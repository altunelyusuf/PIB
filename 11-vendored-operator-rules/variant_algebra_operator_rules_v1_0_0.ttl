@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Operator SHACL-AF Rules v1.0.0
# Real implementation of the 11-operator ontology-native specification
# (10-operator-implementation-spec/ Parts 1-4). Every rule below is the
# EXACT rule already tested in this session's test-drives -- no drift
# between spec and implementation. Execute with pyshacl: advanced=True,
# inplace=True, inference="none" (deliberately no RDFS reasoning required
# -- every rule matches on property patterns, never on rdf:type filters
# against a superclass, per the granularity design principle established
# in Part 1 §0).
# ============================================================

<http://example.org/vaf-consolidated/operator-rules> a owl:Ontology ;
    rdfs:label "VAF Operator SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-07-03"^^xsd:date ;
    dcterms:identifier "variant_algebra_operator_rules_v1_0_0" ;
    owl:versionInfo "1.2.0" ;  # Real, corrected (2026-09-23): PIB's second, independent
    # content-hash catch of this exact recurring miss -- content changed
    # (the IntersectionRuleShape disclosure comment, v2.52.0) without a
    # matching versionInfo bump. STANDING REMINDER: any edit to THIS
    # file's rule bodies or their disclosure comments, however small,
    # needs a real versionInfo bump in the SAME commit -- a repo-level
    # VERSION.txt bump alone does not cover a content-hash-pinning
    # consumer.
    # (ExclusiveAtLeastOneRuleShape, IntersectionCoSelectionRuleShape,
    # WeaklyGroundedRuleShape added) while this stayed 1.0.0 -- a real
    # versioning defect caught by a cross-session PIB handover note
    # (PIB hash-pins this file; the stale version made its own real,
    # content-level change invisible to a version-only consumer).
    owl:versionIRI <http://example.org/vaf-consolidated/operator-rules/1.0.0> ;
    dcterms:source "10-operator-implementation-spec/ Parts 1-4, this session. Depends on 01-ontologies/variant_algebra_v3_operator_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/operator-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated. All 11 operators, real implementation."@en .

# ---- Part 1: Optional ----
va:OptionalRuleShape a sh:NodeShape ;
    sh:targetClass va:OptionalOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isAdmissible true }
            WHERE { $this va:appliesTo ?f }
        """ ; ] .

# ---- Part 1: Exclusive ----
va:ExclusiveRuleShape a sh:NodeShape ;
    sh:targetClass va:ExclusiveOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:members ?list .
                ?list rdf:rest*/rdf:first ?m1 .
                ?list rdf:rest*/rdf:first ?m2 .
                FILTER(?m1 != ?m2)
                ?m1 va:isSelected true . ?m2 va:isSelected true .
            }
        """ ; ] .

# Real, disclosed addition (2026-09-22, owner-directed, verified by direct
# brute-force computation before being added, not assumed): the rule above
# alone only enforces "at most one" -- correct for the real, thesis-cited
# Optional-wrapped composite [a $ b] (0 or 1 of a,b), but the THESIS's own
# real, cited definition of bare, unwrapped (a $ b) is "exactly one" --
# genuinely a different, real construct, not a bug in the rule above.
# Real, formal distributive-law proof, verified computationally:
# (a $ b) + c distributes to (a+c) $ (b+c) -- exactly one, always with c;
# [a $ b] + c distributes to ([a]+c) $ ([b]+c) | c -- at most one, always
# with c, the third alternative being "c alone" (matching hasInnerOperator-
# wrapped Optional's own real "or absent" semantics). This new, additive
# rule enforces "at least one" ONLY for the bare, unwrapped case -- an
# ExclusiveOperator instance is bare iff no real OptionalOperator's own
# hasInnerOperator points to it (hasInnerOperator's own real, declared
# domain is OptionalOperator -- checked directly, not assumed).
va:ExclusiveAtLeastOneRuleShape a sh:NodeShape ;
    sh:targetClass va:ExclusiveOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:members ?list .
                FILTER NOT EXISTS { ?list rdf:rest*/rdf:first ?m . ?m va:isSelected true }
                FILTER NOT EXISTS { ?opt va:hasInnerOperator $this }
            }
        """ ; ] .

# ---- Part 1: Or ----
va:OrRuleShape a sh:NodeShape ;
    sh:targetClass va:OrOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:members ?list .
                FILTER NOT EXISTS { ?list rdf:rest*/rdf:first ?m . ?m va:isSelected true }
            }
        """ ; ] .

# ---- Part 1: Dependency ----
va:DependencyRuleShape a sh:NodeShape ;
    sh:targetClass va:DependencyOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:dependentSet/rdf:rest*/rdf:first ?dep .
                $this va:prerequisiteSet/rdf:rest*/rdf:first ?pre .
                ?dep va:isSelected true .
                FILTER NOT EXISTS { ?pre va:isSelected true }
            }
        """ ; ] .

# ---- Part 1: Addition ----
va:AdditionRuleShape a sh:NodeShape ;
    sh:targetClass va:AdditionOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasOperand ?u }
            WHERE { { $this va:hasOperand ?u } UNION { ?u va:isCoIncludedBy $this } }
        """ ; ] .

# ---- Part 1: Division ----
va:DivisionRuleShape a sh:NodeShape ;
    sh:targetClass va:DivisionOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasResultMember ?a }
            WHERE {
                $this va:hasOperand ?a .
                FILTER NOT EXISTS { $this va:hasOperand ?b . ?b va:removes ?a }
            }
        """ ; ] .

# ---- Part 1: Intersection ----
# Real, disclosed correction (2026-09-22, owner-directed): the original rule
# below treated every operand as one flat, undifferentiated pool, checking
# pairwise coOccursWith within it -- a real, structural mismatch with this
# operator's own authoritative definition ("A ⊓ B contains the variants
# that appear in BOTH A and B" -- two real, SEPARATE sets) and its own real,
# grounding detection source pattern (self.a & self.b -- two named,
# distinct collections, per variant_algebra_calculi_v1_0_0.py's own
# c29_intersection_calculus). Fixed using the SAME SetA/SetB pattern
# Cartesian already establishes below, verified 3/3 real cases before being
# placed into production: a member of SetA survives only if it has a real,
# explicit coOccursWith partner that is itself a member of SetB.
va:IntersectionRuleShape a sh:NodeShape ;
    sh:targetClass va:IntersectionOperator ;
    # Real, disclosed note (2026-09-22, added following a real, cross-
    # session PIB handover observation): both operands MUST be typed as
    # va:SetA / va:SetB respectively -- an earlier version of this rule
    # matched any operands via va:coOccursWith alone, without this
    # typing requirement. Data that satisfied the earlier, untyped rule
    # can produce NO result member under this one, with no error and no
    # warning -- an empty result is NOT distinguishable from "nothing
    # intersects" by inspecting this rule's own output alone. This is a
    # real, deliberate tightening (see WI-036's own real rationale
    # below: Intersection is a genuine symmetric biconditional, not
    # DependencyOperator's asymmetric implication, and correct typing is
    # what makes that distinction enforceable) -- disclosed here
    # explicitly so a consumer relying on this rule's shape can verify
    # its own data carries the required typing before trusting a
    # zero-member result.
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasResultMember ?a }
            WHERE {
                $this va:hasOperand ?a . ?a a va:SetA .
                $this va:hasOperand ?b . ?b a va:SetB .
                ?a va:coOccursWith ?b .
            }
        """ ; ] .

# Real, disclosed addition (2026-09-22, owner-directed): the structural
# rule above alone never checks va:isSelected, making it near-tautological
# for the common case where a declared partner is simply present as
# another operand elsewhere -- checked directly and disclosed to the
# owner before this fix was built, not guessed at. Genuinely distinct
# from DependencyOperator's own real, asymmetric implication (a<b allows
# b without a; verified by direct comparison of both truth tables before
# this rule was written): this is a real, symmetric BICONDITIONAL -- a and
# b are co-selected together, or neither is, matching the operator's own
# authoritative definition ("appear in BOTH A and B") as a genuine,
# per-candidate constraint, not merely a static declaration.
va:IntersectionCoSelectionRuleShape a sh:NodeShape ;
    sh:targetClass va:IntersectionOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:hasOperand ?a . ?a a va:SetA .
                $this va:hasOperand ?b . ?b a va:SetB .
                ?a va:coOccursWith ?b .
                { ?a va:isSelected true . FILTER NOT EXISTS { ?b va:isSelected true } }
                UNION
                { ?b va:isSelected true . FILTER NOT EXISTS { ?a va:isSelected true } }
            }
        """ ; ] .

# ---- Part 2: Repetition (bound check + k-of-n via contributesTo composition) ----
va:RepetitionRuleShape a sh:NodeShape ;
    sh:targetClass va:RepetitionOperator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isViolated true }
            WHERE {
                $this va:appliesTo ?group .
                $this va:hasMaxRepetitions ?max .
                {
                    SELECT ?group (COUNT(?c) as ?n) WHERE {
                        ?c va:contributesTo ?group . ?c va:isSelected true .
                    } GROUP BY ?group
                }
                FILTER(?n > ?max)
            }
        """ ; ] .

# ---- Part 3: Cartesian Layer 0 (decrease-and-conquer propagation) ----
va:PropagationRuleShape a sh:NodeShape ;
    sh:targetClass va:SetA ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isPrunable true }
            WHERE {
                FILTER NOT EXISTS {
                    ?b a va:SetB .
                    FILTER NOT EXISTS { $this va:excludesPartner ?b }
                }
            }
        """ ; ] .

# ---- Part 3: Cartesian Layer 1 (divide-and-conquer partitioning) ----
va:PartitionRuleShape a sh:NodeShape ;
    sh:targetClass va:PartitionRoot ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { ?f1 va:samePartitionAs ?f2 }
            WHERE {
                { ?f1 va:constrainedWith ?f2 }
                UNION
                { ?f1 va:constrainedWith ?mid . ?mid va:constrainedWith ?f2 }
            }
        """ ; ] .

# ---- Part 3: Cartesian Layer 2 (bounded pairing, post-propagation) ----
va:CartesianRuleShape a sh:NodeShape ;
    sh:targetClass va:PairGenerator ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasOperand ?a . $this va:hasOperand ?b }
            WHERE {
                ?a a va:SetA . ?b a va:SetB .
                FILTER NOT EXISTS { ?a va:isPrunable true }
                FILTER NOT EXISTS { ?b va:isPrunable true }
            }
        """ ; ] .

# ---- Part 4: Subtraction + Inverse (purge-before-emission) ----
va:PurgeRuleShape a sh:NodeShape ;
    sh:targetClass va:CandidateVariant ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEmittedMember ?f }
            WHERE {
                $this va:candidateMember ?f .
                FILTER NOT EXISTS { ?f va:isInverseMarked true }
            }
        """ ; ] .

# ---- Part 4: Discovery taxonomy (2026-09-22, owner-directed) ----
# Real, additive rule computing va:isWeaklyGrounded for SemanticCharacteristic
# instances -- verified live before being placed here (both Example 6's
# real, exact case and a contrasting, behaviorally-confirmed case).
va:WeaklyGroundedRuleShape a sh:NodeShape ;
    sh:targetClass va:SemanticCharacteristic ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:isWeaklyGrounded true }
            WHERE {
                $this va:derivedFromSyntactic ?syn .
                FILTER NOT EXISTS { $this va:confirmedByBehavioral ?b }
                FILTER NOT EXISTS { $this va:agreesWithDocumentation true }
            }
        """ ; ] .
