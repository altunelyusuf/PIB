@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# Variant Algebra -- the SHACL file, v1.0.0 (VAF-WI-165, 2026-10-06, plan Amendment 19)
# ONE SHACL file with ONE header and ONE version (BP-D54). Each former rule file of the discovery stack is a MODULE: an untyped resource at the former
# file's header IRI (dcterms:isPartOf this ontology), followed by its block below, copied unchanged. A module is loaded by its shape
# (variant_rule_files_v1_0_0.parse_into), never the whole file: the layers that must feed nothing back are left out of a run by not loading them.
# Strata in use: 1-6 interpretation, 10-14 agreement, 15-21 nonconformity, 22-25 deduction (the trust module also holds 24 and 25), 26-32 trust,
# 40-43 calibration, 44-47 category measures, 48-51 agreement measures.
# ============================================================

<http://example.org/vaf-consolidated/shapes> a owl:Ontology ;
    rdfs:label "Variant Algebra SHACL file"@en ;
    dcterms:created "2026-10-06"^^xsd:date ; dcterms:identifier "variant_algebra_shapes_v1_0_0" ;
    owl:versionInfo "1.3.4" ; owl:versionIRI <http://example.org/vaf-consolidated/shapes/1.3.4> ;
    owl:priorVersion <http://example.org/vaf-consolidated/shapes/1.3.3> ;
    sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
               [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

<http://example.org/vaf-consolidated/discovery-interpretation> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_interpretation_v1_0_0" ; rdfs:label "VAF Discovery Interpretation Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-agreement> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_agreement_v1_0_0" ; rdfs:label "VAF Discovery Agreement Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-deduction> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_deduction_v1_0_0" ; rdfs:label "VAF Discovery Deduction Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-nonconformity> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_nonconformity_v1_0_0" ; rdfs:label "VAF Discovery Nonconformity Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-trust> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_trust_v1_0_0" ; rdfs:label "VAF Discovery Trust Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-calibration> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_calibration_v1_0_0" ; rdfs:label "VAF Discovery Calibration Rules v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-category-measures> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_category_measures_v1_0_0" ; rdfs:label "VAF Discovery Category Measures v1.0.0"@en ; owl:versionInfo "1.0.0" .
<http://example.org/vaf-consolidated/discovery-agreement-measures> dcterms:isPartOf <http://example.org/vaf-consolidated/shapes> ; dcterms:identifier "variant_algebra_discovery_agreement_measures_v1_0_0" ; rdfs:label "VAF Discovery Agreement Measures v1.0.0"@en ; owl:versionInfo "1.0.0" .

# ==== module va:IpRunShape (interpretation) ====
# ============================================================
# Variant Algebra -- discovery interpretation rules, v1.0.0 (VAF-WI-146, 2026-10-05)
# What the discovery description means at three points, as rules over the discovery ontology (no decision in Python,
# va:Decision_NoDecisionsInCode_2026_09_28):
#   1 discovery            a claim is admitted only with a ground, a source for every ground and a context; a term that is
#                          re-interpreted with fewer than two distinct meanings in different contexts is refused.
#   2 variant production   for a target context: which claims apply (they hold there and at least one ground stands), which grounds are
#                          present (the source speaks for the context), which reading of a term the context selects (meaning-in), and
#                          which guard has no reason left (it enforces a policy that is absent there).
#   3 application synthesis  an obligation that applies with no guard in the program is reported, never repaired (the variant adds nothing).
# Stipulations (L-116; each is a proposal with its alternative, accepted only as working definitions):
#   - A ground is PRESENT in a context when every piece of context its source describes is a piece of that context; a source that
#     describes nothing is present everywhere (unknown is not read as absent). Alternative: absent unless it names the context.
#   - A ground STANDS when it is present, its kind is not 'undetermined' (a source that gives no reason is not a reason), and it is
#     not a causal ground all of whose enforced policies are absent (one present policy is a reason). Alternative: undetermined stands (keeps more guards; the safer error).
#   - A claim applies when it holds in the context and at least one ground stands.
# Strata: 1 refusals   2 admitted, present and absent grounds   3 standing grounds, guards without reason   4 applies and dropped
#         5 readings of terms   6 reports
# Run: a node of class va:IpRun with va:ipTarget (the context) in the graph with the ontology and the description.
# ============================================================

va:IpRunShape a sh:NodeShape ; sh:targetClass va:IpRun ;
    rdfs:label "The interpretation rules"@en ;

    # ---- 1 discovery: refusals
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?c va:ipRefused $this . ?n a va:IpRefusal ; va:ipOfRun $this ; va:ipRefusalOf ?c ; va:ipReason "the claim has no ground" }
        WHERE { ?c a va:RelationClaim . FILTER NOT EXISTS { ?c va:hasGround ?g } BIND(IRI(CONCAT("urn:vaf:ip:refusal:", MD5(CONCAT(STR(?c), "noground")))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?c va:ipRefused $this . ?n a va:IpRefusal ; va:ipOfRun $this ; va:ipRefusalOf ?c ; va:ipReason "a ground of the claim has no source" }
        WHERE { ?c a va:RelationClaim ; va:hasGround ?g . FILTER NOT EXISTS { ?g va:groundedBySource ?s } BIND(IRI(CONCAT("urn:vaf:ip:refusal:", MD5(CONCAT(STR(?c), "nosource", STR(?g))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?c va:ipRefused $this . ?n a va:IpRefusal ; va:ipOfRun $this ; va:ipRefusalOf ?c ; va:ipReason "the claim holds in no context" }
        WHERE { ?c a va:RelationClaim . FILTER NOT EXISTS { ?c va:holdsIn ?x } BIND(IRI(CONCAT("urn:vaf:ip:refusal:", MD5(CONCAT(STR(?c), "nocontext")))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?t va:ipRefused $this . ?n a va:IpRefusal ; va:ipOfRun $this ; va:ipRefusalOf ?t ; va:ipReason "a re-interpreted term has fewer than two meanings in different contexts" }
        WHERE { ?t a va:DomainTerm ; va:sensitivity va:SensReinterpreted .
                FILTER NOT EXISTS { ?t va:hasMeaning ?m1 . ?m1 va:meaningIn ?c1 . ?t va:hasMeaning ?m2 . ?m2 va:meaningIn ?c2 . FILTER(?m1 != ?m2 && ?c1 != ?c2) }
                BIND(IRI(CONCAT("urn:vaf:ip:refusal:", MD5(CONCAT(STR(?t), "fewmeanings")))) AS ?n) }""" ] ;

    # ---- 2 admitted claims; grounds present and absent in the target context
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipAdmitted ?c }
        WHERE { ?c a va:RelationClaim . FILTER NOT EXISTS { ?c va:ipRefused $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipPresent ?g }
        WHERE { $this va:ipTarget ?ctx . ?g a va:ClaimGround .
                FILTER NOT EXISTS { ?g va:groundedBySource ?s . ?s va:describesContextPiece ?p . FILTER NOT EXISTS { ?ctx va:hasPiece ?p } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipAbsent ?g }
        WHERE { $this va:ipTarget ?ctx . ?g a va:ClaimGround . ?g va:groundedBySource ?s . ?s va:describesContextPiece ?p . FILTER NOT EXISTS { ?ctx va:hasPiece ?p } }""" ] ;

    # ---- 3 grounds that stand; guards left without a reason
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipStands ?g }
        WHERE { $this va:ipPresent ?g . ?g va:groundKind ?k . FILTER(?k != va:GroundUndetermined && ?k != va:GroundDescriptive)
                FILTER NOT EXISTS { ?g va:groundKind va:GroundCausal ; va:enforces ?p . $this va:ipAbsent ?p . FILTER NOT EXISTS { ?g va:enforces ?q . $this va:ipPresent ?q } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipGuardWithoutReason ?g }
        WHERE { $this va:ipPresent ?g . ?g va:groundKind va:GroundCausal ; va:enforces ?p . $this va:ipAbsent ?p . FILTER NOT EXISTS { ?g va:enforces ?q . $this va:ipPresent ?q } }""" ] ;

    # ---- 4 which claims apply in the context
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipApplies ?c }
        WHERE { $this va:ipTarget ?ctx ; va:ipAdmitted ?c . ?c va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipStands ?g }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipDropped ?c }
        WHERE { $this va:ipTarget ?ctx ; va:ipAdmitted ?c . ?c va:holdsIn ?ctx . FILTER NOT EXISTS { ?c va:hasGround ?g . $this va:ipStands ?g } }""" ] ;

    # ---- 5 which reading of a term the context selects (meaning-in)
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:IpReading ; va:ipOfRun $this ; va:ipTerm ?t ; va:ipMeaning ?m }
        WHERE { $this va:ipTarget ?ctx . ?t a va:DomainTerm ; va:hasMeaning ?m . ?m va:meaningIn ?ctx .
                FILTER NOT EXISTS { ?t va:hasMeaning ?m2 . ?m2 va:meaningIn ?ctx . FILTER(?m2 != ?m) }
                BIND(IRI(CONCAT("urn:vaf:ip:reading:", MD5(CONCAT(STR(?t), STR(?m))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipNoReading ?t }
        WHERE { $this va:ipTarget ?ctx . ?t a va:DomainTerm ; va:hasMeaning ?any . FILTER NOT EXISTS { ?t va:hasMeaning ?m . ?m va:meaningIn ?ctx } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ipAmbiguousReading ?t }
        WHERE { $this va:ipTarget ?ctx . ?t a va:DomainTerm ; va:hasMeaning ?m1, ?m2 . ?m1 va:meaningIn ?ctx . ?m2 va:meaningIn ?ctx . FILTER(?m1 != ?m2) }""" ] ;

    # ---- 6 an obligation that applies with no guard in the program is reported; nothing is added (reported, not repaired)
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:IpReport ; va:ipOfRun $this ; va:ipReportOf ?c ; va:ipReason "an obligation applies in the context and no guard of the program enforces it; the variant adds none" }
        WHERE { $this va:ipApplies ?c . ?c va:claimFamily va:FamNormative ; va:modality va:ModObligation .
                FILTER NOT EXISTS { ?c va:hasGround ?g . ?g va:groundKind va:GroundCausal }
                BIND(IRI(CONCAT("urn:vaf:ip:report:", MD5(STR(?c)))) AS ?n) }""" ] .

# ==== module va:AgRunShape (agreement) ====
# ============================================================
# Variant Algebra -- discovery agreement rules, v1.0.0 (VAF-WI-149, 2026-10-05)
# Compare what the sources state with what the program does, per question and context, and name the state (owner ruling 2026-10-05:
# a mismatch between sources is information; do not merge claims). All decisions are rules over the discovery ontology
# (va:Decision_NoDecisionsInCode_2026_09_28). The run node is typed va:IpRun as well (strata 1-6 of the interpretation rules make
# grounds stand or not in the target context) and va:AgRun; strata here start at 10.
# Stipulations (L-116; proposals with alternatives; see the plan, Amendment 3):
#   1 question identity: after, before, requires-state (one establisher), prevents-state join ordering questions; others by kind
#   2 stated = a standing policy or normative ground in the context; enforced = a causal ground present in the context (the program enforces it
#     whether or not a reason for it stands there); a workflow description is evidence at its own rank (WI-151, Amendment 5): described, never stated
#   3 an obligation is met through order unless one of its grounds carries an uninterpreted condition; requiring one state of an
#     exclusive attribute prevents every other state of it
#   4 dates: stated date = earliest rule-stated event of the context; last change = latest code event of the operation ("*" counts for all)
#   5 incidents apply when opened within the context's validity; the current code is the code of every context
# Strata: 10 questions   11 stated, enforced (and backing)   12 inference between questions   13 dates and incidents   14 records
# ============================================================

va:AgRunShape a sh:NodeShape ; sh:targetClass va:AgRun ;
    rdfs:label "The agreement rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "order" ; va:agKey ?key ; va:agSubject ?s ; va:agObject ?o . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_after ; va:claimSubject ?s ; va:claimObject ?o . BIND(CONCAT("order|", STR(?s), "|", STR(?o)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "order" ; va:agKey ?key ; va:agSubject ?o ; va:agObject ?s . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_before ; va:claimSubject ?s ; va:claimObject ?o . BIND(CONCAT("order|", STR(?o), "|", STR(?s)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "order" ; va:agKey ?key ; va:agSubject ?s ; va:agObject ?m . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_requires ; va:claimSubject ?s ; va:claimObject ?t . ?e a va:StateEstablishment ; va:estMember ?m ; va:estState ?t . FILTER(?m != ?s)
                BIND(CONCAT("order|", STR(?s), "|", STR(?m)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "requires" ; va:agKey ?key ; va:agSubject ?s ; va:agObject ?t . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_requires ; va:claimSubject ?s ; va:claimObject ?t . FILTER NOT EXISTS { ?c va:hasGround ?gd . ?gd va:groundKind va:GroundDefinitional }
                FILTER NOT EXISTS { ?e a va:StateEstablishment ; va:estState ?t ; va:estMember ?m . FILTER(?m != ?s) }
                BIND(CONCAT("requires|", STR(?s), "|", STR(?t)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "prevents" ; va:agKey ?key ; va:agSubject ?s ; va:agObject ?t . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_prevents ; va:claimSubject ?s ; va:claimObject ?t . BIND(CONCAT("prevents|", STR(?s), "|", STR(?t)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "obliged" ; va:agKey ?key ; va:agSubject ?s . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_obliged ; va:claimSubject ?s . BIND(CONCAT("obliged|", STR(?s)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "forbidden" ; va:agKey ?key ; va:agSubject ?s . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_forbidden ; va:claimSubject ?s . BIND(CONCAT("forbidden|", STR(?s)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "permitted" ; va:agKey ?key ; va:agSubject ?s . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_permitted ; va:claimSubject ?s . BIND(CONCAT("permitted|", STR(?s)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "triggers" ; va:agKey ?key ; va:agSubject ?s ; va:agObject ?o . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimRelation va:Rel_triggers ; va:claimSubject ?s ; va:claimObject ?o . BIND(CONCAT("triggers|", STR(?s), "|", STR(?o)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "structural" ; va:agKey ?key . ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:hasGround ?g . FILTER NOT EXISTS { ?c va:hasGround ?g2 . ?g2 va:groundKind ?k2 . FILTER(?k2 != va:GroundDefinitional) }
                FILTER NOT EXISTS { ?o a va:ObservedParameter ; va:obsMember ?s . ?c va:claimSubject ?s }
                BIND(CONCAT("structural|", STR(?c)) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q a va:AgQuestion ; va:agKind "param" ; va:agKey ?key ; va:agName ?k }
        WHERE { ?t va:parameterKey ?k . BIND(CONCAT("param|", ?k) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?c va:agSpeaksTo ?q }
        WHERE { ?c a va:RelationClaim ; va:claimSubject ?s . ?o a va:ObservedParameter ; va:obsMember ?s ; va:obsKey ?k . BIND(CONCAT("param|", ?k) AS ?key) BIND(IRI(CONCAT("urn:vaf:ag:q:", MD5(?key))) AS ?q) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agStatedIn ?ctx . ?c va:agStatesIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipStands ?g . ?g va:groundKind ?k . FILTER(?k IN (va:GroundPolicy, va:GroundNormative)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agEnforcedIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g . ?g va:groundKind va:GroundCausal . FILTER NOT EXISTS { ?q va:agKind "param" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agDescribedIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g . ?g va:groundKind va:GroundDescriptive . FILTER NOT EXISTS { ?q va:agKind "param" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agStatementAt ?au }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipStands ?g . ?g va:groundKind ?k . FILTER(?k IN (va:GroundPolicy, va:GroundNormative)) ?g va:groundedBySource ?src . ?src va:authorityLevel ?au . ?au va:authorityAxis "must hold" }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agStatementAt ?au }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g . ?g va:groundKind va:GroundDescriptive ; va:groundedBySource ?src . ?src va:authorityLevel ?au . ?au va:authorityAxis "must hold" }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agHeldIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "param" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agHeldIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?q va:agKind "param" ; va:agName ?k . ?t va:parameterKey ?k ; va:hasMeaning ?m . ?m va:meaningIn ?ctx }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agEnforcedIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?c a va:RelationClaim ; va:claimRelation va:Rel_prevents ; va:claimSubject ?a ; va:claimObject ?t ; va:holdsIn ?ctx ; va:hasGround ?g .
                $this va:ipPresent ?g . ?g va:groundKind va:GroundCausal . ?e a va:StateEstablishment ; va:estMember ?b ; va:estState ?t . FILTER(?a != ?b)
                ?q a va:AgQuestion ; va:agKind "order" ; va:agSubject ?b ; va:agObject ?a . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?qp va:agStatedIn ?ctx }
        WHERE { ?qp a va:AgQuestion ; va:agKind "prevents" ; va:agSubject ?a ; va:agObject ?t . ?e a va:StateEstablishment ; va:estMember ?b ; va:estState ?t . FILTER(?a != ?b)
                ?qo a va:AgQuestion ; va:agKind "order" ; va:agSubject ?b ; va:agObject ?a ; va:agStatedIn ?ctx . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?qp va:agEnforcedIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?qp a va:AgQuestion ; va:agKind "prevents" ; va:agSubject ?s ; va:agObject ?t .
                ?c a va:RelationClaim ; va:claimRelation va:Rel_requires ; va:claimSubject ?s ; va:claimObject ?t2 ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g . ?g va:groundKind va:GroundCausal .
                ?x1 a va:ExclusiveState ; va:exclState ?t2 ; va:exclAttribute ?at . ?x2 a va:ExclusiveState ; va:exclState ?t ; va:exclAttribute ?at . FILTER(?t != ?t2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?qb va:agEnforcedIn ?ctx . ?qb va:agMetThrough ?qo }
        WHERE { ?qb a va:AgQuestion ; va:agKind "obliged" ; va:agSubject ?o . ?qo a va:AgQuestion ; va:agKind "order" ; va:agObject ?o ; va:agEnforcedIn ?ctx .
                FILTER NOT EXISTS { ?cc va:agSpeaksTo ?qb ; va:hasGround ?gc . ?gc va:groundConditional true } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?qb va:agNotMetBecauseConditional "true" }
        WHERE { ?qb a va:AgQuestion ; va:agKind "obliged" ; va:agSubject ?o . ?cc va:agSpeaksTo ?qb ; va:hasGround ?gc . ?gc va:groundConditional true }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agStatedWhen ?w }
        WHERE { $this va:ipTarget ?ctx . ?ev a va:ChangeEvent ; va:evKind "rule-stated" ; va:evWhen ?w ; va:evHoldsIn ?ctx . ?q a va:AgQuestion ; va:agKind ?ek ; va:agSubject ?es . ?ev va:evRel ?ek ; va:evSubject ?es . OPTIONAL { ?q va:agObject ?eo } OPTIONAL { ?ev va:evObject ?evo }
                FILTER(!BOUND(?eo) || (BOUND(?evo) && ?evo = ?eo)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agStatedWhen ?w }
        WHERE { $this va:ipTarget ?ctx . ?ev a va:ChangeEvent ; va:evKind "rule-stated" ; va:evRel "param" ; va:evName ?k ; va:evValue ?v ; va:evWhen ?w ; va:evHoldsIn ?ctx .
                ?q a va:AgQuestion ; va:agKind "param" ; va:agName ?k . ?t va:parameterKey ?k ; va:hasMeaning ?m . ?m va:meaningIn ?ctx ; va:meaningValue ?mv . FILTER(?mv = ?v) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agCodeChangedWhen ?w }
        WHERE { ?ev a va:ChangeEvent ; va:evKind ?ek2 ; va:evFromCode true ; va:evWhen ?w ; va:evSubject ?es . FILTER(?ek2 IN ("code-changed", "rule-enforced")) ?q a va:AgQuestion ; va:agSubject ?es . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agCodeChangedWhen ?w }
        WHERE { ?ev a va:ChangeEvent ; va:evKind "code-changed" ; va:evFromCode true ; va:evAllOperations true ; va:evWhen ?w . ?q a va:AgQuestion . FILTER NOT EXISTS { ?q va:agKind "param" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agCodeChangedWhen ?w }
        WHERE { ?ev a va:ChangeEvent ; va:evKind "code-changed" ; va:evRel "param" ; va:evFromCode true ; va:evName ?k ; va:evWhen ?w . ?q a va:AgQuestion ; va:agKind "param" ; va:agName ?k . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agIncidentIn ?ctx . ?i va:agAppliesTo ?q }
        WHERE { $this va:ipTarget ?ctx . ?i a va:Incident ; va:incOpened ?op ; va:incHoldsIn ?ctx . OPTIONAL { ?ctx va:validFrom ?vf } OPTIONAL { ?ctx va:validUntil ?vu }
                FILTER((!BOUND(?vf) || ?op >= ?vf) && (!BOUND(?vu) || ?op <= ?vu)) ?i va:incRel ?ek ; va:incSubject ?es . ?q a va:AgQuestion ; va:agKind ?ek ; va:agSubject ?es . OPTIONAL { ?q va:agObject ?eo } OPTIONAL { ?i va:incObject ?io }
                FILTER(!BOUND(?eo) || (BOUND(?io) && ?io = ?eo)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agIncidentIn ?ctx . ?i va:agAppliesTo ?q }
        WHERE { $this va:ipTarget ?ctx . ?i a va:Incident ; va:incOpened ?op ; va:incHoldsIn ?ctx . OPTIONAL { ?ctx va:validFrom ?vf } OPTIONAL { ?ctx va:validUntil ?vu }
                FILTER((!BOUND(?vf) || ?op >= ?vf) && (!BOUND(?vu) || ?op <= ?vu)) ?i va:incRel "param" ; va:incName ?k . ?q a va:AgQuestion ; va:agKind "param" ; va:agName ?k . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agOpenIncidentIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?i a va:Incident ; va:incOpened ?op ; va:incHoldsIn ?ctx . OPTIONAL { ?ctx va:validFrom ?vf } OPTIONAL { ?ctx va:validUntil ?vu }
                FILTER((!BOUND(?vf) || ?op >= ?vf) && (!BOUND(?vu) || ?op <= ?vu)) ?i va:agAppliesTo ?q ; va:incResolution "open" . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agFixedIncidentIn ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?i a va:Incident ; va:incOpened ?op ; va:incHoldsIn ?ctx ; va:agAppliesTo ?q ; va:incResolution "code-fixed" ; va:incClosed ?cl .
                OPTIONAL { ?ctx va:validFrom ?vf } OPTIONAL { ?ctx va:validUntil ?vu } FILTER((!BOUND(?vf) || ?op >= ?vf) && (!BOUND(?vu) || ?op <= ?vu))
                ?q va:agKind ?ek ; va:agSubject ?es . OPTIONAL { ?q va:agObject ?eo }
                ?ev a va:ChangeEvent ; va:evKind "rule-enforced" ; va:evRel ?ek ; va:evSubject ?es ; va:evWhen ?w . OPTIONAL { ?ev va:evObject ?evo }
                FILTER(?w >= ?op && (!BOUND(?eo) || (BOUND(?evo) && ?evo = ?eo))) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agParamEqual ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agName ?k ; va:agHeldIn ?ctx . ?t va:parameterKey ?k ; va:hasMeaning ?m . ?m va:meaningIn ?ctx ; va:meaningValue ?v .
                ?o a va:ObservedParameter ; va:obsKey ?k ; va:obsHoldsIn ?ctx . FILTER NOT EXISTS { ?o2 a va:ObservedParameter ; va:obsKey ?k ; va:obsHoldsIn ?ctx ; va:obsValue ?v2 . FILTER(?v2 != ?v) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agParamDiffers ?ctx }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agName ?k ; va:agHeldIn ?ctx . ?t va:parameterKey ?k ; va:hasMeaning ?m . ?m va:meaningIn ?ctx ; va:meaningValue ?v .
                ?o a va:ObservedParameter ; va:obsKey ?k ; va:obsHoldsIn ?ctx ; va:obsValue ?v2 . FILTER(?v2 != ?v) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agTopLevel ?au }
        WHERE { ?q va:agStatementAt ?au . ?au va:authorityRank ?r . FILTER NOT EXISTS { ?q va:agStatementAt ?au2 . ?au2 va:authorityRank ?r2 . FILTER(?r2 > ?r) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agLatestCodeChange ?w }
        WHERE { ?q a va:AgQuestion ; va:agCodeChangedWhen ?w . FILTER NOT EXISTS { ?q va:agCodeChangedWhen ?w2 . FILTER(?w2 > ?w) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:agEarliestStated ?w }
        WHERE { ?q a va:AgQuestion ; va:agStatedWhen ?w . FILTER NOT EXISTS { ?q va:agStatedWhen ?w2 . FILTER(?w2 < ?w) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgDescribedOnly ; va:agReason "the program enforces it and only a process description says it; no rule states it" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agDescribedIn ?ctx . FILTER NOT EXISTS { ?q va:agStatedIn ?ctx } ?q va:agEnforcedIn ?ctx . FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgDescriptionNotEnforced ; va:agReason "only a process description says it and the program does not enforce it; a description alone gives no verdict" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agDescribedIn ?ctx . FILTER NOT EXISTS { ?q va:agStatedIn ?ctx } FILTER NOT EXISTS { ?q va:agEnforcedIn ?ctx } FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgMisbehaviourConfirmed ; va:agReason "only a process description says it, the program does not enforce it, and an open incident records the violation" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agDescribedIn ?ctx . FILTER NOT EXISTS { ?q va:agStatedIn ?ctx } ?q va:agOpenIncidentIn ?ctx . FILTER NOT EXISTS { ?q va:agEnforcedIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgStructural ; va:agReason "true by the definition of the data" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agKind "structural" ; va:agHeldIn ?ctx . BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgPermissive ; va:agReason "a permission is not compared with enforcement" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agKind "permitted" ; va:agHeldIn ?ctx . BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgContradictedByIncident ; va:agReason "the program enforces it, yet an open incident records a violation" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agEnforcedIn ?ctx ; va:agOpenIncidentIn ?ctx . BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgAgreedAfterCorrection ; va:agReason "stated and enforced; an incident was fixed by a dated change" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agStatedIn ?ctx ; va:agEnforcedIn ?ctx ; va:agFixedIncidentIn ?ctx . FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgAgreed ; va:agReason "a standing document states it and the program enforces it" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agStatedIn ?ctx ; va:agEnforcedIn ?ctx . FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } FILTER NOT EXISTS { ?q va:agFixedIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgDocumentsBehind ; va:agReason "the program enforces it and no standing document states it" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agEnforcedIn ?ctx . FILTER NOT EXISTS { ?q va:agStatedIn ?ctx } FILTER NOT EXISTS { ?q va:agDescribedIn ?ctx } FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgMisbehaviourConfirmed ; va:agReason "stated, not enforced, and an open incident records the violation" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agStatedIn ?ctx ; va:agOpenIncidentIn ?ctx . FILTER NOT EXISTS { ?q va:agEnforcedIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgCodeBehindNewer ; va:agReason "stated, not enforced, and the statement is newer than the last change to the operation" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agStatedIn ?ctx ; va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s > ?l) FILTER NOT EXISTS { ?q va:agEnforcedIn ?ctx } FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgUndecided ; va:agReason "stated, not enforced; the statement is not newer than the last change, or there are no dates" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . FILTER NOT EXISTS { ?q va:agKind "structural" } FILTER NOT EXISTS { ?q va:agKind "permitted" } FILTER NOT EXISTS { ?q va:agKind "param" } ?q va:agStatedIn ?ctx . FILTER NOT EXISTS { ?q va:agEnforcedIn ?ctx } FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } FILTER NOT EXISTS { ?q va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s > ?l) } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgAgreed ; va:agReason "every observed value equals the value stated for the context" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agHeldIn ?ctx . ?q va:agParamEqual ?ctx . FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } FILTER NOT EXISTS { ?q va:agFixedIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgContradictedByIncident ; va:agReason "the value agrees, yet an open incident records a violation" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agHeldIn ?ctx . ?q va:agParamEqual ?ctx ; va:agOpenIncidentIn ?ctx . BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgMisbehaviourConfirmed ; va:agReason "an observed value differs from the value stated and an open incident records it" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agHeldIn ?ctx . ?q va:agParamDiffers ?ctx ; va:agOpenIncidentIn ?ctx . BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgCodeBehindNewer ; va:agReason "an observed value differs from the value stated, and the statement is newer than the last change of the value" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agHeldIn ?ctx . ?q va:agParamDiffers ?ctx ; va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s > ?l) FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState va:AgUndecided ; va:agReason "an observed value differs from the value stated; the statement is not newer than the last change, or there are no dates" . $this va:agHas ?rec }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "param" ; va:agHeldIn ?ctx . ?q va:agParamDiffers ?ctx . FILTER NOT EXISTS { ?q va:agOpenIncidentIn ?ctx } FILTER NOT EXISTS { ?q va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s > ?l) } BIND(IRI(CONCAT("urn:vaf:ag:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] .

# ==== module va:DeRunShape (deduction) ====
# ============================================================
# Variant Algebra -- discovery deduction rules, v1.0.0 (VAF-WI-152, 2026-10-05)
# The source layer is closed; this layer synthesizes the ranks, the agreement states and the incidents into
#  (1) a knowledge category for every question in every context, and
#  (2) deduced facts: an ordering that follows by transitivity from questions held in the context, standing at its weakest link's level.
# A deduced fact is evidence, never a verdict (R11): categorized, never compared with documents, never given an agreement state.
# All decisions are rules (va:Decision_NoDecisionsInCode_2026_09_28). Stipulations (L-116) are in the plan, Amendment 6.
# Strata: 22 chains and reach (to a fixpoint)   23 deduced facts   24 level, enforcement, the questions deduced through   25 categories
# Run after the interpretation and agreement rules in one store; the run node is also typed va:IpRun, va:AgRun and va:DeRun.
# ============================================================

va:DeRunShape a sh:NodeShape ; sh:targetClass va:DeRun ;
    rdfs:label "The deduction rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeChain ; va:deSubject ?s ; va:deObject ?o }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "order" ; va:agHeldIn ?ctx ; va:agSubject ?s ; va:agObject ?o . BIND(IRI(CONCAT("urn:vaf:de:chain:", MD5(CONCAT(STR(?s), "|", STR(?o))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeChain ; va:deSubject ?s ; va:deObject ?o }
        WHERE { ?a a va:DeChain ; va:deSubject ?s ; va:deObject ?m . ?b a va:DeChain ; va:deSubject ?m ; va:deObject ?o . FILTER(?s != ?o) BIND(IRI(CONCAT("urn:vaf:de:chain:", MD5(CONCAT(STR(?s), "|", STR(?o))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeEnfChain ; va:deSubject ?s ; va:deObject ?o }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "order" ; va:agHeldIn ?ctx ; va:agSubject ?s ; va:agObject ?o . ?q va:agEnforcedIn ?ctx . BIND(IRI(CONCAT("urn:vaf:de:enf:", MD5(CONCAT(STR(?s), "|", STR(?o))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeEnfChain ; va:deSubject ?s ; va:deObject ?o }
        WHERE { ?a a va:DeEnfChain ; va:deSubject ?s ; va:deObject ?m . ?b a va:DeEnfChain ; va:deSubject ?m ; va:deObject ?o . FILTER(?s != ?o) BIND(IRI(CONCAT("urn:vaf:de:enf:", MD5(CONCAT(STR(?s), "|", STR(?o))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeReach ; va:deSubject ?s ; va:deObject ?o ; va:deAtLevel ?A }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agKind "order" ; va:agHeldIn ?ctx ; va:agSubject ?s ; va:agObject ?o . ?q va:agTopLevel ?L . ?L va:authorityRank ?r . ?A va:authorityAxis "must hold" ; va:authorityRank ?ra . FILTER(?r >= ?ra) BIND(IRI(CONCAT("urn:vaf:de:reach:", MD5(CONCAT(STR(?s), "|", STR(?o), "|", STR(?A))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 22 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?n a va:DeReach ; va:deSubject ?s ; va:deObject ?o ; va:deAtLevel ?A }
        WHERE { ?a a va:DeReach ; va:deSubject ?s ; va:deObject ?m ; va:deAtLevel ?A . ?b a va:DeReach ; va:deSubject ?m ; va:deObject ?o ; va:deAtLevel ?A . FILTER(?s != ?o) BIND(IRI(CONCAT("urn:vaf:de:reach:", MD5(CONCAT(STR(?s), "|", STR(?o), "|", STR(?A))))) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 23 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d a va:DeDerived ; va:deOfRun $this ; va:deSubject ?s ; va:deObject ?o }
        WHERE { $this va:ipTarget ?ctx . ?c a va:DeChain ; va:deSubject ?s ; va:deObject ?o . FILTER NOT EXISTS { ?q a va:AgQuestion ; va:agKind "order" ; va:agHeldIn ?ctx ; va:agSubject ?s ; va:agObject ?o } BIND(IRI(CONCAT("urn:vaf:de:derived:", MD5(CONCAT(STR(?s), "|", STR(?o))))) AS ?d) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d va:deLevel ?A }
        WHERE { ?d a va:DeDerived ; va:deSubject ?s ; va:deObject ?o . ?r a va:DeReach ; va:deSubject ?s ; va:deObject ?o ; va:deAtLevel ?A . ?A va:authorityRank ?ra .
                FILTER NOT EXISTS { ?r2 a va:DeReach ; va:deSubject ?s ; va:deObject ?o ; va:deAtLevel ?A2 . ?A2 va:authorityRank ?ra2 . FILTER(?ra2 > ?ra) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d va:deEnforced "true" }
        WHERE { ?d a va:DeDerived ; va:deSubject ?s ; va:deObject ?o . ?e a va:DeEnfChain ; va:deSubject ?s ; va:deObject ?o }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d va:deVia ?q }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deSubject ?s ; va:deObject ?o . ?q a va:AgQuestion ; va:agKind "order" ; va:agHeldIn ?ctx ; va:agSubject ?s1 ; va:agObject ?o1 .
                FILTER(!(?s1 = ?s && ?o1 = ?o)) FILTER(?s1 = ?s || EXISTS { ?c1 a va:DeChain ; va:deSubject ?s ; va:deObject ?s1 }) FILTER(?o1 = ?o || EXISTS { ?c2 a va:DeChain ; va:deSubject ?o1 ; va:deObject ?o }) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOfDerived ?d ; va:kcIn ?ctx ; va:kcCategory va:KcEstablished ; va:kcBasis "deduced; every link is stated at a documented rule or above and enforced" }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deOfRun $this . ?d va:deEnforced "true" ; va:deLevel ?L . ?L va:authorityRank ?r . FILTER(?r >= 4) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?d)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOfDerived ?d ; va:kcIn ?ctx ; va:kcCategory va:KcEstablishedWeak ; va:kcBasis "deduced; enforced, and the weakest link is below a documented rule" }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deOfRun $this . ?d va:deEnforced "true" ; va:deLevel ?L . ?L va:authorityRank ?r . FILTER(?r < 4) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?d)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOfDerived ?d ; va:kcIn ?ctx ; va:kcCategory va:KcPractice ; va:kcBasis "deduced; enforced, and no chain of statements exists" }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deOfRun $this . ?d va:deEnforced "true" . FILTER NOT EXISTS { ?d va:deLevel ?any } BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?d)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOfDerived ?d ; va:kcIn ?ctx ; va:kcCategory va:KcOwed ; va:kcBasis "deduced; stated at a documented rule or above, and no chain of enforced links exists" }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deOfRun $this . ?d va:deLevel ?L . ?L va:authorityRank ?r . FILTER(?r >= 4) FILTER NOT EXISTS { ?d va:deEnforced "true" } BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?d)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOfDerived ?d ; va:kcIn ?ctx ; va:kcCategory va:KcUnresolved ; va:kcBasis "deduced; not enforced and not stated at a documented rule or above" }
        WHERE { $this va:ipTarget ?ctx . ?d a va:DeDerived ; va:deOfRun $this . FILTER NOT EXISTS { ?d va:deEnforced "true" } FILTER NOT EXISTS { ?d va:deLevel ?L . ?L va:authorityRank ?r . FILTER(?r >= 4) } BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?d)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcEstablished ; va:kcBasis "agreed, and no statement below a documented rule is the highest" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgAgreed, va:AgAgreedAfterCorrection)) FILTER NOT EXISTS { ?q va:agTopLevel ?L . ?L va:authorityRank ?r . FILTER(?r < 4) } BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcEstablishedWeak ; va:kcBasis "agreed, and the highest statement is below a documented rule" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgAgreed, va:AgAgreedAfterCorrection)) ?q va:agTopLevel ?L . ?L va:authorityRank ?r . FILTER(?r < 4) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcPractice ; va:kcBasis "the program does it and no rule says it" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgDocumentsBehind, va:AgDescribedOnly)) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcOwed ; va:kcBasis "a statement requires it and the program does not do it" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgCodeBehindNewer, va:AgMisbehaviourConfirmed)) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcUnresolved ; va:kcBasis "the data cannot decide" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgUndecided, va:AgDescriptionNotEnforced)) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcInDispute ; va:kcBasis "enforced, yet an open incident records a violation" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st = va:AgContradictedByIncident) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcStructural ; va:kcBasis "true by the definition of the data" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st = va:AgStructural) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?k a va:KcRecord ; va:kcOf ?q ; va:kcIn ?ctx ; va:kcCategory va:KcPermitted ; va:kcBasis "a permission is not compared with enforcement" }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agOf ?q ; va:agIn ?ctx ; va:agState ?st . FILTER(?st = va:AgPermissive) BIND(IRI(CONCAT("urn:vaf:de:kc:", MD5(STR(?rec)))) AS ?k) }""" ]  .

# ==== module va:NcRunShape (nonconformity) ====
# ============================================================
# Variant Algebra -- discovery nonconformity rules, v1.0.0 (VAF-WI-150, 2026-10-05)
# A mismatch between what the sources state and what the program does is a nonconformity (ISO 9001:2015 clause 10.2, owner ruling
# 2026-10-05). From the agreement result (strata 10-14 of the agreement rules) these rules derive, per question and context: a record,
# the candidate causes the dates and the state are consistent with (a fishbone category and the point where detection failed), the open
# question when no cause can be named, a person's confirmed cause, a known-problem acceptance, the status, and a Pareto count per cause.
# The model never confirms a cause: only a person's record does. All decisions are rules (va:Decision_NoDecisionsInCode_2026_09_28).
# Stipulations (L-116; proposals with alternatives; see the plan, Amendment 4):
#   1 a record exists for every state except agreed, structural and permissive; agreed after correction is a closed record
#   2 candidate causes come from the state and the dates only: documents behind -> never written down; a statement newer than the last
#     change of the program -> change not carried; stated, not enforced, program changed on or after the statement -> rule missed in the
#     change; enforced yet an open incident -> guard incomplete; agreed after correction -> rule missed in the change
#   3 no candidate -> cause unknown, with the question derived from the missing date, or "changed after the statement"
#   4 a person's confirmation gives correction planned; a confirmed cause outside the candidates is flagged, not rejected
#   5 a known problem needs owner, reason, risk and review date; past the review date as of the assessment date it is overdue
#   6 Pareto counts every record with a candidate cause that is not closed, accepted known problems included; unknown causes counted apart
#   7 (found while building) a confirmation and a known-problem entry for the same record conflict: flagged, status not decided by either
# Strata: 15 records   16 candidate causes   17 escape points, open questions, matching inputs   18 flags   19 status   20 counts   21 ranks
# ============================================================

va:NcRunShape a sh:NodeShape ; sh:targetClass va:NcRun ;
    rdfs:label "The nonconformity rules"@en ;
    sh:property [ sh:path va:ncAsOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "A nonconformity run needs the date it is assessed as of." ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 15 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc a va:NcRecord ; va:ncOf ?rec ; va:ncIn ?ctx . $this va:ncAssessed ?nc }
        WHERE { $this va:ipTarget ?ctx . ?rec a va:AgRecord ; va:agIn ?ctx ; va:agState ?st . FILTER(?st IN (va:AgDocumentsBehind, va:AgCodeBehindNewer, va:AgMisbehaviourConfirmed, va:AgContradictedByIncident, va:AgUndecided, va:AgAgreedAfterCorrection, va:AgDescribedOnly, va:AgDescriptionNotEnforced)) BIND(IRI(CONCAT("urn:vaf:nc:rec:", MD5(STR(?rec)))) AS ?nc) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_OnlyDescribed }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgDescribedOnly .  }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_DocumentNeverWritten }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgDocumentsBehind .  }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_ChangeNotCarried }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgCodeBehindNewer .  }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_GuardIncomplete }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgContradictedByIncident .  }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_RuleMissedInChange }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgAgreedAfterCorrection .  }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_ChangeNotCarried }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgMisbehaviourConfirmed . ?rec va:agOf ?q . ?q va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s > ?l) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncCandidate va:NcCause_RuleMissedInChange }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgMisbehaviourConfirmed . ?rec va:agOf ?q . ?q va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s <= ?l) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncEscape ?e }
        WHERE { ?nc va:ncCandidate ?c . ?c va:causeEscape ?e }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncQuestion va:NcQuestion_StatementDateMissing }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . FILTER NOT EXISTS { ?nc va:ncCandidate ?any } ?rec va:agOf ?q . FILTER NOT EXISTS { ?q va:agEarliestStated ?s } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncQuestion va:NcQuestion_CodeChangeDateMissing }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . FILTER NOT EXISTS { ?nc va:ncCandidate ?any } ?rec va:agOf ?q . FILTER NOT EXISTS { ?q va:agLatestCodeChange ?l } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncQuestion va:NcQuestion_ChangedAfterStatement }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . FILTER NOT EXISTS { ?nc va:ncCandidate ?any } ?rec va:agOf ?q . ?q va:agEarliestStated ?s ; va:agLatestCodeChange ?l . FILTER(?s <= ?l) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncConfirmed ?cc ; va:ncConfirmedCause ?cause }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec ; va:ncIn ?ctx . ?rec va:agOf ?q . ?q va:agKind ?k ; va:agSubject ?s . OPTIONAL { ?q va:agObject ?o } FILTER(?k != "param") ?cc a va:CauseConfirmation ; va:ccIn ?ctx ; va:ccRel ?k ; va:ccSubject ?s ; va:ccCause ?cause . OPTIONAL { ?cc va:ccObject ?co } FILTER(BOUND(?o) = BOUND(?co) && (!BOUND(?o) || ?o = ?co)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncConfirmed ?cc ; va:ncConfirmedCause ?cause }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec ; va:ncIn ?ctx . ?rec va:agOf ?q . ?q va:agKind "param" ; va:agName ?n . ?cc a va:CauseConfirmation ; va:ccIn ?ctx ; va:ccRel "param" ; va:ccName ?n ; va:ccCause ?cause }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncKnownProblem ?kp }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec ; va:ncIn ?ctx . ?rec va:agOf ?q . ?q va:agKind ?k ; va:agSubject ?s . OPTIONAL { ?q va:agObject ?o } FILTER(?k != "param") ?kp a va:KnownProblem ; va:kpIn ?ctx ; va:kpRel ?k ; va:kpSubject ?s . OPTIONAL { ?kp va:kpObject ?ko } FILTER(BOUND(?o) = BOUND(?ko) && (!BOUND(?o) || ?o = ?ko)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncKnownProblem ?kp }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec ; va:ncIn ?ctx . ?rec va:agOf ?q . ?q va:agKind "param" ; va:agName ?n . ?kp a va:KnownProblem ; va:kpIn ?ctx ; va:kpRel "param" ; va:kpName ?n }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 18 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncOutsideCandidates true }
        WHERE { ?nc va:ncConfirmedCause ?c . FILTER NOT EXISTS { ?nc va:ncCandidate ?c } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 18 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncConflictingInputs true }
        WHERE { ?nc va:ncConfirmed ?cc ; va:ncKnownProblem ?kp }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcClosedEffective }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?rec va:agState va:AgAgreedAfterCorrection . FILTER NOT EXISTS { ?nc va:ncConfirmed ?x } FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcCorrectionPlanned }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?nc va:ncConfirmed ?cc . FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcKnownProblem }
        WHERE { $this va:ncAsOf ?d . ?nc a va:NcRecord ; va:ncOf ?rec . ?nc va:ncKnownProblem ?kp . ?kp va:kpReview ?r . FILTER(?r >= ?d) FILTER NOT EXISTS { ?nc va:ncConfirmed ?x } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcKnownProblemOverdue }
        WHERE { $this va:ncAsOf ?d . ?nc a va:NcRecord ; va:ncOf ?rec . ?nc va:ncKnownProblem ?kp . ?kp va:kpReview ?r . FILTER(?r < ?d) FILTER NOT EXISTS { ?nc va:ncConfirmed ?x } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcInvestigationOpen }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . ?nc va:ncCandidate ?c . FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } FILTER NOT EXISTS { ?nc va:ncConfirmed ?x . FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y } } FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y2 . FILTER NOT EXISTS { ?nc va:ncConfirmed ?x2 } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?nc va:ncStatus va:NcCauseUnknown }
        WHERE { ?nc a va:NcRecord ; va:ncOf ?rec . FILTER NOT EXISTS { ?nc va:ncCandidate ?c } FILTER NOT EXISTS { ?rec va:agState va:AgAgreedAfterCorrection } FILTER NOT EXISTS { ?nc va:ncConfirmed ?x . FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y } } FILTER NOT EXISTS { ?nc va:ncKnownProblem ?y2 . FILTER NOT EXISTS { ?nc va:ncConfirmed ?x2 } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?row a va:NcParetoRow ; va:ncParetoIn ?ctx ; va:ncParetoCause ?c ; va:ncParetoCount ?n . $this va:ncPareto ?row }
        WHERE { $this va:ipTarget ?ctx . { SELECT ?c (COUNT(DISTINCT ?nc) AS ?n) WHERE { ?nc a va:NcRecord ; va:ncCandidate ?c ; va:ncStatus ?st . FILTER(?st != va:NcClosedEffective) } GROUP BY ?c } BIND(IRI(CONCAT("urn:vaf:nc:pareto:", MD5(STR(?c)))) AS ?row) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { $this va:ncUnknownCount ?n }
        WHERE { { SELECT (COUNT(?nc) AS ?n) WHERE { ?nc a va:NcRecord ; va:ncStatus va:NcCauseUnknown } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 21 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?row va:ncParetoRank ?r }
        WHERE { { SELECT ?row (COUNT(?o) AS ?higher) WHERE { ?row a va:NcParetoRow ; va:ncParetoCount ?n . OPTIONAL { ?o a va:NcParetoRow ; va:ncParetoCount ?m . FILTER(?m > ?n) } } GROUP BY ?row } BIND(?higher + 1 AS ?r) }""" ] .

# ==== module va:TrRunShape (trust) ====
# ============================================================
# Variant Algebra -- discovery trust rules, v1.0.0 (VAF-WI-154, 2026-10-06, plan Amendment 8)
# The trust of every entity in a context is measured from its independent witnesses (owner ruling 2026-10-06: no kind of document is an
# exception; findings from every source are consolidated and measured). A trust record holds a vector of numbers, a level named from the
# vector by thresholds kept as data rows (va:TrustLevel), and the witnesses. All decisions are rules and data (va:Decision_NoDecisionsInCode_2026_09_28).
# Stipulations (L-116; proposals with alternatives; see the plan, Amendment 8):
#   1 entities: a question, and any entity a claim names, in the context (more kinds join by adding a witness rule at stratum 26)
#   2 a witness is a ground present in the context that is not undetermined; for a question when its claim speaks to it, for an entity when its
#     claim names it; an open incident applied to a question, and every witness of an opposing question, speak against it
#   3 origin = the file and the kind of source; witnesses of one origin on one side count once
#   4 vector: C origins for, X origins against, I kinds of source among the origins for, S highest prior among them (authority rank), R reach
#   5 level = highest numbered row of va:TrustLevel whose minimums the vector meets, on net support N = C - X; contested when X > 0
#   6 (VAF-WI-158, plan Amendment 11) P = origins for the record that are not read only by a language model (a witness whose source has a reader of a kind
#     other than va:RkLanguageModel); a source with no recorded reader is not credited; levels T3 and T4 need P >= 1, so a language-model-only record is capped at T2
#   8 (VAF-WI-160, plan Amendment 13) opinion: belief, disbelief, uncertainty and expectation of every record from its origins for (r) and against (s) with the parameters of
#     va:OpinionModel_Default (prior weight W, base rate a): b = r/(r+s+W) (computed in double precision: exact decimal division overflows for thirds), d = s/(r+s+W), u = W/(r+s+W), E = b + a*u; each origin is one unit of evidence; the levels are not changed by it
#   7 (VAF-WI-159, plan Amendment 12) origin: sources joined by a dependence (an identical copy under another path, or a derivation the maintainer declared) are one origin; the group takes
#     the file and kind of its smallest origin key; a source with no dependence keeps its own file and kind
# Strata: 24 dependences between sources   25 origin of each source   26 records, witnesses, origins   27 counts, reach, strength of each origin   28 strength   29 zero fill   30 net, contested   31 level   32 opinion
# ============================================================

va:TrRunShape a sh:NodeShape ; sh:targetClass va:TrRun ;
    rdfs:label "The trust rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d a va:SourceDependence ; va:depFrom ?s ; va:depOn ?t ; va:dependenceBasis va:DepIdenticalContent }
        WHERE { $this a va:TrRun . ?s a va:Source ; va:sourceSha256 ?h ; va:sourcePath ?p1 . ?t a va:Source ; va:sourceSha256 ?h ; va:sourcePath ?p2 . FILTER(STR(?p1) < STR(?p2))
 BIND(IRI(CONCAT("urn:vaf:tr:dep:", MD5(CONCAT(STR(?s), STR(?t), "identical")))) AS ?d) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?d a va:SourceDependence ; va:depFrom ?s ; va:depOn ?t ; va:dependenceBasis va:DepDeclaredDerivation }
        WHERE { $this a va:TrRun . ?s va:derivedFromSource ?t . BIND(IRI(CONCAT("urn:vaf:tr:dep:", MD5(CONCAT(STR(?s), STR(?t), "declared")))) AS ?d) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?s va:srcOriginKey ?mk ; va:srcOriginKind ?mkind }
        WHERE { $this a va:TrRun . { SELECT ?s (MIN(?tk) AS ?mk) WHERE { ?s a va:Source ; va:sourceKind ?sk0 . ?s ((^va:depFrom/va:depOn)|(^va:depOn/va:depFrom))* ?t . ?t va:sourceKind ?tsk . OPTIONAL { ?t va:sourcePath ?tp }
 BIND(CONCAT(COALESCE(STR(?tp), STR(?t)), "|", STR(?tsk)) AS ?tk) } GROUP BY ?s }
 BIND(IRI(STRAFTER(?mk, "|")) AS ?mkind) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:TrRecord ; va:trOf ?q ; va:trIn ?ctx ; va:trEntityKind "question" }
        WHERE { $this va:ipTarget ?ctx . ?q a va:AgQuestion ; va:agHeldIn ?ctx . BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec a va:TrRecord ; va:trOf ?e ; va:trIn ?ctx ; va:trEntityKind "entity" }
        WHERE { $this va:ipTarget ?ctx . ?c a va:RelationClaim ; va:holdsIn ?ctx . { ?c va:claimSubject ?e } UNION { ?c va:claimObject ?e } FILTER(isIRI(?e)) BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?e), STR(?ctx))))) AS ?rec) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?w a va:TrWitness ; va:trWitnessOf ?rec ; va:trStance "for" ; va:trVia ?g ; va:trPrior ?pr ; va:trBackedBy ?b .
 ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" ; va:trOriginKey ?ok ; va:trOriginKind ?sk }
        WHERE { $this va:ipTarget ?ctx . ?c va:agSpeaksTo ?q ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g .
 ?g va:groundKind ?k . FILTER(?k != va:GroundUndetermined)
 ?g va:groundedBySource ?s . ?s va:authorityLevel ?au ; va:srcOriginKey ?ok ; va:srcOriginKind ?sk . ?au va:authorityRank ?pr .
 BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec)
 BIND(IRI(CONCAT("urn:vaf:tr:w:", MD5(CONCAT(STR(?rec), STR(?g), "for")))) AS ?w)
 BIND(IRI(CONCAT("urn:vaf:tr:b:", MD5(CONCAT(STR(?rec), ?ok, "for")))) AS ?b) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?w a va:TrWitness ; va:trWitnessOf ?rec ; va:trStance "for" ; va:trVia ?g ; va:trPrior ?pr ; va:trBackedBy ?b .
 ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" ; va:trOriginKey ?ok ; va:trOriginKind ?sk }
        WHERE { $this va:ipTarget ?ctx . ?c a va:RelationClaim ; va:holdsIn ?ctx ; va:hasGround ?g . { ?c va:claimSubject ?e } UNION { ?c va:claimObject ?e } FILTER(isIRI(?e)) $this va:ipPresent ?g .
 ?g va:groundKind ?k . FILTER(?k != va:GroundUndetermined)
 ?g va:groundedBySource ?s . ?s va:authorityLevel ?au ; va:srcOriginKey ?ok ; va:srcOriginKind ?sk . ?au va:authorityRank ?pr .
 BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?e), STR(?ctx))))) AS ?rec)
 BIND(IRI(CONCAT("urn:vaf:tr:w:", MD5(CONCAT(STR(?rec), STR(?g), "for")))) AS ?w)
 BIND(IRI(CONCAT("urn:vaf:tr:b:", MD5(CONCAT(STR(?rec), ?ok, "for")))) AS ?b) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:trOpposes ?q2 . ?q2 va:trOpposes ?q }
        WHERE { ?q a va:AgQuestion ; va:agKind "obliged" ; va:agSubject ?s . ?q2 a va:AgQuestion ; va:agKind "forbidden" ; va:agSubject ?s . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:trOpposes ?q2 }
        WHERE { ?q a va:AgQuestion ; va:agKind "order" ; va:agSubject ?a ; va:agObject ?b . ?q2 a va:AgQuestion ; va:agKind "order" ; va:agSubject ?b ; va:agObject ?a . FILTER(?q != ?q2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?q va:trOpposes ?q2 . ?q2 va:trOpposes ?q }
        WHERE { ?q a va:AgQuestion ; va:agKind "requires" ; va:agSubject ?s ; va:agObject ?t . ?q2 a va:AgQuestion ; va:agKind "prevents" ; va:agSubject ?s ; va:agObject ?t . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?w a va:TrWitness ; va:trWitnessOf ?rec ; va:trStance "against" ; va:trVia ?g ; va:trPrior ?pr ; va:trBackedBy ?b .
 ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "against" ; va:trOriginKey ?ok ; va:trOriginKind ?sk }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx ; va:trOpposes ?q2 . ?c va:agSpeaksTo ?q2 ; va:holdsIn ?ctx ; va:hasGround ?g . $this va:ipPresent ?g .
 ?g va:groundKind ?k . FILTER(?k != va:GroundUndetermined)
 ?g va:groundedBySource ?s . ?s va:authorityLevel ?au ; va:srcOriginKey ?ok ; va:srcOriginKind ?sk . ?au va:authorityRank ?pr .
 BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec)
 BIND(IRI(CONCAT("urn:vaf:tr:w:", MD5(CONCAT(STR(?rec), STR(?g), "against")))) AS ?w)
 BIND(IRI(CONCAT("urn:vaf:tr:b:", MD5(CONCAT(STR(?rec), ?ok, "against")))) AS ?b) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?w a va:TrWitness ; va:trWitnessOf ?rec ; va:trStance "against" ; va:trVia ?i ; va:trPrior ?pr ; va:trBackedBy ?b .
 ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "against" ; va:trOriginKey ?ok ; va:trOriginKind ?sk }
        WHERE { $this va:ipTarget ?ctx . ?q va:agHeldIn ?ctx . ?i a va:Incident ; va:agAppliesTo ?q ; va:incResolution "open" ; va:incOpened ?op ; va:incHoldsIn ?ctx ; va:incFromSource ?s .
 OPTIONAL { ?ctx va:validFrom ?vf } OPTIONAL { ?ctx va:validUntil ?vu } FILTER((!BOUND(?vf) || ?op >= ?vf) && (!BOUND(?vu) || ?op <= ?vu))
 ?s va:authorityLevel ?au ; va:srcOriginKey ?ok ; va:srcOriginKind ?sk . ?au va:authorityRank ?pr .
 BIND(IRI(CONCAT("urn:vaf:tr:rec:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?rec)
 BIND(IRI(CONCAT("urn:vaf:tr:w:", MD5(CONCAT(STR(?rec), STR(?i), "against")))) AS ?w)
 BIND(IRI(CONCAT("urn:vaf:tr:b:", MD5(CONCAT(STR(?rec), ?ok, "against")))) AS ?b) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?w va:trReaderKind ?rk }
        WHERE { ?w a va:TrWitness ; va:trVia ?g . ?g va:groundedBySource ?s . ?s va:readBy ?r . ?r va:readerKind ?rk }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trNonModel ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?b) AS ?n) WHERE { ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" . ?w va:trBackedBy ?b ; va:trReaderKind ?rk . FILTER(?rk != va:RkLanguageModel) } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?b va:trBackingStrength ?m }
        WHERE { { SELECT ?b (MAX(?pr) AS ?m) WHERE { ?w a va:TrWitness ; va:trBackedBy ?b ; va:trPrior ?pr } GROUP BY ?b } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trCorroboration ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?b) AS ?n) WHERE { ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trContradiction ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?b) AS ?n) WHERE { ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "against" } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trIndependence ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?sk) AS ?n) WHERE { ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" ; va:trOriginKind ?sk } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trReach ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?dep) AS ?n) WHERE { ?rec a va:TrRecord ; va:trEntityKind "question" ; va:trOf ?q ; va:trIn ?ctx .
     { ?dep va:agMetThrough ?q . ?dep va:agHeldIn ?ctx } UNION { ?dep a va:DeDerived ; va:deVia ?q } } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trReach ?n }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?q) AS ?n) WHERE { ?rec a va:TrRecord ; va:trEntityKind "entity" ; va:trOf ?e ; va:trIn ?ctx .
     ?c va:holdsIn ?ctx ; va:agSpeaksTo ?q . { ?c va:claimSubject ?e } UNION { ?c va:claimObject ?e } } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 28 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trStrength ?m }
        WHERE { { SELECT ?rec (MAX(?bs) AS ?m) WHERE { ?b a va:TrBacking ; va:trBackingOf ?rec ; va:trStance "for" ; va:trBackingStrength ?bs } GROUP BY ?rec } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trCorroboration 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trCorroboration ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trContradiction 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trContradiction ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trIndependence 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trIndependence ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trStrength 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trStrength ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trReach 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trReach ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 29 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trNonModel 0 }
        WHERE { ?rec a va:TrRecord . FILTER NOT EXISTS { ?rec va:trNonModel ?x } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 30 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trNet ?n }
        WHERE { ?rec va:trCorroboration ?c ; va:trContradiction ?x . BIND(?c - ?x AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 30 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trContested true }
        WHERE { ?rec va:trContradiction ?x . FILTER(?x > 0) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 30 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trContested false }
        WHERE { ?rec va:trContradiction ?x . FILTER(?x = 0) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 31 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trLevel ?l }
        WHERE { ?rec va:trNet ?n ; va:trIndependence ?i ; va:trStrength ?st ; va:trNonModel ?p . ?l va:trLevelNumber ?ln ; va:trMinNet ?mn ; va:trMinIndependence ?mi ; va:trMinStrength ?ms ; va:trMinNonModel ?mp .
 FILTER(?n >= ?mn && ?i >= ?mi && ?st >= ?ms && ?p >= ?mp)
 FILTER NOT EXISTS { ?l2 va:trLevelNumber ?ln2 ; va:trMinNet ?mn2 ; va:trMinIndependence ?mi2 ; va:trMinStrength ?ms2 ; va:trMinNonModel ?mp2 . FILTER(?ln2 > ?ln && ?n >= ?mn2 && ?i >= ?mi2 && ?st >= ?ms2 && ?p >= ?mp2) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 32 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?rec va:trBelief ?b ; va:trDisbelief ?d ; va:trUncertainty ?u ; va:trExpectation ?e }
        WHERE { ?rec va:trCorroboration ?c ; va:trContradiction ?x . va:OpinionModel_Default va:omPriorWeight ?w ; va:omBaseRate ?a .
 BIND(xsd:double(?c) AS ?cd) BIND(xsd:double(?x) AS ?xd) BIND(xsd:double(?w) AS ?wd) BIND(xsd:double(?a) AS ?ad)
 BIND(?cd + ?xd + ?wd AS ?n) BIND(?cd / ?n AS ?b) BIND(?xd / ?n AS ?d) BIND(?wd / ?n AS ?u) BIND(?b + ?ad * ?u AS ?e) }""" ] .

# ==== module va:CalRunShape (calibration) ====
# ============================================================
# Variant Algebra -- discovery calibration rules, v1.0.0 (VAF-WI-161, 2026-10-06, plan Amendment 14)
# A measurement layer: it reads the outputs of the agreement and trust layers and writes only its own records; neither layer reads it.
# Anchors (questions whose truth reality has settled) come from incidents the agreement layer finds closed and code-fixed (verdict "holds") and from maintainer
# declarations (a relation, subject, object, context and verdict). Per anchor: the squared error of the opinion's expectation (Brier component); per context: the
# number of anchors and the mean error (none when there is no anchor); per authority level: hits, misses and the estimated reliability (h + 1) / (n + 2) beside
# the stipulated rank, which is never changed. All decisions are rules and data (va:Decision_NoDecisionsInCode_2026_09_28).
# Strata: 40 anchors   41 the trust record of an anchor   42 errors, outcomes per level   43 per-level estimates, summary
# ============================================================

va:CalRunShape a sh:NodeShape ; sh:targetClass va:TrRun ;
    rdfs:label "The calibration rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 40 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?a a va:Anchor ; va:anchorQuestion ?q ; va:anchorIn ?ctx ; va:anchorVerdict "holds" ; va:anchorBasis va:AnchorFixedIncident }
        WHERE { $this va:ipTarget ?ctx . ?q va:agFixedIncidentIn ?ctx . BIND(IRI(CONCAT("urn:vaf:cal:a:", MD5(CONCAT(STR(?q), STR(?ctx), "incident")))) AS ?a) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 40 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?a va:anchorQuestion ?q }
        WHERE { $this va:ipTarget ?ctx . ?a a va:Anchor ; va:anchorIn ?ctx ; va:anchorRel ?ek ; va:anchorSubject ?es . ?q a va:AgQuestion ; va:agKind ?ek ; va:agSubject ?es ; va:agHeldIn ?ctx .
 OPTIONAL { ?q va:agObject ?eo } OPTIONAL { ?a va:anchorObject ?ao } FILTER(!BOUND(?eo) || (BOUND(?ao) && ?ao = ?eo)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 41 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?a va:anchorRecord ?rec }
        WHERE { $this va:ipTarget ?ctx . ?a a va:Anchor ; va:anchorQuestion ?q ; va:anchorIn ?ctx . ?rec a va:TrRecord ; va:trOf ?q ; va:trIn ?ctx }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 42 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?a va:calError ?err }
        WHERE { ?a va:anchorRecord ?rec ; va:anchorVerdict ?v . ?rec va:trExpectation ?e . BIND(IF(?v = "holds", (1 - ?e) * (1 - ?e), ?e * ?e) AS ?err) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 42 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?o a va:CalOutcome ; va:calOutcomeOf ?a ; va:calLevel ?l ; va:calResult ?res }
        WHERE { ?a va:anchorRecord ?rec ; va:anchorVerdict ?v . ?w va:trWitnessOf ?rec ; va:trStance ?st ; va:trVia ?via .
 { ?via va:groundedBySource ?s } UNION { ?via va:incFromSource ?s } ?s va:authorityLevel ?l .
 BIND(IF((?v = "holds" && ?st = "for") || (?v = "fails" && ?st = "against"), "hit", "miss") AS ?res)
 BIND(IRI(CONCAT("urn:vaf:cal:o:", MD5(CONCAT(STR(?a), STR(?l), ?res)))) AS ?o) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 43 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?est a va:CalLevelEstimate ; va:calEstOf ?l ; va:calHits ?h ; va:calMisses ?m ; va:calN ?n ; va:calReliability ?r }
        WHERE { { SELECT ?l (COUNT(DISTINCT ?oh) AS ?h) (COUNT(DISTINCT ?om) AS ?m) WHERE { ?l skos:inScheme va:AuthorityScheme ; skos:broader va:AuthorityLevel .
 OPTIONAL { ?oh va:calLevel ?l ; va:calResult "hit" } OPTIONAL { ?om va:calLevel ?l ; va:calResult "miss" } } GROUP BY ?l }
 BIND(?h + ?m AS ?n) BIND((xsd:double(?h) + 1) / (xsd:double(?n) + 2) AS ?r) BIND(IRI(CONCAT("urn:vaf:cal:e:", MD5(STR(?l)))) AS ?est) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 43 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:CalSummary_run va:calAnchorCount ?n }
        WHERE { { SELECT (COUNT(DISTINCT ?a) AS ?n) WHERE { ?a va:anchorRecord ?rec } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 43 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:CalSummary_run va:calBrier ?b }
        WHERE { { SELECT (AVG(?e) AS ?b) WHERE { ?a va:calError ?e } } FILTER EXISTS { ?a2 va:calError ?x } }""" ] .

# ==== module va:CatRunShape (category_measures) ====
# ============================================================
# Variant Algebra -- discovery category measures, v1.0.0 (VAF-WI-162, 2026-10-06, plan Amendment 15)
# A measurement layer: it reads the knowledge categories (deduction) and the opinions (trust) and writes only its own records; neither layer reads it.
# Per context: how many categorized questions each of the eight categories has and the rate; the same within each relation kind; per category the mean
# expectation and mean uncertainty of its questions' opinions; per question the deviation of its expectation from its category's mean. Zero-filled counts;
# a rate or mean is absent, never invented, when its denominator or population is empty. Descriptive only: it is not an OE ceiling and mints no OE term.
# Strata: 44 category counts   45 total, counts within a kind   46 rates, kind totals, category means   47 kind rates, deviations
# ============================================================

va:CatRunShape a sh:NodeShape ; sh:targetClass va:TrRun ;
    rdfs:label "The category measure rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 44 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m a va:CatMeasure ; va:cmIn ?ctx ; va:cmCategory ?c ; va:cmCount ?n }
        WHERE { { SELECT ?ctx ?c (COUNT(DISTINCT ?q) AS ?n) WHERE { ?c skos:broader va:KnowledgeCategory . ?r va:ipTarget ?ctx .
 OPTIONAL { ?k a va:KcRecord ; va:kcCategory ?c ; va:kcIn ?ctx ; va:kcOf ?q } } GROUP BY ?ctx ?c }
 BIND(IRI(CONCAT("urn:vaf:cat:m:", MD5(CONCAT(STR(?ctx), STR(?c))))) AS ?m) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:CatSummary_run a va:CatSummary ; va:cmIn ?ctx ; va:cmTotal ?n }
        WHERE { { SELECT ?ctx (COUNT(DISTINCT ?q) AS ?n) WHERE { ?r va:ipTarget ?ctx . OPTIONAL { ?k a va:KcRecord ; va:kcIn ?ctx ; va:kcOf ?q } } GROUP BY ?ctx } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m a va:CatKindMeasure ; va:cmIn ?ctx ; va:cmKind ?kind ; va:cmCategory ?c ; va:cmCount ?n }
        WHERE { { SELECT ?ctx ?kind ?c (COUNT(DISTINCT ?q2) AS ?n) WHERE { ?c skos:broader va:KnowledgeCategory .
 { SELECT DISTINCT ?ctx ?kind WHERE { ?k0 a va:KcRecord ; va:kcIn ?ctx ; va:kcOf ?q0 . ?q0 va:agKind ?kind } }
 OPTIONAL { ?k a va:KcRecord ; va:kcCategory ?c ; va:kcIn ?ctx ; va:kcOf ?q2 . ?q2 va:agKind ?kind } } GROUP BY ?ctx ?kind ?c }
 BIND(IRI(CONCAT("urn:vaf:cat:k:", MD5(CONCAT(STR(?ctx), ?kind, STR(?c))))) AS ?m) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m va:cmRate ?rate }
        WHERE { ?m a va:CatMeasure ; va:cmIn ?ctx ; va:cmCount ?n . va:CatSummary_run va:cmIn ?ctx ; va:cmTotal ?t . FILTER(?t > 0) BIND(xsd:double(?n) / xsd:double(?t) AS ?rate) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m va:cmKindTotal ?t }
        WHERE { ?m a va:CatKindMeasure ; va:cmIn ?ctx ; va:cmKind ?kind .
 { SELECT ?ctx ?kind (SUM(?n) AS ?t) WHERE { ?x a va:CatKindMeasure ; va:cmIn ?ctx ; va:cmKind ?kind ; va:cmCount ?n } GROUP BY ?ctx ?kind } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m va:cmMeanExpectation ?me ; va:cmMeanUncertainty ?mu }
        WHERE { ?m a va:CatMeasure ; va:cmIn ?ctx ; va:cmCategory ?c .
 { SELECT ?ctx ?c (AVG(?e) AS ?me) (AVG(?u) AS ?mu) WHERE { ?k a va:KcRecord ; va:kcCategory ?c ; va:kcIn ?ctx ; va:kcOf ?q .
 ?rec a va:TrRecord ; va:trOf ?q ; va:trIn ?ctx ; va:trExpectation ?e ; va:trUncertainty ?u } GROUP BY ?ctx ?c } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 47 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?m va:cmRate ?rate }
        WHERE { ?m a va:CatKindMeasure ; va:cmCount ?n ; va:cmKindTotal ?t . FILTER(?t > 0) BIND(xsd:double(?n) / xsd:double(?t) AS ?rate) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 47 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?x a va:QuestionRelative ; va:qrQuestion ?q ; va:qrIn ?ctx ; va:qrCategory ?c ; va:qrExpectation ?e ; va:qrDeviation ?dev }
        WHERE { ?m a va:CatMeasure ; va:cmIn ?ctx ; va:cmCategory ?c ; va:cmMeanExpectation ?me .
 ?k a va:KcRecord ; va:kcCategory ?c ; va:kcIn ?ctx ; va:kcOf ?q . ?rec a va:TrRecord ; va:trOf ?q ; va:trIn ?ctx ; va:trExpectation ?e .
 BIND(?e - ?me AS ?dev) BIND(IRI(CONCAT("urn:vaf:cat:q:", MD5(CONCAT(STR(?q), STR(?ctx))))) AS ?x) }""" ] .

# ==== module va:AmRunShape (agreement_measures) ====
# ============================================================
# Variant Algebra -- discovery agreement measures, v1.0.0 (VAF-WI-163, 2026-10-06, plan Amendment 16)
# A measurement layer: it reads the trust witnesses (stance and origin) and writes only its own records; neither trust nor agreement reads it.
# Units are questions with a trust record; raters are origins (copies and declared derivations already count once); the value is the stance, for or against.
# An origin that states both stances on a question gives no single value and is left out of it (counted). A unit is pairable with two or more raters.
# Nominal Krippendorff alpha: 1 - (n - 1) S / (2 n_for n_against), S = sum of 2ab / (m - 1); raw agreement 1 - S / n. Alpha is absent when the stances never vary.
# Strata: 48 units and exclusions   49 pairable units   50 totals   51 raw agreement and alpha
# ============================================================

va:AmRunShape a sh:NodeShape ; sh:targetClass va:TrRun ;
    rdfs:label "The agreement measure rules"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 48 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?u a va:AgreementUnit ; va:auOf ?q ; va:auIn ?ctx ; va:auFor ?a }
        WHERE { { SELECT ?rec ?q ?ctx (COUNT(DISTINCT ?okf) AS ?a) WHERE { ?rec a va:TrRecord ; va:trEntityKind "question" ; va:trOf ?q ; va:trIn ?ctx .
 OPTIONAL { ?wf va:trWitnessOf ?rec ; va:trStance "for" ; va:trBackedBy ?bf . ?bf va:trOriginKey ?okf .
 FILTER NOT EXISTS { ?wa va:trWitnessOf ?rec ; va:trStance "against" ; va:trBackedBy ?ba . ?ba va:trOriginKey ?okf } } } GROUP BY ?rec ?q ?ctx }
 BIND(IRI(CONCAT("urn:vaf:am:u:", MD5(STR(?rec)))) AS ?u) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 48 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?u va:auAgainst ?b }
        WHERE { { SELECT ?rec (COUNT(DISTINCT ?oka) AS ?b) WHERE { ?rec a va:TrRecord ; va:trEntityKind "question" .
 OPTIONAL { ?wa va:trWitnessOf ?rec ; va:trStance "against" ; va:trBackedBy ?ba . ?ba va:trOriginKey ?oka .
 FILTER NOT EXISTS { ?wf va:trWitnessOf ?rec ; va:trStance "for" ; va:trBackedBy ?bf . ?bf va:trOriginKey ?oka } } } GROUP BY ?rec }
 BIND(IRI(CONCAT("urn:vaf:am:u:", MD5(STR(?rec)))) AS ?u) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 49 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { ?u va:auSize ?m ; va:auDisagree ?d }
        WHERE { ?u a va:AgreementUnit ; va:auFor ?a ; va:auAgainst ?b . BIND(?a + ?b AS ?m) FILTER(?m >= 2)
 BIND(2 * xsd:double(?a) * xsd:double(?b) / (xsd:double(?m) - 1) AS ?d) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 50 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:AgreementMeasure_run a va:AgreementMeasure ; va:amIn ?ctx ; va:amUnits ?n ; va:amValues ?v ; va:amFor ?f ; va:amAgainst ?g ; va:amDisagreeSum ?s }
        WHERE { $this va:ipTarget ?ctx . { SELECT (COUNT(DISTINCT ?u) AS ?n) (SUM(?m) AS ?v) (SUM(?a) AS ?f) (SUM(?b) AS ?g) (SUM(?d) AS ?s) WHERE { ?u a va:AgreementUnit ; va:auFor ?a ; va:auAgainst ?b .
 OPTIONAL { ?u va:auSize ?m ; va:auDisagree ?d } FILTER(BOUND(?m)) } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 50 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:AgreementMeasure_run va:amExcluded ?x }
        WHERE { { SELECT (COUNT(DISTINCT ?pair) AS ?x) WHERE { ?rec a va:TrRecord ; va:trEntityKind "question" .
 OPTIONAL { ?wf va:trWitnessOf ?rec ; va:trStance "for" ; va:trBackedBy ?bf . ?bf va:trOriginKey ?ok . ?wa va:trWitnessOf ?rec ; va:trStance "against" ; va:trBackedBy ?ba . ?ba va:trOriginKey ?ok
 BIND(CONCAT(STR(?rec), "|", ?ok) AS ?pair) } } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 51 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:AgreementMeasure_run va:amRaw ?raw }
        WHERE { va:AgreementMeasure_run va:amValues ?v ; va:amDisagreeSum ?s . FILTER(?v > 0) BIND(1 - xsd:double(?s) / xsd:double(?v) AS ?raw) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 51 ; sh:prefixes <http://example.org/vaf-consolidated/shapes> ; sh:construct """
        CONSTRUCT { va:AgreementMeasure_run va:amAlpha ?alpha }
        WHERE { va:AgreementMeasure_run va:amValues ?v ; va:amFor ?f ; va:amAgainst ?g ; va:amDisagreeSum ?s . FILTER(?f > 0 && ?g > 0)
 BIND(1 - (xsd:double(?v) - 1) * xsd:double(?s) / (2 * xsd:double(?f) * xsd:double(?g)) AS ?alpha) }""" ] .

# ==== file vaf_invariants_v1_1_0.ttl ====
@prefix : <http://example.org/vaf/invariants#> .
@prefix vai: <http://example.org/vaf/invariants#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix vax: <http://example.org/variant-algebra-shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix redo: <http://example.org/redo#> .
@prefix oe: <http://example.org/ontology-engineering#> .


:Shape_Lock1_NoHeuristicNames a sh:NodeShape ;
    rdfs:label "Lock #1 shape: detect lingering Heuristic-prefixed identifiers in non-deprecated content"@en ;
    sh:targetClass va:DetectionCalculus ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this a va:DetectionCalculus .
                FILTER (REGEX(STR($this), \"Heuristic\", \"i\") &&
                        NOT EXISTS { $this owl:deprecated true })
            }
        """ ;
        sh:message "Lock #1 violation: DetectionCalculus instance has 'Heuristic' in IRI but is not marked owl:deprecated. Per blueprint v3.0.4 lock #1, the rename is complete; only deprecated aliases may retain Heuristic prefix."@en ;
        sh:severity sh:Violation ;
    ] .

:Shape_Lock2_NoLLMImports a sh:NodeShape ;
    rdfs:label "Lock #2 shape: no LLM library imports in synthesis modules"@en ;
    sh:targetClass va:SynthesisModule ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this ?import WHERE {
                $this va:imports ?import .
                FILTER (REGEX(STR(?import), \"^(openai|anthropic|transformers|langchain|llama|cohere|mistral)\", \"i\"))
            }
        """ ;
        sh:message "Lock #2 violation: synthesis module imports an LLM library. The synthesis engine is the algebraic inverse of analysis; no LLM, no retrieval. Move LLM-assisted code emission to a presentation layer outside the engine."@en ;
        sh:severity sh:Violation ;
    ] .

:Shape_Lock3_ComplexityRequired a sh:NodeShape ;
    rdfs:label "Lock #3 shape: complexity metadata required on operators"@en ;
    sh:targetClass va:Operator ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this rdfs:subClassOf+ va:Operator .
                FILTER NOT EXISTS { $this owl:deprecated true }
                FILTER NOT EXISTS { $this va:hasComputationalComplexity ?c }
            }
        """ ;
        sh:message "Lock #3 violation: active operator class has no va:hasComputationalComplexity. Every operator must declare its complexity to support the brute-force-replacement audit (lock #3)."@en ;
        sh:severity sh:Violation ;
    ] .

:Shape_Lock4_BodySegmentPresent a sh:NodeShape ;
    rdfs:label "Lock #4 part A: BodySegment + Aspect classes must exist"@en ;
    sh:targetNode va:BodySegment ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:Class ;
        sh:message "Lock #4 part A violation: va:BodySegment must be declared as owl:Class."@en ;
    ] .

:Shape_Lock4_PrecedesIsRelation a sh:NodeShape ;
    rdfs:label "Lock #4 part B: va:precedes must NOT be subClassOf va:Operator"@en ;
    sh:targetNode va:precedes ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this rdfs:subClassOf+ va:Operator .
            }
        """ ;
        sh:message "Lock #4 part B violation: va:precedes must be a relation (ObjectProperty), NOT a subclass of va:Operator. Segment ordering preserves operator-reuse purity."@en ;
        sh:severity sh:Violation ;
    ] .

# Shape A: any non-core operator MUST have justification metadata
:Shape_Lock5_NewOperatorRequiresJustification a sh:NodeShape ;
    rdfs:label "Lock #5A shape: non-core operators MUST declare extension metadata"@en ;
    sh:targetSubjectsOf rdfs:subClassOf ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this rdfs:subClassOf+ va:Operator .
                FILTER NOT EXISTS { $this owl:deprecated true }
                FILTER (
                    $this != va:AdditionOperator && $this != va:SubtractionOperator &&
                    $this != va:CartesianOperator && $this != va:DivisionOperator &&
                    $this != va:InverseOperator && $this != va:IntersectionOperator &&
                    $this != va:OrOperator && $this != va:ExclusiveOperator &&
                    $this != va:OptionalOperator && $this != va:DependencyOperator &&
                    $this != va:RepetitionOperator && $this != va:MandatoryOperator
                )
                FILTER (
                    NOT EXISTS { $this va:isCoreOperator false } ||
                    NOT EXISTS { $this va:operatorJustification ?j } ||
                    NOT EXISTS { $this va:operatorSemanticNonOverlap ?n } ||
                    NOT EXISTS { $this va:notExpressibleByCalculi ?e } ||
                    NOT EXISTS { $this va:approvalProvenance ?p }
                )
            }
        """ ;
        sh:message "Lock #5A violation: non-core operator class lacks one or more required extension metadata properties (va:isCoreOperator false, va:operatorJustification, va:operatorSemanticNonOverlap, va:notExpressibleByCalculi, va:approvalProvenance). Per user direction 2026-04-30T09:37:13, new operators ARE permitted, but only when calculi need cannot be answered by existing operators AND the new operator declares its justification, non-overlap evidence, and approval provenance."@en ;
        sh:severity sh:Violation ;
    ] .

# Shape B: the 12 core operators MUST remain present and not deprecated together
# (one deprecation might be ok with cause, but wholesale removal is forbidden)
:Shape_Lock5_CoreOperatorListPreserved a sh:NodeShape ;
    rdfs:label "Lock #5B shape: each of the 12 core operators MUST be present in the active hierarchy"@en ;
    sh:targetNode va:AdditionOperator ;
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue va:Operator ;
        sh:message "Lock #5B violation: va:AdditionOperator must remain a subclass of va:Operator (the core 12-leaf list is preserved). To remove, first amend the goal record."@en ;
    ] .

# Note: a complete shape would target each of the 12 individually; for brevity
# only the first one is shown. CI extends this list mechanically by reading
# the core list and generating one shape per core operator.

# Shape C: do not reintroduce deprecated operator superclasses
# (Lock #5b commitment from blueprint v3.0.4)
:Shape_Lock5_NoOperatorSuperclassReintroduction a sh:NodeShape ;
    rdfs:label "Lock #5C shape: do not reintroduce deprecated operator superclasses as active subclasses"@en ;
    sh:targetClass va:Operator ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this rdfs:subClassOf va:Operator .
                FILTER ($this = va:AlgebraicOperator || $this = va:VariabilityOperator || $this = va:StructuralOperator)
                FILTER NOT EXISTS { $this owl:deprecated true }
            }
        """ ;
        sh:message "Lock #5C violation: a deprecated operator superclass (va:AlgebraicOperator / va:VariabilityOperator / va:StructuralOperator) is present without owl:deprecated true. Per blueprint v3.0.4 lock #5b, these superclasses remain only as deprecated for backward compatibility; they MUST NOT be active in the hierarchy."@en ;
        sh:severity sh:Violation ;
    ] .

:Shape_Lock6_CountVerified a sh:NodeShape ;
    rdfs:label "Lock #6c shape: count gate (external CI script)"@en ;
    sh:targetNode <http://example.org/variant-algebra/v3.2.0> ;
    rdfs:comment "Enforced by tools/check_v320_count.py (rdflib enumeration). Expected 96 classes / 145 properties for the v3.2.0 cut. Note v3.2.x patches MAY add classes for legitimate operator extensions per the v1.1.0 conditional-closure rule; the count gate then becomes an inequality with required disclosure of every increment in the version-history footnote."@en .

:Shape_Lock7_AssemblyNotOperator a sh:NodeShape ;
    rdfs:label "Lock #7 part A: va:Assembly must NOT be subclass of va:Operator"@en ;
    sh:targetNode va:Assembly ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this rdfs:subClassOf+ va:Operator .
            }
        """ ;
        sh:message "Lock #7 part A violation: va:Assembly must NOT be a subclass of va:Operator. Assembly is a process class (prov:Activity-style), not algebraic."@en ;
        sh:severity sh:Violation ;
    ] .

:Shape_Lock7_AssemblyIsActivity a sh:NodeShape ;
    rdfs:label "Lock #7 part B: va:Assembly should be subclass of prov:Activity"@en ;
    sh:targetNode va:Assembly ;
    sh:sparql [
        sh:prefixes :SharedPrefixes ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this rdfs:subClassOf+ prov:Activity }
            }
        """ ;
        sh:message "Lock #7 part B violation: va:Assembly should be rdfs:subClassOf prov:Activity to support the process-class semantics."@en ;
        sh:severity sh:Warning ;
    ] .

:Shape_CalculusContent a sh:NodeShape ;
    rdfs:label "Calculus content shape: every DetectionCalculus MUST have executable backing"@en ;
    sh:targetClass va:DetectionCalculus ;
    sh:or (
        [ sh:property [ sh:path va:hasConstructQuery ;        sh:minCount 1 ] ]
        [ sh:property [ sh:path va:hasASTPatternDescriptor ;  sh:minCount 1 ] ]
        [ sh:property [ sh:path va:calculusImplementationSHA256 ; sh:minCount 1 ] ]
    ) ;
    sh:message "Concern #2 / Concern #3 violation: DetectionCalculus instance has no executable backing. Must declare at least one of va:hasConstructQuery (SPARQL CONSTRUCT, preferred), va:hasASTPatternDescriptor (AST pattern DSL), or va:calculusImplementationSHA256 (SHA-anchored source file)."@en ;
    sh:severity sh:Violation .

:Shape_CalculusAuthority a sh:NodeShape ;
    rdfs:label "Calculus authority shape: every operator instance MUST trace to an ontology calculus"@en ;
    sh:targetClass va:OperatorApplication ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:message "Concern #2 violation: OperatorApplication has no prov:wasGeneratedBy link to a calculus run activity. Source code must not invent operator instances; every instance must trace back to an ontology-defined va:DetectionCalculus."@en ;
    ] .

# ============================================================================
# SHARED PREFIXES for sh:sparql constraints (required by pyshacl)
# ============================================================================

:SharedPrefixes
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "vai" ; sh:namespace "http://example.org/vaf/invariants#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .

# ==== file vaf_version_conformance_shapes_v1_0_1.ttl ====
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix vx:   <http://example.org/vaf/version-conformance#> .

<http://example.org/vaf/version-conformance/shapes>
    rdfs:label "VAF version-conformance shapes"@en ;
    owl:versionInfo "1.0.1" ;
    owl:versionIRI <http://example.org/vaf/version-conformance/shapes/1.0.1> ;
    owl:priorVersion <http://example.org/vaf/version-conformance/shapes/1.0.0> ;
    rdfs:comment "VAF-WI-194. BP-D7 as SHACL-SPARQL over the inventory: header alignment, same name, and a stated prior version. The gates WP-5 and WP-6 are retired once both have agreed for a release."@en .

vx:Prefixes sh:declare [ sh:prefix "vx" ; sh:namespace "http://example.org/vaf/version-conformance#"^^xsd:anyURI ] .

vx:HeaderAlignedShape a sh:NodeShape ; sh:targetClass vx:OntologyFile ; sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "the file name token, owl:versionInfo and the owl:versionIRI token must be the same version (BP-D7)" ;
        sh:prefixes vx:Prefixes ;
        sh:select """SELECT $this WHERE { $this vx:path ?p ; vx:versionInfo ?vi ; vx:versionIRI ?iri .
            BIND(REPLACE(STR(?p), "^.*_v([0-9]+)_([0-9]+)_([0-9]+)\\\\.ttl$", "$1.$2.$3") AS ?fn)
            BIND(REPLACE(STR(?iri), "^.*/", "") AS ?it)
            FILTER (?fn != STR(?vi) || ?it != STR(?vi)) }""" ] .

vx:SameNameShape a sh:NodeShape ; sh:targetClass vx:VersionedFile ; sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a versioned file differs from its committed state under the same name (BP-D7)" ;
        sh:prefixes vx:Prefixes ;
        sh:select """SELECT $this WHERE {
            { $this vx:blobCommitted ?c ; vx:blobNow ?n . FILTER (?n != ?c) } UNION { $this vx:blobCommitted ?c ; vx:blobPrevious ?b . FILTER (?b != ?c) } }""" ] .

vx:PriorVersionShape a sh:NodeShape ; sh:targetClass vx:OntologyFile ; sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "an ontology file beyond version 1.0.0 should state owl:priorVersion" ;
        sh:prefixes vx:Prefixes ;
        sh:select """SELECT $this WHERE { $this vx:versionInfo ?vi . FILTER NOT EXISTS { $this vx:priorVersion ?x } FILTER (?vi != "1.0.0") }""" ] .

vx:CheckRecordShape a sh:NodeShape ; sh:targetClass vx:ShaclValidation ; sh:severity sh:Violation ;
    sh:property [ sh:path vx:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ;
        sh:message "a check record states exactly one content hash, 64 hexadecimal digits (VAF-WI-196)" ] ;
    sh:property [ sh:path vx:engine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "a check record states the engine and its versions" ] ;
    sh:property [ sh:path <http://www.w3.org/ns/prov#endedAtTime> ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "a check record states when it ended" ] ;
    sh:property [ sh:path <http://www.w3.org/ns/prov#generated> ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sh:ValidationReport ;
        sh:message "a check record generated exactly one validation report" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "a check record's report states no count of unaccepted violations" ;
        sh:select """SELECT $this WHERE { $this <http://www.w3.org/ns/prov#generated> ?r . FILTER NOT EXISTS { ?r <http://example.org/vaf/version-conformance#unacceptedViolations> ?n } }""" ] .

# ==== file variant_algebra_adaptive_feedback_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Adaptive Feedback SHACL-AF Rules v1.0.0 (VAF-WI-116g, 2026-09-29)
# One reusable "enough evidence" gate (observed >= threshold), used by both of Sprint 12's threshold decisions:
# whether the store holds enough QUALITY-diagnosed sessions to suggest a policy adjustment (E2), and whether a
# (component, variant) pair's count of EXHAUSTED sessions is enough to auto-blacklist it (E3) -- the same comparison,
# one implementation, per the single-implementation discipline. Until 2026-09-29 both were Python
# (variant_feedback_adaptive_v1_0_0.py). Input: one va:ThresholdCheck per gate (va:checkObserved, va:checkThreshold).
# VAF-WI-256 (2026-10-21): the two decisions that used the gate are rules as well. Policy suggestions: a request (va:PolicyAdjustmentRequest) with the
# thresholds the caller gives (va:PolicyThreshold) gets one suggestion for each relaxable dimension (cyclomatic, sloc, coupling, cohesion_lcom4, in that order)
# when the store holds a session and the sessions with a quality diagnostic reach the evidence the request needs; the suggested value is the current value
# raised by the factor and held at the largest total factor. Blacklist: a pair of component and variant whose exhausted sessions reach the threshold and
# that no entry excludes yet is added; the additions are listed in the order of the pair's first exhausted session. Python writes the sessions and the
# entries as facts, runs the rules and reads the suggestions and additions back (variant_feedback_adaptive).
# ============================================================

<http://example.org/vaf-consolidated/adaptive-feedback-rules>
    rdfs:label "VAF Adaptive Feedback SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-29"^^xsd:date ;
    dcterms:identifier "variant_algebra_adaptive_feedback_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/adaptive-feedback-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:ThresholdGateRuleShape a sh:NodeShape ; sh:targetClass va:ThresholdCheck ;
    rdfs:comment "A gate is met when its observed count reaches its threshold."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/adaptive-feedback-rules> ; sh:construct """
        CONSTRUCT { $this va:checkMet true }
        WHERE { $this a va:ThresholdCheck ; va:checkObserved ?o ; va:checkThreshold ?t . FILTER(?o >= ?t) }""" ] .

va:PolicyEvidenceGateRuleShape a sh:NodeShape ; sh:targetClass va:PolicyAdjustmentRequest ;
    rdfs:label "A policy adjustment request has an evidence gate over the sessions with a quality diagnostic"@en ;
    rdfs:comment "The gate observes the number of sessions with an attempt whose diagnostic class is QUALITY and requires the request's minimum evidence; the threshold gate rule decides whether it is met."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/adaptive-feedback-rules> ; sh:construct """
        CONSTRUCT { ?g a va:ThresholdCheck ; va:checkThreshold ?m ; va:checkObserved ?n . $this va:hasEvidenceGate ?g }
        WHERE { $this va:minEvidence ?m .
                { SELECT (COUNT(DISTINCT ?s) AS ?cnt) WHERE { ?s va:hasAttempt/va:hasDiagnostic/va:diagnosticClass "QUALITY" } }
                BIND(xsd:double(?cnt) AS ?n) BIND(IRI(CONCAT(STR($this), '__evidence')) AS ?g) }""" ] .

va:PolicySuggestionRuleShape a sh:NodeShape ; sh:targetClass va:PolicyAdjustmentRequest ;
    rdfs:label "A met evidence gate suggests raising each relaxable threshold the caller gave"@en ;
    rdfs:comment "Only loosening is suggested (tightening is a human choice); the relaxable dimensions are cyclomatic, sloc, coupling and cohesion_lcom4, listed in that order; nothing is suggested when the store holds no session. The suggested value is the current value raised by the factor, not above the largest total factor."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/adaptive-feedback-rules> ; sh:construct """
        CONSTRUCT { ?sg a va:PolicySuggestion ; va:raisesThreshold ?pt ; va:suggestedThreshold ?s ; va:suggestionEvidence ?cnt ; va:suggestionOrder ?ord }
        WHERE { $this va:hasEvidenceGate ?g ; va:adjustmentFactor ?f ; va:maxTotalFactor ?mx . ?g va:checkMet true ; va:checkObserved ?obs .
                FILTER EXISTS { ?any a va:FeedbackSession }
                ?pt a va:PolicyThreshold ; va:thresholdOf $this ; va:thresholdDimension ?dim ; va:thresholdValue ?cur .
                VALUES (?dim ?ord) { ("cyclomatic" 1) ("sloc" 2) ("coupling" 3) ("cohesion_lcom4" 4) }
                BIND(?cur * (1.0e0 + ?f) AS ?a) BIND(?cur * ?mx AS ?b) BIND(IF(?a < ?b, ?a, ?b) AS ?s)
                BIND(xsd:integer(?obs) AS ?cnt) BIND(IRI(CONCAT(STR(?pt), '__suggestion')) AS ?sg) }""" ] .

va:ExhaustionGateRuleShape a sh:NodeShape ; sh:targetClass va:ComponentVariantPair ;
    rdfs:label "Each pair with an exhausted session has an exhaustion gate against the blacklist threshold"@en ;
    rdfs:comment "The gate observes the number of the pair's sessions that ended EXHAUSTED and requires the blacklist threshold of the request; the threshold gate rule decides whether it is met."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/adaptive-feedback-rules> ; sh:construct """
        CONSTRUCT { ?g a va:ThresholdCheck ; va:checkThreshold ?t ; va:checkObserved ?n ; va:checksPair $this . $this va:hasExhaustionGate ?g }
        WHERE { { SELECT ?this (COUNT(?s) AS ?cnt) WHERE { ?s va:sessionOfPair ?this ; va:terminationReason "EXHAUSTED" } GROUP BY ?this }
                ?req a va:BlacklistUpdateRequest ; va:blacklistThreshold ?t .
                BIND(xsd:double(?cnt) AS ?n) BIND(IRI(CONCAT(STR($this), '__exhaustion')) AS ?g) }""" ] .

va:BlacklistAdditionRuleShape a sh:NodeShape ; sh:targetClass va:ComponentVariantPair ;
    rdfs:label "A pair whose exhaustion gate is met and that no entry excludes is added to the blacklist"@en ;
    rdfs:comment "The additions are listed in the order of the pair's first exhausted session in the store."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/adaptive-feedback-rules> ; sh:construct """
        CONSTRUCT { ?a a va:BlacklistAddition ; va:additionOfPair $this ; va:additionUnderRequest ?req ; va:exhaustedSessionCount ?c ; va:firstExhaustedPosition ?first }
        WHERE { $this va:hasExhaustionGate ?g . ?g va:checkMet true ; va:checkObserved ?n . ?req a va:BlacklistUpdateRequest .
                FILTER NOT EXISTS { ?e a va:BlacklistEntry ; va:entryOfPair $this }
                { SELECT ?this (MIN(?pos) AS ?first) WHERE { ?s va:sessionOfPair ?this ; va:terminationReason "EXHAUSTED" ; va:sessionPosition ?pos } GROUP BY ?this }
                BIND(xsd:integer(?n) AS ?c) BIND(IRI(CONCAT(STR($this), '__addition')) AS ?a) }""" ] .

# ==== file variant_algebra_algebraic_operator_detection_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix py:      <http://example.org/py#> .
@prefix :        <http://example.org/vaf-consolidated/algebraic-operator-detection-rules#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .



# ============================================================
# Variant Algebra — Algebraic-Operator Detection SHACL-AF Rules v1.0.0
# Real, ontology-native detection for operators that had NO prior detection
# precedent (checked directly, 2026-09-21) -- neither in Python nor in the
# existing variant_algebra_code_analysis_rules_v1_0_0.ttl (C1-C9 only).
#
# Real, owner-directed correction of process, disclosed here: an earlier
# pass this session built this detection in Python (variant_algebra_calculi_v1_0_0.py,
# C22-C29) without first checking whether the real, established, ontology-
# native pattern (harvester -> SHACL-AF CONSTRUCT, as C1-C9 already do)
# should be used instead. It should. This file, plus the matching real
# extension to 09-declarative-calculi/harvester_python_v1_0_0.py, is the
# correction -- built the same way C1-C9 were, verified the same way.
#
# Real, disclosed naming note: C22-C29 as numbers are NOT reused here --
# those numbers already, separately name a real, different, partially-built
# structured-artifact calculus family (DeploymentArtifact=C22 [complete],
# DatabaseSchema=C23, APISpecification=C24, Configuration=C25,
# OperationalMetadata=C29, per VAF_COMPLETE_SCOPE_ARCHITECTURE_v1_0_0.md),
# discovered this session after the collision had already been created in
# the Python file. This file's own rules are named for their real operator
# directly (C28InverseRuleShape etc.), not renumbered into the collision.
#
# Round 3 of round-based rollout (2026-09-21): Exclusive, Or, Addition,
# Subtraction, Cartesian, Division, Intersection added -- closing all 7
# remaining operators. Each differentially verified exact against the
# real, retained Python C22-C29/C27/C29 calculi as ground truth, positive
# and negative fixtures, matching the InverseOperator round's own method.
#
# Real, honest algorithmic note (Levitin's taxonomy, checked against each
# problem before writing any rule, not applied uniformly by default):
# Or/Addition/Subtraction/Division/Intersection are each a direct,
# single-fact existence check -- brute force is the correct, honest
# characterization for a genuinely simple problem, not an oversight.
# Cartesian's real recursive character lives in the harvester's own AST
# walk (mirrors the AST's own recursive nesting, decrease-and-conquer in
# spirit); the SHACL-AF rule itself is a direct match over the resulting
# fact. Exclusive is the one genuinely interesting case: the correctness
# condition (no attribute assigned by more than one branch, each branch
# assigns exactly one) is expressed as a real, declarative constraint
# equivalent to a single-pass hash-based check -- SPARQL's own declarative
# nature means the query states WHAT must hold; the engine's optimizer,
# not this rule, decides HOW (hash join vs nested loop).
# ============================================================

# ---- ExclusiveOperator: real if/elif chain, each branch assigns exactly
# one distinct attribute, no attribute repeated across branches. ----
va:C22ExclusiveRuleShape a sh:NodeShape ;
    sh:targetClass py:IfBranch ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { ?a1 va:proposesExclusivePairing ?a2 }
            WHERE {
                $this va:memberOfChain ?chain .
                $this va:branchAssigns ?a1 .
                ?b2 va:memberOfChain ?chain .
                ?b2 va:branchAssigns ?a2 .
                FILTER(?b2 != $this)
                FILTER(?a1 != ?a2)
                FILTER NOT EXISTS { $this va:branchAssigns ?other1 . FILTER(?other1 != ?a1) }
                FILTER NOT EXISTS { ?b2 va:branchAssigns ?other2 . FILTER(?other2 != ?a2) }
                FILTER NOT EXISTS { ?b3 va:memberOfChain ?chain . ?b3 va:branchAssigns ?a1 . FILTER(?b3 != $this) }
                FILTER NOT EXISTS { ?b4 va:memberOfChain ?chain . ?b4 va:branchAssigns ?a2 . FILTER(?b4 != ?b2) }
            }
        """ ; ] .

# ---- OrOperator: real boolean 'or' directly combining self.X reads. ----
va:C23OrRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:combinedWithOr ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesOrPairing ?b }
            WHERE { $this va:combinedWithOr ?b }
        """ ; ] .

# ---- AdditionOperator: real, single tuple-unpacking assignment in __init__. ----
va:C24AdditionRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:coAssignedInTuple ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesAdditionPairing ?b }
            WHERE { $this va:coAssignedInTuple ?b }
        """ ; ] .

# ---- SubtractionOperator: real, guarded removal. ----
va:C25SubtractionRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:removalGuardedBy ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesSubtractionPairing ?guard }
            WHERE { $this va:removalGuardedBy ?guard }
        """ ; ] .

# ---- CartesianOperator: real, nested for-loops over different self.X/self.Y. ----
va:C26CartesianRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:nestedIterationOver ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesCartesianPairing ?inner }
            WHERE { $this va:nestedIterationOver ?inner }
        """ ; ] .

# ---- DivisionOperator: real Python set '-' / '.difference()'. ----
va:C27DivisionRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setDifferenceOperand ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDivisionPairing ?b }
            WHERE { $this va:setDifferenceOperand ?b }
        """ ; ] .

# ---- IntersectionOperator: real Python set '&' / '.intersection()'. ----
va:C29IntersectionRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setIntersectionOperand ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesIntersectionPairing ?b }
            WHERE { $this va:setIntersectionOperand ?b }
        """ ; ] .

# Real, thesis section 2.2.3 semantics, matching c28_inverse_calculus exactly.
va:C28InverseRuleShape a sh:NodeShape ;
    sh:targetClass py:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesInverseRefinement ?a }
            WHERE {
                # 2026-09-25 (owner-approved, VAF-WI-080): only a real removal (del self.x) is an inverse.
                # A negated read (return not self.x) reads the value; it does not remove the feature, and
                # treating it as removal made the Shopping cart's gift-wrap absent from every variant.
                $this va:deletes ?a
            }
        """ ; ] .

# ==== file variant_algebra_behavioral_detection_rules_v1_1_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix :        <http://example.org/vaf-consolidated/behavioral-detection-rules#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra — Behavioral Detection SHACL-AF Rules v1.0.0
#
# Real, new (2026-09-23, owner-directed conversion check, following the
# tidy-up round that found C22-C29 already had shipped, ontology-native
# equivalents): C31 (guard-precondition detection) previously required
# Joern, a real, ~1.8GB external tool needing re-provisioning every
# session. Live-verified before this was written: a pure, standard-
# library ast walk on the harvester replicates C31's exact semantics
# (!=, ==, and multi-value 'in' guards) precisely, against the exact
# same real fixture (order_state_machine_v1_0_0.py) used to verify the
# original Joern-based version. No external tool needed for this
# calculus at all.
# ============================================================

owl:Ontology
    owl:versionInfo "1.2.0" ;
    rdfs:comment "1.2.0 (VAF-WI-077, 2026-09-29): rewired from py:raisesIfNotEqual/raisesIfEqual/raisesIfIn to their va: counterparts (va:raisesIfAttributeNotEqual/raisesIfAttributeEqual/raisesIfAttributeIn), now that harvester_python_v1_0_0.py emits them -- va is the canonical discovery vocabulary (owner decision, 2026-09-24). 1.1.0 (VAF-WI-116, task a): the documentation-agreement check as a rule (va:DocumentationAgreementRuleShape); until then Python (variant_behavioral_calculi_v1_0_0.py)."@en ;
    dcterms:title "Variant Algebra — Behavioral Detection SHACL-AF Rules"@en .

# ---- C31 (DependencyOperator / NegatedDependencyOperator via guard-precondition). ----
va:C31NotEqualGuardRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:raisesIfAttributeNotEqual ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesGuardDependency ?fact }
            WHERE { $this va:raisesIfAttributeNotEqual ?fact }
        """ ; ] .

va:C31EqualGuardRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:raisesIfAttributeEqual ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesGuardExclusion ?fact }
            WHERE { $this va:raisesIfAttributeEqual ?fact }
        """ ; ] .

va:C31InGuardRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:raisesIfAttributeInValue ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesGuardMultiExclusion ?fact }
            WHERE { $this va:raisesIfAttributeInValue ?fact }
        """ ; ] .

# ---- 1.1.0 (VAF-WI-116a): does a claim's value word appear as a whole word in a documentation text?
# A lexical match, disclosed as such: a match is corroborating evidence; a miss is not disagreement. A word is a run of
# the letters a-z (after lower-casing), so a value word with any other character never matches.
va:DocumentationAgreementRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:claimValueWord ;
    rdfs:label "A claim agrees with a documentation text when its value word is a whole word of the text"@en ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:agreesWithDocumentation true }
            WHERE { $this va:claimValueWord ?w ; va:claimDocumentText ?t .
                    FILTER(REGEX(STR(?w), "^[A-Za-z]+$"))
                    FILTER(REGEX(LCASE(STR(?t)), CONCAT("(^|[^a-z])", LCASE(STR(?w)), "([^a-z]|$)"))) }
        """ ; ] .

# ==== file variant_algebra_behaviour_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- behaviour classes of variants, v1.0.0 (VAF-WI-131, 2026-10-04)
# The owner's toy trace: of 1850 variants, many are different selections that do the same thing -- and some do nothing at
# all (no method a caller can use). Variants are grouped by what a probe observes (python harvests the observation);
# THIS file decides what each class is called and how it is ranked (va:Decision_NoDecisionsInCode_2026_09_28).
# Nothing is hidden (L-116: "useful" is a stipulation): every variant stays listed; a class carries a label and a rank.
#
# Input facts: va:BehaviourClass (va:bcMethods count of methods a caller can use, va:bcProbed true when a probe ran,
#              va:bcSameAsOriginal true/false, va:bcMembers number of variants in the class)
# Output facts: va:bcLabel (plain words), va:bcRank (1 = most useful)
# ============================================================

<http://example.org/vaf-consolidated/behaviour-rules>
    rdfs:label "VAF Behaviour-Class SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_behaviour_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/behaviour-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:BehaviourNoneShape a sh:NodeShape ; sh:targetClass va:BehaviourClass ;
    rdfs:label "A class with no method a caller can use has no behaviour"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcLabel "no behaviour: no method a caller can use" ; va:bcRank 3 }
        WHERE { $this va:bcMethods ?n . FILTER(?n = 0) }""" ] .

va:BehaviourSameShape a sh:NodeShape ; sh:targetClass va:BehaviourClass ;
    rdfs:label "A class a probe saw behave as the original does"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcLabel "behaves as the original on every call tried" ; va:bcRank 1 }
        WHERE { $this va:bcMethods ?n ; va:bcProbed true ; va:bcSameAsOriginal true . FILTER(?n > 0) }""" ] .

va:BehaviourDiffersShape a sh:NodeShape ; sh:targetClass va:BehaviourClass ;
    rdfs:label "A class a probe saw behave differently from the original"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcLabel "behaves differently from the original on some call" ; va:bcRank 2 }
        WHERE { $this va:bcMethods ?n ; va:bcProbed true ; va:bcSameAsOriginal false . FILTER(?n > 0) }""" ] .

va:BehaviourUnprobedShape a sh:NodeShape ; sh:targetClass va:BehaviourClass ;
    rdfs:label "A class with usable methods that no probe ran on is not judged"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcLabel "has behaviour, not probed" ; va:bcRank 2 }
        WHERE { $this va:bcMethods ?n . FILTER(?n > 0) FILTER NOT EXISTS { $this va:bcProbed true } }""" ] .

va:BehaviourGroupingShape a sh:NodeShape ; sh:targetClass va:Variant ;
    rdfs:label "Variants with a realised program that a probe observed alike are one class"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 0 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { ?cls a va:BehaviourClass ; va:bcMethods ?m ; va:bcSameAsOriginal ?s ; va:groupsVariant $this }
        WHERE { $this va:hasRealisedProgram true ; va:observationSignature ?sig ; va:observedMethodCount ?m ; va:behavesAsOriginal ?s BIND(IRI(CONCAT("urn:vaf:bclass:", MD5(?sig))) AS ?cls) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 0 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { ?cls va:bcProbed true }
        WHERE { $this va:hasRealisedProgram true ; va:probeRan true ; va:observationSignature ?sig BIND(IRI(CONCAT("urn:vaf:bclass:", MD5(?sig))) AS ?cls) }""" ] .

va:BehaviourClassFactsShape a sh:NodeShape ; sh:targetClass va:BehaviourClass ;
    rdfs:label "A class counts its variants, is represented by the smallest selection of them and starts where its first variant does"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 0.5 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcMembers ?n }
        WHERE { { SELECT ?c (COUNT(?v) AS ?n) WHERE { ?c va:groupsVariant ?v } GROUP BY ?c } FILTER(?c = $this) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 0.5 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcRepresentative ?v }
        WHERE { $this va:groupsVariant ?v . ?v va:selectionSize ?s ; va:variantPosition ?p
                FILTER NOT EXISTS { $this va:groupsVariant ?w . ?w va:selectionSize ?s2 ; va:variantPosition ?p2 FILTER(?s2 < ?s || (?s2 = ?s && ?p2 < ?p)) } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 0.5 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcFirstPosition ?p }
        WHERE { $this va:groupsVariant ?v . ?v va:variantPosition ?p
                FILTER NOT EXISTS { $this va:groupsVariant ?w . ?w va:variantPosition ?p2 FILTER(?p2 < ?p) } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 0.7 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcKey ?k }
        WHERE { $this va:bcFirstPosition ?p
                { SELECT ?c (COUNT(?o) AS ?before) WHERE { ?c a va:BehaviourClass ; va:bcFirstPosition ?pc OPTIONAL { ?o a va:BehaviourClass ; va:bcFirstPosition ?po FILTER(?po < ?pc) } } GROUP BY ?c } FILTER(?c = $this)
                BIND(CONCAT("B", STR(1 + ?before)) AS ?k) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/behaviour-rules> ; sh:construct """
        CONSTRUCT { $this va:bcOrdinal ?n }
        WHERE { $this va:bcKey ?k ; va:bcMembers ?sz OPTIONAL { $this va:bcRank ?r0 } BIND(COALESCE(?r0, 9) AS ?r)
                { SELECT ?c (COUNT(?o) AS ?n) WHERE { ?c va:bcKey ?kc ; va:bcMembers ?szc OPTIONAL { ?c va:bcRank ?rc0 } BIND(COALESCE(?rc0, 9) AS ?rc)
                        OPTIONAL { ?o va:bcKey ?ko ; va:bcMembers ?szo OPTIONAL { ?o va:bcRank ?ro0 } BIND(COALESCE(?ro0, 9) AS ?ro)
                                   FILTER(?ro < ?rc || (?ro = ?rc && ?szo > ?szc) || (?ro = ?rc && ?szo = ?szc && ?ko < ?kc)) } } GROUP BY ?c } FILTER(?c = $this) }""" ] .

# ==== file variant_algebra_candidate_review_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .



# ============================================================
# Variant Algebra -- Candidate Review SHACL-AF Rules v1.0.0 (VAF-WI-116h, 2026-09-29)
# Reviewing one raw detection item (variant_candidate_review_v1_0_0.py's review_detection_output): whether every
# name it names is a valid DSL identifier (variant_dsl_grammar_v1_0_0.lark's NAME token: starts with a letter, then
# letters/digits/underscore); whether its operator is one the DSL grammar can represent (a fixed list, held here as
# ontology data, not a Python set literal) -- with one exception, a detected Sequence/Next fact that is really a
# state move or an event, which the grammar cannot yet carry a condition or is not a feature at all; whether its
# evidence is weak (held for human review, never auto-accepted); and, in priority order (an invalid name is worse
# than being unrepresentable, which is worse than being merely weak), its disposition. Also: whether a claim's
# calculus is itself a behavioral confirmation (a fixed list, held here too), and whether an operator is relational
# (asserts a relationship between two named things, so a weakly-grounded claim about it is flagged in the
# synthesized text). Until 2026-09-29 all of this was Python (variant_candidate_review_v1_0_0.py). Input: one
# va:CandidateReview per raw item (va:reviewOperator, va:reviewCalc, va:reviewReason, va:reviewStrength, and one
# va:reviewName per name it must validate).
# ============================================================

<http://example.org/vaf-consolidated/candidate-review-rules> sh:declare [ sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ;
            sh:prefix "va" ] .

va:CandidateNameRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "Every name a candidate names is a valid DSL identifier -- no name it names fails the grammar's NAME token. A class-scoped name (exactly one dot) is valid when both parts independently pass the NAME token."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:allNamesValid true }
        WHERE { $this a va:CandidateReview .
                FILTER NOT EXISTS { $this va:reviewName ?n .
                    FILTER(!REGEX(STR(?n), "^[A-Za-z][A-Za-z0-9_]*$") && !REGEX(STR(?n), "^[A-Za-z][A-Za-z0-9_]*\\\\.[A-Za-z][A-Za-z0-9_]*$")) } }""" ] .

va:CandidateTemporalKindRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "A detected Sequence/Next fact from C33 whose reason names a state move (or the initial state) or an event -- flagged here as a temporal-kind candidate; CandidateRepresentableRuleShape below lifts the block only when a real, correlated guard condition exists (VAF-WI-064 remainder, va:hasGuardCondition), otherwise it stays not a model line: an unguarded move has no single condition to attach, and an event is not a feature at all."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:temporalKind ?k }
        WHERE { $this a va:CandidateReview ; va:reviewOperator ?op . FILTER(?op IN ("SequenceOperator", "NextOperator"))
                OPTIONAL { $this va:reviewCalc ?calc } OPTIONAL { $this va:reviewReason ?why }
                FILTER(BOUND(?calc) && STRSTARTS(?calc, "C33") && BOUND(?why))
                BIND(IF(STRSTARTS(?why, "state move") || STRSTARTS(?why, "initial state"), "state",
                        IF(STRSTARTS(?why, "event"), "event", "")) AS ?k)
                FILTER(?k != "") }""" ] .

va:CandidateGuardConditionRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-064 remainder (2026-09-29): a NextOperator candidate carries a real, correlated guard condition (va:reviewCondition, from compute_guard_conditions -- the SAME harvested method node's raisesIfNotEqual/raisesIfEqual guard fact joined to C33's own proposesStateMove fact) onto va:hasGuardCondition, when non-empty. Real evidence, not a heuristic: the condition text is the harvester's own guard fact, not guessed."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:hasGuardCondition ?c }
        WHERE { $this a va:CandidateReview ; va:reviewCondition ?c . FILTER(STRLEN(?c) > 0) }""" ] .

va:CandidateRepresentableRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "Representable: the operator is on the grammar's list (this file's own va:DSLRepresentableOperator individuals, loaded into the data alongside each review -- the executor runs a rule's CONSTRUCT against the data graph only, so ontology data a rule needs travels with it), and (for Sequence/Next) it is not a temporal-kind override -- UNLESS a real, correlated guard condition (va:hasGuardCondition, VAF-WI-064 remainder) resolves it: a guarded state move genuinely has real condition text to attach ('a -> b when cond', D3), so the block is lifted for exactly that candidate, not for every state-move candidate."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:operatorRepresentable ?rep }
        WHERE { $this a va:CandidateReview ; va:reviewOperator ?op .
                BIND(EXISTS { ?x a va:DSLRepresentableOperator ; va:operatorName ?op } AS ?inGrammar)
                BIND(EXISTS { $this va:temporalKind ?k . FILTER NOT EXISTS { $this va:hasGuardCondition ?c } } AS ?blocked)
                BIND(?inGrammar && !?blocked AS ?rep) }""" ] .

va:CandidateDispositionRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "In priority order: an invalid name is worse than being unrepresentable, which is worse than merely weak evidence; otherwise accepted."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:disposition ?d }
        WHERE { $this a va:CandidateReview ; va:reviewStrength ?strength .
                BIND(EXISTS { $this va:allNamesValid true } AS ?namesOk)
                BIND(EXISTS { $this va:operatorRepresentable true } AS ?rep)
                BIND(?strength = "weak" AS ?weak)
                BIND(IF(!?namesOk, "invalid_name", IF(!?rep, "not_representable", IF(?weak, "weak", "accepted"))) AS ?d) }""" ] .

va:CandidateBehavioralRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "A claim's calculus is itself a behavioral confirmation when it is on the behavioral-calculus list."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:fromBehavioralCalculus true }
        WHERE { $this a va:CandidateReview ; va:reviewCalc ?calc . FILTER EXISTS { ?x a va:BehavioralCalculusId ; va:calculusId ?calc } }""" ] .

va:CandidateRelationalRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "An operator is relational when it is on the relational-operator list."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:isRelationalOperator true }
        WHERE { $this a va:CandidateReview ; va:reviewOperator ?op . FILTER EXISTS { ?x a va:RelationalOperator ; va:operatorName ?op } }""" ] .

va:CandidateBadNameRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-256: the name that makes a candidate invalid, told in the note: the subject when the subject is not a valid name by itself (a group's comma-joined members never are), else the object."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:badName ?b }
        WHERE { $this a va:CandidateReview ; va:reviewSubject ?s . OPTIONAL { $this va:reviewObject ?o }
                FILTER NOT EXISTS { $this va:allNamesValid true }
                BIND(IF(REGEX(STR(?s), "^[A-Za-z][A-Za-z0-9_]*$") || REGEX(STR(?s), "^[A-Za-z][A-Za-z0-9_]*\\\\.[A-Za-z][A-Za-z0-9_]*$"), ?o, ?s) AS ?b) FILTER(BOUND(?b)) }""" ] .

va:CandidateAcceptanceRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-256: a candidate is accepted when its disposition is accepted; the kind of note it gets follows the disposition, and an accepted state move that carries a guard condition is a guarded move."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:isAccepted ?a ; va:noteKind ?k }
        WHERE { $this a va:CandidateReview ; va:disposition ?d ; va:reviewOperator ?op . OPTIONAL { $this va:hasGuardCondition ?g }
                BIND(?d = "accepted" AS ?a)
                BIND(IF(?d != "accepted", ?d, IF(?op = "NextOperator" && BOUND(?g), "guarded", "accepted")) AS ?k) }""" ] .

va:CandidateValueDomainRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-256 (C13, VAF-WI-066): an exclusive pairing whose two names are both members of one detected value domain (an enumeration) is confirmed by the source's own type system."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:confirmedByValueDomain true . ?d va:domainConfirmsCandidate $this }
        WHERE { $this a va:CandidateReview ; va:reviewOperator "ExclusiveOperator" ; va:reviewSubject ?s ; va:reviewObject ?o .
                ?d a va:ValueDomain ; va:domainHasMember ?s , ?o }""" ] .

va:CandidateRuntimeObservationRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-256 (VAF-WI-078): a state-move candidate that a runtime scenario also observed is confirmed by that observation."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:confirmedByRuntimeObservation true . ?m va:moveConfirmsCandidate $this }
        WHERE { $this a va:CandidateReview ; va:reviewOperator "NextOperator" ; va:reviewSubject ?s ; va:reviewObject ?o .
                ?m a va:RuntimeConfirmedMove ; va:moveFrom ?s ; va:moveTo ?o }""" ] .

va:CandidateLoopBoundRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ;
    rdfs:comment "VAF-WI-256 (C32): a repetition candidate whose attribute a literal-bounded loop appends to has that loop's bound as its real upper bound; where several loops append to it, the largest bound."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-review-rules> ; sh:construct """
        CONSTRUCT { $this va:realMaxBound ?mx }
        WHERE { $this a va:CandidateReview ; va:reviewOperator "RepetitionOperator" ; va:reviewSubject ?s .
                { SELECT ?s (MAX(?n) AS ?mx) WHERE { ?b a va:LoopBound ; va:boundAttribute ?s ; va:maxBound ?n } GROUP BY ?s } }""" ] .

# ==== file variant_algebra_closed_semantics_shacl_v1_0_2.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Variant Algebra -- closed semantics, shapes v1.0.2 (2026-09-28, VAF-WI-104, -107, -112, Lineage 5; deliverable: closed semantics).
# Data graph: the ontology files (01-ontologies/*.ttl), including the measured thesis laws.
# The third clause of the deliverable -- one evaluation procedure per concept -- is checked by the implementation
# register's single-implementation shape, not repeated here (one check per rule).
# Each shape is shown to fail on a known-bad input by 06-runtime/src/test_deliverable_checks_v1_0_0.py (L-95).

<http://example.org/variant-algebra/closed-semantics-shapes>
    owl:versionInfo "1.0.2" ; owl:versionIRI <http://example.org/variant-algebra/closed-semantics-shapes/1.0.2> ;
    owl:priorVersion <http://example.org/variant-algebra/closed-semantics-shapes/1.0.1> ;
    rdfs:comment "1.0.2 (VAF-WI-112): the laws are now measured under the ontology's operator rules -- the generative reading evaluates definitions by them -- and the feature-model reading, which built classifier bodies, evaluates none; a claimed law is backed when it holds under the rules."@en ;
    rdfs:comment "1.0.1 (VAF-WI-107): claimed laws are backed only by a measurement that holds under both existing implementations; neither is the semantics, which is the ontology's operator rules (va:Decision_OwnerClarification_2026_09_28). The laws are to be re-measured under those rules (VAF-WI-100)."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    rdfs:label "Variant Algebra -- closed semantics (shapes)"@en .

va:OperatorOneMeaningShape a sh:NodeShape ;
    rdfs:label "Every operator states one meaning"@en ;
    rdfs:comment "Targets the operator kinds (subclasses of va:Operator), not operator applications in instance data."@en ;
    sh:targetClass va:Operator ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This operator does not state exactly one meaning (skos:definition). The owner: operators are generic -- each has the one meaning its ontology rule states (2026-09-27, 2026-09-28)." ;
        sh:select """SELECT $this WHERE {
            $this <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ va:Operator .
            FILTER NOT EXISTS { $this <http://www.w3.org/2002/07/owl#deprecated> true }
            { SELECT $this (COUNT(?d) AS ?n) WHERE { OPTIONAL { $this <http://www.w3.org/2004/02/skos/core#definition> ?d } } GROUP BY $this }
            FILTER (?n != 1) }""" ] .

va:ClaimedLawMeasuredShape a sh:NodeShape ;
    rdfs:label "Every algebraic law an operator claims is measured to hold"@en ;
    sh:severity sh:Warning ;
    rdfs:comment "Warning: the laws of '*', '/', the identity element and the operators outside the thesis's tables cannot be measured at all. Since 1.0.2 the measurement is the operator rules' (the generative reading, VAF-WI-112). A tag contradicted by measurement is refused by the reconciliation shapes (TagMatchesMeasurementShape); this shape reports the tags not yet backed by a measurement."@en ;
    sh:targetSubjectsOf va:hasAlgebraicProperty ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This operator claims an algebraic law that no measurement backs: no thesis law of that kind on this operator alone holds under the operator rules." ;
        sh:select """SELECT $this ?value WHERE { $this va:hasAlgebraicProperty ?value .
            FILTER NOT EXISTS { ?law va:lawKind ?k ; va:lawOperator $this ; va:generativeReading "holds" . ?k va:tagValue ?value .
                                FILTER NOT EXISTS { ?law va:lawOperator ?other . FILTER (?other != $this) } } }""" ] .

va: sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

# ==== file variant_algebra_code_analysis_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Code Analysis SHACL-AF Rules v1.0.0
# Real ontology-native implementation of all 9 DetectionCalculus algorithms.
# Every rule matches on property patterns only (per the granularity design
# principle established in the operator-rules file), so it works identically
# whether the underlying Method/Attribute individuals came from a Component,
# a SuperComponent, or any other ComposableUnit context.
# ============================================================

<http://example.org/vaf-consolidated/code-analysis-rules>
    rdfs:label "VAF Code Analysis SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-07-03"^^xsd:date ;
    dcterms:identifier "variant_algebra_code_analysis_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/code-analysis-rules/1.0.0> ;
    dcterms:source "10-operator-implementation-spec/, this session. Depends on 01-ontologies/variant_algebra_v3_code_analysis_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/code-analysis-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated. All 9 detection calculi, real implementation, results verified identical to the already-tested Python calculi (variant_detection_calculi_v1_0_0.py)."@en .

# ---- C1: AttributeUsageCalculus. Reuses real va:readsAttribute/writesAttribute. ----
va:C1RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesAttributeDependency ?a }
            WHERE {
                $this va:readsAttribute ?a .
                ?a a va:Attribute .
                FILTER NOT EXISTS { $this va:writesAttribute ?a }
            }
        """ ; ] .

# ---- C2: MethodCallCalculus ----
va:C2RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesCallDependency ?called }
            WHERE { $this va:callsSelfMethod ?called }
        """ ; ] .

# ---- C3: InitDependencyCalculus. Reuses real va:readsAttribute; new va:isInitDeclared. ----
va:C3RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesInitDependency true }
            WHERE {
                $this va:readsAttribute ?a .
                ?a a va:Attribute .
            }
        """ ; ] .

# ---- C4: ExternalCallCalculus ----
va:C4RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesExternalDependency ?f }
            WHERE { $this va:callsExternalFunction ?f }
        """ ; ] .

# ---- C5: DecoratorRoleCalculus. Reuses real va:hasDecorator. ----
va:C5RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesOperatorRefinement ?op }
            WHERE {
                { $this va:hasDecorator 'property' . BIND('MandatoryOperator' AS ?op) }
                UNION
                { $this va:hasDecorator ?d . FILTER(?d = 'classmethod' || ?d = 'staticmethod') . BIND('OptionalOperator' AS ?op) }
            }
        """ ; ] .

# ---- C6: CollectionInitCalculus ----
va:C6RuleShape a sh:NodeShape ;
    sh:targetClass va:Attribute ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesOperatorRefinement 'RepetitionOperator' }
            WHERE { $this va:isCollectionTyped true }
        """ ; ] .

# ---- C7: TransitiveClosureCalculus. Operates over C2's own output edges (2-hop,
# same UNION-chain technique already proven in the operator-rules Layer 1). ----
va:C7RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesTransitiveDependency ?c }
            WHERE {
                $this va:callsSelfMethod ?b .
                ?b va:callsSelfMethod ?c .
                FILTER NOT EXISTS { $this va:callsSelfMethod ?c }
            }
        """ ; ] .

# ---- C8: CrossFileCallCalculus ----
va:C8RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesExternalDependency ?resolved }
            WHERE { $this va:callsResolvedCrossFile ?resolved }
        """ ; ] .

# ---- C9: ExternalSymbolCalculus ----
va:C9RuleShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesExternalDependency ?sym }
            WHERE { $this va:callsUnresolvedExternal ?sym }
        """ ; ] .

# ==== file variant_algebra_definitions_shacl_v2_0_0.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Variant Algebra -- well-defined definitions, shapes v2.0.0 (2026-09-28).
# Each shape is shown to fail on a known-bad model by 06-runtime/src/test_definitions_v1_0_0.py (L-95).

<http://example.org/variant-algebra/definitions-shapes>
    owl:versionInfo "2.0.0" ; owl:versionIRI <http://example.org/variant-algebra/definitions-shapes/2.0.0> ;
    owl:priorVersion <http://example.org/variant-algebra/definitions-shapes/1.0.0> ;
    rdfs:comment "2.0.0 (VAF-WI-122, breaking): the refusal of a variable defined through itself is removed -- recursion is allowed (va:Decision_RecursionAllowed_2026_09_28); the operator rules evaluate it to its least closed set and refuse only recursion through a negation (va:RecursionThroughNegationRuleShape)."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    rdfs:label "Variant Algebra -- well-defined definitions (shapes)"@en .

va:VariableHasOneDefinitionShape a sh:NodeShape ;
    rdfs:label "Every variable has exactly one definition"@en ;
    sh:targetClass va:Variable ;
    sh:property [ sh:path va:hasDefinition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Definition ;
        sh:message "A variable must have exactly one definition (thesis Figure 3.1: one equation per variable)." ] .

va:DefinitionShape a sh:NodeShape ;
    rdfs:label "A definition defines one variable, is written out, and names at least one feature"@en ;
    sh:targetClass va:Definition ;
    sh:property [ sh:path va:defines ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Variable ;
        sh:message "A definition defines exactly one variable." ] ;
    sh:property [ sh:path va:definingExpression ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A definition carries its expression as written." ] ;
    sh:property [ sh:path va:usesName ; sh:minCount 1 ;
        sh:message "A definition names at least one variable or terminal." ] .

va:UsedNameHasStatusShape a sh:NodeShape ;
    rdfs:label "Every name a definition uses is a variable or a terminal"@en ;
    sh:targetObjectsOf va:usesName ;
    sh:or ( [ sh:class va:Variable ] [ sh:class va:TerminalFeature ] ) ;
    sh:message "A name used in a definition is either defined (a variable) or a terminal; it may not be neither." .

va:TerminalNotDefinedShape a sh:NodeShape ;
    rdfs:label "A terminal has no definition"@en ;
    sh:targetClass va:TerminalFeature ;
    sh:property [ sh:path va:hasDefinition ; sh:maxCount 0 ;
        sh:message "A terminal cannot be defined further (thesis section 3.5); a name with a definition is a variable." ] .

va: sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

# ==== file variant_algebra_dependence_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Dependence SHACL-AF Rules v1.0.0 (VAF-WI-130 and VAF-WI-133, 2026-10-04)
# Which members of a class a variant needs in order to be a working program is decided here, over the program's
# harvested members, not in Python (va:Decision_NoDecisionsInCode_2026_09_28). Python only harvests the members
# (methods, attributes, state values, exceptions) and how each method uses them, and reads the decided relations back.
#
# Input facts (see variant_dependence_model_v1_0_0.py):
#   va:DepAtom   a member of a class; va:depClass, va:depKind (method | attribute | state value | exception),
#                va:depValueOf (a state value's attribute)
#   va:DepUsage  one use of a member by a method: va:usageBy (the method), va:usageOf (the member), va:usageRole:
#                reads | writes | assigns (a value, outside the constructor) | initialises (a value, in the
#                constructor) | raises | calls. (A test of an attribute against a value is NOT a need: a guard on a value
#                the variant leaves out is simply absent, the realisation drops it. A guard that RAISES unless the attribute
#                holds a value is a precondition, which the guard calculus (C31) already reports.)
# Output facts: va:DepRelation (va:relFrom, va:relTo, va:relKind, va:relWhy): relFrom needs relTo.
# ============================================================

<http://example.org/vaf-consolidated/dependence-rules>
    rdfs:label "VAF Dependence SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_dependence_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/dependence-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:DepValueOfShape a sh:NodeShape ; sh:targetClass va:DepAtom ;
    rdfs:label "A state value exists only as a value of its attribute"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom $this ; va:relTo ?a ; va:relKind "value of attribute" ;
                    va:relWhy "a state value is a value of its attribute, so it cannot exist without it" }
        WHERE { $this va:depValueOf ?a .
                BIND(IRI(CONCAT("urn:vaf:rel:valueof:", STRAFTER(STR($this), "urn:vaf:atom:"), ":", STRAFTER(STR(?a), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepUsesAttributeShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "A method needs the attributes it reads or writes"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?m ; va:relTo ?x ; va:relKind "uses attribute" ;
                    va:relWhy "the method reads or writes this attribute, so the attribute must be there" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?x ; va:usageRole ?role . ?x va:depKind "attribute" . ?m va:depKind "method" .
                FILTER (?role IN ("reads", "writes"))
                BIND(IRI(CONCAT("urn:vaf:rel:uses:", STRAFTER(STR(?m), "urn:vaf:atom:"), ":", STRAFTER(STR(?x), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepCallsShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "A method needs the methods it calls"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?m ; va:relTo ?x ; va:relKind "calls method" ;
                    va:relWhy "the method calls this method, so it must be there" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?x ; va:usageRole "calls" . ?m va:depKind "method" . ?x va:depKind "method" .
                BIND(IRI(CONCAT("urn:vaf:rel:calls:", STRAFTER(STR(?m), "urn:vaf:atom:"), ":", STRAFTER(STR(?x), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepProducedByShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "A state value that only one method ever sets, and that the constructor does not set, needs that method"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?v ; va:relTo ?m ; va:relKind "reached by method" ;
                    va:relWhy "the attribute takes this value only in this one method, so without the method the value is never reached" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?v ; va:usageRole "assigns" . ?v va:depKind "state value" . ?m va:depKind "method" .
                FILTER NOT EXISTS { ?i va:usageOf ?v ; va:usageRole "initialises" }
                FILTER NOT EXISTS { ?u2 va:usageOf ?v ; va:usageRole "assigns" ; va:usageBy ?m2 . FILTER (?m2 != ?m) }
                BIND(IRI(CONCAT("urn:vaf:rel:reached:", STRAFTER(STR(?v), "urn:vaf:atom:"), ":", STRAFTER(STR(?m), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepRaisedByShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "An exception that only one method ever raises needs that method"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?e ; va:relTo ?m ; va:relKind "raised by method" ;
                    va:relWhy "only this method raises the exception, so without the method it is never raised" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?e ; va:usageRole "raises" . ?e va:depKind "exception" . ?m va:depKind "method" .
                FILTER NOT EXISTS { ?u2 va:usageOf ?e ; va:usageRole "raises" ; va:usageBy ?m2 . FILTER (?m2 != ?m) }
                BIND(IRI(CONCAT("urn:vaf:rel:raised:", STRAFTER(STR(?e), "urn:vaf:atom:"), ":", STRAFTER(STR(?m), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepRaisedByAnyShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "An exception that several methods raise needs at least one of them"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?e ; va:relTo ?m ; va:relKind "raised by one of" ;
                    va:relWhy "several methods raise the exception, so it needs at least one of them or it is never raised" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?e ; va:usageRole "raises" . ?e va:depKind "exception" . ?m va:depKind "method" .
                ?u2 va:usageOf ?e ; va:usageRole "raises" ; va:usageBy ?m2 . FILTER (?m2 != ?m)
                BIND(IRI(CONCAT("urn:vaf:rel:raisedany:", STRAFTER(STR(?e), "urn:vaf:atom:"), ":", STRAFTER(STR(?m), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

va:DepReachedByAnyShape a sh:NodeShape ; sh:targetClass va:DepUsage ;
    rdfs:label "A state value that several methods set, and that the constructor does not set, needs at least one of them"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/dependence-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DepRelation ; va:relFrom ?v ; va:relTo ?m ; va:relKind "reached by one of" ;
                    va:relWhy "several methods set this value, so without at least one of them the value is never reached" }
        WHERE { $this va:usageBy ?m ; va:usageOf ?v ; va:usageRole "assigns" . ?v va:depKind "state value" . ?m va:depKind "method" .
                FILTER NOT EXISTS { ?i va:usageOf ?v ; va:usageRole "initialises" }
                ?u2 va:usageOf ?v ; va:usageRole "assigns" ; va:usageBy ?m2 . FILTER (?m2 != ?m)
                BIND(IRI(CONCAT("urn:vaf:rel:reachedany:", STRAFTER(STR(?v), "urn:vaf:atom:"), ":", STRAFTER(STR(?m), "urn:vaf:atom:"))) AS ?rel) }
    """ ] .

# ==== file variant_algebra_deployment_calculus_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Deployment Artifact Detection SHACL-AF Rules v1.0.0
# Real implementation, Package 4. Uses SPARQL REGEX's "m" (multiline) flag,
# confirmed to match Python's re.MULTILINE semantics before authoring.
# ============================================================

<http://example.org/vaf-consolidated/deployment-calculus-rules>
    rdfs:label "VAF Deployment Artifact Detection SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-07-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_deployment_calculus_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/deployment-calculus-rules/1.0.0> ;
    dcterms:source "This session, 2026-07-04. Depends on 01-ontologies/variant_algebra_v3_deployment_calculus_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/deployment-calculus-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated."@en .

va:DeploymentArtifactShape a sh:NodeShape ;
    sh:targetClass va:DeploymentArtifact ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "dockerfile" }
            WHERE {
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?c, "^(\\\\s*(#.*)?\\\\n)*\\\\s*FROM\\\\s+\\\\S+", "m"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "docker-compose" }
            WHERE {
                $this va:deploymentFilename ?fn .
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?fn, "docker-compose.*\\\\.ya?ml$", "i"))
                FILTER(REGEX(?c, "^services:\\\\s*$", "m"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "kubernetes" }
            WHERE {
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?c, "^apiVersion:\\\\s*\\\\S+", "m"))
                FILTER(REGEX(?c, "^kind:\\\\s*(Deployment|Service|ConfigMap|Pod|StatefulSet|DaemonSet|Ingress|Secret)", "m"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "terraform" }
            WHERE {
                $this va:deploymentFilename ?fn .
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?fn, "\\\\.tf$"))
                FILTER(REGEX(?c, "^\\\\s*(resource|provider|module|terraform)\\\\s+\\"?[\\\\w.]*\\"?\\\\s*\\\\{", "m"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "ansible" }
            WHERE {
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?c, "^\\\\s*-?\\\\s*hosts:\\\\s*\\\\S+", "m"))
                FILTER(REGEX(?c, "^\\\\s*tasks:\\\\s*$", "m"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesDeploymentArtifactKind "systemd" }
            WHERE {
                $this va:deploymentFileContent ?c .
                FILTER(REGEX(?c, "^\\\\[Unit\\\\]\\\\s*$", "m"))
            }
        """ ; ] .

# ==== file variant_algebra_discovery_reader_shapes_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Variant Algebra -- discovery reader shapes, v1.0.0 (VAF-WI-158, plan Amendment 11).
# A source that gives a ground must name exactly one reader, and a reader must say its kind and the environment it ran in. Applied to the generated
# description (the two-domain toy); the earlier hand-written toy predates readers and is not required to carry them. A source with no reader is
# not credited as a non-model origin by the trust rules, so this shape names what the rules would silently leave out.

<http://example.org/vaf-consolidated/discovery-reader-shapes>
    rdfs:label "VAF Discovery Reader Shapes v1.0.0"@en ;
    dcterms:created "2026-10-06"^^xsd:date ; dcterms:identifier "variant_algebra_discovery_reader_shapes_v1_0_0" ;
    owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/vaf-consolidated/discovery-reader-shapes/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

va:DsReaderSourceShape a sh:NodeShape ; sh:targetObjectsOf va:groundedBySource ;
    rdfs:label "A source that gives a ground names exactly one reader"@en ;
    sh:property [ sh:path va:readBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Reader ; sh:message "A source that gives a ground must name exactly one reader." ] .

va:DsReaderShape a sh:NodeShape ; sh:targetClass va:Reader ;
    rdfs:label "A reader has a kind from the reader-kind scheme, a name and its environment"@en ;
    sh:property [ sh:path va:readerKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A reader must have exactly one kind." ] ,
                [ sh:path va:readerName ; sh:minCount 1 ; sh:message "A reader must have a name." ] ,
                [ sh:path va:hasEnvItem ; sh:minCount 1 ; sh:class va:ReaderEnvItem ; sh:message "A reader must record the environment it ran in." ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:message "A reader's kind must be a concept of the reader-kind scheme." ;
        sh:prefixes <http://example.org/vaf-consolidated/discovery-reader-shapes> ;
        sh:select """SELECT $this WHERE { $this va:readerKind ?k . FILTER NOT EXISTS { ?k skos:inScheme va:ReaderKindScheme } }""" ] .

# ==== file variant_algebra_discovery_reading_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .



# ============================================================
# Variant Algebra -- discovery reading, v1.0.0 (VAF-WI-142, 2026-10-05)
# What a reader finds (a relation, the kind of source it was found in) becomes a claim of the discovery ontology: its family,
# its ground kinds, the authority of its source and its modality. Everything below is data and rules; Python only harvests
# the reader's output as facts and reads the claims back (va:Decision_NoDecisionsInCode_2026_09_28).
#
# Stipulations, accepted by the owner on 2026-10-05 ("accept the proposal") and revisable by a refinement event (L-116):
#   - which discovery relation each reader relation is (the predicate rows);
#   - which source kind and authority level each reader source (docstring, comment, error message) is (the source rows);
#   - the default modality of each kind of necessity (the modality rows).
# Derived, not stipulated: the family of a relation (its parent in the family scheme); the ground kind of a ground (the one
# kind its source kind can ground per va:groundsKindsFrom, and 'undetermined' when the source kind can ground several or none:
# a source never gets a kind of necessity it does not support, and a guess is not made); the claim modality (that of the
# ground of highest authority).
#
# Strata: 1 claim and ground nodes   2 ground kind stated by the source row (checked against the ontology by DcSourceMapShape)
#         3 ground kind, the one its source kind can give   4 ground kind undetermined
#         5 modality of a ground stated by its relation (a normative relation)   6 modality of a ground by its kind of necessity
#         7 modality of a claim   8 a causal ground enforces the policy ground of the same claim (owner ruling 2026-10-05)
# Channels (VAF-WI-144): the language reader, and the pipeline's accepted discovery features (a calculus and operator row, below).
# A pipeline feature is read through its calculus row; features of calculi without a row are not described (reported, not guessed).
# ============================================================

<http://example.org/vaf-consolidated/discovery-reading> sh:declare [ sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ;
            sh:prefix "va" ],
        [ sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ;
            sh:prefix "skos" ] .

va:DcReadShape a sh:NodeShape ; sh:targetClass va:DcRead ;
    rdfs:label "A reading becomes a claim and a ground"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { ?c a va:DcClaim ; va:claimRelation ?rel ; va:claimFamily ?fam ; va:dcSubject ?s ; va:dcObject ?o0 .
                    ?g a va:DcGround ; va:dcGroundOf ?c ; va:dcGroundSrcName ?sn ; va:dcGroundSourceKind ?sk ; va:dcGroundAuthority ?au ;
                       va:dcGroundEvidence ?ev ; va:dcGroundLang ?lang ; va:dcGroundSrcId ?sidr ; va:dcGroundConditional ?cnd ; va:dcFromRead $this }
        WHERE { $this va:dcPred ?p ; va:dcSubj ?s ; va:dcEvidence ?ev .
                OPTIONAL { $this va:dcSrc ?sn0 } OPTIONAL { $this va:dcObj ?o0 } OPTIONAL { $this va:dcLang ?lang } OPTIONAL { $this va:dcSrcId ?sid } OPTIONAL { $this va:dcConditional ?cnd } BIND(COALESCE(?o0, "") AS ?o)
                ?pm a va:DcPredMap ; va:dcMapPred ?p ; va:dcMapRelation ?rel . ?rel skos:broader ?fam . OPTIONAL { ?pm va:dcMapSrcName ?psn }
                BIND(COALESCE(?sn0, ?psn) AS ?sn0r)
                OPTIONAL { ?wm a va:DcSourceMap ; va:dcMapSrcName ?sn0r ; va:dcMapWordingName ?wn }
                BIND(IF(BOUND(?sn0) && BOUND(?wn), ?wn, ?sn0r) AS ?sn)
                BIND(IF(BOUND(?sn0) && BOUND(?wn) && BOUND(?sid), CONCAT(STR(?sid), " wording"), ?sid) AS ?sidr)
                ?sm a va:DcSourceMap ; va:dcMapSrcName ?sn ; va:dcMapSourceKind ?sk ; va:dcMapAuthority ?au .
                BIND(IRI(CONCAT("urn:vaf:dc:c:", MD5(CONCAT(STR(?rel), "|", ?s, "|", ?o)))) AS ?c)
                BIND(IRI(CONCAT("urn:vaf:dc:g:", MD5(CONCAT(STR(?rel), "|", ?s, "|", ?o, "|", ?sn, "|", COALESCE(?sidr, ""))))) AS ?g) }""" ] .

va:DcGroundShape a sh:NodeShape ; sh:targetClass va:DcGround ;
    rdfs:label "A ground gets the kind its source row states, else the one kind its source kind can give, else undetermined; then a modality"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcGroundKind ?gk }
        WHERE { $this va:dcGroundSrcName ?sn . ?sm a va:DcSourceMap ; va:dcMapSrcName ?sn ; va:dcMapGroundKind ?gk }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcGroundKind ?gk }
        WHERE { $this va:dcGroundSourceKind ?sk .
                { SELECT ?sk (COUNT(?k) AS ?n) (SAMPLE(?k) AS ?gk) WHERE { ?k va:groundsKindsFrom ?sk } GROUP BY ?sk }
                FILTER(?n = 1) FILTER NOT EXISTS { $this va:dcGroundKind ?any } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcGroundKind va:GroundUndetermined }
        WHERE { $this va:dcGroundSourceKind ?sk . FILTER NOT EXISTS { $this va:dcGroundKind ?any } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcGroundModality ?m }
        WHERE { $this va:dcGroundOf ?c . ?c va:claimRelation ?rel . ?pm a va:DcPredMap ; va:dcMapRelation ?rel ; va:dcMapModality ?m }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcGroundModality ?m }
        WHERE { $this va:dcGroundKind ?gk . ?row a va:DcModalityMap ; va:dcMapGroundKind ?gk ; va:dcMapModality ?m .
                FILTER NOT EXISTS { $this va:dcGroundModality ?any } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcEnforces ?p }
        WHERE { $this va:dcGroundOf ?c ; va:dcGroundKind va:GroundCausal . ?p va:dcGroundOf ?c ; va:dcGroundKind va:GroundPolicy }""" ] .

# a source row that states a kind of necessity must state one its source kind can give (va:groundsKindsFrom): refused otherwise
va:DcSourceMapShape a sh:NodeShape ; sh:targetClass va:DcSourceMap ;
    rdfs:label "A source row's stated ground kind is one its source kind can give"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:message "a source row states a ground kind that its source kind cannot give (not in va:groundsKindsFrom)" ;
        sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ;
        sh:select """SELECT $this WHERE { $this va:dcMapGroundKind ?gk ; va:dcMapSourceKind ?sk . FILTER NOT EXISTS { ?gk va:groundsKindsFrom ?sk } }""" ] .

va:DcClaimShape a sh:NodeShape ; sh:targetClass va:DcClaim ;
    rdfs:label "A claim has the modality of the ground of highest authority"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/discovery-reading> ; sh:construct """
        CONSTRUCT { $this va:dcModality ?m }
        WHERE { ?g va:dcGroundOf $this ; va:dcGroundAuthority ?au ; va:dcGroundModality ?m . ?au va:authorityRank ?r .
                FILTER NOT EXISTS { ?g2 va:dcGroundOf $this ; va:dcGroundAuthority ?au2 ; va:dcGroundModality ?m2 . ?au2 va:authorityRank ?r2 . FILTER(?r2 > ?r) } }""" ] .

# ==== file variant_algebra_discovery_shapes_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Shapes for the discovery ontology (VAF-WI-141, 2026-10-05), a proposal with it (L-116). They check that what is held is complete:
# a claim has a family and grounds, a ground has a kind and a source, a term has a sensitivity, a re-interpreted term has one
# meaning per context, and every concept has a label and a definition. A role-like term without the relation it comes from is a
# Warning (a gap to know about), not a Violation.

<http://example.org/vaf-consolidated/discovery-shapes>
    rdfs:label "VAF Discovery Shapes v1.0.0 (proposal)"@en ; dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:identifier "variant_algebra_discovery_shapes_v1_0_0" ; owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/discovery-shapes/1.0.0> .

va:DsClaimShape a sh:NodeShape ; sh:targetClass va:RelationClaim ;
    rdfs:label "A relation claim has a family, a relation and at least one ground"@en ;
    sh:property [ sh:path va:claimFamily ; sh:minCount 1 ; sh:message "A relation claim must name its relation family." ] ,
                [ sh:path va:claimRelation ; sh:minCount 1 ; sh:message "A relation claim must name its relation." ] ,
                [ sh:path va:claimSubject ; sh:minCount 1 ; sh:message "A relation claim must name its subject." ] ,
                [ sh:path va:hasGround ; sh:minCount 1 ; sh:class va:ClaimGround ; sh:message "A relation claim must have at least one ground; a claim with none rests on nothing." ] .

va:DsGroundShape a sh:NodeShape ; sh:targetClass va:ClaimGround ;
    rdfs:label "A ground has exactly one kind of necessity and at least one source"@en ;
    sh:property [ sh:path va:groundKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A ground must state its kind of necessity (or Undetermined, stated, never guessed)." ] ,
                [ sh:path va:groundedBySource ; sh:minCount 1 ; sh:class va:Source ; sh:message "A ground must name the source that gives it." ] .

va:DsSourceShape a sh:NodeShape ; sh:targetClass va:Source ;
    rdfs:label "A source has a kind and an authority level"@en ;
    sh:property [ sh:path va:sourceKind ; sh:minCount 1 ; sh:message "A source must have a kind." ] ,
                [ sh:path va:authorityLevel ; sh:minCount 1 ; sh:message "A source must have an authority level." ] .

va:DsTermShape a sh:NodeShape ; sh:targetClass va:DomainTerm ;
    rdfs:label "A domain term has a sensitivity class"@en ;
    sh:property [ sh:path va:sensitivity ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A domain term must say how its meaning behaves when the domain changes." ] .

va:DsReinterpretedShape a sh:NodeShape ; sh:targetClass va:DomainTerm ;
    rdfs:label "A re-interpreted term has at least two meanings, each tied to its context"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:message "A re-interpreted term needs at least two meanings, each linked to its context (meaning-in); otherwise variants built for a context cannot tell which reading to use." ;
        sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:select """SELECT $this WHERE { $this va:sensitivity va:SensReinterpreted .
            FILTER( NOT EXISTS { $this va:hasMeaning ?m1 . ?m1 va:meaningIn ?c1 . $this va:hasMeaning ?m2 . ?m2 va:meaningIn ?c2 . FILTER(?m1 != ?m2 && ?c1 != ?c2) } ) }""" ] .

va:DsRoleLikeShape a sh:NodeShape ; sh:targetClass va:DomainTerm ; sh:severity sh:Warning ;
    rdfs:label "A role-like term should name the relation it comes from"@en ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A role-like term has no role-of link: the relation that gives it meaning is not in the model." ;
        sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:select """SELECT $this WHERE { $this va:sensitivity va:SensRoleLike . FILTER NOT EXISTS { $this va:roleOf ?r } }""" ] .

va:DsSchemeMembershipShape a sh:NodeShape ; sh:targetClass va:Source, va:ClaimGround, va:RelationClaim, va:DomainTerm ;
    rdfs:label "A value taken from a scheme is a concept of that scheme"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A kind, level, family or class named here is not a concept of the scheme that defines it." ;
        sh:select """SELECT $this WHERE { {
              $this va:sourceKind ?v . FILTER NOT EXISTS { ?v skos:inScheme va:SourceKindScheme } } UNION {
              $this va:authorityLevel ?v . FILTER NOT EXISTS { ?v skos:inScheme va:AuthorityScheme } } UNION {
              $this va:groundKind ?v . FILTER NOT EXISTS { ?v skos:inScheme va:GroundKindScheme } } UNION {
              $this va:claimFamily ?v . FILTER NOT EXISTS { ?v skos:broader va:RelationFamily } } UNION {
              $this va:sensitivity ?v . FILTER NOT EXISTS { ?v skos:inScheme va:DomainSensitivityScheme } } }""" ] .

va:DsConceptShape a sh:NodeShape ; sh:targetClass skos:Concept ;
    rdfs:label "Every concept has a human label and a definition"@en ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:message "A concept must have a label." ] ,
                [ sh:path skos:definition ; sh:minCount 1 ; sh:message "A concept must have a definition." ] .

# ---- VAF-WI-145: shapes for the connections between the ideas (each has a failing case in test_discovery_two_domain)
va:DsMeaningShape a sh:NodeShape ; sh:targetClass va:TermMeaning ;
    rdfs:label "A meaning is tied to the context it holds in (meaning-in)"@en ;
    sh:property [ sh:path va:meaningIn ; sh:minCount 1 ; sh:class va:Context ; sh:message "A meaning of a term must name the context it holds in (meaning-in); a meaning with no context cannot be chosen for a variant." ] .

va:DsHoldsInShape a sh:NodeShape ; sh:targetClass va:RelationClaim ;
    rdfs:label "A claim names the contexts it holds in (holds-in)"@en ;
    sh:property [ sh:path va:holdsIn ; sh:minCount 1 ; sh:class va:Context ; sh:message "A relation claim must name at least one context it holds in (holds-in); otherwise variant production cannot tell where it applies." ] .

va:DsGroundKindShape a sh:NodeShape ; sh:targetClass va:ClaimGround ;
    rdfs:label "A ground's kind is one its source's kind can give (ground-kind, grounded-by)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A ground states a kind of necessity that the kind of its source cannot give (the source kind is not in the kind's groundsKindsFrom); say 'undetermined' instead." ;
        sh:select """SELECT $this WHERE { $this va:groundKind ?gk ; va:groundedBySource ?s . ?s va:sourceKind ?sk .
            FILTER(?gk != va:GroundUndetermined) FILTER NOT EXISTS { ?gk va:groundsKindsFrom ?sk } }""" ] .

va:DsTranslationShape a sh:NodeShape ; sh:targetClass va:TermMeaning ;
    rdfs:label "A translation joins two meanings of one term in different contexts, and says how they differ (translates-to)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A translation must join two meanings of the same term, held in different contexts." ;
        sh:select """SELECT $this WHERE { $this va:translatesTo ?o .
            FILTER NOT EXISTS { ?t va:hasMeaning $this , ?o } 
            } """ ] ,
      [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A translation must be between meanings held in different contexts; two meanings in the same context are a conflict, not a translation." ;
        sh:select """SELECT $this WHERE { $this va:translatesTo ?o ; va:meaningIn ?c . ?o va:meaningIn ?c }""" ] ,
      [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A translation must say how the meanings differ: same, narrower, broader or different." ;
        sh:select """SELECT $this WHERE { $this va:translatesTo ?o . FILTER NOT EXISTS { $this va:translationKind ?k . FILTER(?k IN ("same", "narrower", "broader", "different")) } }""" ] .

va:DsSupersedesShape a sh:NodeShape ; sh:targetClass va:Context ;
    rdfs:label "A context that supersedes another follows it in time (valid-during, supersedes)"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A context that supersedes another must have a start date, and the superseded context must have an end date before it; otherwise the two overlap or the order is unknown." ;
        sh:select """SELECT $this WHERE { $this va:supersedes ?o .
            FILTER( NOT EXISTS { $this va:validFrom ?f . ?o va:validUntil ?u . FILTER(?u < ?f) } ) }""" ] .

va:DsSourceTraceShape a sh:NodeShape ; sh:targetClass va:Source ;
    rdfs:label "A source read from a file records the file and its hash"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A source read from a file must record the SHA-256 of the file as read, so a later change to the file is visible." ;
        sh:select """SELECT $this WHERE { $this va:sourcePath ?p . FILTER NOT EXISTS { $this va:sourceSha256 ?h . FILTER(REGEX(STR(?h), "^[0-9a-f]{64}$")) } }""" ] .

va:DsRoleOfShape a sh:NodeShape ; sh:targetClass va:DomainTerm ;
    rdfs:label "A role-of link points to a term"@en ;
    sh:property [ sh:path va:roleOf ; sh:class va:DomainTerm ; sh:message "A role-of link must point to the domain term of the relation that gives the role its meaning." ] .

# ---- VAF-WI-149: the facts the agreement rules compare
va:DsChangeEventShape a sh:NodeShape ; sh:targetClass va:ChangeEvent ;
    rdfs:label "A change event has a kind, a date, a file and a context"@en ;
    sh:property [ sh:path va:evKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "rule-stated" "rule-enforced" "code-changed" ) ; sh:message "A change event must have exactly one kind: rule-stated, rule-enforced or code-changed." ] ;
    sh:property [ sh:path va:evWhen ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "A change event must have exactly one date." ] ;
    sh:property [ sh:path va:evSourceFile ; sh:minCount 1 ; sh:message "A change event must name the file it is about." ] ;
    sh:property [ sh:path va:evHoldsIn ; sh:minCount 1 ; sh:class va:Context ; sh:message "A change event must carry the context of the file it is about." ] ;
    sh:property [ sh:path va:evFromSource ; sh:minCount 1 ; sh:class va:Source ; sh:message "A change event must point at the history that records it." ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A rule event (stated or enforced) must say which rule it is about: a member (and a second member for ordering), or a parameter name and value." ;
        sh:select """SELECT $this WHERE { $this va:evKind ?k . FILTER(?k IN ("rule-stated", "rule-enforced")) FILTER NOT EXISTS { $this va:evSubject ?s } FILTER NOT EXISTS { $this va:evName ?n . $this va:evValue ?v } }""" ] .

va:DsIncidentShape a sh:NodeShape ; sh:targetClass va:Incident ;
    rdfs:label "An incident points at the rule it violates and says how it ended"@en ;
    sh:property [ sh:path va:incOpened ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:message "An incident must have exactly one opened date." ] ;
    sh:property [ sh:path va:incResolution ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "open" "code-fixed" "document-fixed" "accepted" ) ; sh:message "An incident must be open, code-fixed, document-fixed or accepted." ] ;
    sh:property [ sh:path va:incRel ; sh:minCount 1 ; sh:in ( "order" "requires" "prevents" "obliged" "forbidden" "triggers" "param" ) ; sh:message "An incident must name the kind of rule it violates." ] ;
    sh:property [ sh:path va:incHoldsIn ; sh:minCount 1 ; sh:class va:Context ; sh:message "An incident must carry the context of the program it is about." ] ;
    sh:property [ sh:path va:incFromSource ; sh:minCount 1 ; sh:class va:Source ; sh:message "An incident must point at the record that holds it." ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "An incident that is not open must have a closed date." ;
        sh:select """SELECT $this WHERE { $this va:incResolution ?r . FILTER(?r != "open") FILTER NOT EXISTS { $this va:incClosed ?c } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "An incident must point at a rule: a member, or a parameter name." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this va:incSubject ?s } FILTER NOT EXISTS { $this va:incName ?n } }""" ] .

va:DsEstablishmentShape a sh:NodeShape ; sh:targetClass va:StateEstablishment ;
    rdfs:label "An establishment names an operation, a state and the line of code"@en ;
    sh:property [ sh:path va:estMember ; sh:minCount 1 ; sh:message "An establishment must name the operation." ] ;
    sh:property [ sh:path va:estState ; sh:minCount 1 ; sh:message "An establishment must name the state." ] ;
    sh:property [ sh:path va:estEvidence ; sh:minCount 1 ; sh:message "An establishment must quote the line of code." ] .

va:DsObservedParameterShape a sh:NodeShape ; sh:targetClass va:ObservedParameter ;
    rdfs:label "An observed limit has a key, a number, its words and a context"@en ;
    sh:property [ sh:path va:obsKey ; sh:minCount 1 ; sh:message "An observed limit must name the parameter it belongs to." ] ;
    sh:property [ sh:path va:obsValue ; sh:minCount 1 ; sh:datatype xsd:decimal ; sh:message "An observed limit must have a number." ] ;
    sh:property [ sh:path va:obsEvidence ; sh:minCount 1 ; sh:message "An observed limit must quote the source." ] ;
    sh:property [ sh:path va:obsHoldsIn ; sh:minCount 1 ; sh:class va:Context ; sh:message "An observed limit must carry the context of the file it is read from." ] .

va:DsParametrisedTermShape a sh:NodeShape ; sh:targetClass va:DomainTerm ;
    rdfs:label "A term with a parameter key has a value in every meaning"@en ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes <http://example.org/vaf-consolidated/discovery-shapes> ;
        sh:message "A term with a parameter key must give a value in every one of its meanings." ;
        sh:select """SELECT $this WHERE { $this va:parameterKey ?k ; va:hasMeaning ?m . FILTER NOT EXISTS { ?m va:meaningValue ?v } }""" ] .

<http://example.org/vaf-consolidated/discovery-shapes> sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
    [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

# ---- VAF-WI-150: corrective-action records
va:DsCauseConfirmationShape a sh:NodeShape ; sh:targetClass va:CauseConfirmation ;
    rdfs:label "A confirmed cause names a cause from the scheme, who confirmed it, the action and its due date"@en ;
    sh:property [ sh:path va:ccCause ; sh:minCount 1 ; sh:maxCount 1 ; sh:node va:DsNcCauseConceptShape ; sh:message "A confirmation must name one cause from the cause scheme." ] ;
    sh:property [ sh:path va:ccBy ; sh:minCount 1 ; sh:message "A confirmation must say who confirmed the cause." ] ;
    sh:property [ sh:path va:ccAction ; sh:minCount 1 ; sh:message "A confirmation must name the corrective action." ] ;
    sh:property [ sh:path va:ccDue ; sh:minCount 1 ; sh:datatype xsd:date ; sh:message "A confirmation must have a due date." ] ;
    sh:property [ sh:path va:ccIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Context ; sh:message "A confirmation must name the context." ] ;
    sh:property [ sh:path va:ccRel ; sh:minCount 1 ; sh:in ( "order" "requires" "prevents" "obliged" "forbidden" "triggers" "param" ) ; sh:message "A confirmation must name the kind of rule." ] ;
    sh:property [ sh:path va:ccFromSource ; sh:minCount 1 ; sh:class va:Source ; sh:message "A confirmation must point at the record that holds it." ] .
va:DsKnownProblemShape a sh:NodeShape ; sh:targetClass va:KnownProblem ;
    rdfs:label "A known problem has an owner, a reason, an accepted risk and a review date"@en ;
    sh:property [ sh:path va:kpOwner ; sh:minCount 1 ; sh:message "A known problem must have an owner." ] ;
    sh:property [ sh:path va:kpReason ; sh:minCount 1 ; sh:message "A known problem must say why it is accepted." ] ;
    sh:property [ sh:path va:kpRisk ; sh:minCount 1 ; sh:message "A known problem must state the accepted risk." ] ;
    sh:property [ sh:path va:kpReview ; sh:minCount 1 ; sh:datatype xsd:date ; sh:message "A known problem must have a review date." ] ;
    sh:property [ sh:path va:kpIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Context ; sh:message "A known problem must name the context." ] ;
    sh:property [ sh:path va:kpRel ; sh:minCount 1 ; sh:in ( "order" "requires" "prevents" "obliged" "forbidden" "triggers" "param" ) ; sh:message "A known problem must name the kind of rule." ] ;
    sh:property [ sh:path va:kpFromSource ; sh:minCount 1 ; sh:class va:Source ; sh:message "A known problem must point at the record that holds it." ] .
va:DsNcCauseConceptShape a sh:NodeShape ; rdfs:label "A cause is a concept of the cause scheme"@en ;
    sh:property [ sh:path skos:broader ; sh:hasValue va:NcCause ; sh:message "A cause must be a concept below the cause scheme's top concept." ] .

# ==== file variant_algebra_documentation_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- documented rules read as constraints, v1.0.0 (VAF-WI-132, 2026-10-04)
# The owner's toy trace: the class docstring says "a loan may only be checked out after approval, and may only be
# cancelled before it is checked out" -- a rule the program states in words and no calculus read. Which sentence is a
# rule, and what it constrains, is decided HERE, over the clause's words (va:Decision_NoDecisionsInCode_2026_09_28);
# Python only harvests the clauses, their words and which member each word names (a stem match with the first word of a
# method's name), and reads the relations back.
#
# Input facts: va:DocClause (va:clauseText the sentence, va:clauseClass the class), va:DocToken (va:tokIn, va:tokIndex,
#              va:tokWord, va:tokMentions a member atom)
# Output facts: va:DocRelation (va:docFrom, va:docTo, va:docKind, va:docWhy)
#   "X ... only after Y"  -> kind "only after":  X needs Y   (X requires Y)
#   "X ... only before Y" -> kind "only before": X and Y are never together in a program (exclusive)
# Disclosed stipulation (L-116): these two readings are the first documented patterns; others are not read, not guessed.
# ============================================================

<http://example.org/vaf-consolidated/documentation-rules>
    rdfs:label "VAF Documented-Rule SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_documentation_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/documentation-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:DocOnlyAfterShape a sh:NodeShape ; sh:targetClass va:DocClause ;
    rdfs:label "A clause that says a member may only happen after another one"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/documentation-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DocRelation ; va:docFrom ?m1 ; va:docTo ?m2 ; va:docKind "only after" ; va:docWhy ?txt }
        WHERE { $this va:clauseText ?txt .
                ?to va:tokIn $this ; va:tokWord "only" ; va:tokIndex ?o .
                ?ta va:tokIn $this ; va:tokWord "after" ; va:tokIndex ?a . FILTER(?a > ?o)
                ?t1 va:tokIn $this ; va:tokIndex ?i1 ; va:tokMentions ?m1 . FILTER(?i1 < ?a)
                FILTER NOT EXISTS { ?t1b va:tokIn $this ; va:tokMentions ?x1 ; va:tokIndex ?j1 . FILTER(?j1 < ?a && ?j1 > ?i1) }
                ?t2 va:tokIn $this ; va:tokIndex ?i2 ; va:tokMentions ?m2 . FILTER(?i2 > ?a)
                FILTER NOT EXISTS { ?t2b va:tokIn $this ; va:tokMentions ?x2 ; va:tokIndex ?j2 . FILTER(?j2 > ?a && ?j2 < ?i2) }
                FILTER(?m1 != ?m2)
                BIND(IRI(CONCAT("urn:vaf:docrel:", MD5(CONCAT(STR($this), "after", STR(?m1), STR(?m2))))) AS ?rel) }""" ] .

va:DocOnlyBeforeShape a sh:NodeShape ; sh:targetClass va:DocClause ;
    rdfs:label "A clause that says a member may only happen before another one"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/documentation-rules> ; sh:construct """
        CONSTRUCT { ?rel a va:DocRelation ; va:docFrom ?m1 ; va:docTo ?m2 ; va:docKind "only before" ; va:docWhy ?txt }
        WHERE { $this va:clauseText ?txt .
                ?to va:tokIn $this ; va:tokWord "only" ; va:tokIndex ?o .
                ?ta va:tokIn $this ; va:tokWord "before" ; va:tokIndex ?a . FILTER(?a > ?o)
                ?t1 va:tokIn $this ; va:tokIndex ?i1 ; va:tokMentions ?m1 . FILTER(?i1 < ?a)
                FILTER NOT EXISTS { ?t1b va:tokIn $this ; va:tokMentions ?x1 ; va:tokIndex ?j1 . FILTER(?j1 < ?a && ?j1 > ?i1) }
                ?t2 va:tokIn $this ; va:tokIndex ?i2 ; va:tokMentions ?m2 . FILTER(?i2 > ?a)
                FILTER NOT EXISTS { ?t2b va:tokIn $this ; va:tokMentions ?x2 ; va:tokIndex ?j2 . FILTER(?j2 > ?a && ?j2 < ?i2) }
                FILTER(?m1 != ?m2)
                BIND(IRI(CONCAT("urn:vaf:docrel:", MD5(CONCAT(STR($this), "before", STR(?m1), STR(?m2))))) AS ?rel) }""" ] .

# ==== file variant_algebra_failure_diagnosis_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Failure Diagnosis SHACL-AF Rules v1.0.0 (VAF-WI-116f, 2026-09-28)
# A FAILed verdict's primary failure class, in priority order (the earliest check in the L1-L6 pipeline that could
# have produced the FAIL: static checks trump runtime checks) -- syntactic, structural, contract, fabrication,
# quality, then, from the execution report if one is attached, resource (a sandbox limit) ahead of execution (a
# contract check or an exception); a verdict with none of these signals is unknown. Resource and unknown are
# terminal: further synthesis attempts are unlikely to fix them. Until 2026-09-28 the signal detection (matched
# against the verdict's reason lines) and the priority ordering were Python (variant_feedback_v1_0_0.py). Input: one
# va:FailureDiagnosisCheck per diagnose() call, carrying its verdict's joined reason lines (va:diagnosisReasonText)
# and, when an execution report is attached, its outcome (va:diagnosisExecOutcome) and whether any of its checks
# failed (va:diagnosisExecHasFailedChecks).
# ============================================================

<http://example.org/vaf-consolidated/failure-diagnosis-rules>
    rdfs:label "VAF Failure Diagnosis SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_failure_diagnosis_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/failure-diagnosis-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:FailureSignalRuleShape a sh:NodeShape ; sh:targetClass va:FailureDiagnosisCheck ;
    rdfs:comment "The static-check signals: whether the verdict's reason lines name a FAIL at each check."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:sawSyntacticFail true }
        WHERE { $this va:diagnosisReasonText ?t . FILTER(CONTAINS(?t, "FAIL syntactic")) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:sawStructuralFail true }
        WHERE { $this va:diagnosisReasonText ?t . FILTER(CONTAINS(?t, "FAIL structural")) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:sawContractFail true }
        WHERE { $this va:diagnosisReasonText ?t . FILTER(CONTAINS(?t, "FAIL contract")) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:sawFabricationFail true }
        WHERE { $this va:diagnosisReasonText ?t . FILTER(CONTAINS(?t, "FAIL fabrication")) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:sawQualityFail true }
        WHERE { $this va:diagnosisReasonText ?t . FILTER(CONTAINS(?t, "FAIL quality[")) }""" ] .

va:FailurePriorityRuleShape a sh:NodeShape ; sh:targetClass va:FailureDiagnosisCheck ;
    rdfs:comment "The primary class is the highest-priority signal present: syntactic, structural, contract, fabrication, quality, resource (the execution report's outcome is TIMEOUT, OOM or CPU), execution (the report has a failed check, or its outcome is FAIL or EXCEPTION), else unknown."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:primaryClass ?c }
        WHERE { $this a va:FailureDiagnosisCheck .
                OPTIONAL { $this va:sawSyntacticFail ?syn } OPTIONAL { $this va:sawStructuralFail ?str }
                OPTIONAL { $this va:sawContractFail ?con } OPTIONAL { $this va:sawFabricationFail ?fab }
                OPTIONAL { $this va:sawQualityFail ?qual } OPTIONAL { $this va:diagnosisExecOutcome ?eo }
                OPTIONAL { $this va:diagnosisExecHasFailedChecks ?efc }
                BIND(COALESCE(?syn, false) AS ?bsyn) BIND(COALESCE(?str, false) AS ?bstr) BIND(COALESCE(?con, false) AS ?bcon)
                BIND(COALESCE(?fab, false) AS ?bfab) BIND(COALESCE(?qual, false) AS ?bqual)
                BIND(COALESCE(?eo IN ("TIMEOUT", "OOM", "CPU"), false) AS ?bres)
                BIND(COALESCE(?efc, false) || COALESCE(?eo IN ("FAIL", "EXCEPTION"), false) AS ?bexec)
                BIND(IF(?bsyn, "SYNTACTIC", IF(?bstr, "STRUCTURAL", IF(?bcon, "CONTRACT", IF(?bfab, "FABRICATION",
                     IF(?bqual, "QUALITY", IF(?bres, "RESOURCE", IF(?bexec, "EXECUTION", "UNKNOWN"))))))) AS ?c) }""" ] .

va:FailureTerminalRuleShape a sh:NodeShape ; sh:targetClass va:FailureDiagnosisCheck ;
    rdfs:comment "Resource and unknown failures are terminal: unlikely to be fixed by more synthesis attempts."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/failure-diagnosis-rules> ; sh:construct """
        CONSTRUCT { $this va:isTerminal ?t }
        WHERE { $this va:primaryClass ?c . BIND(?c IN ("RESOURCE", "UNKNOWN") AS ?t) }""" ] .

# ==== file variant_algebra_feature_model_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- feature-model anomalies of a component's variants, v1.0.0 (VAF-WI-136, 2026-10-04)
# Researched with the owner's request for "similar cases": feature-model analysis defines a DEAD feature (one that appears in
# no product of the product line) and a FALSE-OPTIONAL feature (one included in all products although not modelled as
# mandatory) (feature-model analysis operations, isa.us.es/featuremodelanalysis/operations; Benavides et al. 2010,
# "Automated analysis of feature models 20 years later"). Decided here over all variants of one component.
# Input facts: va:UvAtom (a declared member), va:uvOptional true (declared optional), va:UvVariant with va:uvHas atom.
# Output facts: va:uvDeadFeature true, va:uvFalseOptional true.
# ============================================================

<http://example.org/vaf-consolidated/feature-model-rules>
    rdfs:label "VAF Feature-Model Anomaly SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_feature_model_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/feature-model-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:UvModelAnomalyShape a sh:NodeShape ; sh:targetClass va:UvAtom ;
    rdfs:label "Feature-model anomalies: a dead feature is in no variant; a false-optional feature is in every variant"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/feature-model-rules> ; sh:construct """
        CONSTRUCT { $this va:uvDeadFeature true }
        WHERE { $this a va:UvAtom . FILTER NOT EXISTS { ?v va:uvHas $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/feature-model-rules> ; sh:construct """
        CONSTRUCT { $this va:uvFalseOptional true }
        WHERE { $this a va:UvAtom ; va:uvOptional true . ?v0 va:uvHas $this . FILTER NOT EXISTS { ?v a va:UvVariant . FILTER NOT EXISTS { ?v va:uvHas $this } } }""" ] .

# ==== file variant_algebra_feedback_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- the Feedback step's rules, v1.0.0 (VAF-WI-249, 2026-10-19)
# What a run teaches, and whom it is addressed to, is decided HERE (va:Decision_NoDecisionsInCode_2026_09_28): the rules read the record of one
# run (its stage results, their findings and checks, its capacity notices, the seconds each step took, the step that stopped it) and state a
# va:FeedbackFinding for each thing that needs a reader. Python only builds the request and the result, runs these rules and writes down what they state.
#
# Input facts: the run's graph (va:hasProcessingStage ... va:hasExecutionStage, their findings, checks, verdicts, va:secondsTaken, va:stoppedAt, va:stopReason,
#              va:hasCapacityNotice) and the workflow ontology (va:stepResultClass and the step labels); a va:FeedbackRequest (va:feedbackFrom the run, va:producesFeedback the result).
# Output facts: va:FeedbackFinding (va:feedbackFindingOf the result, va:feedbackKind, va:feedbackAddressee, va:feedbackEvidenceStep, va:feedbackStatement,
#              va:feedbackSeconds for a measurement) and the result's va:hasFeedbackVerdict.
#   stratum 1: the findings.  stratum 2: the verdict, which needs every finding: Findings to act on when a finding is not a measurement, Nothing to correct otherwise.
# ============================================================

<http://example.org/vaf-consolidated/feedback-rules>
    rdfs:label "VAF Feedback SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:identifier "variant_algebra_feedback_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/feedback-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

va:FeedbackFromProcessingShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "A dead or false-optional feature, a model with no variant and a count the budget cut short are addressed to the model owner"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "DeadFeature" ; va:feedbackAddressee "Model owner" ; va:feedbackEvidenceStep "Processing" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasProcessingStage ?pr . ?pf va:processingFindingOf ?pr ; va:processingFindingKind "DeadFeature" ; va:processingFindingFeature ?name .
                BIND (IRI(CONCAT(STR($this), "_DeadFeature_", ENCODE_FOR_URI(?name))) AS ?f) BIND (CONCAT(?name, " can never be selected: the model or the program is wrong, or the feature cannot be reached.") AS ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "FalseOptionalFeature" ; va:feedbackAddressee "Model owner" ; va:feedbackEvidenceStep "Processing" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasProcessingStage ?pr . ?pf va:processingFindingOf ?pr ; va:processingFindingKind "FalseOptionalFeature" ; va:processingFindingFeature ?name .
                BIND (IRI(CONCAT(STR($this), "_FalseOptionalFeature_", ENCODE_FOR_URI(?name))) AS ?f) BIND (CONCAT(?name, " is optional but every variant selects it: the model or the program is wrong, or it is mandatory.") AS ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "NoVariant" ; va:feedbackAddressee "Model owner" ; va:feedbackEvidenceStep "Processing" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasProcessingStage ?pr . ?pr va:hasProcessingVerdict va:ProcessingVerdict_Void .
                BIND (IRI(CONCAT(STR($this), "_NoVariant")) AS ?f) BIND ("The model admits no variant: its statements contradict each other." AS ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "Undecided" ; va:feedbackAddressee "Model owner" ; va:feedbackEvidenceStep "Processing" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasProcessingStage ?pr . ?pr va:hasProcessingVerdict va:ProcessingVerdict_Undecided ; va:notCountedBecause ?why .
                BIND (IRI(CONCAT(STR($this), "_Undecided")) AS ?f) BIND (CONCAT("The variants could not be counted within the budget: ", ?why, ".") AS ?t) }""" ] .

va:FeedbackFromAgreementShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "A state that unmatches is addressed to the document owner"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "DocumentsDisagree" ; va:feedbackAddressee "Document owner" ; va:feedbackEvidenceStep "Agreement" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasAgreementStage ?ar . ?af va:findingOf ?ar ; va:findingNcStatus ?st ; va:findingQuestion ?q ; va:findingReason ?why .
                BIND (IRI(CONCAT(STR($this), "_DocumentsDisagree_", MD5(STR(?af)))) AS ?f) BIND (CONCAT(STR(?q), ": ", STR(?why), " (status ", STR(?st), ").") AS ?t) }""" ] .

va:FeedbackFromVerificationShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "A verification check that did not pass, of either severity, is addressed to synthesis"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "VerificationCheckFailed" ; va:feedbackAddressee "Synthesis" ; va:feedbackEvidenceStep "Verification" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasVerificationStage ?vr . ?c va:verificationCheckOf ?vr ; va:checkPassed false ; va:checkName ?n ; va:checkSeverity ?sv ; va:checkDetail ?d .
                BIND (IRI(CONCAT(STR($this), "_VerificationCheckFailed_", ENCODE_FOR_URI(?n))) AS ?f) BIND (CONCAT(?n, " (", ?sv, "): ", STR(?d)) AS ?t) }""" ] .

va:FeedbackFromExecutionShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "An artifact that did not run, or was not run, is addressed to synthesis"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "ExecutionFailed" ; va:feedbackAddressee "Synthesis" ; va:feedbackEvidenceStep "Execution" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasExecutionStage ?xr . ?xr va:hasExecutionVerdict va:ExecutionVerdict_Failed ; va:executionDetail ?d .
                BIND (IRI(CONCAT(STR($this), "_ExecutionFailed")) AS ?f) BIND (STR(?d) AS ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "ExecutionSkipped" ; va:feedbackAddressee "Synthesis" ; va:feedbackEvidenceStep "Execution" ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasExecutionStage ?xr . ?xr va:hasExecutionVerdict va:ExecutionVerdict_NotRun ; va:executionDetail ?d .
                BIND (IRI(CONCAT(STR($this), "_ExecutionSkipped")) AS ?f) BIND (STR(?d) AS ?t) }""" ] .

va:FeedbackFromCapacityShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "A project larger than was measured is addressed to the capacity measurement"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "CapacityNotice" ; va:feedbackAddressee "Capacity measurement" ; va:feedbackEvidenceStep ?st ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:hasCapacityNotice ?n . ?n va:noticeText ?nt ; va:noticeBeforeStep ?stp . ?stp rdfs:label ?stl . BIND (STR(?stl) AS ?st)
                BIND (IRI(CONCAT(STR($this), "_CapacityNotice_", MD5(STR(?n)))) AS ?f) BIND (STR(?nt) AS ?t) }""" ] .

va:FeedbackMeasurementShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "The seconds each step took are addressed to the capacity measurement"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "Measurement" ; va:feedbackAddressee "Capacity measurement" ; va:feedbackEvidenceStep ?sn ; va:feedbackStatement ?t ; va:feedbackSeconds ?secs }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run ?link ?r . ?r va:secondsTaken ?secs ; a ?cls . ?step a va:PipelineStep ; va:stepResultClass ?cls ; rdfs:label ?lbl . BIND (STR(?lbl) AS ?sn)
                BIND (IRI(CONCAT(STR($this), "_Measurement_", ENCODE_FOR_URI(STR(?sn)))) AS ?f) BIND (CONCAT(STR(?sn), " took ", STR(?secs), " s.") AS ?t) }""" ] .

va:FeedbackStopShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "The reason a run stopped is addressed to the person"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FeedbackFinding ; va:feedbackFindingOf $this ; va:feedbackKind "StoppedRun" ; va:feedbackAddressee "The person" ; va:feedbackEvidenceStep ?step ; va:feedbackStatement ?t }
        WHERE { ?req va:producesFeedback $this ; va:feedbackFrom ?run .
                ?run va:stoppedAt ?step ; va:stopReason ?why .
                BIND (IRI(CONCAT(STR($this), "_StoppedRun")) AS ?f) BIND (IF(?step = "Run", CONCAT("The run stopped: ", ?why), CONCAT("The run stopped at ", LCASE(?step), ": ", ?why)) AS ?t) }""" ] .

va:FeedbackVerdictShape a sh:NodeShape ; sh:targetClass va:FeedbackResult ;
    rdfs:label "The verdict follows the findings: Findings to act on when one is not a measurement, Nothing to correct otherwise"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { $this va:hasFeedbackVerdict va:FeedbackVerdict_FindingsToActOn }
        WHERE { ?f va:feedbackFindingOf $this ; va:feedbackKind ?k . FILTER (?k != "Measurement") }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-rules> ; sh:construct """
        CONSTRUCT { $this va:hasFeedbackVerdict va:FeedbackVerdict_NothingToCorrect }
        WHERE { FILTER NOT EXISTS { ?f va:feedbackFindingOf $this ; va:feedbackKind ?k . FILTER (?k != "Measurement") } }""" ] .

# ==== file variant_algebra_general_bridge_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — General Bridge SHACL-AF Rules v1.0.0
# Real implementation, Package 1 of the pipeline-backbone backlog.
# ============================================================

<http://example.org/vaf-consolidated/general-bridge-rules>
    rdfs:label "VAF General Bridge SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-07-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_general_bridge_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/general-bridge-rules/1.0.0> ;
    dcterms:source "This session, 2026-07-04. Depends on 01-ontologies/variant_algebra_v3_general_bridge_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/general-bridge-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated."@en .

# ---- Bridges fact type 1: C2-style call-dependency edges ----
va:BridgeDependencyShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT {
                $this va:hasSynthesisCandidate _:cand .
                _:cand a va:SynthesisInputCandidate ;
                    va:candidateKind "dependency" ;
                    va:candidateSource ?target .
            }
            WHERE { $this va:proposesCallDependency ?target }
        """ ; ] .

# ---- Bridges fact type 2: BuilderAttribution/Purpose claims ----
va:BridgePurposeShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT {
                $this va:hasSynthesisCandidate _:cand .
                _:cand a va:SynthesisInputCandidate ;
                    va:candidateKind "purpose" ;
                    va:candidateSource ?attr .
            }
            WHERE {
                ?attr va:attributesPurposeTo $this .
                ?attr va:confidenceTier ?tier .
            }
        """ ; ] .

# ==== file variant_algebra_group_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- independent groups of a component's statements, v1.0.0 (VAF-WI-129 and VAF-WI-135, 2026-10-04)
# The calculus optimisation the framework recorded as not built (vaf_native_evaluator_v1_8_0.md): a component's
# statements that share no feature cannot influence each other's variants, so the component's variants are the product
# of its groups' variants, and its variant count is the product of their counts (the Sprint 3.2 decomposition that
# definitions already use, orders 17.1-19.5 of the operator rules). Which statements form a group is decided HERE, over
# the statements' names, not in Python (va:Decision_NoDecisionsInCode_2026_09_28); Python only harvests the names,
# evaluates each group with the operator rules and multiplies.
#
# Input facts: va:GroupStatement (one per statement), va:gsIndex (its position), va:gsNames (a feature it names)
# Output facts: va:gsGroup (the smallest position in the statement's group: the group's key)
# ============================================================

<http://example.org/vaf-consolidated/group-rules>
    rdfs:label "VAF Independent-Group SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_group_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/group-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:GroupLinkShape a sh:NodeShape ; sh:targetClass va:GroupStatement ;
    rdfs:label "Two statements that name a common feature are linked"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/group-rules> ; sh:construct """
        CONSTRUCT { $this va:gsLinked ?other . $this va:gsSameGroup $this }
        WHERE { $this va:gsNames ?f . OPTIONAL { ?other va:gsNames ?f . FILTER (?other != $this) } }
    """ ] .

va:GroupClosureShape a sh:NodeShape ; sh:targetClass va:GroupStatement ;
    rdfs:label "Statements linked through a chain of shared features are in the same group"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/group-rules> ; sh:construct """
        CONSTRUCT { $this va:gsSameGroup ?c }
        WHERE { $this va:gsSameGroup ?b . ?b va:gsLinked ?c }
    """ ] .

va:GroupKeyShape a sh:NodeShape ; sh:targetClass va:GroupStatement ;
    rdfs:label "A group is named by the position of its first statement"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/group-rules> ; sh:construct """
        CONSTRUCT { $this va:gsGroup ?k }
        WHERE { { SELECT $this (MIN(?i) AS ?k) WHERE { $this va:gsSameGroup ?b . ?b va:gsIndex ?i } GROUP BY $this } }
    """ ] .

# ==== file variant_algebra_implementation_audit_shapes_v1_0_0.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- implementation audit, shapes v1.0.0 (2026-10-11, VAF-WI-197).
# The owner's rule, 2026-10-09: ontology native; Python only where the standard capabilities do not match. Each shape is shown to fail on known-bad
# data by 06-runtime/src/test_implementation_register_v1_0_21.py (L-95).

<http://example.org/variant-algebra/implementation-audit-shapes>
    owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/variant-algebra/implementation-audit-shapes/1.0.0> ;
    rdfs:label "Variant Algebra -- implementation audit (shapes)"@en .

va:AuditedNeedsVerdictShape a sh:NodeShape ;
    rdfs:label "An audited tool states the verdict, the standard capability considered and the test that decided"@en ;
    sh:targetClass va:AuditedArtifact ;
    sh:property [ sh:path va:hasCapabilityVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:CapabilityVerdict ;
        sh:message "An audited tool must state exactly one capability verdict." ] ;
    sh:property [ sh:path va:standardCapabilityConsidered ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "An audited tool must name the standard capability that was considered." ] ;
    sh:property [ sh:path va:capabilityTest ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "An audited tool must cite the test that decided the verdict." ] .

va:ProceduralVerdictNeedsReasonShape a sh:NodeShape ;
    rdfs:label "A tool that stays procedural (wholly or in part) states which boundary it crosses"@en ;
    sh:targetClass va:AuditedArtifact ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This audited tool keeps procedural work (verdict: partly standard, or no standard capability) and states no procedural reason." ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasCapabilityVerdict ?v . FILTER (?v != va:Verdict_ReplaceableByStandard)
                     FILTER NOT EXISTS { $this va:proceduralReason ?r } }""" ] .

# ==== file variant_algebra_implementation_register_shacl_v1_0_0.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Variant Algebra -- implementation register, shapes v1.0.0 (2026-09-27, VAF-WI-099).
# Each shape is shown to fail on a known-bad register by 06-runtime/src/test_implementation_register_v1_0_0.py (L-95).

<http://example.org/variant-algebra/implementation-register-shapes>
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/variant-algebra/implementation-register-shapes/1.1.0> ;
    dcterms:modified "2026-10-21"^^xsd:date ;
    rdfs:label "Variant Algebra -- implementation register (shapes)"@en .

va:RegisterArtifactShape a sh:NodeShape ;
    rdfs:label "Every artifact has one role, one reachability and a path"@en ;
    sh:targetClass va:ImplementationArtifact ;
    sh:property [ sh:path va:hasArtifactRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ArtifactRole ;
        sh:message "An artifact must have exactly one role." ] ;
    sh:property [ sh:path va:hasReachability ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Reachability ;
        sh:message "An artifact must have exactly one computed reachability." ] ;
    sh:property [ sh:path va:artifactPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "An artifact must name its path." ] .

va:ProceduralNeedsReasonShape a sh:NodeShape ;
    rdfs:label "A procedural artifact states why the ontology cannot do its work"@en ;
    sh:targetClass va:ImplementationArtifact ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This artifact is procedural and states no reason. The owner's rule: VAF is ontology native; the only exception is where the ontology is not capable -- which boundary of the graph does this artifact cross?" ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasArtifactRole va:Role_NecessarilyProcedural .
                     FILTER NOT EXISTS { $this va:proceduralReason ?r } }""" ] .

va:ImplementationShape a sh:NodeShape ;
    rdfs:label "Every implementation names its concept, artifact, location and use"@en ;
    sh:targetClass va:ConceptImplementation ;
    sh:property [ sh:path va:implementsConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "An implementation implements one concept." ] ;
    sh:property [ sh:path va:implementedIn ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ImplementationArtifact ;
        sh:message "An implementation lives in one registered artifact." ] ;
    sh:property [ sh:path va:implementationUse ; sh:minCount 1 ; sh:in ( "live" "test-only" "unreachable" ) ;
        sh:message "An implementation's use is live, test-only or unreachable." ] .

va:SingleImplementationShape a sh:NodeShape ;
    rdfs:label "A concept has exactly one implementation (owner, 2026-09-27)"@en ;
    sh:severity sh:Warning ;
    rdfs:comment "Warning while Lineage 5 consolidates (objective: concepts implemented more than once, 19 -> 0). It measures, it does not yet refuse; promoting it to a violation is a ruling for the owner once the count reaches zero."@en ;
    sh:targetSubjectsOf va:implementsConcept ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This implementation's concept is implemented more than once. The owner: 'Multiple implementations of the operators and calculus is not allowable.'" ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:implementsConcept ?c . ?other va:implementsConcept ?c . FILTER (?other != $this) }""" ] .

# ---- VAF-WI-256 (2026-10-21): the functions of a delegating module are read and classed; a decision in code has a disposition ----
va:FunctionRecordShape a sh:NodeShape ;
    rdfs:label "Every function is recorded with its artifact, its name and exactly one class"@en ;
    sh:targetClass va:ArtifactFunction ;
    sh:property [ sh:path va:functionOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ImplementationArtifact ;
        sh:message "A function belongs to exactly one registered artifact." ] ;
    sh:property [ sh:path va:functionName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A function states its name." ] ;
    sh:property [ sh:path va:hasFunctionClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:FunctionClass ;
        sh:message "A function has exactly one class: it was read and placed." ] .

va:DecideNeedsDispositionShape a sh:NodeShape ;
    rdfs:label "A function that decides in code has a disposition; no other function has one"@en ;
    sh:targetClass va:ArtifactFunction ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This function decides in code and has no disposition: say whether it is converted into a rule or kept on an analysis (va:Decision_NoDecisionsInCode_2026_09_28)." ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasFunctionClass va:Function_Decide .
                     FILTER NOT EXISTS { $this va:hasDecisionDisposition ?d } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This function has a decision disposition but does not decide: a disposition belongs to a function of the class Decide." ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasDecisionDisposition ?d . FILTER NOT EXISTS { $this va:hasFunctionClass va:Function_Decide } }""" ] .

va:RetainedNeedsAnalysisShape a sh:NodeShape ;
    rdfs:label "A decision kept in Python is justified by an analysis of cost, benefit and risk"@en ;
    sh:targetClass va:ArtifactFunction ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This function is retained in Python and no retention analysis covers it. The owner (2026-10-21): where Python is kept, run a cost, benefit and risk analysis." ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasDecisionDisposition va:Disposition_RetainedOnAnalysis .
                     FILTER NOT EXISTS { ?a va:analysisCovers $this } }""" ] .

va:RetentionAnalysisShape a sh:NodeShape ;
    rdfs:label "A retention analysis states cost, benefit, risk and verdict, and names what it covers"@en ;
    sh:targetClass va:RetentionAnalysis ;
    sh:property [ sh:path va:retentionCost ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "State what keeping the code costs." ] ;
    sh:property [ sh:path va:retentionBenefit ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "State what keeping the code gains." ] ;
    sh:property [ sh:path va:retentionRisk ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "State the risk of keeping and of converting." ] ;
    sh:property [ sh:path va:retentionVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "State what was decided and what would reopen it." ] ;
    sh:property [ sh:path va:analysisCovers ; sh:minCount 1 ; sh:class va:ArtifactFunction ; sh:message "Name the functions the analysis justifies keeping." ] .

va:DelegatingFunctionsReadShape a sh:NodeShape ;
    rdfs:label "A module recorded as delegating to the ontology has its functions read"@en ;
    sh:targetClass va:ImplementationArtifact ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This Python module is recorded as delegating to the ontology and no function of it is recorded: the claim has not been checked function by function." ;
        sh:prefixes va: ;
        sh:select """SELECT $this WHERE { $this va:hasArtifactRole va:Role_DelegatesToOntology ; va:artifactPath ?p .
                     FILTER (STRENDS(?p, ".py")) FILTER NOT EXISTS { ?f va:functionOf $this } }""" ] .


va: sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

# ==== file variant_algebra_language_clue_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- language clue rules, v1.0.0 (VAF-WI-138, 2026-10-04)
# Reads a program's words (names, docstrings, comments, error messages) into relations between its members, and follows the
# relations along chains. Owner, 2026-10-04: verbs, adjectives and adverbs are clues to semantic, behavioural and contextual
# relations; discover the entities, relations and implications from the sentences; follow chains X-Y, Y-Z, Z-W; the chain
# is followed to a fixpoint (no depth number) and carries the weakest grounding along it.
# Python only harvests (words, lemmas, morphemes, member names, the model's own relations) and reads the results back; every
# decision below is a rule (va:Decision_NoDecisionsInCode_2026_09_28). The words of each language are in
# variant_algebra_language_lexicon_v1_0_0.ttl; a language is added there, not here.
#
# Strata (each runs to a fixpoint):
#   1 clue class of a span (word or morpheme)       2 hits per language in a unit        3 language of a unit
#   4 alignment of a span to a member (name, head word of a name, or a project gloss; a name whose first word is an accessor prefix has no head word)
#   5 span properties: prohibited (an operation that is not allowed), negated (a state that is negated)
#   6 relations: only after, only before, needs state, forbidden in state, from the clue patterns
#   7 implications: a needs-state relation followed through the method that reaches the state, an 'only after' relation,
#     and every chain of them (transitive closure), the rank being the minimum along the chain
#   8 the best-ranked implication per pair          9 the model's own relations, closed, and which relations it already holds
# Spans: a span is one or two consecutive words; its keys are the surface word and the lemma candidates, each prefixed by the
# language ("en|approve"); a member's keys are its name, its name without separators, and the first word of the name (its verb).
# ============================================================

<http://example.org/vaf-consolidated/language-clue-rules>
    rdfs:label "VAF Language Clue SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ; dcterms:identifier "variant_algebra_language_clue_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ; owl:versionIRI <http://example.org/vaf-consolidated/language-clue-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:LcClassShape a sh:NodeShape ; sh:targetClass va:LcSpan ;
    rdfs:label "A word or morpheme that the lexicon lists is a clue of its class"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?c a va:LcClassed ; va:lcClsSpan $this ; va:lcCls ?cls ; va:lcClsLang ?lang ; va:lcClsSide ?side ; va:lcClsOrder ?ord }
        WHERE { $this va:lcKey ?k . ?w a va:LcWord ; va:lcLexKey ?k ; va:lcClass ?cls . OPTIONAL { ?w va:lcArgSide ?side } OPTIONAL { ?w va:lcOrder ?ord } BIND(STRBEFORE(?k, "|") AS ?lang) BIND(IRI(CONCAT(STR($this), "/c/", MD5(CONCAT(?k, ?cls)))) AS ?c) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?c a va:LcClassed ; va:lcClsSpan $this ; va:lcCls ?cls ; va:lcClsLang ?lang }
        WHERE { $this va:lcFeature ?f . ?w a va:LcWord ; va:lcLexFeature ?f ; va:lcClass ?cls . BIND(STRBEFORE(?f, "|") AS ?lang) BIND(IRI(CONCAT(STR($this), "/f/", MD5(CONCAT(?f, ?cls)))) AS ?c) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?c a va:LcClassed ; va:lcClsSpan $this ; va:lcCls ?cls ; va:lcClsLang ?lang }
        WHERE { $this va:lcSurface ?k . ?w a va:LcWord ; va:lcLexPattern ?x ; va:lcClass ?cls . BIND(STRBEFORE(?k, "|") AS ?lang) FILTER(?lang = STRBEFORE(?x, "|") && REGEX(STRAFTER(?k, "|"), STRAFTER(?x, "|"))) BIND(IRI(CONCAT(STR($this), "/x/", MD5(CONCAT(?k, ?cls, ?x)))) AS ?c) }""" ] .

va:LcLanguageShape a sh:NodeShape ; sh:targetClass va:LcUnit ;
    rdfs:label "The language of a unit is the language with the most clue words in it (a tie decides nothing)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?h a va:LcHit ; va:lcHitUnit $this ; va:lcHitLang ?lang ; va:lcHitN ?n }
        WHERE { { SELECT $this ?lang (COUNT(DISTINCT ?c) AS ?n) WHERE { ?s va:lcOf $this . ?c va:lcClsSpan ?s ; va:lcCls ?cls ; va:lcClsLang ?lang . FILTER(?cls != "ACCESSOR") } GROUP BY $this ?lang } BIND(IRI(CONCAT(STR($this), "/hit/", ?lang)) AS ?h) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcLang ?lang }
        WHERE { ?h va:lcHitUnit $this ; va:lcHitLang ?lang ; va:lcHitN ?n . FILTER NOT EXISTS { ?h2 va:lcHitUnit $this ; va:lcHitLang ?l2 ; va:lcHitN ?n2 . FILTER(?l2 != ?lang && ?n2 >= ?n) } }""" ] .

va:LcAlignShape a sh:NodeShape ; sh:targetClass va:LcSpan ;
    rdfs:label "A span is aligned to the member whose name it spells, or whose project gloss it is"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcAligned ?m }
        WHERE { $this va:lcOf ?u ; va:lcKey ?k . ?u va:lcLang ?L . FILTER(STRSTARTS(?k, CONCAT(?L, "|"))) ?m a va:LcMember ; va:lcMemberKeyNode ?kn . ?kn va:lcMemberKey ?mk ; va:lcMemberKeyKind ?kk . FILTER(?mk = STRAFTER(?k, "|")) FILTER(?kk = "full" || NOT EXISTS { ?m va:lcMemberKeyNode ?hn . ?hn va:lcMemberKeyKind "head" ; va:lcMemberKey ?hk . ?aw a va:LcWord ; va:lcClass "ACCESSOR" ; va:lcLexKey ?alk . FILTER(?alk = CONCAT(?L, "|", ?hk)) }) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcAligned ?m }
        WHERE { $this va:lcOf ?u ; va:lcKey ?k . ?u va:lcLang ?L . FILTER(STRSTARTS(?k, CONCAT(?L, "|"))) ?g a va:LcGloss ; va:lcGlossLang ?L ; va:lcGlossKey ?gk ; va:lcGlossMember ?gm . FILTER(?gk = STRAFTER(?k, "|")) BIND(IRI(CONCAT("urn:vaf:lc:m:", ?gm)) AS ?m) ?m a va:LcMember }""" ] .

va:LcPropertyShape a sh:NodeShape ; sh:targetClass va:LcSpan ;
    rdfs:label "An operation after 'cannot' (or carrying the morpheme) is prohibited; a state after 'not' (or carrying the morpheme) is negated"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcProhibited true }
        WHERE { $this va:lcOf ?u ; va:lcFrom ?vf ; va:lcAligned ?v . ?v va:lcKind "method" . ?u va:lcLang ?L . ?c va:lcCls "NEGMODAL" ; va:lcClsLang ?L ; va:lcClsSide "right" ; va:lcClsSpan ?n . ?n va:lcOf ?u ; va:lcTo ?nt . FILTER(?nt < ?vf) FILTER NOT EXISTS { ?s2 va:lcOf ?u ; va:lcFrom ?f2 ; va:lcAligned ?m2 . ?m2 va:lcKind "method" . FILTER(?f2 > ?nt && ?f2 < ?vf) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcProhibited true }
        WHERE { $this va:lcOf ?u ; va:lcFrom ?vf ; va:lcTo ?vt ; va:lcAligned ?v . ?v va:lcKind "method" . ?u va:lcLang ?L . ?c va:lcCls "NEGMODAL" ; va:lcClsLang ?L ; va:lcClsSpan ?n . FILTER NOT EXISTS { ?c va:lcClsSide ?any } ?n va:lcOf ?u ; va:lcFrom ?nf ; va:lcTo ?nt . FILTER(?nf >= ?vf && ?nt <= ?vt) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcNegated true }
        WHERE { $this va:lcOf ?u ; va:lcFrom ?sf ; va:lcAligned ?s . ?s va:lcKind "state value" . ?u va:lcLang ?L . ?c va:lcCls "NOT" ; va:lcClsLang ?L ; va:lcClsSide "right" ; va:lcClsSpan ?n . ?n va:lcOf ?u ; va:lcTo ?nt . FILTER(?nt < ?sf) FILTER NOT EXISTS { ?s2 va:lcOf ?u ; va:lcFrom ?f2 ; va:lcAligned ?m2 . ?m2 va:lcKind "state value" . FILTER(?f2 > ?nt && ?f2 < ?sf) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcNegated true }
        WHERE { $this va:lcOf ?u ; va:lcTo ?st ; va:lcAligned ?s . ?s va:lcKind "state value" . ?u va:lcLang ?L . ?c va:lcCls "NOT" ; va:lcClsLang ?L ; va:lcClsSide "left" ; va:lcClsSpan ?n . ?n va:lcOf ?u ; va:lcFrom ?nf . FILTER(?nf > ?st) FILTER NOT EXISTS { ?s2 va:lcOf ?u ; va:lcTo ?t2 ; va:lcAligned ?m2 . ?m2 va:lcKind "state value" . FILTER(?t2 < ?nf && ?t2 > ?st) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcNegated true }
        WHERE { $this va:lcOf ?u ; va:lcFrom ?sf ; va:lcTo ?st ; va:lcAligned ?s . ?s va:lcKind "state value" . ?u va:lcLang ?L . ?c va:lcCls "NOT" ; va:lcClsLang ?L ; va:lcClsSpan ?n . FILTER NOT EXISTS { ?c va:lcClsSide ?any } ?n va:lcOf ?u ; va:lcFrom ?nf ; va:lcTo ?nt . FILTER(?nf >= ?sf && ?nt <= ?st) }""" ] .

va:LcTemporalShape a sh:NodeShape ; sh:targetClass va:LcClassed ;
    rdfs:label "'only ... after B' makes A come only after B; 'only ... before B' makes A possible only before B (the complement of the clue is on its right in English and on its left in Turkish)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred "only after" ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "AFTER" ; va:lcClsSide "right" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcFrom ?tf ; va:lcTo ?tt . ?u va:lcLang ?L . ?o va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u . ?sb va:lcOf ?u ; va:lcFrom ?bf ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bf > ?tt) FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcFrom ?b2f ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2f > ?tt && ?b2f < ?bf) } ?sa va:lcOf ?u ; va:lcTo ?at ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?at < ?tf) FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcTo ?a2t ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2t < ?tf && ?a2t > ?at) } FILTER(?a != ?b) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), "only after", STR(?b), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred "only after" ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "AFTER" ; va:lcClsSide "left" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcFrom ?tf ; va:lcTo ?tt . ?u va:lcLang ?L . ?o va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u . ?sb va:lcOf ?u ; va:lcTo ?bt ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bt < ?tf) FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcTo ?b2t ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2t < ?tf && ?b2t > ?bt) } ?sa va:lcOf ?u ; va:lcFrom ?af ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?af > ?tt) FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcFrom ?a2f ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2f > ?tt && ?a2f < ?af) } FILTER(?a != ?b) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), "only after", STR(?b), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred "only before" ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "BEFORE" ; va:lcClsSide "right" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcFrom ?tf ; va:lcTo ?tt . ?u va:lcLang ?L . ?o va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u . ?sb va:lcOf ?u ; va:lcFrom ?bf ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bf > ?tt) FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcFrom ?b2f ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2f > ?tt && ?b2f < ?bf) } ?sa va:lcOf ?u ; va:lcTo ?at ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?at < ?tf) FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcTo ?a2t ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2t < ?tf && ?a2t > ?at) } FILTER(?a != ?b) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), "only before", STR(?b), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred "only before" ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "BEFORE" ; va:lcClsSide "left" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcFrom ?tf ; va:lcTo ?tt . ?u va:lcLang ?L . ?o va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u . ?sb va:lcOf ?u ; va:lcTo ?bt ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bt < ?tf) FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcTo ?b2t ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2t < ?tf && ?b2t > ?bt) } ?sa va:lcOf ?u ; va:lcFrom ?af ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?af > ?tt) FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcFrom ?a2f ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2f > ?tt && ?a2f < ?af) } FILTER(?a != ?b) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), "only before", STR(?b), STR(?u))))) AS ?r) }""" ] .

# ---- VAF-WI-143: normative claims (obliged, permitted, forbidden: an operation) and triggers (one operation triggers another)
# A modal word before an operation (English, complement on its right, within the modal window) or an ending inside the span that
# names the operation (Turkish). 'must'/'may' with 'not' right after, or the ending 'must not', is a prohibition. A permission in a
# unit that says 'only' is not asserted as one: 'only a requested loan may be approved' restricts, and is the needs-state relation.
va:LcModalShape a sh:NodeShape ; sh:targetClass va:LcClassed ;
    rdfs:label "'must' obliges, 'may' permits, and 'must not' or 'may not' forbids the operation they govern"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred ?pred ; va:lcUnit ?u ; va:lcRank ?rk ; va:lcConditional ?cond }
        WHERE { VALUES (?cl ?pred) { ("MUST" "obliged") ("MAY" "permitted") }
                $this va:lcCls ?cl ; va:lcClsSide "right" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcTo ?tt . ?u va:lcLang ?L . va:lcWindowModal va:lcValue ?W .
                ?sv va:lcOf ?u ; va:lcFrom ?vf ; va:lcAligned ?v . ?v va:lcKind "method" . FILTER(?vf > ?tt && ?vf - ?tt <= ?W)
                FILTER NOT EXISTS { ?sv2 va:lcOf ?u ; va:lcFrom ?f2 ; va:lcAligned ?m2 . ?m2 va:lcKind "method" . FILTER(?f2 > ?tt && ?f2 < ?vf) }
                FILTER NOT EXISTS { ?nc va:lcCls "NOT" ; va:lcClsLang ?L ; va:lcClsSpan ?ns . ?ns va:lcOf ?u ; va:lcFrom ?nf . FILTER(?nf = ?tt + 1) }
                FILTER(?cl != "MAY" || NOT EXISTS { ?oc va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u })
                ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(EXISTS { ?cc va:lcCls "COND" ; va:lcClsLang ?L ; va:lcClsSpan ?cs . ?cs va:lcOf ?u } AS ?cond) BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), ?pred, STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred "forbidden" ; va:lcUnit ?u ; va:lcRank ?rk ; va:lcConditional ?cond }
        WHERE { VALUES ?cl { "MUST" "MAY" }
                $this va:lcCls ?cl ; va:lcClsSide "right" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcTo ?tt . ?u va:lcLang ?L . va:lcWindowModal va:lcValue ?W .
                ?nc va:lcCls "NOT" ; va:lcClsLang ?L ; va:lcClsSpan ?ns . ?ns va:lcOf ?u ; va:lcFrom ?nf . FILTER(?nf = ?tt + 1)
                ?sv va:lcOf ?u ; va:lcFrom ?vf ; va:lcAligned ?v . ?v va:lcKind "method" . FILTER(?vf > ?nf && ?vf - ?nf <= ?W)
                FILTER NOT EXISTS { ?sv2 va:lcOf ?u ; va:lcFrom ?f2 ; va:lcAligned ?m2 . ?m2 va:lcKind "method" . FILTER(?f2 > ?nf && ?f2 < ?vf) }
                ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(EXISTS { ?cc va:lcCls "COND" ; va:lcClsLang ?L ; va:lcClsSpan ?cs . ?cs va:lcOf ?u } AS ?cond) BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), "forbidden", STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred ?pred ; va:lcUnit ?u ; va:lcRank ?rk ; va:lcConditional ?cond }
        WHERE { VALUES (?cl ?pred) { ("MUST" "obliged") ("MAY" "permitted") ("MUSTNOT" "forbidden") }
                $this va:lcCls ?cl ; va:lcClsLang ?L ; va:lcClsSpan ?n . FILTER NOT EXISTS { $this va:lcClsSide ?any }
                ?n va:lcOf ?u ; va:lcFrom ?nf ; va:lcTo ?nt . ?u va:lcLang ?L .
                ?sv va:lcOf ?u ; va:lcFrom ?vf ; va:lcTo ?vt ; va:lcAligned ?v . ?v va:lcKind "method" . FILTER(?nf >= ?vf && ?nt <= ?vt)
                FILTER(?cl != "MAY" || NOT EXISTS { ?oc va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u })
                FILTER(?cl != "MUST" || NOT EXISTS { ?x va:lcCls "MUSTNOT" ; va:lcClsLang ?L ; va:lcClsSpan ?xs . ?xs va:lcOf ?u ; va:lcFrom ?xf ; va:lcTo ?xt . FILTER(?xf >= ?vf && ?xt <= ?vt) })
                ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(EXISTS { ?cc va:lcCls "COND" ; va:lcClsLang ?L ; va:lcClsSpan ?cs . ?cs va:lcOf ?u } AS ?cond) BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), ?pred, STR(?u))))) AS ?r) }""" ] .

va:LcTriggerShape a sh:NodeShape ; sh:targetClass va:LcClassed ;
    rdfs:label "'A triggers B' (English: A before the verb, B after) and 'A, B-yi tetikler' (Turkish: both before the verb, A first): the nearest operations on each side"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred ?pred ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls ?cl ; va:lcClsOrder "SVO" ; va:lcClsLang ?L ; va:lcClsSpan ?t . FILTER(?cl IN ("TRIGGER", "COMEBEFORE")) BIND(IF(?cl = "COMEBEFORE", "precedes", "triggers") AS ?pred)
                ?t va:lcOf ?u ; va:lcFrom ?tf ; va:lcTo ?tt . ?u va:lcLang ?L .
                FILTER(?cl != "COMEBEFORE" || EXISTS { ?bc va:lcCls "BEFORE" ; va:lcClsSpan ?bs . ?bs va:lcOf ?u ; va:lcFrom ?bsf . FILTER(?bsf = ?tt + 1) })
                ?sa va:lcOf ?u ; va:lcTo ?at ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?at < ?tf)
                FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcTo ?a2t ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2t < ?tf && ?a2t > ?at) }
                ?sb va:lcOf ?u ; va:lcFrom ?bf ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bf > ?tt && ?a != ?b)
                FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcFrom ?b2f ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2f > ?tt && ?b2f < ?bf) }
                ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), ?pred, STR(?b), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?a ; va:lcPred "triggers" ; va:lcObj ?b ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "TRIGGER" ; va:lcClsOrder "SOV" ; va:lcClsLang ?L ; va:lcClsSpan ?t . ?t va:lcOf ?u ; va:lcFrom ?tf . ?u va:lcLang ?L .
                ?sb va:lcOf ?u ; va:lcFrom ?bf ; va:lcTo ?bt ; va:lcAligned ?b . ?b va:lcKind "method" . FILTER(?bt < ?tf)
                FILTER NOT EXISTS { ?sb2 va:lcOf ?u ; va:lcTo ?b2t ; va:lcAligned ?b2 . ?b2 va:lcKind "method" . FILTER(?b2t < ?tf && ?b2t > ?bt) }
                ?sa va:lcOf ?u ; va:lcTo ?at ; va:lcAligned ?a . ?a va:lcKind "method" . FILTER(?at < ?bf && ?a != ?b)
                FILTER NOT EXISTS { ?sa2 va:lcOf ?u ; va:lcTo ?a2t ; va:lcAligned ?a2 . ?a2 va:lcKind "method" . FILTER(?a2t < ?bf && ?a2t > ?at) }
                ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?a), "triggers", STR(?b), STR(?u))))) AS ?r) }""" ] .

va:LcStateShape a sh:NodeShape ; sh:targetClass va:LcSpan ;
    rdfs:label "A prohibited operation with a negated state needs that state; with a plain state it is forbidden in that state; 'only' with a state needs it; 'only valid for' a state needs it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred "needs state" ; va:lcObj ?s ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcProhibited true ; va:lcOf ?u ; va:lcFrom ?vf ; va:lcTo ?vt ; va:lcAligned ?v . ?v va:lcKind "method" . ?sp va:lcNegated true ; va:lcOf ?u ; va:lcFrom ?sf ; va:lcTo ?stt ; va:lcAligned ?s . ?s va:lcKind "state value" . FILTER(?stt < ?vf || ?sf > ?vt) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), "needs state", STR(?s), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred "forbidden in state" ; va:lcObj ?s ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcProhibited true ; va:lcOf ?u ; va:lcFrom ?vf ; va:lcTo ?vt ; va:lcAligned ?v . ?v va:lcKind "method" . ?sp va:lcOf ?u ; va:lcFrom ?sf ; va:lcTo ?stt ; va:lcAligned ?s . ?s va:lcKind "state value" . FILTER NOT EXISTS { ?sp va:lcNegated true } FILTER(?stt < ?vf || ?sf > ?vt) ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), "forbidden in state", STR(?s), STR(?u))))) AS ?r) }""" ] .

va:LcOnlyShape a sh:NodeShape ; sh:targetClass va:LcClassed ;
    rdfs:label "'only <state> ... <operation>' needs the state; 'only valid for <state>' needs it for the operation before it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred "needs state" ; va:lcObj ?s ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u ; va:lcTo ?ot . ?u va:lcLang ?L . va:lcWindowOnlyState va:lcValue ?W . ?ss va:lcOf ?u ; va:lcFrom ?sf ; va:lcTo ?stt ; va:lcAligned ?s . ?s va:lcKind "state value" . FILTER(?sf > ?ot && ?sf - ?ot <= ?W) FILTER NOT EXISTS { ?ss2 va:lcOf ?u ; va:lcFrom ?s2f ; va:lcAligned ?s2 . ?s2 va:lcKind "state value" . FILTER(?s2f > ?ot && ?s2f < ?sf) } ?sv va:lcOf ?u ; va:lcFrom ?vf ; va:lcAligned ?v . ?v va:lcKind "method" . FILTER(?vf > ?stt) FILTER NOT EXISTS { ?sv2 va:lcOf ?u ; va:lcFrom ?v2f ; va:lcAligned ?v2 . ?v2 va:lcKind "method" . FILTER(?v2f > ?stt && ?v2f < ?vf) } FILTER NOT EXISTS { ?tc va:lcCls ?tcl ; va:lcClsLang ?L ; va:lcClsSpan ?ts . ?ts va:lcOf ?u ; va:lcFrom ?tsf . FILTER(?tcl IN ("AFTER", "BEFORE") && ?tsf > ?ot && ?tsf < ?vf) } ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), "needs state", STR(?s), STR(?u))))) AS ?r) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?r a va:LcRel ; va:lcSubj ?v ; va:lcPred "needs state" ; va:lcObj ?s ; va:lcUnit ?u ; va:lcRank ?rk }
        WHERE { $this va:lcCls "VALID" ; va:lcClsLang ?L ; va:lcClsSpan ?vs . ?vs va:lcOf ?u ; va:lcFrom ?vlf . ?u va:lcLang ?L . ?oc va:lcCls "ONLY" ; va:lcClsLang ?L ; va:lcClsSpan ?os . ?os va:lcOf ?u ; va:lcTo ?ot . FILTER(?ot + 1 = ?vlf) ?sv va:lcOf ?u ; va:lcTo ?vt ; va:lcAligned ?v . ?v va:lcKind "method" . FILTER(?vt < ?ot) FILTER NOT EXISTS { ?sv2 va:lcOf ?u ; va:lcTo ?v2t ; va:lcAligned ?v2 . ?v2 va:lcKind "method" . FILTER(?v2t < ?ot && ?v2t > ?vt) } ?fc va:lcCls "FOR" ; va:lcClsLang ?L ; va:lcClsSpan ?fs . ?fs va:lcOf ?u ; va:lcFrom ?ff ; va:lcTo ?ft . FILTER(?ff > ?vlf) FILTER NOT EXISTS { ?fc2 va:lcCls "FOR" ; va:lcClsLang ?L ; va:lcClsSpan ?fs2 . ?fs2 va:lcOf ?u ; va:lcFrom ?ff2 . FILTER(?ff2 > ?vlf && ?ff2 < ?ff) } ?ss va:lcOf ?u ; va:lcFrom ?sf ; va:lcAligned ?s . ?s va:lcKind "state value" . FILTER(?sf > ?ft) FILTER NOT EXISTS { ?ss2 va:lcOf ?u ; va:lcFrom ?s2f ; va:lcAligned ?s2 . ?s2 va:lcKind "state value" . FILTER(?s2f > ?ft && ?s2f < ?sf) } ?u va:lcKind ?uk . ?sr a va:LcSourceRank ; va:lcSourceKind ?uk ; va:lcRankValue ?rk . BIND(IRI(CONCAT("urn:vaf:lc:r:", MD5(CONCAT(STR(?v), "needs state", STR(?s), STR(?u))))) AS ?r) }""" ] .

va:LcImplyShape a sh:NodeShape ; sh:targetClass va:LcRel ;
    rdfs:label "What a relation implies: a needs-state relation through the method that reaches the state, an 'only after' relation, and every chain of them (the rank is the minimum along the chain)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?i a va:LcImp ; va:lcImpFrom ?m ; va:lcImpTo ?p ; va:lcImpRank ?rk ; va:lcImpVia ?s ; va:lcImpHow "needs state, reached by method" }
        WHERE { $this va:lcPred "needs state" ; va:lcSubj ?m ; va:lcObj ?s ; va:lcRank ?r0 . ?s va:lcReachedBy ?p . FILTER(?m != ?p) ?cr a va:LcSourceRank ; va:lcSourceKind "code" ; va:lcRankValue ?c . BIND(IF(?r0 < ?c, ?r0, ?c) AS ?rk) BIND(IRI(CONCAT("urn:vaf:lc:i:", MD5(CONCAT(STR(?m), STR(?p), STR(?rk))))) AS ?i) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?i a va:LcImp ; va:lcImpFrom ?m ; va:lcImpTo ?p ; va:lcImpRank ?rk ; va:lcImpHow "only after" }
        WHERE { $this va:lcPred "only after" ; va:lcSubj ?m ; va:lcObj ?p ; va:lcRank ?rk . BIND(IRI(CONCAT("urn:vaf:lc:i:", MD5(CONCAT(STR(?m), STR(?p), STR(?rk))))) AS ?i) }""" ] .

va:LcChainShape a sh:NodeShape ; sh:targetClass va:LcImp ;
    rdfs:label "A chain: X implies Y and Y implies Z, so X implies Z, with the lower of the two ranks and Y as the way through (followed to a fixpoint)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?i a va:LcImp ; va:lcImpFrom ?x ; va:lcImpTo ?z ; va:lcImpRank ?rk ; va:lcImpVia ?y ; va:lcImpHow "chain" }
        WHERE { $this va:lcImpFrom ?x ; va:lcImpTo ?y ; va:lcImpRank ?r1 . ?j a va:LcImp ; va:lcImpFrom ?y ; va:lcImpTo ?z ; va:lcImpRank ?r2 . FILTER(?x != ?z) BIND(IF(?r1 < ?r2, ?r1, ?r2) AS ?rk) BIND(IRI(CONCAT("urn:vaf:lc:i:", MD5(CONCAT(STR(?x), STR(?z), STR(?rk))))) AS ?i) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcImpBest true }
        WHERE { $this va:lcImpFrom ?x ; va:lcImpTo ?z ; va:lcImpRank ?rk . FILTER NOT EXISTS { ?o a va:LcImp ; va:lcImpFrom ?x ; va:lcImpTo ?z ; va:lcImpRank ?rk2 . FILTER(?rk2 > ?rk) } }""" ] .

va:LcModelShape a sh:NodeShape ; sh:targetClass va:LcModelRel ;
    rdfs:label "The model's own relations, closed under chains (a state reached by a method is the method), and which words-read relations it already holds"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 9 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { ?c a va:LcModelRel ; va:lcModelPred "requires" ; va:lcModelFrom ?x ; va:lcModelTo ?z }
        WHERE { $this va:lcModelPred "requires" ; va:lcModelFrom ?x ; va:lcModelTo ?y . ?j a va:LcModelRel ; va:lcModelPred "requires" ; va:lcModelFrom ?y ; va:lcModelTo ?z . FILTER(?x != ?z) BIND(IRI(CONCAT("urn:vaf:lc:mr:", MD5(CONCAT(STR(?x), STR(?z))))) AS ?c) }""" ] .

va:LcHeldShape a sh:NodeShape ; sh:targetClass va:LcRel ;
    rdfs:label "A relation read from words is held by the model when the model states it or its closure implies it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcInModel true }
        WHERE { $this va:lcPred "only after" ; va:lcSubj ?a ; va:lcObj ?b . ?m a va:LcModelRel ; va:lcModelPred "requires" ; va:lcModelFrom ?a ; va:lcModelTo ?b }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcInModel true }
        WHERE { $this va:lcPred "needs state" ; va:lcSubj ?a ; va:lcObj ?s . ?m a va:LcModelRel ; va:lcModelPred "requires" ; va:lcModelFrom ?a ; va:lcModelTo ?s }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcInModel true }
        WHERE { $this va:lcPred "forbidden in state" ; va:lcSubj ?a ; va:lcObj ?s . ?m a va:LcModelRel ; va:lcModelPred "excludes" ; va:lcModelFrom ?a ; va:lcModelTo ?s }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcInModel true }
        WHERE { $this va:lcPred "only before" ; va:lcSubj ?a ; va:lcObj ?b . ?m a va:LcModelRel ; va:lcModelPred "excludes" ; va:lcModelFrom ?a ; va:lcModelTo ?b }""" ] .

va:LcImpHeldShape a sh:NodeShape ; sh:targetClass va:LcImp ;
    rdfs:label "An implication is held by the model when its closure states it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/language-clue-rules> ; sh:construct """
        CONSTRUCT { $this va:lcInModel true }
        WHERE { $this va:lcImpFrom ?a ; va:lcImpTo ?b . ?m a va:LcModelRel ; va:lcModelPred "requires" ; va:lcModelFrom ?a ; va:lcModelTo ?b }""" ] .

# ==== file variant_algebra_operator_rules_v8_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- operator rules v9.1.0 (VAF-WI-255: the laws of the operators are rules -- a division joins on its own node, a subtraction keeps the sets without the names of its right side, a negation or condition is judged level by level, a removed feature keeps its sets; 9.0.0: VAF-WI-237: a condition on any expression, 'e when c'; 8.0.0: VAF-WI-227, -228, -229, -232: the Cartesian product and division between expressions, repetition counts, a counted name joined to another; 7.0.0 is the differential oracle)
# was: operator rules v7.1.0 (VAF-WI-135: truth only for nodes something reads); before that v7.0.0 (VAF-WI-100, -111, -113, -117, -112, -118, -119, -121, -122; 2026-09-28)
#
# The operator rules of v1.x, stated once per operator over candidates, so that the ontology itself generates a
# component's candidates, evaluates every statement in each, and counts the variants. A model enters as the triples
# the parser emits (06-runtime/src/variant_dsl_parser_v1_0_0.py, to_ttl); nothing else is computed outside.
#
# Semantics carried over from v1.x (owner, va:Decision_OwnerClarification_2026_09_28):
#   bare exclusive: exactly one member present; exclusive inside an optional list: at most one;
#   or: at least one; dependency: every dependent present requires every prerequisite;
#   intersection: co-selection (both or neither); repetition: a bound on counts, a k-of-n bound on members;
#   division / partner exclusion / subtraction / inverse: the removed features are purged from every variant.
# Carried from the recorded decisions where v1.x had no rule:
#   subtraction inside an expression: a and not b (va:Decision_SubtractionRevisit_2026_09_25);
#   next / sequence: b never without a, only where the edge's condition holds (va:Decision_DescriptorsAndOccurrences_2026_09_25,
#   va:Decision_EdgeConditionSyntax_2026_09_25); lists: every item holds, a list on the left of '<' is a set of
#   dependents, '[a, b]' declares optional items (va:Decision_TerminalsAndLeftLists_2026_09_26,
#   va:Decision_ListsAndVariables_2026_09_26); a repeated group repeats as a unit (va:Decision_RepetitionNotation_2026_09_25);
#   addition inside an expression: both operands present (thesis eq. 2.28, co-inclusion).
# Cartesian product and division between expressions (8.0.0): a * b joins one set of each side as + does and drops a pair whose
# features are partners that exclude each other (va:excludesPartner); a / b is each set of a with the features of b removed
# (a / a is the empty variant). An edge with a condition used as an operand still has no candidate reading and is reported as
# not evaluable, never silently admitted or rejected.
#
# CONSUMERS (VAF-WI-260). Run these rules with the executor named below, on Oxigraph, not with pySHACL. Measured on 2026-10-22 on one
# parsed component (three optional features, an exclusive, a dependency, an at-most bound): the native evaluator and the executor give
# 3 variants; pySHACL (advanced, in place, no inference, the prescribed configuration) ends without an error, with one variant node and
# no count, a wrong answer that is silent. The PIB package reports, on its own models, an AttributeError ('NotBoundError' has no
# 'datatype') raised by rdflib inside the counting rules. The PIB package also reports that the blank nodes of a model must be
# skolemised first (variant_native_evaluator does it, to urn:vaf:node:), because the generation rules build the IRI of a candidate by
# joining strings on the node they branch from, so that an RDF list of operator members left as blank nodes yields no candidate and
# no error; that point is not re-measured here. The input of the rules is what the parser emits (an operator typed directly, carrying
# va:members); a va:OperatorApplication is the record of a calculus run and is not read as input.
#
# EXECUTION. The rules are run by sh:order stratum: every rule of the lowest order to a fixpoint, then the next.
# Aggregates and negation read only strata already complete (a substitution's model rewrite 1-9, setup 10-16, names, independent groups and weights 17-19.5, generated sets 24-25, candidates and pruning 25.05-25.4, truth 26 and 30,
# relations over the whole variant 25.5-26.4, admissibility 40, conditional substitution 42-44, variants and counts 45-46).
# 06-runtime/src/variant_rule_executor_v1_0_0.py runs them as SPARQL updates.
# 2.1.0 (VAF-WI-111): slot bounds are the declared bounds and a purged slot allows 0 only; the combinatorial upper
# bound; a conditional substitution's variant rewrite; the variants (va:Variant) and their count; partner exclusion
# over the ontology's va:SetA / va:SetB as well as the language's statements; the v1.x rules for weak grounding and
# for the intersection's result members carried over. Rules 1.x left the live tree with this version; its rules with
# no user and no counterpart here (the Optional marker va:isAdmissible, partition, Cartesian pairing, the
# candidateMember form of purge) are listed in _quarantine/2026-09-28-enumeration-engines/README.md.
# 2.2.0 (VAF-WI-113): a substitution's model rewrite (orders 1-9) -- until then Python (apply_substitutions).
# 3.0.0 (VAF-WI-117, breaking): one meaning for every expression (va:Decision_OneMeaningGenerated_2026_09_28). An
# expression means the sets it generates; a statement holds in a candidate when the candidate restricted to the
# statement's names is one of them. Per candidate this is compositional: the part of an expression that is not chosen
# has its own names absent (|, $, [ ], &); a < b is a with b, a bare name being present
# (va:Decision_DependencyPresence_2026_09_28); a subtraction or inverse statement is a constraint. The keyword forms keep
# their meaning over names ('requires' is 'if a then b', the shorthand of [(a < b) | b]); edges keep 'b never without a'
# ([(b < a) | a]). A feature's truth has its own stage (29); the absence of an expression's names is read from it (29.5).
# 3.1.0 (VAF-WI-112): a repeated group inside an expression ({a, b}[m..n], name[m..n]) -- the group rule also decides
# it: its members occur equally often, and all of them may be absent only when its lower bound is 0.
# Also 3.1.0: a feature's presence (va:presentIn, va:absentIn) is stated apart from its truth, and the absence of an
# expression's names is read from presence. They differ only for a variable whose definition generates the empty set
# (va:admitsEmptyVariant, stated by the definition rules): absent, it holds as its definition does -- so a definition
# evaluated with its variables as units gives, once expanded, the variants of the expression written out in full.
# Also 3.1.0: classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28): the carrier rules
# (order 31), the body clauses of the slot bounds and of admissibility, and a substitution's blocks inside the component
# are removed; a substitution's block is its component, so a classifier is no longer replaced wholesale.
# 4.0.0 (VAF-WI-118, breaking): the rules generate each expression's sets (va:Decision_OneMeaningGenerated_2026_09_28,
# va:Decision_AdditionIsAdditive_2026_09_28) instead of judging each operator per candidate; a node holds in a candidate
# when the candidate's counts on the node's features are one of its sets (one truth rule, va:MembershipRuleShape). The
# per-candidate reading of 3.x agreed with the generated sets only when no two operands shared a name ((p $ q) + p gave
# {p}; '+' generates {p} and {p, q}). A variable stands for its definition (va:hasDefinitionRoot), so a model of
# definitions is generated by the same rules (orders 27-28 count it and view it through each definition); the
# expansion rules of 3.1.0 and the presence terms (va:presentIn, va:absentIn, va:admitsEmptyVariant) are retired.
# 5.0.0 (VAF-WI-119, breaking): exclusion and dependency hold for the whole variant (va:Decision_CalculusFirstGlobalRelations_2026_09_28,
# va:Decision_WholeVariantIteration_2026_09_28). The sets are generated as in 4.0.0 (the joins are the expression's
# normal form: '+' distributed over the choices); then every X $ Y and X < Y that a statement or a variable's definition
# states -- not under a negation, not under a conditioned edge -- is checked on the whole variant (a component's
# candidate, a variable's set). What an operand contributes to a variant is the features of every non-empty set of the
# operand contained in it; X $ Y fails when both contribute and neither contribution contains the other, X < Y fails
# when X contributes and no set of Y is contained (orders 25.5-26.4). So (a $ b) + (a $ c) gives {a} {b, c}, as
# a $ (b + c) does (thesis Table 2.7), and [a] + [b] + [a < b] gives {} {b} {a, b}. A variable's variants are its
# consistent sets (va:ConsistentSet); a component's candidate that breaks a relation is not admissible.
# 6.0.0 (VAF-WI-121): the calculus with the optimisations the framework had lost when the runtime moved onto the rules
# (va:Decision_CalculusOptimised_2026_09_28): a variable's definition is split into independent groups -- items of its
# '+' chains and lists that share no name -- each generated alone, and its capacity is the product of their counts
# (the Sprint 3.2 decomposition, the partition rule of 1.x); in a model of definitions a node's sets are generated only
# where needed, a split variable's own sets (from its definition) only when used or asked for (orders 17.1-19.5); a component's
# candidates are built after the sets, and a branch that already breaks a statement is not extended (the PIB kit's
# pruning, 25.05-25.3); a node's first set among equals is found by grouping, not by comparing every pair (24).
# 7.0.0 (VAF-WI-122, breaking): recursive definitions (va:Decision_RecursionAllowed_2026_09_28). A join's result is raw;
# one representative per node, fold stage and key stands for all equal results and is what parents join, so the sets
# are finitely many and generation stops when a step adds none -- a recursive variable gets the least set its
# definitions close under. Recursion through a negation has no least set and is refused (17). A variable counts as
# generable where it is used (19); a variable inside a repeated group is refused, not read as a name.
# ============================================================

<http://example.org/vaf-consolidated/operator-rules-v2>
    rdfs:label "VAF Operator SHACL-AF Rules v9.1.0"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_operator_rules_v8_0_0" ;
    owl:versionInfo "9.1.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/operator-rules/9.1.0> ;
    owl:priorVersion <http://example.org/vaf-consolidated/operator-rules/9.0.0> ;
    dcterms:replaces <http://example.org/vaf-consolidated/operator-rules/8.0.0> ;
    dcterms:source "01-ontologies/variant_algebra_evaluation_vocabulary_v1_0_0.ttl; 02-shacl-safeguards/variant_algebra_operator_rules_v1_0_0.ttl (1.2.0)." ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

# A rule that uses $this inside a nested group or a negation binds it in that same group, so the rules mean the same
# when $this is pre-bound (SHACL-AF) and when it is joined from the target (the executor).

# ------------------------------------------------------------ 1-9: a substitution's model rewrite (VAF-WI-113)
# 'a ~ b' (va:Decision_ReplacementReading_2026_09_25, va:Decision_SubstitutionSemantics_2026_09_25, round 3): every a in
# the component becomes b (3.1.0: a substitution's block is its component); the substitutions apply one after another
# in the order written (a ~ b, b ~ c gives c; a ~ b, b ~ a gives a). The result is a component of its own (<model>_Result,
# va:Decision_StoreSubstitutionResults_2026_09_26): every statement copied with its names resolved. Conditional
# substitutions ('a ~ b when c') change variants, not statements (va:ConditionalSubstitutionRuleShape). The copy reads
# the model's nodes as IRIs (blank nodes skolemised when a model is loaded).
va:SubstitutionContextRuleShape a sh:NodeShape ; sh:targetClass va:ReplacementOperator ;
    rdfs:comment "Model-first (the substitution's meaning): a result component, and each substitution's block -- its component (3.1.0). Read at variant level (va:VariantLevelReading, the A4 check's comparison), there is no result component."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        PREFIX prov: <http://www.w3.org/ns/prov#>
        CONSTRUCT { ?R a va:Component ; va:substitutionResultOf ?C ; prov:wasDerivedFrom ?C ; va:derivedBySubstitution $this }
        WHERE { ?C va:hasOperator $this . FILTER NOT EXISTS { ?C va:substitutionReading va:VariantLevelReading }
                BIND(IRI(CONCAT(STR(?C), "_Result")) AS ?R) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:substitutionBlock ?b }
        WHERE { ?C va:hasOperator $this . BIND(?C AS ?b) }""" ] .

va:SubstitutionChainRuleShape a sh:NodeShape ; sh:targetClass va:ReplacementOperator ;
    rdfs:comment "A block's substitutions applied one after another as written: from each name, follow the first later substitution of the name reached."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st va:chainBlock ?b ; va:chainStart ?n ; va:chainValue ?n ; va:chainPos 0 }
        WHERE { $this va:substitutionBlock ?b . FILTER NOT EXISTS { $this va:hasConditionExpression ?x }
                { $this va:hasLeftOperand ?n } UNION { $this va:hasRightOperand ?n }
                BIND(IRI(CONCAT(STR(?b), "_chain_", ENCODE_FOR_URI(STR(?n)), "_0")) AS ?st) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st2 va:chainBlock ?b ; va:chainStart ?n ; va:chainValue ?y2 ; va:chainPos ?p }
        WHERE { $this va:substitutionBlock ?b ; va:hasLeftOperand ?y ; va:hasRightOperand ?y2 ; va:writtenOrder ?p .
                FILTER NOT EXISTS { $this va:hasConditionExpression ?x }
                ?st va:chainBlock ?b ; va:chainStart ?n ; va:chainValue ?y ; va:chainPos ?q . FILTER(?p > ?q)
                FILTER NOT EXISTS { ?s2 va:substitutionBlock ?b ; va:hasLeftOperand ?y ; va:writtenOrder ?p2 .
                                    FILTER NOT EXISTS { ?s2 va:hasConditionExpression ?x2 } FILTER(?p2 > ?q && ?p2 < ?p) }
                BIND(IRI(CONCAT(STR(?b), "_chain_", ENCODE_FOR_URI(STR(?n)), "_", STR(?p))) AS ?st2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?m va:mapBlock ?b ; va:mapFrom ?n ; va:mapTo ?y }
        WHERE { $this va:substitutionBlock ?b .
                ?st va:chainBlock ?b ; va:chainStart ?n ; va:chainValue ?y ; va:chainPos ?q . FILTER(?y != ?n)
                FILTER NOT EXISTS { ?s2 va:substitutionBlock ?b ; va:hasLeftOperand ?y ; va:writtenOrder ?p2 .
                                    FILTER NOT EXISTS { ?s2 va:hasConditionExpression ?x2 } FILTER(?p2 > ?q) }
                BIND(IRI(CONCAT(STR(?b), "_map_", ENCODE_FOR_URI(STR(?n)))) AS ?m) }""" ] .

va:SubstitutionResolutionRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:hasOperator ;
    rdfs:comment "Each name a statement uses, passed through the component's mappings (3.1.0: one block, the component)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?fin va:finOp ?O ; va:finRef ?n ; va:finValue ?v }
        WHERE { $this va:hasOperator ?O . ?S a va:ReplacementOperator . $this va:hasOperator ?S .
                FILTER NOT EXISTS { ?O a va:ReplacementOperator }
                ?O (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:members|va:dependentSet|va:prerequisiteSet|rdf:first|rdf:rest)* ?node .
                ?node ?p ?n . ?n a va:Feature .
                OPTIONAL { ?m va:mapBlock $this ; va:mapFrom ?n ; va:mapTo ?z }
                BIND(COALESCE(?z, ?n) AS ?v)
                BIND(IRI(CONCAT(STR(?O), "_fin_ref_", ENCODE_FOR_URI(STR(?n)))) AS ?fin) }""" ] .

va:SubstitutionResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:hasOperator ;
    rdfs:comment "The result component: each statement not dropped, copied with its names resolved; removal and partner-exclusion facts renamed with it; the names its statements use as its features."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?R va:hasOperator ?O2 . ?O2 va:copyOf ?O }
        WHERE { ?R va:substitutionResultOf $this . $this va:hasOperator ?O .
                FILTER NOT EXISTS { ?O a va:ReplacementOperator }
                BIND(IRI(CONCAT(STR(?O), "_r")) AS ?O2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n2 ?p ?x2 }
        WHERE { ?R va:substitutionResultOf $this . ?O2 va:copyOf ?O . ?R va:hasOperator ?O2 .
                ?O (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:members|va:dependentSet|va:prerequisiteSet|rdf:first|rdf:rest)* ?node .
                FILTER NOT EXISTS { ?node a va:Feature } FILTER(?node != rdf:nil)
                ?node ?p ?x . FILTER(?p != va:copyOf)
                BIND(IRI(CONCAT(STR(?node), "_r")) AS ?n2)
                OPTIONAL { ?x a va:Feature . ?fin va:finOp ?O ; va:finRef ?x ; va:finValue ?v }
                BIND(IF(BOUND(?v), ?v, IF(isIRI(?x) && EXISTS { ?O (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:members|va:dependentSet|va:prerequisiteSet|rdf:first|rdf:rest)+ ?x . FILTER NOT EXISTS { ?x a va:Feature } FILTER(?x != rdf:nil) }, IRI(CONCAT(STR(?x), "_r")), ?x)) AS ?x2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?vx ?p ?vy }
        WHERE { ?R va:substitutionResultOf $this . ?O2 va:copyOf ?O . ?R va:hasOperator ?O2 .
                { ?O a va:DivisionOperator } UNION { ?O a va:CartesianOperator }
                ?O va:hasOperand ?x , ?y . ?x ?p ?y . FILTER(?p = va:removes || ?p = va:excludesPartner)
                ?fx va:finOp ?O ; va:finRef ?x ; va:finValue ?vx .
                ?fy va:finOp ?O ; va:finRef ?y ; va:finValue ?vy . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?R va:hasFeature ?v . ?v a va:Feature }
        WHERE { ?R va:substitutionResultOf $this . ?O2 va:copyOf ?O . ?R va:hasOperator ?O2 .
                ?fin va:finOp ?O ; va:finValue ?v }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?O2 va:changedBySubstitution ?S }
        WHERE { ?R va:substitutionResultOf $this . ?O2 va:copyOf ?O . ?R va:hasOperator ?O2 .
                FILTER EXISTS { ?f1 va:finOp ?O ; va:finRef ?n1 ; va:finValue ?v1 . FILTER(?n1 != ?v1) }
                $this va:hasOperator ?S . ?S a va:ReplacementOperator ; va:hasRightOperand ?new . FILTER NOT EXISTS { ?S va:hasConditionExpression ?c }
                ?f2 va:finOp ?O ; va:finValue ?new . }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 9 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?O2 va:changedBySubstitution ?S }
        WHERE { ?R va:substitutionResultOf $this . ?O2 va:copyOf ?O . ?R va:hasOperator ?O2 .
                FILTER EXISTS { ?f1 va:finOp ?O ; va:finRef ?n1 ; va:finValue ?v1 . FILTER(?n1 != ?v1) }
                FILTER NOT EXISTS { ?O2 va:changedBySubstitution ?any }
                $this va:hasOperator ?S . ?S a va:ReplacementOperator . FILTER NOT EXISTS { ?S va:hasConditionExpression ?c } }""" ] .

# ------------------------------------------------------------ 10: the model's context
va:DivisionRuleShape a sh:NodeShape ; sh:targetClass va:DivisionOperator ;
    rdfs:comment "Carried over from v1.x unchanged: an operand survives division unless another operand removes it."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:hasResultMember ?a }
        WHERE { $this va:hasOperand ?a . FILTER NOT EXISTS { $this va:hasOperand ?b . ?b va:removes ?a } }""" ] .

va:VariationSpaceRuleShape a sh:NodeShape ; sh:targetClass va:Component ;
    rdfs:comment "A component's variation space: one slot per feature it names, in a fixed order, and the number of slots."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s a va:VariationSlot ; va:slotOfComponent $this ; va:slotFeature ?f ; va:slotIndex ?i . }
        WHERE { { SELECT $this ?f (COUNT(?g) AS ?i) WHERE { $this va:hasFeature ?f , ?g . FILTER(STR(?g) <= STR(?f)) } GROUP BY $this ?f }
                BIND(IRI(CONCAT(STR($this), "__slot", STR(?i))) AS ?s) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:variationSlotCount ?n }
        WHERE { { SELECT $this (COUNT(?f) AS ?n) WHERE { $this a va:Component . OPTIONAL { $this va:hasFeature ?f } } GROUP BY $this } }""" ] .

va:ConstraintRootRuleShape a sh:NodeShape ; sh:targetClass va:Component ;
    rdfs:comment "The statements every variant must satisfy: all but declarations (mandatory, optional, a feature's repetition) and static relations (removal, partner exclusion, union). A subtraction or inverse statement is a constraint as well as a purge (3.0.0: a - b is a and not b)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:hasConstraintRoot ?r }
        WHERE { $this va:hasOperator ?r .
                FILTER NOT EXISTS { ?r a va:MandatoryOperator }
                FILTER NOT EXISTS { ?r a va:OptionalOperator }
                FILTER NOT EXISTS { ?r a va:ReplacementOperator }
                FILTER NOT EXISTS { ?r a va:RepetitionOperator ; va:appliesTo ?x . FILTER NOT EXISTS { ?r va:repeatsAsGroup true } }
                FILTER NOT EXISTS { { ?r a va:AdditionOperator } UNION { ?r a va:DivisionOperator } UNION { ?r a va:CartesianOperator } ?r va:hasOperand ?y }
}""" ] .

va:ExclusiveMemberRuleShape a sh:NodeShape ; sh:targetClass va:ExclusiveOperator ;
    rdfs:comment "The members of an exclusive choice; a chain a $ b $ c is one choice among its three members."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:exclusiveMember ?m }
        WHERE { { $this va:members/rdf:rest*/rdf:first ?m }
                UNION { $this va:hasLeftOperand|va:hasRightOperand ?m . FILTER NOT EXISTS { ?m a va:ExclusiveOperator ; va:hasLeftOperand ?z } }
                UNION { $this va:hasLeftOperand|va:hasRightOperand ?o . ?o a va:ExclusiveOperator ; va:hasLeftOperand ?z2 ; va:exclusiveMember ?m } }""" ] .

va:IntersectionResultRuleShape a sh:NodeShape ; sh:targetClass va:IntersectionOperator ;
    rdfs:comment "Carried over from v1.x IntersectionRuleShape unchanged (2026-09-22): between a set A and a set B, the members of A that co-occur with a member of B are the intersection's result members. The meaning of '&' in an expression is its generated sets (co-selection: both, or neither; va:JoinRequestRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:hasResultMember ?a }
        WHERE { $this va:hasOperand ?a . ?a a va:SetA . $this va:hasOperand ?b . ?b a va:SetB . ?a va:coOccursWith ?b . }""" ] .

va:WeaklyGroundedRuleShape a sh:NodeShape ; sh:targetClass va:SemanticCharacteristic ;
    rdfs:comment "Carried over from v1.x unchanged (discovery taxonomy, 2026-09-22): a semantic characteristic derived only from syntax, with neither behavioural confirmation nor documented agreement, is weakly grounded."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:isWeaklyGrounded true }
        WHERE { $this va:derivedFromSyntactic ?syn .
                FILTER NOT EXISTS { $this va:confirmedByBehavioral ?b }
                FILTER NOT EXISTS { $this va:agreesWithDocumentation true } }""" ] .

va:AdditionRuleShape a sh:NodeShape ; sh:targetClass va:AdditionOperator ;
    rdfs:comment "v1.x AdditionRuleShape (co-inclusion) carried over: an operand bound from either direction (va:isCoIncludedBy). Inside an expression, a + b generates each pair of its operands' sets (va:JoinRequestRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:hasOperand ?u }
        WHERE { ?u va:isCoIncludedBy $this }""" ] .

# ------------------------------------------------------------ 11: removals
va:PurgeRuleShape a sh:NodeShape ; sh:targetClass va:Component ;
    rdfs:comment "Features removed from every variant of the component (v1.x PurgeRuleShape, DivisionRuleShape and PropagationRuleShape, scoped to the component): the second operand of a subtraction statement, the operand of an inverse statement, an operand a division removes, and a member of set A whose partner exclusions leave it no partner in set B. The sets are the features partner exclusion names (the excluders and the excluded), and any stated with va:SetA / va:SetB on the component's partner-exclusion operators (v1.x PropagationRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?f va:isPurgedIn $this }
        WHERE { { $this va:hasOperator ?op . ?op a va:SubtractionOperator ; va:hasRightOperand ?f . ?f a va:Feature }
                UNION { $this va:hasOperator ?op . ?op a va:InverseOperator ; va:hasOperand ?f . ?f a va:Feature }
                UNION { $this va:hasOperator ?op . ?op a va:DivisionOperator ; va:hasOperand ?f . FILTER NOT EXISTS { ?op va:hasResultMember ?f } }
                UNION { $this va:hasOperator ?op . ?op a va:CartesianOperator ; va:hasOperand ?f . FILTER NOT EXISTS { ?op va:hasLeftOperand ?lx } FILTER NOT EXISTS { ?pr a va:CartesianOperator ; va:hasLeftOperand ?pl }
                        { ?f va:excludesPartner ?y . ?op va:hasOperand ?y } UNION { ?f a va:SetA }
                        FILTER NOT EXISTS { $this va:hasOperator ?op2 . ?op2 a va:CartesianOperator ; va:hasOperand ?b . FILTER NOT EXISTS { ?op2 va:hasLeftOperand ?ly }
                                            FILTER (EXISTS { ?op2 va:hasOperand ?x . ?x va:excludesPartner ?b } || EXISTS { ?b a va:SetB })
                                            FILTER NOT EXISTS { $this va:hasOperator ?op3 . ?op3 a va:CartesianOperator ; va:hasOperand ?f , ?b . ?f va:excludesPartner ?b } } } }""" ] .

# ------------------------------------------------------------ 12-14: the counts each feature may take
va:SlotBoundsRuleShape a sh:NodeShape ; sh:targetClass va:VariationSlot ;
    rdfs:comment "Declared bounds of a slot. Least count: 1 for a mandatory or united feature, a repetition's lower bound, else 0. Greatest count: the smallest repetition upper bound ('*' read as the component's enumeration bound), else 1. A purged feature keeps its declared bounds and is allowed the count 0 only (va:AllowedCountRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:minCount ?lo }
        WHERE { { SELECT $this (MAX(?m) AS ?lo) WHERE {
                    $this va:slotOfComponent ?c ; va:slotFeature ?f .
                    { BIND(0 AS ?m) }
                    UNION { ?c va:hasOperator ?op . ?op a va:MandatoryOperator ; va:appliesTo ?f . BIND(1 AS ?m) }
                    UNION { ?c va:hasOperator ?op . ?op a va:AdditionOperator ; va:hasOperand ?f . BIND(1 AS ?m) }
                    UNION { ?c va:hasOperator ?op . ?op a va:RepetitionOperator ; va:appliesTo ?f ; va:cardinalityMin ?r .
                            BIND(xsd:integer(STR(?r)) AS ?m) } } GROUP BY $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:maxCount ?hi }
        WHERE { { SELECT $this (MIN(?m) AS ?hi) WHERE {
                    $this va:slotOfComponent ?c ; va:slotFeature ?f .
                    OPTIONAL { ?c va:hasOperator ?op . ?op a va:RepetitionOperator ; va:appliesTo ?f ; va:cardinalityMax ?r . }
                    OPTIONAL { ?c va:enumerationBound ?b }
                    BIND(IF(!BOUND(?r), 1, IF(STR(?r) = "*", xsd:integer(STR(?b)), xsd:integer(STR(?r)))) AS ?m) } GROUP BY $this } }""" ] .

va:CountCeilingRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel ;
    rdfs:comment "The count ceiling: the largest count any slot may take or any enumeration bound names, at least 1. Counts run from 0 to it, and the weights of a node's features are its powers plus one (4.0.0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 12.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { va:CountCeiling va:numericValue ?c }
        WHERE { { SELECT (MAX(?m) AS ?c) WHERE { { BIND(1 AS ?m) } UNION { ?s va:maxCount ?m } UNION { ?x va:enumerationBound ?b . BIND(xsd:integer(STR(?b)) AS ?m) }
                    UNION { ?g a va:RepetitionOperator ; va:repeatsAsGroup true ; va:cardinalityMin ?lo ; va:cardinalityMax ?hi . FILTER(STR(?hi) != "*") FILTER(STR(?lo) = STR(?hi) || EXISTS { ?x va:countsRepetitions true }) BIND(xsd:integer(STR(?hi)) AS ?m) } } } }""" ] .

va:CountValueRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel , va:CountValue ;
    rdfs:comment "The natural numbers 0 .. the count ceiling, used as counts."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { <http://example.org/variant-algebra/count#0> a va:CountValue ; va:numericValue 0 }
        WHERE { { $this a va:Component } UNION { $this a va:DefinitionModel } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n a va:CountValue ; va:numericValue ?k1 }
        WHERE { $this a va:CountValue ; va:numericValue ?k . va:CountCeiling va:numericValue ?c . FILTER(?c > ?k)
                BIND(?k + 1 AS ?k1) BIND(IRI(CONCAT("http://example.org/variant-algebra/count#", STR(?k1))) AS ?n) }""" ] .

va:AllowedCountRuleShape a sh:NodeShape ; sh:targetClass va:VariationSlot ;
    sh:rule [ a sh:SPARQLRule ; sh:order 14 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:allowedCount ?v }
        WHERE { $this va:minCount ?lo ; va:maxCount ?hi ; va:slotOfComponent ?c ; va:slotFeature ?f . ?n a va:CountValue ; va:numericValue ?v .
                BIND(EXISTS { ?f va:isPurgedIn ?c } AS ?purged)
                FILTER(IF(?purged, ?v = 0, ?v >= ?lo && ?v <= ?hi)) }""" ] .

va:UpperBoundRuleShape a sh:NodeShape ; sh:targetClass va:VariationSlot , va:Component ;
    rdfs:comment "The combinatorial upper bound of a component: the product over its slots of (greatest declared count + 1), taken slot by slot in index order."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 15 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:partialUpperBound ?p }
        WHERE { $this a va:VariationSlot .
                { $this va:slotIndex 1 ; va:maxCount ?m1 . BIND(?m1 + 1 AS ?p) }
                UNION { $this va:slotOfComponent ?c ; va:slotIndex ?i ; va:maxCount ?m2 . ?prev va:slotOfComponent ?c ; va:slotIndex ?j ; va:partialUpperBound ?q .
                        FILTER(?j = ?i - 1) BIND(?q * (?m2 + 1) AS ?p) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 16 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:combinatorialUpperBound ?u }
        WHERE { $this a va:Component ; va:variationSlotCount ?n .
                OPTIONAL { ?s va:slotOfComponent $this ; va:slotIndex ?n ; va:partialUpperBound ?q }
                BIND(IF(?n = 0, 1, ?q) AS ?u) FILTER(BOUND(?u)) }""" ] .

# ------------------------------------------------------------ 20-22: candidates
va:CandidateDeadEndRuleShape a sh:NodeShape ; sh:targetClass va:CandidateVariant , va:Component ;
    rdfs:comment "Pruning (the PIB kit's technique, 6.0.0): a statement is decided as soon as every feature it names has its count -- at the slot of its last feature (va:rootLastSlot). A candidate at that slot whose counts on the statement's features are none of the statement's valid sets can hold in no completion; it is a dead end and is not extended. The truth rule still judges every complete candidate."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.05 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?r va:rootLastSlot ?last ; va:rootLastSlotIn $this }
        WHERE { $this a va:Component ; va:hasConstraintRoot ?r . ?r va:generable true . FILTER NOT EXISTS { ?r va:nestedNegationIn $this }
                FILTER NOT EXISTS { ?wx va:weightOf ?r ; va:weightFeature ?fx . FILTER NOT EXISTS { ?sx va:slotOfComponent $this ; va:slotFeature ?fx } }
                { SELECT $this ?r (MAX(?i) AS ?last) WHERE { $this va:hasConstraintRoot ?r . ?w va:weightOf ?r ; va:weightFeature ?f . ?sl va:slotOfComponent $this ; va:slotFeature ?f ; va:slotIndex ?i } GROUP BY $this ?r } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:deadEnd true }
        WHERE { { SELECT $this ?r ?comp (SUM(COALESCE(?k, 0) * ?w) AS ?key) WHERE {
                    $this a va:CandidateVariant ; va:candidateOf ?comp ; va:decidedUpTo ?n . FILTER NOT EXISTS { $this va:deadEnd true }
                    ?r va:rootLastSlotIn ?comp ; va:rootLastSlot ?n . ?wn va:weightOf ?r ; va:weightFeature ?f ; va:weightValue ?w .
                    OPTIONAL { $this va:hasAssignment ?a . ?a va:assignedFeature ?f ; va:assignedCount ?k } } GROUP BY $this ?r ?comp }
                FILTER NOT EXISTS { ?s va:setOf ?r ; va:setFor ?comp ; va:setKey ?key ; a va:ValidSet } }""" ] .

va:CandidateGenerationRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:CandidateVariant ;
    rdfs:comment "Candidates branch slot by slot: each extends its parent by one allowed count for the next slot and carries the parent's counts with it (the PIB kit's technique). A candidate with a count for every slot is complete. 6.0.0: candidates are built after the sets (orders 25.1-25.3), so that a branch that already breaks a statement is not extended (va:CandidateDeadEndRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?cand a va:CandidateVariant ; va:candidateOf $this ; va:decidedUpTo 0 }
        WHERE { $this a va:Component ; va:variationSlotCount ?n . BIND(IRI(CONCAT(STR($this), "__cand")) AS ?cand) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?ch a va:CandidateVariant ; va:candidateOf ?comp ; va:decidedUpTo ?n ; va:branchedFrom $this ;
                        va:hasAssignment ?a , ?pa .
                    ?a va:assignedFeature ?f ; va:assignedCount ?v . }
        WHERE { $this a va:CandidateVariant ; va:candidateOf ?comp ; va:decidedUpTo ?k . ?comp va:variationSlotCount ?max . FILTER(?k < ?max)
                FILTER NOT EXISTS { ?x va:branchedFrom $this } FILTER NOT EXISTS { $this va:deadEnd true }
                BIND(?k + 1 AS ?n)
                ?slot va:slotOfComponent ?comp ; va:slotIndex ?n ; va:slotFeature ?f ; va:allowedCount ?v .
                BIND(IRI(CONCAT(STR($this), "_", STR(?v))) AS ?ch)
                BIND(IRI(CONCAT(STR(?slot), "_", STR(?v))) AS ?a)
                OPTIONAL { $this va:hasAssignment ?pa } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.3 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:CompleteCandidate }
        WHERE { $this a va:CandidateVariant ; va:candidateOf ?comp ; va:decidedUpTo ?k . ?comp va:variationSlotCount ?k . FILTER NOT EXISTS { $this va:deadEnd true } }""" ] .

# ------------------------------------------------------------ 13: shorthands
va:ShorthandRuleShape a sh:NodeShape ; sh:targetClass va:ExclusiveOperator , va:OrOperator , va:DependencyOperator , va:NextOperator , va:SequenceOperator ;
    rdfs:comment "3.0.0: the keyword forms and the order edges are shorthands, built here as expression nodes so that they mean what their expansion generates: exclusive (a | b | c) is a $ (b $ c); or (a, b, c) is a | (b | c); 'a requires b' is [(a < b) | b] ('if a then b'); an edge a -> b (or a >-> b) is [(b < a) | a] ('b never without a'). A shorthand statement generates its expansion's sets (va:JoinRequestRuleShape); a conditioned edge applies its condition (va:OrderEdgeRuleShape). The expansion is evaluation only: the model as written is not changed."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n a ?cls ; va:hasLeftOperand ?first ; va:hasRightOperand ?right . ?top va:expandsTo ?n0 }
        WHERE { $this va:members ?list . FILTER NOT EXISTS { $this va:hasLeftOperand ?z }
                { $this a va:ExclusiveOperator . BIND(va:ExclusiveOperator AS ?cls) } UNION { $this a va:OrOperator . BIND(va:OrOperator AS ?cls) }
                ?list rdf:rest* ?cell . ?cell rdf:first ?first ; rdf:rest ?rest . FILTER(?rest != rdf:nil)
                ?rest rdf:first ?rf ; rdf:rest ?rr .
                BIND(IRI(CONCAT(STR($this), "__sh_", ENCODE_FOR_URI(STR(?cell)))) AS ?n)
                BIND(IF(?rr = rdf:nil, ?rf, IRI(CONCAT(STR($this), "__sh_", ENCODE_FOR_URI(STR(?rest))))) AS ?right)
                BIND(IF(?cell = ?list, $this, ?unbound) AS ?top) BIND(IF(?cell = ?list, ?n, ?unbound) AS ?n0) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:DependencyOperator ; va:hasLeftOperand ?a ; va:hasRightOperand ?b .
                    ?o a va:OrOperator ; va:hasLeftOperand ?d ; va:hasRightOperand ?b .
                    ?x a va:ListExpression ; va:isOptionalList true ; va:hasListItem ?o . $this va:expandsTo ?x }
        WHERE { $this a va:DependencyOperator ; va:antecedent ?a ; va:consequent ?b . FILTER NOT EXISTS { $this va:hasLeftOperand ?z }
                BIND(IRI(CONCAT(STR($this), "__sh_dep")) AS ?d) BIND(IRI(CONCAT(STR($this), "__sh_or")) AS ?o)
                BIND(IRI(CONCAT(STR($this), "__sh_opt")) AS ?x) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 13 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:DependencyOperator ; va:hasLeftOperand ?r ; va:hasRightOperand ?l .
                    ?o a va:OrOperator ; va:hasLeftOperand ?d ; va:hasRightOperand ?l .
                    ?x a va:ListExpression ; va:isOptionalList true ; va:hasListItem ?o . $this va:edgeExpandsTo ?x }
        WHERE { { $this a va:NextOperator } UNION { $this a va:SequenceOperator }
                $this va:hasLeftOperand ?l ; va:hasRightOperand ?r .
                BIND(IRI(CONCAT(STR($this), "__sh_dep")) AS ?d) BIND(IRI(CONCAT(STR($this), "__sh_or")) AS ?o)
                BIND(IRI(CONCAT(STR($this), "__sh_opt")) AS ?x) }""" ] .

# ------------------------------------------------------------ 17-19: the names under each node, their weights, what can be generated
va:ExpressionNamesRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel ;
    rdfs:comment "The context that decides an expression node (va:nodeOfComponent: a component, the result component's conditional substitutions included, or a model of definitions), the basic features a node covers (va:nameUnder: a variable counts as the features of its definition; a condition is not part of what it conditions), and the features whose sets a context generates (va:leafIn). 4.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:nodeOfComponent $this }
        WHERE { { $this va:hasOperator ?op } UNION { $this va:derivedBySubstitution ?op } UNION { $this va:definesVariable ?v . ?v va:hasDefinitionRoot ?op }
                ?op (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:members/rdf:rest*/rdf:first|va:expandsTo|va:edgeExpandsTo|va:appliesTo)* ?n .
                FILTER(isIRI(?n)) FILTER NOT EXISTS { ?n a va:Feature } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:nameUnder ?f }
        WHERE { { ?n va:nodeOfComponent $this } UNION { $this va:definesVariable ?n }
                ?n (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:members/rdf:rest*/rdf:first|va:expandsTo|va:edgeExpandsTo|va:appliesTo|va:hasDefinitionRoot)+ ?f .
                ?f a va:Feature . FILTER NOT EXISTS { ?f va:hasDefinitionRoot ?r } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?a va:nameUnder ?f . ?a va:atomsOf ?v }
        WHERE { $this va:definesVariable ?v . ?v va:hasDefinitionRoot ?r .
                ?r (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:appliesTo)* ?f . ?f a va:Feature .
                BIND(IRI(CONCAT(STR(?v), "__atoms")) AS ?a) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?f va:leafIn $this }
        WHERE { { ?s va:slotOfComponent $this ; va:slotFeature ?f }
                UNION { ?n va:nodeOfComponent $this ; va:nameUnder ?f }
                UNION { ?n va:nodeOfComponent $this ; va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:expandsTo|va:edgeExpandsTo ?f . ?f a va:Feature }
                UNION { $this va:definesVariable ?f }
                UNION { $this va:definesVariable ?v . ?v va:nameUnder ?f } }""" ] .

# ------------------------------------------------------------ 17.1-19.5: independent groups (6.0.0, VAF-WI-121)
# The thesis-native decomposition the owner directed in Sprint 3.2 and operator rules 1.x's partition rule, restated for
# generated sets. A variable's definition is read as a product: its '+' chains and lists are flattened into items (an
# optional list's items are optional items; an optional item is a unit). Items that share a name, directly or through
# other items, form one group; groups share no name. A variable with two or more groups is split: each group is a
# factor, generated on its own, and the variable's capacity is the product of its factors' counts -- its own sets are
# generated only when they are needed (by an expression that uses it, or when its variants are listed). A relation is
# checked on a factor's sets, which hold every name it can concern.
va:ProductItemRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "A variable's definition flattened into the items of a product: '+' operands and a list's items, an optional list's items as optional items; an optional item, and anything that is not '+' or a list, is an item (6.0.0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st va:flatOf ?v ; va:flatNode ?r ; va:flatOptional false }
        WHERE { $this va:definesVariable ?v . ?v va:hasDefinitionRoot ?r .
                BIND(IRI(CONCAT(STR(?v), "__flat_", MD5(CONCAT(STR(?r), " false")))) AS ?st) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st2 va:flatOf ?v ; va:flatNode ?c ; va:flatOptional ?o2 . ?st va:flatExpanded true }
        WHERE { $this va:definesVariable ?v . ?st va:flatOf ?v ; va:flatNode ?n ; va:flatOptional false .
                { ?n a va:AdditionOperator ; va:hasLeftOperand ?z . ?n va:hasLeftOperand|va:hasRightOperand ?c . BIND(false AS ?o2) }
                UNION { ?n a va:ListExpression ; va:hasListItem ?c . FILTER NOT EXISTS { ?n va:isOptionalList true } BIND(false AS ?o2) }
                UNION { ?n a va:ListExpression ; va:isOptionalList true ; va:hasListItem ?c . BIND(true AS ?o2) }
                BIND(IRI(CONCAT(STR(?v), "__flat_", MD5(CONCAT(STR(?c), " ", STR(?o2))))) AS ?st2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st va:flatItem true ; va:itemName ?f }
        WHERE { $this va:definesVariable ?v . ?st va:flatOf ?v ; va:flatNode ?n . FILTER NOT EXISTS { ?st va:flatExpanded true }
                OPTIONAL { { ?n a va:Feature . FILTER NOT EXISTS { ?n va:hasDefinitionRoot ?d } BIND(?n AS ?f) } UNION { ?n va:nameUnder ?f } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.25 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s1 va:linkedItem ?s2 }
        WHERE { $this va:definesVariable ?v . ?s1 va:flatOf ?v ; va:itemName ?f . ?s2 va:flatOf ?v ; va:itemName ?f . FILTER(?s1 != ?s2) }""" ] .

va:IndependentGroupRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "Items linked through shared names form one group; a variable with two or more groups is split, and so is one whose single group is a single mandatory item that is itself a split variable. A split variable's factors are its groups, a group that is a single split variable giving that variable's factors instead (6.0.0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.3 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?st va:inGroup ?G . ?G va:groupOf ?v }
        WHERE { { SELECT $this ?v ?st (MIN(STR(?o)) AS ?rep) WHERE { $this va:definesVariable ?v . ?st va:flatOf ?v ; va:flatItem true . ?st va:linkedItem* ?o } GROUP BY $this ?v ?st }
                BIND(IRI(CONCAT(STR(?v), "__group_", MD5(?rep))) AS ?G) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.35 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:groupCount ?n }
        WHERE { { SELECT $this ?v (COUNT(DISTINCT ?G) AS ?n) WHERE { $this va:definesVariable ?v . ?G va:groupOf ?v } GROUP BY $this ?v } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.35 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?G va:groupItemCount ?n }
        WHERE { { SELECT $this ?G (COUNT(DISTINCT ?st) AS ?n) WHERE { $this va:definesVariable ?v . ?G va:groupOf ?v . ?st va:inGroup ?G } GROUP BY $this ?G } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.36 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:productSplit true }
        WHERE { $this va:definesVariable ?v .
                { ?v va:groupCount ?n . FILTER(?n >= 2) }
                UNION { ?v va:groupCount 1 . ?G va:groupOf ?v ; va:groupItemCount 1 . ?st va:inGroup ?G ; va:flatNode ?a ; va:flatOptional false . ?a va:productSplit true } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.4 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:hasFactor ?F }
        WHERE { $this va:definesVariable ?v . ?v va:productSplit true . ?G va:groupOf ?v .
                FILTER NOT EXISTS { ?G va:groupItemCount 1 . ?st va:inGroup ?G ; va:flatNode ?a ; va:flatOptional false . ?a va:productSplit true }
                BIND(?G AS ?F) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.4 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:hasFactor ?F }
        WHERE { $this va:definesVariable ?v . ?v va:productSplit true . ?G va:groupOf ?v ; va:groupItemCount 1 .
                ?st va:inGroup ?G ; va:flatNode ?a ; va:flatOptional false . ?a va:productSplit true ; va:hasFactor ?F }""" ] .

va:FactorViewRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "A factor is generated as the list of its group's items (an optional item wrapped as an optional list of one) (6.0.0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.45 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?G a va:ListExpression ; va:factorView true ; va:hasListItem ?j . ?w a va:ListExpression ; va:factorView true ; va:isOptionalList true ; va:hasListItem ?n }
        WHERE { $this va:definesVariable ?v . ?v va:hasFactor ?G . ?G va:groupOf ?v2 . ?st va:inGroup ?G ; va:flatNode ?n ; va:flatOptional ?o .
                BIND(IF(?o, IRI(CONCAT(STR(?G), "__opt_", MD5(STR(?n)))), ?unbound) AS ?w)
                BIND(COALESCE(?w, ?n) AS ?j) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.46 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?x va:nodeOfComponent $this }
        WHERE { ?x va:factorView true . $this a va:DefinitionModel }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17.46 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?x va:nameUnder ?f }
        WHERE { $this a va:DefinitionModel . ?x va:factorView true ; va:hasListItem ?j .
                { ?j a va:Feature . FILTER NOT EXISTS { ?j va:hasDefinitionRoot ?d } BIND(?j AS ?f) } UNION { ?j va:nameUnder ?f } }""" ] .

va:SetsNeededRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "In a model of definitions a node's sets are generated only where needed: every variable that is not split, every factor, a variable whose variants are asked for (va:listingRequestedFor), and, from a needed node, its operands, items, expansion and definition (6.0.0). In a component every node is needed."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:setsNeededIn $this }
        WHERE { { $this va:definesVariable ?n . FILTER NOT EXISTS { ?n va:productSplit true } }
                UNION { $this va:definesVariable ?v . ?v va:hasFactor ?n }
                UNION { $this va:listingRequestedFor ?n } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?c va:setsNeededIn $this }
        WHERE { ?n va:setsNeededIn $this ; va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot ?c }""" ] .

va:RecursionThroughNegationRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "A variable that reaches itself through the operand of a negation ('!') or the right side of a subtraction has no least set of variants: each step would remove what the last added. It is marked, and the model is reported as not evaluable (7.0.0; the stop condition's safety, va:Decision_RecursionAllowed_2026_09_28)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 17 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:recursesThroughNegation $this }
        WHERE { $this va:definesVariable ?v . ?v va:hasDefinitionRoot ?r .
                ?r (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot)* ?neg .
                { ?neg a va:InverseOperator ; va:hasOperand ?x } UNION { ?neg a va:SubtractionOperator ; va:hasRightOperand ?x }
                ?x (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot)* ?v }""" ] .

va:NameWeightRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:nameUnder , va:leafIn ;
    rdfs:comment "Each feature a node covers gets a weight, (the count ceiling + 1) to the power of its rank among the node's features by IRI, so that a set of counts over those features has one number (its key) and two sets have the same key only when they are the same set. A basic feature on its own has weight 1. 4.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 18 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?w va:weightOf $this ; va:weightFeature ?f ; va:weightRank ?r }
        WHERE { { SELECT $this ?f (COUNT(?g) AS ?r) WHERE { $this va:nameUnder ?f . OPTIONAL { $this va:nameUnder ?g . FILTER(STR(?g) < STR(?f)) } } GROUP BY $this ?f }
                BIND(IRI(CONCAT(STR($this), "__w_", MD5(STR(?f)))) AS ?w) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 18 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?w va:weightOf $this ; va:weightFeature $this ; va:weightRank 0 }
        WHERE { $this va:leafIn ?c . FILTER NOT EXISTS { $this va:hasDefinitionRoot ?r } BIND(IRI(CONCAT(STR($this), "__w_", MD5(STR($this)))) AS ?w) }""" ] .
va:WeightValueRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:weightRank ;
    sh:rule [ a sh:SPARQLRule ; sh:order 18.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:weightValue ?v }
        WHERE { { $this va:weightRank 0 . BIND(1 AS ?v) }
                UNION { $this va:weightOf ?n ; va:weightRank ?r . FILTER(?r > 0)
                        ?p va:weightOf ?n ; va:weightRank ?r0 ; va:weightValue ?pv . FILTER(?r0 = ?r - 1)
                        va:CountCeiling va:numericValue ?c . BIND(?pv * (?c + 1) AS ?v) } }""" ] .

va:GenerableRuleShape a sh:NodeShape ; sh:targetClass va:Feature ; sh:targetSubjectsOf va:nodeOfComponent ;
    rdfs:comment "A node whose sets the rules generate: a basic feature; a variable whose definition is generable; +, |, $, <, &, *, /, -, ! and a list with generable operands; a repeated group; a keyword statement or an edge without a condition, through its expansion. An edge with a condition used as an operand is not generable: a statement over it is reported as not evaluable. 8.0.0: * and / are generable. 4.0.0. 7.0.0: a variable counts as generable where it is used; its own definition decides whether it is (so a recursive definition is not blocked by itself). A repeated group with a variable among its members is not generable: the group rule repeats names, and what a variable repeated k times means is not decided (it was silently read as a name)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:generable true }
        WHERE { { $this a va:Feature . FILTER NOT EXISTS { $this va:hasDefinitionRoot ?r } }
                UNION { $this a va:RepetitionOperator ; va:repeatsAsGroup true .
                        FILTER NOT EXISTS { $this va:appliesTo ?mv . ?mv va:hasDefinitionRoot ?mr } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:generable true }
        WHERE { { $this a ?t ; va:hasLeftOperand ?z . VALUES ?t { va:AdditionOperator va:OrOperator va:ExclusiveOperator va:DependencyOperator va:IntersectionOperator va:SubtractionOperator va:CartesianOperator va:DivisionOperator } }
                UNION { $this a va:InverseOperator } UNION { $this a va:ListExpression } UNION { $this va:expandsTo ?z2 }
                UNION { $this va:edgeExpandsTo ?z3 . FILTER NOT EXISTS { $this va:hasConditionExpression ?k } }
                UNION { $this va:hasDefinitionRoot ?z4 }
                UNION { $this a va:ConditionedExpression ; va:hasOperand ?z5 }
                FILTER(NOT EXISTS { $this a va:ConditionedExpression ; va:hasConditionExpression ?kc . FILTER NOT EXISTS { ?kc va:generable true } })
                { SELECT $this (COUNT(DISTINCT ?ch) AS ?T) WHERE { $this va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot ?ch } GROUP BY $this }
                { SELECT $this (COUNT(DISTINCT ?g) AS ?G) WHERE { $this va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot ?g .
                    { ?g va:generable true } UNION { ?g va:hasDefinitionRoot ?gr } } GROUP BY $this }
                FILTER(?T = ?G) }""" ] .

# ------------------------------------------------------------ 24: the sets each node generates (va:Decision_OneMeaningGenerated_2026_09_28, va:Decision_AdditionIsAdditive_2026_09_28)
# A set is a node with its members (feature, count) and its key. The operators ask for joins (va:SetJoin); one rule
# carries out every join: the members of the two sides together, a feature on both sides once with the larger count.
va:FeatureSetRuleShape a sh:NodeShape ; sh:targetClass va:Feature ;
    rdfs:comment "A basic feature generates one set per count its slot declares, at least 1 (1 where the context has no slot for it, as in a model of definitions). A feature that a statement removes from every variant (va:isPurgedIn) keeps its sets: an expression that mentions it, such as (a / a) when (!a), still reads them (VAF-WI-255)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:setOf $this ; va:setFor ?C ; va:setKey ?k ; va:setMember ?m . ?m va:memberFeature $this ; va:memberTimes ?k }
        WHERE { $this va:leafIn ?C . FILTER NOT EXISTS { $this va:hasDefinitionRoot ?r }
                { ?sl va:slotOfComponent ?C ; va:slotFeature $this ; va:minCount ?lo ; va:maxCount ?hi . ?cv0 a va:CountValue ; va:numericValue ?k . FILTER(?k >= 1 && ?k >= ?lo && ?k <= ?hi) }
                UNION { FILTER NOT EXISTS { ?sl2 va:slotOfComponent ?C ; va:slotFeature $this } BIND(1 AS ?k) }
                BIND(IRI(CONCAT(STR($this), "__set_", MD5(STR(?C)), "_", STR(?k))) AS ?s)
                BIND(IRI(CONCAT(STR($this), "__n", STR(?k))) AS ?m) }""" ] .

va:JoinRequestRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:nodeOfComponent , va:hasDefinitionRoot ;
    rdfs:comment "What each operator generates, as joins of its operands' sets: a + b each pair (one variant of each side, joined: additive); a $ b each side's sets (their union); a | b each side's sets and each pair; a < b each pair whose left set has a name, and the empty left set alone ('{} < b' is {}); a & b each pair and the empty set; a - b the left's sets (va:SubtractionRequirementRuleShape removes those whose part on the right's names is one of the right's); a keyword statement, an edge without a condition and a variable, the sets of their expansion or definition."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C ; va:joinLeft ?sa ; va:joinRight ?sb }
        WHERE { $this va:nodeOfComponent ?C ; va:hasLeftOperand ?l ; va:hasRightOperand ?r .
                VALUES ?t { va:AdditionOperator va:OrOperator va:DependencyOperator va:IntersectionOperator va:CartesianOperator } $this a ?t .
                ?sa va:setOf ?l ; va:setFor ?C ; a va:CanonicalSet . ?sb va:setOf ?r ; va:setFor ?C ; a va:CanonicalSet .
                FILTER(?t != va:DependencyOperator || EXISTS { ?sa va:setMember ?m })
                FILTER(?t != va:CartesianOperator || NOT EXISTS { ?sa va:setMember ?pm1 . ?pm1 va:memberFeature ?px . ?sb va:setMember ?pm2 . ?pm2 va:memberFeature ?py . { ?px va:excludesPartner ?py } UNION { ?py va:excludesPartner ?px } })
                FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " ", STR(?sa), " ", STR(?sb))))) AS ?j) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C ; va:joinLeft ?sa }
        WHERE { $this va:nodeOfComponent ?C .
                { $this a va:ExclusiveOperator ; va:hasLeftOperand|va:hasRightOperand ?x }
                UNION { $this a va:OrOperator ; va:hasLeftOperand|va:hasRightOperand ?x }
                UNION { $this a va:SubtractionOperator ; va:hasLeftOperand ?x }
                UNION { $this a va:ConditionedExpression ; va:hasOperand ?x }
                UNION { $this a va:DivisionOperator ; va:hasLeftOperand ?x }
                UNION { $this a va:DependencyOperator ; va:hasLeftOperand ?x . BIND(true AS ?emptyOnly) }
                UNION { $this va:expandsTo ?x }
                UNION { $this va:edgeExpandsTo ?x . FILTER NOT EXISTS { $this va:hasConditionExpression ?k } }
                ?sa va:setOf ?x ; va:setFor ?C ; a va:CanonicalSet .
                FILTER(!BOUND(?emptyOnly) || NOT EXISTS { ?sa va:setMember ?m })
                FILTER NOT EXISTS { $this a va:SubtractionOperator ; va:hasRightOperand ?R . ?sa va:setMember ?sm . ?sm va:memberFeature ?sdf . FILTER(?R = ?sdf || EXISTS { ?R va:nameUnder ?sdf }) } FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " ", STR(?sa))))) AS ?j) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C ; va:joinLeft ?sa }
        WHERE { $this va:leafIn ?C . FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                $this va:hasDefinitionRoot ?x .
                ?sa va:setOf ?x ; va:setFor ?C ; a va:CanonicalSet .
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " ", STR(?sa))))) AS ?j) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C }
        WHERE { $this a va:IntersectionOperator ; va:nodeOfComponent ?C ; va:hasLeftOperand ?l . FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " empty")))) AS ?j) }""" ] .

va:ListFoldRuleShape a sh:NodeShape ; sh:targetClass va:ListExpression ;
    rdfs:comment "(e1, e2, ...) joins one set of each item (every item holds); [e1, e2, ...] joins, for each item, one of its sets or nothing (each item holds or has all its names absent). The items are taken in IRI order, one stage per item; the last stage's sets are the list's."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 23 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:itemCount ?T . ?it va:itemRankIn ?rk . ?rk va:rankList $this ; va:rankValue ?r ; va:rankItem ?it }
        WHERE { { SELECT $this (COUNT(DISTINCT ?o) AS ?T) WHERE { $this va:hasListItem ?o } GROUP BY $this }
                { SELECT $this ?it (COUNT(DISTINCT ?o2) AS ?r) WHERE { $this va:hasListItem ?it . OPTIONAL { $this va:hasListItem ?o2 . FILTER(STR(?o2) < STR(?it)) } } GROUP BY $this ?it }
                BIND(IRI(CONCAT(STR($this), "__rank_", MD5(STR(?it)))) AS ?rk) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C ; va:joinLeft ?p ; va:joinRight ?sb ; va:joinStage ?r ; va:joinFinal ?fin }
        WHERE { $this va:nodeOfComponent ?C ; va:itemCount ?T . ?rk va:rankList $this ; va:rankValue ?r ; va:rankItem ?it . FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                { ?sb va:setOf ?it ; va:setFor ?C ; a va:CanonicalSet } UNION { $this va:isOptionalList true . BIND(va:NoSet AS ?sb) }
                OPTIONAL { ?p va:partialOf $this ; va:setFor ?C ; va:foldStage ?q ; a va:CanonicalSet . FILTER(?q = ?r - 1) }
                FILTER(?r = 0 || BOUND(?p))
                BIND(IF(?r = ?T - 1, true, ?unbound) AS ?fin)
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " ", COALESCE(STR(?p), "-"), " ", STR(?sb), " ", STR(?r))))) AS ?j) }""" ] .

va:GroupSetRuleShape a sh:NodeShape ; sh:targetClass va:RepetitionOperator ;
    rdfs:comment "{a, b}[m..n] generates, for each count k from m to n (at most the count ceiling), the set with every member k times; k = 0 is the empty set."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:setOf $this ; va:setFor ?C ; va:setKey ?key ; va:setMember ?mm . ?mm va:memberFeature ?f ; va:memberTimes ?k }
        WHERE { $this va:repeatsAsGroup true ; va:nodeOfComponent ?C ; va:cardinalityMin ?lo ; va:cardinalityMax ?hi . FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                va:CountCeiling va:numericValue ?ceil . ?cv a va:CountValue ; va:numericValue ?k .
                FILTER(?k >= xsd:integer(STR(?lo)) && ?k <= IF(STR(?hi) = "*", ?ceil, IF(xsd:integer(STR(?hi)) < ?ceil, xsd:integer(STR(?hi)), ?ceil)))
                { SELECT $this (SUM(?w) AS ?W) WHERE { ?wn va:weightOf $this ; va:weightValue ?w } GROUP BY $this }
                BIND(?k * ?W AS ?key)
                BIND(IRI(CONCAT(STR($this), "__g_", MD5(STR(?C)), "_", STR(?k))) AS ?s)
                OPTIONAL { $this va:appliesTo ?f . FILTER(?k > 0) }
                BIND(IRI(CONCAT(STR(?f), "__n", STR(?k))) AS ?mm) }""" ] .

va:InverseSetRuleShape a sh:NodeShape ; sh:targetClass va:InverseOperator ;
    rdfs:comment "!e generates every assignment of counts (0 up to the count ceiling) to e's features that is not one of e's sets: the assignments are built one feature at a time (in weight order), and each final one carries the requirement that it is not e's (va:ValidSetRuleShape)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?u va:setOf ?un ; va:setFor ?C ; va:setMember ?mm . ?mm va:memberFeature ?f ; va:memberTimes ?k . ?un va:universeOf $this ; va:universeRank ?r }
        WHERE { $this va:nodeOfComponent ?C . ?wn va:weightOf $this ; va:weightFeature ?f ; va:weightRank ?r . FILTER (NOT EXISTS { ?C a va:DefinitionModel } || EXISTS { $this va:setsNeededIn ?C })
                ?cv a va:CountValue ; va:numericValue ?k .
                BIND(IRI(CONCAT(STR($this), "__u_", MD5(STR(?f)))) AS ?un)
                BIND(IRI(CONCAT(STR($this), "__u_", MD5(STR(?f)), "_", MD5(STR(?C)), "_", STR(?k))) AS ?u)
                BIND(IF(?k > 0, IRI(CONCAT(STR(?f), "__n", STR(?k))), ?unbound) AS ?mm) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?j a va:SetJoin ; va:joinFor $this ; va:joinIn ?C ; va:joinLeft ?p ; va:joinRight ?u ; va:joinStage ?r ; va:joinFinal ?fin }
        WHERE { $this va:nodeOfComponent ?C ; va:hasOperand ?e .
                { SELECT $this (COUNT(?w0) AS ?T) WHERE { ?w0 va:weightOf $this } GROUP BY $this }
                ?un va:universeOf $this ; va:universeRank ?r . ?u va:setOf ?un ; va:setFor ?C .
                OPTIONAL { ?p va:partialOf $this ; va:setFor ?C ; va:foldStage ?q ; a va:CanonicalSet . FILTER(?q = ?r - 1) }
                FILTER(?r = 0 || BOUND(?p))
                BIND(IF(?r = ?T - 1, true, ?unbound) AS ?fin)
                BIND(IRI(CONCAT("urn:vaf:join:", MD5(CONCAT(STR($this), " ", STR(?C), " ", COALESCE(STR(?p), "-"), " ", STR(?u), " ", STR(?r))))) AS ?j) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k ; va:requirementIn ?C }
        WHERE { ?s va:setOf $this ; va:setFor ?C ; va:setKey ?k . $this va:hasOperand ?e .
                BIND(IRI(CONCAT("urn:vaf:req:", MD5(CONCAT(STR(?e), " ", STR(?C), " ", STR(?k))))) AS ?q) }""" ] .

va:ConditionedExpressionRuleShape a sh:NodeShape ; sh:targetClass va:ConditionedExpression ;
    rdfs:comment "9.0.0 (VAF-WI-237): (e when c) is each of e's sets, with the requirement that its part on c's features is one of c's sets -- the converse of a subtraction, which requires that it is not (owner, 2026-10-15). A condition is read on the names of the expression it follows; one that carries a negation of its own is not decided (a requirement on a node whose sets carry requirements), the nodes above it are reported as not evaluable."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:requiresMember ?q . ?q va:requirementOn ?b ; va:requirementKey ?k ; va:requirementIn ?C }
        WHERE { $this va:hasConditionExpression ?b . ?s va:setOf $this ; va:setFor ?C .
                { SELECT ?s ?b (SUM(?c * ?w) AS ?k) WHERE {
                    { SELECT ?s ?b ?f (MAX(COALESCE(?c0, 0)) AS ?c) WHERE {
                        ?s va:setOf ?P . ?P a va:ConditionedExpression ; va:hasConditionExpression ?b . ?wn va:weightOf ?b ; va:weightFeature ?f .
                        OPTIONAL { ?s va:setMember ?m . ?m va:memberFeature ?f ; va:memberTimes ?c0 } } GROUP BY ?s ?b ?f }
                    ?wn2 va:weightOf ?b ; va:weightFeature ?f ; va:weightValue ?w } GROUP BY ?s ?b }
                BIND(IRI(CONCAT("urn:vaf:reqm:", MD5(CONCAT(STR(?b), " ", STR(?C), " ", STR(?k))))) AS ?q) }""" ] .

va:SetJoinRuleShape a sh:NodeShape ; sh:targetClass va:SetJoin ;
    rdfs:comment "The one join (7.0.0: its result is raw; one representative per key stands for all equal results, va:SetRepresentativeRuleShape): the set whose members are the members of both sides (va:Decision_AdditionIsAdditive_2026_09_28: a name on both sides is one feature; with two counts, the larger counts -- va:SetKeyRuleShape); a fold stage's set is partial until the last stage. A set carries the requirements of the sets it was joined from. Each join is carried out once."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s ?rel ?P ; va:setFor ?C ; va:joinResultOf $this ; va:joinedFrom ?sa , ?sb ; va:foldStage ?i ; va:setMember ?m }
        WHERE { $this va:joinFor ?P ; va:joinIn ?C . FILTER NOT EXISTS { ?done va:joinResultOf $this }
                OPTIONAL { $this va:joinLeft ?sa } OPTIONAL { $this va:joinRight ?sb } OPTIONAL { $this va:joinStage ?i }
                BIND(IF(EXISTS { $this va:joinStage ?x } && NOT EXISTS { $this va:joinFinal true }, va:rawPartialOf, va:rawSetOf) AS ?rel)
                BIND(IRI(CONCAT("urn:vaf:set:", MD5(STR($this)))) AS ?s)
                { $this va:joinFor ?P0 ; va:joinLeft ?a1 . ?a1 va:setMember ?m
                  FILTER NOT EXISTS { ?P0 a va:DivisionOperator ; va:hasRightOperand ?R . ?m va:memberFeature ?df . FILTER(?R = ?df || EXISTS { ?R va:nameUnder ?df }) } }
                UNION { $this va:joinRight ?b2 . ?b2 va:setMember ?m } UNION { BIND(true AS ?header) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:requires ?q }
        WHERE { ?s va:joinedFrom ?t . ?t va:requires ?q . FILTER(?s != ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:requiresMember ?q }
        WHERE { ?s va:joinedFrom ?t . ?t va:requiresMember ?q . FILTER(?s != ?t) }""" ] .

va:CanonicalSetRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:setKey ;
    rdfs:comment "The sets a node's parents join: every set with a key -- a feature's or a repeated group's own sets, and the representatives of join results (7.0.0: one per key, so choosing among equal sets is no longer needed; it was not monotone, which recursion cannot allow)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:CanonicalSet }
        WHERE { $this va:setKey ?k ; va:setFor ?C . { $this va:setOf ?n } UNION { $this va:partialOf ?n } }""" ] .
va:UnderNegationRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:nodeOfComponent , va:hasDefinitionRoot ;
    rdfs:comment "A node with a negation below it (through variables' definitions too, 7.0.0): its sets carry requirements, so equal sets are kept apart."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 19 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:underNegation true }
        WHERE { $this (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot)* ?x .
                { ?x a va:InverseOperator } UNION { ?x a va:SubtractionOperator } UNION { ?x a va:ConditionedExpression } }""" ] .

va:SetKeyRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:joinResultOf ;
    rdfs:comment "A joined set's key: the sum, over the node's features, of the set's count of the feature times the feature's weight. Two sets of one node have the same key only when they are the same set."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:rawKey ?key }
        WHERE { { SELECT ?s (SUM(?c * ?w) AS ?key) WHERE {
                    { SELECT ?s ?f (MAX(COALESCE(?c0, 0)) AS ?c) WHERE {
                        ?s va:joinResultOf ?j . FILTER NOT EXISTS { ?s va:rawKey ?k0 }
                        { ?s va:rawSetOf ?P } UNION { ?s va:rawPartialOf ?P }
                        ?wn va:weightOf ?P ; va:weightFeature ?f .
                        OPTIONAL { ?s va:setMember ?m . ?m va:memberFeature ?f ; va:memberTimes ?c0 } } GROUP BY ?s ?f }
                    { ?s va:rawSetOf ?P2 } UNION { ?s va:rawPartialOf ?P2 } ?wn2 va:weightOf ?P2 ; va:weightFeature ?f ; va:weightValue ?w } GROUP BY ?s } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:rawKey 0 }
        WHERE { ?s va:joinResultOf ?j . { ?s va:rawSetOf ?P } UNION { ?s va:rawPartialOf ?P }
                FILTER NOT EXISTS { ?wn va:weightOf ?P } FILTER NOT EXISTS { ?s va:rawKey ?k0 } }""" ] .

va:SetRepresentativeRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:rawKey ;
    rdfs:comment "One set per node, fold stage and key (7.0.0): every raw join result is stood for by the representative of its key, which carries its members; parents join representatives only. So a set reached twice -- by two joins, or again around a recursive definition -- is the same set, the sets are finitely many, and generation stops when a step adds none (va:Decision_RecursionAllowed_2026_09_28). Under a negation each raw set is its own representative, since its requirements tell equal sets apart."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 24 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?R ?rel ?n ; va:setFor ?C ; va:setKey ?k ; va:foldStage ?st ; va:setMember ?m . $this va:representedBy ?R }
        WHERE { $this va:rawKey ?k ; va:setFor ?C .
                { $this va:rawSetOf ?n . BIND(va:setOf AS ?rel) } UNION { $this va:rawPartialOf ?n ; va:foldStage ?st . BIND(va:partialOf AS ?rel) }
                BIND(IF(EXISTS { ?n va:underNegation true }, $this,
                        IRI(CONCAT("urn:vaf:rep:", MD5(CONCAT(STR(?n), " ", STR(?C), " ", COALESCE(STR(?st), "final"), " ", STR(?k)))))) AS ?R)
                OPTIONAL { $this va:setMember ?m } }""" ] .

# ------------------------------------------------------------ 25-26: the valid sets, and truth in a candidate
va:NegationLevelRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:nodeOfComponent , va:hasDefinitionRoot ;
    rdfs:comment "How deeply the requirements of a node's sets are nested (VAF-WI-255, retiring the operator laws module): a negation or a condition is at level 1 above plain names, and one level above the deepest requirement it reads -- so !(!a) is at level 2, and !(a when !b) at level 3. A node has the deepest level of anything below it. A set is judged valid in the order of its node's level (25.001 for level 1, and so on), so a requirement always reads sets whose validity is already decided."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:negLevelAtLeast 1 }
        WHERE { { $this a va:InverseOperator } UNION { $this a va:ConditionedExpression } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:negLevelAtLeast ?k }
        WHERE { $this va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:expandsTo|va:edgeExpandsTo|va:hasDefinitionRoot|va:hasConditionExpression ?c . ?c va:negLevelAtLeast ?k }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:negLevelAtLeast ?k1 }
        WHERE { { $this a va:InverseOperator ; va:hasOperand ?e } UNION { $this a va:ConditionedExpression ; va:hasOperand|va:hasConditionExpression ?e }
                ?e va:negLevelAtLeast ?k . FILTER(?k <= 6) BIND(?k + 1 AS ?k1) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 20.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:negLevel ?m }
        WHERE { { SELECT $this (MAX(?k) AS ?m) WHERE { $this va:negLevelAtLeast ?k } GROUP BY $this } }""" ] .

va:ValidSetRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:setOf ;
    rdfs:comment "A set is valid unless one of its requirements fails: a negation's set fails when the node it negates has a VALID set of the same key; a condition's set fails unless the condition has a valid set of the part. Sets of a node with no negation or condition below it are valid at once; the others are judged level by level (va:NegationLevelRuleShape), so a negation inside a negation, a condition inside a negation and the like are decided (VAF-WI-255). Nesting deeper than six levels is not decided: the nodes above it are reported as not evaluable, never guessed."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . FILTER NOT EXISTS { ?n va:negLevel ?any } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.001 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 1 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.002 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 2 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.003 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 3 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.004 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 4 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.005 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 5 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.006 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:ValidSet }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel 6 .
                FILTER NOT EXISTS { $this va:requires ?q . ?q va:requirementOn ?e ; va:requirementKey ?k . ?t va:setOf ?e ; va:setFor ?C ; va:setKey ?k ; a va:ValidSet }
                FILTER NOT EXISTS { $this va:requiresMember ?qm . ?qm va:requirementOn ?em ; va:requirementKey ?km . FILTER NOT EXISTS { ?tm va:setOf ?em ; va:setFor ?C ; va:setKey ?km ; a va:ValidSet } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:nestedNegationIn ?C }
        WHERE { $this va:setOf ?n ; va:setFor ?C . ?n va:negLevel ?l . FILTER(?l > 6) }""" ] .

va:NeedsTruthRuleShape a sh:NodeShape ; sh:targetClass va:Component ;
    rdfs:comment "7.1.0 (VAF-WI-135): which nodes need a truth verdict. A statement the pruning decided (va:rootLastSlot) holds in every complete candidate by construction (va:PrunedRootTruthRuleShape), so only the nodes something reads are judged: a root the pruning did not decide, the operands an order edge, a repetition and a substitution condition read. A model with a replacement operator is judged as before (every node)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.9 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?r va:needsTruth true }
        WHERE { $this va:hasConstraintRoot ?r . FILTER NOT EXISTS { ?r va:rootLastSlotIn $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.9 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:needsTruth true }
        WHERE { { ?p va:hasConditionExpression ?n } UNION { ?p va:edgeExpandsTo ?n . ?p va:hasConditionExpression ?k }
                UNION { ?p va:hasMaxRepetitions ?mx . { ?p va:members/rdf:rest*/rdf:first ?n } UNION { ?n va:contributesTo ?p } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.9 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n va:needsTruth true }
        WHERE { FILTER EXISTS { ?rep a va:ReplacementOperator } { ?n va:nodeOfComponent $this } UNION { ?n va:leafIn $this } }""" ] .

va:PrunedRootTruthRuleShape a sh:NodeShape ; sh:targetClass va:CompleteCandidate ;
    rdfs:comment "7.1.0: a statement decided by pruning holds in every complete candidate (a candidate that broke it was a dead end and was never completed), so its truth is asserted without the key sum the truth rule computes. Not used when a replacement operator is present."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?r va:holdsIn $this }
        WHERE { $this a va:CompleteCandidate . { $this va:candidateOf ?C } UNION { $this va:renamedFrom ?o . ?o va:candidateOf ?C }
                ?r va:rootLastSlotIn ?C . FILTER NOT EXISTS { ?rep a va:ReplacementOperator } }""" ] .

va:MembershipRuleShape a sh:NodeShape ; sh:targetClass va:CompleteCandidate ;
    rdfs:comment "One truth rule for every expression node something reads (4.0.0; 7.1.0 limits it to va:needsTruth nodes): a generable node holds in a complete candidate when the candidate's counts on the node's features are one of its valid sets (the candidate's key is a valid set's key), and fails otherwise. A renamed candidate is read in the context of the candidate it copies."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?n ?verdict $this }
        WHERE { { SELECT ?n $this ?C (SUM(COALESCE(?k, 0) * ?w) AS ?key) WHERE {
                    $this a va:CompleteCandidate . { $this va:candidateOf ?C } UNION { $this va:renamedFrom ?o . ?o va:candidateOf ?C }
                    { ?n va:nodeOfComponent ?C } UNION { ?n va:leafIn ?C }
                    ?n va:generable true ; va:needsTruth true .
                    ?wn va:weightOf ?n ; va:weightFeature ?f ; va:weightValue ?w .
                    OPTIONAL { $this va:hasAssignment ?a . ?a va:assignedFeature ?f ; va:assignedCount ?k } } GROUP BY ?n $this ?C }
                FILTER NOT EXISTS { ?n va:nestedNegationIn ?C }
                BIND(IF(EXISTS { ?s va:setOf ?n ; va:setFor ?C ; va:setKey ?key ; a va:ValidSet }, va:holdsIn, va:failsIn) AS ?verdict) }""" ] .

# ------------------------------------------------------------ 25.5-26.4: exclusion and dependency hold for the whole variant (5.0.0, VAF-WI-119)
va:AssertedNodeRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel ;
    rdfs:comment "The nodes a statement or a variable's definition asserts (va:assertedUnder its constraint root or its variable): the root and, from an asserted node, its operands, list items, expansion and a variable's definition -- not the operand of a negation, not the right side of a subtraction, not the expansion of a conditioned edge, not a condition. 5.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?r va:assertedUnder ?r }
        WHERE { { $this va:hasConstraintRoot ?r } UNION { $this va:definesVariable ?r } UNION { $this va:definesVariable ?v . ?v va:hasFactor ?r } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.5 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?c va:assertedUnder ?root }
        WHERE { { $this va:hasConstraintRoot ?root } UNION { $this va:definesVariable ?root } UNION { $this va:definesVariable ?v . ?v va:hasFactor ?root }
                ?p va:assertedUnder ?root .
                { ?p va:hasLeftOperand|va:hasListItem|va:expandsTo|va:hasDefinitionRoot ?c FILTER NOT EXISTS { ?p a va:DivisionOperator } }
                UNION { ?p a va:ConditionedExpression ; va:hasOperand ?c }
                UNION { ?p va:hasRightOperand ?c . FILTER NOT EXISTS { ?p a va:SubtractionOperator } FILTER NOT EXISTS { ?p a va:DivisionOperator } }
                UNION { ?p va:edgeExpandsTo ?c . FILTER NOT EXISTS { ?p va:hasConditionExpression ?k } }
                FILTER(NOT EXISTS { ?c a va:Feature } || EXISTS { ?c va:hasDefinitionRoot ?d }) }""" ] .

va:WholeVariantScopeRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel ;
    rdfs:comment "Each relation (a generable X $ Y or X < Y) asserted for a whole variant (va:relationFor): every complete candidate of the component whose statement asserts it; every valid set of the variable whose definition asserts it. 5.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.7 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?R va:relationFor ?T }
        WHERE { ?R va:assertedUnder ?root ; va:hasLeftOperand ?x ; va:hasRightOperand ?y ; va:generable true .
                { ?R a va:ExclusiveOperator } UNION { ?R a va:DependencyOperator }
                { $this va:hasConstraintRoot ?root . ?T a va:CompleteCandidate ; va:candidateOf $this }
                UNION { { $this va:definesVariable ?root } UNION { $this va:definesVariable ?v . ?v va:hasFactor ?root }
                        ?T va:setOf ?root ; va:setFor $this ; a va:ValidSet } }""" ] .

va:ContainedSetRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:relationFor ;
    rdfs:comment "A set of a relation's operand is contained in a whole variant when every feature it counts is present there (counted at least once). The empty set is contained in every variant. 5.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26.1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?x va:containedIn ?T }
        WHERE { $this va:relationFor ?T ; va:hasLeftOperand|va:hasRightOperand ?o .
                { ?T va:candidateOf ?C } UNION { ?T va:setFor ?C }
                ?x va:setOf ?o ; va:setFor ?C ; a va:ValidSet .
                FILTER NOT EXISTS { ?x va:setMember ?m . ?m va:memberFeature ?f ; va:memberTimes ?k . FILTER(?k > 0)
                                    FILTER NOT EXISTS { { ?T va:hasAssignment ?a . ?a va:assignedFeature ?f ; va:assignedCount ?n }
                                                        UNION { ?T va:setMember ?m2 . ?m2 va:memberFeature ?f ; va:memberTimes ?n } FILTER(?n > 0) } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?cn va:contributionOf $this ; va:contributionIn ?T ; va:contributionSide ?side ; va:contributesFeature ?f }
        WHERE { $this va:relationFor ?T .
                { $this va:hasLeftOperand ?o . BIND("left" AS ?side) } UNION { $this va:hasRightOperand ?o . BIND("right" AS ?side) }
                ?x va:setOf ?o ; va:containedIn ?T ; va:setMember ?m . ?m va:memberFeature ?f ; va:memberTimes ?k . FILTER(?k > 0)
                BIND(IRI(CONCAT("urn:vaf:contribution:", MD5(CONCAT(STR($this), " ", STR(?T), " ", ?side)))) AS ?cn) }""" ] .

va:WholeVariantRelationRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:relationFor ;
    rdfs:comment "X $ Y fails in a whole variant when both sides contribute and neither contribution contains the other (a name part of both sides is not excluded on its own); X < Y fails when X contributes and no set of Y is contained. 5.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26.3 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?T va:violatesRelation $this }
        WHERE { $this a va:ExclusiveOperator ; va:relationFor ?T .
                ?l va:contributionOf $this ; va:contributionIn ?T ; va:contributionSide "left" .
                ?r va:contributionOf $this ; va:contributionIn ?T ; va:contributionSide "right" .
                FILTER EXISTS { ?l va:contributesFeature ?f . FILTER NOT EXISTS { ?r va:contributesFeature ?f } }
                FILTER EXISTS { ?r va:contributesFeature ?g . FILTER NOT EXISTS { ?l va:contributesFeature ?g } } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26.3 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?T va:violatesRelation $this }
        WHERE { $this a va:DependencyOperator ; va:relationFor ?T ; va:hasRightOperand ?y .
                ?l va:contributionOf $this ; va:contributionIn ?T ; va:contributionSide "left" .
                FILTER NOT EXISTS { ?s va:setOf ?y ; va:containedIn ?T } }""" ] .

va:ConsistentSetRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "A variable's consistent sets: its valid sets that break no relation its definition asserts. They are its variants. 5.0.0."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 26.4 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s a va:ConsistentSet }
        WHERE { { $this va:definesVariable ?v } UNION { $this va:definesVariable ?v0 . ?v0 va:hasFactor ?v }
                ?s va:setOf ?v ; va:setFor $this ; a va:ValidSet .
                FILTER NOT EXISTS { ?s va:violatesRelation ?R } }""" ] .

# ------------------------------------------------------------ 27-28: a model of definitions: capacity and local variants
va:DefinitionCountRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ;
    rdfs:comment "A variable's local variants (the thesis's Tables 3.1-3.6): its consistent sets (5.0.0) seen through the names its own definition writes -- a basic feature present when counted, a variable present when one of its features is -- each distinct view once."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 27 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?s va:projectsTo ?lv . ?lv va:localVariantOf ?v ; va:localKey ?key }
        WHERE { { SELECT ?v ?s (SUM(?p * ?w) AS ?key) WHERE {
                    $this va:definesVariable ?v . ?s va:setOf ?v ; va:setFor $this ; a va:ConsistentSet .
                    ?at va:atomsOf ?v . ?wn va:weightOf ?at ; va:weightFeature ?a ; va:weightValue ?w .
                    BIND(IF(EXISTS { ?s va:setMember ?m . ?m va:memberFeature ?a } || EXISTS { ?a va:nameUnder ?g . ?s va:setMember ?m2 . ?m2 va:memberFeature ?g }, 1, 0) AS ?p) }
                  GROUP BY ?v ?s }
                BIND(IRI(CONCAT(STR(?v), "__local_", STR(?key))) AS ?lv) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 28 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?lv va:hasMember ?a }
        WHERE { $this va:definesVariable ?v . ?s va:projectsTo ?lv . ?lv va:localVariantOf ?v . ?at va:atomsOf ?v ; va:nameUnder ?a .
                FILTER (EXISTS { ?s va:setMember ?m . ?m va:memberFeature ?a } || EXISTS { ?a va:nameUnder ?g . ?s va:setMember ?m2 . ?m2 va:memberFeature ?g }) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 28 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:localVariantCount ?n }
        WHERE { { SELECT ?v (COUNT(DISTINCT ?lv) AS ?n) WHERE { $this va:definesVariable ?v .
                    FILTER (NOT EXISTS { ?v va:productSplit true } || EXISTS { $this va:listingRequestedFor ?v })
                    OPTIONAL { ?lv va:localVariantOf ?v } } GROUP BY ?v } }""" ] .

# ------------------------------------------------------------ 30: statements that are not expressions

va:OrderEdgeRuleShape a sh:NodeShape ; sh:targetClass va:NextOperator , va:SequenceOperator ;
    rdfs:comment "a -> b when c (va:Decision_EdgeConditionSyntax_2026_09_25): the edge's expansion [(b < a) | a] ('b never without a', va:Decision_DescriptorsAndOccurrences_2026_09_25) holds where c holds. An edge without a condition is an expression like any other (va:MembershipRuleShape); the condition is not part of what it conditions, so a conditioned edge is decided here, as a statement."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 30 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this ?verdict ?c }
        WHERE { $this va:edgeExpandsTo ?x ; va:hasConditionExpression ?k .
                { ?x va:holdsIn ?c . BIND(1 AS ?vx) } UNION { ?x va:failsIn ?c . BIND(0 AS ?vx) }
                { ?k va:holdsIn ?c . BIND(1 AS ?vk) } UNION { ?k va:failsIn ?c . BIND(0 AS ?vk) }
                BIND(IF(?vk = 0 || ?vx = 1, va:holdsIn, va:failsIn) AS ?verdict) }""" ] .

va:RepetitionBoundRuleShape a sh:NodeShape ; sh:targetClass va:RepetitionOperator ;
    rdfs:comment "v1.x RepetitionRuleShape: at most k of the members hold ('atmost k of {...}', contributesTo / hasMaxRepetitions)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 30 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this ?verdict ?c }
        WHERE { $this va:hasMaxRepetitions ?max .
                { SELECT $this (COUNT(DISTINCT ?o) AS ?T) WHERE { { $this va:members/rdf:rest*/rdf:first ?o } UNION { ?o va:contributesTo $this } } GROUP BY $this }
                { SELECT $this ?c (COUNT(DISTINCT ?h) AS ?H) (COUNT(DISTINCT ?x) AS ?F) WHERE {
                    { $this va:members/rdf:rest*/rdf:first ?m } UNION { ?m va:contributesTo $this }
                    { ?m va:holdsIn ?c . BIND(?m AS ?h) } UNION { ?m va:failsIn ?c . BIND(?m AS ?x) } } GROUP BY $this ?c }
                FILTER(?H + ?F = ?T)
                BIND(IF(?H <= xsd:integer(STR(?max)), va:holdsIn, va:failsIn) AS ?verdict) }""" ] .

# ------------------------------------------------------------ 40-46: admissibility, conditional substitution, variants and their number
va:AdmissibilityRuleShape a sh:NodeShape ; sh:targetClass va:CompleteCandidate ;
    rdfs:comment "A complete candidate is a variant when every constraint root holds in it and it breaks no relation they assert (5.0.0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 40 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:AdmissibleCandidate }
        WHERE { $this a va:CompleteCandidate ; va:candidateOf ?comp .
                FILTER NOT EXISTS { ?comp va:hasConstraintRoot ?r . FILTER NOT EXISTS { ?r va:holdsIn $this } }
                FILTER NOT EXISTS { $this va:violatesRelation ?R } }""" ] .

va:VariantLevelSubstitutionRuleShape a sh:NodeShape ; sh:targetClass va:CompleteCandidate ;
    rdfs:comment "The variant-level reading, used only by the A4 check to compare with the model-first result: each complete candidate of the model without its substitutions gets a renamed copy (va:renamedFrom), every name renamed by the component's unconditional substitutions as written (in order), counts merged by the larger, a name renamed away counted 0. The copy is complete, so the truth rules decide the conditions on it -- a conditional substitution's condition is read after the unconditional renaming, as in the result component (va:ConditionalSubstitutionRuleShape). The copy of an admissible candidate is the renamed candidate (va:RenamedCandidate)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.4 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:CompleteCandidate ; va:renamedFrom $this ; va:hasAssignment ?an . ?an va:assignedFeature ?t ; va:assignedCount ?v }
        WHERE { $this a va:CompleteCandidate ; va:candidateOf ?comp . ?comp va:substitutionReading va:VariantLevelReading .
                { SELECT $this ?t (MAX(?n) AS ?v) WHERE {
                    $this va:hasAssignment ?a ; va:candidateOf ?comp0 . ?a va:assignedFeature ?f ; va:assignedCount ?n .
                    OPTIONAL { ?m va:mapBlock ?comp0 ; va:mapFrom ?f ; va:mapTo ?z }
                    BIND(COALESCE(?z, ?f) AS ?t) } GROUP BY $this ?t }
                BIND(IRI(CONCAT(STR($this), "__vr")) AS ?d) BIND(IRI(CONCAT(STR(?t), "__count_", STR(?v))) AS ?an) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 25.4 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d va:hasAssignment ?z0 . ?z0 va:assignedFeature ?f ; va:assignedCount 0 }
        WHERE { $this a va:CompleteCandidate ; va:candidateOf ?comp . ?comp va:substitutionReading va:VariantLevelReading .
                ?m va:mapBlock ?comp ; va:mapFrom ?f .
                FILTER NOT EXISTS { ?m2 va:mapBlock ?comp ; va:mapTo ?f }
                BIND(IRI(CONCAT(STR($this), "__vr")) AS ?d) BIND(IRI(CONCAT(STR(?f), "__count_0")) AS ?z0) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 42 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:CandidateVariant , va:RenamedCandidate ; va:candidateOf ?comp }
        WHERE { $this a va:AdmissibleCandidate ; va:candidateOf ?comp . ?d va:renamedFrom $this }""" ] .

va:ConditionalSubstitutionRuleShape a sh:NodeShape ; sh:targetClass va:CandidateVariant ;
    rdfs:comment "'a ~ b when c' (va:Decision_SubstitutionSemantics_2026_09_25, va:Decision_ReplacementReading_2026_09_25): in an admissible candidate of the substitution's result where c holds and a is present, a is taken out and b put in its place (b's count the larger of its own and a's). The substitutions whose conditions hold apply at once, each condition read on the candidate before any of them. In the variant-level reading the same applies to the renamed candidates, the condition read on the renamed candidate, as on a candidate of the result. Scope: the component's names."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 43 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:rewrittenBy ?sub }
        WHERE { { $this a va:AdmissibleCandidate ; va:candidateOf ?comp . ?comp va:derivedBySubstitution ?sub . BIND($this AS ?c) }
                UNION { $this a va:RenamedCandidate ; va:candidateOf ?comp . ?comp va:hasOperator ?sub . ?sub a va:ReplacementOperator . BIND($this AS ?c) }
                ?sub va:hasConditionExpression ?k ; va:hasLeftOperand ?old . ?k va:holdsIn ?c .
                $this va:hasAssignment ?a . ?a va:assignedFeature ?old ; va:assignedCount ?n . FILTER(?n > 0) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 44 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:CandidateVariant , va:SubstitutedCandidate ; va:candidateOf ?comp ; va:substitutedFrom $this ; va:hasAssignment ?a }
        WHERE { $this va:rewrittenBy ?s0 ; va:candidateOf ?comp ; va:hasAssignment ?a . ?a va:assignedFeature ?f .
                FILTER NOT EXISTS { $this va:rewrittenBy ?s . { ?s va:hasLeftOperand ?f } UNION { ?s va:hasRightOperand ?f } }
                BIND(IRI(CONCAT(STR($this), "__sub")) AS ?d) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 44 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:CandidateVariant , va:SubstitutedCandidate ; va:candidateOf ?comp ; va:substitutedFrom $this ; va:hasAssignment ?z .
                    ?z va:assignedFeature ?old ; va:assignedCount 0 }
        WHERE { $this va:rewrittenBy ?sub ; va:candidateOf ?comp . ?sub va:hasLeftOperand ?old .
                FILTER NOT EXISTS { $this va:rewrittenBy ?s2 . ?s2 va:hasRightOperand ?old }
                BIND(IRI(CONCAT(STR($this), "__sub")) AS ?d) BIND(IRI(CONCAT(STR(?old), "__count_0")) AS ?z) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 44 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?d a va:CandidateVariant , va:SubstitutedCandidate ; va:candidateOf ?comp ; va:substitutedFrom $this ; va:hasAssignment ?an .
                    ?an va:assignedFeature ?new ; va:assignedCount ?v }
        WHERE { { SELECT $this ?new (MAX(?x) AS ?v) WHERE {
                    $this va:rewrittenBy ?sub . ?sub va:hasRightOperand ?new .
                    { $this va:rewrittenBy ?sub1 ; va:hasAssignment ?a . ?sub1 va:hasLeftOperand ?old ; va:hasRightOperand ?new . ?a va:assignedFeature ?old ; va:assignedCount ?x }
                    UNION { $this va:hasAssignment ?b . ?b va:assignedFeature ?new ; va:assignedCount ?x } } GROUP BY $this ?new }
                $this va:candidateOf ?comp .
                BIND(IRI(CONCAT(STR($this), "__sub")) AS ?d) BIND(IRI(CONCAT(STR(?new), "__count_", STR(?v))) AS ?an) }""" ] .

va:VariantRuleShape a sh:NodeShape ; sh:targetClass va:CandidateVariant ;
    rdfs:comment "The component's variants (va:Variant): its admissible candidates no conditional substitution rewrote (in the variant-level reading, the renamed ones), and the rewritten ones, each counted once -- a rewritten or renamed candidate equal (same features, same counts) to a variant already listed adds none."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:Variant ; va:variantOf ?comp }
        WHERE { $this a va:AdmissibleCandidate ; va:candidateOf ?comp . FILTER NOT EXISTS { $this va:rewrittenBy ?s }
                FILTER NOT EXISTS { ?comp va:substitutionReading va:VariantLevelReading } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this a va:Variant ; va:variantOf ?comp }
        WHERE { { $this a va:SubstitutedCandidate } UNION { $this a va:RenamedCandidate . FILTER NOT EXISTS { $this va:rewrittenBy ?s0 } }
                $this va:candidateOf ?comp .
                FILTER NOT EXISTS {
                    ?w va:candidateOf ?comp .
                    { ?w a va:AdmissibleCandidate . FILTER NOT EXISTS { ?w va:rewrittenBy ?s3 } FILTER NOT EXISTS { ?comp va:substitutionReading va:VariantLevelReading } }
                    UNION { ?w a va:SubstitutedCandidate . FILTER(STR(?w) < STR($this)) }
                    UNION { ?w a va:RenamedCandidate . FILTER NOT EXISTS { ?w va:rewrittenBy ?s4 } FILTER(STR(?w) < STR($this)) }
                    FILTER NOT EXISTS { $this va:hasAssignment ?x . ?x va:assignedCount ?nx ; va:assignedFeature ?fx . FILTER(?nx > 0)
                                        FILTER NOT EXISTS { ?w va:hasAssignment ?y . ?y va:assignedFeature ?fx ; va:assignedCount ?nx } }
                    FILTER NOT EXISTS { ?w va:hasAssignment ?x2 . ?x2 va:assignedCount ?nx2 ; va:assignedFeature ?fx2 . FILTER(?nx2 > 0)
                                        FILTER NOT EXISTS { $this va:hasAssignment ?y2 . ?y2 va:assignedFeature ?fx2 ; va:assignedCount ?nx2 } } } }""" ] .

va:VariantCountRuleShape a sh:NodeShape ; sh:targetClass va:Component , va:DefinitionModel ;
    rdfs:comment "The number of variants (the variation capacity, the thesis's VP, Figure 3.2): of a component, its variants; of a variable of a model of definitions, its consistent sets, each distinct set once. 4.0.0: both counted here; 5.0.0: consistent sets."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { $this va:admissibleVariantCount ?n }
        WHERE { { SELECT $this (COUNT(?v) AS ?n) WHERE { $this a va:Component . OPTIONAL { ?v va:variantOf $this ; a va:Variant } } GROUP BY $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:variationCapacity ?n }
        WHERE { { SELECT ?v (COUNT(DISTINCT ?k) AS ?n) WHERE { $this va:definesVariable ?v . FILTER NOT EXISTS { ?v va:productSplit true }
                    OPTIONAL { ?s va:setOf ?v ; va:setFor $this ; va:setKey ?k ; a va:ConsistentSet } } GROUP BY ?v } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?F va:factorCount ?n }
        WHERE { { SELECT ?F (COUNT(DISTINCT ?k) AS ?n) WHERE { $this va:definesVariable ?v . ?v va:hasFactor ?F .
                    OPTIONAL { ?s va:setOf ?F ; va:setFor $this ; va:setKey ?k ; a va:ConsistentSet } } GROUP BY ?F } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?p va:partialProductOf ?v ; va:partialRank 0 ; va:partialValue ?c }
        WHERE { $this va:definesVariable ?v . ?rk va:rankedIn ?v ; va:factorRank 0 ; va:rankedFactor ?F . ?F va:factorCount ?c .
                BIND(IRI(CONCAT(STR(?v), "__product_0")) AS ?p) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45.1 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?p va:factorRank ?r . ?p va:rankedFactor ?F ; va:rankedIn ?v }
        WHERE { { SELECT ?v ?F (COUNT(?G) AS ?r) WHERE { $this va:definesVariable ?v . ?v va:hasFactor ?F . OPTIONAL { ?v va:hasFactor ?G . FILTER(STR(?G) < STR(?F)) } } GROUP BY ?v ?F }
                BIND(IRI(CONCAT(STR(?v), "__rank_", MD5(STR(?F)))) AS ?p) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 45.2 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?p2 va:partialProductOf ?v ; va:partialRank ?r ; va:partialValue ?c }
        WHERE { $this va:definesVariable ?v . ?p va:partialProductOf ?v ; va:partialRank ?q ; va:partialValue ?c0 .
                ?rk va:rankedIn ?v ; va:factorRank ?r ; va:rankedFactor ?F . FILTER(?r = ?q + 1) ?F va:factorCount ?n .
                BIND(?c0 * ?n AS ?c) BIND(IRI(CONCAT(STR(?v), "__product_", STR(?r))) AS ?p2) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 46 ; sh:prefixes <http://example.org/vaf-consolidated/operator-rules-v2> ; sh:construct """
        CONSTRUCT { ?v va:variationCapacity ?c }
        WHERE { $this va:definesVariable ?v . ?v va:productSplit true .
                { SELECT ?v (COUNT(?F) AS ?k) WHERE { ?v va:hasFactor ?F } GROUP BY ?v }
                ?p va:partialProductOf ?v ; va:partialRank ?r ; va:partialValue ?c . FILTER(?r = ?k - 1) }""" ] .

# ==== file variant_algebra_pipeline_gates_v1_7_0.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra — Pipeline Gates v1.0.0
#
# The gates between the stages of a recorded Discovery-Synthesis Pipeline run.
# A stage may start only from an accepted result of the stage before it; a run
# must name its profile and keep its stages coherent with each other.
# Each shape is paired with a positive and a negative fixture (L-95):
#   03-fixtures/fixtures/shacl/pipeline_gates_v1_0_0_positive.ttl
#   03-fixtures/fixtures/shacl/pipeline_gates_v1_0_0_negative.ttl
# ============================================================

<http://example.org/variant-algebra/pipeline-gates>
    owl:versionInfo "1.7.0" ;
    owl:versionIRI <http://example.org/variant-algebra/pipeline-gates/1.7.0> ;
    owl:priorVersion <http://example.org/variant-algebra/pipeline-gates/1.6.0> ;
    dcterms:modified "2026-10-19"^^xsd:date ;
    rdfs:comment "1.7.0 (2026-10-19, VAF-WI-249): the Feedback step joins the gates -- it reads this run, states each finding completely (kind, addressee, step, statement), has a verdict that follows its findings, a run recorded as Completed has it and a run recorded as Stopped has one that records the stop. 1.6.0 (2026-10-19, VAF-WI-248): the Execution step joins the gates -- its entry (a verification that verified), one verdict, what a Ran, a Failed and a Not run result must state, and the run outcome (a run recorded as Completed needs an execution that did not fail). 1.5.0 (2026-10-19, VAF-WI-247): the Verification step joins the gates -- its entry (a synthesis that passed or warned), one verdict that follows its checks, each of the six checks exactly once, and the run outcome (a run recorded as Completed that lacks a step's record skipped it). 1.4.0 (2026-10-18, VAF-WI-245): the Undecided processing verdict (no count, says why) and the capacity notice (stated completely; a notice that says the value is beyond what was measured must have a value that is). 1.3.0 (2026-10-18, VAF-WI-242): the Processing step joins the gates -- its entry (an accepted discovery), its one verdict, its findings, and the rule that the verdict follows the count; a run with a conversion stage must have a processing stage. 1.2.0 (2026-10-18, VAF-WI-241): the Agreement step joins the gates -- its entry (an accepted discovery; the documents describe the code that was discovered), its one verdict, its findings, and the rule that the verdict follows the polarity the matching taxonomy gives each recorded state; a run with a conversion stage must have an agreement stage. The matching taxonomy must be given to the validation as an ontology graph. 1.1.0 (2026-09-27, VAF-WI-103): the conversion ambiguity check joins the gates (it was a separate specification file, and it read 'converts from' on the Conversion Result, against the property's declared domain, so it could never fire on a gated run); and a shape refuses a pipeline step that is not fully stated or not in unbroken order."@en ;
    dcterms:title "Variant Algebra — Pipeline Gates"@en .

# ---- Gate 1: Discovery -> Conversion ----
va:DiscoveryToConversionGateShape a sh:NodeShape ;
    rdfs:label "Conversion starts only from an accepted discovery"@en ;
    sh:targetClass va:ConversionRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:convertsFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoveryResult ;
        sh:message "A conversion request must name exactly one Discovery Result it converts from." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Conversion started from a Discovery Result that was not accepted." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:convertsFrom ?dr .
                FILTER NOT EXISTS { ?dr va:hasDiscoveryVerdict va:Verdict_Accept }
            }""" ] .

# ---- Gate 2: Conversion -> Synthesis ----
va:ConversionToSynthesisGateShape a sh:NodeShape ;
    rdfs:label "Synthesis starts only from a variant of an accepted conversion"@en ;
    sh:targetClass va:SynthesisRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:synthesizesVariant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Variant ;
        sh:message "A synthesis request must name exactly one Variant to realise." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Synthesis started from a Variant that no accepted Conversion Result yielded." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:synthesizesVariant ?v .
                FILTER NOT EXISTS { ?cr va:yieldsVariant ?v ; va:hasConversionVerdict va:Verdict_Accept }
            }""" ] .

# ---- Every result carries exactly one verdict of its own kind ----
va:DiscoveryResultVerdictShape a sh:NodeShape ;
    rdfs:label "A discovery result carries one discovery verdict"@en ;
    sh:targetClass va:DiscoveryResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasDiscoveryVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoveryVerdict ;
        sh:message "A Discovery Result must carry exactly one Discovery Verdict." ] .

va:ConversionResultVerdictShape a sh:NodeShape ;
    rdfs:label "A conversion result carries one conversion verdict"@en ;
    sh:targetClass va:ConversionResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasConversionVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ConversionVerdict ;
        sh:message "A Conversion Result must carry exactly one Conversion Verdict." ] .

va:SynthesisResultVerdictShape a sh:NodeShape ;
    rdfs:label "A synthesis result carries one synthesis verdict"@en ;
    sh:targetClass va:SynthesisResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasSynthesisVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:SynthesisVerdict ;
        sh:message "A Synthesis Result must carry exactly one Synthesis Verdict." ] .

# ---- A run is complete and its stages belong together ----
va:PipelineRunShape a sh:NodeShape ;
    rdfs:label "A pipeline run names its profile and keeps its stages coherent"@en ;
    sh:targetClass va:DiscoverySynthesisPipeline ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:runsProfile ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:VAFDomainProfile ;
        sh:message "A pipeline run must name exactly one domain profile." ] ;
    sh:property [ sh:path va:hasDiscoveryStage ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoveryResult ;
        sh:message "A pipeline run must have exactly one discovery stage." ] ;
    sh:property [ sh:path va:hasAgreementStage ; sh:maxCount 1 ; sh:class va:AgreementResult ;
        sh:message "A pipeline run has at most one agreement stage." ] ;
    sh:property [ sh:path va:hasProcessingStage ; sh:maxCount 1 ; sh:class va:ProcessingResult ;
        sh:message "A pipeline run has at most one processing stage." ] ;
    sh:property [ sh:path va:hasConversionStage ; sh:maxCount 1 ; sh:class va:ConversionResult ;
        sh:message "A pipeline run has at most one conversion stage." ] ;
    sh:property [ sh:path va:hasSynthesisStage ; sh:maxCount 1 ; sh:class va:SynthesisResult ;
        sh:message "A pipeline run has at most one synthesis stage." ] ;
    sh:property [ sh:path va:hasVerificationStage ; sh:maxCount 1 ; sh:class va:VerificationResult ;
        sh:message "A pipeline run has at most one verification stage." ] ;
    sh:property [ sh:path va:hasExecutionStage ; sh:maxCount 1 ; sh:class va:ExecutionResult ;
        sh:message "A pipeline run has at most one execution stage." ] ;
    sh:property [ sh:path va:hasFeedbackStage ; sh:maxCount 1 ; sh:class va:FeedbackResult ;
        sh:message "A pipeline run has at most one feedback stage." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's feedback stage did not read this run." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasFeedbackStage ?fr . FILTER NOT EXISTS { ?req va:producesFeedback ?fr ; va:feedbackFrom $this } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run has an execution stage but no verification stage: a stage was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasExecutionStage ?x . FILTER NOT EXISTS { $this va:hasVerificationStage ?v } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's execution stage did not run the artifact of this run's own verification stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasVerificationStage ?vr ; va:hasExecutionStage ?xr .
                FILTER NOT EXISTS { ?req va:producesExecution ?xr ; va:executesFrom ?vr }
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run has a verification stage but no synthesis stage: a stage was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasVerificationStage ?v . FILTER NOT EXISTS { $this va:hasSynthesisStage ?s } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's verification stage did not check this run's own synthesis stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasSynthesisStage ?sr ; va:hasVerificationStage ?vr .
                FILTER NOT EXISTS { ?req va:producesVerification ?vr ; va:verifiesFrom ?sr }
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run has a synthesis stage but no conversion stage: a stage was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasSynthesisStage ?s . FILTER NOT EXISTS { $this va:hasConversionStage ?c } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run has a conversion stage but no agreement stage: a stage was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasConversionStage ?c . FILTER NOT EXISTS { $this va:hasAgreementStage ?a } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run has a conversion stage but no processing stage: a stage was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasConversionStage ?c . FILTER NOT EXISTS { $this va:hasProcessingStage ?a } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's processing stage did not follow this run's own discovery stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasDiscoveryStage ?dr ; va:hasProcessingStage ?pr .
                FILTER NOT EXISTS { ?req va:producesProcessing ?pr ; va:processesFrom ?dr }
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's agreement stage did not follow this run's own discovery stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasDiscoveryStage ?dr ; va:hasAgreementStage ?ar .
                FILTER NOT EXISTS { ?req va:producesAgreement ?ar ; va:agreesFrom ?dr }
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's conversion stage was not converted from this run's own discovery stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasDiscoveryStage ?dr ; va:hasConversionStage ?cr .
                FILTER NOT EXISTS { ?req va:producesConversion ?cr ; va:convertsFrom ?dr }
            }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run's synthesis stage did not realise a variant of this run's own conversion stage." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:hasConversionStage ?cr ; va:hasSynthesisStage ?sr .
                FILTER NOT EXISTS { ?req va:producesSynthesis ?sr ; va:synthesizesVariant ?v . ?cr va:yieldsVariant ?v }
            }""" ] .

# ---- 1.1.0: one of the governing gates; was 11-groomed-specifications/conversion_verdict_shacl_v1_0_0.ttl ----
va:ConversionAmbiguityShape a sh:NodeShape ;
    rdfs:label "A conversion that maps two discovered features to one target slot is not accepted"@en ;
    sh:targetClass va:ConversionResult ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Two discovered features assembled into this Conversion Result claim the same target slot -- an ambiguous mapping. The result must carry Reject or Needs Review, not Accept, until a reviewer resolves which candidate is correct." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                ?req va:producesConversion $this ; va:convertsFrom ?dr .
                ?f1 va:memberOfDiscoveryResult ?dr ; va:targetSlot ?slot .
                ?f2 va:memberOfDiscoveryResult ?dr ; va:targetSlot ?slot .
                FILTER (?f1 != ?f2)
                $this va:hasConversionVerdict va:Verdict_Accept .
            }""" ] .

# ---- 1.1.0: the steps themselves are checked, so the definition cannot drift silently ----
va:PipelineStepDefinitionShape a sh:NodeShape ;
    rdfs:label "Every pipeline step is fully stated (entry, task, verification, exit), enforced, and in unbroken order"@en ;
    sh:targetClass va:PipelineStep ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:stepOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A step must have exactly one position." ] ;
    sh:property [ sh:path va:entryCriterion ; sh:minCount 1 ; sh:message "A step must state its entry criterion." ] ;
    sh:property [ sh:path va:stepTask ; sh:minCount 1 ; sh:message "A step must state its task." ] ;
    sh:property [ sh:path va:stepVerification ; sh:minCount 1 ; sh:message "A step must state how its result is judged." ] ;
    sh:property [ sh:path va:exitCriterion ; sh:minCount 1 ; sh:message "A step must state its exit criterion." ] ;
    sh:property [ sh:path va:enforcedByShape ; sh:minCount 1 ; sh:message "A step must name a shape that enforces it." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This step's next step is not the step one position later: the order is broken." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:nextStep ?n ; va:stepOrder ?o . ?n va:stepOrder ?no . FILTER (?no != ?o + 1) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A later step exists but this step names no next step: the order is broken." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:stepOrder ?o . ?later a va:PipelineStep ; va:stepOrder ?lo . FILTER (?lo > ?o)
                                 FILTER NOT EXISTS { $this va:nextStep ?n } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Two steps share this position." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:stepOrder ?o . ?other a va:PipelineStep ; va:stepOrder ?o . FILTER (?other != $this) }""" ] .

va:OneGoverningPipelineDefinitionShape a sh:NodeShape ;
    rdfs:label "Exactly one pipeline definition governs"@en ;
    sh:targetClass va:PipelineDefinitionRecord ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:definitionStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "governing" "superseded" ) ;
        sh:message "A pipeline definition record is either governing or superseded." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "More than one pipeline definition claims to govern." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:definitionStatus "governing" . ?o va:definitionStatus "governing" . FILTER (?o != $this) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A superseded definition must say why." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:definitionStatus "superseded" . FILTER NOT EXISTS { $this va:supersededBecause ?w } }""" ] .

# ---- 1.2.0: the Agreement step (VAF-WI-241) ----
va:DiscoveryToAgreementGateShape a sh:NodeShape ;
    rdfs:label "Agreement starts only from an accepted discovery, and only for the code that was discovered"@en ;
    sh:targetClass va:AgreementRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:agreesFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoveryResult ;
        sh:message "An agreement request must name exactly one Discovery Result it follows." ] ;
    sh:property [ sh:path va:producesAgreement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:AgreementResult ;
        sh:message "An agreement request must produce exactly one Agreement Result." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Agreement started from a Discovery Result that was not accepted." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:agreesFrom ?dr . FILTER NOT EXISTS { ?dr va:hasDiscoveryVerdict va:Verdict_Accept } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "The documents describe different code than the code that was discovered: none of the sha-256 values the description was made from is the discovered source's." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            PREFIX dcterms: <http://purl.org/dc/terms/>
            SELECT $this WHERE {
                $this va:documentsCodeSha ?any ; va:agreesFrom ?dr .
                ?dreq va:producesDiscovery ?dr ; dcterms:identifier ?id .
                FILTER NOT EXISTS { $this va:documentsCodeSha ?id }
            }""" ] .

va:AgreementResultVerdictShape a sh:NodeShape ;
    rdfs:label "An agreement result carries one agreement verdict"@en ;
    sh:targetClass va:AgreementResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasAgreementVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:AgreementVerdict ;
        sh:message "An Agreement Result must carry exactly one Agreement Verdict." ] .

va:AgreementFindingShape a sh:NodeShape ;
    rdfs:label "A finding is one question in one context with one state; an unmatching one carries its nonconformity record"@en ;
    sh:targetClass va:AgreementFinding ; sh:severity sh:Violation ;
    sh:property [ sh:path va:findingOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:AgreementResult ; sh:message "A finding belongs to exactly one Agreement Result." ] ;
    sh:property [ sh:path va:findingContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A finding names exactly one context." ] ;
    sh:property [ sh:path va:findingQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A finding names exactly one question." ] ;
    sh:property [ sh:path va:findingState ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A finding carries exactly one agreement state." ] ;
    sh:property [ sh:path va:findingReason ; sh:minCount 1 ; sh:message "A finding states the reason the rules gave." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A finding carries a state the matching taxonomy does not classify." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            PREFIX vm: <http://example.org/vaf-consolidated/matching#>
            SELECT $this WHERE { $this va:findingState ?s . FILTER NOT EXISTS { ?e vm:describes ?s ; vm:polarity ?p } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A finding in an unmatching state carries no nonconformity status." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            PREFIX vm: <http://example.org/vaf-consolidated/matching#>
            SELECT $this WHERE { $this va:findingState ?s . ?e vm:describes ?s ; vm:polarity vm:Unmatching .
                                 FILTER NOT EXISTS { $this va:findingNcStatus ?st } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A finding in an unmatching state names neither a candidate cause nor an open question." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            PREFIX vm: <http://example.org/vaf-consolidated/matching#>
            SELECT $this WHERE { $this va:findingState ?s . ?e vm:describes ?s ; vm:polarity vm:Unmatching .
                                 FILTER NOT EXISTS { $this va:findingCandidateCause ?c }
                                 FILTER NOT EXISTS { $this va:findingOpenQuestion ?q } }""" ] .

va:AgreementVerdictFollowsPolarityShape a sh:NodeShape ;
    rdfs:label "The agreement verdict is the one the polarity of the recorded states gives"@en ;
    sh:targetClass va:AgreementResult ; sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "The agreement verdict is not the one the recorded states give: Unmatching if any state unmatches, else Undecided if any is undecided, else Matching if any matches, else Not compared." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            PREFIX vm: <http://example.org/vaf-consolidated/matching#>
            SELECT $this WHERE {
                $this va:hasAgreementVerdict ?v .
                BIND(EXISTS { ?f va:findingOf $this ; va:findingState ?s . ?e vm:describes ?s ; vm:polarity vm:Unmatching } AS ?u)
                BIND(EXISTS { ?f va:findingOf $this ; va:findingState ?s . ?e vm:describes ?s ; vm:polarity vm:Undecided } AS ?d)
                BIND(EXISTS { ?f va:findingOf $this ; va:findingState ?s . ?e vm:describes ?s ; vm:polarity vm:Matching } AS ?m)
                BIND(IF(?u, va:AgreementVerdict_Unmatching, IF(?d, va:AgreementVerdict_Undecided, IF(?m, va:AgreementVerdict_Matching, va:AgreementVerdict_NotCompared))) AS ?expected)
                FILTER (?v != ?expected)
            }""" ] .

# ---- 1.3.0: the Processing step (VAF-WI-242) ----
va:DiscoveryToProcessingGateShape a sh:NodeShape ;
    rdfs:label "Processing starts only from an accepted discovery"@en ;
    sh:targetClass va:ProcessingRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:processesFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoveryResult ;
        sh:message "A processing request must name exactly one Discovery Result it processes." ] ;
    sh:property [ sh:path va:producesProcessing ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ProcessingResult ;
        sh:message "A processing request must produce exactly one Processing Result." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Processing started from a Discovery Result that was not accepted." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:processesFrom ?dr . FILTER NOT EXISTS { ?dr va:hasDiscoveryVerdict va:Verdict_Accept } }""" ] .

va:ProcessingResultVerdictShape a sh:NodeShape ;
    rdfs:label "A processing result carries one processing verdict"@en ;
    sh:targetClass va:ProcessingResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasProcessingVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ProcessingVerdict ;
        sh:message "A Processing Result must carry exactly one Processing Verdict." ] .

va:ProcessingFindingShape a sh:NodeShape ;
    rdfs:label "A processing finding is a group, a dead feature or a false-optional feature, stated completely"@en ;
    sh:targetClass va:ProcessingFinding ; sh:severity sh:Violation ;
    sh:property [ sh:path va:processingFindingOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ProcessingResult ; sh:message "A processing finding belongs to exactly one Processing Result." ] ;
    sh:property [ sh:path va:processingFindingKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Group" "DeadFeature" "FalseOptionalFeature" ) ;
        sh:message "A processing finding is a Group, a DeadFeature or a FalseOptionalFeature." ] ;
    sh:property [ sh:path va:processingFindingFeature ; sh:minCount 1 ; sh:message "A processing finding names the feature or features it is about." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A dead or false-optional finding names exactly one feature." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:processingFindingKind ?k ; va:processingFindingFeature ?f1 , ?f2 . FILTER (?k != "Group" && ?f1 != ?f2) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A group finding states how many variants the group alone has." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:processingFindingKind "Group" . FILTER NOT EXISTS { $this va:processingFindingVariants ?n } }""" ] .

va:ProcessingVerdictFollowsCountShape a sh:NodeShape ;
    rdfs:label "The processing verdict is the one the count gives, and the groups listed are the groups counted"@en ;
    sh:targetClass va:ProcessingResult ; sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Counted needs an exact count greater than zero." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasProcessingVerdict va:ProcessingVerdict_Counted . OPTIONAL { $this va:exactVariantCount ?n } FILTER (!BOUND(?n) || ?n <= 0) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Void needs an exact count of zero." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasProcessingVerdict va:ProcessingVerdict_Void . OPTIONAL { $this va:exactVariantCount ?n } FILTER (!BOUND(?n) || ?n != 0) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Not counted or undecided has no count and says why." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasProcessingVerdict ?v ; va:exactVariantCount ?n . FILTER (?v IN (va:ProcessingVerdict_NotCounted, va:ProcessingVerdict_Undecided)) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Not counted or undecided has no count and says why." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasProcessingVerdict ?v . FILTER (?v IN (va:ProcessingVerdict_NotCounted, va:ProcessingVerdict_Undecided)) FILTER NOT EXISTS { $this va:notCountedBecause ?w } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "The group count is not the number of group findings." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:groupCount ?g . OPTIONAL { ?f va:processingFindingOf $this ; va:processingFindingKind "Group" } } GROUP BY $this ?g HAVING (COUNT(?f) != ?g)
            """ ] .

# ---- 1.5.0: the Verification step (VAF-WI-247) ----
va:SynthesisToVerificationGateShape a sh:NodeShape ;
    rdfs:label "Verification starts only from a synthesis that passed or warned"@en ;
    sh:targetClass va:VerificationRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:verifiesFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:SynthesisResult ;
        sh:message "A verification request must name exactly one Synthesis Result it verifies." ] ;
    sh:property [ sh:path va:producesVerification ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:VerificationResult ;
        sh:message "A verification request must produce exactly one Verification Result." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Verification started from a Synthesis Result that neither passed nor warned." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:verifiesFrom ?sr . FILTER NOT EXISTS { ?sr va:hasSynthesisVerdict ?v . FILTER (?v IN (va:SynthesisVerdict_Pass, va:SynthesisVerdict_Warn)) } }""" ] .

va:VerificationResultVerdictShape a sh:NodeShape ;
    rdfs:label "A verification result carries one verification verdict and records each of its six checks once"@en ;
    sh:targetClass va:VerificationResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasVerificationVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:VerificationVerdict ;
        sh:message "A Verification Result must carry exactly one Verification Verdict." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A Verification Result lacks one of its six checks (FitsModel, ArtifactUnchanged, SelectedFeaturesPresent, NoUnselectedFeatures, Usefulness, GatesConform)." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { { BIND("FitsModel" AS ?n) } UNION { BIND("ArtifactUnchanged" AS ?n) } UNION { BIND("SelectedFeaturesPresent" AS ?n) }
                UNION { BIND("NoUnselectedFeatures" AS ?n) } UNION { BIND("Usefulness" AS ?n) } UNION { BIND("GatesConform" AS ?n) }
                FILTER NOT EXISTS { ?c va:verificationCheckOf $this ; va:checkName ?n } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A Verification Result records the same check twice." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { ?c1 va:verificationCheckOf $this ; va:checkName ?n . ?c2 va:verificationCheckOf $this ; va:checkName ?n . FILTER (?c1 != ?c2) }""" ] .

va:VerificationCheckShape a sh:NodeShape ;
    rdfs:label "A verification check is stated completely"@en ;
    sh:targetClass va:VerificationCheck ; sh:severity sh:Violation ;
    sh:property [ sh:path va:verificationCheckOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:VerificationResult ; sh:message "A verification check belongs to exactly one Verification Result." ] ;
    sh:property [ sh:path va:checkName ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "FitsModel" "ArtifactUnchanged" "SelectedFeaturesPresent" "NoUnselectedFeatures" "Usefulness" "GatesConform" ) ;
        sh:message "A verification check is one of the six: FitsModel, ArtifactUnchanged, SelectedFeaturesPresent, NoUnselectedFeatures, Usefulness, GatesConform." ] ;
    sh:property [ sh:path va:checkSeverity ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "Failure" "Warning" ) ; sh:message "A verification check has the severity Failure or Warning." ] ;
    sh:property [ sh:path va:checkPassed ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:message "A verification check states whether it passed." ] ;
    sh:property [ sh:path va:checkDetail ; sh:minCount 1 ; sh:message "A verification check says what it looked at and found." ] .

va:VerificationVerdictFollowsChecksShape a sh:NodeShape ;
    rdfs:label "The verification verdict is the one the checks give"@en ;
    sh:targetClass va:VerificationResult ; sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Not verified needs a check of severity Failure that did not pass." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasVerificationVerdict va:VerificationVerdict_NotVerified .
                FILTER NOT EXISTS { ?c va:verificationCheckOf $this ; va:checkSeverity "Failure" ; va:checkPassed false } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A check of severity Failure did not pass, yet the verdict is not Not verified." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasVerificationVerdict ?v . FILTER (?v != va:VerificationVerdict_NotVerified)
                ?c va:verificationCheckOf $this ; va:checkSeverity "Failure" ; va:checkPassed false }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Verified with warnings needs a check of severity Warning that did not pass." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasVerificationVerdict va:VerificationVerdict_VerifiedWithWarnings .
                FILTER NOT EXISTS { ?c va:verificationCheckOf $this ; va:checkSeverity "Warning" ; va:checkPassed false } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Verified needs every check to have passed." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasVerificationVerdict va:VerificationVerdict_Verified . ?c va:verificationCheckOf $this ; va:checkPassed false }""" ] .

# ---- 1.6.0: the Execution step (VAF-WI-248) ----
va:VerificationToExecutionGateShape a sh:NodeShape ;
    rdfs:label "Execution starts only from a verification that verified"@en ;
    sh:targetClass va:ExecutionRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:executesFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:VerificationResult ;
        sh:message "An execution request must name exactly one Verification Result it runs the artifact of." ] ;
    sh:property [ sh:path va:producesExecution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ExecutionResult ;
        sh:message "An execution request must produce exactly one Execution Result." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Execution started from a Verification Result that did not verify the variant." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:executesFrom ?vr . FILTER NOT EXISTS { ?vr va:hasVerificationVerdict ?v . FILTER (?v IN (va:VerificationVerdict_Verified, va:VerificationVerdict_VerifiedWithWarnings)) } }""" ] .

va:ExecutionResultShape a sh:NodeShape ;
    rdfs:label "An execution result carries one verdict and says what ran and what was seen"@en ;
    sh:targetClass va:ExecutionResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasExecutionVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:ExecutionVerdict ;
        sh:message "An Execution Result must carry exactly one Execution Verdict." ] ;
    sh:property [ sh:path va:executionEngine ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "python" "chromium" "none" ) ;
        sh:message "An Execution Result names the engine that ran the artifact: python, chromium, or none when nothing did." ] ;
    sh:property [ sh:path va:executionDetail ; sh:minCount 1 ; sh:message "An Execution Result says what was seen, or why the artifact was not run." ] ;
    sh:property [ sh:path va:executionSeconds ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:message "The seconds an execution took are one non-negative number." ] ;
    sh:property [ sh:path va:executionExitCode ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:message "An execution has at most one exit code, a whole number." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A result recorded as Ran names an engine that ran, not none." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasExecutionVerdict va:ExecutionVerdict_Ran ; va:executionEngine "none" }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A result recorded as Ran has a nonzero exit code." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasExecutionVerdict va:ExecutionVerdict_Ran ; va:executionExitCode ?c . FILTER (?c != 0) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A result recorded as Ran or Failed states the seconds it took and a digest of what was seen." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasExecutionVerdict ?v . FILTER (?v IN (va:ExecutionVerdict_Ran, va:ExecutionVerdict_Failed))
                FILTER (NOT EXISTS { $this va:executionSeconds ?s } || NOT EXISTS { $this va:executionOutputDigest ?d }) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A result recorded as Not run names no engine that ran it: its engine is none." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasExecutionVerdict va:ExecutionVerdict_NotRun ; va:executionEngine ?e . FILTER (?e != "none") }""" ] .

# ---- 1.7.0: the Feedback step (VAF-WI-249) ----
va:RunToFeedbackGateShape a sh:NodeShape ;
    rdfs:label "Feedback reads one pipeline run and produces one result"@en ;
    sh:targetClass va:FeedbackRequest ;
    sh:severity sh:Violation ;
    sh:property [ sh:path va:feedbackFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoverySynthesisPipeline ;
        sh:message "A feedback request must name exactly one pipeline run it reads." ] ;
    sh:property [ sh:path va:producesFeedback ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:FeedbackResult ;
        sh:message "A feedback request must produce exactly one Feedback Result." ] .

va:FeedbackResultShape a sh:NodeShape ;
    rdfs:label "A feedback result carries one verdict, and the verdict follows its findings"@en ;
    sh:targetClass va:FeedbackResult ; sh:severity sh:Violation ;
    sh:property [ sh:path va:hasFeedbackVerdict ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:FeedbackVerdict ;
        sh:message "A Feedback Result must carry exactly one Feedback Verdict." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Findings to act on needs a finding that is not a measurement." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasFeedbackVerdict va:FeedbackVerdict_FindingsToActOn .
                FILTER NOT EXISTS { ?f va:feedbackFindingOf $this ; va:feedbackKind ?k . FILTER (?k != "Measurement") } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "Nothing to correct, yet a finding that is not a measurement is recorded." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:hasFeedbackVerdict va:FeedbackVerdict_NothingToCorrect .
                ?f va:feedbackFindingOf $this ; va:feedbackKind ?k . FILTER (?k != "Measurement") }""" ] .

va:FeedbackFindingShape a sh:NodeShape ;
    rdfs:label "A feedback finding is stated completely"@en ;
    sh:targetClass va:FeedbackFinding ; sh:severity sh:Violation ;
    sh:property [ sh:path va:feedbackFindingOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:FeedbackResult ; sh:message "A feedback finding belongs to exactly one Feedback Result." ] ;
    sh:property [ sh:path va:feedbackKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "DeadFeature" "FalseOptionalFeature" "NoVariant" "Undecided" "DocumentsDisagree" "VerificationCheckFailed" "ExecutionFailed" "ExecutionSkipped" "CapacityNotice" "Measurement" "StoppedRun" ) ;
        sh:message "A feedback finding has one kind of those the Feedback step states." ] ;
    sh:property [ sh:path va:feedbackAddressee ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "Model owner" "Document owner" "Synthesis" "Capacity measurement" "The person" ) ;
        sh:message "A feedback finding is addressed to one of: Model owner, Document owner, Synthesis, Capacity measurement, The person." ] ;
    sh:property [ sh:path va:feedbackEvidenceStep ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "Discovery" "Agreement" "Processing" "Conversion" "Synthesis" "Verification" "Execution" "Run" ) ;
        sh:message "A feedback finding names the step of the run it comes from, or Run." ] ;
    sh:property [ sh:path va:feedbackStatement ; sh:minCount 1 ; sh:message "A feedback finding states what it found." ] ;
    sh:property [ sh:path va:feedbackSeconds ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:message "The seconds a measurement states are one non-negative number." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A measurement states the seconds it measured." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:feedbackKind "Measurement" . FILTER NOT EXISTS { $this va:feedbackSeconds ?s } }""" ] .

va:RunOutcomeShape a sh:NodeShape ;
    rdfs:label "A run recorded as Completed has the record of every step"@en ;
    sh:targetClass va:DiscoverySynthesisPipeline ; sh:severity sh:Violation ;
    sh:property [ sh:path va:runOutcome ; sh:maxCount 1 ; sh:in ( "Completed" "Stopped" ) ; sh:message "A run's outcome is Completed or Stopped." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run is recorded as Completed but lacks the record of a step: that step was skipped." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:runOutcome "Completed" .
                FILTER (NOT EXISTS { $this va:hasDiscoveryStage ?a } || NOT EXISTS { $this va:hasAgreementStage ?b } || NOT EXISTS { $this va:hasProcessingStage ?c }
                     || NOT EXISTS { $this va:hasConversionStage ?d } || NOT EXISTS { $this va:hasSynthesisStage ?e } || NOT EXISTS { $this va:hasVerificationStage ?f } || NOT EXISTS { $this va:hasExecutionStage ?g } || NOT EXISTS { $this va:hasFeedbackStage ?h }) }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run is recorded as Completed, but its verification did not verify the variant." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:runOutcome "Completed" ; va:hasVerificationStage ?v . FILTER NOT EXISTS { ?v va:hasVerificationVerdict ?d . FILTER (?d IN (va:VerificationVerdict_Verified, va:VerificationVerdict_VerifiedWithWarnings)) } }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run is recorded as Completed, but its execution failed." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:runOutcome "Completed" ; va:hasExecutionStage ?x . ?x va:hasExecutionVerdict va:ExecutionVerdict_Failed }""" ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "This run is recorded as Stopped but has no feedback that records the stop." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:runOutcome "Stopped" .
                FILTER NOT EXISTS { $this va:hasFeedbackStage ?fr . ?f va:feedbackFindingOf ?fr ; va:feedbackKind "StoppedRun" } }""" ] .

# ---- Capacity notices (VAF-WI-245)
va:CapacityNoticeShape a sh:NodeShape ;
    rdfs:label "A capacity notice is stated completely, and a notice of 'beyond measured' has a value that is beyond"@en ;
    sh:targetClass va:CapacityNotice ; sh:severity sh:Violation ;
    sh:property [ sh:path [ sh:inversePath va:hasCapacityNotice ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DiscoverySynthesisPipeline ;
        sh:message "A capacity notice belongs to exactly one pipeline run." ] ;
    sh:property [ sh:path va:noticeBeforeStep ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( va:Step_Discovery va:Step_Processing ) ;
        sh:message "A capacity notice names the step it was given before: Discovery or Processing." ] ;
    sh:property [ sh:path va:noticeDimension ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A capacity notice names the one dimension it is about." ] ;
    sh:property [ sh:path va:noticeObserved ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "A capacity notice states the project's value." ] ;
    sh:property [ sh:path va:noticeKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "BeyondMeasured" "UndecidedElsewhere" ) ;
        sh:message "A capacity notice is BeyondMeasured or UndecidedElsewhere." ] ;
    sh:property [ sh:path va:noticeText ; sh:minCount 1 ; sh:message "A capacity notice carries the text the person reads." ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
        sh:message "A notice of 'beyond measured' states a value that is not above what was measured." ;
        sh:select """PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE { $this va:noticeKind "BeyondMeasured" ; va:noticeObserved ?v ; va:noticeMeasuredUpTo ?m . FILTER (?v <= ?m) }""" ] .

# ==== file variant_algebra_probe_evidence_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- probe outcomes as evidence for 'a requires b', v1.0.0 (VAF-WI-134, 2026-10-04)
# A derived or discovered 'a requires b' between two methods stays "weakly grounded" while only syntax backs it. Running
# the ORIGINAL program answers it: a fresh instance is asked to run a (va:ProbeOutcome with va:poAfter none) and one in
# which b has run first (va:poAfter b). What those two outcomes mean is decided HERE (va:Decision_NoDecisionsInCode_2026_09_28);
# Python only runs the program and writes down what each call returned or raised.
#
# Input facts: va:ProbeQuestion (va:pqFrom a, va:pqTo b); va:ProbeOutcome (va:poMethod, va:poAfter "none" or the method that
#              ran first, va:poResult "ok" | "raised")
# Output facts: va:ProbeVerdict (va:pvFrom, va:pvTo, va:pvKind "confirmed" | "refuted" | "inconclusive", va:pvWhy)
#   confirmed:    a raised on a fresh instance and ran after b -> b is what a needed
#   refuted:      a ran on a fresh instance -> a does not need b
#   inconclusive: a raised even after b (it needs something else as well) or a probe did not run
# ============================================================

<http://example.org/vaf-consolidated/probe-evidence-rules>
    rdfs:label "VAF Probe-Evidence SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_probe_evidence_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/probe-evidence-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:ProbeConfirmShape a sh:NodeShape ; sh:targetClass va:ProbeQuestion ;
    rdfs:label "The probe saw a fail alone and succeed after b"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/probe-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:pvKind "confirmed" ; va:pvWhy "a fresh instance could not run it, and one on which the other had run could" }
        WHERE { $this va:pqFrom ?a ; va:pqTo ?b .
                ?o1 va:poMethod ?a ; va:poAfter "none" ; va:poResult "raised" .
                ?o2 va:poMethod ?a ; va:poAfter ?b ; va:poResult "ok" }""" ] .

va:ProbeRefuteShape a sh:NodeShape ; sh:targetClass va:ProbeQuestion ;
    rdfs:label "The probe saw a succeed on a fresh instance"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/probe-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:pvKind "refuted" ; va:pvWhy "a fresh instance ran it without the other" }
        WHERE { $this va:pqFrom ?a . ?o va:poMethod ?a ; va:poAfter "none" ; va:poResult "ok" }""" ] .

va:ProbeInconclusiveShape a sh:NodeShape ; sh:targetClass va:ProbeQuestion ;
    rdfs:label "Neither outcome decides"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/probe-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:pvKind "inconclusive" ; va:pvWhy "the probe's outcomes do not show that the other is what it needs" }
        WHERE { $this a va:ProbeQuestion . FILTER NOT EXISTS { $this va:pvKind ?k } }""" ] .

# ==== file variant_algebra_profile_family_generation_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra -- Profile Family Generation SHACL-AF Rules v1.0.0
# Mission_ProfileFamilyVariantGeneration, WI_ProfileFamilyGenerationBridge.
#
# Real, ontology-native implementation of the ONLY genuinely ontology-native
# part of the ProfileFamily -> variant generation bridge: computing, for
# every real va:ProfileFamily node, its EFFECTIVE (accumulated) element sets
# -- its own plus every real ancestor's, walked via an ordinary SPARQL
# property path (^va:hasChildFamily)*, exactly the same style as this
# corpus's own real rdf:rest*/rdf:first list-traversal pattern
# (variant_algebra_operator_rules_v1_0_0.ttl's ExclusiveRuleShape) applied
# to a tree instead of a list.
#
# Deliberately NOT ontology-native (see Ex_NoNewEnumerationLogic and the
# Python bridge in 06-runtime/src/variant_profile_family_generation_bridge_v1_0_0.py):
# constructing the nested Component/Statement AST VAF's existing, unmodified
# enumerate_variants() requires, and calling that pre-existing external
# function -- SPARQL CONSTRUCT can accumulate a flat set; it cannot build an
# arbitrary nested AST or invoke an external API.
#
# Execute with pyshacl: advanced=True, inplace=True, inference="none" --
# same convention as variant_algebra_operator_rules_v1_0_0.ttl.
# ============================================================

<http://example.org/vaf-consolidated/profile-family-generation-rules>
    rdfs:label "VAF Profile Family Generation SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-14"^^xsd:date ;
    dcterms:identifier "variant_algebra_profile_family_generation_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/profile-family-generation-rules/1.0.0> ;
    dcterms:source "Mission_ProfileFamilyVariantGeneration, WI_ProfileFamilyGenerationBridge, this session. Depends on 01-ontologies/variant_algebra_profile_family_v1_0_0.ttl." ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_profile_family_v1_0_0.ttl not mutated beyond its own new hasEffective* property declarations." .

va:ProfileFamilyEffectiveMandatoryRuleShape a sh:NodeShape ;
    sh:targetClass va:Profile, va:ProfileFamily ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEffectiveMandatoryElement ?el }
            WHERE {
                $this (^va:hasChildFamily)* ?ancestor .
                ?ancestor va:hasMandatoryElement ?el .
            }
        """ ; ] .

va:ProfileFamilyEffectiveOptionalRuleShape a sh:NodeShape ;
    sh:targetClass va:Profile, va:ProfileFamily ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEffectiveOptionalElement ?el }
            WHERE {
                $this (^va:hasChildFamily)* ?ancestor .
                ?ancestor va:hasOptionalElement ?el .
            }
        """ ; ] .

#################################################################
# Operator coverage extension: accumulate hasExcludedElement (real
# Inverse semantics) first, since the Mandatory/Optional rules above
# do NOT subtract it (kept deliberately simple/additive, matching
# their own real, already-tested behavior) -- a SEPARATE pair of
# rules below computes the real, exclusion-aware effective sets.
#################################################################

va:ProfileFamilyEffectiveExcludedRuleShape a sh:NodeShape ;
    sh:targetClass va:Profile, va:ProfileFamily ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEffectiveExcludedElement ?el }
            WHERE {
                $this (^va:hasChildFamily)* ?ancestor .
                ?ancestor va:hasExcludedElement ?el .
            }
        """ ; ] .

va:ProfileFamilyEffectiveMandatoryMinusExcludedRuleShape a sh:NodeShape ;
    sh:targetClass va:Profile, va:ProfileFamily ;
    sh:rule [ a sh:SPARQLRule ;
        sh:order 2 ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEffectiveMandatoryElementNet ?el }
            WHERE {
                $this va:hasEffectiveMandatoryElement ?el .
                FILTER NOT EXISTS { $this va:hasEffectiveExcludedElement ?el }
            }
        """ ; ] .

va:ProfileFamilyEffectiveOptionalMinusExcludedRuleShape a sh:NodeShape ;
    sh:targetClass va:Profile, va:ProfileFamily ;
    sh:rule [ a sh:SPARQLRule ;
        sh:order 2 ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:hasEffectiveOptionalElementNet ?el }
            WHERE {
                $this va:hasEffectiveOptionalElement ?el .
                FILTER NOT EXISTS { $this va:hasEffectiveExcludedElement ?el }
            }
        """ ; ] .

# ==== file variant_algebra_profile_family_soundness_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Profile Family Soundness SHACL-AF Rules v1.0.0 (VAF-WI-116c, 2026-09-28)
# The soundness check of a profile family (Package Del_SoundnessCheckReal): along an inheritance path, a family that
# marks an element Optional where the nearest ancestor that constrains the element marked it Mandatory (or the reverse)
# makes the accumulated constraints unsatisfiable. Until 2026-09-28 Python (variant_profile_family_soundness_v1_0_0.py);
# by va:Decision_NoDecisionsInCode_2026_09_28 the decision is here, and the module writes the family as triples and
# reads the findings. Kept apart from the generation rules: soundness is a check on a family, not its generation.
# ============================================================

<http://example.org/vaf-consolidated/profile-family-soundness-rules>
    rdfs:label "VAF Profile Family Soundness SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_profile_family_soundness_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/profile-family-soundness-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:FamilyContradictionRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:ownConstraint ;
    rdfs:label "A family contradicts the nearest ancestor that constrains the same element: Mandatory against Optional"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/profile-family-soundness-rules> ; sh:construct """
        CONSTRUCT { ?f a va:FamilyContradiction ; va:contradictionElement ?e ; va:contradictionAncestor ?a ; va:ancestorOperator ?oa ;
                       va:contradictionDescendant $this ; va:descendantOperator ?od ; va:contradictionConstraint ?cd }
        WHERE { $this va:ownConstraint ?cd . ?cd va:constrainedElement ?e ; va:constraintOperator ?od .
                ?a va:hasChildFamily+ $this ; va:ownConstraint ?ca . ?ca va:constrainedElement ?e ; va:constraintOperator ?oa .
                FILTER NOT EXISTS { ?a va:hasChildFamily+ ?m . ?m va:hasChildFamily+ $this ; va:ownConstraint ?cm . ?cm va:constrainedElement ?e }
                FILTER ((?oa = "Mandatory" && ?od = "Optional") || (?oa = "Optional" && ?od = "Mandatory"))
                BIND(IRI(CONCAT(STR(?cd), "__contradiction")) AS ?f) }""" ] .

# ==== file variant_algebra_purpose_derivation_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Purpose Derivation SHACL-AF Rule v1.0.0
# Real implementation of the SuperComponent purpose-derivation mechanism,
# tested to 2 hops of nesting (testdrive_purpose_agent.py, 3/3 PASS).
# ============================================================

<http://example.org/vaf-consolidated/purpose-derivation-rules>
    rdfs:label "VAF Purpose Derivation SHACL-AF Rule v1.0.0"@en ;
    dcterms:created "2026-07-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_purpose_derivation_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/purpose-derivation-rules/1.0.0> ;
    dcterms:source "This session, 2026-07-04. Depends on 01-ontologies/variant_algebra_v3_purpose_attribution_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/purpose-attribution-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated."@en .

va:DeriveShape a sh:NodeShape ;
    sh:targetClass va:SuperComponent ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { ?sub va:hasDerivedPurposeFrom $this }
            WHERE {
                { $this va:hasSubComponent ?sub }
                UNION
                { $this va:hasSubComponent ?mid . ?mid va:hasSubComponent ?sub }
                FILTER NOT EXISTS { ?attr va:attributesPurposeTo ?sub }
                FILTER EXISTS { ?attr2 va:attributesPurposeTo $this }
            }
        """ ; ] .

# ==== file variant_algebra_purpose_target_selection_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Purpose Target-Selection SHACL-AF Rules v1.0.0
# Real implementation, Package 3.
# ============================================================

<http://example.org/vaf-consolidated/purpose-target-selection-rules>
    rdfs:label "VAF Purpose Target-Selection SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-07-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_purpose_target_selection_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/purpose-target-selection-rules/1.0.0> ;
    dcterms:source "This session, 2026-07-04. Depends on 01-ontologies/variant_algebra_v3_purpose_target_selection_properties_v1_0_0.ttl." ;
    oe:testedBy <http://example.org/vaf-consolidated/purpose-target-selection-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated."@en .

va:TargetSelectionShape a sh:NodeShape ;
    sh:targetClass va:BuilderAttribution ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesSynthesisTarget "python" }
            WHERE {
                $this va:purposeDescription ?d .
                FILTER(REGEX(?d, "utility|library|internal", "i"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesSynthesisTarget "html" }
            WHERE {
                $this va:purposeDescription ?d .
                FILTER(REGEX(?d, "demo|stakeholder|presentation|report", "i"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesSynthesisTarget "knowledge-embedded" }
            WHERE {
                $this va:purposeDescription ?d .
                FILTER(REGEX(?d, "knowledge|semantic|reference", "i"))
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:proposesSynthesisTarget "agentic-export" }
            WHERE {
                $this va:purposeDescription ?d .
                FILTER(REGEX(?d, "agent|reasoning|prompt", "i"))
            }
        """ ; ] .

va:TargetChoiceShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    rdfs:label "A method is built for the smallest target its purposes propose; with none proposed, for the default target"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:selectedSynthesisTarget ?t }
            WHERE {
                ?a va:attributesPurposeTo $this ; va:proposesSynthesisTarget ?t .
                FILTER NOT EXISTS { ?a2 va:attributesPurposeTo $this ; va:proposesSynthesisTarget ?t2 FILTER(?t2 < ?t) }
            }
        """ ; ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT { $this va:selectedSynthesisTarget ?d ; va:targetDefaultedBy ?p }
            WHERE {
                ?p a va:SynthesisPolicy ; va:defaultSynthesisTarget ?d .
                FILTER NOT EXISTS { $this va:selectedSynthesisTarget ?x }
            }
        """ ; ] .

# ==== file variant_algebra_quality_check_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Quality Check SHACL-AF Rules v1.0.0 (VAF-WI-116e, 2026-09-28)
# Sprint 4.2's five quality dimensions (cyclomatic, size, documentation, coupling, cohesion -- seven metrics in all,
# methods_per_class and classes counted separately under size) each compare one observed value against one threshold,
# in the direction its policy states (a ceiling for six of them, a floor for documentation), and carry the severity
# (WARN | FAIL) the policy assigns when they violate; a dimension whose policy severity is absent is measured but
# never enforced. The report fails when any metric carries FAIL, warns when any carries WARN and no metric carries
# FAIL; the verifier's outcome keeps the prior check's FAIL, otherwise takes the quality outcome. Until 2026-09-28
# these were Python (variant_quality_v1_0_0.py). Input: one va:QualityMetricAssertion per dimension (va:metricObserved,
# va:metricThreshold, va:metricDirection "max"|"min", optional va:metricPolicySeverity) under one va:QualityCheck
# (va:priorOutcome "PASS"|"WARN"|"FAIL" from the checks that ran before it).
# ============================================================

<http://example.org/vaf-consolidated/quality-check-rules>
    rdfs:label "VAF Quality Check SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_quality_check_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/quality-check-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:QualityMetricViolationRuleShape a sh:NodeShape ; sh:targetClass va:QualityMetricAssertion ;
    rdfs:comment "A ceiling metric violates above its threshold; a floor metric (documentation) violates below it."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:metricViolated true }
        WHERE { $this a va:QualityMetricAssertion ; va:metricDirection "max" ; va:metricObserved ?o ; va:metricThreshold ?t . FILTER(?o > ?t) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:metricViolated true }
        WHERE { $this a va:QualityMetricAssertion ; va:metricDirection "min" ; va:metricObserved ?o ; va:metricThreshold ?t . FILTER(?o < ?t) }""" ] .

va:QualityMetricSeverityRuleShape a sh:NodeShape ; sh:targetClass va:QualityMetricAssertion ;
    rdfs:comment "A violated metric carries its policy's severity for that dimension; a metric with no policy severity (the dimension disabled) is measured but never enforced."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:metricSeverity ?s }
        WHERE { $this a va:QualityMetricAssertion ; va:metricViolated true ; va:metricPolicySeverity ?s }""" ] .

va:QualityReportRuleShape a sh:NodeShape ; sh:targetClass va:QualityCheck ;
    rdfs:comment "The report fails when any of its metrics carries FAIL, and warns when any carries WARN."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:hasFailures true }
        WHERE { $this a va:QualityCheck . FILTER EXISTS { $this va:hasMetric ?m . ?m va:metricSeverity "FAIL" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:hasWarnings true }
        WHERE { $this a va:QualityCheck . FILTER EXISTS { $this va:hasMetric ?m . ?m va:metricSeverity "WARN" } }""" ] .

va:QualityOutcomeRuleShape a sh:NodeShape ; sh:targetClass va:QualityCheck ;
    rdfs:comment "FAIL dominates, from either the prior checks or this report. Otherwise this report's WARN escalates a prior PASS; any other prior outcome (already WARN, or FAIL handled above) passes through unchanged."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/quality-check-rules> ; sh:construct """
        CONSTRUCT { $this va:finalOutcome ?out }
        WHERE { $this a va:QualityCheck ; va:priorOutcome ?prior .
                BIND(EXISTS { $this va:hasFailures true } AS ?fail) BIND(EXISTS { $this va:hasWarnings true } AS ?warn)
                BIND(IF(?prior = "FAIL" || ?fail, "FAIL", IF(?warn && ?prior = "PASS", "WARN", ?prior)) AS ?out) }""" ] .

# ==== file variant_algebra_rdodi_domain_translation_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — RDODI Domain-Ontology Translation SHACL-AF Rule v1.0.0
# Gap-filling only, by design (see properties file header).
# ============================================================

<http://example.org/vaf-consolidated/rdodi-domain-translation-rules>
    rdfs:label "VAF RDODI Domain-Ontology Translation SHACL-AF Rule v1.0.0"@en ;
    dcterms:created "2026-07-06"^^xsd:date ;
    dcterms:identifier "variant_algebra_rdodi_domain_translation_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/rdodi-domain-translation-rules/1.0.0> ;
    dcterms:source "This session, 2026-07-06. Depends on 01-ontologies/variant_algebra_v3_rdodi_domain_translation_properties_v1_0_0.ttl and the General Bridge (Package 1)." ;
    oe:testedBy <http://example.org/vaf-consolidated/rdodi-domain-translation-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated."@en .

va:DomainGapFillShape a sh:NodeShape ;
    sh:targetClass va:Method ;
    sh:rule [ a sh:SPARQLRule ;
        sh:construct """
            PREFIX va: <http://example.org/variant-algebra#>
            CONSTRUCT {
                $this va:hasSynthesisCandidate _:cand .
                _:cand a va:SynthesisInputCandidate ;
                    va:candidateKind "domain-ontology" ;
                    va:candidateSource ?concept .
                _:attr a va:BuilderAttribution ;
                    va:attributesPurposeTo $this ;
                    va:confidenceTier "domain-inferred" .
            }
            WHERE {
                $this va:hasRawName ?name .
                ?concept a va:DomainConcept ;
                    va:domainConceptLabel ?label .
                FILTER(CONTAINS(LCASE(?name), LCASE(?label)))
                FILTER NOT EXISTS { $this va:hasSynthesisCandidate ?anyExisting }
            }
        """ ; ] .

# ==== file variant_algebra_realisation_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Realisation SHACL-AF Rules v1.0.0 (VAF-WI-127, 2026-10-01)
# Owner decision va:Decision_ExecutableVariants_2026_09_29: a chosen variant becomes a genuine, runnable program that
# contains only the selected features. WHICH statements of the original program a variant keeps is decided here, over
# the program's harvested syntax (one va:RealStatement per statement, with the discovered features it refers to), not
# in Python (va:Decision_NoDecisionsInCode_2026_09_28). Python only harvests the statements and, from the decided
# facts, writes the surviving statements back out.
#
# Input facts (harvested; see variant_realise_backend_v1_0_0.py):
#   va:RealAtom            a discovered feature that occurs in the program (a method, attribute, state value,
#                          exception or external it names); va:atomSelected true when the variant selects it,
#                          va:atomCount n for its repetition count
#   va:RealStatement       one statement; va:stmtParent (the enclosing statement), va:stmtRefers (an atom its own
#                          header expression names), va:stmtRefersValue (a state-value atom of an assignment to an
#                          attribute), va:isCompound / va:dropsWhenVacuous, va:inInit, va:assignsAttr,
#                          va:loopBound / va:loopAdds
# Output facts: va:realDrop (the statement is not in the variant), va:realRewriteNone (an initial assignment whose
# state value is not selected keeps the attribute but starts it unset), va:realRewriteBound n (a literal loop bound is
# the selected repetition count).
# ============================================================

<http://example.org/vaf-consolidated/realisation-rules>
    rdfs:label "VAF Realisation SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-01"^^xsd:date ;
    dcterms:identifier "variant_algebra_realisation_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/realisation-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

# ---- stratum 1: rewrites that keep a statement in a changed form
va:RealInitRewriteShape a sh:NodeShape ; sh:targetClass va:RealStatement ;
    rdfs:label "An initial assignment of an unselected state value keeps the selected attribute, unset"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realRewriteNone true }
        WHERE { $this va:inInit true ; va:assignsAttr ?a ; va:stmtRefersValue ?v .
                ?a va:atomSelected true .
                FILTER NOT EXISTS { ?v va:atomSelected true } }
    """ ] .

va:RealLoopBoundShape a sh:NodeShape ; sh:targetClass va:RealStatement ;
    rdfs:label "A loop over a literal count runs as many times as the selected repetition count of what it fills"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realRewriteBound ?c }
        WHERE { $this va:loopBound ?n ; va:loopAdds ?a .
                ?a va:atomSelected true ; va:atomCount ?c .
                FILTER (?c != ?n) }
    """ ] .

# ---- stratum 2: what is not in the variant
va:RealDropShape a sh:NodeShape ; sh:targetClass va:RealStatement ;
    rdfs:label "A statement that names a feature the variant does not select is not in the variant"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realDrop true }
        WHERE { $this va:stmtRefers ?a . ?a a va:RealAtom .
                FILTER NOT EXISTS { ?a va:atomSelected true } }
    """ ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realDrop true }
        WHERE { $this va:stmtRefersValue ?v . ?v a va:RealAtom .
                FILTER NOT EXISTS { ?v va:atomSelected true }
                FILTER NOT EXISTS { $this va:realRewriteNone true } }
    """ ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realDrop true }
        WHERE { $this va:stmtParent ?p . ?p va:realDrop true }
    """ ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/realisation-rules> ; sh:construct """
        CONSTRUCT { $this va:realDrop true }
        WHERE { $this va:dropsWhenVacuous true . ?c va:stmtParent $this .
                FILTER NOT EXISTS { ?c2 va:stmtParent $this . FILTER NOT EXISTS { ?c2 va:realDrop true } } }
    """ ] .

# ==== file variant_algebra_semantic_marker_rules_v2_1_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix py:      <http://example.org/python-ast#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra -- Semantic Marker SHACL-AF Rules v2.1.0 (VAF-WI-114, VAF-WI-116b, 2026-09-28)
# C10-C13 as rules, equal to the calculi they replace (the Python module is now a wrapper that reads these results).
#   C10 NameTerm       a name split into terms, any number of them (1.0.0 kept four and, on Oxigraph, lost the first
#                      part at a camel-case boundary: there '$1_$2' names a group '1_')
#   C11 NamingPattern  all ten patterns, in their declared order (1.0.0 had five)
#   C12 TypeReference  a function's annotations as type references, nested to any depth, over its syntax tree
#   C13 ValueDomain    Enum classes and their assigned members, over a module's syntax tree
#   Composition        (2.1.0, VAF-WI-116b) self.x = C() in a class, C a class of the same module: a has-a fact; until
#                      then Python (variant_composition_calculi_v1_0_0.py)
# Names are read from va:hasRawName; syntax trees from 09-declarative-calculi/harvester_python_syntax_tree_v1_0_0.py.
# ============================================================

<http://example.org/vaf-consolidated/semantic-marker-rules>
    rdfs:label "VAF Semantic Marker SHACL-AF Rules v2.1.0"@en ;
    dcterms:created "2026-07-03"^^xsd:date ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_semantic_marker_rules_v2_1_0" ;
    owl:versionInfo "2.1.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/semantic-marker-rules/2.1.0> ;
    owl:priorVersion <http://example.org/vaf-consolidated/semantic-marker-rules/2.0.0> ;
    owl:imports <http://example.org/variant-algebra/harvest-vocabulary> , <http://example.org/python-ast> ;
    rdfs:comment "2.0.0 (VAF-WI-114) makes each rule equal to its calculus, measured against the Python calculi's recorded results (12-experiments/calculi_on_rules_v1_0_0.py). Breaking: C10 gives ordered va:NameTerm individuals (va:hasNameTerm, va:termIndex, va:termText) instead of va:proposesNameTerm strings; C12 reads a syntax tree instead of va:typeName facts; the 1.0.0 marker va:proposesOuterConfirmed is gone."@en ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "py" ; sh:namespace "http://example.org/python-ast#"^^xsd:anyURI ] .

# ---- C11: NamingPattern. Each pattern is searched for in the raw name; a name may match several (the ontology
# declares no exclusivity). The declared order is recorded on the pattern (va:namingPatternOrder).
va:C11RuleShape a sh:NodeShape ; sh:targetClass va:Feature ; rdfs:label "C11: naming patterns"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { $this va:matchesNamingPattern ?p . ?p va:namingPatternOrder ?o }
        WHERE { $this va:hasRawName ?n .
                VALUES (?o ?p ?rx) {
                    (0 va:Pattern_Getter    '^get_?[A-Za-z0-9]')
                    (1 va:Pattern_Setter    '^set_?[A-Za-z0-9]')
                    (2 va:Pattern_Validator '^(validate_?|is_valid_)[A-Za-z0-9]')
                    (3 va:Pattern_Handler   '^(handle_?|on_)[A-Za-z0-9]')
                    (4 va:Pattern_Factory   '^(create_?|make_?|build_?)[A-Za-z0-9]|_factory$')
                    (5 va:Pattern_Mutator   '^[A-Za-z0-9]+_to_[A-Za-z0-9]+$')
                    (6 va:Pattern_Predicate '^(is_|has_|can_)[A-Za-z0-9]')
                    (7 va:Pattern_Lifecycle '^(init_?|destroy_?|open_?|close_?|start_?|stop_?)[A-Za-z0-9]')
                    (8 va:Pattern_Test      '^test_[A-Za-z0-9]|_test$')
                    (9 va:Pattern_Accessor  '^[A-Za-z0-9]+_of_[A-Za-z0-9]+$') }
                FILTER(REGEX(?n, ?rx)) }""" ] .

# ---- C10: NameTerm. A snake_case name splits at its underscores as written; any other name at its camel-case
# boundaries (an acronym ends before the capital that starts the next word; a capital after a lower-case letter or a
# digit starts a word). Terms are lower-cased, empty ones dropped, and kept in order. The split runs term by term to
# a fixpoint, so there is no limit on the number of terms. The boundary mark '|' is not a word character (a name is
# an identifier, which cannot contain it).
va:C10RuleShape a sh:NodeShape ; sh:targetClass va:Feature ; rdfs:label "C10: name terms"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?s va:splitOf $this ; va:splitIndex 0 ; va:splitRest ?joined }
        WHERE { $this va:hasRawName ?n .
                BIND(IF(CONTAINS(?n, '_'), REPLACE(?n, '_', '|'),
                        REPLACE(REPLACE(?n, '([A-Z]+)([A-Z][a-z])', '$1|$2'), '([a-z0-9])([A-Z])', '$1|$2')) AS ?joined)
                BIND(IRI(CONCAT(STR($this), '__split_0')) AS ?s) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?next va:splitOf $this ; va:splitIndex ?j ; va:splitRest ?after }
        WHERE { ?s va:splitOf $this ; va:splitIndex ?i ; va:splitRest ?r . FILTER(CONTAINS(?r, '|'))
                BIND(STRAFTER(?r, '|') AS ?after) BIND(?i + 1 AS ?j)
                BIND(IRI(CONCAT(STR($this), '__split_', STR(?j))) AS ?next) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { $this va:hasNameTerm ?t . ?t a va:NameTerm ; va:termIndex ?i ; va:termText ?text }
        WHERE { ?s va:splitOf $this ; va:splitIndex ?i ; va:splitRest ?r .
                BIND(LCASE(IF(CONTAINS(?r, '|'), STRBEFORE(?r, '|'), ?r)) AS ?text) FILTER(?text != '')
                BIND(IRI(CONCAT(STR($this), '__term_', STR(?i))) AS ?t) }""" ] .

# ---- C12: TypeReference. For a function: each parameter (not 'self') with an annotation, in order, then the return
# annotation. An annotation is a type reference when it is a name (its identifier), an attribute (its last name), the
# constant None ('None'), or a subscript whose base is one (the base's name); a subscript's parameters are the elements
# of its slice (a tuple's elements, otherwise the slice itself) that are type references, in order. Anything else is
# not a type reference and is left out.
va:C12RuleShape a sh:NodeShape ; sh:targetClass py:FunctionDef ; rdfs:label "C12: type references"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?r va:annotationOf $this ; va:annotationPosition ?pos }
        WHERE { { $this py:args ?as . ?as py:args ?a . ?a py:arg ?an ; py:annotation ?r ; py:index ?pos . FILTER(?an != 'self') }
                UNION { $this py:returns ?r . BIND(1000000 AS ?pos) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?x va:inAnnotationOf $this }
        WHERE { ?r va:annotationOf $this . ?r (py:value|py:slice|py:elts)* ?x . FILTER(isIRI(?x)) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?x va:typeName ?nm }
        WHERE { ?x va:inAnnotationOf $this .
                { ?x a py:Name ; py:id ?nm } UNION { ?x a py:Attribute ; py:attr ?nm }
                UNION { ?x a py:Constant ; py:value py:None . BIND('None' AS ?nm) }
                UNION { ?x a py:Subscript ; py:value ?b . ?b va:typeName ?nm } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?x a va:TypeReference . ?x va:hasTypeParameter ?e . ?e va:typeParameterIndex ?i }
        WHERE { ?x va:inAnnotationOf $this ; va:typeName ?nm .
                OPTIONAL { { ?x a py:Subscript ; py:slice ?sl . ?sl a py:Tuple ; py:elts ?e . ?e py:index ?i }
                           UNION { ?x a py:Subscript ; py:slice ?e . FILTER NOT EXISTS { ?e a py:Tuple } BIND(0 AS ?i) }
                           ?e va:typeName ?en } }""" ] .

# ---- C13: ValueDomain. A class with a base named Enum, IntEnum, Flag or IntFlag (a name, or an attribute's last
# name) whose body assigns at least one plain name: those names are its members, in the order written. Its members
# are mutually exclusive (the ontology's definition), which closes the loop to va:ExclusiveOperator.
va:C13RuleShape a sh:NodeShape ; sh:targetClass py:ClassDef ; rdfs:label "C13: value domains"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { $this a va:ValueDomain ; va:hasDomainMember ?t . ?t va:domainMemberName ?m ; va:domainMemberStatement ?si ; va:domainMemberTarget ?ti }
        WHERE { $this py:bases ?b . { ?b a py:Name ; py:id ?bn } UNION { ?b a py:Attribute ; py:attr ?bn }
                FILTER(?bn IN ('Enum', 'IntEnum', 'Flag', 'IntFlag'))
                $this py:body ?st . ?st a py:Assign ; py:index ?si ; py:targets ?t . ?t a py:Name ; py:id ?m ; py:index ?ti }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { $this va:impliesExclusiveOperator true }
        WHERE { $this a va:ValueDomain ; va:hasDomainMember ?m1 , ?m2 . FILTER(?m1 != ?m2) }""" ] .

va:CompositionRuleShape a sh:NodeShape ; sh:targetClass py:ClassDef ; rdfs:label "Composition: a class holds an instance of another class of the same module"@en ;
    rdfs:comment "self.x = C() anywhere inside a class, C the name of a class defined in the same module: the class has-a C through its attribute x. A structural fact, not an operator of the algebra (2.1.0, VAF-WI-116b)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/semantic-marker-rules> ; sh:construct """
        CONSTRUCT { ?f a va:CompositionFact ; va:compositionOwner $this ; va:compositionAttribute ?attr ; va:compositionType ?tn ;
                       va:compositionStatement ?as ; va:compositionTarget ?ti }
        WHERE { $this py:child+ ?as . ?as a py:Assign ; py:targets ?t ; py:value ?call .
                ?t a py:Attribute ; py:attr ?attr ; py:value ?sv ; py:index ?ti . ?sv a py:Name ; py:id "self" .
                ?call a py:Call ; py:func ?fn . ?fn a py:Name ; py:id ?tn .
                ?mod a py:Module ; py:child+ $this , ?other . ?other a py:ClassDef ; py:name ?tn .
                BIND(IRI(CONCAT(STR($this), "__composition_", MD5(CONCAT(STR(?as), " ", STR(?ti))))) AS ?f) }""" ] .

# ==== file variant_algebra_shacl_v3_2_1.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/ontology-engineering#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix vax: <http://example.org/variant-algebra-shapes#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://example.org/variant-algebra-shapes> sh:declare [ sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ;
            sh:prefix "va" ],
        [ sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
            sh:prefix "rdfs" ],
        [ sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ;
            sh:prefix "owl" ] .

vax:APISpecificationArtifactShape a sh:NodeShape ;
    rdfs:label "APISpecificationArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:APISpecificationArtifact .

vax:ActiveOperatorLeafShape a sh:NodeShape ;
    rdfs:label "Active Operator Leaf Shape (lock #5c mechanical enforcement)"@en ;
    dcterms:source "Blueprint v3.0.4 §0.4 lock #5c (mechanical enforcement); BS-§0-8 closure"@en ;
    rdfs:comment "For any class C such that (C rdfs:subClassOf va:Operator) AND NOT (C owl:deprecated true), C must be one of the 12 enumerated leaves per blueprint v3.0.4 lock #5b. Closes BS-§0-8."@en ;
    sh:in ( va:AdditionOperator va:SubtractionOperator va:CartesianOperator va:DivisionOperator va:InverseOperator va:IntersectionOperator va:OrOperator va:ExclusiveOperator va:OptionalOperator va:DependencyOperator va:RepetitionOperator va:MandatoryOperator ) ;
    sh:message "Lock #5b violation: this class is rdfs:subClassOf va:Operator and not deprecated, but its IRI is not in the closed twelve-leaf list. The list (set-theoretic interpretation per thesis L1099): AdditionOperator, SubtractionOperator, CartesianOperator, DivisionOperator, InverseOperator, IntersectionOperator, OrOperator, ExclusiveOperator, OptionalOperator, DependencyOperator, RepetitionOperator, MandatoryOperator. Closes BS-§0-8 mechanically."@en ;
    sh:target [ a sh:SPARQLTarget ;
            sh:prefixes <http://example.org/variant-algebra-shapes> ;
            sh:select """
            PREFIX va: <http://example.org/variant-algebra#>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT ?this WHERE {
                ?this rdfs:subClassOf va:Operator .
                FILTER NOT EXISTS { ?this owl:deprecated true }
            }
        """ ] .

vax:ArtifactShape a sh:NodeShape ;
    rdfs:label "Artifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:message "va:artifactTimestamp on Artifact must conform to its declared range."@en ;
            sh:path va:artifactTimestamp ],
        [ sh:datatype xsd:string ;
            sh:message "va:authoredBy on Artifact must conform to its declared range."@en ;
            sh:path va:authoredBy ],
        [ sh:datatype xsd:string ;
            sh:message "va:artifactFormat on Artifact must conform to its declared range."@en ;
            sh:path va:artifactFormat ],
        [ sh:datatype xsd:string ;
            sh:message "va:artifactPath on Artifact must conform to its declared range."@en ;
            sh:path va:artifactPath ],
        [ sh:datatype xsd:string ;
            sh:message "va:artifactLifecycleStage on Artifact must conform to its declared range."@en ;
            sh:path va:artifactLifecycleStage ] ;
    sh:targetClass va:Artifact .

vax:AssemblyShape a sh:NodeShape ;
    rdfs:label "Assembly Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:class va:Application ;
            sh:message "va:producesApplication on Assembly must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:producesApplication ],
        [ sh:class va:Variant ;
            sh:message "va:assembles on Assembly must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:assembles ],
        [ sh:datatype xsd:string ;
            sh:message "va:targetLanguage on Assembly must conform to its declared range."@en ;
            sh:path va:targetLanguage ] ;
    sh:targetClass va:Assembly .

vax:BodySegmentShape a sh:NodeShape ;
    rdfs:label "BodySegment Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:class va:BodySegment ;
            sh:message "va:precedes on BodySegment must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:precedes ],
        [ sh:datatype xsd:integer ;
            sh:message "va:endLine on BodySegment must conform to its declared range."@en ;
            sh:path va:endLine ],
        [ sh:datatype xsd:string ;
            sh:message "va:segmentKind on BodySegment must conform to its declared range."@en ;
            sh:path va:segmentKind ],
        [ sh:class va:SoftwareUnit ;
            sh:message "va:partOfBody on BodySegment must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:partOfBody ],
        [ sh:datatype xsd:integer ;
            sh:message "va:startLine on BodySegment must conform to its declared range."@en ;
            sh:path va:startLine ],
        [ sh:in ( "Validation" "Dispatch" "ResourceScope" "ErrorHandling" "Logging" "StateUpdate" "Computation" "IOEffect" "Result" "PreconditionAssertion" "Iteration" ) ;
            sh:message "segmentKind must be one of the 11 enumerated values per blueprint v3.0.4 lock #4."@en ;
            sh:path va:segmentKind ] ;
    sh:targetClass va:BodySegment .

vax:CanonicalSignatureCompletenessShape a sh:NodeShape ;
    rdfs:label "v4.6.2: CanonicalSignature with typed properties is complete"@en ;
    sh:message "A CanonicalSignature using v4.6.2 emission must have both signatureString and hasArity (or neither, for legacy)." ;
    sh:or ( [ sh:not [ sh:minCount 1 ;
                        sh:path va:signatureString ],
                    [ sh:minCount 1 ;
                        sh:path va:hasArity ] ] [ sh:property [ sh:minCount 1 ;
                        sh:path va:signatureString ],
                    [ sh:minCount 1 ;
                        sh:path va:hasArity ] ] ) ;
    sh:targetClass va:CanonicalSignature .

vax:CompositionBindingStyleShape a sh:NodeShape ;
    rdfs:label "Composition should declare a binding style"@en ;
    rdfs:comment "v3.1.0 addition: a well-formed CompositionOperator SHOULD declare va:bindingStyle to disambiguate Direct vs Indirect. Missing is an Info-level finding — legacy exports without bindingStyle are tolerated for backward compatibility with v3.0.0 instance graphs."@en ;
    sh:property [ sh:message "CompositionOperator {$this} does not declare va:bindingStyle. Consider adding va:bindingStyle va:DirectBinding or va:IndirectBinding for semantic clarity."@en ;
            sh:minCount 1 ;
            sh:path va:bindingStyle ;
            sh:severity sh:Info ] ;
    sh:targetClass va:CompositionOperator .

vax:CompositionOperandComposabilityShape a sh:NodeShape ;
    rdfs:label "Composition operand must be a ComposableUnit"@en ;
    sh:class va:ComposableUnit ;
    sh:message "Operands of va:hasOperand must be ComposableUnit instances. Methods, Attributes, Parameters, Signatures, Bodies, Literals are NOT composable."@en ;
    sh:targetObjectsOf va:hasOperand .

vax:CompositionOperatorShape a sh:NodeShape ;
    rdfs:label "Composition operator structural shape"@en ;
    sh:property [ sh:message "A CompositionOperator must have at least 2 operands."@en ;
            sh:minCount 2 ;
            sh:path va:hasOperand ],
        [ sh:class va:SuperComponent ;
            sh:maxCount 1 ;
            sh:message "A CompositionOperator must produce exactly one SuperComponent."@en ;
            sh:minCount 1 ;
            sh:path va:produces ] ;
    sh:targetClass va:CompositionOperator .

vax:CompositionWithoutWiringShape a sh:NodeShape ;
    rdfs:label "Direct-binding composition without wirings"@en ;
    rdfs:comment "v3.1.0 update: this warning now fires only when va:bindingStyle is va:DirectBinding. Per thesis §1137 (Bruneton 2002) citing corrected v3.0.3 semantics, compositions with va:IndirectBinding (sub-components coordinated via super-component methods) are fully legitimate without wirings. Only Direct-binding compositions missing their peer wirings are suspicious."@en ;
    sh:sparql [ sh:message "Direct-binding CompositionOperator {$this} has no wirings. Direct binding implies peer-to-peer wiring via Ports; either add wirings or change va:bindingStyle to va:IndirectBinding."@en ;
            sh:prefixes vax: ;
            sh:select """
            PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this a va:CompositionOperator ;
                      va:bindingStyle va:DirectBinding .
                FILTER NOT EXISTS { $this va:hasWiring ?w }
            }
        """ ;
            sh:severity sh:Warning ] ;
    sh:targetClass va:CompositionOperator .

vax:ConfidenceLevelShape a sh:NodeShape ;
    rdfs:label "ConfidenceLevel Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:ConfidenceLevel .

vax:ConfigurationArtifactShape a sh:NodeShape ;
    rdfs:label "ConfigurationArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:ConfigurationArtifact .

vax:ContainedByValueShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:containedBy values must be IRIs"@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "va:containedBy must point to exactly one parent IRI." ;
            sh:nodeKind sh:IRI ;
            sh:path va:containedBy ] ;
    sh:targetSubjectsOf va:containedBy .

vax:ContractOperationShape a sh:NodeShape ;
    rdfs:label "Contract operation shape"@en ;
    sh:property [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:message "ContractOperation requires a va:positionalParamCount."@en ;
            sh:minCount 1 ;
            sh:path va:positionalParamCount ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "ContractOperation requires exactly one non-empty va:operationName."@en ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path va:operationName ] ;
    sh:targetClass va:ContractOperation .

vax:ContractShape a sh:NodeShape ;
    rdfs:label "Contract structural shape"@en ;
    sh:property [ sh:message "Contract must have rdfs:label."@en ;
            sh:minCount 1 ;
            sh:path rdfs:label ] ;
    sh:targetClass va:Contract .

vax:ConvergenceShape a sh:NodeShape ;
    rdfs:label "Convergence Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:reconciliationDescription on Convergence must conform to its declared range."@en ;
            sh:path va:reconciliationDescription ],
        [ sh:class va:Artifact ;
            sh:message "va:involvesArtifact on Convergence must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:involvesArtifact ] ;
    sh:targetClass va:Convergence .

vax:DatabaseSchemaArtifactShape a sh:NodeShape ;
    rdfs:label "DatabaseSchemaArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:DatabaseSchemaArtifact .

vax:DecoratorRoleShape a sh:NodeShape ;
    rdfs:label "DecoratorRole Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:roleName on DecoratorRole must conform to its declared range."@en ;
            sh:path va:roleName ],
        [ sh:datatype xsd:string ;
            sh:message "va:decoratorArgument on DecoratorRole must conform to its declared range."@en ;
            sh:path va:decoratorArgument ] ;
    sh:targetClass va:DecoratorRole .

vax:DependsOnModuleShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:dependsOnModule is non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:dependsOnModule must be a non-empty xsd:string; empty imports indicate analyzer bug." ;
            sh:minLength 1 ;
            sh:path va:dependsOnModule ] ;
    sh:targetSubjectsOf va:dependsOnModule .

vax:DeploymentArtifactShape a sh:NodeShape ;
    rdfs:label "DeploymentArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:DeploymentArtifact .

vax:DesignArtifactShape a sh:NodeShape ;
    rdfs:label "DesignArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:DesignArtifact .

vax:DirectoryRoleShape a sh:NodeShape ;
    rdfs:label "DirectoryRole Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:DirectoryRole .

vax:DivergenceShape a sh:NodeShape ;
    rdfs:label "Divergence Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:reconciliationDescription on Divergence must conform to its declared range."@en ;
            sh:path va:reconciliationDescription ],
        [ sh:class va:Artifact ;
            sh:message "va:involvesArtifact on Divergence must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:involvesArtifact ] ;
    sh:targetClass va:Divergence .

vax:EventBindingShape a sh:NodeShape ;
    rdfs:label "EventBinding Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:eventName on EventBinding must conform to its declared range."@en ;
            sh:path va:eventName ],
        [ sh:class va:SoftwareUnit ;
            sh:message "va:bindingSource on EventBinding must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:bindingSource ],
        [ sh:datatype xsd:string ;
            sh:message "va:bindingFramework on EventBinding must conform to its declared range."@en ;
            sh:path va:bindingFramework ],
        [ sh:class va:Feature ;
            sh:message "va:bindingHandler on EventBinding must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:bindingHandler ] ;
    sh:targetClass va:EventBinding .

vax:FeatureNameValueShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:featureName is a single non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "va:featureName must be a single non-empty xsd:string." ;
            sh:minLength 1 ;
            sh:path va:featureName ] ;
    sh:targetSubjectsOf va:featureName .

vax:GapShape a sh:NodeShape ;
    rdfs:label "Gap Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:class va:Artifact ;
            sh:message "va:involvesArtifact on Gap must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:involvesArtifact ],
        [ sh:datatype xsd:string ;
            sh:message "va:reconciliationDescription on Gap must conform to its declared range."@en ;
            sh:path va:reconciliationDescription ] ;
    sh:targetClass va:Gap .

vax:HasArityShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:hasArity is a single non-negative integer"@en ;
    sh:property [ sh:maxCount 1 ;
            sh:message "va:hasArity must be a single non-negative integer (xsd:integer or xsd:nonNegativeInteger accepted due to pyoxigraph type normalization)." ;
            sh:minInclusive 0 ;
            sh:or ( [ sh:datatype xsd:nonNegativeInteger ] [ sh:datatype xsd:integer ] ) ;
            sh:path va:hasArity ] ;
    sh:targetSubjectsOf va:hasArity .

vax:HasDecoratorShape a sh:NodeShape ;
    rdfs:label "v4.6.2: each va:hasDecorator value is a non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:hasDecorator must be a non-empty xsd:string." ;
            sh:minLength 1 ;
            sh:path va:hasDecorator ] ;
    sh:targetSubjectsOf va:hasDecorator .

vax:HasInitialValueShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:hasInitialValue is a single boolean"@en ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "va:hasInitialValue must be a single xsd:boolean." ;
            sh:path va:hasInitialValue ] ;
    sh:targetSubjectsOf va:hasInitialValue .

vax:HasKwargsShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:hasKwargs is a single boolean"@en ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "va:hasKwargs must be a single xsd:boolean." ;
            sh:path va:hasKwargs ] ;
    sh:targetSubjectsOf va:hasKwargs .

vax:HasKwonlyShape a sh:NodeShape ;
    rdfs:label "v4.6.2: each va:hasKwonly value is a non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:hasKwonly parameter name must be a non-empty xsd:string." ;
            sh:minLength 1 ;
            sh:path va:hasKwonly ] ;
    sh:targetSubjectsOf va:hasKwonly .

vax:HasTypeAnnotationShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:hasTypeAnnotation is a single string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "va:hasTypeAnnotation must be a single xsd:string." ;
            sh:path va:hasTypeAnnotation ] ;
    sh:targetSubjectsOf va:hasTypeAnnotation .

vax:HasVarargsShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:hasVarargs is a single boolean"@en ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "va:hasVarargs must be a single xsd:boolean." ;
            sh:path va:hasVarargs ] ;
    sh:targetSubjectsOf va:hasVarargs .

vax:InheritsFromNameShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:inheritsFromName is non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:inheritsFromName must be a non-empty xsd:string." ;
            sh:minLength 1 ;
            sh:path va:inheritsFromName ] ;
    sh:targetSubjectsOf va:inheritsFromName .

vax:IntersectionOperatorShape a sh:NodeShape ;
    rdfs:label "IntersectionOperator Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:IntersectionOperator .

vax:IsAsyncShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:isAsync is a single boolean"@en ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "va:isAsync must be a single xsd:boolean." ;
            sh:path va:isAsync ] ;
    sh:targetSubjectsOf va:isAsync .

vax:LifecyclePhaseShape a sh:NodeShape ;
    rdfs:label "LifecyclePhase Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:LifecyclePhase .

vax:NameTermShape a sh:NodeShape ;
    rdfs:label "NameTerm Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:NameTerm .

vax:NamingPatternShape a sh:NodeShape ;
    rdfs:label "NamingPattern Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:NamingPattern .

vax:OperationalMetadataArtifactShape a sh:NodeShape ;
    rdfs:label "OperationalMetadataArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:OperationalMetadataArtifact .

vax:OperatorApplicationPatchedShape a sh:NodeShape ;
    rdfs:label "OperatorApplication validity (v4.6.1)"@en ;
    dcterms:source "v4.6.1 patch."@en ;
    rdfs:comment "Supersedes v4.6.0 OperatorApplicationShape. Uses applicationOperand."@en ;
    sh:property [ sh:class va:Operator ;
            sh:maxCount 1 ;
            sh:message "Every OperatorApplication must reference exactly one va:Operator via va:hasOperator."@en ;
            sh:minCount 1 ;
            sh:path va:hasOperator ],
        [ sh:message "Every OperatorApplication must have at least one operand via va:applicationOperand."@en ;
            sh:minCount 1 ;
            sh:path va:applicationOperand ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Every OperatorApplication must declare its applicationLevel."@en ;
            sh:minCount 1 ;
            sh:path va:applicationLevel ] ;
    sh:targetClass va:OperatorApplication .

vax:OperatorApplicationShape a sh:NodeShape ;
    rdfs:label "OperatorApplication Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:applicationRationale on OperatorApplication must conform to its declared range."@en ;
            sh:path va:applicationRationale ],
        [ sh:class va:Variant ;
            sh:message "va:applicationResult on OperatorApplication must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:applicationResult ],
        [ sh:datatype xsd:string ;
            sh:message "va:applicationLevel on OperatorApplication must conform to its declared range."@en ;
            sh:path va:applicationLevel ] ;
    sh:targetClass va:OperatorApplication .

vax:OperatorShape a sh:NodeShape ;
    rdfs:label "Operator metadata shape"@en ;
    sh:deactivated true ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path va:operatorSymbol ],
        [ sh:datatype xsd:nonNegativeInteger ;
            sh:maxCount 1 ;
            sh:path va:operatorPrecedence ] ;
    sh:targetClass va:Operator .

vax:PortShape a sh:NodeShape ;
    rdfs:label "Port structural shape"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Every Port must have exactly one non-empty va:portName."@en ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path va:portName ],
        [ sh:in ( "provided" "required" ) ;
            sh:maxCount 1 ;
            sh:message "va:portDirection must be exactly one of 'provided' or 'required'."@en ;
            sh:minCount 1 ;
            sh:path va:portDirection ],
        [ sh:class va:Contract ;
            sh:maxCount 1 ;
            sh:message "Every Port must reference exactly one va:Contract."@en ;
            sh:minCount 1 ;
            sh:path va:referencesContract ] ;
    sh:targetClass va:Port .

vax:ProbabilisticCalculusShape a sh:NodeShape ;
    rdfs:label "ProbabilisticCalculus Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:ProbabilisticCalculus .

vax:ProcessArtifactShape a sh:NodeShape ;
    rdfs:label "ProcessArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:ProcessArtifact .

vax:ProtocolShape a sh:NodeShape ;
    rdfs:label "Protocol Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:protocolName on Protocol must conform to its declared range."@en ;
            sh:path va:protocolName ],
        [ sh:class va:CanonicalSignature ;
            sh:message "va:requiresFeatureSignature on Protocol must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:requiresFeatureSignature ] ;
    sh:targetClass va:Protocol .

vax:RequirementsArtifactShape a sh:NodeShape ;
    rdfs:label "RequirementsArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:RequirementsArtifact .

vax:SideEffectClassShape a sh:NodeShape ;
    rdfs:label "SideEffectClass Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:SideEffectClass .

vax:SignatureStringShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:signatureString is a single non-empty string"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "va:signatureString must be a single non-empty xsd:string." ;
            sh:minLength 1 ;
            sh:path va:signatureString ] ;
    sh:targetSubjectsOf va:signatureString .

vax:SourceCodeArtifactShape a sh:NodeShape ;
    rdfs:label "SourceCodeArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:targetClass va:SourceCodeArtifact .

vax:TestArtifactShape a sh:NodeShape ;
    rdfs:label "TestArtifact Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:testFrameworkUsed on TestArtifact must conform to its declared range."@en ;
            sh:path va:testFrameworkUsed ],
        [ sh:class va:SoftwareUnit ;
            sh:message "va:testsUnit on TestArtifact must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:testsUnit ] ;
    sh:targetClass va:TestArtifact .

vax:TypeReferenceShape a sh:NodeShape ;
    rdfs:label "TypeReference Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:message "va:typeName on TypeReference must conform to its declared range."@en ;
            sh:path va:typeName ],
        [ sh:class va:TypeReference ;
            sh:message "va:hasTypeParameter on TypeReference must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:hasTypeParameter ] ;
    sh:targetClass va:TypeReference .

vax:UnitKindValueShape a sh:NodeShape ;
    rdfs:label "v4.6.2: va:unitKind values constrained to the known enumeration"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:in ( "module" "class" "method" "function" "nested_class" "nested_function" "package" "attribute" "parameter" ) ;
            sh:maxCount 1 ;
            sh:message "va:unitKind must be a single xsd:string from the v4.6.2 enumeration." ;
            sh:path va:unitKind ] ;
    sh:targetSubjectsOf va:unitKind .

vax:ValueDomainShape a sh:NodeShape ;
    rdfs:label "ValueDomain Shape"@en ;
    dcterms:source "PBI-015 programmatic shape generation from v3.2.0 ontology"@en ;
    sh:property [ sh:class va:Feature ;
            sh:message "va:hasDomainMember on ValueDomain must conform to its declared range."@en ;
            sh:nodeKind sh:IRI ;
            sh:path va:hasDomainMember ] ;
    sh:targetClass va:ValueDomain .

vax:WiringContractMatchShape a sh:NodeShape ;
    rdfs:label "Wiring endpoints must reference the same Contract"@en ;
    sh:sparql [ sh:message "Wiring {$this}: fromPort and toPort reference different contracts. Wiring is only valid when both ports reference the same va:Contract."@en ;
            sh:prefixes vax: ;
            sh:select """
            PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:fromPort ?fp .
                $this va:toPort ?tp .
                ?fp va:referencesContract ?c1 .
                ?tp va:referencesContract ?c2 .
                FILTER (?c1 != ?c2)
            }
        """ ] ;
    sh:targetClass va:Wiring .

vax:WiringDirectionShape a sh:NodeShape ;
    rdfs:label "Wiring direction follows UML ball-and-socket"@en ;
    sh:sparql [ sh:message "Wiring {$this}: UML convention requires fromPort='provided' and toPort='required'."@en ;
            sh:prefixes vax: ;
            sh:select """
            PREFIX va: <http://example.org/variant-algebra#>
            SELECT $this WHERE {
                $this va:fromPort ?fp .
                $this va:toPort ?tp .
                ?fp va:portDirection ?fd .
                ?tp va:portDirection ?td .
                FILTER (?fd != 'provided' || ?td != 'required')
            }
        """ ] ;
    sh:targetClass va:Wiring .

vax:WiringShape a sh:NodeShape ;
    rdfs:label "Wiring structural shape"@en ;
    sh:property [ sh:class va:Port ;
            sh:maxCount 1 ;
            sh:message "Wiring must have exactly one va:fromPort of type va:Port."@en ;
            sh:minCount 1 ;
            sh:path va:fromPort ],
        [ sh:class va:Port ;
            sh:maxCount 1 ;
            sh:message "Wiring must have exactly one va:toPort of type va:Port."@en ;
            sh:minCount 1 ;
            sh:path va:toPort ] ;
    sh:targetClass va:Wiring .

# ==== file variant_algebra_substitution_check_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- Substitution Check SHACL-AF Rules v1.0.0 (VAF-WI-116d, 2026-09-28)
# Policy A4 for every substitution (owner decisions, 2026-09-25): the variants before, rewritten as the substitution
# rewrites them ("mapped"), are compared with the variants after --
#   refactoring (equal) | specialization (variants lost) | generalization (gained) | arbitrary (both);
# anomalies on the result -- a void model, a dead feature (still declared, in no variant), a false optional feature
# (declared optional, in every variant); severity -- void or dead: error; lost variants: warning; else information.
# The three sets of variants are computed by the operator rules (VAF-WI-113); until 2026-09-28 the comparison and the
# policy were Python (variant_substitution_v1_0_0.py). Input: one va:CheckedVariant per distinct variant, tagged with
# its role (va:checkRole "before" | "after" | "mapped") and its (feature, count) assignments; the result's declared and
# optional features (va:checkDeclares, va:checkOptional) and the substitution's targets (va:checkMappedTo).
# ============================================================

<http://example.org/vaf-consolidated/substitution-check-rules>
    rdfs:label "VAF Substitution Check SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-09-28"^^xsd:date ;
    dcterms:identifier "variant_algebra_substitution_check_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/substitution-check-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:VariantMatchRuleShape a sh:NodeShape ; sh:targetClass va:CheckedVariant ;
    rdfs:comment "Two variants are the same when they give every feature the same count (a feature not assigned counts 0)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:sameVariantAs ?y }
        WHERE { $this a va:CheckedVariant ; va:checkRole ?r1 . ?y a va:CheckedVariant ; va:checkRole ?r2 . FILTER(?r1 != ?r2)
                FILTER NOT EXISTS { $this va:checkAssigns ?a . ?a va:checkFeature ?f ; va:checkCount ?n .
                                    FILTER NOT EXISTS { ?y va:checkAssigns ?b . ?b va:checkFeature ?f ; va:checkCount ?n } }
                FILTER NOT EXISTS { ?y va:checkAssigns ?b2 . ?b2 va:checkFeature ?f2 ; va:checkCount ?n2 .
                                    FILTER NOT EXISTS { $this va:checkAssigns ?a2 . ?a2 va:checkFeature ?f2 ; va:checkCount ?n2 } } }""" ] .

va:SubstitutionEditRuleShape a sh:NodeShape ; sh:targetClass va:SubstitutionCheck ;
    rdfs:comment "A mapped variant with no equal after is lost; a variant after with no equal among the mapped is gained. The edit: refactoring (neither), specialization (lost only), generalization (gained only), arbitrary (both)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:lostVariant ?v }
        WHERE { $this a va:SubstitutionCheck . ?v va:checkRole "mapped" . FILTER NOT EXISTS { ?v va:sameVariantAs ?w . ?w va:checkRole "after" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:gainedVariant ?v }
        WHERE { $this a va:SubstitutionCheck . ?v va:checkRole "after" . FILTER NOT EXISTS { ?v va:sameVariantAs ?w . ?w va:checkRole "mapped" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:substitutionEdit ?e }
        WHERE { $this a va:SubstitutionCheck .
                BIND(EXISTS { $this va:lostVariant ?l } AS ?lost) BIND(EXISTS { $this va:gainedVariant ?g } AS ?gained)
                BIND(IF(!?lost && !?gained, "refactoring", IF(?lost && !?gained, "specialization", IF(?gained && !?lost, "generalization", "arbitrary"))) AS ?e) }""" ] .

va:SubstitutionAnomalyRuleShape a sh:NodeShape ; sh:targetClass va:SubstitutionCheck ;
    rdfs:comment "Anomalies on the result: void (variants before, none after); a dead feature (declared, in no variant after, and present in a mapped variant or a substitution's target); a false optional feature (declared optional, in every variant after)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:voidModel true }
        WHERE { $this a va:SubstitutionCheck . FILTER EXISTS { ?b va:checkRole "before" } FILTER NOT EXISTS { ?a va:checkRole "after" } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:deadFeature ?f }
        WHERE { $this a va:SubstitutionCheck ; va:checkDeclares ?f .
                FILTER NOT EXISTS { ?a va:checkRole "after" ; va:checkAssigns ?x . ?x va:checkFeature ?f ; va:checkCount ?n . FILTER(?n > 0) }
                FILTER (EXISTS { ?m va:checkRole "mapped" ; va:checkAssigns ?y . ?y va:checkFeature ?f ; va:checkCount ?k . FILTER(?k > 0) }
                        || EXISTS { $this va:checkMappedTo ?f }) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:falseOptionalFeature ?f }
        WHERE { $this a va:SubstitutionCheck ; va:checkOptional ?f . FILTER EXISTS { ?a0 va:checkRole "after" }
                FILTER NOT EXISTS { ?a va:checkRole "after" .
                                    FILTER NOT EXISTS { ?a va:checkAssigns ?x . ?x va:checkFeature ?f ; va:checkCount ?n . FILTER(?n > 0) } } }""" ] .

va:SubstitutionSeverityRuleShape a sh:NodeShape ; sh:targetClass va:SubstitutionCheck ;
    rdfs:comment "Severity: error when the result is void or has a dead feature (nothing is applied); warning when variants are lost (specialization, arbitrary); information otherwise."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/substitution-check-rules> ; sh:construct """
        CONSTRUCT { $this va:checkSeverity ?s }
        WHERE { $this a va:SubstitutionCheck ; va:substitutionEdit ?e .
                BIND(IF(EXISTS { $this va:voidModel true } || EXISTS { $this va:deadFeature ?d }, "error",
                        IF(?e IN ("specialization", "arbitrary"), "warning", "information")) AS ?s) }""" ] .

# ==== file variant_algebra_temporal_detection_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix py:      <http://example.org/py#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Temporal Order calculus (C33) — SHACL-AF rules, v1.1.0
#
# Note: predicate alternatives use FILTER (?p IN (...)), not VALUES -- rdflib does not join a VALUES block
# placed after a variable-predicate pattern inside a group, so it silently matches nothing.
# v1.1.0 (2026-09-24, standard-library test-drive): the guard family now covers what real code does --
# raise OR early-return exits; equal, not-equal, in, not-in; several exclusions in one method applied
# together; and moves made inside 'if self.state == V' branches (py:setsToWhen), which need no guard.
#
# Harvested, purely structural inputs:
#   allow-guards   py:raisesIfNotEqual py:raisesIfNotIn py:exitsIfNotEqual py:exitsIfNotIn   "attr:v[,v]"  (only these values may pass)
#   block-guards   py:raisesIfEqual py:raisesIfIn py:exitsIfEqual py:exitsIfIn               "attr:v[,v]"  (these values may not pass)
#   effects        py:setsTo "attr:W" ; py:setsToWhen "attr:V>W" ; py:initiallySets "attr:V"
# A field is a STATE FIELD only when some guard or branch move tests it. Static analysis only.
# ============================================================

<http://example.org/vaf-consolidated/temporal-detection-rules>
    owl:versionInfo "1.5.0" ;
    rdfs:comment "1.5.0 (VAF-WI-077, 2026-09-29): rules 1-5 and 7 rewired from py: guard/effect/event facts to their va: counterparts, now that harvester_python_v1_0_0.py and event_harvester_v1_0_0.py emit them -- va is the canonical discovery vocabulary (owner decision, 2026-09-24). Rule 6 (C33StepNextRuleShape) deliberately kept on py:edgeFrom/edgeTo/edgeKind (control_flow_harvester_v1_0_0.py): a full control-flow-graph serialization, architecturally the same category as the semantic-marker rules' AST-structure reads, deferred to a later pass."@en ;
    dcterms:title "Variant Algebra — Temporal Order calculus (C33) SHACL-AF rules"@en .

# 1. Branch move -> Next: inside 'if self.a == V', the method sets a to W.
va:C33BranchMoveRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setsAttributeToWhen ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesStateMove ?m }
        WHERE { $this va:setsAttributeToWhen ?m }
    """ ] .

# 2. Guarded move -> Next: an unconditional effect W, reachable from every known value that the method's
#    allow-guards admit (if any) and that none of its block-guards exclude.
va:C33GuardedMoveRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setsAttributeTo ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesStateMove ?move }
        WHERE {
            $this va:setsAttributeTo ?e .
            BIND (STRBEFORE(?e, ":") AS ?a) BIND (STRAFTER(?e, ":") AS ?w)
            # the method is guarded on this field (otherwise rule 3 applies)
            $this ?gp ?g . FILTER (?gp IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn, va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn))
            FILTER (STRBEFORE(?g, ":") = ?a)
            # not a move already made inside a branch
            FILTER NOT EXISTS { $this va:setsAttributeToWhen ?bw . FILTER (STRBEFORE(?bw, ":") = ?a && STRAFTER(?bw, ">") = ?w) }
            { ?any va:setsAttributeTo ?k } UNION { ?any va:initiallySetsAttribute ?k } UNION { ?any va:setsAttributeToWhen ?kk . BIND (CONCAT(STRBEFORE(?kk, ":"), ":", STRBEFORE(STRAFTER(?kk, ":"), ">")) AS ?k) }
            FILTER (STRBEFORE(?k, ":") = ?a)
            BIND (STRAFTER(?k, ":") AS ?x)
            FILTER (?x != ?w)
            FILTER NOT EXISTS { $this ?bp ?b . FILTER (?bp IN (va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn))
                                FILTER (STRBEFORE(?b, ":") = ?a && CONTAINS(CONCAT(",", STRAFTER(?b, ":"), ","), CONCAT(",", ?x, ","))) }
            FILTER NOT EXISTS { $this ?ap ?al . FILTER (?ap IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn))
                                FILTER (STRBEFORE(?al, ":") = ?a && !CONTAINS(CONCAT(",", STRAFTER(?al, ":"), ","), CONCAT(",", ?x, ","))) }
            BIND (CONCAT(?a, ":", ?x, ">", ?w) AS ?move)
        }
    """ ] .

# 3. Unguarded move -> Next from every known value, flagged: the method sets a state field without checking it.
va:C33UnguardedMoveRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setsAttributeTo ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesStateMove ?move . $this va:proposesUnguardedMove ?e }
        WHERE {
            $this va:setsAttributeTo ?e .
            BIND (STRBEFORE(?e, ":") AS ?a) BIND (STRAFTER(?e, ":") AS ?w)
            FILTER EXISTS { ?t ?tp ?tg . FILTER (?tp IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn, va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn, va:setsAttributeToWhen)) FILTER (STRBEFORE(?tg, ":") = ?a) }
            FILTER NOT EXISTS { $this ?op ?own . FILTER (?op IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn, va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn))
                                FILTER (STRBEFORE(?own, ":") = ?a) }
            FILTER NOT EXISTS { $this va:setsAttributeToWhen ?bw . FILTER (STRBEFORE(?bw, ":") = ?a && STRAFTER(?bw, ">") = ?w) }
            { ?any va:setsAttributeTo ?k } UNION { ?any va:initiallySetsAttribute ?k }
            FILTER (STRBEFORE(?k, ":") = ?a)
            BIND (STRAFTER(?k, ":") AS ?x)
            FILTER (?x != ?w)
            BIND (CONCAT(?a, ":", ?x, ">", ?w) AS ?move)
        }
    """ ] .

# 4. Hand-off -> Sequence: m1 sets V; m2 admits only V, or moves out of V in a branch -> m1 comes before m2.
va:C33HandoffSequenceRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setsAttributeTo ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesSequenceBefore ?m2 }
        WHERE {
            $this va:setsAttributeTo ?f .
            { ?m2 ?gp ?f . FILTER (?gp IN (va:raisesIfAttributeNotEqual, va:exitsIfAttributeNotEqual)) }
            UNION { ?m2 va:setsAttributeToWhen ?bw . BIND (CONCAT(STRBEFORE(?bw, ":"), ":", STRBEFORE(STRAFTER(?bw, ":"), ">")) AS ?from) }
            FILTER (COALESCE(?from, ?f) = ?f)
            FILTER ($this != ?m2)
        }
    """ ] .

# 5. Initial state: creation sets a state field to V.
va:C33InitialStateRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:initiallySetsAttribute ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesInitialState ?f }
        WHERE {
            $this va:initiallySetsAttribute ?f .
            FILTER EXISTS { ?t ?tp ?tg . FILTER (?tp IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn, va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn, va:setsAttributeToWhen)) FILTER (STRBEFORE(?tg, ":") = STRBEFORE(?f, ":")) }
        }
    """ ] .

# 6. Step order -> Next (v1.2.0): every control-flow edge between steps (control_flow_harvester) is a Next
#    fact; the edge kind (step, branch, loop-enter, loop-repeat = ITERATION, loop-leave, exit, suspend, resume,
#    delegate, handler) is kept. Steps are DESCRIPTORS (a loop cycles), so the edge is va:mayBeImmediatelyFollowedBy;
#    reachability over it answers 'may b follow a'. Strict order belongs to occurrences of steps at run time.
va:C33StepNextRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf py:edgeFrom ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        PREFIX py: <http://example.org/py#>
        CONSTRUCT { ?a va:mayBeImmediatelyFollowedBy ?b . $this va:proposesStepNext ?k }
        WHERE { $this py:edgeFrom ?a ; py:edgeTo ?b ; py:edgeKind ?k }
    """ ] .

# 7. Events (v1.3.0), from event_harvester: a stored function F-handler runs after it was registered, during a
#    dispatch from F, possibly immediately on registration, and after any state the dispatching caller set first.
va:C33EventRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:dispatchesHandlersFrom ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { ?reg va:proposesRegistrationBefore ?f . $this va:proposesDispatchOf ?f }
        WHERE { $this va:dispatchesHandlersFrom ?f . ?reg va:registersHandlerInto ?f }
    """ ] .
va:C33ImmediateFiringRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:firesImmediately ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesImmediateFiring ?f }
        WHERE { $this va:firesImmediately ?f }
    """ ] .
va:C33StateBeforeEventRuleShape a sh:NodeShape ;
    sh:targetSubjectsOf va:setsBeforeCall ;
    sh:rule [ a sh:SPARQLRule ; sh:construct """
        PREFIX va: <http://example.org/variant-algebra#>
        CONSTRUCT { $this va:proposesStateBeforeEvent ?se }
        WHERE {
            $this va:setsBeforeCall ?sb .
            ?d va:dispatchesHandlersFrom ?f .
            FILTER (STRAFTER(?sb, "|") = REPLACE(STR(?d), "^.*[.]", ""))
            FILTER EXISTS { ?t ?tp ?tg . FILTER (?tp IN (va:raisesIfAttributeNotEqual, va:raisesIfAttributeNotIn, va:exitsIfAttributeNotEqual, va:exitsIfAttributeNotIn, va:raisesIfAttributeEqual, va:raisesIfAttributeIn, va:exitsIfAttributeEqual, va:exitsIfAttributeIn, va:setsAttributeToWhen))
                            FILTER (STRBEFORE(?tg, ":") = STRBEFORE(?sb, ":")) }
            BIND (CONCAT(STRBEFORE(?sb, "|"), ">", ?f) AS ?se)
        }
    """ ] .

# ==== file variant_algebra_temporal_occurrence_shapes_v1_1_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Temporal occurrence shapes v1.1.0 (VAF-WI-230: a conditioned edge licenses by the state of the source occurrence) -- strictness lives on OCCURRENCES, never on descriptors.
# Descriptor edges (va:mayBeFollowedBy, va:mayBeImmediatelyFollowedBy) may cycle freely; nothing here targets them.
# ============================================================

<http://example.org/vaf-consolidated/temporal-occurrence-shapes>
    owl:versionInfo "1.1.0" ;
    dcterms:title "Variant Algebra — temporal occurrence shapes"@en .

va:OccurrenceShape a sh:NodeShape ;
    sh:targetClass va:Occurrence ;
    sh:property [ sh:path va:occurrenceOf ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An occurrence activates exactly one descriptor." ] ;
    sh:property [ sh:path va:occurrenceIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ;
        sh:message "An occurrence carries exactly one logical time stamp (its index in the trace)." ] ;
    sh:property [ sh:path va:inTrace ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An occurrence belongs to exactly one trace." ] ;
    # 1. strict: no occurrence precedes itself, directly or through a chain
    sh:sparql [ sh:message "Strictness: this occurrence precedes itself." ; sh:select """
        PREFIX core: <http://example.org/core#> PREFIX va: <http://example.org/variant-algebra#>
        SELECT $this WHERE { $this (core:precedes|va:immediatelyPrecedes)+ $this }""" ] ;
    # 2. the order agrees with time: logical index, and clock time when recorded
    sh:sparql [ sh:message "Time: this occurrence precedes one with an equal or earlier time stamp." ; sh:select """
        PREFIX core: <http://example.org/core#> PREFIX va: <http://example.org/variant-algebra#> PREFIX prov: <http://www.w3.org/ns/prov#>
        SELECT $this WHERE {
            $this (core:precedes|va:immediatelyPrecedes) ?o .
            { $this va:occurrenceIndex ?i . ?o va:occurrenceIndex ?j . FILTER (?i >= ?j) }
            UNION { $this prov:startedAtTime ?t . ?o prov:startedAtTime ?u . FILTER (?t > ?u) } }""" ] ;
    # 3. immediacy: nothing lies between an immediately-preceding pair
    sh:sparql [ sh:message "Immediacy: an occurrence lies between this one and the one it immediately precedes." ; sh:select """
        PREFIX va: <http://example.org/variant-algebra#>
        SELECT $this WHERE {
            $this va:immediatelyPrecedes ?b ; va:inTrace ?t ; va:occurrenceIndex ?i .
            ?b va:occurrenceIndex ?j .
            ?c va:inTrace ?t ; va:occurrenceIndex ?k .
            FILTER (?k > ?i && ?k < ?j) }""" ] ;
    # 4. licensing: an immediate succession needs a descriptor edge between what the occurrences activate; an edge with a
    #    condition licenses it only where the condition holds in the state of the source occurrence (va:edgeHolds)
    sh:sparql [ sh:message "Licensing: no descriptor edge allows this occurrence to be immediately followed by the next." ; sh:select """
        PREFIX va: <http://example.org/variant-algebra#>
        SELECT $this WHERE {
            $this va:immediatelyPrecedes ?b ; va:occurrenceOf ?da . ?b va:occurrenceOf ?db .
            FILTER NOT EXISTS { ?da va:mayBeImmediatelyFollowedBy ?db }
            FILTER NOT EXISTS { ?e a va:DescriptorEdge ; va:edgeFrom ?da ; va:edgeTo ?db ; va:edgeOperator va:NextOperator } }""" ] ;
    sh:sparql [ sh:message "Licensing: the only edge that allows this succession has a condition that does not hold in the state of this occurrence, or no state is recorded for it." ; sh:select """
        PREFIX va: <http://example.org/variant-algebra#>
        SELECT $this WHERE {
            $this va:immediatelyPrecedes ?b ; va:occurrenceOf ?da . ?b va:occurrenceOf ?db .
            FILTER NOT EXISTS { ?da va:mayBeImmediatelyFollowedBy ?db }
            ?e a va:DescriptorEdge ; va:edgeFrom ?da ; va:edgeTo ?db ; va:edgeOperator va:NextOperator .
            FILTER NOT EXISTS { ?e2 a va:DescriptorEdge ; va:edgeFrom ?da ; va:edgeTo ?db ; va:edgeOperator va:NextOperator . FILTER NOT EXISTS { ?e2 va:edgeCondition ?c2 } }
            FILTER NOT EXISTS { ?e3 a va:DescriptorEdge ; va:edgeFrom ?da ; va:edgeTo ?db ; va:edgeOperator va:NextOperator . $this va:edgeHolds ?e3 } }""" ] ;
    # 5. distinct: two activations of one descriptor in one trace are two occurrences with different time stamps
    sh:sparql [ sh:message "Distinctness: another occurrence of the same descriptor in the same trace has the same time stamp." ; sh:select """
        PREFIX va: <http://example.org/variant-algebra#>
        SELECT $this WHERE {
            $this va:occurrenceOf ?d ; va:inTrace ?t ; va:occurrenceIndex ?i .
            ?o va:occurrenceOf ?d ; va:inTrace ?t ; va:occurrenceIndex ?i . FILTER (?o != $this) }""" ] .

# ==== file variant_algebra_thesis_reconciliation_shacl_v1_1_0.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Variant Algebra -- reconciliation with the thesis, shapes v1.1.0 (2026-09-28, VAF-WI-102, -112, -120).
# Each shape is shown to fail on a known-bad input by 06-runtime/src/test_thesis_reconciliation_v1_0_0.py (L-95).
# Data graph: the reconciliation file, the thesis laws data, the core ontology and the owner decisions.

<http://example.org/variant-algebra/thesis-reconciliation-shapes>
    owl:versionInfo "1.1.0" ; owl:versionIRI <http://example.org/variant-algebra/thesis-reconciliation-shapes/1.1.0> ;
    owl:priorVersion <http://example.org/variant-algebra/thesis-reconciliation-shapes/1.0.3> ;
    rdfs:comment "1.1.0 (VAF-WI-120): a thesis law that fails under the operator rules is a departure from the thesis, so it needs a divergence record with its reason (va:FailingLawRecordedShape)."@en ;
    rdfs:comment "1.0.3 (VAF-WI-112): the laws are now measured under the operator rules (the generative reading evaluates definitions by them), so a tag is refused when its law fails under the rules; the feature-model reading built classifier bodies and evaluates none."@en ;
    rdfs:comment "1.0.2 (VAF-WI-107): 1.0.1 followed the Python definitions evaluator alone, taking it for the semantics; the semantics is the ontology's operator rules (va:Decision_OwnerClarification_2026_09_28). Until the laws are measured under those rules (VAF-WI-100), a tag is refused only when both existing implementations contradict it."@en ;
    rdfs:comment "1.0.1 (VAF-WI-105): the tag check follows the generative reading alone, the language's semantics by the owner's ruling of 2026-09-27; it no longer waits for both readings to fail."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    rdfs:label "Variant Algebra -- reconciliation with the thesis (shapes)"@en .

va:DivergenceRecordShape a sh:NodeShape ;
    rdfs:label "A divergence says what differs, where, and what was done"@en ;
    sh:targetClass va:ThesisDivergence ;
    sh:property [ sh:path va:surveyItem ; sh:minCount 1 ; sh:maxCount 1 ; sh:message "A divergence names its item in the comparison." ] ;
    sh:property [ sh:path va:baselineKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:DivergenceKind ; sh:message "A divergence has one baseline kind." ] ;
    sh:property [ sh:path va:hasDisposition ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:Disposition ; sh:message "A divergence has exactly one disposition." ] ;
    sh:property [ sh:path va:ontologyLocation ; sh:minCount 1 ; sh:message "A divergence says where the ontology stands." ] ;
    sh:property [ sh:path va:thesisLocation ; sh:minCount 1 ; sh:message "A divergence says where the thesis stands ('none' when the thesis is silent)." ] ;
    sh:property [ sh:path va:dispositionReason ; sh:minCount 1 ; sh:message "A divergence states the reason for its disposition. The owner: the thesis is the original but not the authoritative resource -- every departure carries its reason." ] .

va:ResolvedDivergenceShape a sh:NodeShape ;
    rdfs:label "A divergence corrected or captured names the file that now states it"@en ;
    sh:targetClass va:ThesisDivergence ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This divergence is marked corrected or captured but names no file that now states it." ;
        sh:select """SELECT $this WHERE { $this va:hasDisposition ?d . FILTER (?d IN (va:Disp_CorrectedInOntology, va:Disp_Captured))
                     FILTER NOT EXISTS { $this va:resolvedIn ?f } }""" ] .

va:PutToOwnerShape a sh:NodeShape ;
    rdfs:label "A divergence put to the owner points at a pending decision"@en ;
    sh:targetClass va:ThesisDivergence ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This divergence is put to the owner but awaits no pending owner decision. Either name the decision, or -- if the decision was given -- record the disposition it produced." ;
        sh:select """SELECT $this WHERE { $this va:hasDisposition va:Disp_PutToOwner .
                     FILTER NOT EXISTS { $this va:awaitsDecision ?q . ?q va:decisionStatus ?st . FILTER (STRSTARTS(STR(?st), "pending")) } }""" ] .

va:ThesisLawShape a sh:NodeShape ;
    rdfs:label "A thesis law is measured under both readings"@en ;
    sh:targetClass va:ThesisLaw ;
    sh:property [ sh:path va:lawKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class va:LawKind ; sh:message "A law has one kind." ] ;
    sh:property [ sh:path va:lawOperator ; sh:minCount 1 ; sh:message "A law names its operators." ] ;
    sh:property [ sh:path va:generativeReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "holds" "fails" "not evaluable" ) ; sh:message "A law records one result under the generative reading." ] ;
    sh:property [ sh:path va:featureModelReading ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "holds" "fails" "not evaluable" ) ; sh:message "A law records one result under the feature-model reading." ] ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This law fails under a reading but records no counterexample." ;
        sh:select """SELECT $this WHERE { { $this va:generativeReading "fails" } UNION { $this va:featureModelReading "fails" }
                     FILTER NOT EXISTS { $this va:counterexample ?c } }""" ] .

va:TagMatchesMeasurementShape a sh:NodeShape ;
    rdfs:label "An operator's property tag is not contradicted by measurement"@en ;
    sh:targetSubjectsOf va:hasAlgebraicProperty ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This operator carries an algebraic-property tag whose law, measured on this operator alone, fails under the operator rules. The ontology is the authority: a tag states what holds here, not what the thesis wrote." ;
        sh:select """SELECT $this ?value WHERE { $this va:hasAlgebraicProperty ?value .
                     ?law va:lawKind ?k ; va:lawOperator $this ; va:generativeReading "fails" .
                     ?k va:tagValue ?value .
                     FILTER NOT EXISTS { ?law va:lawOperator ?other . FILTER (?other != $this) } }""" ] .

va:FailingLawRecordedShape a sh:NodeShape ;
    rdfs:label "A thesis law that fails under the operator rules is recorded as a departure, with its reason"@en ;
    sh:targetClass va:ThesisLaw ;
    sh:sparql [ a sh:SPARQLConstraint ; sh:prefixes va: ;
        sh:message "This thesis law fails under the operator rules, and no divergence record says why. Every point where the ontology departs from the thesis is recorded with its reason." ;
        sh:select """SELECT $this WHERE { $this va:generativeReading "fails" .
                     FILTER NOT EXISTS { ?d a va:ThesisDivergence ; va:departureForLaw $this ; va:dispositionReason ?r } }""" ] .

va: sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

# ==== file variant_algebra_usefulness_rules_v1_0_0.ttl ====
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ============================================================
# Variant Algebra -- useless variants, v1.0.0 (VAF-WI-136, 2026-10-04)
# The owner (2026-10-04) ruled what a useless variant of a class is: "A single attribute is useless. A method doing no
# processing is useless. A class with unrelated attributes and methods is useless, a class with no semantics and no
# behaviour at all is useless." plus: research similar cases. This file decides, over the facts the program's dependence
# model yields, WHICH of those a variant is (va:Decision_NoDecisionsInCode_2026_09_28); Python harvests the facts and
# reads the reasons back. No variant is deleted: each carries its reasons, and the page shows the useful ones first.
#
# Reasons, with where each comes from:
#   owner  -- no members at all; no behaviour (no method that processes anything; a single attribute is the smallest case);
#             unrelated members (members that do not connect through use); no semantics (no state value, no exception,
#             no method that does more than get/set/is/has an attribute).
#   code-smell catalogue (Fowler, Data Class, Middle Man) -- an accessor-only class is a data class (covered by no
#             semantics); a class whose methods only pass calls on to another class is a middle man (only delegates).
#   feature-model analysis (dead features, false-optional features) -- about the whole model, not one variant; decided in
#             variant_algebra_feature_model_rules_v1_0_0.ttl.
# Not adopted, because each needs a threshold the owner has not set (a stipulation, L-116): "lazy class" (too small to
# justify itself), "large class".
#
# Input facts (shared by every variant of the class):
#   va:UvAtom a member: va:uvName, va:uvKind (method, attribute, state value, exception), va:uvIndex (its position);
#   va:uvLink a b (a and b are related by use: a method and the attribute it reads or writes, a state value and its
#   attribute, a method and the exception it raises, a method and the method it calls), va:uvUses m x (method m uses
#   same-class member x), va:uvDelegates m (method m calls into another class).
# Per variant: va:UvVariant with va:uvHas atom (one per selected member).
# Output facts: va:uvReason (a plain sentence), va:uvUseful true (no reason). Variants are independent of each other, so they
# are judged in batches (the joins grow with the number of variants in one store).
# ============================================================

<http://example.org/vaf-consolidated/usefulness-rules>
    rdfs:label "VAF Useless-Variant SHACL-AF Rules v1.0.0"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_usefulness_rules_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/usefulness-rules/1.0.0> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:UvMemberShape a sh:NodeShape ; sh:targetClass va:UvVariant ;
    rdfs:label "A variant's members: one node per selected member"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { ?m a va:UvMember ; va:uvOfVariant $this ; va:uvAtom ?a }
        WHERE { $this va:uvHas ?a . BIND(IRI(CONCAT(STR($this), "/", MD5(STR(?a)))) AS ?m) }""" ] .

va:UvConnectShape a sh:NodeShape ; sh:targetClass va:UvMember ;
    rdfs:label "Two selected members that are related by use are adjacent; adjacency chains into one connected group, named by its first member"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvAdj ?other . $this va:uvSame $this }
        WHERE { $this va:uvOfVariant ?v ; va:uvAtom ?a . OPTIONAL { ?other va:uvOfVariant ?v ; va:uvAtom ?b . { ?a va:uvLink ?b } UNION { ?b va:uvLink ?a } FILTER(?other != $this) } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvSame ?c }
        WHERE { $this va:uvSame ?b . ?b va:uvAdj ?c }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvGroup ?k }
        WHERE { { SELECT $this (MIN(?i) AS ?k) WHERE { $this va:uvSame ?b . ?b va:uvAtom ?x . ?x va:uvIndex ?i } GROUP BY $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvProcesses true }
        WHERE { $this va:uvOfVariant ?v ; va:uvAtom ?a . ?a va:uvKind "method" .
                { ?a va:uvUses ?x . ?o va:uvOfVariant ?v ; va:uvAtom ?x } UNION { ?a va:uvDelegates true } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvOwnProcessing true }
        WHERE { $this va:uvOfVariant ?v ; va:uvAtom ?a . ?a va:uvKind "method" ; va:uvName ?n .
                FILTER(!STRSTARTS(?n, "get_") && !STRSTARTS(?n, "set_") && !STRSTARTS(?n, "is_") && !STRSTARTS(?n, "has_"))
                ?a va:uvUses ?x . ?o va:uvOfVariant ?v ; va:uvAtom ?x } """ ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvMeaning true }
        WHERE { $this va:uvAtom ?a . ?a va:uvKind ?k . FILTER(?k IN ("state value", "exception")) }""" ] .

va:UvReasonShape a sh:NodeShape ; sh:targetClass va:UvVariant ;
    rdfs:label "Why a variant is useless: each of the owner's cases, and the two researched ones"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "no members: nothing in it" }
        WHERE { $this a va:UvVariant . FILTER NOT EXISTS { ?m va:uvOfVariant $this } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "a single attribute: it holds a value and nothing uses it, so there is no behaviour" }
        WHERE { $this a va:UvVariant . { SELECT $this (COUNT(?m) AS ?n) WHERE { ?m va:uvOfVariant $this } GROUP BY $this } FILTER(?n = 1)
                ?m va:uvOfVariant $this ; va:uvAtom ?a . ?a va:uvKind "attribute" }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "no behaviour: no method processes anything (members only store or label)" }
        WHERE { $this a va:UvVariant . ?m0 va:uvOfVariant $this . FILTER NOT EXISTS { ?m va:uvOfVariant $this ; va:uvProcesses true } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "unrelated members: some members are not connected to the others by use" }
        WHERE { { SELECT $this (COUNT(DISTINCT ?k) AS ?c) WHERE { ?m va:uvOfVariant $this ; va:uvGroup ?k } GROUP BY $this } FILTER(?c > 1) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "no semantics: no state value, no exception and no method beyond get, set, is or has (a data class)" }
        WHERE { $this a va:UvVariant . ?m0 va:uvOfVariant $this .
                FILTER NOT EXISTS { ?m va:uvOfVariant $this ; va:uvMeaning true }
                FILTER NOT EXISTS { ?m2 va:uvOfVariant $this ; va:uvOwnProcessing true } }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvReason "only delegates: every method that does anything only calls another class (a middle man)" }
        WHERE { $this a va:UvVariant . ?m0 va:uvOfVariant $this ; va:uvProcesses true .
                FILTER NOT EXISTS { ?m va:uvOfVariant $this ; va:uvAtom ?a . ?a va:uvUses ?x . ?o va:uvOfVariant $this ; va:uvAtom ?x } }""" ] .

va:UvUsefulShape a sh:NodeShape ; sh:targetClass va:UvVariant ;
    rdfs:label "A variant none of the reasons applies to is useful"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/usefulness-rules> ; sh:construct """
        CONSTRUCT { $this va:uvUseful true }
        WHERE { $this a va:UvVariant . FILTER NOT EXISTS { $this va:uvReason ?r } }""" ] .

# ==== file variant_artifact_classification_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- artifact classification rules v1.0.0 (VAF-WI-114, 2026-09-28)
# The file classifications C14-C17 as SHACL-AF rules over a harvested file (09-declarative-calculi/harvester_files_v1_0_0.py:
# va:SourceFile with va:fileName, va:fileText and its lines). Each calculus is one rule: its structural markers as
# regular expressions (SPARQL REGEX; flags m, i and s where a marker needs them), tried in the calculus's order, the
# first that holds naming the kind. Moved from Python: the C14-C17 modules are now wrappers that read these results.
# In the regular expressions below every backslash is written four times (Turtle, then SPARQL, unescape it).

<http://example.org/vaf-consolidated/artifact-classification-rules>
    rdfs:label "Artifact classification rules (C14-C17)"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-09-28"^^xsd:date ;
    owl:imports <http://example.org/variant-algebra/harvest-vocabulary> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:C14DeploymentRuleShape a sh:NodeShape ; sh:targetClass va:SourceFile ; rdfs:label "C14: deployment artifact"@en ;
    rdfs:comment "A deployment artifact of the six kinds va:DeploymentArtifact names, each by its format's own structural marker, tried in this order: dockerfile (the first line that is neither blank nor a comment is a FROM instruction), docker-compose (the file name and a top-level services key), kubernetes (a top-level apiVersion, and the first top-level kind a Kubernetes resource), terraform (.tf and a resource, provider, module or terraform block), ansible (a hosts key and a tasks key), systemd (a [Unit] section)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/artifact-classification-rules> ; sh:construct """
        CONSTRUCT { $this a va:DeploymentArtifact ; va:deploymentKind ?k }
        WHERE { $this a va:SourceFile ; va:fileName ?fn ; va:fileText ?tx .
                OPTIONAL { SELECT $this (MIN(?i) AS ?first) WHERE { $this va:hasLine ?l . ?l va:lineIndex ?i ; va:lineText ?t .
                              BIND(REPLACE(?t, '^\\\\s+|\\\\s+$', '') AS ?st) FILTER(?st != '' && !STRSTARTS(?st, '#')) } GROUP BY $this }
                OPTIONAL { $this va:hasLine ?fl . ?fl va:lineIndex ?first ; va:lineText ?ft }
                BIND(COALESCE(REGEX(?ft, '^\\\\s*FROM\\\\s+\\\\S+', 'i'), false) AS ?docker)
                BIND(REGEX(?fn, 'docker-compose.*\\\\.ya?ml$', 'i') && REGEX(?tx, '^services:\\\\s*$', 'm') AS ?compose)
                BIND(IF(REGEX(?tx, '^kind:\\\\s*\\\\w+', 'm'), REPLACE(?tx, '^[\\\\s\\\\S]*?^kind:\\\\s*(\\\\w+)[\\\\s\\\\S]*$', '$1', 'm'), '') AS ?kind)
                BIND(REGEX(?tx, '^apiVersion:\\\\s*\\\\S+', 'm') && ?kind IN ('Deployment', 'Service', 'ConfigMap', 'Pod', 'StatefulSet', 'DaemonSet', 'Ingress', 'Secret') AS ?k8s)
                BIND(STRENDS(?fn, '.tf') && REGEX(?tx, '^\\\\s*(resource|provider|module|terraform)\\\\s+"?[\\\\w.]*"?\\\\s*\\\\{', 'm') AS ?tf)
                BIND(REGEX(?tx, '^\\\\s*-?\\\\s*hosts:\\\\s*\\\\S+', 'm') && REGEX(?tx, '^\\\\s*tasks:\\\\s*$', 'm') AS ?ansible)
                BIND(REGEX(?tx, '^\\\\[Unit\\\\]\\\\s*$', 'm') AS ?systemd)
                BIND(IF(?docker, 'dockerfile', IF(?compose, 'docker-compose', IF(?k8s, 'kubernetes', IF(?tf, 'terraform',
                     IF(?ansible, 'ansible', IF(?systemd, 'systemd', '')))))) AS ?k)
                FILTER(?k != '') }""" ] .

va:C15DatabaseSchemaRuleShape a sh:NodeShape ; sh:targetClass va:SourceFile ; rdfs:label "C15: database schema artifact"@en ;
    rdfs:comment "A database schema artifact, tried in this order: sql-ddl (CREATE TABLE, CREATE INDEX or CREATE UNIQUE INDEX outside comment lines), orm-sqlalchemy (a class on Base, db.Model or Model with a Column or Mapped attribute), orm-django (a class on models.Model with a models field), orm-rails (a class on ActiveRecord::Migration that creates, adds or changes a table), migration (a migration file name and a schema-changing statement)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/artifact-classification-rules> ; sh:construct """
        CONSTRUCT { $this a va:DatabaseSchemaArtifact ; va:databaseSchemaKind ?k }
        WHERE { $this a va:SourceFile ; va:fileName ?fn ; va:fileText ?tx .
                BIND(REPLACE(?tx, '^[^\\\\S\\\\n]*(--|#)[^\\\\n]*$', '', 'm') AS ?code)
                BIND(REGEX(?code, '\\\\bCREATE\\\\s+(TABLE|INDEX|UNIQUE\\\\s+INDEX)\\\\b', 'i') AS ?ddl)
                BIND(REGEX(?tx, 'class\\\\s+\\\\w+\\\\s*\\\\(\\\\s*(Base|db\\\\.Model|Model)\\\\s*\\\\)') && (REGEX(?tx, '=\\\\s*Column\\\\s*\\\\(') || REGEX(?tx, ':\\\\s*Mapped\\\\[')) AS ?sqlalchemy)
                BIND(REGEX(?tx, 'class\\\\s+\\\\w+\\\\s*\\\\(\\\\s*models\\\\.Model\\\\s*\\\\)') && REGEX(?tx, '=\\\\s*models\\\\.\\\\w+Field\\\\s*\\\\(') AS ?django)
                BIND(REGEX(?tx, 'class\\\\s+\\\\w+\\\\s*<\\\\s*ActiveRecord::Migration') && REGEX(?tx, '\\\\b(create_table|add_column|change_table)\\\\b') AS ?rails)
                BIND(REGEX(?fn, '(^\\\\d+_.*migrat|migration.*\\\\.(sql|py|rb)$)', 'i') && REGEX(?tx, '\\\\b(ALTER\\\\s+TABLE|CREATE\\\\s+TABLE|DROP\\\\s+TABLE|add_column|create_table)\\\\b', 'i') AS ?migration)
                BIND(IF(?ddl, 'sql-ddl', IF(?sqlalchemy, 'orm-sqlalchemy', IF(?django, 'orm-django', IF(?rails, 'orm-rails',
                     IF(?migration, 'migration', ''))))) AS ?k)
                FILTER(?k != '') }""" ] .

va:C16APISpecificationRuleShape a sh:NodeShape ; sh:targetClass va:SourceFile ; rdfs:label "C16: API specification artifact"@en ;
    rdfs:comment "An API specification, tried in this order: openapi (a top-level openapi or swagger version 2 or 3, and a paths block), asyncapi (a top-level asyncapi version and a channels block), graphql (a Query, Mutation or Subscription object type), grpc-proto (.proto with a service block holding an rpc), wsdl (a WSDL definitions root or the WSDL namespace)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/artifact-classification-rules> ; sh:construct """
        CONSTRUCT { $this a va:APISpecificationArtifact ; va:apiSpecificationKind ?k }
        WHERE { $this a va:SourceFile ; va:fileName ?fn ; va:fileText ?tx .
                BIND(REGEX(?tx, '^(openapi|swagger):\\\\s*[\\\\"\\']?[23]\\\\.', 'm') && REGEX(?tx, '^paths:\\\\s*$', 'm') AS ?openapi)
                BIND(REGEX(?tx, '^asyncapi:\\\\s*[\\\\"\\']?\\\\d', 'm') && REGEX(?tx, '^channels:\\\\s*$', 'm') AS ?asyncapi)
                BIND(REGEX(?tx, '\\\\btype\\\\s+(Query|Mutation|Subscription)\\\\s*\\\\{') AS ?graphql)
                BIND(STRENDS(?fn, '.proto') && REGEX(?tx, '\\\\bservice\\\\s+\\\\w+\\\\s*\\\\{[^}]*\\\\brpc\\\\s+\\\\w+', 's') AS ?grpc)
                BIND(REGEX(?tx, '<(wsdl:)?definitions\\\\b[^>]*xmlns:wsdl=') || REGEX(?tx, 'xmlns[^=]*=[\\\\"\\']http://schemas\\\\.xmlsoap\\\\.org/wsdl/') AS ?wsdl)
                BIND(IF(?openapi, 'openapi', IF(?asyncapi, 'asyncapi', IF(?graphql, 'graphql', IF(?grpc, 'grpc-proto',
                     IF(?wsdl, 'wsdl', ''))))) AS ?k)
                FILTER(?k != '') }""" ] .

va:C17ConfigurationRuleShape a sh:NodeShape ; sh:targetClass va:SourceFile ; rdfs:label "C17: configuration artifact"@en ;
    rdfs:comment "A configuration artifact, tried in this order: dotenv (a .env file name and at least two KEY=VALUE lines), django-settings (settings.py assigning INSTALLED_APPS, MIDDLEWARE, DATABASES or ALLOWED_HOSTS at the top level), java-properties (.properties and at least two lines with a dotted key), feature-flags (a top-level flags, features or feature_flags key and an indented boolean entry), toml-config (.toml with a [section] header and a key = value line)."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/artifact-classification-rules> ; sh:construct """
        CONSTRUCT { $this a va:ConfigurationArtifact ; va:configurationKind ?k }
        WHERE { $this a va:SourceFile ; va:fileName ?fn ; va:fileText ?tx .
                OPTIONAL { SELECT $this (COUNT(?l) AS ?env) WHERE { $this va:hasLine ?l . ?l va:lineText ?t .
                              FILTER(REGEX(REPLACE(?t, '^\\\\s+|\\\\s+$', ''), '^[A-Z][A-Z0-9_]*=')) } GROUP BY $this }
                OPTIONAL { SELECT $this (COUNT(?l2) AS ?props) WHERE { $this va:hasLine ?l2 . ?l2 va:lineText ?t .
                              FILTER(REGEX(REPLACE(?t, '^\\\\s+|\\\\s+$', ''), '^[\\\\w.]+\\\\s*=') && CONTAINS(STRBEFORE(?t, '='), '.')) } GROUP BY $this }
                BIND(REGEX(?fn, '(^|/)\\\\.env(\\\\.\\\\w+)?$') && COALESCE(?env, 0) >= 2 AS ?dotenv)
                BIND(REGEX(?fn, 'settings\\\\.py$') && REGEX(?tx, '^(INSTALLED_APPS|MIDDLEWARE|DATABASES|ALLOWED_HOSTS)\\\\s*=', 'm') AS ?djangoSettings)
                BIND(STRENDS(?fn, '.properties') && COALESCE(?props, 0) >= 2 AS ?properties)
                BIND(REGEX(?tx, '^(flags|features|feature_flags):\\\\s*$', 'm') && REGEX(?tx, '^\\\\s+\\\\w+:\\\\s*(true|false)\\\\s*$', 'm') AS ?flags)
                BIND(STRENDS(?fn, '.toml') && REGEX(?tx, '^\\\\[[\\\\w.]+\\\\]\\\\s*$', 'm') && REGEX(?tx, '^\\\\w+\\\\s*=\\\\s*\\\\S+', 'm') AS ?toml)
                BIND(IF(?dotenv, 'dotenv', IF(?djangoSettings, 'django-settings', IF(?properties, 'java-properties', IF(?flags, 'feature-flags',
                     IF(?toml, 'toml-config', ''))))) AS ?k)
                FILTER(?k != '') }""" ] .

# ==== file variant_calculus_result_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- calculus result rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_detection_calculi.run_all_single_file_calculi_va and variant_algebra_calculi: the pairing of the
# detection rules' proposals into operators, the collection of co-included names into groups, the splitting of the guard and
# state-move facts, the guard conditions of a state move). The detection rules (code analysis, algebraic operator detection,
# behavioural detection, temporal detection) propose; these rules turn each proposal into one result fact -- a dependency, an operator
# refinement or an operator pairing -- with its calculus, its names and its reason, and mark which pairs are one pair (C22, C24 and C26 are
# symmetric: a pair is one pair whichever side is written first). Python reads the result facts into its result types and decides nothing.
# A name is the part of the node's identifier after the last '#', and (where the calculus says bare) after the last '/' and the last '.'.

<http://example.org/vaf-consolidated/calculus-result-rules>
    rdfs:label "Calculus result rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:C1ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesAttributeDependency ; rdfs:label "C1: a proposed dependency becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:DependencyResult ; va:resultOf $this ; va:resultCalculus "C1" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultEvidence "strong" }
        WHERE { $this va:proposesAttributeDependency ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", "") AS ?l) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*/", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C1:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C2ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesCallDependency ; rdfs:label "C2: a proposed dependency becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:DependencyResult ; va:resultOf $this ; va:resultCalculus "C2" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultEvidence "strong" }
        WHERE { $this va:proposesCallDependency ?o BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C2:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C3ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesInitDependency ; rdfs:label "C3: a proposed dependency becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:DependencyResult ; va:resultOf $this ; va:resultCalculus "C3" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultEvidence "strong" }
        WHERE { $this va:proposesInitDependency ?o BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND("__init__" AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C3:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C4ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesExternalDependency ; rdfs:label "C4: a proposed dependency becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:DependencyResult ; va:resultOf $this ; va:resultCalculus "C4" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultEvidence "strong" }
        WHERE { $this va:proposesExternalDependency ?o BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND(STR(?o) AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C4:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C7ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesTransitiveDependency ; rdfs:label "C7: a proposed dependency becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:DependencyResult ; va:resultOf $this ; va:resultCalculus "C7" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultEvidence "strong" }
        WHERE { $this va:proposesTransitiveDependency ?o BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C7:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C5C6ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesOperatorRefinement ; rdfs:label "C5 and C6: a proposed refinement of an operator becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:RefinementResult ; va:resultOf $this ; va:resultCalculus "C5" ; va:resultLeft ?l ; va:resultOperator ?op ; va:resultReason "decorator role, via the real, shipped ontology-native va:C5RuleShape" }
        WHERE { $this va:proposesOperatorRefinement ?o BIND(STR(?o) AS ?op) FILTER(?op IN ("MandatoryOperator", "OptionalOperator")) BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND(IRI(CONCAT("urn:vaf:result:C5:", MD5(CONCAT(STR($this), "|", ?op)))) AS ?res) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:RefinementResult ; va:resultOf $this ; va:resultCalculus "C6" ; va:resultLeft ?l ; va:resultOperator ?op ; va:resultReason "mutable-container initializer, via the real, shipped ontology-native va:C6RuleShape" }
        WHERE { $this va:proposesOperatorRefinement ?o BIND(STR(?o) AS ?op) FILTER(?op = "RepetitionOperator") BIND(REPLACE(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*/", ""), "^.*[.]", "") AS ?l) BIND(IRI(CONCAT("urn:vaf:result:C6:", MD5(CONCAT(STR($this), "|", ?op)))) AS ?res) }""" ] .

va:C22ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesExclusivePairing ; rdfs:label "C22: a proposed pairing becomes a result; a pair is one pair whichever side is written first"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C22-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "ExclusiveOperator" ; va:resultReason "real, mutually exclusive if/elif branches via the ALREADY-EXISTING, shipped va:C22ExclusiveRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesExclusivePairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?on)
                BIND(IF(?sn < ?on, ?sn, ?on) AS ?l) BIND(IF(?sn < ?on, ?on, ?sn) AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C22:", MD5(CONCAT(?l, "|", ?r)))) AS ?res) }""" ] .

va:C23ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesOrPairing ; rdfs:label "C23: a proposed pairing becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C23-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "OrOperator" ; va:resultReason "real, boolean 'or' expression via the ALREADY-EXISTING, shipped va:C23OrRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesOrPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C23:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C24ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesAdditionPairing ; rdfs:label "C24: a proposed pairing becomes a result; a pair is one pair whichever side is written first"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C24-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "AdditionOperator" ; va:resultReason "real, single tuple-unpacking co-inclusion via the ALREADY-EXISTING, shipped va:C24AdditionRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesAdditionPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?on)
                BIND(IF(?sn < ?on, ?sn, ?on) AS ?l) BIND(IF(?sn < ?on, ?on, ?sn) AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C24:", MD5(CONCAT(?l, "|", ?r)))) AS ?res) }""" ] .

va:C25ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesSubtractionPairing ; rdfs:label "C25: a proposed pairing becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C25-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "SubtractionOperator" ; va:resultReason "real, guarded removal via the ALREADY-EXISTING, shipped va:C25SubtractionRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesSubtractionPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C25:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C26ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesCartesianPairing ; rdfs:label "C26: a proposed pairing becomes a result; a pair is one pair whichever side is written first"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C26-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "CartesianOperator" ; va:resultReason "real, nested-loop all-pairings via the ALREADY-EXISTING, shipped va:C26CartesianRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesCartesianPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?on)
                BIND(IF(?sn < ?on, ?sn, ?on) AS ?l) BIND(IF(?sn < ?on, ?on, ?sn) AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C26:", MD5(CONCAT(?l, "|", ?r)))) AS ?res) }""" ] .

va:C27ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesDivisionPairing ; rdfs:label "C27: a proposed pairing becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C27-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "DivisionOperator" ; va:resultReason "real, set-difference via the ALREADY-EXISTING, shipped va:C27DivisionRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesDivisionPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C27:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C29ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesIntersectionPairing ; rdfs:label "C29: a proposed pairing becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C29-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "IntersectionOperator" ; va:resultReason "real, set-intersection via the ALREADY-EXISTING, shipped va:C29IntersectionRuleShape SHACL-AF rule" ; va:resultEvidence "strong" }
        WHERE { $this va:proposesIntersectionPairing ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?r) BIND(IRI(CONCAT("urn:vaf:result:C29:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C28ResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesInverseRefinement ; rdfs:label "C28: a proposed inverse refinement becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:RefinementResult ; va:resultOf $this ; va:resultCalculus "C28-SHACL" ; va:resultLeft ?l ; va:resultOperator "InverseOperator" ; va:resultReason "real, unary 'not'/del via the ALREADY-EXISTING, shipped va:C28InverseRuleShape SHACL-AF rule" }
        WHERE { $this va:proposesInverseRefinement ?o BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(IRI(CONCAT("urn:vaf:result:C28:", MD5(CONCAT(STR($this), "|", STR(?o))))) AS ?res) }""" ] .

va:C31NotEqualResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesGuardDependency ; rdfs:label "C31: a proposed guard becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C31-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "DependencyOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesGuardDependency ?f BIND(STRBEFORE(STR(?f), ":") AS ?attr) BIND(STRAFTER(STR(?f), ":") AS ?val) FILTER(?val != "")
                BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(CONCAT(?attr, "_", ?val) AS ?r)
                BIND(CONCAT("real, guard-negated behavioral precondition via the ALREADY-VERIFIED, real, ontology-native C31NotEqualGuardRuleShape: guard raises, so successful execution genuinely requires ", ?attr, " == ", ?val) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C31:", MD5(CONCAT(STR($this), "|", STR(?f), "|", "DependencyOperator")))) AS ?res) }""" ] .

va:C31EqualResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesGuardExclusion ; rdfs:label "C31: a proposed guard becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C31-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "NegatedDependencyOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesGuardExclusion ?f BIND(STRBEFORE(STR(?f), ":") AS ?attr) BIND(STRAFTER(STR(?f), ":") AS ?val) FILTER(?val != "")
                BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(CONCAT(?attr, "_", ?val) AS ?r)
                BIND(CONCAT("real, guard-negated behavioral EXCLUSION via the real, ontology-native C31EqualGuardRuleShape: guard raises, so successful execution genuinely requires ", ?attr, " != ", ?val) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C31:", MD5(CONCAT(STR($this), "|", STR(?f), "|", "NegatedDependencyOperator")))) AS ?res) }""" ] .

va:C31InResultRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesGuardMultiExclusion ; rdfs:label "C31: a proposed guard becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C31-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "NegatedDependencyOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesGuardMultiExclusion ?f BIND(STRBEFORE(STR(?f), ":") AS ?attr) BIND(STRAFTER(STR(?f), ":") AS ?val) FILTER(?val != "")
                BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?l) BIND(CONCAT(?attr, "_", ?val) AS ?r)
                BIND(CONCAT("real, guard-negated behavioral EXCLUSION (multi-value 'in' guard) via the real, ontology-native C31InGuardRuleShape: guard raises, so successful execution genuinely requires ", ?attr, " != ", ?val) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C31:", MD5(CONCAT(STR($this), "|", STR(?f), "|", "NegatedDependencyOperator")))) AS ?res) }""" ] .

va:C33SequenceRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesSequenceBefore ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "SequenceOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesSequenceBefore ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(REPLACE(REPLACE(STR(?o), "^.*#", ""), "^.*[.]", "") AS ?bn)
                BIND(?sn AS ?l) BIND(?bn AS ?r) BIND(CONCAT("hand-off: ", ?sn, " sets the value ", ?bn, "'s guard requires, so ", ?sn, " comes before ", ?bn) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesSequenceBefore", "|", STR(?o))))) AS ?res) }""" ] .

va:C33StateMoveRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesStateMove ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "NextOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesStateMove ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STRBEFORE(STR(?o), ":") AS ?attr) BIND(STRAFTER(STR(?o), ":") AS ?rest) BIND(STRBEFORE(?rest, ">") AS ?frm) BIND(STRAFTER(?rest, ">") AS ?to)
                BIND(EXISTS { $this va:proposesUnguardedMove ?u . FILTER(STR(?u) = CONCAT(?attr, ":", ?to)) } AS ?unguarded)
                BIND(CONCAT(?attr, "_", ?frm) AS ?l) BIND(CONCAT(?attr, "_", ?to) AS ?r) BIND(CONCAT("state move by ", ?sn, ": ", ?attr, " ", ?frm, " is immediately followed by ", ?to, IF(?unguarded, " -- UNGUARDED: the method does not check where it starts", "")) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesStateMove", "|", STR(?o))))) AS ?res) }""" ] .

va:C33RegistrationRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesRegistrationBefore ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "SequenceOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesRegistrationBefore ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STR(?o) AS ?f)
                BIND(?sn AS ?l) BIND(CONCAT("event_", ?f) AS ?r) BIND(CONCAT("event: a handler registered by ", ?sn, " into ", ?f, " runs only after its registration") AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesRegistrationBefore", "|", STR(?o))))) AS ?res) }""" ] .

va:C33DispatchRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesDispatchOf ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "SequenceOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesDispatchOf ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STR(?o) AS ?f)
                BIND(?sn AS ?l) BIND(CONCAT("event_", ?f) AS ?r) BIND(CONCAT("event: ", ?sn, " runs the handlers stored in ", ?f) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesDispatchOf", "|", STR(?o))))) AS ?res) }""" ] .

va:C33ImmediateRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesImmediateFiring ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "NextOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesImmediateFiring ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STR(?o) AS ?f)
                BIND(?sn AS ?l) BIND(CONCAT("event_", ?f) AS ?r) BIND(CONCAT("event: ", ?sn, " may run the handler at once, instead of storing it") AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesImmediateFiring", "|", STR(?o))))) AS ?res) }""" ] .

va:C33StateBeforeEventRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesStateBeforeEvent ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "SequenceOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesStateBeforeEvent ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STRBEFORE(STR(?o), ">") AS ?st) BIND(STRAFTER(STR(?o), ">") AS ?f) BIND(STRBEFORE(?st, ":") AS ?attr) BIND(STRAFTER(?st, ":") AS ?val)
                BIND(CONCAT(?attr, "_", ?val) AS ?l) BIND(CONCAT("event_", ?f) AS ?r) BIND(CONCAT("event: ", ?sn, " sets ", ?attr, " to ", ?val, " before dispatching the handlers in ", ?f) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesStateBeforeEvent", "|", STR(?o))))) AS ?res) }""" ] .

va:C33InitialStateRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesInitialState ; rdfs:label "C33: a proposed temporal fact becomes a result"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?res a va:PairingResult ; va:resultOf $this ; va:resultCalculus "C33-SHACL" ; va:resultLeft ?l ; va:resultRight ?r ; va:resultOperator "NextOperator" ;
                          va:resultReason ?why ; va:resultEvidence "strong" }
        WHERE { $this va:proposesInitialState ?o BIND(REPLACE(REPLACE(STR($this), "^.*#", ""), "^.*[.]", "") AS ?sn) BIND(STRBEFORE(STR(?o), ":") AS ?attr) BIND(STRAFTER(STR(?o), ":") AS ?val)
                BIND("created" AS ?l) BIND(CONCAT(?attr, "_", ?val) AS ?r) BIND(CONCAT("initial state: creating ", ?sn, " sets ", ?attr, " to ", ?val) AS ?why) BIND(IRI(CONCAT("urn:vaf:result:C33:", MD5(CONCAT(STR($this), "|", "proposesInitialState", "|", STR(?o))))) AS ?res) }""" ] .

va:C24NamesRuleShape a sh:NodeShape ; sh:targetClass va:PairingResult ; rdfs:label "C24: the names of the co-included pairs are linked"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?nl a va:CoIncludedName ; va:nameText ?l ; va:coIncludedWith ?nr . ?nr a va:CoIncludedName ; va:nameText ?r }
        WHERE { $this va:resultCalculus "C24-SHACL" ; va:resultLeft ?l ; va:resultRight ?r
                BIND(IRI(CONCAT("urn:vaf:name:", ENCODE_FOR_URI(?l))) AS ?nl) BIND(IRI(CONCAT("urn:vaf:name:", ENCODE_FOR_URI(?r))) AS ?nr) }""" ] .

va:C24GroupRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:coIncludedWith ; rdfs:label "C24: names linked through co-inclusion form one atomic group (a tuple-unpacking of three or more names is a complete pairwise clique; the clique is recovered)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?g a va:GroupAdditionResult ; va:resultOf $this ; va:resultCalculus "C24" ; va:resultOperator "GroupAdditionOperator" ; va:groupMemberName ?an ; va:groupSize ?n ;
                    va:resultReason ?why }
        WHERE { { SELECT $this (MIN(?bn) AS ?root) (COUNT(DISTINCT ?b) AS ?n) WHERE { $this (va:coIncludedWith|^va:coIncludedWith)* ?b . ?b va:nameText ?bn } GROUP BY $this }
                $this va:nameText ?an FILTER(?n >= 2)
                BIND(IRI(CONCAT("urn:vaf:group:", ENCODE_FOR_URI(?root))) AS ?g)
                BIND(CONCAT("real, reconstructed group from ", STR(?n), " co-included members, detected as one atomic tuple-unpacking assignment in __init__") AS ?why) }""" ] .

va:GuardConditionCandidateRuleShape a sh:NodeShape ; sh:targetSubjectsOf va:proposesStateMove ; rdfs:label "A state move that its method guards has the guard's condition as a candidate"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?c a va:GuardConditionCandidate ; va:candidateOf $this ; va:candFrom ?fr ; va:candTo ?tt ; va:candText ?txt }
        WHERE { $this va:proposesStateMove ?mv BIND(STRBEFORE(STR(?mv), ":") AS ?attr) BIND(STRAFTER(STR(?mv), ":") AS ?rest) BIND(STRBEFORE(?rest, ">") AS ?frm) BIND(STRAFTER(?rest, ">") AS ?to)
                FILTER NOT EXISTS { $this va:proposesUnguardedMove ?u . FILTER(STR(?u) = CONCAT(?attr, ":", ?to)) }
                { $this va:raisesIfAttributeNotEqual ?g BIND(CONCAT(STRBEFORE(STR(?g), ":"), "_", STRAFTER(STR(?g), ":")) AS ?txt) }
                UNION { $this va:raisesIfAttributeEqual ?g FILTER NOT EXISTS { $this va:raisesIfAttributeNotEqual ?x }
                        BIND(CONCAT("!", STRBEFORE(STR(?g), ":"), "_", STRAFTER(STR(?g), ":")) AS ?txt) }
                BIND(CONCAT(?attr, "_", ?frm) AS ?fr) BIND(CONCAT(?attr, "_", ?to) AS ?tt)
                BIND(IRI(CONCAT("urn:vaf:guardcandidate:", MD5(CONCAT(STR($this), "|", STR(?mv), "|", ?txt)))) AS ?c) }""" ] .

va:GuardConditionRuleShape a sh:NodeShape ; sh:targetClass va:GuardConditionCandidate ; rdfs:label "One guard condition per state move: where methods give several, the smallest text"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/calculus-result-rules> ; sh:construct """
        CONSTRUCT { ?k a va:GuardConditionResult ; va:conditionFrom $this ; va:conditionFromFeature ?fr ; va:conditionToFeature ?tt ; va:conditionText ?txt }
        WHERE { $this va:candFrom ?fr ; va:candTo ?tt .
                { SELECT ?fr ?tt (MIN(?x) AS ?txt) WHERE { ?c2 va:candFrom ?fr ; va:candTo ?tt ; va:candText ?x } GROUP BY ?fr ?tt }
                BIND(IRI(CONCAT("urn:vaf:guardcondition:", MD5(CONCAT(?fr, "|", ?tt)))) AS ?k) }""" ] .


