@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- candidate evidence rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_candidate_review._derived_candidates, ._documented_candidates and ._apply_probe_evidence): which relations of the
# dependence model and which rules of the program's documentation become candidates (not those a candidate already says, not repeats), in
# which names they are written (with the class, or bare when one class's evidence is all unscoped), and which candidates a probe of the
# running program can test and what a confirming probe does to their grounding. The probe itself, and reading the documentation, stay
# in Python (they run the program and read text); their answers enter as facts.

<http://example.org/vaf-consolidated/candidate-evidence-rules>
    rdfs:label "Candidate evidence rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:RequestScopedStyleRuleShape a sh:NodeShape ; sh:targetClass va:MatchRequest ; rdfs:label "Names are written with their class when the program has several classes or the evidence already has one"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:scopedStyle true }
        WHERE { { SELECT (COUNT(?c) AS ?n) WHERE { ?c a va:Class } } FILTER(?n >= 2) }""" ] .

va:ReviewedNameScopedStyleRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A reviewed candidate that names a member with its class in front makes the style scoped"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { ?r va:scopedStyle true }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:candidateOfRequest ?r ; va:reviewSubject ?s FILTER(CONTAINS(?s, ".")) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { ?r va:scopedStyle true }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:candidateOfRequest ?r ; va:reviewObject ?s FILTER(CONTAINS(?s, ".")) }""" ] .

va:ReviewedCoverageRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "What an accepted candidate already says: the pairs a dependency covers and the statements it states"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:coversKey ?k }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:isAccepted true ; va:reviewOperator "DependencyOperator" ; va:reviewSubject ?s ; va:reviewObject ?o
                FILTER(CONTAINS(?s, ".") && CONTAINS(?o, ".")) BIND(CONCAT(?s, "|", ?o) AS ?k) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:coversKey ?k }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:isAccepted true ; va:reviewOperator "DependencyOperator" ; va:reviewSubject ?s ; va:reviewObject ?o
                FILTER(!(CONTAINS(?s, ".") && CONTAINS(?o, "."))) ?c a va:Class ; rdfs:label ?cl ; va:ownsMember ?s , ?o
                BIND(CONCAT(?cl, ".", ?s, "|", ?cl, ".", ?o) AS ?k) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:statesKey ?k }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:isAccepted true ; va:reviewOperator ?op ; va:reviewSubject ?s ; va:reviewObject ?o
                BIND(CONCAT(?op, "|", ?s, "|", ?o) AS ?k) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:statesKey ?k }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:isAccepted true ; va:reviewOperator "ExclusiveOperator" ; va:reviewSubject ?s ; va:reviewObject ?o
                BIND(CONCAT("ExclusiveOperator|", ?o, "|", ?s) AS ?k) }""" ] .

va:DocumentedOperatorRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A documented rule that says only after is a dependency; any other documented rule is an exclusion"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:reviewOperator ?op }
        WHERE { $this va:candidateOrigin va:Origin_Documented ; va:documentedKind ?k BIND(IF(?k = "only after", "DependencyOperator", "ExclusiveOperator") AS ?op) }""" ] .

va:ProposalWrittenNameRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A proposed candidate is written with its class in front in the scoped style, and bare otherwise"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:writtenSubject ?w }
        WHERE { $this va:candidateOrigin ?org ; va:candidateOfRequest ?r ; va:reviewSubject ?s FILTER(?org != va:Origin_Review)
                BIND(IF(EXISTS { ?r va:scopedStyle true }, ?s, STRAFTER(?s, ".")) AS ?w) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:writtenObject ?w }
        WHERE { $this va:candidateOrigin ?org ; va:candidateOfRequest ?r ; va:reviewObject ?s FILTER(?org != va:Origin_Review)
                BIND(IF(EXISTS { ?r va:scopedStyle true }, ?s, STRAFTER(?s, ".")) AS ?w) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { ?n va:writtenName ?w }
        WHERE { $this va:candidateOrigin va:Origin_Derived ; va:candidateOfRequest ?r . ?n va:nameOf $this ; va:nameRole va:NameRole_Alternative ; va:nameText ?s
                BIND(IF(EXISTS { ?r va:scopedStyle true }, ?s, STRAFTER(?s, ".")) AS ?w) }""" ] .

va:ProposalKeptRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A related pair of the dependence model becomes a candidate unless it is a self-relation, an accepted candidate already covers it, or an earlier one is the same; a documented rule unless a candidate states it or an earlier rule says it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:proposalKept true }
        WHERE { $this va:candidateOrigin va:Origin_Derived ; va:candidatePosition ?p ; va:reviewSubject ?s ; va:reviewObject ?o FILTER(?s != ?o)
                BIND(CONCAT(?s, "|", ?o) AS ?k)
                FILTER NOT EXISTS { ?e va:coversKey ?k }
                FILTER NOT EXISTS { ?d va:candidateOrigin va:Origin_Derived ; va:candidatePosition ?p2 ; va:reviewSubject ?s ; va:reviewObject ?o FILTER(?p2 < ?p) } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:proposalKept true }
        WHERE { $this va:candidateOrigin va:Origin_Documented ; va:candidatePosition ?p ; va:reviewOperator ?op ; va:writtenSubject ?ws ; va:writtenObject ?wo
                BIND(CONCAT(?op, "|", ?ws, "|", ?wo) AS ?k)
                FILTER NOT EXISTS { ?e va:statesKey ?k }
                FILTER NOT EXISTS { ?d va:candidateOrigin va:Origin_Documented ; va:candidatePosition ?p2 ; va:reviewOperator ?op ; va:writtenSubject ?ws ; va:writtenObject ?wo FILTER(?p2 < ?p) }
                FILTER NOT EXISTS { ?d va:candidateOrigin va:Origin_Documented ; va:candidatePosition ?p3 ; va:reviewOperator "ExclusiveOperator" ; va:writtenSubject ?wo ; va:writtenObject ?ws FILTER(?op = "ExclusiveOperator" && ?p3 < ?p) } }""" ] .

va:CandidateProbePairRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A dependency between two methods of the component, with no alternatives, can be tested by running the program; the pair is the two methods in their bare names"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { ?pair a va:ProbePair ; va:probeFrom ?a ; va:probeTo ?b . $this va:probedFor ?pair }
        WHERE { $this va:candidateOrigin va:Origin_Review ; va:isAccepted true ; va:reviewOperator "DependencyOperator" ; va:reviewSubject ?s ; va:reviewObject ?o ; va:candidateOfRequest ?r .
                ?r va:requestComponentName ?cn . ?cls a va:Class ; rdfs:label ?cn
                FILTER NOT EXISTS { ?an va:nameOf $this ; va:nameRole va:NameRole_Alternative }
                BIND(IF(STRSTARTS(?s, CONCAT(?cn, ".")), SUBSTR(?s, STRLEN(?cn) + 2), ?s) AS ?s1)
                BIND(IF(STRSTARTS(?o, CONCAT(?cn, ".")), SUBSTR(?o, STRLEN(?cn) + 2), ?o) AS ?o1)
                BIND(IF(STRSTARTS(?s1, CONCAT(?cn, "_")) && EXISTS { ?cls va:ownsMethod ?m1 FILTER(?m1 = SUBSTR(?s1, STRLEN(?cn) + 2)) }, SUBSTR(?s1, STRLEN(?cn) + 2), ?s1) AS ?a)
                BIND(IF(STRSTARTS(?o1, CONCAT(?cn, "_")) && EXISTS { ?cls va:ownsMethod ?m2 FILTER(?m2 = SUBSTR(?o1, STRLEN(?cn) + 2)) }, SUBSTR(?o1, STRLEN(?cn) + 2), ?o1) AS ?b)
                FILTER(?a != ?b) FILTER EXISTS { ?cls va:ownsMethod ?a } FILTER EXISTS { ?cls va:ownsMethod ?b }
                BIND(IRI(CONCAT("urn:vaf:probe:", ENCODE_FOR_URI(?a), ":", ENCODE_FOR_URI(?b))) AS ?pair) }""" ] .

va:CandidateProbeEffectRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate whose probe confirmed it is no longer weakly grounded; one whose probe did not confirm it is as weak as before"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-evidence-rules> ; sh:construct """
        CONSTRUCT { $this va:groundedWeaklyAfterProbe true }
        WHERE { $this va:probedFor ?p ; va:candidateOfRequest ?r ; va:groundedWeakly true . ?r va:probeCompleted true FILTER NOT EXISTS { ?p va:probeVerdict "confirmed" } }""" ] .


# ==== file variant_candidate_grounding_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- candidate grounding rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_candidate_review._classify_evidence: whether a candidate is weakly grounded). A candidate is a semantic
# characteristic derived from syntactic evidence (the discovery taxonomy); a relational candidate whose calculus is a behavioural one is
# confirmed by behaviour, and one that the documentation agrees with (told by the check the review makes, which may use a language model)
# agrees with documentation. The taxonomy's own rule (va:WeaklyGroundedRuleShape) then says which are weakly grounded; a candidate that
# the source's own type system or a runtime observation confirms is not.

<http://example.org/vaf-consolidated/candidate-grounding-rules>
    rdfs:label "Candidate grounding rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] .

va:CandidateSemanticRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate is a semantic characteristic derived from syntactic evidence"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-grounding-rules> ; sh:construct """
        CONSTRUCT { $this a va:SemanticCharacteristic ; va:derivedFromSyntactic ?syn . ?syn a va:SyntacticCharacteristic }
        WHERE { $this a va:CandidateReview BIND(IRI(CONCAT(STR($this), "__syntax")) AS ?syn) }""" ] .

va:CandidateBehaviouralConfirmationRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A relational candidate from a behavioural calculus is confirmed by behaviour"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-grounding-rules> ; sh:construct """
        CONSTRUCT { $this va:confirmedByBehavioral ?beh . ?beh a va:BehavioralCharacteristic }
        WHERE { $this va:isRelationalOperator true ; va:fromBehavioralCalculus true BIND(IRI(CONCAT(STR($this), "__behaviour")) AS ?beh) }""" ] .

va:CandidateDocumentationRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A relational candidate the documentation agrees with agrees with documentation"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-grounding-rules> ; sh:construct """
        CONSTRUCT { $this va:agreesWithDocumentation true }
        WHERE { $this va:isRelationalOperator true ; va:reviewAgreesWithDocs true }""" ] .

va:CandidateGroundingRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate is weakly grounded unless confirmed by behaviour, documentation, the type system or a runtime observation"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 11 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-grounding-rules> ; sh:construct """
        CONSTRUCT { $this va:groundedWeakly true }
        WHERE { $this a va:CandidateReview ; va:isWeaklyGrounded true
                FILTER NOT EXISTS { $this va:confirmedByValueDomain true }
                FILTER NOT EXISTS { $this va:confirmedByRuntimeObservation true } }""" ] .

# ==== file variant_candidate_matching_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- candidate matching rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_candidate_review.match_variant_candidates and its helpers): which class's component each accepted candidate
# is written in, which candidates are given to the class that owns the member they name, which cross two unrelated classes (and so are
# left out and told), which are given to the descendant when the two classes are related by inheritance, which statement each
# candidate becomes in each component (its written form is ontology data: va:StatementForm), and which statement repeats an earlier one.
# The Python writes the candidates, their names in order, the classes with what they inherit from and own, and the request; it reads the
# components and statements back and joins their texts.

<http://example.org/vaf-consolidated/candidate-matching-rules>
    rdfs:label "Candidate matching rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:CandidateScopedNameRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate that names a member with its class already written is scoped"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:hasScopedName true }
        WHERE { $this a va:CandidateReview . ?n va:nameOf $this ; va:nameRole ?role ; va:nameText ?t FILTER(?role != va:NameRole_Alternative && CONTAINS(?t, ".")) }""" ] .

va:CandidateOwnedNamesRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "An unscoped candidate whose every name is a member of some class has owners for all its names"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:allNamesOwned true }
        WHERE { $this a va:CandidateReview . ?any va:nameOf $this ; va:nameRole ?anyRole FILTER(?anyRole != va:NameRole_Alternative)
                FILTER NOT EXISTS { $this va:hasScopedName true }
                FILTER NOT EXISTS { ?n va:nameOf $this ; va:nameRole ?role ; va:nameText ?t FILTER(?role != va:NameRole_Alternative) FILTER NOT EXISTS { ?c a va:Class ; va:ownsMember ?t } } }""" ] .

va:CandidateCommonOwnerRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A class that owns every name of an unscoped candidate is a common owner of it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:commonOwner ?c }
        WHERE { $this va:allNamesOwned true . ?c a va:Class
                FILTER NOT EXISTS { ?n va:nameOf $this ; va:nameRole ?role ; va:nameText ?t FILTER(?role != va:NameRole_Alternative) FILTER NOT EXISTS { ?c va:ownsMember ?t } } }""" ] .

va:CandidatePrescopeRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate with exactly one common owner is given to it; one whose names are owned by different classes crosses classes"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:prescopedTo ?c }
        WHERE { $this va:commonOwner ?c FILTER NOT EXISTS { $this va:commonOwner ?c2 FILTER(?c2 != ?c) } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:crossKind "prescope" }
        WHERE { $this va:allNamesOwned true FILTER NOT EXISTS { $this va:commonOwner ?c } }""" ] .

va:CandidateOwnerRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "The class a candidate's subject and object belong to is the class written in the name, or the one it was given to"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:subjectOwner ?c }
        WHERE { $this va:prescopedTo ?c }""" ] ,
    [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:subjectOwner ?c }
        WHERE { $this va:reviewSubject ?s FILTER(CONTAINS(?s, ".")) ?c a va:Class ; rdfs:label ?l FILTER(?l = STRBEFORE(?s, ".")) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:objectOwner ?c }
        WHERE { $this va:prescopedTo ?c ; va:reviewObject ?o }""" ] ,
    [ a sh:SPARQLRule ; sh:order 5 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:objectOwner ?c }
        WHERE { $this va:reviewObject ?o FILTER(CONTAINS(?o, ".")) ?c a va:Class ; rdfs:label ?l FILTER(?l = STRBEFORE(?o, ".")) }""" ] .

va:CandidateRoutingRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate is written in its owner's component; one between two related classes in the descendant's; one between two unrelated classes is left out"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:crossKind "route" }
        WHERE { $this va:subjectOwner ?a ; va:objectOwner ?b FILTER(?a != ?b)
                FILTER NOT EXISTS { ?a va:inheritsFrom+ ?b } FILTER NOT EXISTS { ?b va:inheritsFrom+ ?a } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:routedTo ?a }
        WHERE { $this va:subjectOwner ?a ; va:objectOwner ?b FILTER(?a != ?b)
                FILTER(EXISTS { ?a va:inheritsFrom+ ?b } || EXISTS { ?b va:inheritsFrom+ ?a })
                ?a va:inheritsFrom ?parent }""" ] ,
    [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:routedTo ?b }
        WHERE { $this va:subjectOwner ?a ; va:objectOwner ?b FILTER(?a != ?b)
                FILTER(EXISTS { ?a va:inheritsFrom+ ?b } || EXISTS { ?b va:inheritsFrom+ ?a })
                FILTER NOT EXISTS { ?a va:inheritsFrom ?parent } }""" ] ,
    [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:routedTo ?a }
        WHERE { $this va:subjectOwner ?a OPTIONAL { $this va:objectOwner ?b } FILTER(!BOUND(?b) || ?a = ?b) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 6 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:routedTo ?b }
        WHERE { $this va:objectOwner ?b FILTER NOT EXISTS { $this va:subjectOwner ?a } }""" ] .

va:CandidateComponentRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "Each class a candidate is routed to has a component; when no candidate is routed to a class the request has one component under its own name"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { ?comp a va:Component ; rdfs:label ?l ; va:componentForClass ?c ; va:componentOfRequest ?r }
        WHERE { $this va:routedTo ?c ; va:candidateOfRequest ?r . ?c rdfs:label ?l BIND(IRI(CONCAT("urn:vaf:component:", ENCODE_FOR_URI(?l))) AS ?comp) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 7 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { ?comp a va:Component ; rdfs:label ?n ; va:componentOfRequest ?r }
        WHERE { $this va:candidateOfRequest ?r . ?r va:requestComponentName ?n FILTER NOT EXISTS { ?x va:routedTo ?cl }
                BIND(IRI(CONCAT("urn:vaf:component:default:", ENCODE_FOR_URI(?n))) AS ?comp) }""" ] .

va:CandidateStatementRuleShape a sh:NodeShape ; sh:targetClass va:CandidateReview ; rdfs:label "A candidate becomes a statement in the component of its class, and, when it names no class, in every component with the class written before its names"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { ?st a va:ComponentStatement ; va:statementIn ?comp ; va:statementFor $this ; va:statementRank ?i ; va:statementPrefix ?pfx }
        WHERE { $this va:routedTo ?c ; va:candidatePosition ?i . ?comp va:componentForClass ?c ; rdfs:label ?cl
                OPTIONAL { $this va:prescopedTo ?pc . ?pc rdfs:label ?pl }
                BIND(IF(BOUND(?pl), CONCAT(?pl, "."), "") AS ?pfx)
                BIND(IRI(CONCAT("urn:vaf:statement:", STR(?i), ":own:", ENCODE_FOR_URI(?cl))) AS ?st) }""" ] ,
    [ a sh:SPARQLRule ; sh:order 8 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { ?st a va:ComponentStatement ; va:statementIn ?comp ; va:statementFor $this ; va:statementRank ?rk ; va:statementPrefix ?pfx }
        WHERE { $this va:candidatePosition ?i ; va:candidateOfRequest ?r
                FILTER NOT EXISTS { $this va:routedTo ?x } FILTER NOT EXISTS { $this va:crossKind ?k }
                ?comp va:componentOfRequest ?r ; rdfs:label ?cl OPTIONAL { ?comp va:componentForClass ?cc }
                BIND(IF(BOUND(?cc), CONCAT(?cl, "."), "") AS ?pfx)
                BIND(?i + 1000000 AS ?rk)
                BIND(IRI(CONCAT("urn:vaf:statement:", STR(?i), ":unscoped:", ENCODE_FOR_URI(?cl))) AS ?st) }""" ] .

va:StatementTextRuleShape a sh:NodeShape ; sh:targetClass va:ComponentStatement ; rdfs:label "A statement is its operator's written form with the names, the bound, the guard condition and the alternatives put in, and the weak-grounding note when the candidate is weakly grounded"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 9 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:statementText ?text ; va:statementKey ?key }
        WHERE { $this va:statementFor ?c ; va:statementPrefix ?pfx . ?c va:reviewOperator ?op ; va:reviewSubject ?s .
                OPTIONAL { ?c va:reviewObject ?o } OPTIONAL { ?c va:realMaxBound ?b } OPTIONAL { ?c va:hasGuardCondition ?g }
                BIND(IF(?op = "RepetitionOperator", IF(BOUND(?b), "bounded", "unbounded"),
                     IF(?op = "NextOperator", IF(BOUND(?g), "guarded", "plain"),
                     IF(?op = "DependencyOperator", IF(EXISTS { ?an va:nameOf ?c ; va:nameRole va:NameRole_Alternative }, "alternatives", "plain"), "plain"))) AS ?variant)
                ?opr va:operatorName ?op . ?f a va:StatementForm ; va:formForOperator ?opr ; va:formVariant ?variant ; va:formText ?form .
                BIND(CONCAT(?pfx, ?s) AS ?es)
                BIND(IF(BOUND(?o), CONCAT(?pfx, ?o), "") AS ?eo)
                BIND(IF(BOUND(?g), IF(CONTAINS(?es, "."), CONCAT(IF(STRSTARTS(?g, "!"), "!", ""), STRBEFORE(?es, "."), "_", IF(STRSTARTS(?g, "!"), SUBSTR(?g, 2), ?g)), ?g), "") AS ?cond)
                OPTIONAL { SELECT ?c (GROUP_CONCAT(CONCAT(" | ", REPLACE(?at, "[.]", "_")); separator="") AS ?alts)
                           WHERE { SELECT ?c ?at WHERE { ?an va:nameOf ?c ; va:nameRole va:NameRole_Alternative ; va:nameText ?at ; va:nameIndex ?ai } ORDER BY ?ai }
                           GROUP BY ?c }
                OPTIONAL { SELECT $this (GROUP_CONCAT(?mn2; separator=", ") AS ?members)
                           WHERE { SELECT $this ?mn2 WHERE { $this va:statementFor ?c2 ; va:statementPrefix ?p2 .
                                   ?mn va:nameOf ?c2 ; va:nameRole va:NameRole_Member ; va:nameText ?mt ; va:nameIndex ?mi
                                   BIND(REPLACE(IF(CONTAINS(?mt, "."), ?mt, CONCAT(?p2, ?mt)), "[.]", "_") AS ?mn2) } ORDER BY ?mi }
                           GROUP BY $this }
                ?wf a va:StatementForm ; va:formVariant "weak-note" ; va:formText ?weakNote .
                BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(?form, "@S@", REPLACE(?es, "[.]", "_")), "@O@", REPLACE(?eo, "[.]", "_")), "@B@", STR(COALESCE(?b, 0))), "@C@", COALESCE(?cond, "")), "@ALTS@", COALESCE(?alts, "")), "@MEMBERS@", COALESCE(?members, "")) AS ?body)
                BIND(IF(EXISTS { ?ro a va:RelationalOperator ; va:operatorName ?op } && EXISTS { ?c va:groundedWeakly true }, CONCAT(?body, ?weakNote), ?body) AS ?text)
                BIND(IF(?op = "GroupAdditionOperator", ?body, CONCAT(?op, "|", ?es, "|", ?eo)) AS ?key) }""" ] .

va:StatementRepeatRuleShape a sh:NodeShape ; sh:targetClass va:ComponentStatement ; rdfs:label "A statement that an earlier statement of the same component already says is a repeat"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 10 ; sh:prefixes <http://example.org/vaf-consolidated/candidate-matching-rules> ; sh:construct """
        CONSTRUCT { $this va:statementRepeats true }
        WHERE { $this va:statementIn ?comp ; va:statementRank ?rk ; va:statementKey ?k .
                ?other va:statementIn ?comp ; va:statementKey ?k ; va:statementRank ?rk2 FILTER(?rk2 < ?rk) }""" ] .

# ==== file variant_capacity_notice_rules_v1_0_0.ttl ====
@prefix cap: <http://example.org/vaf-consolidated/capacity#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- capacity notice rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_capacity.check, which compared a project's size with what was measured). A size check states a
# dimension, the observed value and the expectation it is compared with; the rules decide whether a notice is due and of which
# kind. Python writes the notice text from the notice and the expectation. Three cases, exclusive: nothing was measured in the
# dimension, or the value is beyond the largest measured (BeyondMeasured); or the value is within the measured range but at or
# above the smallest value that did not finish (UndecidedElsewhere).

<http://example.org/vaf-consolidated/capacity-notice-rules>
    rdfs:label "Capacity notice rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "cap" ; sh:namespace "http://example.org/vaf-consolidated/capacity#"^^xsd:anyURI ] ,
               [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:CapacityNoticeRuleShape a sh:NodeShape ; sh:targetClass cap:SizeCheck ; rdfs:label "A size check beyond what was measured, or at a size that did not finish, gets a notice"@en ;
    rdfs:comment "Nothing counted in the dimension: a BeyondMeasured notice that says there is no measurement. A value above the largest counted: a BeyondMeasured notice. A value within the counted range and at or above the smallest value that did not finish: an UndecidedElsewhere notice."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/capacity-notice-rules> ; sh:construct """
        CONSTRUCT { ?n a va:CapacityNotice ; cap:noticeOfCheck $this ; va:noticeKind 'BeyondMeasured' ; cap:noMeasurement true }
        WHERE { $this cap:comparedWith ?e . FILTER NOT EXISTS { ?e cap:measuredUpTo ?m }
                BIND(IRI(CONCAT(STR($this), '__notice')) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/capacity-notice-rules> ; sh:construct """
        CONSTRUCT { ?n a va:CapacityNotice ; cap:noticeOfCheck $this ; va:noticeKind 'BeyondMeasured' ; cap:noMeasurement false }
        WHERE { $this cap:observedValue ?v ; cap:comparedWith ?e . ?e cap:measuredUpTo ?m . FILTER(?v > ?m)
                BIND(IRI(CONCAT(STR($this), '__notice')) AS ?n) }""" ] ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/capacity-notice-rules> ; sh:construct """
        CONSTRUCT { ?n a va:CapacityNotice ; cap:noticeOfCheck $this ; va:noticeKind 'UndecidedElsewhere' ; cap:noMeasurement false }
        WHERE { $this cap:observedValue ?v ; cap:comparedWith ?e . ?e cap:measuredUpTo ?m ; cap:undecidedFrom ?u . FILTER(?v <= ?m && ?v >= ?u)
                BIND(IRI(CONCAT(STR($this), '__notice')) AS ?n) }""" ] .

# ==== file variant_definitions_check_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- definitions check rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_definitions.build, which refused a variable defined twice and a substitution inside a definition, and
# warned about a terminal that does not start with a lower-case letter). The model of definitions is written as facts, one entry
# per written definition; these rules mark the entries to refuse and the terminals to warn about. Python reads the marks and says them.
# A substitution is searched through every form an expression is written in, the condition of a 'when' included.

<http://example.org/vaf-consolidated/definitions-check-rules>
    rdfs:label "Definitions check rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

va:DefinedTwiceRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionEntry ; rdfs:label "A variable written a second time is refused at that second definition"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/definitions-check-rules> ; sh:construct """
        CONSTRUCT { $this va:refusedAs va:Refusal_DefinedTwice }
        WHERE { $this va:entryOf ?m ; va:entryDefines ?v ; va:entryIndex ?i .
                ?o va:entryOf ?m ; va:entryDefines ?v ; va:entryIndex ?j . FILTER(?j < ?i) }""" ] .

va:SubstitutionInDefinitionRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionEntry ; rdfs:label "A substitution inside a definition is refused (it is a statement over a block, not an expression)"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/definitions-check-rules> ; sh:construct """
        CONSTRUCT { $this va:refusedAs va:Refusal_Substitution }
        WHERE { $this va:entryRoot ?r .
                ?r (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression)* ?s . ?s a va:ReplacementOperator .
                FILTER NOT EXISTS { $this va:refusedAs ?x } }""" ] .

va:UnconventionalTerminalRuleShape a sh:NodeShape ; sh:targetClass va:DefinitionModel ; rdfs:label "A terminal whose name does not start with a lower-case letter is reported"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/definitions-check-rules> ; sh:construct """
        CONSTRUCT { $this va:hasUnconventionalTerminal ?t }
        WHERE { ?e va:entryOf $this ; va:entryRoot ?r .
                ?r (va:hasLeftOperand|va:hasRightOperand|va:hasOperand|va:hasListItem|va:hasConditionExpression|va:appliesTo)* ?t .
                ?t a va:Feature ; rdfs:label ?n . FILTER NOT EXISTS { $this va:definesVariable ?t }
                FILTER(!REGEX(STR(?n), "^\\\\p{Ll}")) }""" ] .

# ==== file variant_feedback_loop_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- feedback loop rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_feedback.FeedbackLoop.run, which decided after every attempt whether the loop goes on). A session (va:FeedbackSession) records
# a loop (va:FeedbackLoop: the largest number of attempts, whether a terminal failure stops it) and its attempts, each with the verdict it was issued and,
# once the failure is diagnosed, the diagnostic. The rules decide: a variant the blacklist excludes ends BLACKLISTED before any attempt; a verdict that
# is a pass or a warning ends SUCCESS; any other verdict has to be diagnosed (va:attemptNeedsDiagnosis); a diagnosed failure that is terminal, when the
# loop stops on terminal failures, ends ABORTED_TERMINAL; any other diagnosed failure at the last attempt ends EXHAUSTED. A session with no
# va:terminationReason after the attempt is decided goes on with another attempt. Python runs the synthesis and the verification, diagnoses a failure,
# writes the facts, runs the rules and builds the refinement hint (variant_feedback).

<http://example.org/vaf-consolidated/feedback-loop-rules>
    rdfs:label "Feedback loop rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:LoopBlacklistedRuleShape a sh:NodeShape ; sh:targetClass va:FeedbackSession ; rdfs:label "A variant the blacklist excludes ends the session before any attempt"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-loop-rules> ; sh:construct """
        CONSTRUCT { $this va:terminationReason 'BLACKLISTED' }
        WHERE { $this va:variantBlacklisted true . FILTER NOT EXISTS { $this va:hasAttempt ?a } }""" ] .

va:LoopSuccessRuleShape a sh:NodeShape ; sh:targetClass va:FeedbackSession ; rdfs:label "A pass or a warning ends the session as a success"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-loop-rules> ; sh:construct """
        CONSTRUCT { $this va:terminationReason 'SUCCESS' }
        WHERE { $this va:hasAttempt ?a . ?a va:attemptVerdict/va:verdictOutcome ?o . FILTER(?o IN ('PASS', 'WARN')) }""" ] .

va:AttemptDiagnosisRuleShape a sh:NodeShape ; sh:targetClass va:FeedbackAttempt ; rdfs:label "A verdict that is neither a pass nor a warning has to be diagnosed"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-loop-rules> ; sh:construct """
        CONSTRUCT { $this va:attemptNeedsDiagnosis true }
        WHERE { $this va:attemptVerdict/va:verdictOutcome ?o . FILTER(?o NOT IN ('PASS', 'WARN')) }""" ] .

va:LoopAbortRuleShape a sh:NodeShape ; sh:targetClass va:FeedbackSession ; rdfs:label "A terminal failure ends the session when the loop stops on terminal failures"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-loop-rules> ; sh:construct """
        CONSTRUCT { $this va:terminationReason 'ABORTED_TERMINAL' }
        WHERE { $this va:recordsLoop ?l ; va:hasAttempt ?a . ?l va:abortOnTerminal true .
                ?a va:attemptNeedsDiagnosis true ; va:hasDiagnostic ?d . ?d va:isTerminal true }""" ] .

va:LoopExhaustedRuleShape a sh:NodeShape ; sh:targetClass va:FeedbackSession ; rdfs:label "A diagnosed failure at the last attempt that does not stop the loop ends the session as exhausted"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/feedback-loop-rules> ; sh:construct """
        CONSTRUCT { $this va:terminationReason 'EXHAUSTED' }
        WHERE { $this va:recordsLoop ?l ; va:hasAttempt ?a . ?l va:maxAttempts ?m ; va:abortOnTerminal ?stopsOnTerminal .
                ?a va:attemptNeedsDiagnosis true ; va:attemptNumber ?n ; va:hasDiagnostic ?d . ?d va:isTerminal ?terminal .
                FILTER(?n >= ?m && !(?stopsOnTerminal && ?terminal)) }""" ] .

# ==== file variant_loop_bound_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix py: <http://example.org/python-ast#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- loop bound rules v1.0.0 (VAF-WI-114, 2026-09-28)
# C32 as a SHACL-AF rule over a harvested syntax tree (09-declarative-calculi/harvester_python_syntax_tree_v1_0_0.py).
# Moved from Python (variant_loop_bound_calculi_v1_0_0.py, now a wrapper that reads this rule's results). The Python
# found the loops through a control-flow library (staticfg); the rule reads the syntax tree, so it also sees the loops
# that library left out (after a return, in a loop's else branch, in a method whose name is used again in the module)
# and does not fail where the library failed. Each difference from the Python is recorded with its reason in
# 12-experiments/calculi_on_rules_deviations_v1_0_0.json.

<http://example.org/vaf-consolidated/loop-bound-rules>
    rdfs:label "Loop bound rules (C32)"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-09-28"^^xsd:date ;
    owl:imports <http://example.org/variant-algebra/harvest-vocabulary> , <http://example.org/python-ast> ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "py" ; sh:namespace "http://example.org/python-ast#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:C32LoopBoundRuleShape a sh:NodeShape ; sh:targetClass py:ClassDef ; rdfs:label "C32: loop bound"@en ;
    rdfs:comment "In a method of a class (a function in the class's body), a for-loop over range(N), N an integer literal and the only argument, whose body calls append or add on an attribute of self, bounds from above how many elements that loop adds to the attribute: at most N (an upper bound from that one loop; no claim about a lower bound or other code). One fact per loop and call."@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/loop-bound-rules> ; sh:construct """
        CONSTRUCT { ?fact a va:LoopBound ; va:boundClass $this ; va:boundMethod ?mn ; va:boundAttribute ?attr ; va:maxBound ?n ;
                          va:boundLoop ?for ; va:boundCall ?call }
        WHERE { $this py:body ?m . ?m a py:FunctionDef ; py:name ?mn .
                ?m py:body/py:child* ?for . ?for a py:For ; py:iter ?it .
                ?it a py:Call ; py:func ?rf ; py:args ?a0 . ?rf a py:Name ; py:id 'range' .
                ?a0 py:index 0 ; a py:Constant ; py:value ?n . FILTER(DATATYPE(?n) = xsd:integer)
                FILTER NOT EXISTS { ?it py:args ?a1 . ?a1 py:index 1 }
                ?for py:body/py:child* ?call . ?call a py:Call ; py:func ?fa .
                ?fa a py:Attribute ; py:attr ?op ; py:value ?sv . FILTER(?op IN ('append', 'add'))
                ?sv a py:Attribute ; py:attr ?attr ; py:value ?s . ?s a py:Name ; py:id 'self'
                BIND(IRI(CONCAT(STR(?for), '__bound__', ENCODE_FOR_URI(STR(?call)))) AS ?fact) }""" ] .


# ==== file variant_pipeline_run_rules_v1_0_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Variant Algebra -- pipeline run rules v1.0.0 (VAF-WI-256, 2026-10-21).
# Moved from Python (variant_pipeline_workflow.run_pipeline, which decided after every stage what its verdict is, whether the run goes on, why and where it stops).
# The run (va:DiscoverySynthesisPipeline) is given the facts of each stage as the runner meets them: the stage result with its name (va:stageName), whether the
# gates held over the record (va:gatesPassed), what the stage found (the number of accepted features, the exact count and whether counting was undecided, the
# number of variants, the artifact facts, the checks, the execution verdict and its detail) and the ordered parts of any reason (va:ReasonPart). The rules state:
# each stage's verdict; the variant the synthesis step realises (the one asked for, held to the last, or the first that selects a feature, else the first); the
# synthesis verdict; whether the run stops, with the stop reason and the stage's label; the capacity stop; and the outcome (Completed once the feedback stage
# exists, Stopped when a stop is stated without it). A failed gate stops a run before its verdict does. Python walks the stages, calls the tools, writes the
# facts, runs these rules and reads the answer; it decides nothing.

<http://example.org/vaf-consolidated/pipeline-run-rules>
    rdfs:label "Pipeline run rules"@en ;
    owl:versionInfo "1.0.0" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    sh:declare [ sh:prefix "va" ; sh:namespace "http://example.org/variant-algebra#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] .

va:DiscoveryVerdictAcceptRuleShape a sh:NodeShape ; sh:targetClass va:DiscoveryResult ; rdfs:label "Discovery is accepted when review accepted a detected fact"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:hasDiscoveryVerdict va:Verdict_Accept }
        WHERE { $this va:acceptedFeatureCount ?n . FILTER(?n > 0) }""" ] .

va:DiscoveryVerdictRejectRuleShape a sh:NodeShape ; sh:targetClass va:DiscoveryResult ; rdfs:label "Discovery is rejected when no detected fact was accepted, or when it failed"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:hasDiscoveryVerdict va:Verdict_Reject }
        WHERE { FILTER NOT EXISTS { $this va:acceptedFeatureCount ?n . FILTER(?n > 0) } }""" ] .

va:ProcessingVerdictRuleShape a sh:NodeShape ; sh:targetClass va:ProcessingResult ; rdfs:label "Processing is Counted, Void, Undecided or Not counted by the exact count"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:hasProcessingVerdict ?v }
        WHERE { OPTIONAL { $this va:exactVariantCount ?n }
                OPTIONAL { $this va:countUndecided ?u }
                BIND(IF(BOUND(?n), IF(?n = 0, va:ProcessingVerdict_Void, va:ProcessingVerdict_Counted),
                        IF(BOUND(?u) && ?u, va:ProcessingVerdict_Undecided, va:ProcessingVerdict_NotCounted)) AS ?v) }""" ] .

va:ProcessingReasonRuleShape a sh:NodeShape ; sh:targetClass va:ProcessingResult ; rdfs:label "A model that was not counted gives the reason of the evaluator, or says it gave none"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:notCountedBecause ?r }
        WHERE { FILTER NOT EXISTS { $this va:exactVariantCount ?n }
                OPTIONAL { $this va:hasReasonPart ?p . ?p va:partKind 'detail' ; va:partText ?t }
                BIND(IF(BOUND(?t) && ?t != '', ?t, 'the evaluator gave no reason') AS ?r) }""" ] .

va:ConversionVerdictRuleShape a sh:NodeShape ; sh:targetClass va:ConversionResult ; rdfs:label "Conversion is accepted when the enumeration produced a variant"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:hasConversionVerdict ?v }
        WHERE { $this va:enumeratedVariantCount ?n . BIND(IF(?n > 0, va:Verdict_Accept, va:Verdict_Reject) AS ?v) }""" ] .

va:ChosenVariantRequestedRuleShape a sh:NodeShape ; sh:targetClass va:ConversionResult ; rdfs:label "The variant asked for is realised, held to the last variant"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:chosenVariantPosition ?c }
        WHERE { ?run va:hasConversionStage $this ; va:requestedVariantPosition ?r . $this va:enumeratedVariantCount ?n .
                BIND(IF(?r < ?n - 1, ?r, ?n - 1) AS ?c) }""" ] .

va:ChosenVariantDefaultRuleShape a sh:NodeShape ; sh:targetClass va:ConversionResult ; rdfs:label "With no variant asked for, the first variant that selects a feature is realised, else the first"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:chosenVariantPosition ?c }
        WHERE { ?run va:hasConversionStage $this . FILTER NOT EXISTS { ?run va:requestedVariantPosition ?r }
                OPTIONAL { SELECT $this (MIN(?q) AS ?first) WHERE { $this va:yieldsVariant ?v . ?v va:variantPosition ?q ; va:selectionSize ?k . FILTER(?k > 0) } GROUP BY $this }
                BIND(COALESCE(?first, 0) AS ?c) }""" ] .

va:SynthesisVerdictRuleShape a sh:NodeShape ; sh:targetClass va:SynthesisResult ; rdfs:label "Synthesis fails without a sound artifact, warns when the realised variant demonstrates nothing, else passes"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:hasSynthesisVerdict ?v }
        WHERE { ?run va:hasSynthesisStage $this ; va:hasConversionStage ?conv . ?conv va:chosenVariantPosition ?i ; va:yieldsVariant ?cv .
                ?cv va:variantPosition ?i ; va:selectionSize ?k .
                $this va:synthesisBackend ?b ; va:artifactProduced ?a ; va:omittedFeatureCount ?om ; va:realisationVerified ?rv ; va:behaviourRemoved ?br .
                BIND(?b = 'realise' AS ?realise)
                BIND(?a && IF(?realise, ?rv, ?om = 0) AS ?passed)
                BIND(?k = 0 || (?realise && ?br) AS ?empty)
                BIND(IF(!?passed, va:SynthesisVerdict_Fail, IF(?empty, va:SynthesisVerdict_Warn, va:SynthesisVerdict_Pass)) AS ?v) }""" ] .

va:RunCompletedRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A run that reached its feedback stage is completed"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 1 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:runOutcome 'Completed' }
        WHERE { $this va:hasFeedbackStage ?f }""" ] .

va:GateStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A record that fails a gate stops the run at its stage, before the stage's own verdict does"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt ?label ; va:stopReason ?reason }
        WHERE { $this ?h ?s . ?s va:stageName ?n ; va:gatesPassed false .
                OPTIONAL { SELECT ?s (GROUP_CONCAT(?t; separator='; ') AS ?joined) WHERE {
                    { SELECT ?s ?t WHERE { ?s va:hasReasonPart ?p . ?p va:partKind 'gate' ; va:partText ?t ; va:listPosition ?i } ORDER BY ?s ?i } } GROUP BY ?s }
                BIND(CONCAT(UCASE(SUBSTR(?n, 1, 1)), SUBSTR(?n, 2)) AS ?label)
                BIND(STRLANG(CONCAT('gate failed -- ', COALESCE(?joined, '')), 'en') AS ?reason) }""" ] .

va:DiscoveryStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A rejected discovery stops the run, with the failure or the absence of an accepted fact as the reason"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Discovery' ; va:stopReason ?reason }
        WHERE { $this va:hasDiscoveryStage ?s . ?s va:gatesPassed true ; va:hasDiscoveryVerdict va:Verdict_Reject .
                OPTIONAL { ?s va:hasReasonPart ?p . ?p va:partKind 'detail' ; va:partText ?t }
                BIND(STRLANG(CONCAT('discovery rejected -- ', COALESCE(?t, 'no detected fact was accepted by review')), 'en') AS ?reason) }""" ] .

va:ProcessingStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A model that was not counted, or that admits no variant, stops the run"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Processing' ; va:stopReason ?reason }
        WHERE { $this va:hasProcessingStage ?s . ?s va:gatesPassed true ; va:hasProcessingVerdict ?v .
                FILTER(?v != va:ProcessingVerdict_Counted)
                OPTIONAL { ?s va:hasReasonPart ?p . ?p va:partKind 'detail' ; va:partText ?t }
                BIND(STRLANG(IF(?v = va:ProcessingVerdict_Void, 'processing found that the model admits no variant', CONCAT('model not counted -- ', COALESCE(?t, 'None'))), 'en') AS ?reason) }""" ] .

va:ConversionStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A conversion that produced no variant stops the run"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Conversion' ; va:stopReason 'conversion rejected -- enumeration produced no variant'@en }
        WHERE { $this va:hasConversionStage ?s . ?s va:gatesPassed true ; va:hasConversionVerdict va:Verdict_Reject }""" ] .

va:SynthesisStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A synthesis that failed its verdict stops the run"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 3 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Synthesis' ; va:stopReason 'synthesis failed its verdict'@en }
        WHERE { $this va:hasSynthesisStage ?s . ?s va:gatesPassed true ; va:hasSynthesisVerdict va:SynthesisVerdict_Fail }""" ] .

va:VerificationStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A variant or artifact that was not verified stops the run, naming the failed checks"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Verification' ; va:stopReason ?reason }
        WHERE { $this va:hasVerificationStage ?s . ?s va:gatesPassed true ; va:hasVerificationVerdict va:VerificationVerdict_NotVerified .
                OPTIONAL { SELECT ?s (GROUP_CONCAT(?line; separator='; ') AS ?joined) WHERE {
                    { SELECT ?s ?line WHERE { ?c va:verificationCheckOf ?s ; va:checkSeverity 'Failure' ; va:checkPassed false ; va:checkName ?nm ; va:checkDetail ?d ; va:listPosition ?i .
                                              BIND(CONCAT(?nm, ': ', ?d) AS ?line) } ORDER BY ?s ?i } } GROUP BY ?s }
                BIND(STRLANG(CONCAT('the variant or the artifact was not verified -- ', COALESCE(?joined, '')), 'en') AS ?reason) }""" ] .

va:ExecutionStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "An artifact that did not run stops the run, with the detail of the execution as the reason"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Execution' ; va:stopReason ?reason }
        WHERE { $this va:hasExecutionStage ?s . ?s va:gatesPassed true ; va:hasExecutionVerdict va:ExecutionVerdict_Failed ; va:executionDetail ?d .
                BIND(STRLANG(CONCAT('the artifact did not run -- ', ?d), 'en') AS ?reason) }""" ] .

va:ProjectCapacityStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A project beyond what was measured stops the run before discovery when the run was asked to stop on it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Run' ; va:stopReason ?reason }
        WHERE { $this va:capacityMode 'stop' .
                { SELECT (GROUP_CONCAT(?t; separator='; ') AS ?joined) WHERE {
                    { SELECT ?t WHERE { ?n va:noticeBeforeStep va:Step_Discovery ; va:noticeText ?t ; va:listPosition ?i } ORDER BY ?i } } HAVING (COUNT(?t) > 0) }
                BIND(STRLANG(CONCAT('the project is beyond what VAF was measured to handle and the run was asked to stop on that -- ', ?joined), 'en') AS ?reason) }""" ] .

va:ModelCapacityStopRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A model beyond what was measured stops the run before processing when the run was asked to stop on it"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 2 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:stoppedAt 'Run' ; va:stopReason ?reason }
        WHERE { $this va:capacityMode 'stop' .
                { SELECT (GROUP_CONCAT(?t; separator='; ') AS ?joined) WHERE {
                    { SELECT ?t WHERE { ?n va:noticeBeforeStep va:Step_Processing ; va:noticeText ?t ; va:listPosition ?i } ORDER BY ?i } } HAVING (COUNT(?t) > 0) }
                BIND(STRLANG(CONCAT('the model is beyond what VAF was measured to handle and the run was asked to stop on that -- ', ?joined), 'en') AS ?reason) }""" ] .

va:RunStoppedRuleShape a sh:NodeShape ; sh:targetClass va:DiscoverySynthesisPipeline ; rdfs:label "A run stopped before its feedback stage has the outcome Stopped"@en ;
    sh:rule [ a sh:SPARQLRule ; sh:order 4 ; sh:prefixes <http://example.org/vaf-consolidated/pipeline-run-rules> ; sh:construct """
        CONSTRUCT { $this va:runOutcome 'Stopped' }
        WHERE { $this va:stopReason ?r . FILTER NOT EXISTS { $this va:hasFeedbackStage ?f } }""" ] .
