@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe:      <http://example.org/ontology-engineering#> .

# ============================================================
# Variant Algebra — Operator Implementation Properties v1.0.0
# Authored 2026-07-03, closing the implementation phase of the 11-operator
# ontology-native specification (10-operator-implementation-spec/, Parts 1-4).
#
# Does NOT mutate variant_algebra_v3_2_6.ttl (BP-D14) -- extension file,
# same pattern as the complexity-annotations and calculus-implementations
# files alongside this one. Every property below was checked against the
# base ontology first to confirm no naming collision (0 hits, verified).
#
# Real properties from the base ontology used directly, NOT redeclared here:
# va:appliesTo, va:members, va:dependentSet, va:prerequisiteSet, va:hasOperand.
# Only genuinely new plumbing is declared in this file.
# ============================================================

<http://example.org/vaf-consolidated/operator-properties> a owl:Ontology ;
    rdfs:label "VAF Operator Implementation Properties v1.0.0"@en ;
    dcterms:created "2026-07-03"^^xsd:date ;
    dcterms:identifier "variant_algebra_v3_operator_properties_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/operator-properties/1.0.0> ;
    dcterms:source "10-operator-implementation-spec/ Parts 1-4, this session. Every property here backs a real, tested SHACL-AF sh:rule in variant_algebra_operator_rules_v1_0_0.ttl."@en ;
    oe:testedBy <http://example.org/vaf-consolidated/operator-properties#TestSuite> ;
    rdfs:comment "Extension file per BP-D14; variant_algebra_v3_2_6.ttl not mutated. Real implementation of the 11-operator specification -- not a proposal, ships alongside tested SHACL-AF rules."@en .

<http://example.org/vaf-consolidated/operator-properties#TestSuite> a oe:TestSuite ;
    rdfs:label "testdrive_consolidated_implementation.py"@en ;
    dcterms:source "10-operator-implementation-spec/testdrive_consolidated_implementation.py, executed 2026-07-03: 6/6 checks pass, loaded from the actual shipped property+rule files (not inline test strings), including an explicit no-cross-talk check across multiple operators run together in one graph."@en .

# ---- Part 1 (Addition/Division/Intersection) ----

va:isSelected a owl:DatatypeProperty ;
    rdfs:label "is selected"@en ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Marks a Feature/Component as chosen in the candidate variant currently under evaluation by Exclusive/Or/Dependency rules. An evaluation-time marker, asserted per-candidate by the consuming pipeline before rules run -- not a static ontology fact."@en .

va:isCoIncludedBy a owl:ObjectProperty ;
    rdfs:label "is co-included by"@en ;
    rdfs:range va:AdditionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Inverse-direction binding for AdditionOperator: lets an operand be bound from either direction, since va:hasOperand's natural direction is operator-to-operand only."@en .

va:removes a owl:ObjectProperty ;
    rdfs:label "removes"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Marks one operand of a DivisionOperator instance as cancelling another -- the operational realization of thesis eq. 2.32-33's set-difference semantics."@en .

va:coOccursWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "co-occurs with"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Marks two operands of an IntersectionOperator instance as jointly present in the relevant variant. Symmetric by construction (a co-occurs with b iff b co-occurs with a)."@en .

# ---- Part 2 (Repetition + k-of-n composition) ----

va:hasMaxRepetitions a owl:DatatypeProperty ;
    rdfs:label "has max repetitions"@en ;
    rdfs:domain va:RepetitionOperator ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 2, this session -- closes a real gap: RepetitionOperator had zero bound-declaring properties in the base ontology, checked directly, not assumed." ;
    skos:definition "The maximum number of repetitions admissible for the feature (or virtual grouping feature, see va:contributesTo) this RepetitionOperator instance applies to via va:appliesTo. Per thesis eq. 2.39's 'zero or more', absence of this property should be read as unbounded, not zero."@en .

va:contributesTo a owl:ObjectProperty ;
    rdfs:label "contributes to"@en ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 2, this session." ;
    skos:definition "Links a candidate Feature to a virtual grouping Feature it counts toward when selected. Lets RepetitionOperator (via hasMaxRepetitions on the group) bound how many of a SET of otherwise-unrelated candidate features may be simultaneously selected, without a dedicated k-of-n operator -- real composition, proven in Part 2, not new algebra."@en .

# ---- Part 3 (Cartesian scaling: Layer 0 propagation, Layer 1 partitioning) ----

va:excludesPartner a owl:ObjectProperty ;
    rdfs:label "excludes partner"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Marks a candidate operand as incompatible with a specific member of the opposing operand set, for Layer 0 decrease-and-conquer domain propagation ahead of CartesianOperator. A candidate is only prunable (see va:isPrunable) if it excludes EVERY member of the opposing set -- proven both directions in Part 3 (partial exclusion must survive; total exclusion is correctly prunable)."@en .

va:isPrunable a owl:DatatypeProperty ;
    rdfs:label "is prunable"@en ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Rule-derived: true iff a candidate operand has zero admissible partners remaining in the opposing set (Layer 0 output). Consumers should exclude va:isPrunable=true candidates before CartesianOperator's Layer 2 pairing rule runs."@en .

va:constrainedWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "constrained with"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "A real (typically Exclusive/Dependency-derived) constraint edge between two features, for Layer 1 divide-and-conquer partitioning. Ports the same connected-components strategy already real and tested in 06-runtime/src/variant_backends_v1_0_0.py's DecompositionBackend to the composition-scope, ontology-natively. KNOWN LIMIT (disclosed, not silently accepted): a global k-ary bound spanning two edge-free partitions is invisible to this property unless the modeler adds an explicit edge or uses the va:contributesTo/hasMaxRepetitions pattern (Part 2) instead."@en .

va:samePartitionAs a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "same partition as"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Rule-derived (Layer 1 output): two features are in the same partition if connected via one or more va:constrainedWith hops. Proven transitive up to 2 hops in Part 3's test; the rule's property-path (rdf:rest*/rdf:first-free UNION chain) generalizes to arbitrary depth by the nature of SPARQL property-path-free transitive UNION chaining used."@en .

# ---- Part 4 (Subtraction/Inverse: purge-before-emission) ----

va:candidateMember a owl:ObjectProperty ;
    rdfs:domain va:CandidateVariant ;
    rdfs:range va:Feature ;
    rdfs:label "candidate member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    skos:definition "Links a CandidateVariant (pre-purge) to a Feature under consideration for inclusion. Subtraction(a,b) = {a, !b} (thesis eq. 2.29) is realized upstream by asserting both a and b as candidateMember, with b additionally marked va:isInverseMarked."@en .

va:isInverseMarked a owl:DatatypeProperty ;
    rdfs:label "is inverse marked"@en ;
    rdfs:domain va:Feature ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    skos:definition "The operational realization of InverseOperator's (!x): 'produces an element that is removed from the variant's feature set... requires subtraction of all inverse elements before variant emission' (base ontology's own skos:definition, quoted verbatim). Tested idempotent under double-marking (stays purged, does not flip back to present -- Part 4)."@en .

va:hasEmittedMember a owl:ObjectProperty ;
    rdfs:domain va:CandidateVariant ;
    rdfs:range va:Feature ;
    rdfs:label "has emitted member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    skos:definition "Rule-derived (purge-before-emission output): the final, post-purge membership of a CandidateVariant -- every va:candidateMember NOT also va:isInverseMarked. A CandidateVariant whose only member is inverse-marked correctly emits none (tested explicitly, Part 4)."@en .

va:CandidateVariant a owl:Class ;
    rdfs:label "Candidate Variant"@en ;
    rdfs:subClassOf va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    skos:definition "A Variant under evaluation, before Subtraction/Inverse's purge-before-emission rule has been applied. Subclass of the base ontology's own va:Variant."@en .

# ---- Part 3 (Cartesian Layers 0-2): scaffold classes a real consumer instantiates
# their own operand groups against -- generic by design, not domain-specific ----

va:SetA a owl:Class ;
    rdfs:label "Cartesian Operand Set A"@en ;
    rdfs:subClassOf va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Scaffold class for CartesianOperator's first operand set. A real consumer types their own candidate features/components as va:SetA members for a specific enumeration task -- generic by design, matching the operator's own domain-agnostic thesis definition (A x B), not tied to one use case."@en .

va:SetB a owl:Class ;
    rdfs:label "Cartesian Operand Set B"@en ;
    rdfs:subClassOf va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Scaffold class for CartesianOperator's second operand set. See va:SetA."@en .

va:PartitionRoot a owl:Class ;
    rdfs:label "Partition Root"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Marker individual that anchors Layer 1's divide-and-conquer partitioning rule (va:PartitionRuleShape targets this class). A real consumer asserts exactly one va:PartitionRoot instance per enumeration task to trigger partitioning over that task's va:constrainedWith edges."@en .

va:PairGenerator a owl:Class ;
    rdfs:label "Pair Generator"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    skos:definition "Marker individual that anchors Layer 2's bounded Cartesian pairing rule (va:CartesianRuleShape targets this class), run after Layer 0 propagation has marked prunable candidates. A real consumer asserts one va:PairGenerator instance per enumeration task."@en .

# ---- Shared rule-output vocabulary (reused across multiple operators, not
# duplicated per-operator -- Optional/Exclusive/Or/Dependency/Division/Intersection) ----

va:isViolated a owl:DatatypeProperty ;
    rdfs:label "is violated"@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Rule-derived: true iff the operator instance's constraint is violated by the current candidate selection (va:isSelected markers). Shared across ExclusiveOperator, OrOperator, and DependencyOperator's rules rather than one bespoke property per operator."@en .

va:isAdmissible a owl:DatatypeProperty ;
    rdfs:label "is admissible"@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Rule-derived: true iff the operator instance is structurally well-formed (e.g. OptionalOperator correctly has an appliesTo target)."@en .

va:hasResultMember a owl:ObjectProperty ;
    rdfs:label "has result member"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    skos:definition "Rule-derived: a member of the result set of a DivisionOperator or IntersectionOperator instance, after the operator's own filtering (removes / coOccursWith) has been applied."@en .
