# ==== file toy_harness_v1_0_1.ttl ====
@prefix va:  <http://example.org/variant-algebra#> .
@prefix toy: <http://example.org/variant-algebra/toy-harness#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/vaf-domain/module/toy_harness> <http://purl.org/dc/terms/identifier> "toy_harness_v1_0_1"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "toy_harness"@en ;
    <http://www.w3.org/2002/07/owl#versionInfo> "1.0.1" .

#################################################################
# toy_harness_v1_0_1.ttl — real, minimal, explicitly non-usable
# proof harness for WI_ToyHarnessProof / Obj_MetaLevelSubstantive.
#
# Deliberately, explicitly NOT a real product facet -- a recipe
# domain, chosen because it shares zero real structure with software
# (no code, no execution, no files) while still genuinely needing
# "things composed of things," the exact shape va:GenericUnit exists
# to support without forcing membership in va:SoftwareUnit's own
# thesis-scoped Ψ.
#
# Real, honest finding along the way: va:hasFeature (the property
# that would normally link a composed thing to its parts) has
# rdfs:domain va:ComposableUnit / rdfs:range va:Feature -- genuinely
# software-scoped, not usable here without pulling toy instances into
# the software hierarchy by RDFS entailment. toy:carries below is a
# new, minimal, domain-neutral property with domain/range va:GenericUnit
# instead, built ONLY for this harness -- va:GenericUnit itself and
# every existing property on it are completely untouched.
#################################################################

toy:Recipe a owl:Class ;
    rdfs:subClassOf va:GenericUnit ;
    rdfs:label "Recipe (toy)"@en ;
    skos:definition "A composed, non-software thing -- explicitly NOT va:SoftwareUnit, va:ComposableUnit, or va:Feature. Exists only to prove GenericUnit alone is sufficient for a real, non-software domain." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/toy_harness> .

toy:Ingredient a owl:Class ;
    rdfs:subClassOf va:GenericUnit ;
    rdfs:label "Ingredient (toy)"@en ;
    skos:definition "A carried, non-software thing -- explicitly NOT va:Feature. Same real relationship shape (a composed thing carries parts) as Feature/ComposableUnit, using only GenericUnit." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/toy_harness> .

toy:carries a owl:ObjectProperty ;
    rdfs:domain va:GenericUnit ;
    rdfs:range va:GenericUnit ;
    rdfs:label "carries (toy)"@en ;
    skos:definition "A new, minimal, domain-neutral relationship built for this harness only, with domain/range va:GenericUnit -- not va:hasFeature, which is genuinely software-scoped (domain va:ComposableUnit, range va:Feature) and would pull toy instances into the software hierarchy by RDFS entailment if reused here." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/toy_harness> .

# ==== file vaf_invariants_v1_1_2.ttl ====
@prefix : <http://example.org/vaf/invariants#> .
@prefix vai: <http://example.org/vaf/invariants#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix vax: <http://example.org/variant-algebra-shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix redo: <http://example.org/redo#> .
@prefix oe: <http://example.org/ontology-engineering#> .




<http://example.org/vaf/invariants> rdfs:label "Variant Algebra Framework — Goal Invariants v1.1.0"@en ;
    oe:testedBy vai:GoalInvariantTestSuite ;
    dcterms:created "2026-05-01"^^xsd:date ;
    dcterms:creator "Yusuf Altunel"@en ;
    dcterms:description "Addresses Concern #1 from 2026-05-01 decision pack with the conditional-lock correction. Layer 1 (document discipline) is blueprint_v3_0_4.md + vaf_backlog_v1_1_0.md + PROV-O. Layer 2 (mechanical enforcement) is this file. v1.1.0 changes Lock_5_ClosedOperatorSet from 'forbid any operator outside the 12-leaf list' to 'require any new operator to declare semantic non-overlap evidence and a calculi-need justification before the SHACL gate accepts it'."@en ;
    dcterms:subject "CQ1: Does each blueprint lock have a SHACL gate that detects drift?"@en,
        "CQ2: Does Lock_5 permit new operators when calculi need cannot be answered by existing ones?"@en,
        "CQ3: Is the gate testable as 'pyshacl invariants_shape.ttl repo-graph.ttl'?"@en ;
    rdfs:comment "Mechanical drift-prevention layer. v1.1.0 amends Lock #5c invariant per user direction 2026-04-30T09:37:13: the operator set is NOT absolutely closed; new operators MAY be added when existing operators (composed via algebraic identities or ontology-level OperatorApplication) cannot answer a calculus need. Priority: consume existing operators first; deduplication discipline; semantic non-overlap requirement; Intersection precedent is the worked example."@en ;
    rdfs:isDefinedBy "Blueprint v3.0.4 §0.4 locks #1-#7 + user amendment 2026-04-30T09:37"@en ;
    owl:priorVersion <http://example.org/vaf/invariants/1.1.1> ;
    owl:versionIRI <http://example.org/vaf/invariants/1.1.2> ;
    owl:versionInfo "1.1.2" ;
    <http://purl.org/dc/terms/identifier> "vaf_invariants_v1_1_2"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

:VersionHistory_v1_1_0 a owl:Class ;
    rdfs:label "Version history note for v1.1.0"@en ;
    skos:definition "v1.1.0 (2026-05-01): Lock_5_ClosedOperatorSet replaced by Lock_5_ConditionalOperatorClosure to encode the user-declared principle that the operator set is closed by default but extensible when calculi need cannot be answered by existing operators. Precedent: va:IntersectionOperator was added precisely under this rule (set intersection wasn't expressible by +,-,× cleanly enough for query convenience). The new shape blocks operators that lack declared justification metadata; it does NOT block new operators absolutely. Source: user turn 2026-04-30T09:37:13 in transcript 2026-04-30-11-45-20-vaf-v752-multi-sprint.txt."@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    dcterms:source "user transcript 2026-04-30T09:37:13"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

# ============================================================================
# Invariant class
# ============================================================================

redo:Invariant a owl:Class ;
    rdfs:label "Goal Invariant"@en ;
    skos:definition "A binding commitment from a versioned goal record that MUST hold across all subsequent work; violation MUST fire a SHACL gate that fails CI."@en ;
    dcterms:source "redo_safeguard_base_v1.5.md §3 Invariants chapter"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

redo:enforcedBy a owl:ObjectProperty ;
    rdfs:label "enforced by"@en ;
    rdfs:domain redo:Invariant ;
    rdfs:range sh:NodeShape ;
    skos:definition "Links an Invariant to the SHACL shape that mechanically detects its violation."@en ;
    dcterms:source "redo_safeguard_base_v1.5.md §3 Invariants chapter"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

redo:source a owl:DatatypeProperty ;
    rdfs:label "source"@en ;
    rdfs:domain redo:Invariant ;
    rdfs:range xsd:string ;
    skos:definition "Citation to the goal-record document and section that established this invariant."@en ;
    dcterms:source "redo_safeguard_base_v1.5.md §3 Invariants chapter"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

# ============================================================================
# OPERATOR-EXTENSION VOCABULARY (new in v1.1.0)
# ----------------------------------------------------------------------------
# Per user direction 2026-04-30T09:37:13: new operators MAY be added when
# existing operators cannot express what the calculi need. To prevent ad-hoc
# additions, four metadata properties are required on any va:Operator subclass
# that is NOT in the established 12-leaf core list. The SHACL gate Lock_5
# fires only when a non-core operator class lacks one or more of these.
# ============================================================================

va:operatorJustification a owl:DatatypeProperty ;
    rdfs:label "operator justification"@en ;
    skos:definition "Required on any va:Operator subclass not in the established 12-leaf core list. A short prose statement of which calculus or which algebraic-identity expression cannot be served by composing existing operators, and why a new categorically distinct operator is the right answer rather than a va:OperatorApplication of an existing operator. Used by the Lock_5 SHACL gate to require justification metadata on new operators."@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:string ;
    dcterms:source "User turn 2026-04-30T09:37:13 + Intersection precedent"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

va:operatorSemanticNonOverlap a owl:DatatypeProperty ;
    rdfs:label "operator semantic non-overlap"@en ;
    skos:definition "Required on any non-core va:Operator subclass. Prose argument or SPARQL ASK reference proving the new operator's semantics do not duplicate any existing operator's semantics. The user-declared rule: 'priority is to consume the existing operators first, before inventing new ones, to prevent duplication of operators having the same semantics or for those that can be realized from the calculi of the algebra.' This property answers WHY existing operators don't already cover the case."@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:string ;
    dcterms:source "User turn 2026-04-30T09:37:13"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

va:notExpressibleByCalculi a owl:DatatypeProperty ;
    rdfs:label "not expressible by calculi"@en ;
    skos:definition "Required on any non-core va:Operator subclass. References (by IRI list) the calculi that need this operator, with a short note on why those calculi cannot reach the desired result by composing existing operators. The Intersection precedent: was derivable as A - (A - B) but worth naming for query convenience and direct calculus support — that's the kind of justification this property records."@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:string ;
    dcterms:source "User turn 2026-04-30T09:37:13 + Intersection precedent"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

va:approvalProvenance a owl:ObjectProperty ;
    rdfs:label "approval provenance"@en ;
    skos:definition "Required on any non-core va:Operator subclass. Points to a prov:Activity in which the operator addition was discussed, justified, and approved. The activity MUST cite the originating user turn (transcript timestamp + IRI) so the addition is traceable to a goal-record amendment, not an arbitrary code change. Mirrors the discipline by which va:IntersectionOperator was added (transcript 2026-04-24-15-17-02)."@en ;
    rdfs:domain va:Operator ;
    rdfs:range prov:Activity ;
    dcterms:source "User turn 2026-04-30T09:37:13"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

va:isCoreOperator a owl:DatatypeProperty ;
    rdfs:label "is core operator"@en ;
    skos:definition "Boolean marking an operator as part of the established 12-leaf core list (true) or as an extension (false). The 12 core operators are: AdditionOperator, SubtractionOperator, CartesianOperator, DivisionOperator, InverseOperator, IntersectionOperator, OrOperator, ExclusiveOperator, OptionalOperator, DependencyOperator, RepetitionOperator, MandatoryOperator. Extensions MUST carry isCoreOperator false explicitly so the SHACL gate distinguishes them and applies the justification-metadata requirement only to extensions."@en ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:boolean ;
    dcterms:source "User turn 2026-04-30T09:37:13"@en ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

:documentsInvariant a owl:ObjectProperty ;
    rdfs:label "invariant the note documents"@en ;
    rdfs:domain :VersionHistory_v1_1_0 ;
    rdfs:range redo:Invariant ;
    rdfs:isDefinedBy <http://example.org/vaf/invariants> ;
    skos:definition "The goal invariant that a version-history note tells the change of: v1.1.0 replaced the closed operator set by the conditionally closed one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .
:VersionHistory_v1_1_0 :documentsInvariant :Lock_5_ConditionalOperatorClosure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
redo:Invariant rdfs:subClassOf va:Concept ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/invariants> .

# ==== file vaf_version_conformance_vocabulary_v1_0_2.ttl ====
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix vx:   <http://example.org/vaf/version-conformance#> .


<http://example.org/vaf/version-conformance> rdfs:label "VAF version-conformance vocabulary (T-Box)"@en ;
    owl:versionInfo "1.0.2" ;
    owl:versionIRI <http://example.org/vaf/version-conformance/1.0.2> ;
    owl:priorVersion <http://example.org/vaf/version-conformance/1.0.1> ;
    rdfs:comment "VAF-WI-194. The terms in which the version rules of BP-D7 are stated as data: an inventory of the ontology files and the versioned files of a repository, and the exclusions each rule honours. The rules themselves are the shapes file; the inventory is built from the files by SPARQL (and, for the git blob ids, one thin Python step: git has no RDF interface)."@en ;
    <http://purl.org/dc/terms/identifier> "vaf_version_conformance_vocabulary_v1_0_2"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

vx:OntologyFile a owl:Class ;
    rdfs:subClassOf vx:VersionedFile ;
    rdfs:comment "A tracked Turtle file holding exactly one owl:Ontology header, in scope of the header rule."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:VersionedFile a owl:Class ;
    rdfs:comment "A tracked file whose name carries a version token (_vX_Y_Z), in scope of the same-name rule."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:Exclusion a owl:Class ;
    rdfs:comment "A path pattern a rule does not apply to; the reason is stated on the individual."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:Rule a owl:Class ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .

vx:path a owl:DatatypeProperty ; rdfs:domain vx:VersionedFile ; rdfs:range xsd:string ;
    rdfs:comment "Repository-relative path."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:versionInfo a owl:DatatypeProperty ; rdfs:domain vx:OntologyFile ; rdfs:range xsd:string ;
    rdfs:comment "The owl:versionInfo of the file's header."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:versionIRI a owl:ObjectProperty ; rdfs:domain vx:OntologyFile ;
    rdfs:comment "The owl:versionIRI of the file's header."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:priorVersion a owl:ObjectProperty ; rdfs:domain vx:OntologyFile ;
    rdfs:comment "The owl:priorVersion of the file's header, when stated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:blobNow a owl:DatatypeProperty ; rdfs:domain vx:VersionedFile ; rdfs:range xsd:string ;
    rdfs:comment "Git blob id of the working-tree content."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:blobCommitted a owl:DatatypeProperty ; rdfs:domain vx:VersionedFile ; rdfs:range xsd:string ;
    rdfs:comment "Git blob id of the content at HEAD."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:blobPrevious a owl:DatatypeProperty ; rdfs:domain vx:VersionedFile ; rdfs:range xsd:string ;
    rdfs:comment "Git blob id of the content at HEAD~1, when the path existed there."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:pathPattern a owl:DatatypeProperty ; rdfs:domain vx:Exclusion ; rdfs:range xsd:string ;
    rdfs:comment "A regular expression matched against the repository-relative path."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:appliesTo a owl:ObjectProperty ; rdfs:domain vx:Exclusion ; rdfs:range vx:Rule ;
    rdfs:comment "The rule the exclusion is for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:scope a owl:ObjectProperty ; rdfs:domain vx:Rule ; rdfs:range vx:VersionedFile ;
    rdfs:comment "The kind of file the rule is in scope for: the header rule for the ontology files (which are versioned files), the same-name rule for every versioned file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .

# VAF-WI-196: the record of a lineage check, in PROV-O terms (the record file is Turtle, the cache lookup a SPARQL ASK).
vx:ShaclValidation a owl:Class ; rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
    rdfs:comment "One run of the lineage's SHACL check: a prov:Activity with the content hash of what was checked, the engine, and a sh:ValidationReport it generated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:contentHash a owl:DatatypeProperty ; rdfs:domain vx:ShaclValidation ; rdfs:range xsd:string ;
    rdfs:comment "SHA-256 of the checked content: the sorted N-Quads of the lineage graph (header and own name normalised away) joined with the bytes of the vendored T-Box and shapes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:contentHashAlgorithm a owl:DatatypeProperty ; rdfs:domain vx:ShaclValidation ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:engine a owl:DatatypeProperty ; rdfs:domain vx:ShaclValidation ; rdfs:range xsd:string ;
    rdfs:comment "The validator and its versions; a different engine or version is a different check."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:lineageFile a owl:DatatypeProperty ; rdfs:domain vx:ShaclValidation ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:seconds a owl:DatatypeProperty ; rdfs:domain vx:ShaclValidation ; rdfs:range xsd:integer ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:resultCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .
vx:unacceptedViolations a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Violation-severity results beyond the ones the owner accepted; a record with any is never a pass."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
vx:VersionedFile rdfs:subClassOf <http://example.org/variant-algebra#Artifact> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/vaf/version-conformance#ShaclValidation> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: its superclass Activity (http://www.w3.org/ns/prov) is declared outside this file, so the link leaves the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf/version-conformance> .

# ==== file variant_algebra_behavioral_taxonomy_v1_0_2.ttl ====
@prefix vb:      <http://example.org/variant-algebra/behaviour#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix core:    <http://example.org/core#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra — Behavioural Mechanism Taxonomy v1.0.0 (content 1.1.0: step order corrected from 'missing' to
# 'partial' -- core 'precedes' already existed; Sequence and Next operators added by the owner's selection)
#
# Built before any behavioural operator, per the owner's ordering (2026-09-24): the mechanisms
# VAF must eventually discover, represent, process and synthesise, each anchored in what VAF
# already has. Coverage is measured, not hoped:
#   vb:representedBy  an existing VAF class, property or operator that holds the mechanism today
#   vb:discoveredBy   the detection rule that finds it today (by full name)
#   vb:coverage       covered | partial | missing
# Grounding: va:BehavioralCharacteristic (discovery taxonomy) already names execution-order facts;
# va:DiscoveryScopeLimitation records that the thesis scopes discovery to static analysis
# (Altunel 2013, pp. 735-736). Nothing here adds an operator; that is decided separately.
# ============================================================

<http://example.org/variant-algebra/behaviour> owl:versionInfo "1.0.2" ;
    owl:versionIRI <http://example.org/variant-algebra/behaviour/1.0.2> ;
    owl:priorVersion <http://example.org/variant-algebra/behaviour/1.0.1> ;
    dcterms:title "Variant Algebra — Behavioural Mechanism Taxonomy"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_behavioral_taxonomy_v1_0_2"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

vb:representedBy a owl:AnnotationProperty ; rdfs:label "represented by"@en ;
    skos:definition "The existing VAF class, property or operator that holds this mechanism today."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/behaviour> .
vb:discoveredBy a owl:AnnotationProperty ; rdfs:label "discovered by"@en ;
    skos:definition "The detection rule that finds this mechanism in source code today."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/behaviour> .
vb:coverage a owl:AnnotationProperty ; rdfs:label "coverage"@en ;
    skos:definition "covered: discovered and represented; partial: one of the two, or only in some forms; missing: neither."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/behaviour> .
vb:gapNote a owl:AnnotationProperty ; rdfs:label "gap"@en ;
    skos:definition "What is missing, in plain words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/behaviour> .

# ==== file variant_algebra_capacity_v1_0_22.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix cap:     <http://example.org/vaf-consolidated/capacity#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .


# ============================================================
# VAF capacity measurements (VAF-WI-245). What VAF was measured to handle, on named projects: the project's size in a dimension,
# whether the work finished within its budget, the seconds it took, the date, the tool and the machine. Written by
# 03-tooling/vaf_capacity_measure_v1_0_27.py; nothing here is a promise or a target. variant_capacity.expectations() reads the largest size counted and the smallest
# size not decided from these rows; a project beyond them is told so before processing starts.
# ============================================================

<http://example.org/vaf-consolidated/capacity> rdfs:label "VAF capacity measurements"@en ;
    dcterms:created "2026-10-18"^^xsd:date ;
    dcterms:identifier "variant_algebra_capacity_v1_0_22" ;
    owl:versionInfo "1.0.22" ;
    owl:versionIRI <http://example.org/vaf-consolidated/capacity/1.0.22> ;
    owl:priorVersion <http://example.org/vaf-consolidated/capacity/1.0.21> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

cap:Dimension a owl:Class ; rdfs:label "Capacity dimension"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:Measurement a owl:Class ; rdfs:label "Capacity measurement"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:ofDimension a owl:ObjectProperty ; rdfs:label "of dimension"@en ; rdfs:domain cap:Measurement ; rdfs:range cap:Dimension ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:value a owl:DatatypeProperty ; rdfs:label "size measured"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:outcome a owl:DatatypeProperty ; rdfs:label "outcome"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:string ; rdfs:comment "Counted when the work finished within its budget, Undecided when it did not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:seconds a owl:DatatypeProperty ; rdfs:label "seconds taken"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:budgetSeconds a owl:DatatypeProperty ; rdfs:label "budget in seconds"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:onProject a owl:DatatypeProperty ; rdfs:label "on project"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:structure a owl:DatatypeProperty ; rdfs:label "structure of the project"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:measuredAt a owl:DatatypeProperty ; rdfs:label "measured at"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:dateTime ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:withTool a owl:DatatypeProperty ; rdfs:label "with tool"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:onMachine a owl:DatatypeProperty ; rdfs:label "on machine"@en ; rdfs:domain cap:Measurement ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:unit a owl:DatatypeProperty ; rdfs:label "unit"@en ; rdfs:domain cap:Dimension ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:Expectation a owl:Class ; rdfs:label "Capacity expectation"@en ; rdfs:comment "What VAF is expected to handle in one dimension, read from the measurements: the largest size counted and the smallest size not decided."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:SizeCheck a owl:Class ; rdfs:label "Size check"@en ; rdfs:comment "A project's observed size in one dimension, before one pipeline step, compared with the expectation for that dimension."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:expectationOf a owl:ObjectProperty ; rdfs:label "expectation of"@en ; rdfs:domain cap:Expectation ; rdfs:range cap:Dimension ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:checkedDimension a owl:ObjectProperty ; rdfs:label "checked dimension"@en ; rdfs:domain cap:SizeCheck ; rdfs:range cap:Dimension ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:comparedWith a owl:ObjectProperty ; rdfs:label "compared with"@en ; rdfs:domain cap:SizeCheck ; rdfs:range cap:Expectation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:noticeOfCheck a owl:ObjectProperty ; rdfs:label "notice of check"@en ; rdfs:domain va:CapacityNotice ; rdfs:range cap:SizeCheck ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:observedValue a owl:DatatypeProperty ; rdfs:label "observed size"@en ; rdfs:domain cap:SizeCheck ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:beforeStage a owl:DatatypeProperty ; rdfs:label "before stage"@en ; rdfs:domain cap:SizeCheck ; rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:checkIndex a owl:DatatypeProperty ; rdfs:label "check position"@en ; rdfs:domain cap:SizeCheck ; rdfs:range xsd:integer ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:measuredUpTo a owl:DatatypeProperty ; rdfs:label "measured up to"@en ; rdfs:domain cap:Expectation ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:undecidedFrom a owl:DatatypeProperty ; rdfs:label "undecided from"@en ; rdfs:domain cap:Expectation ; rdfs:range xsd:decimal ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .
cap:noMeasurement a owl:DatatypeProperty ; rdfs:label "no measurement"@en ; rdfs:domain va:CapacityNotice ; rdfs:range xsd:boolean ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/capacity> .

# ==== file variant_algebra_definitions_v1_0_34.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- variables and their definitions v1.0.2 (extension file; the base ontology is not mutated)
# Grounded in the thesis (00-grounding-sources/): section 2.2.9.1 (Definition), section 3.5 with Figure 3.1
# and Tables 3.1-3.6, and Figures 2.13-2.15. Requested by the owner on 2026-09-26: "A variable should be defined in
# the means of other variables (non-terminals) or terminals. This should be covered in my PhD thesis and part of the
# ontology."
# Checked by 02-shacl-safeguards/variant_algebra_definitions_shacl_v2_0_0.ttl; built by
# 06-runtime/src/variant_definitions_v1_0_35.py; tested by 06-runtime/src/test_definitions_v1_0_35.py.
# ============================================================

<http://example.org/variant-algebra/definitions> owl:versionInfo "1.0.34" ;
    owl:versionIRI <http://example.org/variant-algebra/definitions/1.0.34> ;
    owl:priorVersion <http://example.org/variant-algebra/definitions/1.0.33> ;
    skos:changeNote "1.0.3 (2026-09-28, VAF-WI-119): the exclusions and dependencies a definition states hold for the whole variant, by the owner's rulings (va:Decision_CalculusFirstGlobalRelations_2026_09_28, va:Decision_WholeVariantIteration_2026_09_28), which keep the thesis's global dependency and override its local exclusion; applied by the operator rules 5.0.0."@en ;
    skos:changeNote "1.0.2 (2026-09-27, VAF-WI-106): corrects 1.0.1, which said the runtime already treats dependencies as global. It does not: the generative evaluator applies a dependency only where it is written (C = [a] + [b] + [a < b] gives {a} alone). The check behind the 1.0.1 claim passed vacuously, because c < a always brings a with it. The ontology keeps the thesis rule; applying it is to be built (VAF-WI-100)."@en ;
    skos:changeNote "1.0.1 (2026-09-27, VAF-WI-102): the scope of relations in a definition follows the thesis: dependencies are global, exclusion is local (section 2.2.9.1; also the text after eq. 2.38). The runtime did not behave so; see 1.0.2. Recorded as va:Div_C8 in variant_algebra_thesis_reconciliation_v1_0_0.ttl."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    dcterms:title "Variant Algebra -- variables and their definitions"@en ;
    dcterms:source "Altunel 2013, sections 2.2.9.1 and 3.5, Figure 3.1, Tables 3.1-3.6, Figures 2.13-2.15"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_definitions_v1_0_34"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:Variable a owl:Class ; rdfs:subClassOf va:Feature ;
    rdfs:label "Variable (non-terminal)"@en ;
    skos:definition "A name that has exactly one definition: an equation that states it in terms of other variables or of terminals, written 'Name = expression.' (thesis Figure 3.1). A component and each of its sub-components are variables."@en ;
    dcterms:source "Altunel 2013, section 3.5, Figure 3.1; section 2.2.9.1"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .

va:Definition a owl:Class ;
    rdfs:label "Definition"@en ;
    skos:definition "The one equation that defines a variable. Its expression uses the algebra's operators over other variables and terminals, and what the expression produces (an operation set: a set of entity sets, each one variant) is the variable's variants. Definitions are written from complex to simple. The exclusions and dependencies a definition states hold for the whole variant, wherever their names are supplied: a set that breaks one is not a variant (owner, va:Decision_CalculusFirstGlobalRelations_2026_09_28 and va:Decision_WholeVariantIteration_2026_09_28: [a] + [b] + [a < b] gives {} {b} {a, b}; (a $ b) + (a $ c) gives {a} {b, c}). The thesis makes dependency global and exclusion local (section 2.2.9.1: 'bağımlılıklar geneldir, dışlama ilişkisi ise yereldir'); the owner's ruling keeps the first and overrides the second (va:Div_ExclusionWholeVariant). Applied by the operator rules 5.0.0 (VAF-WI-119)."@en ;
    dcterms:source "Altunel 2013, sections 2.2.4-2.2.5 and 2.2.9.1"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .

va:hasDefinition a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain va:Variable ; rdfs:range va:Definition ;
    rdfs:label "has definition"@en ; skos:definition "The one definition of a variable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .
va:defines a owl:ObjectProperty ; owl:inverseOf va:hasDefinition ;
    rdfs:label "defines"@en ; skos:definition "The variable a definition defines."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .
va:usesName a owl:ObjectProperty ; rdfs:domain va:Definition ; rdfs:range va:Feature ;
    rdfs:label "uses name"@en ; skos:definition "A variable or terminal named in a definition's expression."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .
va:definingExpression a owl:DatatypeProperty ; rdfs:domain va:Definition ; rdfs:range xsd:string ;
    rdfs:label "defining expression"@en ; skos:definition "The definition as written in the modelling language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .
va:localVariantCount a owl:DatatypeProperty ; rdfs:domain va:Definition ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "local variant count"@en ;
    skos:definition "How many variants the definition gives when the variables it uses count as single units -- one row per variant in the thesis's Tables 3.1-3.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .

# The terminal, as the thesis states it. Enriches the class added on 2026-09-26 (L-110: enrich, do not mint a sibling).
va:TerminalFeature skos:changeNote "2026-09-27, from the thesis (section 3.5): a terminal is a basic feature -- 'temel nitelik, yani daha fazla tanımlanabilmeleri mümkün değildir' (it cannot be defined further). In a model written as definitions, a name used in a definition and not defined itself is a terminal, and its presence in variants follows from where it stands in the definition that uses it (a bare name joined by '+' is in every variant; '[ ]' makes it optional). The 2026-09-26 wording 'its presence in variants is not constrained beyond the rules that name it' remains the behaviour for models written as component statements, pending the owner's ruling."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .

# Right dependency (thesis eq. 2.38): canonical per decision D5.
va:DependencyOperator va:grammarForm "a > b (right dependency, thesis eq. 2.38): b depends on a; equal to b < a" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/definitions> .

# ==== file variant_algebra_discovery_alignment_v1_0_0.ttl ====
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdd:     <http://example.org/rdodi/domain-ontology#> .
@prefix rdr:     <http://example.org/rdodi/research-ontology#> .


# Cite-not-import alignment of the discovery ontology to RDODI and PROV-O (VAF-WI-141, 2026-10-05), the way RDODI cites VAF
# (24-vaf-adaptation/02-alignment). 0 owl:imports, 0 rdfs:subClassOf into another ontology, only skos match predicates (L-64).
# Pinned: RDODI domain ontology file domain_ontology_tbox_v1_3_0.ttl (versionInfo 1.3.0) and research ontology file
# research_ontology_tbox_v1_1_0.ttl (its header still declares versionInfo 1.0.1; see the analysis page). A close match says the
# definitions agree; a related match says they overlap or are the same idea at another grain. All are PROPOSED.
# Not aligned on purpose (the words are the same, the things are not; L-75): rdr:DiscoveryAttempt (finding literature, not
# characteristics of code), rdd:RuntimeEffect (one construct's effect, not a system's behaviour), RDODI's bibliographic authority
# tiers (reliability of a reference, not how binding a source is).

<http://example.org/vaf-consolidated/discovery-alignment> rdfs:label "VAF Discovery Ontology alignment to RDODI and PROV-O v1.0.0 (proposal)"@en ; dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:identifier "variant_algebra_discovery_alignment_v1_0_0" ; owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/discovery-alignment/1.0.0> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:Source skos:relatedMatch rdd:DomainCorpus, prov:Entity ;
    skos:note "RDODI's DomainCorpus is a whole body of material from which concepts are extracted; a VAF source is one place inside it. The grain differs, so related, not close."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-alignment> .
va:ClaimGround skos:relatedMatch rdr:VerificationStatus ;
    skos:note "RDODI's VerificationStatus says whether a claim was confirmed, disclosed as unconfirmed or left unverified. A ground says what kind of necessity a source states. Different questions; VAF's own weak, documented, confirmed and refuted grounding stays where it is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-alignment> .
va:RelationClaim skos:relatedMatch rdd:SourceProvenance ;
    skos:note "RDODI tiers the origin of a class (net new, corpus derived, aligned); a claim's grounds do this per claim, with the source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-alignment> .
va:Context skos:relatedMatch rdr:ResearchScope ;
    skos:note "A research scope bounds what is searched; a context bounds which relations hold. The CIMO frame (context, intervention, mechanism, outcome) has a context part; the match stays related only."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-alignment> .

# ==== file variant_algebra_discovery_ontology_v1_0_27.ttl ====
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- discovery ontology, v1.0.0 (VAF-WI-141, 2026-10-05)  STATUS: PROPOSAL for owner review (L-116)
#
# One place that HOLDS what discovery finds and the context it is found in: sources, context, domain-sensitive terms, the
# families of relations (beyond causality), the kinds of necessity that ground a relation, and the links that must survive a change
# of context. It does not interpret anything: interpretation is done by rules that read it (as for every other VAF taxonomy).
#
# It CONTINUES variant_algebra_discovery_taxonomy_v1_0_0.ttl (which keeps its five classes unchanged): a relation claim here is a
# va:DiscoveredCharacteristic, and its grounds extend va:hasEvidenceStrength / va:documentedAs rather than replace them (BP-D52).
# RDODI's concepts are cited, never imported (see variant_algebra_discovery_alignment_v1_0_0.ttl; L-64).
#
# Every family, ground kind, authority rank and sensitivity class below is a STIPULATION (chosen, not derived); the alternatives
# are in 04-documentation/vaf_discovery_ontology_and_rdodi_reuse_v1_0_31.md section 6.
# ============================================================

<http://example.org/vaf-consolidated/discovery-ontology> rdfs:label "VAF Discovery Ontology v1.0.0 (proposal)"@en ;
    dcterms:created "2026-10-05"^^xsd:date ;
    dcterms:identifier "variant_algebra_discovery_ontology_v1_0_27" ;
    dcterms:source "Continues variant_algebra_discovery_taxonomy_v1_0_0.ttl; picture in vaf_context_and_sources_proposal_v1_0_1.md (2.135.0)."@en ;
    owl:versionInfo "1.0.27" ;
    owl:versionIRI <http://example.org/vaf-consolidated/discovery-ontology/1.0.27> ;
    owl:priorVersion <http://example.org/vaf-consolidated/discovery-ontology/1.0.26> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------------------------------------------------------- classes
va:Source a owl:Class ; rdfs:label "Source"@en ;
    skos:definition "A place where something is written down or observed that discovery reads: a file, a record set, a document, a running program. It has a kind and an authority level."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:Context a owl:Class ; rdfs:label "Context"@en ;
    skos:definition "The situation a variant is built for, described by typed pieces (domain, organisation, jurisdiction, time and version, platform, actor and role, operational state)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ContextPiece a owl:Class ; rdfs:label "Context piece"@en ;
    skos:definition "One typed part of a context description, with the sources that describe it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DomainTerm a owl:Class ; rdfs:label "Domain term"@en ;
    skos:definition "A word or name used in the sources whose meaning may depend on the domain. It has a sensitivity class and, where the meaning differs, one meaning per context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:TermMeaning a owl:Class ; rdfs:label "Meaning of a term in a context"@en ;
    skos:definition "What a domain term means in one context; the link meaning-in keeps it from being mixed with its meaning elsewhere."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:RelationClaim a owl:Class ; rdfs:subClassOf va:DiscoveredCharacteristic ; rdfs:label "Relation claim"@en ;
    skos:definition "A discovered relation between two members or terms, of a family, holding in a context, with one or more grounds. A kind of discovered characteristic of the existing discovery taxonomy."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ClaimGround a owl:Class ; rdfs:label "Ground of a claim"@en ;
    skos:definition "One reason a relation claim holds: the kind of necessity it states and the source that says so. A claim may have several; they are not merged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---------------------------------------------------------------- properties
va:sourceKind a owl:ObjectProperty ; rdfs:label "kind of source"@en ; rdfs:domain va:Source ; rdfs:range va:SourceKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:sourceForm a owl:ObjectProperty ; rdfs:label "form of source (how it can be read)"@en ; rdfs:domain va:Source ; rdfs:range va:SourceForm ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:sourceRole a owl:ObjectProperty ; rdfs:label "role the source plays in discovery"@en ; rdfs:domain va:Source ; rdfs:range va:SourceRole ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:authorityLevel a owl:ObjectProperty ; rdfs:label "how binding the source is for what it says"@en ; rdfs:domain va:Source ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:describesContextPiece a owl:ObjectProperty ; rdfs:label "context piece the source describes"@en ; rdfs:domain va:Source ; rdfs:range va:ContextPiece ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:pieceKind a owl:ObjectProperty ; rdfs:label "kind of context piece"@en ; rdfs:domain va:ContextPiece ; rdfs:range va:ContextPieceKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:hasPiece a owl:ObjectProperty ; rdfs:label "has context piece"@en ; rdfs:domain va:Context ; rdfs:range va:ContextPiece ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:claimFamily a owl:ObjectProperty ; rdfs:label "relation family of the claim"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:RelationFamily ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:claimRelation a owl:ObjectProperty ; rdfs:label "relation of the claim"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:RelationKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:claimSubject a owl:ObjectProperty ; rdfs:label "subject of the claim (a member or a term)"@en ; rdfs:domain va:RelationClaim ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:claimObject a owl:ObjectProperty ; rdfs:label "object of the claim (a member, a term or a state)"@en ; rdfs:domain va:RelationClaim ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:hasGround a owl:ObjectProperty ; rdfs:label "has ground"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:ClaimGround ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:groundKind a owl:ObjectProperty ; rdfs:label "kind of necessity the ground states"@en ; rdfs:domain va:ClaimGround ; rdfs:range va:GroundKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:groundedBySource a owl:ObjectProperty ; rdfs:label "source that gives the ground (grounded-by)"@en ; rdfs:domain va:ClaimGround ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:modality a owl:ObjectProperty ; rdfs:label "modality of the claim"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:Modality ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:holdsIn a owl:ObjectProperty ; rdfs:label "context in which the claim holds (holds-in)"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:sensitivity a owl:ObjectProperty ; rdfs:label "how the term's meaning behaves when the domain changes"@en ; rdfs:domain va:DomainTerm ; rdfs:range va:DomainSensitivity ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:hasMeaning a owl:ObjectProperty ; rdfs:label "has meaning"@en ; rdfs:domain va:DomainTerm ; rdfs:range va:TermMeaning ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:meaningIn a owl:ObjectProperty ; rdfs:label "context in which the term has this meaning (meaning-in)"@en ; rdfs:domain va:TermMeaning ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:roleOf a owl:ObjectProperty ; rdfs:label "relation (relator) that gives a role-like term its meaning (role-of)"@en ; rdfs:domain va:DomainTerm ; rdfs:range va:DomainTerm ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:translatesTo a owl:ObjectProperty ; rdfs:label "the same thing in another context (translates-to)"@en ; rdfs:domain va:TermMeaning ; rdfs:range va:TermMeaning ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:translationKind a owl:DatatypeProperty ; rdfs:label "how the translation differs: same, narrower, broader or different"@en ; rdfs:domain va:TermMeaning ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:validFrom a owl:DatatypeProperty ; rdfs:label "first date or version for which the context holds (valid-during)"@en ; rdfs:domain va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:validUntil a owl:DatatypeProperty ; rdfs:label "last date or version for which the context holds (valid-during)"@en ; rdfs:domain va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:supersedes a owl:ObjectProperty ; rdfs:label "context this one replaces (supersedes)"@en ; rdfs:domain va:Context ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:authorityRank a owl:DatatypeProperty ; rdfs:label "rank in the authority order (higher binds more)"@en ; rdfs:domain va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:authorityAxis a owl:DatatypeProperty ; rdfs:label "what the order is about: what must hold, or what does happen"@en ; rdfs:domain va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:builtToday a owl:DatatypeProperty ; rdfs:label "whether the pipeline reads this relation today: built, recorded, missing"@en ; rdfs:domain va:RelationKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:usedIn a owl:ObjectProperty ; rdfs:label "member where the term (or its value) is used"@en ; rdfs:domain va:DomainTerm ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:parameterValue a owl:DatatypeProperty ; rdfs:label "value of a parametrised term"@en ; rdfs:domain va:DomainTerm ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
# VAF-WI-145: what a generated description records so a reader can check it against the source text
va:groundEvidence a owl:DatatypeProperty ; rdfs:label "words of the source that give the ground (a quotation, checked to occur in the source)"@en ; rdfs:domain va:ClaimGround ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:groundConditional a owl:DatatypeProperty ; rdfs:label "the words giving the ground carry a condition the reader does not interpret"@en ; rdfs:domain va:ClaimGround ; rdfs:range xsd:boolean ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:sourcePath a owl:DatatypeProperty ; rdfs:label "file the source is read from"@en ; rdfs:domain va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:sourceSha256 a owl:DatatypeProperty ; rdfs:label "SHA-256 of the source file when it was read"@en ; rdfs:domain va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:meaningText a owl:DatatypeProperty ; rdfs:label "what the term means in the context, in words"@en ; rdfs:domain va:TermMeaning ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:enforces a owl:ObjectProperty ; rdfs:label "this ground (a guard that refuses) enforces another ground (a policy or norm): if that ground does not hold in a context, this one has no reason to be there"@en ; rdfs:domain va:ClaimGround ; rdfs:range va:ClaimGround ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:groundsKindsFrom a owl:ObjectProperty ; rdfs:label "source kinds that can give this kind of ground"@en ; rdfs:domain va:GroundKind ; rdfs:range va:SourceKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:SourceKind a skos:Concept, owl:Class ; skos:inScheme va:SourceKindScheme ; skos:topConceptOf va:SourceKindScheme ; skos:prefLabel "Source kind"@en ; skos:definition "A kind of place where discovery reads something."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:SourceForm a skos:Concept, owl:Class ; skos:inScheme va:SourceFormScheme ; skos:topConceptOf va:SourceFormScheme ; skos:prefLabel "Source form"@en ; skos:definition "How a source can be read; it decides the reader, not the meaning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:SourceRole a skos:Concept, owl:Class ; skos:inScheme va:SourceRoleScheme ; skos:topConceptOf va:SourceRoleScheme ; skos:prefLabel "Source role"@en ; skos:definition "What a source is used as in discovery; one source can play several."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AuthorityLevel a skos:Concept, owl:Class ; skos:inScheme va:AuthorityScheme ; skos:topConceptOf va:AuthorityScheme ; skos:prefLabel "Authority level"@en ; skos:definition "How binding a source is for what it says. Two orders on purpose: what must hold, and what does happen."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ContextPieceKind a skos:Concept, owl:Class ; skos:inScheme va:ContextPieceScheme ; skos:topConceptOf va:ContextPieceScheme ; skos:prefLabel "Context piece kind"@en ; skos:definition "A typed part of a context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DomainSensitivity a skos:Concept, owl:Class ; skos:inScheme va:DomainSensitivityScheme ; skos:topConceptOf va:DomainSensitivityScheme ; skos:prefLabel "Domain sensitivity"@en ; skos:definition "Four classes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:GroundKind a skos:Concept, owl:Class ; skos:inScheme va:GroundKindScheme ; skos:topConceptOf va:GroundKindScheme ; skos:prefLabel "Ground kind"@en ; skos:definition "The kind of necessity a relation states; one relation can have several grounds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:Modality a skos:Concept, owl:Class ; skos:inScheme va:ModalityScheme ; skos:topConceptOf va:ModalityScheme ; skos:prefLabel "Modality"@en ; skos:definition "How binding a claim is and whether it can be broken."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:RelationFamily a skos:Concept, owl:Class ; skos:inScheme va:RelationFamilyScheme ; skos:topConceptOf va:RelationFamilyScheme ; skos:prefLabel "Relation family"@en ; skos:definition "A group of relations of one kind of meaning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:RelationKind a skos:Concept, owl:Class ; skos:inScheme va:RelationFamilyScheme ; skos:prefLabel "Relation"@en ; skos:definition "One relation of a family."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ChangeEvent a owl:Class ; rdfs:label "A dated change event"@en ; skos:definition "One row of a change history: a rule was stated, a rule began to be enforced, or code or a value changed, on a date."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:Incident a owl:Class ; rdfs:label "An incident"@en ; skos:definition "One record of observed misbehaviour, pointing at the rule it violates by that rule's key."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:StateEstablishment a owl:Class ; rdfs:label "A state that an operation establishes"@en ; skos:definition "A fact read from the code: after this operation the attribute has this state."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ExclusiveState a owl:Class ; rdfs:label "A state of an exclusive attribute"@en ; skos:definition "A fact read from the code: the attribute holds one state at a time, and this is one of its states."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ObservedParameter a owl:Class ; rdfs:label "An observed value of a limit"@en ; skos:definition "A fact read from a source: the program or its database limits this quantity to this value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AgQuestion a owl:Class ; rdfs:label "A question the sources can speak about"@en ; skos:definition "One thing that sources state or enforce, such as whether approval comes after the credit check. Claims speak to a question; they are not merged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AgRecord a owl:Class ; rdfs:label "The state of one question in one context"@en ; skos:definition "How the statements and the behaviour behind one question compare in one context, with the reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AgRun a owl:Class ; rdfs:label "A run of the agreement rules for one target context"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:evKind a owl:DatatypeProperty ; rdfs:label "kind of change event: rule-stated, rule-enforced or code-changed"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evWhen a owl:DatatypeProperty ; rdfs:label "date of the event"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evRel a owl:DatatypeProperty ; rdfs:label "kind of rule the event is about: order, requires, prevents, obliged, forbidden, triggers, param"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evSubject a owl:ObjectProperty ; rdfs:label "member the event is about"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evObject a owl:ObjectProperty ; rdfs:label "second member (or state) the event is about"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evName a owl:DatatypeProperty ; rdfs:label "name of a parameter the event is about"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evValue a owl:DatatypeProperty ; rdfs:label "value a parameter event states or sets"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evAllOperations a owl:DatatypeProperty ; rdfs:label "the event changed the whole program, so it counts for every operation"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evFromCode a owl:DatatypeProperty ; rdfs:label "the changed thing is code or a schema (not a document)"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evSourceFile a owl:DatatypeProperty ; rdfs:label "identifier of the file the event is about"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evNote a owl:DatatypeProperty ; rdfs:label "the history's own words"@en ; rdfs:domain va:ChangeEvent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evHoldsIn a owl:ObjectProperty ; rdfs:label "context of the file the event is about"@en ; rdfs:domain va:ChangeEvent ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:evFromSource a owl:ObjectProperty ; rdfs:label "the history source that records the event"@en ; rdfs:domain va:ChangeEvent ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incOpened a owl:DatatypeProperty ; rdfs:label "date the incident was opened"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incClosed a owl:DatatypeProperty ; rdfs:label "date the incident was closed"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incResolution a owl:DatatypeProperty ; rdfs:label "how the incident was resolved: code-fixed, document-fixed, accepted or open"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incRel a owl:DatatypeProperty ; rdfs:label "kind of rule the incident violates"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incSubject a owl:ObjectProperty ; rdfs:label "member the violated rule is about"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incObject a owl:ObjectProperty ; rdfs:label "second member the violated rule is about"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incName a owl:DatatypeProperty ; rdfs:label "name of the parameter the incident is about"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incObserved a owl:DatatypeProperty ; rdfs:label "what was observed"@en ; rdfs:domain va:Incident ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incHoldsIn a owl:ObjectProperty ; rdfs:label "context of the program the incident is about"@en ; rdfs:domain va:Incident ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:incFromSource a owl:ObjectProperty ; rdfs:label "the incident record that holds it"@en ; rdfs:domain va:Incident ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:estMember a owl:ObjectProperty ; rdfs:label "operation that establishes the state"@en ; rdfs:domain va:StateEstablishment ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:estState a owl:ObjectProperty ; rdfs:label "state that is established"@en ; rdfs:domain va:StateEstablishment ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:estEvidence a owl:DatatypeProperty ; rdfs:label "the line of code that establishes it"@en ; rdfs:domain va:StateEstablishment ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:exclState a owl:ObjectProperty ; rdfs:label "state of an exclusive attribute"@en ; rdfs:domain va:ExclusiveState ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:exclAttribute a owl:DatatypeProperty ; rdfs:label "the attribute that holds one state at a time"@en ; rdfs:domain va:ExclusiveState ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:obsKey a owl:DatatypeProperty ; rdfs:label "key of the parameter the value belongs to"@en ; rdfs:domain va:ObservedParameter ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:obsValue a owl:DatatypeProperty ; rdfs:label "observed value of the limit"@en ; rdfs:domain va:ObservedParameter ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:obsMember a owl:ObjectProperty ; rdfs:label "member (a column) the observed limit is on, when it has one"@en ; rdfs:domain va:ObservedParameter ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:obsEvidence a owl:DatatypeProperty ; rdfs:label "the words of the source that give the limit"@en ; rdfs:domain va:ObservedParameter ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:obsHoldsIn a owl:ObjectProperty ; rdfs:label "context of the file the limit is read from"@en ; rdfs:domain va:ObservedParameter ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:parameterKey a owl:DatatypeProperty ; rdfs:label "key by which sources and incidents name this parametrised term"@en ; rdfs:domain va:DomainTerm ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:meaningValue a owl:DatatypeProperty ; rdfs:label "value a parametrised term has in the contexts of this meaning"@en ; rdfs:domain va:TermMeaning ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agKind a owl:DatatypeProperty ; rdfs:label "kind of question: order, requires, prevents, obliged, forbidden, triggers, permitted, param or structural"@en ; rdfs:domain va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agSubject a owl:ObjectProperty ; rdfs:label "member the question is about"@en ; rdfs:domain va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agObject a owl:ObjectProperty ; rdfs:label "second member (or state) the question is about"@en ; rdfs:domain va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agName a owl:DatatypeProperty ; rdfs:label "name of a parameter question"@en ; rdfs:domain va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agSpeaksTo a owl:ObjectProperty ; rdfs:label "the claim speaks to this question"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agBacks a owl:ObjectProperty ; rdfs:label "the claim backs the enforcement of this question without stating it"@en ; rdfs:domain va:RelationClaim ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agOf a owl:ObjectProperty ; rdfs:label "question the record is about"@en ; rdfs:domain va:AgRecord ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agIn a owl:ObjectProperty ; rdfs:label "context the record is for"@en ; rdfs:domain va:AgRecord ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agState a owl:ObjectProperty ; rdfs:label "state the comparison names"@en ; rdfs:domain va:AgRecord ; rdfs:range va:AgreementState ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agReason a owl:DatatypeProperty ; rdfs:label "why the comparison names this state"@en ; rdfs:domain va:AgRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agTarget a owl:ObjectProperty ; rdfs:label "context the run is for"@en ; rdfs:domain va:AgRun ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AgreementState a skos:Concept, owl:Class ; skos:inScheme va:AgreementStateScheme ; skos:topConceptOf va:AgreementStateScheme ; skos:prefLabel "Agreement state"@en ; skos:definition "How what the sources state compares with what the program does, for one question in one context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:NcRecord a owl:Class ; rdfs:label "A nonconformity record"@en ; skos:definition "One mismatch between what the sources state and what the program does, in one context, with its candidate causes, the point where detection failed, and where the work on it stands."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:NcRun a owl:Class ; rdfs:label "A nonconformity run"@en ; skos:definition "A run of the nonconformity rules after the agreement rules, with the date it is assessed as of."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:CauseConfirmation a owl:Class ; rdfs:label "A confirmed cause"@en ; skos:definition "A person's statement of the cause of one mismatch, with the action planned and its due date."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:KnownProblem a owl:Class ; rdfs:label "A known problem"@en ; skos:definition "A mismatch accepted as it is, with an owner, a reason, the accepted risk and a review date."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:NcParetoRow a owl:Class ; rdfs:label "A count of open records per candidate cause"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ncOf a owl:ObjectProperty ; rdfs:label "comparison result the record is about"@en ; rdfs:domain va:NcRecord ; rdfs:range va:AgRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncIn a owl:ObjectProperty ; rdfs:label "context the record is for"@en ; rdfs:domain va:NcRecord ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncStatus a owl:ObjectProperty ; rdfs:label "where the work on the record stands"@en ; rdfs:domain va:NcRecord ; rdfs:range va:NcStatus ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncCandidate a owl:ObjectProperty ; rdfs:label "a cause the evidence is consistent with"@en ; rdfs:domain va:NcRecord ; rdfs:range va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncEscape a owl:DatatypeProperty ; rdfs:label "where detection failed, if the candidate cause is right"@en ; rdfs:domain va:NcRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncQuestion a owl:ObjectProperty ; rdfs:label "what must be found out, when no cause can be named"@en ; rdfs:domain va:NcRecord ; rdfs:range va:NcQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncConfirmed a owl:ObjectProperty ; rdfs:label "the confirmation that applies"@en ; rdfs:domain va:NcRecord ; rdfs:range va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncConfirmedCause a owl:ObjectProperty ; rdfs:label "the cause a person confirmed"@en ; rdfs:domain va:NcRecord ; rdfs:range va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncOutsideCandidates a owl:DatatypeProperty ; rdfs:label "true when the confirmed cause is not among the candidates the model could name"@en ; rdfs:domain va:NcRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncKnownProblem a owl:ObjectProperty ; rdfs:label "the known-problem entry that applies"@en ; rdfs:domain va:NcRecord ; rdfs:range va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncAsOf a owl:DatatypeProperty ; rdfs:label "date the records are assessed as of"@en ; rdfs:domain va:NcRun ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncAssessed a owl:ObjectProperty ; rdfs:label "a record of the run"@en ; rdfs:domain va:NcRun ; rdfs:range va:NcRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncParetoIn a owl:ObjectProperty ; rdfs:domain va:NcParetoRow ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncParetoCause a owl:ObjectProperty ; rdfs:domain va:NcParetoRow ; rdfs:range va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncParetoCount a owl:DatatypeProperty ; rdfs:label "open records with this candidate cause"@en ; rdfs:domain va:NcParetoRow ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncParetoRank a owl:DatatypeProperty ; rdfs:label "rank by count, 1 is the largest; equal counts share a rank"@en ; rdfs:domain va:NcParetoRow ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncUnknownCount a owl:DatatypeProperty ; rdfs:label "records in the context whose cause is unknown"@en ; rdfs:domain va:NcRun ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ccIn a owl:ObjectProperty ; rdfs:domain va:CauseConfirmation ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccWhen a owl:DatatypeProperty ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccRel a owl:DatatypeProperty ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccSubject a owl:ObjectProperty ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccObject a owl:ObjectProperty ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccName a owl:DatatypeProperty ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccCause a owl:ObjectProperty ; rdfs:domain va:CauseConfirmation ; rdfs:range va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccBy a owl:DatatypeProperty ; rdfs:label "who confirmed the cause"@en ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccAction a owl:DatatypeProperty ; rdfs:label "the corrective action planned"@en ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccDue a owl:DatatypeProperty ; rdfs:label "date the action is due"@en ; rdfs:domain va:CauseConfirmation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ccFromSource a owl:ObjectProperty ; rdfs:domain va:CauseConfirmation ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpIn a owl:ObjectProperty ; rdfs:domain va:KnownProblem ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpAccepted a owl:DatatypeProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpRel a owl:DatatypeProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpSubject a owl:ObjectProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpObject a owl:ObjectProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpName a owl:DatatypeProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpOwner a owl:DatatypeProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpReason a owl:DatatypeProperty ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpRisk a owl:DatatypeProperty ; rdfs:label "the accepted risk"@en ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpReview a owl:DatatypeProperty ; rdfs:label "date the acceptance is reviewed"@en ; rdfs:domain va:KnownProblem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kpFromSource a owl:ObjectProperty ; rdfs:domain va:KnownProblem ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:NcCause a skos:Concept, owl:Class ; skos:inScheme va:NcCauseScheme ; skos:topConceptOf va:NcCauseScheme ; skos:prefLabel "Cause of a mismatch"@en ; skos:definition "A category of cause, in the manner of a fishbone diagram, with the point where detection failed if it is the right one. The model names candidates from dates and states; only a person confirms one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:NcQuestion a skos:Concept, owl:Class ; skos:inScheme va:NcQuestionScheme ; skos:topConceptOf va:NcQuestionScheme ; skos:prefLabel "Open question"@en ; skos:definition "The one thing missing from the evidence that would let a cause be named."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:NcStatus a skos:Concept, owl:Class ; skos:inScheme va:NcStatusScheme ; skos:topConceptOf va:NcStatusScheme ; skos:prefLabel "Nonconformity status"@en ; skos:definition "How far the work on one nonconformity has come."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:causeEscape a owl:DatatypeProperty ; rdfs:label "where detection failed if this cause is the right one"@en ; rdfs:domain va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:causeCategory a owl:DatatypeProperty ; rdfs:label "fishbone branch of the cause"@en ; rdfs:domain va:NcCause ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncPareto a owl:ObjectProperty ; rdfs:label "a count row of the run"@en ; rdfs:domain va:NcRun ; rdfs:range va:NcParetoRow ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ncConflictingInputs a owl:DatatypeProperty ; rdfs:label "true when a person's confirmation and a known-problem entry both apply to the record"@en ; rdfs:domain va:NcRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ================================================================ VAF-WI-151: rank the evidence (the way RDODI ranks references, under other conditions)
va:agDescribedIn a owl:ObjectProperty ; rdfs:label "context where a process description says it"@en ; rdfs:domain va:AgQuestion ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agStatementAt a owl:ObjectProperty ; rdfs:label "authority level of a statement of the question (standing policy or normative ground, or present description)"@en ; rdfs:domain va:AgQuestion ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:agTopLevel a owl:ObjectProperty ; rdfs:label "highest-ranked statement of the question"@en ; rdfs:domain va:AgQuestion ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ================================================================ VAF-WI-152: knowledge categories and deduced facts (Amendment 6)
# The source layer is closed (ranks set); this layer synthesizes them. STIPULATIONS (L-116) are in the plan, Amendment 6.
va:DeRun a owl:Class ; rdfs:label "A deduction run"@en ; skos:definition "A run of the deduction rules after the interpretation and agreement rules, for one context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DeChain a owl:Class ; rdfs:label "A chain of ordering questions"@en ; skos:definition "A pair (subject comes after object) reached by one or more ordering questions held in the context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DeEnfChain a owl:Class ; rdfs:label "A chain of enforced ordering questions"@en ;
    rdfs:subClassOf va:DeChain ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DeReach a owl:Class ; rdfs:label "A chain whose every link is stated at a given level or above"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DeDerived a owl:Class ; rdfs:label "A deduced fact"@en ; skos:definition "An ordering that no question states directly but that follows by transitivity from questions held in the context; evidence at its weakest link's level, never a verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:KcRecord a owl:Class ; rdfs:label "A knowledge category assignment"@en ; skos:definition "The category of one question, or one deduced fact, in one context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deSubject a owl:ObjectProperty ; rdfs:domain va:DeChain ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deObject a owl:ObjectProperty ; rdfs:domain va:DeChain ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deAtLevel a owl:ObjectProperty ; rdfs:domain va:DeReach ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deOfRun a owl:ObjectProperty ; rdfs:domain va:DeDerived ; rdfs:range va:DeRun ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deLevel a owl:ObjectProperty ; rdfs:label "highest level every link of some chain reaches"@en ; rdfs:domain va:DeDerived ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deEnforced a owl:DatatypeProperty ; rdfs:label "some chain of enforced links exists"@en ; rdfs:domain va:DeDerived ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:deVia a owl:ObjectProperty ; rdfs:label "question the deduction came through"@en ; rdfs:domain va:DeDerived ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kcOf a owl:ObjectProperty ; rdfs:domain va:KcRecord ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kcOfDerived a owl:ObjectProperty ; rdfs:domain va:KcRecord ; rdfs:range va:DeDerived ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kcIn a owl:ObjectProperty ; rdfs:domain va:KcRecord ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kcCategory a owl:ObjectProperty ; rdfs:domain va:KcRecord ; rdfs:range va:KnowledgeCategory ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:kcBasis a owl:DatatypeProperty ; rdfs:label "why the record has this category"@en ; rdfs:domain va:KcRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:KnowledgeCategory a skos:Concept, owl:Class ; skos:inScheme va:KnowledgeCategoryScheme ; skos:topConceptOf va:KnowledgeCategoryScheme ; skos:prefLabel "Knowledge category"@en ; skos:definition "A coarse category of what is known about a question in a context, derived from the agreement state and the highest-ranked statement."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:dcMapWordingName a owl:DatatypeProperty ; rdfs:label "name of the source when its words were read by the language reader"@en ; rdfs:domain va:DcSourceMap ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Trust per entity, measured from independent witnesses (VAF-WI-154, plan Amendment 8)
va:TrRun a owl:Class ; rdfs:label "A trust run"@en ; skos:definition "A run of the trust rules after the interpretation, agreement and deduction rules, for one context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:TrRecord a owl:Class ; rdfs:label "A trust record"@en ; skos:definition "The trust of one entity (a question, or any entity a claim names) in one context: a vector of numbers computed from its witnesses, a level named from the vector, and the witnesses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:TrWitness a owl:Class ; rdfs:label "A witness"@en ; skos:definition "One ground (or incident) that speaks for or against an entity in a context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:TrBacking a owl:Class ; rdfs:label "An origin's stand on an entity"@en ; skos:definition "All witnesses of one origin (one file, one kind of source) on one side (for or against) of one record; the unit that is counted once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trOf a owl:ObjectProperty ; rdfs:label "entity the record is about"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trIn a owl:ObjectProperty ; rdfs:domain va:TrRecord ; rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trEntityKind a owl:DatatypeProperty ; rdfs:label "kind of entity: question or entity"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trWitnessOf a owl:ObjectProperty ; rdfs:domain va:TrWitness ; rdfs:range va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trStance a owl:DatatypeProperty ; rdfs:label "for or against"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trVia a owl:ObjectProperty ; rdfs:label "the ground or incident that is the witness"@en ; rdfs:domain va:TrWitness ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trPrior a owl:DatatypeProperty ; rdfs:label "prior weight of one witness: the authority rank of its source's level"@en ; rdfs:domain va:TrWitness ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trOriginKey a owl:DatatypeProperty ; rdfs:label "origin: the file and the kind of source"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trOriginKind a owl:ObjectProperty ; rdfs:label "kind of source of the origin"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trBackingOf a owl:ObjectProperty ; rdfs:domain va:TrBacking ; rdfs:range va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trBackedBy a owl:ObjectProperty ; rdfs:label "the origin's stand a witness belongs to"@en ; rdfs:domain va:TrWitness ; rdfs:range va:TrBacking ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trBackingStrength a owl:DatatypeProperty ; rdfs:label "highest prior among the origin's witnesses"@en ; rdfs:domain va:TrBacking ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trCorroboration a owl:DatatypeProperty ; rdfs:label "C: number of origins for"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trContradiction a owl:DatatypeProperty ; rdfs:label "X: number of origins against"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trIndependence a owl:DatatypeProperty ; rdfs:label "I: number of kinds of source among the origins for"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trStrength a owl:DatatypeProperty ; rdfs:label "S: highest prior among the origins for"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trReach a owl:DatatypeProperty ; rdfs:label "R: how much else in the context relies on the entity"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trNet a owl:DatatypeProperty ; rdfs:label "N: C minus X"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trContested a owl:DatatypeProperty ; rdfs:label "true when at least one origin is against"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trLevel a owl:ObjectProperty ; rdfs:label "level named from the vector"@en ; rdfs:domain va:TrRecord ; rdfs:range va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trLevelCode a owl:DatatypeProperty ; rdfs:label "code of a level: T and its number"@en ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trLevelNumber a owl:DatatypeProperty ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trMinNet a owl:DatatypeProperty ; rdfs:label "least net support N for the level"@en ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trMinIndependence a owl:DatatypeProperty ; rdfs:label "least independence I for the level"@en ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trMinStrength a owl:DatatypeProperty ; rdfs:label "least strength S for the level"@en ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:TrustLevel a skos:Concept, owl:Class ; skos:inScheme va:TrustLevelScheme ; skos:topConceptOf va:TrustLevelScheme ; skos:prefLabel "Trust level"@en ; skos:definition "A named band of the trust vector. The highest numbered level whose minimums the vector meets is the level of the record. The numbers decide; the names only label."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
# VAF-WI-158 (plan Amendment 11): the witness descriptor. Which reader produced the grounds of a source, as data; the reading environment as facts.
# The reader kinds correspond informally to the OE confidence tiers (static to A, lexicon to B, language model to C, human to D) but describe how a STATEMENT was
# read, not how a score was produced; no OE term is minted (B1).
va:Reader a owl:Class ; rdfs:label "A reader"@en ; skos:definition "A program, a person or a model that turned a source into grounds, with the environment it ran in recorded as facts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ReaderEnvItem a owl:Class ; rdfs:label "An item of a reader's environment"@en ; skos:definition "One recorded fact of the environment a reader ran in: a name and a value (a version or a hash)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:readBy a owl:ObjectProperty ; rdfs:label "reader that produced the grounds of the source"@en ; rdfs:domain va:Source ; rdfs:range va:Reader ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:readerKind a owl:ObjectProperty ; rdfs:label "kind of reader"@en ; rdfs:domain va:Reader ; rdfs:range va:ReaderKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:readerName a owl:DatatypeProperty ; rdfs:label "name of the reader"@en ; rdfs:domain va:Reader ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:hasEnvItem a owl:ObjectProperty ; rdfs:label "environment item the reader ran with"@en ; rdfs:domain va:Reader ; rdfs:range va:ReaderEnvItem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:envKey a owl:DatatypeProperty ; rdfs:label "name of the environment item"@en ; rdfs:domain va:ReaderEnvItem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:envValue a owl:DatatypeProperty ; rdfs:label "value of the environment item"@en ; rdfs:domain va:ReaderEnvItem ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:dcMapReaderKind a owl:ObjectProperty ; rdfs:label "kind of reader that produces this named source"@en ; rdfs:range va:ReaderKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trNonModel a owl:DatatypeProperty ; rdfs:label "origins for the entity that are not read only by a language model (P)"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trReaderKind a owl:ObjectProperty ; rdfs:label "kind of reader that read the witness's ground"@en ; rdfs:domain va:TrWitness ; rdfs:range va:ReaderKind ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trMinNonModel a owl:DatatypeProperty ; rdfs:label "least number of origins not read only by a language model (P) for the level"@en ; rdfs:domain va:TrustLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:ReaderKind a skos:Concept, owl:Class ; skos:inScheme va:ReaderKindScheme ; skos:topConceptOf va:ReaderKindScheme ; skos:prefLabel "Reader kind"@en ; skos:definition "How a source was turned into grounds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Dependence between origins (VAF-WI-159, plan Amendment 12)
va:SourceDependence a owl:Class ; rdfs:label "A dependence between two sources"@en ; skos:definition "A record that one source depends on another (an exact copy, or a derivation the maintainer declared), with its basis. Sources joined by dependences count as one origin."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:derivedFromSource a owl:ObjectProperty ; rdfs:label "source this source was declared derived from (a translation, an extract, a rewrite)"@en ; rdfs:domain va:Source ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:depFrom a owl:ObjectProperty ; rdfs:label "dependent source of the dependence"@en ; rdfs:domain va:SourceDependence ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:depOn a owl:ObjectProperty ; rdfs:label "source the dependence is on"@en ; rdfs:domain va:SourceDependence ; rdfs:range va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:dependenceBasis a owl:ObjectProperty ; rdfs:label "why the sources are taken as dependent"@en ; rdfs:domain va:SourceDependence ; rdfs:range va:DependenceBasis ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:srcOriginKey a owl:DatatypeProperty ; rdfs:label "origin key of the source (its file and kind, or that of the smallest key in its group of dependent sources)"@en ; rdfs:domain va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:srcOriginKind a owl:ObjectProperty ; rdfs:label "kind of the source's origin"@en ; rdfs:domain va:Source ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:DependenceBasis a skos:Concept, owl:Class ; skos:inScheme va:DependenceBasisScheme ; skos:topConceptOf va:DependenceBasisScheme ; skos:prefLabel "Dependence basis"@en ; skos:definition "Why two sources are one voice."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Opinions (VAF-WI-160, plan Amendment 13)
va:trBelief a owl:DatatypeProperty ; rdfs:label "belief of the opinion: origins for over origins plus the prior weight"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trDisbelief a owl:DatatypeProperty ; rdfs:label "disbelief of the opinion: origins against over origins plus the prior weight"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trUncertainty a owl:DatatypeProperty ; rdfs:label "uncertainty of the opinion: the prior weight over origins plus the prior weight"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:trExpectation a owl:DatatypeProperty ; rdfs:label "expectation of the opinion: belief plus the base rate times uncertainty"@en ; rdfs:domain va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:omPriorWeight a owl:DatatypeProperty ; rdfs:label "prior weight W of the opinion model (a stipulation)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:omBaseRate a owl:DatatypeProperty ; rdfs:label "base rate a of the opinion model (a stipulation; a placeholder until category base rates exist)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Anchors and calibration (VAF-WI-161, plan Amendment 14)
va:Anchor a owl:Class ; rdfs:label "An anchor"@en ; skos:definition "A question in a context whose truth reality has settled, with a verdict (holds or fails) and a basis; derived from a closed code-fixed incident or declared by the maintainer."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:CalOutcome a owl:Class ; rdfs:label "An outcome of an authority level on an anchor"@en ; skos:definition "A hit or a miss of one authority level on one anchor: a level counts once per anchor and result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:CalLevelEstimate a owl:Class ; rdfs:label "The calibration estimate of an authority level"@en ; skos:definition "Hits, misses, their number and the estimated reliability (h + 1) / (n + 2) of an authority level over the anchors of a context; reported beside the stipulated rank, never replacing it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorQuestion a owl:ObjectProperty ; rdfs:label "question the anchor settles"@en ; rdfs:domain va:Anchor ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorIn a owl:ObjectProperty ; rdfs:label "context of the anchor"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorVerdict a owl:DatatypeProperty ; rdfs:label "verdict of the anchor: holds or fails"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorBasis a owl:ObjectProperty ; rdfs:label "why the anchor is taken as settled"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorRel a owl:DatatypeProperty ; rdfs:label "relation of a declared anchor"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorSubject a owl:ObjectProperty ; rdfs:label "subject of a declared anchor"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorObject a owl:ObjectProperty ; rdfs:label "object of a declared anchor"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:anchorRecord a owl:ObjectProperty ; rdfs:label "trust record of the anchored question"@en ; rdfs:domain va:Anchor ; rdfs:range va:TrRecord ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calError a owl:DatatypeProperty ; rdfs:label "squared error of the opinion's expectation against the anchor's verdict"@en ; rdfs:domain va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calOutcomeOf a owl:ObjectProperty ; rdfs:label "anchor of the outcome"@en ; rdfs:domain va:CalOutcome ; rdfs:range va:Anchor ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calLevel a owl:ObjectProperty ; rdfs:label "authority level of the outcome"@en ; rdfs:domain va:CalOutcome ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calResult a owl:DatatypeProperty ; rdfs:label "hit or miss"@en ; rdfs:domain va:CalOutcome ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calEstOf a owl:ObjectProperty ; rdfs:label "authority level the estimate is of"@en ; rdfs:domain va:CalLevelEstimate ; rdfs:range va:AuthorityLevel ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calHits a owl:DatatypeProperty ; rdfs:label "anchors on which the level had a hit"@en ; rdfs:domain va:CalLevelEstimate ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calMisses a owl:DatatypeProperty ; rdfs:label "anchors on which the level had a miss"@en ; rdfs:domain va:CalLevelEstimate ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calN a owl:DatatypeProperty ; rdfs:label "hits plus misses"@en ; rdfs:domain va:CalLevelEstimate ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calReliability a owl:DatatypeProperty ; rdfs:label "estimated reliability (h + 1) / (n + 2)"@en ; rdfs:domain va:CalLevelEstimate ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calAnchorCount a owl:DatatypeProperty ; rdfs:label "number of anchors with a trust record in the context"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:calBrier a owl:DatatypeProperty ; rdfs:label "mean squared error over the anchors of the context (absent without anchors)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Category measures (VAF-WI-162, plan Amendment 15): base rates per knowledge category and the category-relative reading of the opinion
va:CatMeasure a owl:Class ; rdfs:label "A category measure"@en ; skos:definition "For one knowledge category in one context: the number of categorized questions, their rate, and the mean expectation and mean uncertainty of their opinions (the means are absent for an empty category)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:CatKindMeasure a owl:Class ; rdfs:label "A category measure within a relation kind"@en ; skos:definition "For one relation kind and one knowledge category in one context: the count, the kind's total and the rate within the kind."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:CatSummary a owl:Class ; rdfs:label "Summary of the category measures of a run"@en ; skos:definition "The number of categorized questions of the context of the run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:QuestionRelative a owl:Class ; rdfs:label "A question read against its own category"@en ; skos:definition "A categorized question with its expectation, its category and the deviation of the expectation from the mean expectation of its category."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmIn a owl:ObjectProperty ; rdfs:label "context of the measure"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:CatMeasure va:CatKindMeasure va:CatSummary ) ] ;
    rdfs:range va:Context ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmCategory a owl:ObjectProperty ; rdfs:label "knowledge category of the measure"@en ; rdfs:range va:KnowledgeCategory ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmKind a owl:DatatypeProperty ; rdfs:label "relation kind of the measure"@en ; rdfs:domain va:CatKindMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmCount a owl:DatatypeProperty ; rdfs:label "number of categorized questions"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmTotal a owl:DatatypeProperty ; rdfs:label "number of categorized questions in the context"@en ; rdfs:domain va:CatSummary ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmKindTotal a owl:DatatypeProperty ; rdfs:label "number of categorized questions of the relation kind"@en ; rdfs:domain va:CatKindMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmRate a owl:DatatypeProperty ; rdfs:label "count over the categorized questions of the context (or, for a kind measure, over those of the kind); absent when that number is 0"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmMeanExpectation a owl:DatatypeProperty ; rdfs:label "mean expectation of the opinions of the category's questions (absent for an empty category)"@en ; rdfs:domain va:CatMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:cmMeanUncertainty a owl:DatatypeProperty ; rdfs:label "mean uncertainty of the opinions of the category's questions (absent for an empty category)"@en ; rdfs:domain va:CatMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:qrQuestion a owl:ObjectProperty ; rdfs:domain va:QuestionRelative ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:qrIn a owl:ObjectProperty ; rdfs:domain va:QuestionRelative ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:qrCategory a owl:ObjectProperty ; rdfs:domain va:QuestionRelative ; rdfs:range va:KnowledgeCategory ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:qrExpectation a owl:DatatypeProperty ; rdfs:domain va:QuestionRelative ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:qrDeviation a owl:DatatypeProperty ; rdfs:label "expectation minus the mean expectation of the category"@en ; rdfs:domain va:QuestionRelative ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Agreement measures (VAF-WI-163, plan Amendment 16): chance-corrected agreement between the sources of a context
va:AgreementUnit a owl:Class ; rdfs:label "A question as a unit of agreement between sources"@en ; skos:definition "A question with a trust record: how many origins state it (for) and how many state against it, each origin counted once and only when it states one stance; with two or more such origins it is pairable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:AgreementMeasure a owl:Class ; rdfs:label "Agreement measure of a context"@en ; skos:definition "Pairable questions, their values, the disagreement sum, the raw agreement and the chance-corrected agreement (nominal Krippendorff alpha) of the origins of one context; alpha is absent when the stances never vary."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auOf a owl:ObjectProperty ; rdfs:label "question of the unit"@en ; rdfs:domain va:AgreementUnit ; rdfs:range va:AgQuestion ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auIn a owl:ObjectProperty ; rdfs:label "context of the unit"@en ; rdfs:domain va:AgreementUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auFor a owl:DatatypeProperty ; rdfs:label "origins that state it and do not state against it"@en ; rdfs:domain va:AgreementUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auAgainst a owl:DatatypeProperty ; rdfs:label "origins that state against it and do not state it"@en ; rdfs:domain va:AgreementUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auSize a owl:DatatypeProperty ; rdfs:label "origins that rate the unit (present only when pairable: two or more)"@en ; rdfs:domain va:AgreementUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:auDisagree a owl:DatatypeProperty ; rdfs:label "observed disagreement of the unit: 2ab / (m - 1)"@en ; rdfs:domain va:AgreementUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amIn a owl:ObjectProperty ; rdfs:label "context of the measure"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amUnits a owl:DatatypeProperty ; rdfs:label "pairable questions"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amValues a owl:DatatypeProperty ; rdfs:label "values in the pairable questions"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amFor a owl:DatatypeProperty ; rdfs:label "for-values in the pairable questions"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amAgainst a owl:DatatypeProperty ; rdfs:label "against-values in the pairable questions"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amDisagreeSum a owl:DatatypeProperty ; rdfs:label "sum of the observed disagreements"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amExcluded a owl:DatatypeProperty ; rdfs:label "(origin, question) pairs left out because the origin states both stances"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amRaw a owl:DatatypeProperty ; rdfs:label "raw agreement 1 - S / n (absent without values)"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:amAlpha a owl:DatatypeProperty ; rdfs:label "chance-corrected agreement, nominal alpha (absent when for-values or against-values are 0)"@en ; rdfs:domain va:AgreementMeasure ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- Moved from the interpretation rule file when the rule files became modules of one SHACL file (VAF-WI-165): a class belongs in the T-Box
va:IpRun a owl:Class ; rdfs:label "A run of the interpretation rules for one target context"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ============================================================
# VAF-WI-252: the terms the rules and the code use, declared (written 2026-10-20). Each was used by a rule, a reader or a builder and
# declared nowhere; the labels and definitions say what the rules and the code do with them. Nothing here changes a rule.
# ============================================================

# name | kind | domain | range | label | definition
# ---- agreement between sources and behaviour (rules of the agreement step)
va:agKey a owl:DatatypeProperty ;
    rdfs:label "key of the question"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A text that names the question, built from its kind and its members; two questions with the same key are the same question."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agAppliesTo a owl:ObjectProperty ;
    rdfs:label "incident applies to question"@en ;
    rdfs:domain va:Incident ;
    rdfs:range va:AgQuestion ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The question an incident (a failure seen in running code) is about."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agIncidentIn a owl:ObjectProperty ;
    rdfs:label "incident in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which an incident about the question was seen."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agOpenIncidentIn a owl:ObjectProperty ;
    rdfs:label "open incident in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which an incident about the question was seen and is not yet fixed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agFixedIncidentIn a owl:ObjectProperty ;
    rdfs:label "fixed incident in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which an incident about the question was seen and has been fixed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agHeldIn a owl:ObjectProperty ;
    rdfs:label "held in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which the question can be asked at all (its members exist there)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agStatedIn a owl:ObjectProperty ;
    rdfs:label "stated in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which a rule or a standing statement answers the question."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agStatesIn a owl:ObjectProperty ;
    rdfs:label "claim states in context"@en ;
    rdfs:domain va:RelationClaim ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which the claim is stated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agEnforcedIn a owl:ObjectProperty ;
    rdfs:label "enforced in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which the program enforces the answer to the question."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agMetThrough a owl:ObjectProperty ;
    rdfs:label "met through question"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:AgQuestion ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A question whose enforcement meets this one (the answer follows from it)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agNotMetBecauseConditional a owl:DatatypeProperty ;
    rdfs:label "not met because conditional"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "Set to true when the only enforcement found is conditional, so the question is not counted as met."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agParamEqual a owl:ObjectProperty ;
    rdfs:label "parameter equal in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which the parameter named by the question has the same value as in the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agParamDiffers a owl:ObjectProperty ;
    rdfs:label "parameter differs in context"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A context in which the parameter named by the question has a different value from the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agStatedWhen a owl:DatatypeProperty ;
    rdfs:label "when it was stated"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The time at which the statement answering the question was written."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agEarliestStated a owl:DatatypeProperty ;
    rdfs:label "earliest statement time"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The earliest time at which any statement answers the question."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agCodeChangedWhen a owl:DatatypeProperty ;
    rdfs:label "when the code changed"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A time at which the code that enforces the question changed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agLatestCodeChange a owl:DatatypeProperty ;
    rdfs:label "latest code change"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The latest time at which the code that enforces the question changed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:agHas a owl:ObjectProperty ;
    rdfs:label "run has record"@en ;
    rdfs:domain va:AgRun ;
    rdfs:range va:AgRecord ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A record the run of the agreement rules produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:trOpposes a owl:ObjectProperty ;
    rdfs:label "opposes"@en ;
    rdfs:domain va:AgQuestion ;
    rdfs:range va:AgQuestion ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The question's answer excludes the other question's answer (they cannot both be met)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- reading map of the claim step
va:DcRead a owl:Class ;
    rdfs:label "claim read"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "One reading of a predicate in a source, with its subject, object, evidence and language, as the claim step receives it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:DcClaim a owl:Class ;
    rdfs:label "claim"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A relation claim made from readings through the reading map: its subject, relation, family and modality."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:DcGround a owl:Class ;
    rdfs:label "claim ground"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "One source's support for a claim: the source, its kind and authority, the ground kind, the modality and the evidence."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:DcPredMap a owl:Class ;
    rdfs:label "predicate map row"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A row of the reading map: a predicate read from a source and the relation, the modality and the source name it maps to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:DcSourceMap a owl:Class ;
    rdfs:label "source map row"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A row of the reading map: a kind of source and the authority and ground kind it carries."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:DcModalityMap a owl:Class ;
    rdfs:label "modality map row"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A row of the reading map: a modality and the ground kind it gives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcPred a owl:DatatypeProperty ;
    rdfs:label "predicate read"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The predicate the reading found, in the source's own words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcSubj a owl:DatatypeProperty ;
    rdfs:label "subject read"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The subject of the reading, as the source names it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcObj a owl:DatatypeProperty ;
    rdfs:label "object read"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The object of the reading, as the source names it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcSrc a owl:DatatypeProperty ;
    rdfs:label "source name"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The name of the source the reading comes from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcSrcId a owl:DatatypeProperty ;
    rdfs:label "source identifier"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The identifier the source gives to the statement that was read."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcLang a owl:DatatypeProperty ;
    rdfs:label "language read"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language of the text the reading comes from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcEvidence a owl:DatatypeProperty ;
    rdfs:label "evidence of the reading"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The words of the source that were read."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcConditional a owl:DatatypeProperty ;
    rdfs:label "read as conditional"@en ;
    rdfs:domain va:DcRead ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when the text states the relation only under a condition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcFromRead a owl:ObjectProperty ;
    rdfs:label "ground from reading"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:DcRead ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The reading that a ground was made from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcSubject a owl:DatatypeProperty ;
    rdfs:label "claim subject"@en ;
    rdfs:domain va:DcClaim ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The subject of the claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcObject a owl:DatatypeProperty ;
    rdfs:label "claim object"@en ;
    rdfs:domain va:DcClaim ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The object of the claim, when it has one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcModality a owl:ObjectProperty ;
    rdfs:label "claim modality"@en ;
    rdfs:domain va:DcClaim ;
    rdfs:range va:Modality ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A modality the claim carries (obliged, forbidden, possible and the like)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundOf a owl:ObjectProperty ;
    rdfs:label "ground of claim"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:DcClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The claim the ground supports."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundSrcName a owl:DatatypeProperty ;
    rdfs:label "ground source name"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The name of the source that supports the claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundSrcId a owl:DatatypeProperty ;
    rdfs:label "ground source identifier"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The identifier of the statement in that source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundSourceKind a owl:ObjectProperty ;
    rdfs:label "ground source kind"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:SourceKind ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The kind of source (code, docstring, comment, law and the like)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundAuthority a owl:ObjectProperty ;
    rdfs:label "ground authority"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:AuthorityLevel ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The authority rank of the source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundKind a owl:ObjectProperty ;
    rdfs:label "ground kind"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:GroundKind ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The kind of necessity the ground gives (causal, policy, undetermined)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundModality a owl:ObjectProperty ;
    rdfs:label "ground modality"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:Modality ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The modality the ground gives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundLang a owl:DatatypeProperty ;
    rdfs:label "ground language"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language the ground was written in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundEvidence a owl:DatatypeProperty ;
    rdfs:label "ground evidence"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The words of the source that support the claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcGroundConditional a owl:DatatypeProperty ;
    rdfs:label "ground is conditional"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when the source states it only under a condition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcEnforces a owl:ObjectProperty ;
    rdfs:label "ground enforces ground"@en ;
    rdfs:domain va:DcGround ;
    rdfs:range va:DcGround ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A ground in code that enforces what another ground (a statement) says."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapPred a owl:DatatypeProperty ;
    rdfs:label "mapped predicate"@en ;
    rdfs:domain va:DcPredMap ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The predicate the row applies to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapSrcName a owl:DatatypeProperty ;
    rdfs:label "mapped source name"@en ;
    rdfs:domain va:DcPredMap ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The source name the row applies to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapRelation a owl:ObjectProperty ;
    rdfs:label "mapped relation"@en ;
    rdfs:domain va:DcPredMap ;
    rdfs:range va:RelationKind ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The relation the predicate stands for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapModality a owl:ObjectProperty ;
    rdfs:label "mapped modality"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:DcPredMap va:DcModalityMap ) ];
    rdfs:range va:Modality ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The modality the row gives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapSourceKind a owl:ObjectProperty ;
    rdfs:label "mapped source kind"@en ;
    rdfs:domain va:DcSourceMap ;
    rdfs:range va:SourceKind ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The kind of source the row applies to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapAuthority a owl:ObjectProperty ;
    rdfs:label "mapped authority"@en ;
    rdfs:domain va:DcSourceMap ;
    rdfs:range va:AuthorityLevel ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The authority the kind of source carries."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:dcMapGroundKind a owl:ObjectProperty ;
    rdfs:label "mapped ground kind"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:DcSourceMap va:DcModalityMap ) ];
    rdfs:range va:GroundKind ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The ground kind the row gives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- interpretation of claims
va:IpReading a owl:Class ;
    rdfs:label "reading of a term"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The meaning the interpretation step gave to a domain term for a run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:IpRefusal a owl:Class ;
    rdfs:label "refusal"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A claim or term the interpretation step refused, with the reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:IpReport a owl:Class ;
    rdfs:label "report"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A finding the interpretation step reports without refusing, with the reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipOfRun a owl:ObjectProperty ;
    rdfs:label "of run"@en ;
    rdfs:domain va:IpReading ;
    rdfs:range va:IpRun ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The run of the interpretation step that produced the reading, refusal or report."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipTerm a owl:ObjectProperty ;
    rdfs:label "term read"@en ;
    rdfs:domain va:IpReading ;
    rdfs:range va:DomainTerm ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The domain term that was given a meaning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipMeaning a owl:DatatypeProperty ;
    rdfs:label "meaning given"@en ;
    rdfs:domain va:IpReading ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The meaning the term has in the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipRefusalOf a owl:ObjectProperty ;
    rdfs:label "refusal of"@en ;
    rdfs:domain va:IpRefusal ;
    rdfs:range va:RelationClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The claim or term that was refused."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipReportOf a owl:ObjectProperty ;
    rdfs:label "report of"@en ;
    rdfs:domain va:IpReport ;
    rdfs:range va:RelationClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The claim or term the report is about."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipReason a owl:DatatypeProperty ;
    rdfs:label "reason"@en ;
    rdfs:domain va:IpRefusal ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "Why it was refused or reported."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipTarget a owl:ObjectProperty ;
    rdfs:label "target context"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The context the run interprets for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipAdmitted a owl:ObjectProperty ;
    rdfs:label "claim admitted"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:RelationClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A claim the run admitted for the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipApplies a owl:ObjectProperty ;
    rdfs:label "claim applies"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:RelationClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A claim that applies in the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipDropped a owl:ObjectProperty ;
    rdfs:label "claim dropped"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:RelationClaim ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A claim the run dropped for the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipRefused a owl:ObjectProperty ;
    rdfs:label "refused in run"@en ;
    rdfs:domain va:RelationClaim ;
    rdfs:range va:IpRun ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The run that refused the claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipStands a owl:ObjectProperty ;
    rdfs:label "ground stands"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:ClaimGround ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A ground that stands in the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipPresent a owl:ObjectProperty ;
    rdfs:label "ground present"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:ClaimGround ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A ground that is present in the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipAbsent a owl:ObjectProperty ;
    rdfs:label "ground absent"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:ClaimGround ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A ground that is absent from the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipGuardWithoutReason a owl:ObjectProperty ;
    rdfs:label "guard without reason"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:ClaimGround ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A ground that guards a claim and gives no reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipNoReading a owl:ObjectProperty ;
    rdfs:label "term without reading"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:DomainTerm ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A domain term of the claims that has no reading for the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:ipAmbiguousReading a owl:ObjectProperty ;
    rdfs:label "term with ambiguous reading"@en ;
    rdfs:domain va:IpRun ;
    rdfs:range va:DomainTerm ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A domain term that has more than one reading for the target context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ---- language clues
va:LcMember a owl:Class ;
    rdfs:label "named member"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A method or state the language-clue reader aligns words to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcUnit a owl:Class ;
    rdfs:label "text unit"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A unit of text (a docstring, a comment, a message) that is read for clues, with its owner and language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcSpan a owl:Class ;
    rdfs:label "word span"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A run of words of a unit, by position."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcClassed a owl:Class ;
    rdfs:label "classified span"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A span that a clue word has given a class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcHit a owl:Class ;
    rdfs:label "clue hit"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A clue word found in a unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcRel a owl:Class ;
    rdfs:label "relation read from words"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A relation between members that the clue rules read from a unit, with its rank."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcImp a owl:Class ;
    rdfs:label "implied relation"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A relation that follows from relations read from words, with how it follows."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcModelRel a owl:Class ;
    rdfs:label "relation in the model"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A relation between members that the model already holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcGloss a owl:Class ;
    rdfs:label "word gloss"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A word or phrase that stands for a member in a language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcWord a owl:Class ;
    rdfs:label "clue word"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A closed-class word or morpheme of a language that is a clue of a class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcSourceRank a owl:Class ;
    rdfs:label "source rank"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The rank given to a relation by the kind of text it was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:LcParameter a owl:Class ;
    rdfs:label "clue parameter"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A stipulated number that the clue rules use, such as a window of words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcName a owl:DatatypeProperty ;
    rdfs:label "member name"@en ;
    rdfs:domain va:LcMember ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The name of the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcKind a owl:DatatypeProperty ;
    rdfs:label "kind"@en ;
    rdfs:domain va:LcUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The kind of the member or of the unit text (method, state value, docstring, comment)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcOwner a owl:DatatypeProperty ;
    rdfs:label "owner"@en ;
    rdfs:domain va:LcUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The name of the thing the unit text belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcText a owl:DatatypeProperty ;
    rdfs:label "text"@en ;
    rdfs:domain va:LcUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The text of the unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcLang a owl:DatatypeProperty ;
    rdfs:label "language"@en ;
    rdfs:domain va:LcUnit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language code of the unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcOf a owl:ObjectProperty ;
    rdfs:label "span of unit"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range va:LcUnit ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The unit a span lies in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcFrom a owl:DatatypeProperty ;
    rdfs:label "span start"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The position of the span's first word."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcTo a owl:DatatypeProperty ;
    rdfs:label "span end"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The position of the span's last word."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcKey a owl:DatatypeProperty ;
    rdfs:label "span key"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language and the lower-cased lemma or surface form of the span, joined by a bar."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcSurface a owl:DatatypeProperty ;
    rdfs:label "span surface"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language and the surface form of the span."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcFeature a owl:DatatypeProperty ;
    rdfs:label "span morpheme"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A morpheme the analyser found in the span, with its language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcAligned a owl:ObjectProperty ;
    rdfs:label "span aligned to member"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member the span's words name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcMemberKey a owl:DatatypeProperty ;
    rdfs:label "member key"@en ;
    rdfs:domain va:LcMember ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A word that names the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcMemberKeyKind a owl:DatatypeProperty ;
    rdfs:label "member key kind"@en ;
    rdfs:domain va:LcMember ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "Whether the key is a name, a part of a name or a gloss."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcMemberKeyNode a owl:ObjectProperty ;
    rdfs:label "member key node"@en ;
    rdfs:domain va:LcMember ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A node that carries one key of the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcGlossLang a owl:DatatypeProperty ;
    rdfs:label "gloss language"@en ;
    rdfs:domain va:LcGloss ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language of the gloss."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcGlossKey a owl:DatatypeProperty ;
    rdfs:label "gloss word"@en ;
    rdfs:domain va:LcGloss ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The word or phrase of the gloss."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcGlossMember a owl:DatatypeProperty ;
    rdfs:label "gloss member"@en ;
    rdfs:domain va:LcGloss ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The name of the member the gloss stands for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcCls a owl:DatatypeProperty ;
    rdfs:label "clue class"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The class of the clue (only, after, before, must, may, trigger and the like)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClsLang a owl:DatatypeProperty ;
    rdfs:label "clue class language"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language of the clue word."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClsSide a owl:DatatypeProperty ;
    rdfs:label "clue complement side"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The side of the clue on which its complement lies."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClsOrder a owl:DatatypeProperty ;
    rdfs:label "clue order"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The word order of a trigger: subject-verb-object or subject-object-verb."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClsSpan a owl:ObjectProperty ;
    rdfs:label "clue span"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range va:LcSpan ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The span that carries the clue."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcHitUnit a owl:ObjectProperty ;
    rdfs:label "hit unit"@en ;
    rdfs:domain va:LcHit ;
    rdfs:range va:LcUnit ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The unit in which the clue word was found."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcHitLang a owl:DatatypeProperty ;
    rdfs:label "hit language"@en ;
    rdfs:domain va:LcHit ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language of the hit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcHitN a owl:DatatypeProperty ;
    rdfs:label "hit count"@en ;
    rdfs:domain va:LcHit ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "How many times the clue word was found in the unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcReachedBy a owl:ObjectProperty ;
    rdfs:label "reached by"@en ;
    rdfs:domain va:LcMember ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A member that reaches this one by a relation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcNegated a owl:DatatypeProperty ;
    rdfs:label "negated"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when a negation clue applies to the state."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcProhibited a owl:DatatypeProperty ;
    rdfs:label "prohibited"@en ;
    rdfs:domain va:LcSpan ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when the operation is prohibited by the words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcSubj a owl:ObjectProperty ;
    rdfs:label "relation subject"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member the relation starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcObj a owl:ObjectProperty ;
    rdfs:label "relation object"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member the relation points to, when it has one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcPred a owl:DatatypeProperty ;
    rdfs:label "relation predicate"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The relation read (only after, only before, forbidden, triggers, needs state and the like)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcUnit a owl:ObjectProperty ;
    rdfs:label "relation unit"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range va:LcUnit ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The unit the relation was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcRank a owl:DatatypeProperty ;
    rdfs:label "relation rank"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The rank of the source kind the relation was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcConditional a owl:DatatypeProperty ;
    rdfs:label "relation conditional"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when the words state a condition that the reader cannot see."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcInModel a owl:DatatypeProperty ;
    rdfs:label "already in the model"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when the model already holds the relation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpFrom a owl:ObjectProperty ;
    rdfs:label "implied from"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member an implied relation starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpTo a owl:ObjectProperty ;
    rdfs:label "implied to"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member an implied relation points to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpRank a owl:DatatypeProperty ;
    rdfs:label "implied rank"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The lowest rank along the chain of relations the implication follows from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpHow a owl:DatatypeProperty ;
    rdfs:label "how implied"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "How the relation follows (by order, by trigger, by prohibition)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpVia a owl:ObjectProperty ;
    rdfs:label "implied via"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A member the implication goes through."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcImpBest a owl:DatatypeProperty ;
    rdfs:label "best implication"@en ;
    rdfs:domain va:LcImp ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "True when no implication of the same pair has a higher rank."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcModelPred a owl:DatatypeProperty ;
    rdfs:label "model relation predicate"@en ;
    rdfs:domain va:LcModelRel ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The relation the model holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcModelFrom a owl:ObjectProperty ;
    rdfs:label "model relation start"@en ;
    rdfs:domain va:LcModelRel ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member the model's relation starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcModelTo a owl:ObjectProperty ;
    rdfs:label "model relation end"@en ;
    rdfs:domain va:LcModelRel ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The member the model's relation points to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcLexKey a owl:DatatypeProperty ;
    rdfs:label "lexicon key"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The language and the word, joined by a bar."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcLexFeature a owl:DatatypeProperty ;
    rdfs:label "lexicon morpheme"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The morpheme the analyser must find for the row to apply."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcLexPattern a owl:DatatypeProperty ;
    rdfs:label "lexicon pattern"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "A regular expression matched against the surface text of a word."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClass a owl:DatatypeProperty ;
    rdfs:label "lexicon class"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The class of clue the word is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcArgSide a owl:DatatypeProperty ;
    rdfs:label "complement side"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The side of the word on which its complement lies."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcOrder a owl:DatatypeProperty ;
    rdfs:label "trigger order"@en ;
    rdfs:domain va:LcWord ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The word order of a trigger: SVO or SOV."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcSourceKind a owl:DatatypeProperty ;
    rdfs:label "source kind"@en ;
    rdfs:domain va:LcSourceRank ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The kind of text a relation was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcRankValue a owl:DatatypeProperty ;
    rdfs:label "rank value"@en ;
    rdfs:domain va:LcSourceRank ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The rank of that kind of text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcValue a owl:DatatypeProperty ;
    rdfs:label "parameter value"@en ;
    rdfs:domain va:LcParameter ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The stipulated number."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:groundedByCalculus a owl:ObjectProperty ;
    rdfs:label "grounded by calculus"@en ;
    rdfs:domain va:ClaimGround ;
    rdfs:range va:BehavioralCalculusId ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The calculus whose finding a ground made by the pipeline itself reports; the identifier also opens the ground's comment."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:trRunIn a owl:ObjectProperty ;
    rdfs:label "context of the trust run"@en ;
    rdfs:domain va:TrRun ;
    rdfs:range va:Context ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The context the trust rules were run for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcGlossOf a owl:ObjectProperty ;
    rdfs:label "member the gloss stands for"@en ;
    rdfs:domain va:LcGloss ;
    rdfs:range va:LcMember ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The method or state that the word or phrase of the gloss stands for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcClassedBy a owl:ObjectProperty ;
    rdfs:label "clue word that gave the class"@en ;
    rdfs:domain va:LcClassed ;
    rdfs:range va:LcWord ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The clue word that gave the span its class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcHitWord a owl:ObjectProperty ;
    rdfs:label "clue word found"@en ;
    rdfs:domain va:LcHit ;
    rdfs:range va:LcWord ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The clue word that was found in the unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcRankedBy a owl:ObjectProperty ;
    rdfs:label "rank of the source kind"@en ;
    rdfs:domain va:LcRel ;
    rdfs:range va:LcSourceRank ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The rank, given by the kind of text it was read from, that a relation read from words carries."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcParameterOf a owl:ObjectProperty ;
    rdfs:label "reader that uses the number"@en ;
    rdfs:domain va:LcParameter ;
    rdfs:range va:Reader ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The reader whose clue rules use the stipulated number."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

va:lcUnitFromSource a owl:ObjectProperty ;
    rdfs:label "source of the text unit"@en ;
    rdfs:domain va:LcUnit ;
    rdfs:range va:Source ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "The source (file) the unit of text was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
va:reachedByQuestion a owl:ObjectProperty ;
    rdfs:label "question that reaches the pair"@en ;
    rdfs:domain va:DeChain ;
    rdfs:range va:AgQuestion ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/discovery-ontology> ;
    skos:definition "An ordering question, held in the context, that the pair is reached by."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#AgreementMeasure> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
<http://example.org/variant-algebra#ExclusiveState> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .
<http://example.org/variant-algebra#StateEstablishment> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/discovery-ontology> .

# ==== file variant_algebra_discovery_taxonomy_v1_0_0.ttl ====
@prefix va:    <http://example.org/variant-algebra#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> <http://purl.org/dc/terms/identifier> "variant_algebra_discovery_taxonomy_v1_0_0"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "variant_algebra_discovery_taxonomy"@en ;
    <http://www.w3.org/2002/07/owl#versionInfo> "1.0.0" .

# Real, new ontology extension (2026-09-22, owner-directed): a formal
# categorization of what the detection pipeline discovers, with real,
# traceable links between the three kinds -- so a semantic claim can be
# checked against, not just asserted independently of, the syntactic
# evidence it came from and the behavioral/documented confirmation (or
# contradiction) available for it.
#
# Grounding, checked directly before this file was written: NO real
# ontology-level representation of detected evidence existed at all --
# OperatorPairing (the Python dataclass every calculus emits) has no RDF
# class backing it anywhere in the shipped ontologies. This closes that
# gap, not extends something that already existed.
#
# Real, concrete motivation (Example 6, this session): a syntactic fact
# (method references RuntimeError) was synthesized into a semantically
# meaningless DSL statement ("ship requires RuntimeError") with nothing
# in the pipeline able to say "this semantic claim rests on weak
# grounds." This extension gives that a real, formal home.

# ---- The three real categories ----

va:DiscoveredCharacteristic a owl:Class ;
    rdfs:comment "Real, new (2026-09-22): superclass for anything the pipeline discovers from source or documentation analysis. Never instantiated directly -- always one of the three real subclasses below."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:SyntacticCharacteristic a owl:Class ;
    rdfs:subClassOf va:DiscoveredCharacteristic ;
    rdfs:comment "A raw, structural fact readable directly from AST shape -- 'method M references symbol S', 'class C declares attribute A'. This is what C1-C9 and C22-C29's own real detection produces at its most basic level, before any interpretation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:SemanticCharacteristic a owl:Class ;
    rdfs:subClassOf va:DiscoveredCharacteristic ;
    rdfs:comment "An INTERPRETED relationship -- a real VAF operator instance (Dependency, Exclusive, etc.) asserted as meaningful. Every real instance MUST link back to the syntactic evidence it was derived from via va:derivedFromSyntactic -- a semantic claim with no real syntactic grounding is not a semantic claim, it is an assertion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:BehavioralCharacteristic a owl:Class ;
    rdfs:subClassOf va:DiscoveredCharacteristic ;
    rdfs:comment "A real, TEMPORAL/execution-order fact -- 'method M's legal execution requires state S, established by a prior call to method N'. Distinct from SemanticCharacteristic: a semantic claim describes a structural relationship; a behavioral claim describes something true only at certain points during real execution, derived from real control-flow analysis (branches, loops, guard conditions)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:DocumentedIntent a owl:Class ;
    rdfs:comment "Real, new: the plain-language content of a docstring or comment, held as its own real characteristic so it can be compared against what the code structurally does, not silently ignored the way the pipeline previously treated all documentation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

# ---- Real, shared properties every DiscoveredCharacteristic carries ----

va:hasEvidenceStrength a owl:DatatypeProperty ;
    rdfs:domain va:DiscoveredCharacteristic ; rdfs:range xsd:string ;
    rdfs:comment "Real, established convention (matching the Python detection layer's own existing 'strong'/'weak' disposition, checked directly before reuse, not invented fresh): the detecting calculus's own confidence in this specific characteristic."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:hasSourceCalculus a owl:DatatypeProperty ;
    rdfs:domain va:DiscoveredCharacteristic ; rdfs:range xsd:string ;
    rdfs:comment "Which real calculus (C1-C9, C22-C29, or a new behavioral calculus) produced this characteristic -- real provenance, not an anonymous fact."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

# ---- Real, formal links between the three categories ----

va:derivedFromSyntactic a owl:ObjectProperty ;
    rdfs:domain va:SemanticCharacteristic ; rdfs:range va:SyntacticCharacteristic ;
    rdfs:comment "Real, REQUIRED traceability: which raw, structural fact(s) this semantic claim interprets. A SemanticCharacteristic instance with none is a real, disclosed modeling error, not a valid, ungrounded claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:confirmedByBehavioral a owl:ObjectProperty ;
    rdfs:domain va:SemanticCharacteristic ; rdfs:range va:BehavioralCharacteristic ;
    rdfs:comment "Real, optional, STRONGER grounding: does real control-flow analysis corroborate this semantic claim -- e.g., a detected Dependency edge whose guard condition genuinely gates the consequent action, not just a co-occurring symbol reference."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:contradictedByBehavioral a owl:ObjectProperty ;
    rdfs:domain va:SemanticCharacteristic ; rdfs:range va:BehavioralCharacteristic ;
    rdfs:comment "Real, disclosed conflict: control-flow analysis shows this semantic claim does NOT hold at the relevant execution point -- e.g., the 'dependency' target is written on a code path the guard never actually reaches."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:documentedAs a owl:ObjectProperty ;
    rdfs:domain va:DiscoveredCharacteristic ; rdfs:range va:DocumentedIntent ;
    rdfs:comment "Real link to the plain-language docstring/comment describing this characteristic's real, intended meaning, if any exists."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:agreesWithDocumentation a owl:DatatypeProperty ;
    rdfs:domain va:SemanticCharacteristic ; rdfs:range xsd:boolean ;
    rdfs:comment "Real, disclosed comparison result: does the documented intent (if any) match what was structurally/behaviorally found? Absent (not asserted) when there is no real documentation to compare against -- never defaulted to true or false."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

va:isWeaklyGrounded a owl:DatatypeProperty ;
    rdfs:domain va:SemanticCharacteristic ; rdfs:range xsd:boolean ;
    rdfs:comment "Real, computed flag (see the real, additive SHACL-AF rule in 02-shacl-safeguards/): true when a semantic claim rests ONLY on syntactic evidence, with neither real behavioral confirmation nor documented agreement -- exactly Example 6's own, real, confirmed case ('ship requires RuntimeError')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_discovery_taxonomy> .

# ==== file variant_algebra_evaluation_vocabulary_v1_13_0.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# Variant Algebra -- evaluation vocabulary v1.8.0 (VAF-WI-100, -111, -113, -117, -112, -118, -119, -121, -122; 2026-09-28)
# The terms the native evaluator (02-shacl-safeguards/variant_algebra_operator_rules_v7_0_0.ttl) needs beyond the
# core, the extended properties and the grammar alignment: the model context the parser now emits, the variation
# space of a component, candidates and their counts, and the truth of an expression in a candidate.

<http://example.org/variant-algebra/evaluation-vocabulary> rdfs:label "Variant Algebra evaluation vocabulary"@en ;
    owl:versionInfo "1.13.0" ;
    owl:versionIRI <http://example.org/variant-algebra/evaluation-vocabulary/1.13.0> ;
    owl:priorVersion <http://example.org/variant-algebra/evaluation-vocabulary/1.12.12> ;
    dcterms:created "2026-09-29"^^xsd:date ;
    rdfs:comment "1.12.0 (VAF-WI-116h) adds candidate review: a raw detection item's name validity, whether its operator is on the grammar's representable list (held as ontology data, not a Python set), the temporal-kind override for a Sequence/Next fact that is really a state move or an event, its disposition in priority order, whether its calculus is itself a behavioral confirmation, and whether its operator is relational. 1.11.0 (VAF-WI-116g) adds the reusable threshold gate (an observed count against a threshold, met when it is reached), used by the adaptive feedback policy suggestion and blacklist decisions. 1.10.0 (VAF-WI-116f) adds the failure diagnosis check: the static and execution signals a FAILed verdict's reason lines and execution report carry, the primary failure class they resolve to in priority order, and whether that class is terminal. 1.9.0 (VAF-WI-116e) adds the quality check: one metric assertion per dimension (its observed value, threshold, direction and the policy's severity for it), the check it belongs to, and the outcome that check produces. 1.8.0 (VAF-WI-122) adds recursion: a join's raw result and the representative that stands for all equal results (the stop condition of a recursive definition), and a variable that recurses through a negation. 1.7.0 (VAF-WI-121) adds the optimised calculus: a variable's definition flattened into product items, independent groups, split variables and their factors, sets generated where needed and variants listed on demand, the product of factor counts, and pruning of candidates at the slot where a statement is decided. 1.6.0 (VAF-WI-119) adds exclusion and dependency over the whole variant: the nodes a statement or a definition asserts, a relation's whole variants, an operand's sets contained in one, what each side contributes, a broken relation and a variable's consistent sets. 1.5.0 (VAF-WI-118) adds the generated sets (a node's sets, their members, keys and weights, the joins that build them, the requirements of a negation, the valid and canonical sets) and a model of definitions (a variable's definition root, its local variants); it deprecates the per-candidate terms of 3.x (a feature's presence, the names only one operand covers) and the expansion of 1.4.0. 1.4.0 (VAF-WI-112) adds a feature's presence apart from its truth, and the expansion of definitions (local variants, partial and complete expansions, the variation capacity); it deprecates the terms of classifier bodies, which left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28): a substitution's block is now its component. 1.3.0 (VAF-WI-117) adds the terms of the one meaning: the names an expression node covers and their absence in a candidate, and the expansion of a shorthand (keyword forms, order edges). 1.2.0 (VAF-WI-113) adds a substitution's model rewrite (the result component, blocks, written order, the chains, mappings and name resolution, the classifier replaced wholesale) and the A4 check's variant-level reading, and widens va:rewrittenBy to any candidate variant. 1.1.0 (VAF-WI-111) adds the combinatorial upper bound's partial products and a conditional substitution's rewritten candidates. Reuses va:CandidateVariant, va:Variant, va:variantOf, va:combinatorialUpperBound, va:derivedBySubstitution, va:enumerationBound, va:admissibleVariantCount, va:hasFeature, va:hasOperator, va:dependentSet, va:prerequisiteSet, va:members, va:hasListItem and the operator classes; declares only what none of them covers."@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_evaluation_vocabulary_v1_13_0"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---- model context, emitted by the parser
va:inBodyOf a owl:ObjectProperty ; rdfs:label "in body of"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement written in the body of a feature, linked to every feature carrying it (outermost to innermost). The statement holds in the context of its carriers: it is required only where they are present, and the names it declares are carried by them (owner, VAF-WI-098; thesis section 2.2.9.1). Dependencies are global and are not limited by it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:isOptionalList a owl:DatatypeProperty ; rdfs:label "is optional list"@en ; rdfs:domain va:ListExpression ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "'[a, b]': a list of optional items (owner, 2026-09-26). A name in it imposes nothing; an operator in it keeps its rule, with an exclusive choice reading at most one (the ontology's optional-wrapped exclusive)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasConditionExpression a owl:ObjectProperty ; rdfs:label "has condition expression"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The condition of 'a -> b when c', 'a ~ b when c' or '(e when c)' as an expression node, evaluated like any other expression; va:edgeCondition and va:substitutionCondition keep its text."@en ;
    rdfs:domain va:ConditionedExpression ;
    rdfs:range va:ComposableUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- the variation space
va:VariationSlot a owl:Class ; rdfs:label "Variation slot"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One feature's place in one component's variation space: the counts the feature may take in that component's candidates."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:slotOfComponent a owl:ObjectProperty ; rdfs:label "slot of component"@en ; rdfs:domain va:VariationSlot ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The component whose space holds the slot."@en ;
    rdfs:range va:Component ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:slotFeature a owl:ObjectProperty ; rdfs:label "slot feature"@en ; rdfs:domain va:VariationSlot ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The feature the slot counts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:slotIndex a owl:DatatypeProperty ; rdfs:label "slot index"@en ; rdfs:domain va:VariationSlot ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "Position of the slot, 1..n, in the order candidates decide their slots."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:variationSlotCount a owl:DatatypeProperty ; rdfs:label "variation slot count"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "Number of slots in a component's variation space."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:minCount a owl:DatatypeProperty ; rdfs:label "minimum count"@en ; rdfs:domain va:VariationSlot ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "Least count the slot's feature takes: 1 when mandatory or united, a repetition's lower bound, else 0; 0 when the feature is purged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:maxCount a owl:DatatypeProperty ; rdfs:label "maximum count"@en ; rdfs:domain va:VariationSlot ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "Greatest count the slot's feature takes: a repetition's upper bound (the component's va:enumerationBound for '*'), else 1; 0 when the feature is purged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:allowedCount a owl:DatatypeProperty ; rdfs:label "allowed count"@en ; rdfs:domain va:VariationSlot ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A count between the slot's minimum and maximum."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:CountValue a owl:Class ; rdfs:label "Count value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A natural number used as a count, generated from 0 up to the largest maximum count."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:numericValue a owl:DatatypeProperty ; rdfs:label "numeric value"@en ; rdfs:domain va:CountValue ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The number a count value stands for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:isPurgedIn a owl:ObjectProperty ; rdfs:label "is purged in"@en ; rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feature is removed from every variant of the component: the second operand of a subtraction statement, the operand of an inverse statement, a feature a division statement removes, or a feature partner exclusion leaves with no partner."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:exclusiveMember a owl:ObjectProperty ; rdfs:label "exclusive member"@en ; rdfs:domain va:ExclusiveOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A member of an exclusive choice. A chain a $ b $ c is one choice among its three members (VAF-WI-065)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasConstraintRoot a owl:ObjectProperty ; rdfs:label "has constraint root"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement of the component that every variant must satisfy (as opposed to one that declares features, bounds or removals)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- candidates
va:candidateOf a owl:ObjectProperty ; rdfs:label "candidate of"@en ; rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The component whose variation space the candidate belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:decidedUpTo a owl:DatatypeProperty ; rdfs:label "decided up to"@en ; rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The candidate has a count for the slots 1..n."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:branchedFrom a owl:ObjectProperty ; rdfs:label "branched from"@en ; rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The candidate extends this one by a count for the next slot."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasAssignment a owl:ObjectProperty ; rdfs:label "has assignment"@en ; rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A count the candidate gives one feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:assignedFeature a owl:ObjectProperty ; rdfs:label "assigned feature"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The feature an assignment counts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:assignedCount a owl:DatatypeProperty ; rdfs:label "assigned count"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "How often the feature occurs; 0 is absence."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:CompleteCandidate a owl:Class ; rdfs:subClassOf va:CandidateVariant ; rdfs:label "Complete candidate"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A candidate with a count for every slot of its component."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:AdmissibleCandidate a owl:Class ; rdfs:subClassOf va:CompleteCandidate ; rdfs:label "Admissible candidate"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A complete candidate every constraint root of its component holds in (or whose carriers are absent) and that breaks no carrier rule: a variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:holdsIn a owl:ObjectProperty ; rdfs:label "holds in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A feature is present in the candidate, or an expression's operator rule is satisfied there."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:failsIn a owl:ObjectProperty ; rdfs:label "fails in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A feature is absent from the candidate, or an expression's operator rule is violated there."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nestingViolatedIn a owl:ObjectProperty ; rdfs:label "nesting violated in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement in a body breaks the carrier rule in the candidate: a name it declares is present without its carrier, or a mandatory name or a repetition's lower bound is missing where its carriers are present."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialUpperBound a owl:DatatypeProperty ; rdfs:label "partial upper bound"@en ; rdfs:domain va:VariationSlot ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The product of (greatest declared count + 1) over the slots up to and including this one; the last slot's is the component's va:combinatorialUpperBound."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rewrittenBy a owl:ObjectProperty ; rdfs:label "rewritten by"@en ; rdfs:domain va:CandidateVariant ; rdfs:range va:ReplacementOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A conditional substitution applies to the candidate: its condition holds there and the substituted name is present."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:SubstitutedCandidate a owl:Class ; rdfs:subClassOf va:CandidateVariant ; rdfs:label "Substituted candidate"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An admissible candidate (or, in the variant-level reading, a renamed candidate) after the conditional substitutions that apply to it: each substituted name taken out and its replacement put in its place."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:substitutedFrom a owl:ObjectProperty ; rdfs:label "substituted from"@en ; rdfs:domain va:SubstitutedCandidate ; rdfs:range va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The admissible candidate the substitutions rewrote."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- a substitution's model rewrite (VAF-WI-113): the rules compute the result component
va:directlyInBodyOf a owl:ObjectProperty ; rdfs:label "directly in body of"@en ; rdfs:subPropertyOf va:inBodyOf ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement written in the body of this feature itself, not in a body inside it (the innermost of its va:inBodyOf carriers); a substitution's block is the body it is directly in, or the component."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:writtenOrder a owl:DatatypeProperty ; rdfs:label "written order"@en ; rdfs:domain va:ReplacementOperator ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The position of a substitution among the statements as written (1, 2, ...); the substitutions of a block apply one after another in this order (owner, 2026-09-26)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:substitutionBlock a owl:ObjectProperty ; rdfs:label "substitution block"@en ; rdfs:domain va:ReplacementOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The block a substitution rewrites: its component (1.4.0; until then the body it was directly in, or the component)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:blockDepth a owl:DatatypeProperty ; rdfs:label "block depth"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A body's depth: 0 for a body in the component's own statements, one more for each body around it; inner blocks are resolved before the blocks around them."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:chainBlock a owl:ObjectProperty ; rdfs:label "chain block"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The block of one step of a name's chain through a block's substitutions (a chain step is a node of its own)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:chainStart a owl:ObjectProperty ; rdfs:label "chain start"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name a chain through a block's substitutions starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:chainValue a owl:ObjectProperty ; rdfs:label "chain value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name a chain has reached at this step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:chainPos a owl:DatatypeProperty ; rdfs:label "chain position"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The written order of the substitution the chain step passed through; the next step follows the first later substitution of the name reached."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:mapBlock a owl:ObjectProperty ; rdfs:label "map block"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The block whose substitutions a mapping step combines: every name renamed in the block, from its original name (va:mapFrom) to the name the substitutions, applied in written order, leave it as (va:mapTo)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:mapFrom a owl:ObjectProperty ; rdfs:label "map from"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name a block's combined substitutions rename."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:mapTo a owl:ObjectProperty ; rdfs:label "map to"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name a block's combined substitutions leave a name as."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resOp a owl:ObjectProperty ; rdfs:label "resolution statement"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The statement one name resolution belongs to: a name the statement uses, being passed through the mappings of the blocks around it, innermost first."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resRef a owl:ObjectProperty ; rdfs:label "resolution reference"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node (an operand or a list member) whose name is being resolved."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resKind a owl:DatatypeProperty ; rdfs:label "resolution kind"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "What the resolved name is to the statement: 'ref' for a name it uses, 'carrier' for the feature a body belongs to (resolved only through the blocks around its declaration)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resLevel a owl:DatatypeProperty ; rdfs:label "resolution level"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The block depth the resolution has been carried to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resValue a owl:ObjectProperty ; rdfs:label "resolution value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name reached so far by the resolution."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finOp a owl:ObjectProperty ; rdfs:label "final resolution statement"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The statement a finished name resolution belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finRef a owl:ObjectProperty ; rdfs:label "final resolution reference"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node whose name the finished resolution gives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finKind a owl:DatatypeProperty ; rdfs:label "final resolution kind"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "As va:resKind, for a finished resolution."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finValue a owl:ObjectProperty ; rdfs:label "final resolution value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name a statement's node takes in the result: its name passed through every block around it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:droppedFromResult a owl:DatatypeProperty ; rdfs:label "dropped from result"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement that does not enter the result: a classifier's declaration, and every statement in its body, when the classifier is replaced wholesale (X ~ Y, no member of X with a line of its own, Y declared in the same block)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:copyOf a owl:ObjectProperty ; rdfs:label "copy of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A statement or node of the result component, and the statement or node of the model as written it was copied from, names resolved."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:substitutionResultOf a owl:ObjectProperty ; rdfs:label "substitution result of"@en ; rdfs:domain va:Component ; rdfs:range va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The result component (<model>_Result) and the model as written it is computed from: every statement not dropped, copied with its names resolved (owner, 2026-09-26: substitution results are stored; the model as written is kept unchanged)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- the A4 check's variant-level reading (VAF-WI-113)
va:substitutionReading a owl:ObjectProperty ; rdfs:label "substitution reading"@en ; rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "How a component's substitutions are read: absent, model-first (the substitution's meaning, the result component); va:VariantLevelReading for the A4 check's comparison, where the model's variants without its substitutions are renamed as the substitutions rename them."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:RenamedCandidate a owl:Class ; rdfs:subClassOf va:CandidateVariant ; rdfs:label "Renamed candidate"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "In the variant-level reading, an admissible candidate of the model without its substitutions with every name renamed by the unconditional substitutions (counts merged by the larger, a name renamed away counted 0)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:renamedFrom a owl:ObjectProperty ; rdfs:label "renamed from"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate a renamed copy was made from (the copy is complete, so the truth rules decide conditions on it)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- one meaning (VAF-WI-117): an expression's names and their absence; shorthands
va:nodeOfComponent a owl:ObjectProperty ; rdfs:label "node of component"@en ; rdfs:range va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An expression node and the component whose candidates decide it (a statement's operands, its condition, a shorthand's expansion; the result component's conditional substitutions included)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nameUnder a owl:ObjectProperty ; rdfs:label "name under"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A feature an expression node covers: a name anywhere in its operands (not in a condition it carries)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyLeftName a owl:ObjectProperty ; rdfs:label "only-left name"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name the left operand of a binary expression covers and the right operand does not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyRightName a owl:ObjectProperty ; rdfs:label "only-right name"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name the right operand of a binary expression covers and the left operand does not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:allNamesAbsentIn a owl:ObjectProperty ; rdfs:label "all names absent in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Every name the expression node covers is absent in the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:someNamePresentIn a owl:ObjectProperty ; rdfs:label "some name present in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name the expression node covers is present in the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyLeftAbsentIn a owl:ObjectProperty ; rdfs:label "only-left names absent in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Every name only the left operand covers is absent in the candidate (so, when there is none)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyRightAbsentIn a owl:ObjectProperty ; rdfs:label "only-right names absent in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Every name only the right operand covers is absent in the candidate (so, when there is none)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:expandsTo a owl:ObjectProperty ; rdfs:label "expands to"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A keyword statement and the expression it is shorthand for: exclusive (a | b | c) is a $ (b $ c); or (a, b, c) is a | (b | c); 'a requires b' is [(a < b) | b]. The statement takes its expansion's verdict. Evaluation only: the model as written is unchanged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:edgeExpandsTo a owl:ObjectProperty ; rdfs:label "edge expands to"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An order edge a -> b (or a >-> b) and the expression [(b < a) | a] it means in a variant ('b never without a'); the edge applies its condition to it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- 1.4.0 (VAF-WI-112): presence, and the expansion of definitions
va:presentIn a owl:ObjectProperty ; rdfs:label "present in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate counts the feature at least once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:absentIn a owl:ObjectProperty ; rdfs:label "absent in"@en ; rdfs:range va:CompleteCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate counts the feature zero times. A feature holds where it is present and fails where it is absent, except a variable with va:admitsEmptyVariant, which holds absent too."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:admitsEmptyVariant a owl:DatatypeProperty ; rdfs:label "admits empty variant"@en ; rdfs:domain va:Variable ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The variable's definition generates the empty set: evaluated as a unit in another definition, the variable holds when absent, with none of its names present, as its definition does."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:LocalVariant a owl:Class ; rdfs:label "Local variant"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variant of one definition with the variables it uses taken as units (the thesis's Tables 3.1-3.6)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasLocalVariant a owl:ObjectProperty ; rdfs:label "has local variant"@en ; rdfs:domain va:Variable ; rdfs:range va:LocalVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A local variant of the variable's definition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasMember a owl:ObjectProperty ; rdfs:label "has member"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name present in a local variant or an expansion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:PartialExpansion a owl:Class ; rdfs:label "Partial expansion"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A local variant with some of its variables replaced by one of their non-empty variants."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialExpansionOf a owl:ObjectProperty ; rdfs:label "partial expansion of"@en ; rdfs:domain va:PartialExpansion ; rdfs:range va:Variable ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The variable whose local variant the partial expansion starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:expansionOf a owl:ObjectProperty ; rdfs:label "expansion of"@en ; rdfs:range va:Variable ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A partial expansion with no variable left: a variant of the variable written in terminals."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:memberCount a owl:DatatypeProperty ; rdfs:label "member count"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The number of names in an expansion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sameExpansionAs a owl:ObjectProperty ; rdfs:label "same expansion as"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Two expansions of one variable with the same names (possible when two variables share a name): the later one (by IRI) is not counted."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:DistinctExpansion a owl:Class ; rdfs:label "Distinct expansion"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An expansion with no earlier expansion of the same names: one variant of the variable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:variationCapacity a owl:DatatypeProperty ; rdfs:label "variation capacity"@en ; rdfs:domain va:Variable ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of the variable's distinct variants written in terminals (the thesis's VP, Figure 3.2)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- 1.4.0 (VAF-WI-112): classifier bodies left the language; their terms are kept for stored models, deprecated
va:inBodyOf owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:directlyInBodyOf owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nestingViolatedIn owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:blockDepth owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resOp owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resRef owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resKind owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resLevel owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:resValue owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finKind owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:droppedFromResult owl:deprecated true ; skos:historyNote "Deprecated in 1.4.0 (VAF-WI-112): classifier bodies left the language (va:Decision_FeatureContentAsDefinitions_2026_09_28); no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- 1.5.0 (VAF-WI-118): generated sets, and a model of definitions
va:DefinitionModel a owl:Class ; rdfs:label "Model of definitions"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set of equations, one per variable (thesis section 3.5), evaluated by the operator rules as one context: its variables' sets are generated without candidates."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:definesVariable a owl:ObjectProperty ; rdfs:label "defines variable"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variable the model of definitions defines."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasDefinitionRoot a owl:ObjectProperty ; rdfs:label "has definition root"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The expression node (or name) a variable's definition writes; the variable stands for it: its sets are the root's."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
# ---- definitions check (VAF-WI-256): the entries of a model of definitions and what the check marks
va:DefinitionEntry a owl:Class ; rdfs:label "Definition entry"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One written definition of a model of definitions (a variable written twice is two entries)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:DefinitionRefusal a owl:Class ; rdfs:label "Definition refusal"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A reason a written definition is refused."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:entryOf a owl:ObjectProperty ; rdfs:label "entry of"@en ; rdfs:domain va:DefinitionEntry ; rdfs:range va:DefinitionModel ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The model of definitions the entry is written in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:entryDefines a owl:ObjectProperty ; rdfs:label "entry defines"@en ; rdfs:domain va:DefinitionEntry ; rdfs:range va:Variable ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The variable the entry defines."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:entryRoot a owl:ObjectProperty ; rdfs:label "entry root"@en ; rdfs:domain va:DefinitionEntry ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The expression node (an operator, a list) or name the entry writes; its range is any of these, so none is stated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:entryIndex a owl:DatatypeProperty ; rdfs:label "entry position"@en ; rdfs:domain va:DefinitionEntry ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "The place of the entry in the written order, from 1."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:refusedAs a owl:ObjectProperty ; rdfs:label "refused as"@en ; rdfs:domain va:DefinitionEntry ; rdfs:range va:DefinitionRefusal ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "Why the entry is refused (the first reason found)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasUnconventionalTerminal a owl:ObjectProperty ; rdfs:label "has unconventional terminal"@en ; rdfs:domain va:DefinitionModel ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ; skos:definition "A terminal of the model whose name does not start with a lower-case letter (reported, not refused)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:leafIn a owl:ObjectProperty ; rdfs:label "leaf in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A feature whose own sets a context generates: a slot of a component, a name under one of its nodes, or a variable of a model of definitions."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:atomsOf a owl:ObjectProperty ; rdfs:label "atoms of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node that collects the names a variable's own definition writes (its variables as units), for its local variants."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:weightOf a owl:ObjectProperty ; rdfs:label "weight of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A weight of a node, for one of the features the node covers."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:weightFeature a owl:ObjectProperty ; rdfs:label "weight feature"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feature a weight is for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:weightRank a owl:DatatypeProperty ; rdfs:label "weight rank"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feature's rank among the node's features, by IRI, from 0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:weightValue a owl:DatatypeProperty ; rdfs:label "weight value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "(the count ceiling + 1) to the power of the rank: a set's key sums count times weight over the node's features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:generable a owl:DatatypeProperty ; rdfs:label "generable"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The rules generate this node's sets: a basic feature, a repeated group, or an operator, list, shorthand or unconditioned edge whose operands are generable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:underNegation a owl:DatatypeProperty ; rdfs:label "under negation"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node is, or contains, a negation (! or -): its sets are kept apart by their requirements, not merged by key."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:SetJoin a owl:Class ; rdfs:label "Set join"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A request, made by an operator, to join one set of each side (or one set, or none) into a set of the operator's node."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinFor a owl:ObjectProperty ; rdfs:label "join for"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node whose set the join makes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinIn a owl:ObjectProperty ; rdfs:label "join in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The context of the join."@en ;
    rdfs:domain va:SetJoin ;
    rdfs:range [ a owl:Class ; owl:unionOf ( va:Component va:DefinitionModel ) ] ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinLeft a owl:ObjectProperty ; rdfs:label "join left"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The first set joined."@en ;
    rdfs:domain va:SetJoin ;
    rdfs:range va:CanonicalSet ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinRight a owl:ObjectProperty ; rdfs:label "join right"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The second set joined."@en ;
    rdfs:domain va:SetJoin ;
    rdfs:range va:CanonicalSet ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinStage a owl:DatatypeProperty ; rdfs:label "join stage"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The stage of a fold (a list's items, or a negation's features, one at a time)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinFinal a owl:DatatypeProperty ; rdfs:label "join final"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The join is the last stage of its fold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinResultOf a owl:ObjectProperty ; rdfs:label "join result of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The set a join made."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:joinedFrom a owl:ObjectProperty ; rdfs:label "joined from"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set a joined set was made from; it passes on its requirements."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:setOf a owl:ObjectProperty ; rdfs:label "set of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set the node generates: one of the variants the expression means, over the node's features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialOf a owl:ObjectProperty ; rdfs:label "partial of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set of a fold stage before the last."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:setFor a owl:ObjectProperty ; rdfs:label "set for"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The context (a component or a model of definitions) the set is generated in."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:CanonicalSet va:ValidSet va:CompleteCandidate ) ] ;
    rdfs:range [ a owl:Class ; owl:unionOf ( va:Component va:DefinitionModel ) ] ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:setKey a owl:DatatypeProperty ; rdfs:label "set key"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The set's key: the sum over the node's features of the set's count times the feature's weight."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:setMember a owl:ObjectProperty ; rdfs:label "set member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A member of a set: a feature with a count."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:memberFeature a owl:ObjectProperty ; rdfs:label "member feature"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feature of a set member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:memberTimes a owl:DatatypeProperty ; rdfs:label "member times"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The count of a set member (a feature on both sides of a join counts its larger count)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:foldStage a owl:DatatypeProperty ; rdfs:label "fold stage"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The stage whose set this is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:itemCount a owl:DatatypeProperty ; rdfs:label "item count"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of a list's items."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:itemRankIn a owl:ObjectProperty ; rdfs:label "item rank in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An item's rank node in a list."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rankList a owl:ObjectProperty ; rdfs:label "rank list"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The list a rank belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rankValue a owl:DatatypeProperty ; rdfs:label "rank value"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An item's rank among the list's items, by IRI, from 0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rankItem a owl:ObjectProperty ; rdfs:label "rank item"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The item ranked."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:universeOf a owl:ObjectProperty ; rdfs:label "universe of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One feature's counts, 0 to the count ceiling, for a negation's assignments."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:universeRank a owl:DatatypeProperty ; rdfs:label "universe rank"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feature's weight rank."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requires a owl:ObjectProperty ; rdfs:label "requires"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A requirement a set carries: it is valid only if the requirement holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requiresMember a owl:ObjectProperty ; rdfs:label "requires membership"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set of a conditioned expression (e when c) carries the requirement that its part on c's features is one of c's sets; the converse of va:requires, which requires that it is not (owner, 2026-10-15; VAF-WI-237)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requirementOn a owl:ObjectProperty ; rdfs:label "requirement on"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node whose sets the requirement names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requirementKey a owl:DatatypeProperty ; rdfs:label "requirement key"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The key that must not be one of that node's sets (a negation: this part is not the operand's)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requirementIn a owl:ObjectProperty ; rdfs:label "requirement in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The context of the requirement."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ValidSet a owl:Class ; rdfs:label "Valid set"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set whose requirements hold: one of the node's variants."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:CanonicalSet a owl:Class ; rdfs:label "Canonical set"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Of a node's sets with one key, the first by IRI (every set under a negation): the ones the node's parents join."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nestedNegationIn a owl:ObjectProperty ; rdfs:label "nested negation in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The node has a requirement on a node whose own sets carry requirements (a negation inside a negation): not decided."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:projectsTo a owl:ObjectProperty ; rdfs:label "projects to"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variable's set and the local variant it is seen as through its own definition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:localVariantOf a owl:ObjectProperty ; rdfs:label "local variant of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A local variant of a variable: its sets seen through the names its definition writes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:localKey a owl:DatatypeProperty ; rdfs:label "local key"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A local variant's key over those names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
# ---- 1.5.0: the per-candidate reading and the expansion of 1.4.0 retired (operator rules 4.0.0)
va:presentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:absentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:admitsEmptyVariant owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:LocalVariant owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasLocalVariant owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:PartialExpansion owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialExpansionOf owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:expansionOf owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:memberCount owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sameExpansionAs owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:DistinctExpansion owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyLeftName owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyRightName owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:allNamesAbsentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:someNamePresentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyLeftAbsentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:onlyRightAbsentIn owl:deprecated true ; skos:historyNote "Deprecated in 1.5.0 (VAF-WI-118): the operator rules 4.0.0 generate each expression's sets; no rule reads or writes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- exclusion and dependency over the whole variant (1.6.0, VAF-WI-119; va:Decision_WholeVariantIteration_2026_09_28)
va:assertedUnder a owl:ObjectProperty ; rdfs:label "asserted under"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An expression node a statement or a variable's definition asserts, linked to that statement's root or that variable: the root and, from an asserted node, its operands, list items, expansion and a variable's definition -- not the operand of a negation, the right side of a subtraction, the expansion of a conditioned edge or a condition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:relationFor a owl:ObjectProperty ; rdfs:label "relation for"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An exclusion X $ Y or a dependency X < Y asserted for a whole variant: a complete candidate of the component whose statement asserts it, or a valid set of the variable whose definition asserts it (va:Decision_CalculusFirstGlobalRelations_2026_09_28)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:containedIn a owl:ObjectProperty ; rdfs:label "contained in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A set of a relation's operand whose every counted feature is present in the whole variant; the empty set is contained in every variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:contributionOf a owl:ObjectProperty ; rdfs:label "contribution of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "What one side of a relation contributes to a whole variant: the features of every non-empty set of that side contained in it. Links the contribution to its relation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:contributionIn a owl:ObjectProperty ; rdfs:label "contribution in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The whole variant a contribution is read in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:contributionSide a owl:DatatypeProperty ; rdfs:label "contribution side"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Which side of the relation contributes: \"left\" or \"right\"."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:contributesFeature a owl:ObjectProperty ; rdfs:label "contributes feature"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A feature in a side's contribution."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:violatesRelation a owl:ObjectProperty ; rdfs:label "violates relation"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A whole variant that breaks a relation asserted for it: for X $ Y, both sides contribute and neither contribution contains the other; for X < Y, X contributes and no set of Y is contained in it. A candidate that breaks one is not admissible; a set that breaks one is not consistent."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ConsistentSet a owl:Class ; rdfs:label "consistent set"@en ; rdfs:subClassOf va:ValidSet ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A valid set of a variable that breaks no relation its definition asserts: one of the variable's variants."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- the optimised calculus (1.7.0, VAF-WI-121; va:Decision_CalculusOptimised_2026_09_28)
va:flatOf a owl:ObjectProperty ; rdfs:label "flat of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A step of flattening a variable's definition into the items of a product; links the step to the variable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:flatNode a owl:ObjectProperty ; rdfs:label "flat node"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The expression node a flattening step stands at."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:flatOptional a owl:DatatypeProperty ; rdfs:label "flat optional"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the node stands as an optional item (an item of an optional list)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:flatExpanded a owl:DatatypeProperty ; rdfs:label "flat expanded"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The step was expanded into its operands or items ('+' and lists in a mandatory position); a step not expanded is an item."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:flatItem a owl:DatatypeProperty ; rdfs:label "flat item"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The step is an item of the variable's product."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:itemName a owl:ObjectProperty ; rdfs:label "item name"@en ; rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A basic feature an item covers."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:linkedItem a owl:ObjectProperty ; rdfs:label "linked item"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Two items of one variable that share a name, and so cannot be generated apart."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:inGroup a owl:ObjectProperty ; rdfs:label "in group"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The group of items an item belongs to: the items it is linked to, directly or through others."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:groupOf a owl:ObjectProperty ; rdfs:label "group of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The variable a group of items belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:groupCount a owl:DatatypeProperty ; rdfs:label "group count"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "How many independent groups a variable's items form."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:groupItemCount a owl:DatatypeProperty ; rdfs:label "group item count"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "How many items a group has."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:productSplit a owl:DatatypeProperty ; rdfs:label "product split"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variable whose items form two or more independent groups (or one group that is a single split variable): it is counted as the product of its factors."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasFactor a owl:ObjectProperty ; rdfs:label "has factor"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An independent group of a split variable, generated on its own; a group that is a single split variable gives that variable's factors."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:factorView a owl:DatatypeProperty ; rdfs:label "factor view"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A list node the rules build to generate a factor, or an optional item of it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:setsNeededIn a owl:ObjectProperty ; rdfs:label "sets needed in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A node whose sets are generated in a model of definitions: a variable that is not split, a factor, a listed variable, and what a needed node uses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:listingRequestedFor a owl:ObjectProperty ; rdfs:label "listing requested for"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variable whose variants are asked for, so that a split variable's own sets are generated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:countsRepetitions a owl:DatatypeProperty ; rdfs:label "counts repetitions"@en ; rdfs:domain va:DefinitionModel ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "True when a model of definitions tells repetition counts apart (VAF-WI-229): a repeated group runs to its own upper bound and a variant is a set of features with counts. Absent, a variant is compared by presence and a repeated group counts as one unit, as in the thesis's capacities (operator rules 8.0.0)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:factorCount a owl:DatatypeProperty ; rdfs:label "factor count"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of a factor's consistent sets, each distinct set once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:factorRank a owl:DatatypeProperty ; rdfs:label "factor rank"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A factor's place among its variable's factors, by IRI."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rankedFactor a owl:ObjectProperty ; rdfs:label "ranked factor"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The factor a rank record is about."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rankedIn a owl:ObjectProperty ; rdfs:label "ranked in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The variable a rank record belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialProductOf a owl:ObjectProperty ; rdfs:label "partial product of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A running product of a split variable's factor counts; the last one is its variation capacity."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialRank a owl:DatatypeProperty ; rdfs:label "partial rank"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The rank of the last factor a running product includes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:partialValue a owl:DatatypeProperty ; rdfs:label "partial value"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The value of a running product."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rootLastSlot a owl:DatatypeProperty ; rdfs:label "root last slot"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The index of the last slot a statement names: the point at which a candidate decides it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rootLastSlotIn a owl:ObjectProperty ; rdfs:label "root last slot in"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component a statement's last slot is counted in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:deadEnd a owl:DatatypeProperty ; rdfs:label "dead end"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate whose counts already break a statement it has decided; it is not extended."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- recursion (1.8.0, VAF-WI-122; va:Decision_RecursionAllowed_2026_09_28)
va:rawSetOf a owl:ObjectProperty ; rdfs:label "raw set of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A join's result for a node before it is identified with the node's set of the same key."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rawPartialOf a owl:ObjectProperty ; rdfs:label "raw partial of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A fold stage's join result before it is identified with the stage's set of the same key."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:rawKey a owl:DatatypeProperty ; rdfs:label "raw key"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The key of a raw join result (0 for a node that covers no name)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:representedBy a owl:ObjectProperty ; rdfs:label "represented by"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The one set per node, fold stage and key that stands for a raw join result. Because sets are identified by key, they are finitely many, and a recursive definition's generation stops when a step adds none."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:recursesThroughNegation a owl:ObjectProperty ; rdfs:label "recurses through negation"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variable that reaches itself through the operand of '!' or the right side of '-', linked to its model: such a recursion has no least set of variants, and the model is refused."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- quality check (1.9.0, VAF-WI-116e; va:Decision_NoDecisionsInCode_2026_09_28)
va:QualityCheck a owl:Class ; rdfs:label "Quality Check"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One run of the quality dimensions over one piece of generated code, and the verifier outcome it feeds into."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:QualityMetricAssertion a owl:Class ; rdfs:label "Quality Metric Assertion"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One dimension's observed value and threshold, and the policy's severity for it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasMetric a owl:ObjectProperty ; rdfs:label "has metric"@en ; rdfs:domain va:QualityCheck ; rdfs:range va:QualityMetricAssertion ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A metric assertion measured for a quality check."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricDimension a owl:DatatypeProperty ; rdfs:label "metric dimension"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The dimension's name (cyclomatic, sloc, classes, methods_per_class, documentation, coupling, cohesion_lcom4)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricObserved a owl:DatatypeProperty ; rdfs:label "metric observed"@en ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The value measured for a dimension."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricThreshold a owl:DatatypeProperty ; rdfs:label "metric threshold"@en ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The policy's limit for a dimension."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricDirection a owl:DatatypeProperty ; rdfs:label "metric direction"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "\"max\": the metric violates above its threshold (a ceiling). \"min\": it violates below its threshold (a floor; documentation coverage)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricPolicySeverity a owl:DatatypeProperty ; rdfs:label "metric policy severity"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "\"WARN\" or \"FAIL\": the severity the policy assigns a dimension when it violates. Absent when the policy disables the dimension -- it is still measured, never enforced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricViolated a owl:DatatypeProperty ; rdfs:label "metric violated"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the observed value crosses the threshold in the direction the dimension names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:metricSeverity a owl:DatatypeProperty ; rdfs:label "metric severity"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The metric's policy severity, carried forward only when it violated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasFailures a owl:DatatypeProperty ; rdfs:label "has failures"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether any of a check's metrics carries FAIL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasWarnings a owl:DatatypeProperty ; rdfs:label "has warnings"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether any of a check's metrics carries WARN."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:priorOutcome a owl:DatatypeProperty ; rdfs:label "prior outcome"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The verifier's outcome (\"PASS\"|\"WARN\"|\"FAIL\") from the checks that ran before quality."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:finalOutcome a owl:DatatypeProperty ; rdfs:label "final outcome"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The verifier's outcome after quality: the prior outcome, escalated to FAIL by any FAIL metric (its own or the prior check's), otherwise to WARN by a WARN metric when the prior outcome was PASS."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- failure diagnosis (1.10.0, VAF-WI-116f; va:Decision_NoDecisionsInCode_2026_09_28)
va:FailureDiagnosisCheck a owl:Class ; rdfs:label "Failure Diagnosis Check"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One diagnose() call over a FAILed verdict: its reason lines and, when attached, its execution report."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:diagnosisReasonText a owl:DatatypeProperty ; rdfs:label "diagnosis reason text"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The verdict's reason lines, joined, searched for each check's FAIL marker."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:diagnosisExecOutcome a owl:DatatypeProperty ; rdfs:label "diagnosis execution outcome"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The attached execution report's outcome, when one is attached."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:diagnosisExecHasFailedChecks a owl:DatatypeProperty ; rdfs:label "diagnosis execution has failed checks"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the attached execution report has a check that did not pass."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sawSyntacticFail a owl:DatatypeProperty ; rdfs:label "saw syntactic fail"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The reason text names a syntactic FAIL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sawStructuralFail a owl:DatatypeProperty ; rdfs:label "saw structural fail"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The reason text names a structural FAIL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sawContractFail a owl:DatatypeProperty ; rdfs:label "saw contract fail"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The reason text names a contract FAIL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sawFabricationFail a owl:DatatypeProperty ; rdfs:label "saw fabrication fail"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The reason text names a fabrication FAIL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sawQualityFail a owl:DatatypeProperty ; rdfs:label "saw quality fail"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The reason text names a FAIL-severity quality violation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:primaryClass a owl:DatatypeProperty ; rdfs:label "primary class"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The highest-priority failure signal present (SYNTACTIC | STRUCTURAL | CONTRACT | FABRICATION | QUALITY | RESOURCE | EXECUTION), else UNKNOWN."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:isTerminal a owl:DatatypeProperty ; rdfs:label "is terminal"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the primary class (RESOURCE or UNKNOWN) is unlikely to be fixed by more synthesis attempts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- threshold gate (1.11.0, VAF-WI-116g; va:Decision_NoDecisionsInCode_2026_09_28)
va:ThresholdCheck a owl:Class ; rdfs:label "Threshold Check"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A reusable evidence gate: an observed count against a threshold. Used by the adaptive feedback policy suggestion (E2) and the variant blacklist (E3)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:checkObserved a owl:DatatypeProperty ; rdfs:label "check observed"@en ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The count the gate measures."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:checkThreshold a owl:DatatypeProperty ; rdfs:label "check threshold"@en ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The count the gate requires."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:checkMet a owl:DatatypeProperty ; rdfs:label "check met"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the observed count reached the threshold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- candidate review (1.12.0, VAF-WI-116h; va:Decision_NoDecisionsInCode_2026_09_28)
va:CandidateReview a owl:Class ; rdfs:label "Candidate Review"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One raw detection item under review: its operator, the name(s) it names, its calculus, reason and evidence strength."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:DSLRepresentableOperator a owl:Class ; rdfs:label "DSL Representable Operator"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An operator variant_dsl_grammar_v1_0_5.lark has a statement form for, checked directly against the grammar file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:BehavioralCalculusId a owl:Class ; rdfs:label "Behavioral Calculus Id"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A calculus id whose own evidence is itself a behavioral confirmation (not merely syntactic)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:RelationalOperator a owl:Class ; rdfs:label "Relational Operator"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An operator that asserts a relationship between two named things, so a weakly-grounded claim about it is flagged in the synthesized text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:operatorName a owl:DatatypeProperty ; rdfs:label "operator name"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The operator class name an ontology-data individual names (DSLRepresentableOperator or RelationalOperator)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:calculusId a owl:DatatypeProperty ; rdfs:label "calculus id"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The calculus id a BehavioralCalculusId individual names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewOperator a owl:DatatypeProperty ; rdfs:label "review operator"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's operator name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewCalc a owl:DatatypeProperty ; rdfs:label "review calc"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's calculus id."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewReason a owl:DatatypeProperty ; rdfs:label "review reason"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's detection reason text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewStrength a owl:DatatypeProperty ; rdfs:label "review strength"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's evidence strength (\"strong\" or \"weak\")."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewName a owl:DatatypeProperty ; rdfs:label "review name"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name a candidate review names, which must be a valid DSL identifier (one or more per review: a unary candidate's subject, a binary candidate's subject and object, or a group's members)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:allNamesValid a owl:DatatypeProperty ; rdfs:label "all names valid"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether every name a candidate review names is a valid DSL identifier."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:temporalKind a owl:DatatypeProperty ; rdfs:label "temporal kind"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "\"state\" or \"event\": why a detected Sequence/Next fact from C33 is not a model line."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:operatorRepresentable a owl:DatatypeProperty ; rdfs:label "operator representable"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a candidate review's operator can be represented in the current DSL grammar."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:disposition a owl:DatatypeProperty ; rdfs:label "disposition"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's outcome, in priority order: \"invalid_name\" | \"not_representable\" | \"weak\" | \"accepted\"."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:fromBehavioralCalculus a owl:DatatypeProperty ; rdfs:label "from behavioral calculus"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a candidate review's calculus is itself a behavioral confirmation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:isRelationalOperator a owl:DatatypeProperty ; rdfs:label "is relational operator"@en ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a candidate review's operator is relational."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:localVariantInModel a owl:ObjectProperty ;
    rdfs:label "model of definitions of the local variant"@en ;
    rdfs:domain va:LocalVariant ;
    rdfs:range va:DefinitionModel ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The model of definitions whose equation the local variant is a variant of."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

va:slotAllowsCount a owl:ObjectProperty ;
    rdfs:label "count the slot allows"@en ;
    rdfs:domain va:VariationSlot ;
    rdfs:range va:CountValue ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A count the feature of the slot may take, from 0 up to the largest count of the slot."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

va:diagnosisOf a owl:ObjectProperty ;
    rdfs:label "verdict diagnosed"@en ;
    rdfs:domain va:FailureDiagnosisCheck ;
    rdfs:range va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The failed verdict that the diagnose call was made over."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

va:feedsVerdict a owl:ObjectProperty ;
    rdfs:label "verdict the check feeds"@en ;
    rdfs:domain va:QualityCheck ;
    rdfs:range va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The verdict into which the outcome of the quality check goes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

va:assertedUnderPolicy a owl:ObjectProperty ;
    rdfs:label "policy of the assertion"@en ;
    rdfs:domain va:QualityMetricAssertion ;
    rdfs:range va:QualityPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The policy that gave the threshold and the severity of the assertion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

va:gatesFeedbackLoop a owl:ObjectProperty ;
    rdfs:label "feedback loop the gate guards"@en ;
    rdfs:domain va:ThresholdCheck ;
    rdfs:range va:FeedbackLoop ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The feedback loop whose adaptive policy suggestion the evidence gate guards."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewedOperatorClass a owl:ObjectProperty ;
    rdfs:label "class of operators the review places its operator in"@en ;
    rdfs:domain va:CandidateReview ;
    rdfs:range [ a owl:Class ; owl:unionOf ( va:DSLRepresentableOperator va:RelationalOperator ) ] ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A class of operators (those the grammar has a statement form for, those that assert a relationship between two named things) that the operator of the reviewed item belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- candidate review, grounding and confirmations (VAF-WI-256)
va:reviewSubject a owl:DatatypeProperty ; rdfs:label "review subject"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's subject as written (a group's members comma-joined)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewObject a owl:DatatypeProperty ; rdfs:label "review object"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A candidate review's object as written; absent for a unary candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:reviewAgreesWithDocs a owl:DatatypeProperty ; rdfs:label "review agrees with documentation"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the documentation check made by the review found the candidate's claim stated in the program's documentation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:badName a owl:DatatypeProperty ; rdfs:label "bad name"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name told as invalid in the note of an invalid candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:isAccepted a owl:DatatypeProperty ; rdfs:label "is accepted"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the candidate is accepted: its disposition is accepted."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:noteKind a owl:DatatypeProperty ; rdfs:label "note kind"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The kind of note the candidate gets: invalid_name, not_representable, weak, guarded or accepted."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:confirmedByValueDomain a owl:DatatypeProperty ; rdfs:label "confirmed by value domain"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate (an exclusive pairing) is confirmed because its two names are members of one detected value domain."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:confirmedByRuntimeObservation a owl:DatatypeProperty ; rdfs:label "confirmed by runtime observation"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate (a state move) is confirmed because a runtime scenario also observed the move."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:realMaxBound a owl:DatatypeProperty ; rdfs:label "real maximum bound"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The upper bound a literal-bounded loop gives a repetition candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:groundedWeakly a owl:DatatypeProperty ; rdfs:label "grounded weakly"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate rests on syntactic evidence only: no behaviour, documentation, type system or runtime observation confirms it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:domainHasMember a owl:DatatypeProperty ; rdfs:label "domain has member"@en ; rdfs:domain va:ValueDomain ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A name that belongs to the value domain."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:RuntimeConfirmedMove a owl:Class ; rdfs:label "Runtime confirmed move"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A state move (from one state feature to the next) that a runtime scenario of the component also observed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:moveFrom a owl:DatatypeProperty ; rdfs:label "move from"@en ; rdfs:domain va:RuntimeConfirmedMove ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The state feature the observed move leaves."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:moveTo a owl:DatatypeProperty ; rdfs:label "move to"@en ; rdfs:domain va:RuntimeConfirmedMove ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The state feature the observed move arrives at."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:domainConfirmsCandidate a owl:ObjectProperty ; rdfs:label "value domain confirms candidate"@en ; rdfs:domain va:ValueDomain ; rdfs:range va:CandidateReview ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate an exclusive pairing of this domain's members confirms."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:moveConfirmsCandidate a owl:ObjectProperty ; rdfs:label "move confirms candidate"@en ; rdfs:domain va:RuntimeConfirmedMove ; rdfs:range va:CandidateReview ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The state-move candidate the observed move confirms."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- candidate matching (VAF-WI-256)
va:CandidateName a owl:Class ; rdfs:label "Candidate name"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One name a candidate names, in the order it names them, with the role it has in the candidate (subject, object, group member, alternative)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:NameRole a owl:Class ; rdfs:label "Name role"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The part a name plays in a candidate: subject, object, member of a group, or one of the further alternatives of a dependency."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:MatchRequest a owl:Class ; rdfs:label "Match request"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A request to write the accepted candidates of one component as model statements; it names the component to use when no candidate belongs to a class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ComponentStatement a owl:Class ; rdfs:label "Component statement"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "One model statement a candidate becomes inside one component block."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:StatementForm a owl:Class ; rdfs:label "Statement form"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The written form of the statement an operator becomes (for one variant of it: plain, bounded, guarded, with alternatives), with places for the names, the bound, the condition and the alternatives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nameOf a owl:ObjectProperty ; rdfs:label "name of"@en ; rdfs:domain va:CandidateName ; rdfs:range va:CandidateReview ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate that names this name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nameRole a owl:ObjectProperty ; rdfs:label "name role"@en ; rdfs:domain va:CandidateName ; rdfs:range va:NameRole ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The part this name plays in its candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nameText a owl:DatatypeProperty ; rdfs:label "name text"@en ; rdfs:domain va:CandidateName ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name as the calculus wrote it, with its class in front when it has one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:nameIndex a owl:DatatypeProperty ; rdfs:label "name index"@en ; rdfs:domain va:CandidateName ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The place of the name among those of its role in the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:candidatePosition a owl:DatatypeProperty ; rdfs:label "candidate position"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The place of the candidate among those of its request, in the order they were found."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:candidateOfRequest a owl:ObjectProperty ; rdfs:label "candidate of request"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:MatchRequest ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The request the accepted candidate is to be written for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:requestComponentName a owl:DatatypeProperty ; rdfs:label "request component name"@en ; rdfs:domain va:MatchRequest ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name of the component block used when no candidate belongs to a class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ownsMember a owl:DatatypeProperty ; rdfs:label "owns member"@en ; rdfs:domain va:Class ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The bare name of a member (an attribute or a method) the class declares."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasScopedName a owl:DatatypeProperty ; rdfs:label "has scoped name"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a name of the candidate already has its class written in front."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:allNamesOwned a owl:DatatypeProperty ; rdfs:label "all names owned"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether every name of the unscoped candidate is a member of some class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:commonOwner a owl:ObjectProperty ; rdfs:label "common owner"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A class that owns every name of the unscoped candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:prescopedTo a owl:ObjectProperty ; rdfs:label "given to class"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The one class that owns every name of the unscoped candidate; its names are then written with that class in front."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:crossKind a owl:DatatypeProperty ; rdfs:label "cross kind"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Why the candidate crosses classes and is left out of every component: prescope (its names are owned by different classes) or route (its two classes are unrelated by inheritance)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:subjectOwner a owl:ObjectProperty ; rdfs:label "subject owner"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The class of the candidate's subject."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:objectOwner a owl:ObjectProperty ; rdfs:label "object owner"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The class of the candidate's object."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:routedTo a owl:ObjectProperty ; rdfs:label "routed to"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The class whose component the candidate is written in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:componentForClass a owl:ObjectProperty ; rdfs:label "component for class"@en ; rdfs:domain va:Component ; rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The class of the program a component block is written for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:componentOfRequest a owl:ObjectProperty ; rdfs:label "component of request"@en ; rdfs:domain va:Component ; rdfs:range va:MatchRequest ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The request a component block is written for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementIn a owl:ObjectProperty ; rdfs:label "statement in"@en ; rdfs:domain va:ComponentStatement ; rdfs:range va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component block the statement is written in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementFor a owl:ObjectProperty ; rdfs:label "statement for"@en ; rdfs:domain va:ComponentStatement ; rdfs:range va:CandidateReview ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The candidate the statement says."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementRank a owl:DatatypeProperty ; rdfs:label "statement rank"@en ; rdfs:domain va:ComponentStatement ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Where the statement stands in its component: statements of the component's own class first, then those written for every component, each in the order found."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementPrefix a owl:DatatypeProperty ; rdfs:label "statement prefix"@en ; rdfs:domain va:ComponentStatement ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The class and a dot put in front of the names of the statement that were written without a class; empty when none is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementText a owl:DatatypeProperty ; rdfs:label "statement text"@en ; rdfs:domain va:ComponentStatement ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The statement as written in the model."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementKey a owl:DatatypeProperty ; rdfs:label "statement key"@en ; rdfs:domain va:ComponentStatement ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "What makes two statements of one component the same: the operator and the names as written."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statementRepeats a owl:DatatypeProperty ; rdfs:label "statement repeats"@en ; rdfs:domain va:ComponentStatement ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether an earlier statement of the same component already says the same."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:formForOperator a owl:ObjectProperty ; rdfs:label "form for operator"@en ; rdfs:domain va:StatementForm ; rdfs:range va:DSLRepresentableOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The operator whose statement this is the written form of."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:formVariant a owl:DatatypeProperty ; rdfs:label "form variant"@en ; rdfs:domain va:StatementForm ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Which variant of the operator's statement the form is for: plain, bounded, unbounded, guarded, alternatives; the note added to a weakly grounded statement is the weak-note."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:formText a owl:DatatypeProperty ; rdfs:label "form text"@en ; rdfs:domain va:StatementForm ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The text of the form, with @S@ for the subject, @O@ the object, @B@ the bound, @C@ the condition, @ALTS@ the further alternatives and @MEMBERS@ the group members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- candidate evidence: derived, documented and probed candidates (VAF-WI-256)
va:CandidateOrigin a owl:Class ; rdfs:label "Candidate origin"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Where a candidate comes from: a detection calculus (reviewed), the program's structure (derived) or its documentation (documented)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ProbePair a owl:Class ; rdfs:label "Probe pair"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Two methods of the component, in their bare names, one of which a candidate says needs the other; a probe runs the program to see whether it does."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:candidateOrigin a owl:ObjectProperty ; rdfs:label "candidate origin"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:CandidateOrigin ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Where the candidate comes from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:coversKey a owl:DatatypeProperty ; rdfs:label "covers key"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A pair of class-scoped names (subject, object) that an accepted dependency candidate already covers."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:statesKey a owl:DatatypeProperty ; rdfs:label "states key"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "An operator and its two names, as an accepted candidate states them (an exclusion in both orders)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:proposalKept a owl:DatatypeProperty ; rdfs:label "proposal kept"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a proposed (derived or documented) candidate becomes a candidate: it is not a self-relation, nothing accepted already says it, and no earlier proposal is the same."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:scopedStyle a owl:DatatypeProperty ; rdfs:label "scoped style"@en ; rdfs:domain va:MatchRequest ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether names are written with their class in front: the program has several classes or the evidence already names a member with its class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:writtenSubject a owl:DatatypeProperty ; rdfs:label "written subject"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The subject of a proposed candidate as it is written under the request's style."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:writtenObject a owl:DatatypeProperty ; rdfs:label "written object"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The object of a proposed candidate as it is written under the request's style."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:writtenName a owl:DatatypeProperty ; rdfs:label "written name"@en ; rdfs:domain va:CandidateName ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name of an alternative as it is written under the request's style."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:documentedKind a owl:DatatypeProperty ; rdfs:label "documented kind"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "What the documentation says of the pair: only after, or only before."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ownsMethod a owl:DatatypeProperty ; rdfs:label "owns method"@en ; rdfs:domain va:Class ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The bare name of a method the class declares."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:probeFrom a owl:DatatypeProperty ; rdfs:label "probe from"@en ; rdfs:domain va:ProbePair ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The method that needs the other."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:probeTo a owl:DatatypeProperty ; rdfs:label "probe to"@en ; rdfs:domain va:ProbePair ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The method that is needed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:probedFor a owl:ObjectProperty ; rdfs:label "probed for"@en ; rdfs:domain va:CandidateReview ; rdfs:range va:ProbePair ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The pair of methods a probe of the running program tests for this candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:probeVerdict a owl:DatatypeProperty ; rdfs:label "probe verdict"@en ; rdfs:domain va:ProbePair ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "What the probe saw: confirmed, refuted or inconclusive."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:groundedWeaklyAfterProbe a owl:DatatypeProperty ; rdfs:label "grounded weakly after probe"@en ; rdfs:domain va:CandidateReview ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The probed candidate is still only syntactically grounded: it was weak and the probe did not confirm it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:probeCompleted a owl:DatatypeProperty ; rdfs:label "probe completed"@en ; rdfs:domain va:MatchRequest ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The probe of the running program has been made and its verdicts, where it gave any, are recorded."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ---- the adaptive feedback decisions (VAF-WI-256): which thresholds to suggest raising, which variants to blacklist, when a loop of attempts stops
va:PolicyAdjustmentRequest a owl:Class ; rdfs:label "Policy adjustment request"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A request to suggest raising quality thresholds from the sessions the feedback store holds: how many quality-diagnosed sessions are enough, the size of one step and the largest total step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:minEvidence a owl:DatatypeProperty ; rdfs:label "minimum evidence"@en ; rdfs:domain va:PolicyAdjustmentRequest ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of sessions with a quality diagnostic that earns a suggestion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:adjustmentFactor a owl:DatatypeProperty ; rdfs:label "adjustment factor"@en ; rdfs:domain va:PolicyAdjustmentRequest ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The share of its current value by which one suggestion raises a threshold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:maxTotalFactor a owl:DatatypeProperty ; rdfs:label "largest total factor"@en ; rdfs:domain va:PolicyAdjustmentRequest ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The largest multiple of its current value a suggested threshold may reach."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasEvidenceGate a owl:ObjectProperty ; rdfs:label "has evidence gate"@en ; rdfs:domain va:PolicyAdjustmentRequest ; rdfs:range va:ThresholdCheck ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The threshold check that compares the sessions with a quality diagnostic with the evidence the request needs."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:PolicyThreshold a owl:Class ; rdfs:label "Policy threshold"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The current numeric threshold of one quality dimension, as the caller of a policy adjustment request gives it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:thresholdOf a owl:ObjectProperty ; rdfs:label "threshold of request"@en ; rdfs:domain va:PolicyThreshold ; rdfs:range va:PolicyAdjustmentRequest ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The policy adjustment request that is given this threshold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:thresholdDimension a owl:DatatypeProperty ; rdfs:label "threshold dimension"@en ; rdfs:domain va:PolicyThreshold ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name of the quality dimension the threshold limits (cyclomatic, sloc, coupling, cohesion_lcom4, documentation)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:thresholdValue a owl:DatatypeProperty ; rdfs:label "threshold value"@en ; rdfs:domain va:PolicyThreshold ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The current numeric value of the threshold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:PolicySuggestion a owl:Class ; rdfs:label "Policy suggestion"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A suggestion to raise one quality threshold to accept broader variant generation; it changes no policy, the caller decides."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:raisesThreshold a owl:ObjectProperty ; rdfs:label "raises threshold"@en ; rdfs:domain va:PolicySuggestion ; rdfs:range va:PolicyThreshold ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The threshold the suggestion proposes to raise."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:suggestedThreshold a owl:DatatypeProperty ; rdfs:label "suggested threshold"@en ; rdfs:domain va:PolicySuggestion ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The raised value: the current value increased by the adjustment factor, not above the largest total factor."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:suggestionEvidence a owl:DatatypeProperty ; rdfs:label "suggestion evidence"@en ; rdfs:domain va:PolicySuggestion ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of sessions with a quality diagnostic that support the suggestion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:suggestionOrder a owl:DatatypeProperty ; rdfs:label "suggestion order"@en ; rdfs:domain va:PolicySuggestion ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The place of the suggestion in the list: the order of the relaxable dimensions."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:ComponentVariantPair a owl:Class ; rdfs:label "Component and variant pair"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variant of a component, named as the feedback store and the blacklist name it: the component's name and the variant's name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:pairComponentName a owl:DatatypeProperty ; rdfs:label "pair component name"@en ; rdfs:domain va:ComponentVariantPair ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name of the component."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:pairVariantName a owl:DatatypeProperty ; rdfs:label "pair variant name"@en ; rdfs:domain va:ComponentVariantPair ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The name of the variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sessionOfPair a owl:ObjectProperty ; rdfs:label "session of pair"@en ; rdfs:domain va:FeedbackSession ; rdfs:range va:ComponentVariantPair ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component and variant the feedback session ran on."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:sessionPosition a owl:DatatypeProperty ; rdfs:label "session position"@en ; rdfs:domain va:FeedbackSession ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The place of the session in the feedback store, counted from zero in the order it was recorded."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:BlacklistEntry a owl:Class ; rdfs:label "Blacklist entry"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A variant of a component excluded from synthesis, by the owner's hand or by the rules after repeated exhaustion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:entryOfPair a owl:ObjectProperty ; rdfs:label "entry of pair"@en ; rdfs:domain va:BlacklistEntry ; rdfs:range va:ComponentVariantPair ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component and variant the blacklist entry excludes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:BlacklistUpdateRequest a owl:Class ; rdfs:label "Blacklist update request"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A request to extend the blacklist from the feedback store: how many exhausted sessions of one variant are enough."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:blacklistThreshold a owl:DatatypeProperty ; rdfs:label "blacklist threshold"@en ; rdfs:domain va:BlacklistUpdateRequest ; rdfs:range xsd:double ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of exhausted sessions of one component and variant that earns a place on the blacklist."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:hasExhaustionGate a owl:ObjectProperty ; rdfs:label "has exhaustion gate"@en ; rdfs:domain va:ComponentVariantPair ; rdfs:range va:ThresholdCheck ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The threshold check that compares the exhausted sessions of the pair with the blacklist threshold."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:BlacklistAddition a owl:Class ; rdfs:label "Blacklist addition"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "A component and variant the rules add to the blacklist because the exhaustion gate is met and no entry excludes it yet."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:additionOfPair a owl:ObjectProperty ; rdfs:label "addition of pair"@en ; rdfs:domain va:BlacklistAddition ; rdfs:range va:ComponentVariantPair ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component and variant the addition puts on the blacklist."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:exhaustedSessionCount a owl:DatatypeProperty ; rdfs:label "exhausted session count"@en ; rdfs:domain va:BlacklistAddition ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of exhausted sessions of the pair that supports the addition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:firstExhaustedPosition a owl:DatatypeProperty ; rdfs:label "first exhausted position"@en ; rdfs:domain va:BlacklistAddition ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The place in the feedback store of the pair's first exhausted session; the additions are listed in this order."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:checksPair a owl:ObjectProperty ; rdfs:label "checks pair"@en ; rdfs:domain va:ThresholdCheck ; rdfs:range va:ComponentVariantPair ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The component and variant whose exhausted sessions the threshold check counts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:maxAttempts a owl:DatatypeProperty ; rdfs:label "largest number of attempts"@en ; rdfs:domain va:FeedbackLoop ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The number of attempts after which the loop gives up."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:abortOnTerminal a owl:DatatypeProperty ; rdfs:label "abort on terminal"@en ; rdfs:domain va:FeedbackLoop ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether a terminal failure (a resource limit or an unknown cause) stops the loop at once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:variantBlacklisted a owl:DatatypeProperty ; rdfs:label "variant blacklisted"@en ; rdfs:domain va:FeedbackSession ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "Whether the blacklist excludes the component and variant the session is asked to run on."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .
va:attemptNeedsDiagnosis a owl:DatatypeProperty ; rdfs:label "attempt needs diagnosis"@en ; rdfs:domain va:FeedbackAttempt ; rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    skos:definition "The attempt's verdict is neither a pass nor a warning, so its failure has to be diagnosed before the loop can decide."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
va:additionUnderRequest a owl:ObjectProperty ;
    rdfs:label "addition under request"@en ;
    rdfs:domain va:BlacklistAddition ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/evaluation-vocabulary> ;
    rdfs:range va:BlacklistUpdateRequest ;
    skos:definition "The blacklist update request whose exhaustion threshold the addition met."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/evaluation-vocabulary> .

# ==== file variant_algebra_grammar_alignment_v1_0_36.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- grammar alignment v1.0.0 (extension file; the base ontology is not mutated)
# Owner decisions of 2026-09-25 (grammar work, VAF-WI-065): D1-D6. Checked by
# 06-runtime/src/test_grammar_consistency_v1_0_38.py against 06-runtime/src/variant_dsl_grammar_v1_0_5.lark.
# ============================================================

<http://example.org/variant-algebra/grammar-alignment> owl:versionInfo "1.0.36" ;
    owl:versionIRI <http://example.org/variant-algebra/grammar-alignment/1.0.36> ;
    owl:priorVersion <http://example.org/variant-algebra/grammar-alignment/1.0.35> ;
    dcterms:title "Variant Algebra -- grammar alignment"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_grammar_alignment_v1_0_36"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# D2: Intersection binds at level 3, with Cartesian and Division -- where the grammar already places it.
va:IntersectionOperator va:operatorPrecedence "3"^^xsd:nonNegativeInteger ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:keywordForm a owl:AnnotationProperty ; rdfs:label "keyword form"@en ;
    skos:definition "D5: a readable alias in the modelling language for an operator whose canonical form is its thesis symbol. Alias and symbol give the same variants (checked by the grammar test)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:grammarForm a owl:AnnotationProperty ; rdfs:label "grammar form"@en ;
    skos:definition "How the modelling language writes an operator when that differs from its ontology symbol."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:ExclusiveOperator va:keywordForm "exclusive (a | b)" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:OrOperator va:keywordForm "or (a, b)" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:DependencyOperator va:keywordForm "a requires b" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:SubtractionOperator va:keywordForm "a removes b" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:AdditionOperator va:keywordForm "unite (a, b)" ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:RepetitionOperator va:grammarForm "a[min..max] ; a[n] exact ; {a, b}[min..max] (group of two or more, repeated as a unit) ; {a, b} zero or more ; braces also accepted around a single feature" ;
    skos:note "Owner decisions 2026-09-25: braces mark a repeated group and are needed only when it has more than one element; brackets count or limit the repetition; a braced group repeats as a unit (its members occur equally often). The thesis also gives the bracketed form {a} (eq. 2.39, level 7). '#' remains the grammar's comment character."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:CartesianOperator va:keywordForm "a excludespartner b (partner exclusion; 'excludes' accepted as an older alias)" ;
    skos:note "D6 (2026-09-25): 'a excludespartner b' says a is not a valid partner of b in a Cartesian product -- not 'never together'. The earlier keyword 'excludes' invited that misreading and remains accepted so existing models keep parsing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:repeatsAsGroup a owl:DatatypeProperty ; rdfs:label "repeats as a group"@en ;
    skos:definition "{a, b}[m..n]: the operands of this repetition repeat as one unit, occurring equally often."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:substitutionCondition a owl:DatatypeProperty ; rdfs:label "substitution condition"@en ;
    skos:definition "'a ~ b when cond': the substitution applies only in variants where this condition holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:OptionalOperator va:grammarForm "[a] ; alias optional a" ;
    skos:note "Owner decision 2026-09-26: optional has the canonical form [a]. Brackets: [a] optional, a[m..n] a count; braces only repetition; parentheses grouping and member lists."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:derivedBySubstitution a owl:ObjectProperty ; rdfs:label "derived by substitution"@en ;
    skos:definition "Owner decision 2026-09-26: links the stored result of a model's substitutions to the substitutions that produced it. The result is also prov:wasDerivedFrom the model as written."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:changedBySubstitution a owl:ObjectProperty ; rdfs:label "changed by substitution"@en ;
    skos:definition "Links a rule in a stored substitution result to the substitution(s) that changed it, so the origin of every changed rule is visible."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:MandatoryOperator va:grammarForm "a bare name" ;
    skos:note "Owner, 2026-09-26: ',' is not an operator; it only separates the items of a list. A mandatory feature is written as a bare name (owner, 2026-09-22). The symbol ',' recorded for this operator in the base ontology is superseded and is to be removed there in its next version."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:ListExpression a owl:Class ; rdfs:label "List expression"@en ;
    skos:definition "(e1, e2, ...): a list whose every item holds. ',' only separates the items (owner, 2026-09-26). Example: a < (b, c) -- a depends on b and on c."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .
va:hasListItem a owl:ObjectProperty ; rdfs:label "has list item"@en ; rdfs:domain va:ListExpression ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:ConditionedExpression a owl:Class ; rdfs:label "Conditioned expression"@en ;
    skos:definition "(e when c): the sets of e in which the condition c holds, c read on the names of e (owner, 2026-10-15; VAF-WI-237). It is an expression node of its own, not an operator of the thesis: it has an operand (va:hasOperand) and a condition (va:hasConditionExpression). Example: ((a $ b) * (c $ d) when (a $ c)) keeps ad and bc. A condition of the form !k is read as e - k."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

va:TerminalFeature a owl:Class ; rdfs:subClassOf va:Feature ; rdfs:label "Terminal feature"@en ;
    skos:definition "Owner decision 2026-09-26: a name used in a model without being declared. It has no parts of its own. A terminal whose name does not start with a lower-case letter is reported with a warning. Its presence in variants is not constrained beyond the rules that name it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#ListExpression> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/grammar-alignment> .

# ==== file variant_algebra_harvest_vocabulary_v1_0_29.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# Variant Algebra -- harvest vocabulary v1.0.0 (VAF-WI-114; 2026-09-28)
# The terms the discovery calculi's rules read and write beyond the core and the extended properties: a harvested
# file and its lines (09-declarative-calculi/harvester_files_v1_0_27.py), the kinds C14-C17 give it, the working terms
# and ordered results of C10-C13, and C32's loop bounds. A syntax tree's own terms are in
# python_syntax_tree_vocabulary_v1_0_2.ttl.

<http://example.org/variant-algebra/harvest-vocabulary> rdfs:label "Variant Algebra harvest vocabulary"@en ;
    owl:versionInfo "1.0.29" ;
    owl:versionIRI <http://example.org/variant-algebra/harvest-vocabulary/1.0.29> ;
    owl:priorVersion <http://example.org/variant-algebra/harvest-vocabulary/1.0.28> ;
    dcterms:created "2026-09-28"^^xsd:date ;
    rdfs:comment "Reuses va:DeploymentArtifact, va:DatabaseSchemaArtifact, va:APISpecificationArtifact, va:ConfigurationArtifact, va:Feature, va:hasRawName, va:NameTerm, va:hasNameTerm, va:NamingPattern, va:matchesNamingPattern, va:TypeReference, va:typeName, va:hasTypeParameter, va:ValueDomain and va:hasDomainMember; declares only what none of them covers."@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_harvest_vocabulary_v1_0_29"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---- a harvested file
va:SourceFile a owl:Class ; rdfs:label "Source file"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A file as harvested: its name, its text and its lines."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:fileName a owl:DatatypeProperty ; rdfs:label "file name"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The file's name (or path) as given to the calculus."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:fileText a owl:DatatypeProperty ; rdfs:label "file text"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The file's whole text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:hasLine a owl:ObjectProperty ; rdfs:label "has line"@en ; rdfs:domain va:SourceFile ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A line of the file, as Python's str.splitlines divides the text (the line break not included)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:lineIndex a owl:DatatypeProperty ; rdfs:label "line index"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The line's position in the file, from 0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:lineText a owl:DatatypeProperty ; rdfs:label "line text"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The line's text, without its line break."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ---- C14-C17: the kind each calculus gives a file (the file is also typed by the calculus's artifact class)
va:deploymentKind a owl:DatatypeProperty ; rdfs:label "deployment kind"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "C14's kind for a va:DeploymentArtifact: dockerfile, docker-compose, kubernetes, terraform, ansible or systemd."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:databaseSchemaKind a owl:DatatypeProperty ; rdfs:label "database schema kind"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "C15's kind for a va:DatabaseSchemaArtifact: sql-ddl, orm-sqlalchemy, orm-django, orm-rails or migration."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:apiSpecificationKind a owl:DatatypeProperty ; rdfs:label "API specification kind"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "C16's kind for a va:APISpecificationArtifact: openapi, asyncapi, graphql, grpc-proto or wsdl."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:configurationKind a owl:DatatypeProperty ; rdfs:label "configuration kind"@en ; rdfs:domain va:SourceFile ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "C17's kind for a va:ConfigurationArtifact: dotenv, django-settings, java-properties, feature-flags or toml-config."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ---- C10-C11: a name's terms and patterns
va:splitOf a owl:ObjectProperty ; rdfs:label "split of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A step of C10's split of a name: the feature whose raw name is being split."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:splitIndex a owl:DatatypeProperty ; rdfs:label "split index"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The step's position: the index of the term the step's rest begins with."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:splitRest a owl:DatatypeProperty ; rdfs:label "split rest"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The part of the name not yet split, terms separated by '|'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:termIndex a owl:DatatypeProperty ; rdfs:label "term index"@en ; rdfs:domain va:NameTerm ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A name term's position in its name (terms that were empty keep their places, so indexes may skip)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:termText a owl:DatatypeProperty ; rdfs:label "term text"@en ; rdfs:domain va:NameTerm ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A name term's text, lower-cased."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:namingPatternOrder a owl:DatatypeProperty ; rdfs:label "naming pattern order"@en ; rdfs:domain va:NamingPattern ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A naming pattern's place in C11's declared order (getter 0 ... accessor 9), the order a name's matches are reported in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ---- C12: annotations as type references
va:annotationOf a owl:ObjectProperty ; rdfs:label "annotation of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An annotation of a function (a parameter's other than self, or the return annotation), read by C12."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:annotationPosition a owl:DatatypeProperty ; rdfs:label "annotation position"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The annotation's place among the function's: the parameter's index, the return annotation last."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:inAnnotationOf a owl:ObjectProperty ; rdfs:label "in annotation of"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A node of an annotation's tree (the annotation, a subscript's base or slice, a tuple's elements) of the function."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:typeParameterIndex a owl:DatatypeProperty ; rdfs:label "type parameter index"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A type parameter's position in its subscript's slice."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ---- C13: value domain members
va:domainMemberName a owl:DatatypeProperty ; rdfs:label "domain member name"@en ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The name a value domain's member assigns."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:domainMemberStatement a owl:DatatypeProperty ; rdfs:label "domain member statement"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The position, in the class body, of the assignment that declares the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:domainMemberTarget a owl:DatatypeProperty ; rdfs:label "domain member target"@en ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The member's position among its assignment's targets."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ---- C32: loop bounds
va:LoopBound a owl:Class ; rdfs:label "Loop bound"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "C32's fact: a for-loop over range(N) in a method adds at most N elements to a self attribute (an upper bound from that loop and call only)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:boundClass a owl:ObjectProperty ; rdfs:label "bound class"@en ; rdfs:domain va:LoopBound ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The class whose method holds the loop."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:boundMethod a owl:DatatypeProperty ; rdfs:label "bound method"@en ; rdfs:domain va:LoopBound ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The method's name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:boundAttribute a owl:DatatypeProperty ; rdfs:label "bound attribute"@en ; rdfs:domain va:LoopBound ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The self attribute the loop appends or adds to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:maxBound a owl:DatatypeProperty ; rdfs:label "max bound"@en ; rdfs:domain va:LoopBound ; rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "N: the most elements the loop adds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:boundLoop a owl:ObjectProperty ; rdfs:label "bound loop"@en ; rdfs:domain va:LoopBound ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The for-loop's syntax-tree node."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .
va:boundCall a owl:ObjectProperty ; rdfs:label "bound call"@en ; rdfs:domain va:LoopBound ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The append or add call's syntax-tree node."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ============================================================
# VAF-WI-252: the terms the rules and the code use, declared (written 2026-10-20). Each was used by a rule, a reader or a builder and
# declared nowhere; the labels and definitions say what the rules and the code do with them. Nothing here changes a rule.
# ============================================================

# ---- relations the Python harvester writes for the calculi C1 to C13
va:memberOfChain a owl:ObjectProperty ;
    rdfs:label "member of if-chain"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The chain of if and elif branches a branch belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:branchAssigns a owl:ObjectProperty ;
    rdfs:label "branch assigns"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute that the branch assigns."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:deletes a owl:ObjectProperty ;
    rdfs:label "deletes"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute that a method deletes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:combinedWithOr a owl:ObjectProperty ;
    rdfs:label "combined with or"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute that is combined with this one by an or in an expression."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:removalGuardedBy a owl:ObjectProperty ;
    rdfs:label "removal guarded by"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute whose test guards the removal of this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:nestedIterationOver a owl:ObjectProperty ;
    rdfs:label "iterates inside"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute that is iterated inside a loop over this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:setDifferenceOperand a owl:ObjectProperty ;
    rdfs:label "set difference operand"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The attribute on the right of a set difference with this one on the left."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:setIntersectionOperand a owl:ObjectProperty ;
    rdfs:label "set intersection operand"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The attribute on the right of a set intersection with this one on the left."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:coAssignedInTuple a owl:ObjectProperty ;
    rdfs:label "assigned together with"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute assigned in the same tuple as this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:initiallySetsAttribute a owl:DatatypeProperty ;
    rdfs:label "initially sets attribute"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute of the class and the constant its constructor sets it to, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:setsAttributeTo a owl:DatatypeProperty ;
    rdfs:label "sets attribute to"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute a method sets and the constant it sets it to, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:setsAttributeToWhen a owl:DatatypeProperty ;
    rdfs:label "sets attribute to when"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "An attribute a method sets, the value, and the condition, written attribute:value>condition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:raisesIfAttributeEqual a owl:DatatypeProperty ;
    rdfs:label "raises if attribute equals"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that raises when the attribute equals the value, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:raisesIfAttributeNotEqual a owl:DatatypeProperty ;
    rdfs:label "raises if attribute differs"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that raises when the attribute differs from the value, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:raisesIfAttributeIn a owl:DatatypeProperty ;
    rdfs:label "raises if attribute is among"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that raises when the attribute is among the values, written attribute:values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:raisesIfAttributeInValue a owl:DatatypeProperty ;
    rdfs:label "raises if attribute is this value"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "One value of a guard that raises when the attribute is among several values, written attribute:value; one fact per value, so that no rule has to split a list."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:raisesIfAttributeNotIn a owl:DatatypeProperty ;
    rdfs:label "raises if attribute is not among"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that raises when the attribute is not among the values, written attribute:values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:exitsIfAttributeEqual a owl:DatatypeProperty ;
    rdfs:label "exits if attribute equals"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that returns early when the attribute equals the value, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:exitsIfAttributeNotEqual a owl:DatatypeProperty ;
    rdfs:label "exits if attribute differs"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that returns early when the attribute differs from the value, written attribute:value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:exitsIfAttributeIn a owl:DatatypeProperty ;
    rdfs:label "exits if attribute is among"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that returns early when the attribute is among the values, written attribute:values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:exitsIfAttributeNotIn a owl:DatatypeProperty ;
    rdfs:label "exits if attribute is not among"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A guard that returns early when the attribute is not among the values, written attribute:values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:registersHandlerInto a owl:DatatypeProperty ;
    rdfs:label "registers handler into"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The collection a method registers a handler into."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:dispatchesHandlersFrom a owl:DatatypeProperty ;
    rdfs:label "dispatches handlers from"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The collection a method dispatches handlers from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:firesImmediately a owl:DatatypeProperty ;
    rdfs:label "fires immediately"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The event a method fires at once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:setsBeforeCall a owl:DatatypeProperty ;
    rdfs:label "sets before call"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "A state a method sets before it calls another."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:familyName a owl:DatatypeProperty ;
    rdfs:label "family name"@en ;
    rdfs:domain va:ProfileFamily ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The name of the profile family node."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:bcMembers a owl:DatatypeProperty ;
    rdfs:label "members of the class"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The number of variants in the behaviour class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:clauseClass a owl:DatatypeProperty ;
    rdfs:label "class the clause is about"@en ;
    rdfs:domain va:DocClause ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The name of the class that the clause was read for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

va:depClass a owl:DatatypeProperty ;
    rdfs:label "class of the member"@en ;
    rdfs:domain va:DepAtom ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/harvest-vocabulary> ;
    skos:definition "The name of the class that holds the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
<http://example.org/python-ast#Node> rdfs:subClassOf va:Artifact ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#LoopBound> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/harvest-vocabulary> .

# ==== file variant_algebra_implementation_register_v1_0_210.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- implementation register v1.0.0 (vocabulary; the data is generated into
# variant_algebra_implementation_register_data_v1_0_209.ttl by 03-tooling/vaf_implementation_register_v1_0_220.py
# and is never hand-edited). VAF-WI-099, Lineage 5 (ontology-native closure).
# Owner, 2026-09-27: 'the VAF implementation should be ontology native ... The only exception is where the
# ontology is not capable of ... Multiple implementations of the operators and calculus is not allowable.'
# ============================================================

<http://example.org/variant-algebra/implementation-register> owl:versionInfo "1.0.210" ;
    owl:versionIRI <http://example.org/variant-algebra/implementation-register/1.0.210> ;
    owl:priorVersion <http://example.org/variant-algebra/implementation-register/1.0.209> ;
    skos:changeNote "1.0.1 (2026-09-28, VAF-WI-110): no longer re-declares va:artifactPath, which the core declares (L-82); an implementation artifact is a core va:Artifact and uses the core property."@en ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    dcterms:title "Variant Algebra -- implementation register"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_implementation_register_v1_0_210"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:ImplementationArtifact a owl:Class ; rdfs:subClassOf va:Artifact ;
    rdfs:label "Implementation artifact"@en ;
    skos:definition "A file that implements part of VAF: a Python module, or a rule or query file the ontology executes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:ArtifactRole a owl:Class ;
    rdfs:label "Artifact role"@en ;
    skos:definition "What kind of work an artifact does, judged against the owner's rule that VAF is ontology native except where the ontology is not capable."@en ;
    owl:oneOf ( va:Role_NecessarilyProcedural va:Role_DelegatesToOntology va:Role_DecisionInCode va:Role_Superseded ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:Reachability a owl:Class ;
    rdfs:label "Reachability"@en ;
    owl:oneOf ( va:Reach_Production va:Reach_TestOnly va:Reach_Unreached ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:hasArtifactRole a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range va:ArtifactRole ;
    rdfs:label "has artifact role"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:hasReachability a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range va:Reachability ;
    rdfs:label "has reachability"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
# va:artifactPath: the core ontology's property (domain va:Artifact), used here for the path from the repository root.
va:artifactResponsibility a owl:DatatypeProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range xsd:string ;
    rdfs:label "responsibility"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:proceduralReason a owl:DatatypeProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range xsd:string ;
    rdfs:label "procedural reason"@en ;
    skos:definition "Why the ontology cannot do this artifact's work: which boundary of the graph it crosses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:roleEvidence a owl:DatatypeProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range xsd:string ;
    rdfs:label "role evidence"@en ; skos:definition "The functions or classes that show the role, each checked to exist in the file when the data is generated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:importsArtifact a owl:ObjectProperty ; rdfs:domain va:ImplementationArtifact ; rdfs:range va:ImplementationArtifact ;
    rdfs:label "imports"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:ArtifactRetirement a owl:Class ;
    rdfs:label "Artifact retirement"@en ;
    skos:definition "The record that an implementation artifact was deleted, with the artifact that replaced it and the reason. The file is gone; this record is what remains."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retiredArtifactPath a owl:DatatypeProperty ; rdfs:domain va:ArtifactRetirement ; rdfs:range xsd:string ;
    rdfs:label "retired artifact path"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:replacedByArtifact a owl:ObjectProperty ; rdfs:domain va:ArtifactRetirement ; rdfs:range va:ImplementationArtifact ;
    rdfs:label "replaced by"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retirementReason a owl:DatatypeProperty ; rdfs:domain va:ArtifactRetirement ; rdfs:range xsd:string ;
    rdfs:label "retirement reason"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:LanguageConcept a owl:Class ;
    rdfs:label "Language concept"@en ;
    skos:definition "Something the language means or computes that must have exactly one implementation: an operator, or one of the evaluation concepts below."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:ConceptImplementation a owl:Class ;
    rdfs:label "Concept implementation"@en ;
    skos:definition "One place where a language concept's meaning is implemented."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:implementsConcept a owl:ObjectProperty ; rdfs:domain va:ConceptImplementation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( va:Operator va:LanguageConcept ) ] ;
    rdfs:label "implements concept"@en ; skos:definition "The operator or evaluation concept implemented."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:implementedIn a owl:ObjectProperty ; rdfs:domain va:ConceptImplementation ; rdfs:range va:ImplementationArtifact ;
    rdfs:label "implemented in"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:implementationLocation a owl:DatatypeProperty ; rdfs:domain va:ConceptImplementation ; rdfs:range xsd:string ;
    rdfs:label "location"@en ; skos:definition "Function, class or shape name; checked to exist when the data is generated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:implementationUse a owl:DatatypeProperty ; rdfs:domain va:ConceptImplementation ; rdfs:range xsd:string ;
    rdfs:label "use"@en ; skos:definition "live | test-only | unreachable, as surveyed on 2026-09-27."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

# ------------------------------------------------------------
# VAF-WI-197 (lineage Lineage_VersionConformance): the verdict of the owner's rule for a tool -- 'Ontology native; if only the
# capabilities are not matching use the python' -- with the standard capability that was considered and the test that decided.
# ------------------------------------------------------------
va:AuditedArtifact a owl:Class ; rdfs:subClassOf va:ImplementationArtifact ;
    rdfs:label "Audited artifact"@en ;
    skos:definition "An implementation artifact whose procedural role has been tested against the standard capabilities (SHACL, SHACL-SPARQL, SPARQL, RDFC-1.0, PROV-O, OWL versioning) and carries the verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:CapabilityVerdict a owl:Class ;
    rdfs:label "Capability verdict"@en ;
    owl:oneOf ( va:Verdict_ReplaceableByStandard va:Verdict_PartlyStandard va:Verdict_NoStandardCapability ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

va:hasCapabilityVerdict a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain va:AuditedArtifact ; rdfs:range va:CapabilityVerdict ;
    rdfs:label "has capability verdict"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:standardCapabilityConsidered a owl:DatatypeProperty ; rdfs:domain va:AuditedArtifact ; rdfs:range xsd:string ;
    rdfs:label "standard capability considered"@en ;
    skos:definition "The standard capability that was tried, by the name of its standard."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:capabilityTest a owl:DatatypeProperty ; rdfs:domain va:AuditedArtifact ; rdfs:range xsd:string ;
    rdfs:label "capability test"@en ;
    skos:definition "The test or measurement that decided the verdict: a repository file and what it showed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

# ---- VAF-WI-256: each function of a module that is recorded as delegating to the ontology is read and classed ----
va:ArtifactFunction a owl:Class ;
    rdfs:label "Function of an artifact"@en ;
    skos:definition "One function or method of an implementation artifact, read by the person who recorded it and placed in exactly one function class. The class says what the function does; only the class Decides says that it chooses a domain outcome in code, which VAF forbids (va:Decision_NoDecisionsInCode_2026_09_28)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:functionOf a owl:ObjectProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range va:ImplementationArtifact ;
    rdfs:label "function of"@en ; skos:definition "The artifact the function is defined in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:hasFunctionClass a owl:ObjectProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range va:FunctionClass ;
    rdfs:label "has function class"@en ; skos:definition "What the function does, as read."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:functionName a owl:DatatypeProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range xsd:string ;
    rdfs:label "function name"@en ; skos:definition "The function's name qualified by the classes and functions it sits in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:functionLines a owl:DatatypeProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range xsd:integer ;
    rdfs:label "function lines"@en ; skos:definition "The lines the function takes, measured when the register is generated."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:functionBranches a owl:DatatypeProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range xsd:integer ;
    rdfs:label "function branches"@en ; skos:definition "The conditions, comparisons and conditional expressions in the function, counted from its syntax tree when the register is generated; the measure that told which functions to read first."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:FunctionClass a owl:Class ;
    rdfs:label "Function class"@en ;
    skos:definition "What a function does, in a closed set of six: it handles plumbing, harvests facts from an artifact, renders text, computes a number or a list, orchestrates calls to the rules and tools, or decides."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( va:Function_Plumbing va:Function_Harvest va:Function_Render va:Function_Compute va:Function_Orchestrate va:Function_Decide ) ] ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:hasDecisionDisposition a owl:ObjectProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range va:DecisionDisposition ;
    rdfs:label "has decision disposition"@en ; skos:definition "What is to become of a function that decides in code."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:DecisionDisposition a owl:Class ;
    rdfs:label "Decision disposition"@en ;
    skos:definition "What is to become of a function of the class Decide: it is converted into an ontology rule, or it is retained in Python on a recorded analysis of cost, benefit and risk."@en ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( va:Disposition_ConvertToRules va:Disposition_RetainedOnAnalysis ) ] ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:decisionMovesTo a owl:DatatypeProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range xsd:string ;
    rdfs:label "decision moves to"@en ; skos:definition "For a function to be converted: what it decides and which rule is to decide it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:RetentionAnalysis a owl:Class ;
    rdfs:label "Retention analysis"@en ;
    skos:definition "The analysis of cost, benefit and risk that justifies keeping a piece of Python where an ontology rule could do the work, because Python drifts and its derived files need housekeeping. It names the functions it covers, what keeping them costs and gains, the risk of keeping and of converting, and the verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:analysisCovers a owl:ObjectProperty ; rdfs:domain va:RetentionAnalysis ; rdfs:range va:ArtifactFunction ;
    rdfs:label "analysis covers"@en ; skos:definition "A function the analysis justifies keeping in Python."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:hasRetentionAnalysis a owl:ObjectProperty ; rdfs:domain va:ArtifactFunction ; rdfs:range va:RetentionAnalysis ;
    rdfs:label "has retention analysis"@en ; skos:definition "The analysis that justifies the function staying in Python."@en ;
    owl:inverseOf va:analysisCovers ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retentionCost a owl:DatatypeProperty ; rdfs:domain va:RetentionAnalysis ; rdfs:range xsd:string ; rdfs:label "cost of keeping"@en ;
    skos:definition "What keeping the code costs: lines to maintain, derived files, drift between the code and the rules."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retentionBenefit a owl:DatatypeProperty ; rdfs:domain va:RetentionAnalysis ; rdfs:range xsd:string ; rdfs:label "benefit of keeping"@en ;
    skos:definition "What keeping the code gains, and the measurement that shows it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retentionRisk a owl:DatatypeProperty ; rdfs:domain va:RetentionAnalysis ; rdfs:range xsd:string ; rdfs:label "risk of keeping and of converting"@en ;
    skos:definition "What can go wrong if the code stays, what can go wrong if it is converted, and what holds the risk down."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .
va:retentionVerdict a owl:DatatypeProperty ; rdfs:domain va:RetentionAnalysis ; rdfs:range xsd:string ; rdfs:label "verdict"@en ;
    skos:definition "What was decided on the analysis and what would reopen it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/implementation-register> .

# ==== file variant_algebra_matching_taxonomy_v1_0_2.ttl ====
@prefix vm:      <http://example.org/vaf-consolidated/matching#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .


# ============================================================
# VAF matching and unmatching taxonomy v1.0.0 (VAF-WI-240).
# Where two sources, or a source and a model, are compared, what the comparison can find: a match, an unmatch, an
# undecided case, or nothing to compare. It gathers the states VAF already holds in five places (agreement, nonconformity,
# knowledge category, operator candidate, ontology alignment) under one polarity, with an explanation, an illustration
# and the reference for each, for future academic work on VAF.
# The states themselves are defined in the discovery ontology and the alignment file; this file adds nothing to them and
# points at them (vm:describes). The polarity and strength given here are the session's reading of those definitions and
# are the owner's to amend. The illustrations are constructed for explanation, not taken from the toy data.
# Owner, 2026-10-18: 'our taxonomy and matching/unmatching concepts should also be covered in our taxonomy with its
# explanations and references ... especially useful in developing academic studies on the VAF in future.'
# ============================================================

<http://example.org/vaf-consolidated/matching> rdfs:label "VAF matching and unmatching taxonomy v1.0.0"@en ;
    dcterms:created "2026-10-18"^^xsd:date ;
    dcterms:identifier "variant_algebra_matching_taxonomy_v1_0_2" ;
    owl:versionInfo "1.0.2" ;
    owl:versionIRI <http://example.org/vaf-consolidated/matching/1.0.2> ;
    owl:priorVersion <http://example.org/vaf-consolidated/matching/1.0.1> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .
<http://example.org/vaf-consolidated/matching> sh:declare [ sh:prefix "vm" ; sh:namespace "http://example.org/vaf-consolidated/matching#"^^xsd:anyURI ] .

vm:describes a owl:AnnotationProperty ; rdfs:label "describes"@en ; skos:definition "The existing state, concept or value this entry classifies. Not copied: defined where it is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:family a owl:ObjectProperty ; rdfs:label "family"@en ; skos:definition "The place in VAF where the comparison is made."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:polarity a owl:ObjectProperty ; rdfs:label "polarity"@en ; skos:definition "What the comparison found: Matching, Unmatching, Undecided or NotCompared."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:strength a owl:DatatypeProperty ; rdfs:label "strength"@en ; skos:definition "strong: rests on a standing statement or a recorded fact; weak: rests on a description, a comment or an overlap only; none: no comparison is made."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:explanation a owl:DatatypeProperty ; rdfs:label "explanation"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:illustration a owl:DatatypeProperty ; rdfs:label "illustration"@en ; skos:definition "A constructed example for explanation, not a record from the toy data."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:reference a owl:ObjectProperty ; rdfs:label "reference"@en ;
    rdfs:domain vm:Entry ;
    rdfs:range vm:Reference ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:referenceText a owl:DatatypeProperty ; rdfs:label "reference text"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:referenceStatus a owl:DatatypeProperty ; rdfs:label "reference status"@en ; skos:definition "read: the source was opened; secondary: read only through a summary; named, not read: the owner or the model names it and no source was read."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:ownTerm a owl:DatatypeProperty ; rdfs:label "own term"@en ; skos:definition "True when the word is the project's own and not taken from a source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:Entry a skos:Concept ; skos:inScheme vm:MatchingScheme ; skos:prefLabel "Entry"@en ; skos:definition "One state, concept or value, classified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:Reference a owl:Class ; rdfs:label "Reference"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .
vm:Entry a skos:Concept, owl:Class ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
vm:Entry rdfs:subClassOf va:Concept ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/matching> .

# ==== file variant_algebra_operator_effect_taxonomy_v1_0_0.ttl ====
@prefix vo:      <http://example.org/vaf-consolidated/operator-effect#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# ---------------- Shapes: what the taxonomy must always satisfy ----------------
@prefix sh: <http://www.w3.org/ns/shacl#> .


# ============================================================
# VAF operator effect taxonomy v1.0.0 (VAF-WI-239).
# What each use of an operator does to the NUMBER of variants, stated as a law that a test recomputes on the evaluator,
# and the wording for it, with its source or the flag that the wording is the project's own.
# Built on top of the operator classes of the algebra ontology; no class is changed. The unit is the USE of an operator
# (an expression, or a constraint written as a statement), because one operator class can do both: a dependency written
# a < b combines, a dependency written a => b prunes.
# Owner, 2026-10-18: 'we need to cleanly categorize whether an operator is shrinking or expanding'; the wording
# (adding, multiplying, selective, complementing, mixed) accepted by the owner the same day.
# ============================================================

<http://example.org/vaf-consolidated/operator-effect> rdfs:label "VAF operator effect taxonomy v1.0.0"@en ;
    dcterms:created "2026-10-18"^^xsd:date ;
    dcterms:identifier "variant_algebra_operator_effect_taxonomy_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/operator-effect/1.0.0> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

vo:ofOperator a owl:ObjectProperty ; rdfs:label "of operator"@en ;
    skos:definition "The operator class of the algebra ontology whose use this is."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:hasDirection a owl:ObjectProperty ; rdfs:label "has direction"@en ;
    skos:definition "Whether the use enlarges or reduces the number of variants, or leaves it alone."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:hasKind a owl:ObjectProperty ; rdfs:label "has kind"@en ;
    skos:definition "How the use changes the number: by adding, by multiplying, by selecting, by complementing, or by two of these together."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:writtenAs a owl:DatatypeProperty ; rdfs:label "written as"@en ;
    skos:definition "The way the use is written in the modelling language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:countLaw a owl:DatatypeProperty ; rdfs:label "count law"@en ;
    skos:definition "What the number of variants of the result is, in terms of the numbers n1 and n2 of the operands, when the operands share no feature. The test recomputes it on the evaluator."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:generalBound a owl:DatatypeProperty ; rdfs:label "general bound"@en ;
    skos:definition "What holds when operands do share features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:wordingSource a owl:DatatypeProperty ; rdfs:label "wording source"@en ;
    skos:definition "Where the word for this kind or direction is taken from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:sourceStatus a owl:DatatypeProperty ; rdfs:label "source status"@en ;
    skos:definition "cited: a published source uses the word in this sense; elementary: the plain counting rule, no single source is claimed; own: the project's own term, to be kept apart from the literature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .
vo:thesisEquation a owl:DatatypeProperty ; rdfs:label "thesis equation"@en ;
    skos:definition "Where the operator is defined in the thesis (Altunel 2013), as the algebra ontology records it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/operator-effect> .

# ==== file variant_algebra_owner_decisions_v1_0_34.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra — owner design decisions, 2026-09-24 (v1.0.0)
#
# Recorded as prov:Activity individuals, following the precedent of va:Approval_TemporalOperators_2026_09_24
# (Lock #5A's approval provenance). BRSF's GovernanceRuling is not used: it records how the backlog framework
# itself is governed, not design decisions of a governed package.
# ============================================================

<http://example.org/variant-algebra/owner-decisions> owl:versionInfo "1.0.34" ;
    owl:versionIRI <http://example.org/variant-algebra/owner-decisions/1.0.34> ;
    owl:priorVersion <http://example.org/variant-algebra/owner-decisions/1.0.33> ;
    dcterms:title "Variant Algebra — owner design decisions"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_owner_decisions_v1_0_34"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:decisionStatement a owl:AnnotationProperty ; rdfs:label "decision statement"@en ;
    skos:definition "What was decided, in the owner's own words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/owner-decisions> .
va:decisionStatus a owl:AnnotationProperty ; rdfs:label "decision status"@en ;
    skos:definition "decided | decided, reading awaiting confirmation | pending."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/owner-decisions> .
va:decisionReading a owl:AnnotationProperty ; rdfs:label "reading"@en ;
    skos:definition "How the statement is read against VAF's own vocabulary, when the statement needs interpreting."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/owner-decisions> .
va:closesLimitation a owl:ObjectProperty ; rdfs:label "closes limitation"@en ;
    skos:definition "A decision that closes a disclosed, not-yet-closed limitation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/owner-decisions> .

va:DiscoveryScopeLimitation skos:changeNote "2026-09-24: closed by the owner's decision (va:Decision_ExtendDiscovery_2026_09_24): discovery extends to runtime observation and to temporal information in any corpus. The thesis named behavioural/dynamic discovery as future work (Altunel 2013, pp. 735-736); this is that future work, now authorised."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/owner-decisions> .

# ==== file variant_algebra_pipeline_workflow_v1_1_80.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra — Pipeline Workflow Vocabulary v1.0.0
#
# Completes, rather than replaces, the process model already declared in
# variant_algebra_v3_extended_properties_v1_0_80.ttl: the Discovery-Synthesis
# Pipeline, with a Request, a Result and a Verdict at each of its three
# stages (Discovery, Conversion, Synthesis), and its two named profiles.
# That model existed but nothing executed through it or recorded a run of it.
#
# Only links found missing (checked 2026-09-24 by a direct query of every
# property declared on the pipeline classes) are declared here, each one
# symmetric with a link that already exists:
#   Conversion Request  -converts from->  Discovery Result      (existed)
#   Conversion Request  -produces conversion->  Conversion Result (existed)
#   Discovery Request   -produces discovery->  Discovery Result   (new, symmetric)
#   Synthesis Request   -produces synthesis->  Synthesis Result   (new, symmetric)
#
# Not modelled here, deliberately: gated agent handoffs (a consuming system's
# own concept, owned by altunelyusuf/SCAMPS, which VAF must not depend on),
# and work-item lifecycle workflow (BRSF's Workflow, whose states are a closed
# set of six work-item states and cannot carry process stages).
# ============================================================

<http://example.org/variant-algebra/pipeline-workflow> owl:versionInfo "1.1.80" ;
    owl:versionIRI <http://example.org/variant-algebra/pipeline-workflow/1.1.80> ;
    owl:priorVersion <http://example.org/variant-algebra/pipeline-workflow/1.1.79> ;
    dcterms:modified "2026-10-18"^^xsd:date ;
    skos:changeNote "1.6.0 (2026-10-19, VAF-WI-249, Lineage 10): Feedback becomes the eighth step, after Execution. New: Feedback Request, Feedback Result, Feedback Finding, Feedback Verdict (Findings to act on, Nothing to correct) and the links between them. A finding names its kind, the place it is addressed to, the step it comes from and what it states; a run recorded as Completed needs a feedback stage and a run recorded as Stopped needs one that records the stop. Owner, 2026-10-19: verification, execution and feedback become pipeline steps and none is deferred."@en ;
    skos:changeNote "1.5.0 (2026-10-19, VAF-WI-248, Lineage 10): Execution becomes the seventh step, after Verification. New: Execution Request, Execution Result, Execution Verdict (Ran, Failed, Not run) and the links between them; a run recorded as Completed needs an execution that did not fail. Owner, 2026-10-19: verification, execution and feedback become pipeline steps and none is deferred."@en ;
    skos:changeNote "1.4.0 (2026-10-19, VAF-WI-247, Lineage 10): Verification becomes the sixth step, after Synthesis. New: Verification Request, Verification Result, Verification Check, Verification Verdict (Verified, Verified with warnings, Not verified), the run outcome (Completed or Stopped, so that a skipped step is visible) and the links between them. Owner, 2026-10-19: verification, execution and feedback are steps of the pipeline; none is left for later."@en ;
    skos:changeNote "1.3.0 (2026-10-18, VAF-WI-242, Lineage 10): Processing becomes the third step of five. New: Processing Request, Processing Result, Processing Finding, Processing Verdict (Counted, Void, Not counted) and the links between them. Owner, 2026-10-18: 'our mission is to enhance the VAF so that we can use VAF in big and real projects, safely' -- the size of a model and its anomalies are shown before it is listed."@en ;
    skos:changeNote "1.2.0 (2026-10-18, VAF-WI-241, Lineage 10): Agreement becomes the second step of four. New: Agreement Request, Agreement Result, Agreement Finding, Agreement Verdict (Matching, Unmatching, Undecided, Not compared -- the polarities of the matching taxonomy), and the links between them. Owner, 2026-10-18: matching and unmatching are part of the workflow, and the fit-gap found the agreement and nonconformity rules test-only."@en ;
    skos:changeNote "1.1.0 (2026-09-27, VAF-WI-103, Lineage 5): the pipeline's steps stated in the ontology -- entry criterion, task, verification, exit criterion, order and the shape that enforces each (ETVX) -- and the seven definitions of the pipeline found on 2026-09-27 recorded, one enforced and six superseded. Owner, 2026-09-27: 'We need to clarify the steps and fix it against possible drifts again.'"@en ;
    dcterms:title "Variant Algebra — Pipeline Workflow Vocabulary"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_pipeline_workflow_v1_1_80"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---- links from a run to its stages and profile ----

va:hasConversionStage a owl:ObjectProperty ;
    rdfs:label "has conversion stage"@en ;
    rdfs:domain va:DiscoverySynthesisPipeline ;
    rdfs:range va:ConversionResult ;
    skos:definition "Links a pipeline run to the Conversion Result of its middle stage. Completes the existing pair has discovery stage / has synthesis stage, which named the first and last stage but not the one between them."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:runsProfile a owl:ObjectProperty ;
    rdfs:label "runs profile"@en ;
    rdfs:domain va:DiscoverySynthesisPipeline ;
    rdfs:range va:VAFDomainProfile ;
    skos:definition "The domain profile a pipeline run executes — for example Software Variant Management. Makes explicit which of VAF's declared profiles a recorded run belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ---- request -> result, symmetric with 'produces conversion' ----

va:producesDiscovery a owl:ObjectProperty ;
    rdfs:label "produces discovery"@en ;
    rdfs:domain va:DiscoveryRequest ;
    rdfs:range va:DiscoveryResult ;
    skos:definition "Links a Discovery Request to the Discovery Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:producesSynthesis a owl:ObjectProperty ;
    rdfs:label "produces synthesis"@en ;
    rdfs:domain va:SynthesisRequest ;
    rdfs:range va:SynthesisResult ;
    skos:definition "Links a Synthesis Request to the Synthesis Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ---- what flows between stages ----

va:yieldsVariant a owl:ObjectProperty ;
    rdfs:label "yields variant"@en ;
    rdfs:domain va:ConversionResult ;
    rdfs:range va:Variant ;
    skos:definition "A Variant that a Conversion Result produced. The Conversion Result's own definition says it holds 'the Variant produced by one Conversion Request'; this is the link that says which ones."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:synthesizesVariant a owl:ObjectProperty ;
    rdfs:label "synthesizes variant"@en ;
    rdfs:domain va:SynthesisRequest ;
    rdfs:range va:Variant ;
    skos:definition "The Variant a Synthesis Request asks to be realised."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ---- verdicts at the first and last stage (the middle one existed) ----

va:hasDiscoveryVerdict a owl:ObjectProperty ;
    rdfs:label "has discovery verdict"@en ;
    rdfs:domain va:DiscoveryResult ;
    rdfs:range va:DiscoveryVerdict ;
    skos:definition "The verdict over a Discovery Result. Symmetric with the existing has conversion verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasSynthesisVerdict a owl:ObjectProperty ;
    rdfs:label "has synthesis verdict"@en ;
    rdfs:domain va:SynthesisResult ;
    rdfs:range va:SynthesisVerdict ;
    skos:definition "The verdict over a Synthesis Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.1.0 -- the steps, stated (ETVX: entry, task, verification, exit)
# This is the one definition of the Discovery-Synthesis Pipeline. The runner
# (06-runtime/src/variant_pipeline_workflow_v1_0_91.py) executes these steps in this
# order, and 02-shacl-safeguards/variant_algebra_pipeline_gates_v1_7_0.ttl enforces them.
# ============================================================

va:PipelineStep a owl:Class ;
    rdfs:label "Pipeline step"@en ;
    skos:definition "One step of the Discovery-Synthesis Pipeline, stated by its entry criterion, task, verification and exit criterion (the ETVX process-definition model), its position, and the shapes that enforce it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stepOrder a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain va:PipelineStep ; rdfs:range xsd:positiveInteger ; rdfs:label "step order"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:nextStep a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain va:PipelineStep ; rdfs:range va:PipelineStep ; rdfs:label "next step"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:PipelineStepResult a owl:Class ; rdfs:label "Pipeline step result"@en ;
    skos:definition "The record one step of the pipeline leaves in the run: the Agreement, Processing, Verification, Execution and Feedback results are each one, and so are the results of the steps defined beside them. What a step produces, as the class of every such record."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producedByStep a owl:ObjectProperty ; rdfs:label "produced by step"@en ; rdfs:domain va:PipelineStepResult ; rdfs:range va:PipelineStep ;
    skos:definition "The step that produced this result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:definesStep a owl:ObjectProperty ; rdfs:label "defines step"@en ; rdfs:domain va:PipelineDefinitionRecord ; rdfs:range va:PipelineStep ;
    skos:definition "A step of the pipeline that this definition record states."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:entryCriterion a owl:DatatypeProperty ; rdfs:domain va:PipelineStep ; rdfs:label "entry criterion"@en ;
    skos:definition "What must hold before the step may start."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stepTask a owl:DatatypeProperty ; rdfs:domain va:PipelineStep ; rdfs:label "task"@en ; skos:definition "What the step does."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stepVerification a owl:DatatypeProperty ; rdfs:domain va:PipelineStep ; rdfs:label "verification"@en ;
    skos:definition "How the step's result is judged: the criteria for its verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:exitCriterion a owl:DatatypeProperty ; rdfs:domain va:PipelineStep ; rdfs:label "exit criterion"@en ;
    skos:definition "What holds when the step is finished."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stepResultClass a owl:ObjectProperty ; rdfs:domain va:PipelineStep ; rdfs:label "result class"@en ;
    skos:definition "The class of the record the step produces."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:enforcedByShape a owl:ObjectProperty ; rdfs:domain va:PipelineStep ; rdfs:label "enforced by shape"@en ;
    skos:definition "A gate shape that refuses a run violating this step's entry or exit criterion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:DiscoverySynthesisPipeline skos:changeNote "2026-10-18 (workflow vocabulary 1.2.0, VAF-WI-241): the pipeline has four steps -- Discovery, Agreement, Conversion, Synthesis; Agreement is stated as va:Step_Agreement. 2026-10-18 (workflow vocabulary 1.3.0, VAF-WI-242): five steps, Processing between Agreement and Conversion. 2026-09-27 (workflow vocabulary 1.1.0): the pipeline has three steps -- Discovery, Conversion, Synthesis -- stated as va:Step_Discovery, va:Step_Conversion and va:Step_Synthesis. The class text's two named stages (discovery and synthesis, with assembly between them) is superseded by these three; the assembly it describes is the Conversion step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.1.0 -- the seven definitions of the pipeline found on 2026-09-27, and which one governs
# ============================================================

va:PipelineDefinitionRecord a owl:Class ;
    rdfs:label "Pipeline definition record"@en ;
    skos:definition "A place where the Discovery-Synthesis Pipeline was defined, recorded so that exactly one governs and the others visibly do not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:definitionStatus a owl:DatatypeProperty ; rdfs:domain va:PipelineDefinitionRecord ; rdfs:label "definition status"@en ;
    skos:definition "governing | superseded"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:definitionLocation a owl:DatatypeProperty ; rdfs:domain va:PipelineDefinitionRecord ; rdfs:label "location"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:supersededBecause a owl:DatatypeProperty ; rdfs:domain va:PipelineDefinitionRecord ; rdfs:label "superseded because"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.2.0 -- the Agreement step: documents against the program (VAF-WI-241)
# The states a finding can take are the discovery ontology's Ag* individuals; their polarity is the matching taxonomy's
# (01-ontologies/variant_algebra_matching_taxonomy_*.ttl). Nothing here defines a state.
# ============================================================

va:AgreementRequest a owl:Class ; rdfs:label "Agreement request"@en ;
    skos:definition "The request to compare, for one pipeline run, what the project's documents state with what the program does. It names the Discovery Result it follows, the contexts compared, and the sha-256 of the code the documents describe."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:AgreementResult a owl:Class ; rdfs:subClassOf va:PipelineStepResult ; rdfs:label "Agreement result"@en ;
    skos:definition "What the Agreement step found for one run: one verdict and one finding per question and context."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:AgreementFinding a owl:Class ; rdfs:label "Agreement finding"@en ;
    skos:definition "One question in one context, with the agreement state the rules gave it and the reason; when the state unmatches, also the nonconformity status, candidate causes and open question."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:AgreementVerdict a owl:Class ; rdfs:label "Agreement verdict"@en ;
    skos:definition "The outcome of the Agreement step, taken from the polarity of the states found: Matching, Unmatching, Undecided or Not compared."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasAgreementStage a owl:ObjectProperty ; rdfs:label "has agreement stage"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:AgreementResult ;
    skos:definition "Links a pipeline run to the Agreement Result of its second step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:agreesFrom a owl:ObjectProperty ; rdfs:label "agrees from"@en ; rdfs:domain va:AgreementRequest ; rdfs:range va:DiscoveryResult ;
    skos:definition "The Discovery Result an Agreement Request follows."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producesAgreement a owl:ObjectProperty ; rdfs:label "produces agreement"@en ; rdfs:domain va:AgreementRequest ; rdfs:range va:AgreementResult ;
    skos:definition "Links an Agreement Request to the Agreement Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasAgreementVerdict a owl:ObjectProperty ; rdfs:label "has agreement verdict"@en ; rdfs:domain va:AgreementResult ; rdfs:range va:AgreementVerdict ;
    skos:definition "The verdict over an Agreement Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:comparesContext a owl:ObjectProperty ; rdfs:label "compares context"@en ; rdfs:domain va:AgreementRequest ; rdfs:range va:Context ;
    skos:definition "A context the Agreement step compared."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:documentsCodeSha a owl:DatatypeProperty ; rdfs:label "documents' code sha-256"@en ; rdfs:domain va:AgreementRequest ;
    skos:definition "The sha-256 (as sha256:...) of a program file the documents' description was made from. The code discovered in the run must be among them."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingOf a owl:ObjectProperty ; rdfs:label "finding of"@en ; rdfs:domain va:AgreementFinding ; rdfs:range va:AgreementResult ;
    skos:definition "The Agreement Result a finding belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingContext a owl:ObjectProperty ; rdfs:label "finding context"@en ; rdfs:domain va:AgreementFinding ; rdfs:range va:Context ;
    skos:definition "The context the finding was made in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingQuestion a owl:DatatypeProperty ; rdfs:label "finding question"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "The question compared, in plain words (for example: order: approve , credit_check)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingState a owl:ObjectProperty ; rdfs:label "finding state"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "The agreement state the rules gave the question: one of the discovery ontology's Ag* individuals."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingReason a owl:DatatypeProperty ; rdfs:label "finding reason"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "The reason the rules gave for the state."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingNcStatus a owl:DatatypeProperty ; rdfs:label "finding nonconformity status"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "The status of the nonconformity record of the question (for example InvestigationOpen); present when the state unmatches."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingCandidateCause a owl:DatatypeProperty ; rdfs:label "finding candidate cause"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "A candidate cause the nonconformity rules named. The model never confirms a cause; only a person's record does."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:findingOpenQuestion a owl:DatatypeProperty ; rdfs:label "finding open question"@en ; rdfs:domain va:AgreementFinding ;
    skos:definition "The question that must be answered when no cause can be named."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.3.0 -- the Processing step: what the model is before it is listed (VAF-WI-242)
# ============================================================

va:ProcessingRequest a owl:Class ; rdfs:label "Processing request"@en ;
    skos:definition "The request to decompose, count and analyse the discovered model of one pipeline run before any variant is listed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:ProcessingResult a owl:Class ; rdfs:subClassOf va:PipelineStepResult ; rdfs:label "Processing result"@en ;
    skos:definition "What the Processing step found: one verdict, the exact variant count when the model could be counted, the number of independent groups, and findings."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:ProcessingFinding a owl:Class ; rdfs:label "Processing finding"@en ;
    skos:definition "One thing the Processing step found: an independent group with its number of variants, a dead feature, or a false-optional feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:ProcessingVerdict a owl:Class ; rdfs:label "Processing verdict"@en ;
    skos:definition "The outcome of the Processing step: Counted, Void, Not counted or Undecided."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasProcessingStage a owl:ObjectProperty ; rdfs:label "has processing stage"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:ProcessingResult ;
    skos:definition "Links a pipeline run to the Processing Result of its third step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:processesFrom a owl:ObjectProperty ; rdfs:label "processes from"@en ; rdfs:domain va:ProcessingRequest ; rdfs:range va:DiscoveryResult ;
    skos:definition "The Discovery Result whose model a Processing Request analyses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producesProcessing a owl:ObjectProperty ; rdfs:label "produces processing"@en ; rdfs:domain va:ProcessingRequest ; rdfs:range va:ProcessingResult ;
    skos:definition "Links a Processing Request to the Processing Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasProcessingVerdict a owl:ObjectProperty ; rdfs:label "has processing verdict"@en ; rdfs:domain va:ProcessingResult ; rdfs:range va:ProcessingVerdict ;
    skos:definition "The verdict over a Processing Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:exactVariantCount a owl:DatatypeProperty ; rdfs:label "exact variant count"@en ; rdfs:domain va:ProcessingResult ; rdfs:range xsd:integer ;
    skos:definition "The exact number of variants of the model, counted without listing them."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:groupCount a owl:DatatypeProperty ; rdfs:label "group count"@en ; rdfs:domain va:ProcessingResult ; rdfs:range xsd:integer ;
    skos:definition "The number of independent groups the model's statements fall into."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:combinatorialBound a owl:DatatypeProperty ; rdfs:label "combinatorial bound"@en ; rdfs:domain va:ProcessingResult ; rdfs:range xsd:integer ;
    skos:definition "The combinatorial upper bound of the model's variants (the product of the groups' bounds)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:notCountedBecause a owl:DatatypeProperty ; rdfs:label "not counted because"@en ; rdfs:domain va:ProcessingResult ;
    skos:definition "Why no count was given: the evaluator refused the model, or the time allowed ran out."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:processingFindingOf a owl:ObjectProperty ; rdfs:label "processing finding of"@en ; rdfs:domain va:ProcessingFinding ; rdfs:range va:ProcessingResult ;
    skos:definition "The Processing Result a finding belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:processingFindingKind a owl:DatatypeProperty ; rdfs:label "processing finding kind"@en ; rdfs:domain va:ProcessingFinding ;
    skos:definition "Group, DeadFeature or FalseOptionalFeature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:processingFindingFeature a owl:DatatypeProperty ; rdfs:label "processing finding feature"@en ; rdfs:domain va:ProcessingFinding ;
    skos:definition "A feature the finding is about: the members of a group, or the one dead or false-optional feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:processingFindingVariants a owl:DatatypeProperty ; rdfs:label "processing finding variants"@en ; rdfs:domain va:ProcessingFinding ; rdfs:range xsd:integer ;
    skos:definition "For a group: the number of variants of that group alone."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ---- capacity notices (VAF-WI-245): told before the step that would take the time starts
va:CapacityNotice a owl:Class ; rdfs:label "Capacity notice"@en ;
    skos:definition "What the person is told, before a step starts, when a measured size of the project is beyond what VAF has been measured to handle, or at a size where a measurement did not finish. Telling is not refusing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasCapacityNotice a owl:ObjectProperty ; rdfs:label "has capacity notice"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:CapacityNotice ;
    skos:definition "Links a pipeline run to a notice given before one of its steps."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeBeforeStep a owl:ObjectProperty ; rdfs:label "notice before step"@en ; rdfs:domain va:CapacityNotice ; rdfs:range va:PipelineStep ;
    skos:definition "The step the notice was given before: Discovery or Processing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeDimension a owl:DatatypeProperty ; rdfs:label "notice dimension"@en ; rdfs:domain va:CapacityNotice ;
    skos:definition "The measured dimension of the project the notice is about (a name in the capacity measurements)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeObserved a owl:DatatypeProperty ; rdfs:label "notice observed"@en ; rdfs:domain va:CapacityNotice ; rdfs:range xsd:decimal ;
    skos:definition "The project's value in that dimension."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeMeasuredUpTo a owl:DatatypeProperty ; rdfs:label "notice measured up to"@en ; rdfs:domain va:CapacityNotice ; rdfs:range xsd:decimal ;
    skos:definition "The largest value of that dimension at which VAF was measured to finish; absent when nothing was measured."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeKind a owl:DatatypeProperty ; rdfs:label "notice kind"@en ; rdfs:domain va:CapacityNotice ;
    skos:definition "BeyondMeasured (the value is above the largest measured) or UndecidedElsewhere (a measurement of that size did not finish within its budget)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:noticeText a owl:DatatypeProperty ; rdfs:label "notice text"@en ; rdfs:domain va:CapacityNotice ;
    skos:definition "The notice as the person reads it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.4.0 -- the Verification step: the produced variant is checked, not assumed (VAF-WI-247)
# ============================================================

va:VerificationRequest a owl:Class ; rdfs:label "Verification request"@en ;
    skos:definition "The request to check the variant and the artifact that the Synthesis step of one pipeline run produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:VerificationResult a owl:Class ; rdfs:subClassOf va:PipelineStepResult ; rdfs:label "Verification result"@en ;
    skos:definition "What the Verification step found: one verdict and the checks it ran, each passed or not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:VerificationCheck a owl:Class ; rdfs:label "Verification check"@en ;
    skos:definition "One check of the Verification step, with its name, its severity (Failure or Warning), whether it passed and the detail that decided it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:VerificationVerdict a owl:Class ; rdfs:label "Verification verdict"@en ;
    skos:definition "The outcome of the Verification step: Verified, Verified with warnings or Not verified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasVerificationStage a owl:ObjectProperty ; rdfs:label "has verification stage"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:VerificationResult ;
    skos:definition "Links a pipeline run to the Verification Result of its sixth step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:verifiesFrom a owl:ObjectProperty ; rdfs:label "verifies from"@en ; rdfs:domain va:VerificationRequest ; rdfs:range va:SynthesisResult ;
    skos:definition "The Synthesis Result whose variant and artifact a Verification Request checks."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producesVerification a owl:ObjectProperty ; rdfs:label "produces verification"@en ; rdfs:domain va:VerificationRequest ; rdfs:range va:VerificationResult ;
    skos:definition "Links a Verification Request to the Verification Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasVerificationVerdict a owl:ObjectProperty ; rdfs:label "has verification verdict"@en ; rdfs:domain va:VerificationResult ; rdfs:range va:VerificationVerdict ;
    skos:definition "The verdict over a Verification Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:verificationCheckOf a owl:ObjectProperty ; rdfs:label "verification check of"@en ; rdfs:domain va:VerificationCheck ; rdfs:range va:VerificationResult ;
    skos:definition "The Verification Result a check belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:checkName a owl:DatatypeProperty ; rdfs:label "check name"@en ; rdfs:domain va:VerificationCheck ;
    skos:definition "Which of the six checks this is: FitsModel, ArtifactUnchanged, SelectedFeaturesPresent, NoUnselectedFeatures, Usefulness or GatesConform."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:checkSeverity a owl:DatatypeProperty ; rdfs:label "check severity"@en ; rdfs:domain va:VerificationCheck ;
    skos:definition "Failure (a check that did not pass stops the run) or Warning (it is reported and the run goes on)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:checkPassed a owl:DatatypeProperty ; rdfs:label "check passed"@en ; rdfs:domain va:VerificationCheck ; rdfs:range xsd:boolean ;
    skos:definition "Whether the check passed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:checkDetail a owl:DatatypeProperty ; rdfs:label "check detail"@en ; rdfs:domain va:VerificationCheck ;
    skos:definition "What the check looked at and what it found, in words the person reads."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.5.0 -- the Execution step: the verified artifact is run, not assumed to run (VAF-WI-248)
# ============================================================

va:ExecutionRequest a owl:Class ; rdfs:label "Execution request"@en ;
    skos:definition "The request to run the artifact that the Verification step of one pipeline run verified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:ExecutionResult a owl:Class ; rdfs:subClassOf va:PipelineStepResult ; rdfs:label "Execution result"@en ;
    skos:definition "What the Execution step saw when it ran the artifact: one verdict, the engine that ran it, the time taken, a digest of what was seen and the errors."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:ExecutionVerdict a owl:Class ; rdfs:label "Execution verdict"@en ;
    skos:definition "The outcome of the Execution step: Ran, Failed or Not run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasExecutionStage a owl:ObjectProperty ; rdfs:label "has execution stage"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:ExecutionResult ;
    skos:definition "Links a pipeline run to the Execution Result of its seventh step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executesFrom a owl:ObjectProperty ; rdfs:label "executes from"@en ; rdfs:domain va:ExecutionRequest ; rdfs:range va:VerificationResult ;
    skos:definition "The Verification Result whose artifact an Execution Request runs."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producesExecution a owl:ObjectProperty ; rdfs:label "produces execution"@en ; rdfs:domain va:ExecutionRequest ; rdfs:range va:ExecutionResult ;
    skos:definition "Links an Execution Request to the Execution Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasExecutionVerdict a owl:ObjectProperty ; rdfs:label "has execution verdict"@en ; rdfs:domain va:ExecutionResult ; rdfs:range va:ExecutionVerdict ;
    skos:definition "The verdict over an Execution Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executionEngine a owl:DatatypeProperty ; rdfs:label "execution engine"@en ; rdfs:domain va:ExecutionResult ;
    skos:definition "What ran the artifact: python, chromium, or none when nothing did."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executionSeconds a owl:DatatypeProperty ; rdfs:label "execution seconds"@en ; rdfs:domain va:ExecutionResult ; rdfs:range xsd:decimal ;
    skos:definition "The seconds the run took, as measured."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executionExitCode a owl:DatatypeProperty ; rdfs:label "execution exit code"@en ; rdfs:domain va:ExecutionResult ; rdfs:range xsd:integer ;
    skos:definition "The exit code of the interpreter, when a program was run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executionOutputDigest a owl:DatatypeProperty ; rdfs:label "execution output digest"@en ; rdfs:domain va:ExecutionResult ;
    skos:definition "The sha-256 of what the run printed and the errors it raised, so that the same run can be compared."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:executionDetail a owl:DatatypeProperty ; rdfs:label "execution detail"@en ; rdfs:domain va:ExecutionResult ;
    skos:definition "What was seen, or why the artifact was not run, in words the person reads."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ============================================================
# 1.6.0 -- the Feedback step: what the run teaches is stated and addressed (VAF-WI-249)
# ============================================================

va:FeedbackRequest a owl:Class ; rdfs:label "Feedback request"@en ;
    skos:definition "The request to state what one pipeline run, finished or stopped, teaches."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:FeedbackResult a owl:Class ; rdfs:subClassOf va:PipelineStepResult ; rdfs:label "Feedback result"@en ;
    skos:definition "What the Feedback step stated about a run: one verdict and the findings, each addressed to the place that can act on it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:FeedbackFinding a owl:Class ; rdfs:label "Feedback finding"@en ;
    skos:definition "One thing a run teaches, with its kind, the place it is addressed to, the step it comes from and what it states. A statement for a reviewer; it is never applied by itself."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:FeedbackVerdict a owl:Class ; rdfs:label "Feedback verdict"@en ;
    skos:definition "The outcome of the Feedback step: Findings to act on, or Nothing to correct."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:hasFeedbackStage a owl:ObjectProperty ; rdfs:label "has feedback stage"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range va:FeedbackResult ;
    skos:definition "Links a pipeline run to the Feedback Result of its eighth step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackFrom a owl:ObjectProperty ; rdfs:label "feedback from"@en ; rdfs:domain va:FeedbackRequest ; rdfs:range va:DiscoverySynthesisPipeline ;
    skos:definition "The pipeline run a Feedback Request reads."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:producesFeedback a owl:ObjectProperty ; rdfs:label "produces feedback"@en ; rdfs:domain va:FeedbackRequest ; rdfs:range va:FeedbackResult ;
    skos:definition "Links a Feedback Request to the Feedback Result it produced."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasFeedbackVerdict a owl:ObjectProperty ; rdfs:label "has feedback verdict"@en ; rdfs:domain va:FeedbackResult ; rdfs:range va:FeedbackVerdict ;
    skos:definition "The verdict over a Feedback Result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackFindingOf a owl:ObjectProperty ; rdfs:label "feedback finding of"@en ; rdfs:domain va:FeedbackFinding ; rdfs:range va:FeedbackResult ;
    skos:definition "The Feedback Result a finding belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackKind a owl:DatatypeProperty ; rdfs:label "feedback kind"@en ; rdfs:domain va:FeedbackFinding ;
    skos:definition "What the finding is: DeadFeature, FalseOptionalFeature, NoVariant, Undecided, DocumentsDisagree, VerificationCheckFailed, ExecutionFailed, ExecutionSkipped, CapacityNotice, Measurement or StoppedRun."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackAddressee a owl:DatatypeProperty ; rdfs:label "feedback addressee"@en ; rdfs:domain va:FeedbackFinding ;
    skos:definition "The place that can act on the finding: Model owner, Document owner, Synthesis, Capacity measurement or The person."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackEvidenceStep a owl:DatatypeProperty ; rdfs:label "feedback evidence step"@en ; rdfs:domain va:FeedbackFinding ;
    skos:definition "The step of the run the finding comes from, or Run when it concerns the run as a whole."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackStatement a owl:DatatypeProperty ; rdfs:label "feedback statement"@en ; rdfs:domain va:FeedbackFinding ;
    skos:definition "What the finding states, in words the person reads."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:feedbackSeconds a owl:DatatypeProperty ; rdfs:label "feedback seconds"@en ; rdfs:domain va:FeedbackFinding ; rdfs:range xsd:decimal ;
    skos:definition "For a measurement, the seconds the step took."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:secondsTaken a owl:DatatypeProperty ; rdfs:label "seconds taken"@en ; rdfs:range xsd:decimal ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:DiscoveryResult va:AgreementResult va:ProcessingResult va:ConversionResult va:SynthesisResult va:VerificationResult va:ExecutionResult ) ] ;
    skos:definition "The seconds the step that produced this result took, as measured. The Feedback step states it as a measurement."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stoppedAt a owl:DatatypeProperty ; rdfs:label "stopped at"@en ; rdfs:domain va:DiscoverySynthesisPipeline ;
    skos:definition "The step that stopped the run, named as the step is (Discovery, Processing, ...), or Run when no step did (the check of the project's size before the first step)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stopReason a owl:DatatypeProperty ; rdfs:label "stop reason"@en ; rdfs:domain va:DiscoverySynthesisPipeline ;
    skos:definition "Why the run stopped, in words the person reads."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

va:runOutcome a owl:DatatypeProperty ; rdfs:label "run outcome"@en ; rdfs:domain va:DiscoverySynthesisPipeline ;
    skos:definition "Completed when the run went through every step of the pipeline, Stopped when a step stopped it. A run recorded as Completed that lacks the record of a step skipped that step, and the gates refuse it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ---- VAF-WI-256: the facts the pipeline run rules decide from (written 2026-10-21). The rules state each stage's verdict, whether the run goes on, where and why it stops and the variant realised.
va:ReasonPart a owl:Class ; rdfs:label "Reason part"@en ;
    skos:definition "One piece of the reason a stage gives, in the order the pieces are joined: a message of a failed gate, the failure a stage reports, or the detail of a stage that did not complete."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:hasReasonPart a owl:ObjectProperty ; rdfs:label "has reason part"@en ; rdfs:range va:ReasonPart ;
    skos:definition "Links a stage result to a piece of the reason the rules join into the stop reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:partKind a owl:DatatypeProperty ; rdfs:label "part kind"@en ; rdfs:domain va:ReasonPart ; rdfs:range xsd:string ;
    skos:definition "What the piece is: gate (a message of a failed gate) or detail (the failure or the reason a stage reports)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:partText a owl:DatatypeProperty ; rdfs:label "part text"@en ; rdfs:domain va:ReasonPart ; rdfs:range xsd:string ;
    skos:definition "The words of the piece."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:listPosition a owl:DatatypeProperty ; rdfs:label "position in the list"@en ; rdfs:range xsd:integer ;
    skos:definition "The place of a check, a notice or a reason part among those of its stage, counted from 0 in the order they were produced. The other position properties give the place in one kind of list (variantPosition: the variants listed)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:stageName a owl:DatatypeProperty ; rdfs:label "stage name"@en ; rdfs:range xsd:string ;
    skos:definition "The name of the stage that produced a stage result (discovery, agreement, processing, conversion, synthesis, verification, execution, feedback); the stage the rules name as where the run stopped."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:gatesPassed a owl:DatatypeProperty ; rdfs:label "gates passed"@en ; rdfs:range xsd:boolean ;
    skos:definition "Whether the run record held under the pipeline gates once this stage was recorded. A stage that failed them stops the run before its own verdict does."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:acceptedFeatureCount a owl:DatatypeProperty ; rdfs:label "accepted feature count"@en ; rdfs:domain va:DiscoveryResult ; rdfs:range xsd:integer ;
    skos:definition "The number of detected facts that review accepted as features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:countUndecided a owl:DatatypeProperty ; rdfs:label "count undecided"@en ; rdfs:domain va:ProcessingResult ; rdfs:range xsd:boolean ;
    skos:definition "Whether counting the model's variants ended undecided (the budget ran out) and not for a reason of its own; only a model with no exact count has it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:enumeratedVariantCount a owl:DatatypeProperty ; rdfs:label "enumerated variant count"@en ; rdfs:domain va:ConversionResult ; rdfs:range xsd:integer ;
    skos:definition "The number of variants the enumeration listed. The exact count of the model is va:exactVariantCount, which processing states before any variant is listed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:requestedVariantPosition a owl:DatatypeProperty ; rdfs:label "requested variant position"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range xsd:integer ;
    skos:definition "The place, among the variants listed, of the variant the run was asked to realise. A run with none realises the first variant that selects a feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:chosenVariantPosition a owl:DatatypeProperty ; rdfs:label "chosen variant position"@en ; rdfs:domain va:ConversionResult ; rdfs:range xsd:integer ;
    skos:definition "The place, among the variants listed, of the variant the synthesis step realises: the one asked for, held to the last, or the first that selects a feature, or the first."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:synthesisBackend a owl:DatatypeProperty ; rdfs:label "synthesis backend"@en ; rdfs:domain va:SynthesisResult ; rdfs:range xsd:string ;
    skos:definition "Which backend realised the variant: html (the artifact page) or realise (the original program restricted to the variant)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:artifactProduced a owl:DatatypeProperty ; rdfs:label "artifact produced"@en ; rdfs:domain va:SynthesisResult ; rdfs:range xsd:boolean ;
    skos:definition "Whether the backend gave an artifact that is not empty."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:omittedFeatureCount a owl:DatatypeProperty ; rdfs:label "omitted feature count"@en ; rdfs:domain va:SynthesisResult ; rdfs:range xsd:integer ;
    skos:definition "The number of the variant's selected features that the artifact does not name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:realisationVerified a owl:DatatypeProperty ; rdfs:label "realisation verified"@en ; rdfs:domain va:SynthesisResult ; rdfs:range xsd:boolean ;
    skos:definition "Whether the check of a realised program against the original passed; false when the artifact was not realised from a program."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:behaviourRemoved a owl:DatatypeProperty ; rdfs:label "behaviour removed"@en ; rdfs:domain va:SynthesisResult ; rdfs:range xsd:boolean ;
    skos:definition "Whether a selected method does nothing in the realised program, so that the artifact demonstrates less than the variant selects."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .
va:capacityMode a owl:DatatypeProperty ; rdfs:label "capacity mode"@en ; rdfs:domain va:DiscoverySynthesisPipeline ; rdfs:range xsd:string ;
    skos:definition "What the run was asked to do when the project is beyond what VAF was measured to handle: tell (give the notice and go on), stop (give the notice and stop) or off (measure nothing)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#ReasonPart> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/pipeline-workflow> .

# ==== file variant_algebra_profile_family_v1_0_42.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/vaf-domain/module/variant_algebra_profile_family> <http://purl.org/dc/terms/identifier> "variant_algebra_profile_family_v1_0_42"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "variant_algebra_profile_family"@en ;
    <http://www.w3.org/2002/07/owl#versionInfo> "1.0.42" .

#################################################################
# variant_algebra_profile_family_v1_0_42.ttl — WI_ProfileBaseClass,
# WI_ProfileFamilyRecursiveStructure. Real content, mission
# Mission_ProfileFamilyConfiguration (08-lineage/lineage_vaf_v*.ttl (the highest version)).
#
# Formalizes va:Profile as a real <Element, Constraint, Attribute> class
# -- checked directly against the full corpus before this file was
# written: no such class existed despite a prior cross-session proposal
# describing one as "the existing definition, unchanged" (real finding,
# disclosed in the impact analysis grounding this mission).
#
# Distinct from va:VAFDomainProfile (variant_algebra_profile_mechanism_v1_0_0.ttl):
# that class selects a coarse domain facet (Software vs KnowledgeBase);
# va:Profile below is a fine-grained configuration binding WITHIN a
# facet (e.g. a project-type category), the concept the proposal's own
# motivating case (a project-proposal template) actually needed.
# Deliberately NOT unified with VAFDomainProfile in this mission --
# unifying two real, differently-shaped mechanisms without evidence
# either should collapse into the other would be exactly the kind of
# forced fit this lineage's own discipline exists to prevent.
#################################################################

va:Profile a owl:Class ;
    rdfs:label "Profile"@en ;
    skos:definition "A configuration binding: a closed set of Elements a concrete case carries, a closed set of Constraints those elements must jointly satisfy, and a set of Attributes describing the binding itself (name, provenance, etc.) -- the base case va:ProfileFamily's recursive structure builds on." ;
    dcterms:source "REGISTRANT-STATED, Y. Altunel via cross-session proposal 07-handover-inbox/deferred/PROPOSAL_pib-vaf-paper_to_VAF_taxonomy-based-configuration.md, 2026-09-14, formalizing what that proposal called '<E_P, C_P, A_P>, the existing definition, unchanged' -- found, on direct corpus check, not to exist prior to this file; formalized here for the first time, not merely restated." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasProfileElement a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:Feature ;
    rdfs:label "has profile element"@en ;
    rdfs:comment "A Feature this profile's concrete cases carry. Range is va:Feature (not a new Element class) -- VAF already has a real, tested Feature concept; this mission does not duplicate it." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasProfileConstraint a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:VariabilityOperator ;
    rdfs:label "has profile constraint"@en ;
    rdfs:comment "A constraint over this profile's elements, expressed using VAF's existing variability operators (Mandatory/Optional/Exclusive/Or/Dependency/Repetition) -- not a new constraint language. Range is va:VariabilityOperator, matching Ex_NoNewOperator's own real exclusion." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasProfileAttribute a owl:DatatypeProperty ;
    rdfs:domain va:Profile ; rdfs:range xsd:string ;
    rdfs:label "has profile attribute"@en ;
    rdfs:comment "A free-text attribute describing the profile binding itself (its name, its origin) -- deliberately a plain datatype property, not a class, since the proposal's own formal sketch treats A_P as descriptive metadata, not a structure requiring further recursion." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

#################################################################
# Generation-ready properties, added for Mission_ProfileFamilyVariantGeneration.
# Direct analogs of the DSL's own real MandatoryStmt/OptionalStmt (variant_dsl_parser_v1_0_35.py)
# -- concrete element-to-operator pairing, unlike the abstract hasProfileConstraint
# above (never populated anywhere in this corpus -- checked directly before adding
# these, not assumed necessary). This is the real bridge point to variant generation.
#################################################################

va:hasMandatoryElement a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:Feature ;
    rdfs:label "has mandatory element"@en ;
    skos:definition "A Feature this profile requires -- direct analog of the DSL's own MandatoryStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasOptionalElement a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:Feature ;
    rdfs:label "has optional element"@en ;
    skos:definition "A Feature this profile permits but does not require -- direct analog of the DSL's own OptionalStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasEffectiveMandatoryElement a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has effective mandatory element"@en ;
    skos:definition "MATERIALIZED, not asserted -- the accumulated union of this node's own hasMandatoryElement plus every real ancestor's, computed by variant_algebra_profile_family_generation_rules_v1_0_0.ttl's SHACL-AF rule. Never write this directly." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasEffectiveOptionalElement a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has effective optional element"@en ;
    skos:definition "MATERIALIZED, not asserted -- the accumulated union of this node's own hasOptionalElement plus every real ancestor's. Never write this directly." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

#################################################################
# Operator coverage extension, Mission_ProfileFamilyOperatorCoverage.
# Direct analogs of the DSL's own remaining Statement types
# (ExclusiveStmt/OrStmt/DependencyStmt/RepetitionStmt), plus the two
# AlgebraicOperators (Addition, Inverse) with a real, defensible
# per-profile meaning -- checked against their real thesis definitions
# before modeling, not guessed.
#################################################################

va:ElementGroup a owl:Class ;
    rdfs:label "Element Group"@en ;
    skos:definition "An ordered set of Features, used as the member list of an Exclusive or Or group -- direct analog of the DSL's own ExclusiveStmt.members/OrStmt.members." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:groupMember a owl:ObjectProperty ;
    rdfs:domain va:ElementGroup ; rdfs:range va:Feature ;
    rdfs:label "group member"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasExclusiveGroup a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:ElementGroup ;
    rdfs:label "has exclusive group"@en ;
    skos:definition "A group of Features of which exactly one appears in a variant (va:ExclusiveOperator, thesis eq. 2.35, precedence 1) -- direct analog of the DSL's own ExclusiveStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasOrGroup a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:ElementGroup ;
    rdfs:label "has or group"@en ;
    skos:definition "A group of Features of which one, the other, or both appear (va:OrOperator, thesis eq. 2.34, precedence 1) -- direct analog of the DSL's own OrStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:DependencyConstraint a owl:Class ;
    rdfs:label "Dependency Constraint"@en ;
    skos:definition "A directional pair: if the antecedent Feature appears, the consequent Feature must also appear (va:DependencyOperator, thesis eq. 2.37, precedence 4) -- direct analog of the DSL's own DependencyStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:dependencyAntecedent a owl:ObjectProperty ;
    rdfs:domain va:DependencyConstraint ; rdfs:range va:Feature ; rdfs:label "dependency antecedent"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:dependencyConsequent a owl:ObjectProperty ;
    rdfs:domain va:DependencyConstraint ; rdfs:range va:Feature ; rdfs:label "dependency consequent"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasDependency a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:DependencyConstraint ; rdfs:label "has dependency"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:RepetitionConstraint a owl:Class ;
    rdfs:label "Repetition Constraint"@en ;
    skos:definition "A Feature with a cardinality bound: zero or more repetitions, min/max (va:RepetitionOperator, thesis eq. 2.39, precedence 1) -- direct analog of the DSL's own RepetitionStmt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:repetitionElement a owl:ObjectProperty ;
    rdfs:domain va:RepetitionConstraint ; rdfs:range va:Feature ; rdfs:label "repetition element"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:repetitionCardMin a owl:DatatypeProperty ;
    rdfs:domain va:RepetitionConstraint ; rdfs:range xsd:integer ; rdfs:label "repetition cardinality minimum"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:repetitionCardMax a owl:DatatypeProperty ;
    rdfs:domain va:RepetitionConstraint ; rdfs:range xsd:string ; rdfs:label "repetition cardinality maximum"@en ;
    rdfs:comment "String, not integer, because the DSL's own card_max accepts '*' (unbounded) as a real value -- matching RepetitionStmt.card_max: Union[int, str] exactly." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasRepetitionElement a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:RepetitionConstraint ; rdfs:label "has repetition element"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:CoInclusionPair a owl:Class ;
    rdfs:label "Co-Inclusion Pair"@en ;
    skos:definition "Two Features that always appear together (va:AdditionOperator, thesis eq. 2.28: (a+b) = co-inclusion of two elements in the feature space, precedence 2) -- weaker than both being independently Mandatory: neither is required unless the OTHER is chosen, but once one is chosen, both must be." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:coIncludedFeatureA a owl:ObjectProperty ;
    rdfs:domain va:CoInclusionPair ; rdfs:range va:Feature ; rdfs:label "co-included feature A"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:coIncludedFeatureB a owl:ObjectProperty ;
    rdfs:domain va:CoInclusionPair ; rdfs:range va:Feature ; rdfs:label "co-included feature B"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasCoIncludedPair a owl:ObjectProperty ;
    rdfs:domain va:Profile ; rdfs:range va:CoInclusionPair ; rdfs:label "has co-included pair"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasExcludedElement a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has excluded element"@en ;
    skos:definition "A Feature this ProfileFamily node explicitly removes from what it would otherwise inherit (va:InverseOperator, thesis section 2.2.3: (!a), unary inverse producing an element removed from the variant's feature space, precedence 5) -- the one real way a descendant can override, not just add to, an ancestor's closed core. Applied at THIS node and propagates to all descendants on this path, per the SHACL-AF rule below." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasEffectiveExcludedElement a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has effective excluded element"@en ;
    skos:definition "MATERIALIZED -- the accumulated union of this node's own hasExcludedElement plus every real ancestor's, same accumulation pattern as hasEffectiveMandatoryElement. Never write this directly." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasEffectiveMandatoryElementNet a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has effective mandatory element (net of exclusions)"@en ;
    skos:definition "MATERIALIZED, second-stage rule -- hasEffectiveMandatoryElement minus anything in hasEffectiveExcludedElement. THIS is the real, exclusion-aware set the generation bridge should read when Inverse exclusions are in play; hasEffectiveMandatoryElement alone ignores them." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasEffectiveOptionalElementNet a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has effective optional element (net of exclusions)"@en ;
    skos:definition "MATERIALIZED, second-stage rule -- hasEffectiveOptionalElement minus anything in hasEffectiveExcludedElement." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

#################################################################
# va:ProfileFamily -- the recursive structure. Per the proposal's own
# formal sketch: "F is either a base profile P, or a tuple
# <E_F, C_F, {F_1,...,F_n}>, where E_F/C_F are the family's own closed
# (inherited-by-all) sets, and each F_i is itself a profile family,
# subject to E_F subseteq E_Fi and C_F subseteq C_Fi for every i".
#################################################################

va:ProfileFamily a owl:Class ;
    rdfs:subClassOf va:Profile ;
    rdfs:label "Profile Family"@en ;
    skos:definition "A profile that is either a base case (a plain va:Profile, no children) or a real internal node: a closed element/constraint core (inherited by every descendant, never dropped or overridden) plus one or more child ProfileFamily members. Subclass of va:Profile, not a sibling -- a family's own closed core IS a profile in exactly va:Profile's sense; the recursion is in what it may additionally carry (children), not a different kind of thing at the root." ;
    dcterms:source "Formalizes the proposal's own formal sketch verbatim (07-handover-inbox/deferred/PROPOSAL_pib-vaf-paper_to_VAF_taxonomy-based-configuration.md): 'F = <E_F, C_F, {F_1,...,F_n}>'." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasChildFamily a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:ProfileFamily ;
    rdfs:label "has child family"@en ;
    skos:definition "Relates a ProfileFamily to one of its children. A family with zero hasChildFamily assertions is a leaf -- a base case in the proposal's own sense, even though it is typed va:ProfileFamily rather than plain va:Profile, since real families are built incrementally and a leaf today may gain children later without a type change." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:discriminatedBy a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:VariabilityOperator ;
    rdfs:label "discriminated by"@en ;
    skos:definition "The va:ExclusiveOperator or va:OrOperator individual used to discriminate among this family's own hasChildFamily children over a designated type element -- per the proposal's own proposed mechanism and Ex_NoNewOperator's exclusion, always an operator VAF already has, never a new one." ;
    dcterms:source "va:ExclusiveOperator/va:OrOperator confirmed real, tested (variant_algebra_operator_rules_v1_0_0.ttl, variant_dsl_parser_v1_0_35.py) before this property was declared." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

va:hasFamilyDiscriminantElement a owl:ObjectProperty ;
    rdfs:domain va:ProfileFamily ; rdfs:range va:Feature ;
    rdfs:label "has family discriminant element"@en ;
    rdfs:comment "The designated type element discriminatedBy's operator discriminates over -- e.g. a 'ProjectType' feature whose value distinguishes one child family from another." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain/module/variant_algebra_profile_family> .

# ==== file variant_algebra_runtime_vocabulary_v1_0_3.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://example.org/variant-algebra/runtime-vocabulary> dcterms:description "The terms the runtime writes into its TTL output (enumerator, parser, synthesis, verdict and feedback emitters, ontology bridge), declared once in the current ontology (VAF-WI-110, Lineage 5). 67 were declared only in the older runtime generation 06-runtime/ontology/variant_algebra_v2_10_0.ttl and are carried over with their declarations; 4 were written but declared nowhere and are defined here from their use."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    dcterms:title "Variant Algebra -- runtime vocabulary"@en ;
    owl:versionIRI <http://example.org/variant-algebra/runtime-vocabulary/1.0.3> ;
    owl:priorVersion <http://example.org/variant-algebra/runtime-vocabulary/1.0.2> ;
    owl:versionInfo "1.0.3" ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_runtime_vocabulary_v1_0_3"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:admissibleVariantCount a owl:DatatypeProperty ;
    rdfs:label "admissible variant count"@en ;
    dcterms:source "Altunel (2013) §2.1.4. v2.2.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Admissible count under declared constraints."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:antecedent a owl:ObjectProperty ;
    rdfs:label "antecedent"@en ;
    dcterms:source "Altunel (2013) §2.2.6. v2.1.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range va:Feature ;
    skos:definition "Feature whose presence triggers the Dependency."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:attemptNumber a owl:DatatypeProperty ;
    rdfs:label "attempt number"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.9.0."@en ;
    rdfs:domain va:FeedbackAttempt ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "1-indexed position of this attempt within its FeedbackSession."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:cardinalityMax a owl:DatatypeProperty ;
    rdfs:label "cardinality max"@en ;
    dcterms:source "Altunel (2013) §2.2.6. v2.1.0, semantics tightened in v2.3.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:RepetitionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Maximum instance count as xsd:string. Either a non-negative decimal integer or the single token asterisk. The asterisk denotes omega; materialisation requires an explicit enumerationBound."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:cardinalityMin a owl:DatatypeProperty ;
    rdfs:label "cardinality min"@en ;
    dcterms:source "Altunel (2013) §2.2.6. v2.1.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:RepetitionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Minimum instance count."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkDetail a owl:DatatypeProperty ;
    rdfs:label "check detail"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:CheckOutcome ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable detail string from the sandbox driver. For passed checks typically the observed type name; for failed checks the exception class and message."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkKind a owl:DatatypeProperty ;
    rdfs:label "check kind"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0 Sprint 7."@en ;
    rdfs:domain va:CheckOutcome ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Kind of this contract check: instantiate, attribute, or repetition. Enables SPARQL filtering by check category."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkPassed a owl:DatatypeProperty ;
    rdfs:label "check passed"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:CheckOutcome ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean outcome of this specific check. True iff the assertion held at runtime."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkTarget a owl:DatatypeProperty ;
    rdfs:label "check target"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:CheckOutcome ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Name of the target entity the check evaluated: component class name for instantiate, feature name for attribute, suffixed feature name (Feature_N) for repetition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:combinatorialUpperBound a owl:DatatypeProperty ;
    rdfs:label "combinatorial upper bound"@en ;
    dcterms:source "Altunel (2013) §2.1.4. v2.2.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Upper bound without constraints."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:consequent a owl:ObjectProperty ;
    rdfs:label "consequent"@en ;
    dcterms:source "Altunel (2013) §2.2.6. v2.1.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range va:Feature ;
    skos:definition "Feature that must be present if antecedent is present."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:count a owl:DatatypeProperty ;
    rdfs:label "count"@en ;
    dcterms:source "Altunel (2013) §2.2.6. v2.2.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:FeatureCount ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Non-negative integer multiplicity."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:diagnosticClass a owl:DatatypeProperty ;
    rdfs:label "diagnostic class"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.9.0."@en ;
    rdfs:domain va:FailureDiagnostic ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "The FailureClass value for this diagnostic. One of SYNTACTIC STRUCTURAL CONTRACT FABRICATION QUALITY EXECUTION RESOURCE UNKNOWN."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:diagnosticFailedCheckTarget a owl:DatatypeProperty ;
    rdfs:label "diagnostic failed check target"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:FailureDiagnostic ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Target name of a failed contract check, extracted from EXECUTION diagnostics. Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:diagnosticLeakedFeatures a owl:DatatypeProperty ;
    rdfs:label "diagnostic leaked features"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:FailureDiagnostic ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Feature name that was NOT selected by the variant but appeared in the generated code. Multi-valued for STRUCTURAL diagnostics."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:diagnosticMissingFeatures a owl:DatatypeProperty ;
    rdfs:label "diagnostic missing features"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:FailureDiagnostic ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Feature name that was selected by the variant but did not appear in the generated code. Multi-valued for STRUCTURAL diagnostics."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:diagnosticViolatedDimension a owl:DatatypeProperty ;
    rdfs:label "diagnostic violated dimension"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:FailureDiagnostic ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Quality dimension name (cyclomatic, sloc, coupling, etc) that violated its threshold in a QUALITY diagnostic. Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:enumerationBound a owl:DatatypeProperty ;
    rdfs:label "enumeration bound"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "v2.3.0."@en ;
    rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Finite cap applied to unbounded dimensions during BoundedEnumeration."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionCheckCount a owl:DatatypeProperty ;
    rdfs:label "execution check count"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Total number of ContractChecks evaluated. Equals one plus the count of selected singleton features plus sum of Repetition feature counts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionElapsedMs a owl:DatatypeProperty ;
    rdfs:label "execution elapsed ms"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:decimal ;
    skos:definition "Wall-clock elapsed time from subprocess launch to completion in milliseconds. Includes Python interpreter startup. A clean Car variant typically reports under 150 ms."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionExitCode a owl:DatatypeProperty ;
    rdfs:label "execution exit code"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:integer ;
    skos:definition "Process exit code from the sandbox subprocess. Negative values indicate signal termination (e.g. -9 for SIGKILL from rlimit enforcement). Replaces the composite skos:definition encoding in Sprint 5.1."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionOutcome a owl:DatatypeProperty ;
    rdfs:label "execution outcome"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Top-level outcome of the sandbox run. One of PASS FAIL EXCEPTION TIMEOUT OOM CPU INTERNAL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionPassedCount a owl:DatatypeProperty ;
    rdfs:label "execution passed count"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Number of ContractChecks whose passed flag is true. When this equals executionCheckCount and no resource ceiling fired the outcome is PASS."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionStderr a owl:DatatypeProperty ;
    rdfs:label "execution stderr"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:ExecutionReport ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Captured stderr from the sandbox subprocess, truncated. Emitted only when non-empty."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:executionStdout a owl:DatatypeProperty ;
    rdfs:label "execution stdout"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.10.0."@en ;
    rdfs:domain va:ExecutionReport ;
