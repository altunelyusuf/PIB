va:APISpecificationArtifact a owl:Class ;
    rdfs:label "API Specification Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "API Belirtim Yapıtı"@tr ;
    skos:definition "A formal, machine-readable API specification. Includes OpenAPI (Swagger) documents, GraphQL schemas, AsyncAPI specifications, gRPC .proto files, WSDL documents. Fully structured; Tier-1 calculi parse directly without probabilistic processing."@en ;
    skos:example "An openapi.yaml file defining REST endpoints with parameters and response schemas. A schema.graphql file defining GraphQL types and queries. A protobuf file defining service RPC methods."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Body a owl:Class ;
    rdfs:label "Body"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.13"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Gövde"@tr ;
    skos:definition "A method body, defined as a set of Aspects (thesis eq. 2.13). Member-of-Method."@en ;
    skos:example "The method Body `{self.balance -= amount; return True}` consists of one or more Aspects per thesis eq. 2.13."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Class a owl:Class ;
    rdfs:label "Class"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:altLabel "Sınıf"@tr ;
    skos:definition "An object-oriented class definition. Carries Attributes and Methods. Ψ-element."@en ;
    skos:example "`class PaymentProcessor:` with methods `charge`, `refund`, `get_history` is a Class Ψ element in Python."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Comment a owl:Class ;
    rdfs:label "Comment"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8; Terms List"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:altLabel "Yorum"@tr ;
    skos:definition "A developer-authored comment Ψ element. Distinct from va:Annotation (Bilgi Notu) which is formal metadata. Thesis §2.2.2 eq. 2.8 lists both Yorum (Comment) and Bilgi Notu (Annotation) as separate Ψ elements."@en ;
    skos:example "A Python `# TODO: refactor this` docstring is a Comment Ψ element. By contrast, `@deprecated` would be an Annotation (Bilgi Notu)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ComponentTemplate a owl:Class ;
    rdfs:label "Component Template"@en ;
    dcterms:source "Specification v1.1 §2.3 Definition 2.7; refined in v2.0 §2.3 for recursive view."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:altLabel "Bileşen Şablonu"@tr ;
    skos:definition "A SoftwareUnit whose feature set contains at least one abstract feature. Non-instantiable by construction: every variant containing any abstract feature has unfulfilled slots. The variant set V(T) enumerates permissible contract-shapes that concrete realizers must fulfill. Abstract features may themselves be SoftwareUnits (abstract methods are declared units with signatures); this does not change the Template's status — it concerns each feature's unfulfilled-at-container relationship."@en ;
    skos:example "AuthBase in the Python requests library is a Component Template: its __call__ method-feature is abstract (body is 'raise NotImplementedError'). AuthBase.__call__ is a Feature of AuthBase AND a SoftwareUnit declaring the expected signature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ConfigurationArtifact a owl:Class ;
    rdfs:label "Configuration Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Yapılandırma Yapıtı"@tr ;
    skos:definition "A file declaring configuration values or deployment parameters. Includes application config files (YAML, TOML, .env), framework-specific configs (settings.py, application.properties), feature flag files, environment-specific overrides. Usually key-value or nested structure; Tier-1 parseable."@en ;
    skos:example "config/production.yaml with database connection settings. .env file with API_KEY and DATABASE_URL. Rails config/application.rb. pyproject.toml."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CrossLevelCalculus a owl:Class ;
    rdfs:label "Cross-Level Calculus (Tier 4)"@en ;
    dcterms:source "v4.0.0 introduction; requires the recursive view of spec v2.0."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Calculus ;
    skos:definition "Tier 4 Calculus: operates across the recursive SoftwareUnit hierarchy enabled by spec v2.0. Input: multiple SoftwareUnits at potentially different levels of recursion (methods, classes, modules). Output: relations and aggregate structures (Realization edges, PolymorphismGroups, locality-principle enforcement)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DatabaseSchemaArtifact a owl:Class ;
    rdfs:label "Database Schema Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Veritabanı Şema Yapıtı"@tr ;
    skos:definition "A formal definition of database structure. Includes SQL DDL files (CREATE TABLE, CREATE INDEX), ORM model definitions (SQLAlchemy, Django, Rails models), migration files, ERDs in structured formats. Strongly structured; Tier-1 parseable. Captures entity-attribute-relationship information directly mappable to va:Component, va:Attribute, and va:DependencyOperator."@en ;
    skos:example "schema.sql with CREATE TABLE statements. Django models.py with class User(models.Model). Alembic migration scripts. A dbml file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DeploymentArtifact a owl:Class ;
    rdfs:label "Deployment Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Dağıtım Yapıtı"@tr ;
    skos:definition "A file describing how software is deployed or operated. Includes Dockerfiles, docker-compose.yml, Kubernetes manifests (Deployment, Service, ConfigMap), Terraform files, Ansible playbooks, systemd unit files. Structured; Tier-1 parseable. Reveals runtime-environment dependencies and configuration."@en ;
    skos:example "Dockerfile specifying base image and run command. k8s deployment.yaml with replica count and resource limits. terraform main.tf with provisioned infrastructure."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DesignArtifact a owl:Class ;
    rdfs:label "Design Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Tasarım Yapıtı"@tr ;
    skos:definition "A document or file authored during design. Includes architecture documents, Architecture Decision Records (ADRs), design patterns documentation, component diagrams, sequence diagrams, state charts. Mix of prose and semi-formal notation. ADRs in particular often follow structured templates (context / decision / consequences) amenable to Tier-1 extraction; free-prose architecture documents need Tier-5."@en ;
    skos:example "An ADR file 'adr/0001-use-oauth2-for-authentication.md'. A PlantUML sequence diagram. A component-diagram image with accompanying description. An architecture.md root document."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DivisionOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Division Operator"@en,
        "Division operator (/)"@en ;
    va:hasAlgebraicProperty "Inverse" ;
    va:hasIdentityElement "∅" ;
    va:isAssociative false ;
    va:isCommutative false ;
    va:operatorPrecedence "3"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "/" ;
    va:thesisSection "§2.2.6.4 eq. 2.32-2.33; Table 2.5 level 3; Table 2.6 row '/'" ;
    va:variantSemantics "projection" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.32–2.33; Tablo 2.5 precedence 3; Tablo 2.6"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Bölme"@tr ;
    skos:changeNote "Owner, 2026-10-14 11:59 (UTC+3), VAF-WI-228: division between expressions is built in the operator rules 8.0.0 (02-shacl-safeguards/variant_algebra_shapes_v1_3_3.ttl, file-module variant_algebra_operator_rules_v8_0_0.ttl). A / B is each set of A with every feature B names removed, so a / a is the empty variant (Figure 3.7: ((a+c) $ (a+d) $ (b+c) $ (b+d)) / (c $ d) gives a and b); B asserts nothing of its own. Until then a statement over it was reported as not evaluable."@en ;
    skos:definition "Thesis eq. 2.32–2.33: (a / b) — set division; removes common elements. Non-commutative; not associative."@en ;
    skos:example "`(A / B)`: thesis eq. 2.32–2.33 factors common elements out of a set algebraically."@en ;
    skos:changeNote "3.2.7: citation corrected. Thesis eq. 2.32 is element level ((a / b) gives V(a): b is taken out); eq. 2.33 is set level (the common elements of A's entity sets are factored by B). 'projection' names neither exactly; which level '/' acts at waits on the owner (va:Decision_OperatorLevels_2026_09_27). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C13 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    skos:changeNote "Owner, 2026-09-27 and 2026-09-28 (va:Decision_OwnerAnswers_2026_09_27, va:Decision_OwnerClarification_2026_09_28): operators are generic -- each has one meaning, the one its ontology rule states (02-shacl-safeguards/variant_algebra_operator_rules_v1_0_0.ttl), whatever its operands stand for; a named element is the one-element case. (3.2.8; corrected in 3.2.9, which had named the Python definitions evaluator as the semantics.) Division is therefore one operation: eq. 2.33 over operation sets factors the common elements of A's entity sets by B, and eq. 2.32 is its one-element case, (a / b) giving V(a). 'projection' is kept as the tag name for that factoring. This replaces the 3.2.7 note that left the level to the owner."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:EntailmentCalculus a owl:Class ;
    rdfs:label "Entailment Calculus (Tier 3)"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Calculus ;
    skos:definition "Tier 3 Calculus: derives algebraic consequences from accepted algebraic facts. Input: a set of operator instances. Output: new operator instances implied by the input under algebra axioms. Transitive-Closure (H7) is a Tier-3 calculus preserved in its v3.0.7 form. Tier 3 is the least source-code-dependent: all inputs are already accepted algebraic facts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8, preceding commentary"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    owl:equivalentClass va:SoftwareUnit ;
    skos:altLabel "Varlık"@tr ;
    skos:definition "The genus Ψ element — all other Ψ elements are specific kinds of Entity. Thesis §2.2.1 preceding eq. 2.8: 'Varlık (Entity): Cebri oluşturan ana unsur varlıktır' (Entity is the main element constituting the algebra). In v3.0.2 va:Entity is introduced as an alias for va:SoftwareUnit — the two share identical extension."@en ;
    skos:example "Every va:Component, va:Class, va:Method, va:Feature etc. is a va:Entity. Thesis treats Varlık as the inclusive category name for all Ψ members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:EntityPair a owl:Class ;
    rdfs:label "Entity Pair"@en ;
    dcterms:source "Altunel 2013 §2.2.5.1 eq. 2.26–2.27"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:EntitySet ;
    skos:altLabel "Varlık Çifti"@tr ;
    skos:definition "Thesis eq. 2.26: a two-element EntitySet. (a, b) = {a, b} where a ≠ b. Thesis §2.2.4 explicitly extends to triples and higher but pairs are the primary use."@en ;
    skos:example "Thesis eq. 2.26: (a, b) = {a, b} — the two-element EntitySet case. Most common auxiliary structure for binary operators."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ExclusiveOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Exclusion operator ($)"@en,
        "Exclusive Operator"@en ;
    va:hasAlgebraicProperty "Associative",
        "Commutative",
        "Idempotent" ;
    va:isAssociative true ;
    va:isCommutative true ;
    va:operatorPrecedence "1"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "$" ;
    va:thesisSection "§2.2.6.6 eq. 2.35; Table 2.5 level 1; Table 2.6 row '$'" ;
    va:variantSemantics "restriction" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.35; Tablo 2.5 precedence 1"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Dışlamalı"@tr ;
    skos:definition "Thesis eq. 2.35: (a $ b) — exactly one of the operands appears in a variant."@en ;
    skos:example "`AuditLogger { WriteLocal $ WriteCloud }`: exactly one of WriteLocal or WriteCloud per variant. Thesis eq. 2.35."@en ;
    skos:changeNote "3.2.7: Associative and Idempotent added -- thesis Table 2.6 gives both and they hold under the ontology's reading (measured, 12-experiments/thesis_laws_check_v1_0_37.py). The identity element is not asserted: the language cannot write the empty element, so the law is recorded as not evaluable. Citation corrected from Table 2.7 (distributivity) to Table 2.6 (properties). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C2 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:IntersectionOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Intersection Operator"@en,
        "Intersection operator (∩)"@en ;
    va:hasAlgebraicProperty "Associative",
        "Commutative",
        "Idempotent" ;
    va:operatorSymbol "&" ;
    va:thesisSection "Set-theoretic interpretation; v4.6.0 archive" ;
    va:variantSemantics "intersection" ;
    dcterms:source "v4.6.0 operator punning (new in v4.6.0).",
        "Set-theoretic correction; v4.6.0 archive line 21–28; thesis §2.2.3 ⊓ symbol context.",
        "Real, disclosed ASCII notation (owner, 2026-09-22): '&' chosen for keyboard accessibility, matching Python's own real set-intersection operator -- the exact signal c29_intersection_calculus already detects ('self.a & self.b'), so the notation and the detection signal now agree. Also disclosed here, not silently left: this individual's own rdfs:label uses '∩' while its skos:definition below uses '⊓' for the same operator -- a real, pre-existing inconsistency between two non-ASCII symbols, found while adding this one. Neither corrected in place (thesis-cited prose, left as historical record); '&' is the one formally load-bearing value via operatorSymbol."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Kesişim Operatörü"@tr ;
    skos:definition "Co-selection (va:Decision_OwnerClarification_2026_09_28, the operator rules): (a & b) gives {{}, {a, b}} -- both operands, or none of their names. Written '&' (owner, 2026-09-22). Until 3.3.0 this definition read 'set-theoretic intersection of two variant sets', which no rule or decision implemented."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ReplacementOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Replacement Operator"@en,
        "Replacement operator (~)"@en ;
    va:isCommutative false ;
    va:operatorSymbol "~" ;
    va:operatorPrecedence "2"^^xsd:nonNegativeInteger ;
    va:variantSemantics "replacement" ;
    va:isCoreOperator false ;
    va:operatorJustification "The final operator missing from the algebra, requested directly by the owner, 2026-09-22: 'The final operator missing is the replacement.' No existing operator states 'wherever a appears, put b in its place' -- Subtraction alone removes a without ever introducing b; Addition alone introduces b without removing a; composing them by hand loses the single, atomic 'in its place' semantics and the ordering/no-self-application guarantees (owner decisions 5a, 2026-09-25, and round 3, 2026-09-26) that make Replacement terminate."@en ;
    va:operatorSemanticNonOverlap "Subtraction (a - b) only removes; Addition (a + b) only introduces; neither, alone or in an unordered pair, states that b takes a's place. Replacement is non-commutative (va:isCommutative false) by definition -- 'a ~ b' and 'b ~ a' mean opposite substitutions -- which no existing commutative or order-blind operator can express."@en ;
    va:notExpressibleByCalculi "No existing detection calculus (C1-C33) proposes a substitution pairing; each proposes either a removal fact or an addition fact in isolation, never the single mapping 'a is taken out and b is put in its place' that Replacement's own semantics (and policy A4's rewrite-comparison check) require."@en ;
    va:approvalProvenance va:Approval_ReplacementOperator_2026_09_22 ;
    dcterms:source "Real, disclosed, session-introduced operator (owner + this session, 2026-09-22) -- thesis-external, like IntersectionOperator (v3.2.0), not a thesis eq. number. Requested directly: 'The final operator missing is the replacement.'"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:definition "(a ~ b): a substitution. Wherever a is in a variant, a is taken out and b is put in its place; 'a ~ b when cond' applies only in variants where cond holds; a statement applies to every a in the block where it is written, and several substitutions apply in written order (owner decisions 5a, 2026-09-25, and round 3, 2026-09-26). Applied once per variant and never to its own result, it terminates. It equals (V - a) + b when a is in V, which is why it binds at level 2 with Subtraction and Addition. Every substitution is checked by policy A4 (earlier variants rewritten by the same mapping compared with the new ones)."@en ;
    skos:example "`new_processor ~ legacy_processor` is not the intent; `legacy_processor ~ new_processor`: every variant that held legacy_processor holds new_processor in its place."@en ;
    skos:changeNote "3.2.7: definition changed from the withdrawn static reading ('a replaces b': a present, b absent) to the substitution the owner decided (5a, A4) and the runtime implements; the tag 'Non-commutative', outside the allowed values of va:hasAlgebraicProperty, replaced by va:isCommutative false. Level 2 follows from 5a: a ~ b equals (V - a) + b. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C4 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:InverseOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Inverse Operator"@en,
        "Inverse operator (!)"@en ;
        va:operatorPrecedence "5"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "!" ;
    va:thesisSection "§2.2.6.2 eq. 2.29 (introduced with Subtraction); Table 2.5 level 5" ;
    va:variantSemantics "complement" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 §2.2.6.2 eq. 2.29; Tablo 2.5 precedence 5"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Tersi"@tr ;
    skos:definition "Thesis §2.2.6.2: (!a) — unary inverse; produces an element that is removed from the variant's feature set. Inverse elements cannot appear in final variants; thesis eq. 2.29 requires subtraction of all inverse elements before variant emission."@en ;
    skos:example "`!b`: thesis §2.2.6.2 — represents the absence or negation of b in a variant; used during subtraction-based variant elimination."@en ;
    skos:changeNote "3.2.7: 'Idempotent' withdrawn and the variant semantics changed from 'identity' to 'complement', by owner decision 5b (va:Decision_SubtractionRevisit_2026_09_25), which reads Inverse as a complement. A complement's law is !!a = a (an involution), which is not idempotence; thesis Table 2.6 has no row for '!'. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C5 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Literal a owl:Class ;
    rdfs:label "Literal"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:comment "v3.2.4 scope note: va:Literal is the SINGLE terminal class for all literal value forms (numeric, string, boolean, null, collection literals). Discrimination, if needed, is via the va:literalDatatype datatype property, NOT via subclasses. Lexical subtypes (operators, keywords, delimiters, whitespace) are NOT modeled as VAF classes; they belong to the parsing layer. This boundary is intentional — VAF classes represent semantic units of composition and variation, not lexical artifacts."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:altLabel "Değer"@tr ;
    skos:definition "A literal value. Ψ-element. Non-composable (atomic)."@en ;
    skos:example "The integer value `3` appearing as an initial value in an Attribute definition is a Literal Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:MandatoryOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:subClassOf va:Operator ;
    rdfs:label "Mandatory Operator"@en ;
    va:hasAlgebraicProperty "Identity" ;
        va:thesisSection "§2.1.4 (zorunlu, mandatory elements)" ;
    va:variantSemantics "identity" ;
    dcterms:source "Altunel 2013 §2.1.4; no symbol in thesis Table 2.5"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "Zorunlu"@tr ;
    skos:definition "The feature must appear in every variant. Thesis §2.3: zorunluluk. Real, disclosed notation (owner, 2026-09-22, ASCII-only): a bare, undecorated entity name -- not wrapped by Optional's own '[]' closure -- is mandatory by convention; no wrapping symbol decorates the entity itself. The declared ',' is the real separator for listing several jointly-mandatory entities together (e.g. 'a, b, c' -- all three mandatory), not a per-entity decoration. Real, disclosed generalization (owner, 2026-09-22): the same ',' is the general-purpose multi-element listing separator wherever several entities are named together -- inside or outside a set, Repetition, Optional, or terminal (leaf) element description -- not a Mandatory-specific device; Mandatory is simply the case where the comma-joined list sits at the top level, undecorated."@en ;
    skos:example "`PaymentProcessor.ProcessOrder` declared mandatory: every variant of PaymentProcessor must contain ProcessOrder."@en ;
    skos:changeNote "3.2.7: the symbol ',' removed, as the grammar alignment announced (owner, 2026-09-26: ',' only separates list items; a mandatory feature is a bare name). The thesis's operator set (eq. 2.8) lists ',' and the thesis names mandatory elements in §2.1.4; the ontology keeps the operator and drops the symbol. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_B7 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Message a owl:Class ;
    rdfs:label "Message"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Mesaj"@tr ;
    skos:definition "A message exchanged between software units. Ψ-element."@en ;
    skos:example "An RPC payload `{action: 'charge', amount: 10.5, currency: 'USD'}` passed between Components is a Message Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:NormalizationCalculus a owl:Class ;
    rdfs:label "Normalization Calculus (Tier 2)"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Calculus ;
    skos:definition "Tier 2 Calculus: applies algebraic properties (associativity, commutativity, identity-element, distributivity) to canonicalize expressions. Input: a feature expression. Output: an equivalent canonicalized expression. Exercises the property declarations (va:isAssociative, va:isCommutative, va:hasIdentityElement) declared on operators since v3.0.0 but not previously used."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8; Terms List distinguishing İşlem from İşleç"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "İşlem"@tr ;
    skos:definition "Thesis distinguishes İşlem (Operation — a relation or operation an element undergoes) from İşleç (Operator — the symbol triggering it). Both appear in Ψ. va:Operation is the Ψ-element sense: an operation-as-element, distinct from va:Operator (the symbol-level class)."@en ;
    skos:example "A method's name 'charge' names an Operation; its algebraic counterpart (the application of some Operator to features) is an Operator instance. Same concept, two vocabulary levels."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:OperationSet a owl:Class ;
    rdfs:label "Operation Set"@en ;
    dcterms:source "Altunel 2013 §2.2.4.3 eq. 2.23–2.24"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:AlgebraicStructure ;
    skos:altLabel "İşlem Kümesi"@tr ;
    skos:definition "Thesis eq. 2.23–2.24: O(ω) = {VK_1(ω), ..., VK_n(ω)} where VK_i ≠ VK_j. Set of entity sets that an operation can produce."@en ;
    skos:example "Thesis eq. 2.23: O(ω) = {VK₁(ω), VK₂(ω)} — a set of entity sets producible by operation ω, each set distinct."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:OperationalMetadataArtifact a owl:Class ;
    rdfs:label "Operational Metadata Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Operasyonel Metaveri Yapıtı"@tr ;
    skos:definition "Metadata describing the runtime operational surface of a system — what it logs, measures, and exposes. Includes log-format definitions, metric/instrument catalogs (Prometheus rules, OpenTelemetry configs), alert-rule files, dashboard definitions. Distinct from actual operational data (log streams, metric values) which is runtime-dynamic and typically privacy-sensitive."@en ;
    skos:example "prometheus.yml with scrape configs and alert rules. grafana dashboard JSON files. logger configurations defining log levels and formats. OpenTelemetry collector configs."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:OrOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Or Operator"@en,
        "Or operator (|)"@en ;
    va:hasAlgebraicProperty "Associative",
        "Commutative",
        "Idempotent" ;
    va:isAssociative true ;
    va:isCommutative true ;
    va:operatorPrecedence "1"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "|" ;
    va:thesisSection "§2.2.6.5 eq. 2.34; Table 2.5 level 1; Table 2.6 row '|'" ;
    va:variantSemantics "union" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.34; Tablo 2.5 precedence 1"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Veya"@tr ;
    skos:definition "Thesis eq. 2.34: (a | b) — one, the other, or both may appear."@en ;
    skos:example "`Car { Connectivity4G | Connectivity5G }`: variants may include 4G, 5G, or both. Thesis eq. 2.34 yields 2^n - 1 combinations."@en ;
    skos:changeNote "3.2.7: citation corrected from Table 2.7 (distributivity) to Table 2.6 (properties). Idempotent, commutative and associative are measured to hold; the identity element is not asserted (not writable). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C3 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Package a owl:Class ;
    rdfs:label "Package"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:altLabel "Paket"@tr ;
    skos:definition "A named grouping of related software units. Ψ-element."@en ;
    skos:example "The Python package `django.contrib.auth` (a directory with `__init__.py` plus submodules) is a Package Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ProbabilisticCalculus a owl:Class ;
    rdfs:label "Probabilistic Calculus (Tier 5)"@en ;
    dcterms:source "v4.2.0 §C. Distinguished at class level on author's explicit direction for epistemic transparency."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Calculus ;
    skos:altLabel "Olasılıksal Hesap (Tier 5)"@tr ;
    skos:definition "Tier 5 Calculus: derives facts via probabilistic methods rather than deterministic calculation. Input: typically natural-language text (requirements prose, commit messages, issue descriptions, wiki content) or ambiguous structural patterns. Output: facts with confidence annotation. Distinguished from Tiers 1–4 at the class level because the epistemic character of the output differs: Tier-5 facts may be wrong, may be incomplete, may hallucinate structure that isn't in the source, and may fail to detect structure that is. Workbench policy may restrict Tier-5 output to 'proposed' status (not auto-promoted to authoritative ontology) or may require a designer review step."@en ;
    skos:scopeNote "Intentional root primitive subclass of Calculus. Tier-5 is categorically distinct from Tiers 1–4: same framework input (source material) but different epistemic output (probabilistic vs deterministic). Tier-5 calculi MUST attach ConfidenceLevel (typically Medium/Low/Speculative) and rawEvidenceSnippet to every DetectionRecord they produce. Applications consuming Tier-5 facts MUST NOT conflate them with deterministic facts; downstream queries should filter by tier when appropriate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ProcessArtifact a owl:Class ;
    rdfs:label "Process Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Süreç Yapıtı"@tr ;
    skos:definition "A record of development-process activity. Includes commit messages (structured if conventional-commits, free-form otherwise), pull request descriptions and discussions, issue tracker entries, wiki pages, meeting notes, chat transcripts, code review comments. Highly variable structure; many are pure natural language and require Tier-5 extraction. Valuable for design rationale and institutional knowledge that never made it into formal artifacts."@en ;
    skos:example "Git commit 'feat(auth): add OAuth2 token refresh' (conventional-commits format, Tier-1). Jira ticket prose 'Users are complaining about session timeouts after 30m...' (Tier-5). Wiki page 'Authentication Design Rationale' (Tier-5). Meeting notes 'Decided to use JWT because of stateless scaling requirements' (Tier-5)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Repetition a owl:Class ;
    rdfs:label "Repetition (element)"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:altLabel "Tekrar"@tr ;
    skos:definition "A repeated instance of an element within a variant. Thesis §2.2.2 eq. 2.8 lists Tekrar as a Ψ element, distinct from the RepetitionOperator `#` (which is the Δ-level mechanism that produces Repetition elements)."@en ;
    skos:example "A variant of Car that contains 3 USBPort features carries 3 Repetition elements of the USBPort feature. Each Repetition is a distinct Ψ-element instance."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:RepetitionOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Repetition Operator"@en,
        "Repetition operator (#)"@en ;
    va:hasAlgebraicProperty "Associative" ;
    va:operatorPrecedence "1"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "#" ;
    va:thesisSection "§2.2.6.9 eq. 2.39; Table 2.5 levels 1 (#) and 7 ({})" ;
    va:variantSemantics "product" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.39; Tablo 2.5 — infix `#` at level 1, bracketed `{}` at level 7"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Tekrarlama"@tr ;
    skos:definition "Thesis eq. 2.39: (a # b) — zero or more repetitions. Also applicable in bracketed form {a} at precedence level 7."@en ;
    skos:example "USBPort # 2..4: a variant may have 2, 3, or 4 USB port features."@en ;
    skos:changeNote "3.2.7: citation corrected. Written today as a[m..n], a[n] and {a, b}[m..n] (owner decisions 2026-09-25); the thesis's infix 'a # b' cannot be written because '#' starts a comment -- put to the owner (va:Decision_InfixRepetition_2026_09_27). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C6 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    skos:changeNote "Owner, 2026-09-27 and 2026-09-28 (va:Decision_OwnerAnswers_2026_09_27, va:Decision_OwnerClarification_2026_09_28): operators are generic -- each has one meaning, the one its ontology rule states (02-shacl-safeguards/variant_algebra_operator_rules_v1_0_0.ttl), whatever its operands stand for; a named element is the one-element case. (3.2.8; corrected in 3.2.9, which had named the Python definitions evaluator as the semantics.) Repetition is written as decided on 2026-09-25 (a[m..n], a[n], {a, b}[m..n]); the thesis's infix 'a # b' is not part of the language, and '#' is recorded as the thesis's symbol only. This replaces the 3.2.7 note that put the infix form to the owner."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:RequirementsArtifact a owl:Class ;
    rdfs:label "Requirements Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Gereksinim Yapıtı"@tr ;
    skos:definition "A document authored during requirements analysis. Includes use cases, user stories, acceptance criteria, requirements specifications, domain glossaries, vision documents. Typically natural-language prose, sometimes with semi-structured templates. Structured extraction requires text processing (Tier-5 calculi for free prose; Tier-1 calculi for structured templates)."@en ;
    skos:example "A Markdown file describing a use case, a Jira epic with acceptance criteria, a Word document with functional requirements. Templated use cases following a standard format (actor/precondition/flow/postcondition) are Tier-1-parseable; free-form prose requirements need Tier-5 extraction."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Signature a owl:Class ;
    rdfs:label "Signature"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.12"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "İmza"@tr ;
    skos:definition "A method's signature (thesis eq. 2.12): Sig = ⟨ReturnType, Name, ParameterList⟩. Member-of-Method."@en ;
    skos:example "`Signature = ⟨ReturnType, Name, ParameterList⟩ = ⟨bool, charge, [amount: float]⟩` — thesis eq. 2.12; excludes Visibility and Body."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SourceCodeArtifact a owl:Class ;
    rdfs:label "Source Code Artifact"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Artifact ;
    skos:altLabel "Kaynak Kod Yapıtı"@tr ;
    skos:definition "A file containing source code in a programming language. Examples: Python .py files, Java .java files, TypeScript .ts files, SQL procedure files. The current structural framework's Tier-1 calculi (H1–H9) operate on SourceCodeArtifacts via AST parsing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SubtractionOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Subtraction Operator"@en,
        "Subtraction operator (−)"@en ;
    va:hasAlgebraicProperty "Inverse" ;
    va:hasIdentityElement "∅" ;
    va:isAssociative true ;
    va:isCommutative false ;
    va:operatorPrecedence "2"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "-" ;
    va:thesisSection "§2.2.6.2 eq. 2.29; Table 2.5 level 2; Table 2.6 row '-'" ;
    va:variantSemantics "difference" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.29; Tablo 2.5 precedence 2; Tablo 2.6"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Çıkarma"@tr ;
    skos:definition "Thesis eq. 2.29: (a - b) = {a, b | a ∈ F ∧ !b ∈ F}. Introduces the inverse of the second operand. Non-commutative; associative left-to-right."@en ;
    skos:example "`(a - b)`: thesis eq. 2.29 produces {a, !b} — variants containing a but not b. Used to exclude a feature."@en ;
    skos:changeNote "3.2.7, label revision of decision 5b (va:Decision_SubtractionRevisit_2026_09_25) done: the tag 'Inverse' here is thesis Table 2.6's inverse-element column, a - a = empty. It does not make Subtraction the inverse of Addition, which has no inverse because it is idempotent. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_B1 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:VariantSet a owl:Class ;
    rdfs:label "Variant Set"@en ;
    dcterms:source "Altunel 2013 §2.2.4.2 eq. 2.22"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:AlgebraicStructure ;
    skos:altLabel "Varyant Kümesi"@tr ;
    skos:definition "Thesis eq. 2.22: V = {V_1, V_2, ..., V_n} where V_i ≠ V_j. All variants producible by a given operator. No two variants in the set are equal."@en ;
    skos:example "Thesis eq. 2.22: V = {V₁, V₂, V₃} where each Vᵢ is distinct from the others. All variants producible by a given operator."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:applicationLevel a owl:DatatypeProperty ;
    rdfs:label "application level"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:OperatorApplication ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Abstraction level at which the operator was applied (e.g. 'feature', 'method', 'class', 'package')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:applicationRationale a owl:DatatypeProperty ;
    rdfs:label "application rationale"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:OperatorApplication ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable explanation of why this operator was applied here."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:applicationResult a owl:ObjectProperty ;
    rdfs:label "application result"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:OperatorApplication ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Variant ;
    skos:definition "Links an OperatorApplication to its resulting Variant or VariantSet."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to"@en ;
    dcterms:source "Altunel 2013 §2.2.3 (operators applied to features); Sprint S-D formal declaration."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a single-feature operator instance (MandatoryOperator, OptionalOperator, RepetitionOperator, InverseOperator) to the va:Feature it governs. Exactly one appliesTo per single-feature operator; multi-feature operators use va:members instead."@en ;
    skos:example ":Car_Op3 a va:MandatoryOperator ; va:appliesTo :Car_start . — the start method is mandatory in every Car variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:appliesToScope a owl:DatatypeProperty ;
    rdfs:label "applies to scope"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The scope (as string identifier: 'first-party', 'third-party', 'test-code', or custom tag) to which a CalculusPolicy applies. Workbench matches SoftwareUnits to policies by comparing unit-scope tags to policy-scope values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:artifactFormat a owl:DatatypeProperty ;
    rdfs:label "artifact format"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:domain va:Artifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The format of an Artifact ('python', 'yaml', 'json', 'markdown', 'openapi-3.0', 'graphql', 'sql-ddl', 'dockerfile', 'git-commit', 'jira-issue', 'confluence-page', etc.). Determines which parser/extractor applies."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:artifactLifecycleStage a owl:DatatypeProperty ;
    rdfs:label "lifecycle stage"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:domain va:Artifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The software-life-cycle stage that produced this Artifact: 'requirements', 'design', 'implementation', 'testing', 'deployment', 'operation', 'maintenance'. Coarse classification; artifacts may span stages (a test case authored during implementation testing a requirement from analysis)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:artifactPath a owl:DatatypeProperty ;
    rdfs:label "artifact path"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:domain va:Artifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The file-system path or URI identifying an Artifact's storage location. Used for stable identification and for correlating facts back to their evidence source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:artifactTimestamp a owl:DatatypeProperty ;
    rdfs:label "artifact timestamp"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:domain va:Artifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:dateTime ;
    skos:definition "The creation or last-modification timestamp of an Artifact. Used for temporal reasoning (which artifact was written first, is the code newer than the requirement, etc.)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:assembles a owl:ObjectProperty ;
    rdfs:label "assembles"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Assembly ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Variant ;
    skos:definition "Links an Assembly activity to the Variant being assembled. The Variant is INPUT to the assembly process."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:assemblyHasWiring a owl:ObjectProperty ;
    rdfs:label "assembly has wiring"@en ;
    dcterms:source "Wire-First-P1 simulation, Decision 1 option (b/d/e selected)." ;
    rdfs:domain va:Assembly ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/3.2.3> ;
    rdfs:range va:Wiring ;
    skos:definition "Links an Assembly activity directly to a Wiring it includes. Successor to va:hasWiring (which has CompositionOperator domain - deprecated). Per the wire-first-constraint-propagation-P1 strategy, each legal Wiring under an Assembly is reified at materialisation time as an AdditionOperator over its endpoint Components (thesis eq. 2.28)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:authoredBy a owl:DatatypeProperty ;
    rdfs:label "authored by"@en ;
    dcterms:source "v4.2.0 §A."@en ;
    rdfs:domain va:Artifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The author or role that produced an Artifact, when known. String-typed rather than Agent-typed for broad applicability across artifact types (git author name vs. Jira reporter vs. wiki editor)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:bindingFramework a owl:DatatypeProperty ;
    rdfs:label "binding framework"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:domain va:EventBinding ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The framework convention that produced this EventBinding ('flask-route', 'pytest-fixture', 'qt-signal-slot', 'dom-event', 'asyncio-task')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:bindingHandler a owl:ObjectProperty ;
    rdfs:label "binding handler"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:domain va:EventBinding ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "The Feature (typically a method) that handles the event."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:bindingSource a owl:ObjectProperty ;
    rdfs:label "binding source"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:domain va:EventBinding ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SoftwareUnit ;
    skos:definition "The SoftwareUnit that serves as the event source — the object on which the event is registered. May be absent for decorator-based bindings where source is implicit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:bindingStyle a owl:ObjectProperty ;
    rdfs:label "has binding style"@en ;
    dcterms:source "Sprint S-D semantic correction; Bruneton et al. 2002 direct/indirect binding distinction."@en ;
    rdfs:domain va:CompositionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:BindingStyle ;
    skos:definition "Declares how sub-components in a SuperComponent coordinate: DirectBinding (peer-to-peer wirings between sub-component ports) or IndirectBinding (coordination mediated by SuperComponent's own methods, no peer wirings)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:bindsConcern a owl:ObjectProperty ;
    rdfs:label "binds Concern"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Aspect ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Concern ;
    skos:definition "Links an Aspect to the Concern it addresses. va:Concern already exists in v3.1.0 baseline (verified by rdflib parse 2026-04-28); this property MUST point to that existing class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:calculusTier a owl:DatatypeProperty ;
    rdfs:label "calculus tier"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:Calculus ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Annotation on a Calculus individual indicating its tier: 1 (Detection), 2 (Normalization), 3 (Entailment), 4 (Cross-Level). Redundant with class typing (Tier-N subclass membership) but provides direct queryability."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:conflictResolution a owl:DatatypeProperty ;
    rdfs:label "conflict resolution strategy"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "How the workbench resolves conflicting proposals from multiple calculi. Values: 'strongest-wins' (prefer strong-evidence proposals), 'designer-review' (surface all conflicts for manual resolution), 'all-recorded' (record all proposals; let downstream queries filter). Default: 'designer-review'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:containedBy a owl:ObjectProperty ;
    rdfs:label "contained by"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    owl:inverseOf va:hasFeature ;
    skos:definition "Inverse direction of va:hasFeature / va:containsUnit. A unit is containedBy its parent (module by package, method by class). Explicit navigation aid — lets consumers walk the containment tree without computing inverses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:decoratorArgument a owl:DatatypeProperty ;
    rdfs:label "decorator argument"@en ;
    dcterms:source "v4.1.0 §C."@en ;
    rdfs:domain va:DecoratorRole ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "An argument value passed to the decorator (e.g., @app.route('/users', methods=['GET']) has arguments '/users' and methods=['GET']). Captured as strings for structural recording."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:definedAtLine a owl:DatatypeProperty ;
    rdfs:label "defined at line"@en ;
    dcterms:source "Sprint S-F — source-line display for every Feature row; 'every feature has a reason' principle made traceable."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Source-code line number where a Feature (Method or Attribute) is defined. Complements va:detectedAtLine (which refers to dependency evidence): va:definedAtLine refers to the feature's own declaration site. Makes every Feature in the exported TTL directly traceable to source position."@en ;
    skos:example ":Car_start va:definedAtLine \"11\"^^xsd:nonNegativeInteger . (The start() method is defined at line 11 of the source file.)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:dependentSet a owl:ObjectProperty ;
    rdfs:label "dependent set"@en ;
    dcterms:source "Altunel 2013 §2.2.6.8 eq. 2.37 and Figure 6.31; Sprint S-D set-dependency extension."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a DependencyOperator instance to an rdf:List of features on the DEPENDENT side of the relation. Thesis Figure 6.31: `(a, b) < (c, d) = (a<c), (a<d), (b<c), (b<d)` — set-to-set dependency distributes to pairwise edges. Representing as a set preserves design intent as a single ontological entity while being equivalent to the distributed pairwise form."@en ;
    skos:example ":Car_DepOp1 a va:DependencyOperator ; va:dependentSet ( :Car_navigate ) ; va:prerequisiteSet ( :Car_gps :Car_map ) . — navigate requires both gps AND map."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:dependsOnModule a owl:DatatypeProperty ;
    rdfs:label "depends on module"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Name of a module this module imports. Replaces v0.1.0 skos:note 'imports: X'. Multi-valued. Future work: promote to va:dependsOn ObjectProperty linking to the actual module unit IRI when the dependency is within the same project."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:derivedFromArtifact a owl:ObjectProperty ;
    rdfs:label "derived from artifact"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:domain va:DetectionRecord ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Artifact ;
    skos:definition "A DetectionRecord is linked to the Artifact(s) from which the detected fact was derived. Multi-valued when a fact is supported by multiple artifacts (convergence). The existing va:detectedAtLine provides intra-artifact location; va:derivedFromArtifact provides cross-artifact source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:derivedFromDetections a owl:ObjectProperty ;
    rdfs:label "derived from detections"@en ;
    dcterms:source "Sprint S-G provenance preservation under safe-merge."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a simplified (merged) DependencyOperator to an rdf:List of DetectionRecord instances, one per pre-merge pairwise constituent. Preserves full calculus provenance through Figure 6.31 distribution-rule compression."@en ;
    skos:example ":DepOp1 va:derivedFromDetections ( [a va:DetectionRecord; va:detectedAtLine '86'^^xsd:nonNegativeInteger; ...] [a va:DetectionRecord; va:detectedAtLine '87'^^xsd:nonNegativeInteger; ...] ) ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:detectedAtLine a owl:DatatypeProperty ;
    rdfs:label "detected at line"@en ;
    dcterms:source "Sprint S-E provenance."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Source-code line number where the triggering evidence for an auto-detected dependency appears. Together with va:detectedBy gives full provenance: 'C1 fired because method navigate reads self.gps at line 18'."@en ;
    skos:example ":Car_Op14 va:detectedAtLine \"18\"^^xsd:nonNegativeInteger ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:detectedBy a owl:ObjectProperty ;
    rdfs:label "detected by"@en ;
    dcterms:source "Sprint S-E provenance."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:DetectionCalculus ;
    skos:definition "Links a DependencyOperator instance (or any proposed constraint) to the DetectionCalculus individual that proposed it. Only present on auto-detected dependencies that the designer has accepted; absent on manually-declared dependencies."@en ;
    skos:example ":Car_Op14 va:detectedBy va:AttributeUsageCalculus . (Means: the navigate<gps dependency was proposed by C1 and accepted by the designer.)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:detectionRationale a owl:DatatypeProperty ;
    rdfs:label "detection rationale"@en ;
    dcterms:source "Sprint S-E provenance."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable explanation of why a detection calculus proposed a particular dependency. Makes the reasoning introspectable: a dependency's existence is never opaque."@en ;
    skos:example ":Car_Op14 va:detectionRationale \"navigate() reads self.gps at line 18\"@en ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:directoryPath a owl:DatatypeProperty ;
    rdfs:label "directory path"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The relative directory path of a SoftwareUnit's source file (e.g., 'src/models/user', 'tests/unit/services'). Complements v3.0.7 va:sourceModule which captures the specific file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:disablesCalculus a owl:ObjectProperty ;
    rdfs:label "disables calculus"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Calculus ;
    skos:definition "A CalculusPolicy disables a Calculus for its scope (overriding defaults)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:docstringStyle a owl:DatatypeProperty ;
    rdfs:label "docstring style"@en ;
    dcterms:source "v4.1.0 §H."@en ;
    rdfs:domain va:Annotation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The docstring convention recognized on parsing: 'google', 'numpy', 'sphinx', 'epytext', 'plain'. Determines how structured sections (Args, Returns, Raises) were extracted."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:documentationText a owl:DatatypeProperty ;
    rdfs:label "documentation text"@en ;
    dcterms:source "v4.1.0 §H."@en ;
    rdfs:domain va:Annotation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The text content of an Annotation as extracted from source (docstring body, parameter description, return description, exception description)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:documentsParameter a owl:ObjectProperty ;
    rdfs:label "documents parameter"@en ;
    dcterms:source "v4.1.0 §H."@en ;
    rdfs:domain va:Annotation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Parameter ;
    skos:definition "An Annotation documents a specific Parameter (derived from structured docstring parsing)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:enablesCalculus a owl:ObjectProperty ;
    rdfs:label "enables calculus"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Calculus ;
    skos:definition "A CalculusPolicy enables a Calculus for its scope."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:endLine a owl:DatatypeProperty ;
    rdfs:label "end Line"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:BodySegment ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:integer ;
    skos:definition "Last source-code line number (1-indexed, inclusive) of the BodySegment."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:eventName a owl:DatatypeProperty ;
    rdfs:label "event name"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:domain va:EventBinding ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The name or identifier of the event that triggers the handler. Format depends on framework: HTTP route string, signal name, DOM event type, pytest mark name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:extractionModel a owl:DatatypeProperty ;
    rdfs:label "extraction model"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:domain va:DetectionRecord ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "For DetectionRecords produced by Tier-5 probabilistic calculi, the model or technique used ('gpt-4', 'spacy-ner', 'regex', 'embedding-similarity', etc.). Supports reproducibility and version-dependent-confidence analysis."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:extractionPromptId a owl:DatatypeProperty ;
    rdfs:label "extraction prompt identifier"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:domain va:DetectionRecord ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "For DetectionRecords produced by LLM-based extraction, an identifier for the prompt template used. Enables reproducibility: given the same prompt-id, model, artifact, and seed, results should be deterministic (or within controlled variance)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:featureName a owl:DatatypeProperty ;
    rdfs:label "feature name"@en ;
    dcterms:source "v4.6.2 patch, analyzer v0.2.0."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:altLabel "özellik adı"@tr ;
    skos:definition "The bare identifier of a Feature or SoftwareUnit — the rightmost segment of its qualified name. Indexed equality queries on featureName are O(log n) vs the v0.1.0 CONTAINS substring matching on rdfs:label which was O(n·m)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:fromPort a owl:ObjectProperty ;
    rdfs:label "from port"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Wiring ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Port ;
    skos:definition "The provided Port that is the source of the wiring."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasAbstractFeature a owl:ObjectProperty ;
    rdfs:label "has abstract feature"@en ;
    dcterms:source "Specification v1.1 §2.3 Definition 2.7."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:AbstractFeature ;
    rdfs:subPropertyOf va:hasFeature ;
    skos:altLabel "soyut unsura sahip"@tr ;
    skos:definition "A SoftwareUnit has an abstract Feature as a member. Subproperty of va:hasFeature; range restricted to va:AbstractFeature. A SoftwareUnit with at least one hasAbstractFeature triple qualifies as a ComponentTemplate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasAlgebraicProperty a owl:DatatypeProperty ;
    rdfs:label "has algebraic property"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Multi-valued tag enumerating algebraic-law properties of an operator: Identity, Inverse, Commutative, Associative, Distributive, Idempotent. Replaces lock #5b's superclass grouping. Sourced from thesis Tablo 2.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasArity a owl:DatatypeProperty ;
    rdfs:label "has arity"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Count of positional parameters of a signature, excluding implicit receiver (self/cls)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasAttributeType a owl:ObjectProperty ;
    rdfs:label "has attribute type"@en ;
    dcterms:source "v4.1.0 §B."@en ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:TypeReference ;
    skos:definition "Annotates an Attribute with its declared type reference. Optional."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasCanonicalSignature a owl:ObjectProperty ;
    rdfs:label "has canonical signature"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:CanonicalSignature ;
    skos:altLabel "kurallı imzası"@tr ;
    skos:definition "Relates a Feature to its structured canonical signature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasComputationalComplexity a owl:ObjectProperty ;
    rdfs:label "has computational complexity"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ComputationalComplexity ;
    skos:definition "Links an Operator to its ComputationalComplexity classification. Required by blueprint v3.0.4 lock #3 efficiency commitment."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasConcreteFeature a owl:ObjectProperty ;
    rdfs:label "has concrete feature"@en ;
    dcterms:source "Specification v2.0 §5.2."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ConcreteFeature ;
    rdfs:subPropertyOf va:hasFeature ;
    skos:altLabel "somut unsura sahip"@tr ;
    skos:definition "A SoftwareUnit has a concrete Feature as a member. Subproperty of va:hasFeature; range restricted to va:ConcreteFeature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasConfidence a owl:ObjectProperty ;
    rdfs:label "has confidence"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:domain va:DetectionRecord ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ConfidenceLevel ;
    skos:definition "A DetectionRecord has an associated ConfidenceLevel classifying how strongly its evidence supports the derived fact."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasDecorator a owl:DatatypeProperty ;
    rdfs:label "has decorator"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "One decorator name applied to a feature or unit (e.g., 'staticmethod', 'property', 'abstractmethod'). Multi-valued. Replaces v0.1.0 skos:note 'decorators: X,Y,Z' comma-joined string — queries can now test individual decorator presence without parsing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasDecoratorRole a owl:ObjectProperty ;
    rdfs:label "has decorator role"@en ;
    dcterms:source "v4.1.0 §C."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:DecoratorRole ;
    skos:definition "A Feature has an assigned DecoratorRole from one or more of its decorators. Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasDirectoryRole a owl:ObjectProperty ;
    rdfs:label "has directory role"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:DirectoryRole ;
    skos:definition "A SoftwareUnit has a role derived from its source directory."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasDocstring a owl:ObjectProperty ;
    rdfs:label "has docstring"@en ;
    dcterms:source "v4.1.0 §H."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Annotation ;
    skos:definition "A SoftwareUnit has an attached Annotation that captures its docstring. The Annotation's content is the docstring text; further parsing (per Google/NumPy/Sphinx conventions) populates additional annotations for parameter documentation, return documentation, and raises documentation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasDomainMember a owl:ObjectProperty ;
    rdfs:label "has domain member"@en ;
    dcterms:source "v4.1.0 §E."@en ;
    rdfs:domain va:ValueDomain ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "A ValueDomain has a specific named-value member. Each member is itself a Feature of the enclosing class (when the domain is an Enum class)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasIdentityElement a owl:DatatypeProperty ;
    rdfs:label "has identity element"@en ;
    dcterms:source "Altunel 2013 Tablo 2.6"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Symbolic representation of the identity element for the operator, if any. ∅ for most operators per thesis Tablo 2.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasInitialValue a owl:DatatypeProperty ;
    rdfs:label "has initial value"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True when a feature (typically an Attribute) has a declared initial value in source code. Replaces v0.1.0 skos:note 'has_initial_value: true'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasInnerOperator a owl:ObjectProperty ;
    rdfs:label "has inner operator"@en ;
    dcterms:source "Altunel 2013 Figure 6.30 and surrounding §6 discussion; Sprint S-D wrapping support."@en ;
    rdfs:domain va:OptionalOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Operator ;
    skos:definition "Links an OptionalOperator to an inner operator it wraps. Enables thesis patterns like `[a $ b]` (Optional-Exclusive: one of {a, b, ∅} — 3 variants) vs `(a $ b)` (Exclusive-only: one of {a, b} — 2 variants). Distinguishes variant-count n from n+1."@en ;
    skos:example ":Car_Op7 a va:OptionalOperator ; va:hasInnerOperator :Car_Op5 . — where :Car_Op5 is an ExclusiveOperator over {4G, 5G}; the outer Optional allows the ∅ case (no connectivity)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasKwargs a owl:DatatypeProperty ;
    rdfs:label "has kwargs"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the signature accepts **kwargs."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasKwonly a owl:DatatypeProperty ;
    rdfs:label "has keyword-only parameter"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "One keyword-only parameter name in the signature. Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasNameTerm a owl:ObjectProperty ;
    rdfs:label "has name term"@en ;
    dcterms:source "v4.1.0 §A."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:NameTerm ;
    skos:definition "Relates a SoftwareUnit or Feature to one of the lexical terms in its name, in the order of appearance. Multi-valued; order preserved via list representations where needed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasOperand a owl:ObjectProperty ;
    rdfs:label "has operand"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:CompositionOperator va:ConditionedExpression ) ];
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ComposableUnit ;
    skos:definition "Links a CompositionOperator instance to one of its operand ComposableUnits. A composition with two operands has two hasOperand triples."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasOperation a owl:ObjectProperty ;
    rdfs:label "has operation"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Contract ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ContractOperation ;
    skos:definition "Links a Contract to an Operation it declares. A Contract with zero operations is a pure marker (nominal interface)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasOperator a owl:ObjectProperty ;
    rdfs:label "has operator"@en ;
    dcterms:source "Altunel 2013 §2.2.1"@en ;
    rdfs:domain va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Operator ;
    skos:definition "Links a ComposableUnit to an Operator declaration that applies to its features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasParameterType a owl:ObjectProperty ;
    rdfs:label "has parameter type"@en ;
    dcterms:source "v4.1.0 §B."@en ;
    rdfs:domain va:Parameter ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:TypeReference ;
    skos:definition "Annotates a Parameter with its declared type reference. Optional (some parameters lack type annotations)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasPort a owl:ObjectProperty ;
    rdfs:label "has port"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Port ;
    skos:definition "Links a ComposableUnit to a Port it declares."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasReturnType a owl:ObjectProperty ;
    rdfs:label "has return type"@en ;
    dcterms:source "v4.1.0 §B. Complementary to canonical-signature matching discipline from v2.0."@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:TypeReference ;
    skos:definition "Annotates a Method with its declared return type. Excluded from canonical-signature equality per v2.0 Definition 2.5 (Python dynamic typing); recorded for behavioral/semantic signal."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasSideEffectClass a owl:ObjectProperty ;
    rdfs:label "has side effect class"@en ;
    dcterms:source "v4.1.0 §G."@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SideEffectClass ;
    skos:definition "A Method has one or more SideEffectClass classifications. Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasSubComponent a owl:ObjectProperty ;
    rdfs:label "has sub-component"@en ;
    dcterms:source "Altunel 2013 Terms List"@en ;
    rdfs:domain va:SuperComponent ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ComposableUnit ;
    skos:altLabel "alt-bileşen"@tr ;
    skos:definition "Links a SuperComponent to a sub-unit it contains. Sub-components retain their identity — composition does not merge their feature spaces. Mirrors thesis 'Alt-bileşen' Terms List entry."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasTypeAnnotation a owl:DatatypeProperty ;
    rdfs:label "has type annotation"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Declared type annotation for an attribute or parameter, in source-language syntactic form (e.g., 'Optional[str]', 'list[int]'). Replaces v0.1.0 skos:note 'type_annotation: X'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasTypeParameter a owl:ObjectProperty ;
    rdfs:label "has type parameter"@en ;
    dcterms:source "v4.1.0 §B."@en ;
    rdfs:domain va:TypeReference ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:TypeReference ;
    skos:definition "A TypeReference has a parameter TypeReference (for container types like list, dict, Optional). Multi-valued for types with multiple parameters; order significant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasValueDomain a owl:ObjectProperty ;
    rdfs:label "has value domain"@en ;
    dcterms:source "v4.1.0 §E."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ValueDomain ;
    skos:definition "Relates an Attribute or Parameter to the ValueDomain that constrains its possible values. When present, implies the attribute/parameter takes values only from the domain's members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasVarargs a owl:DatatypeProperty ;
    rdfs:label "has varargs"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the signature accepts *args."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasWiring a owl:ObjectProperty ;
    rdfs:label "has wiring"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:CompositionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Wiring ;
    skos:definition "Links a CompositionOperator to a Wiring it declares. A composition may declare zero or more wirings; unwired compositions are valid but the variant space is the full Cartesian product (upper bound without deflation)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:implementsLifecyclePhase a owl:ObjectProperty ;
    rdfs:label "implements lifecycle phase"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:LifecyclePhase ;
    skos:definition "A Feature (typically a method) implements a specific phase of a unit's lifecycle."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:importPath a owl:DatatypeProperty ;
    rdfs:label "import path"@en ;
    dcterms:source "Sprint S-H."@en ;
    rdfs:domain va:ExternalSymbol ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The dotted import path by which an External Symbol was referenced in the source: e.g. 'requests.utils.parse_dict_header', 'hashlib.md5'. Preserves the textual evidence for the symbol's existence even though its source is unparsed."@en ;
    skos:example ":parse_dict_header va:importPath \"requests.utils\"^^xsd:string ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:inheritedFrom a owl:ObjectProperty ;
    rdfs:label "inherited from"@en ;
    dcterms:source "Sprint S-D inheritance provenance."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ComposableUnit ;
    skos:definition "Per-feature provenance: identifies the ancestor class from which a feature was inherited. When a subclass X inherits AuthBase's __call__ method, X's feature-view includes a distinct feature X_inherited_AuthBase___call__ that carries va:inheritedFrom :AuthBase. The feature has its OWN identity and operator declaration; the parent's original feature AuthBase___call__ remains distinct."@en ;
    skos:example ":HTTPBasicAuth_inherited_AuthBase___call__ va:inheritedFrom :AuthBase ; va:sourceFeature :AuthBase___call__ ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:inheritsFrom a owl:ObjectProperty ;
    rdfs:label "inherits from"@en ;
    dcterms:source "Altunel 2013 §1.5 (Kalıt, inheritance, among related approaches); Sprint S-D feature-inheritance support. (Corrected in 3.2.7: '§1293, §1303' were line numbers of a text extraction, not sections.)"@en ;
    rdfs:domain va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:ComposableUnit ;
    skos:altLabel "Kalıt"@tr ;
    skos:definition "Links a subclass (va:Class or va:Component) to one of its superclass ancestors. Inheritance is a CLASS-LEVEL dependency — thesis §1293 (D'Souza & Wills 1999): 'Kalıt ile üretilen yazılım ürünleri arasında en güçlü bağımlılıklar oluşur' (inheritance produces the strongest dependencies between software products). Represented as a direct property rather than a DependencyOperator instance because (1) it is structural/static, not a variant-time choice; (2) it is transitive; (3) it carries feature propagation semantics."@en ;
    skos:example ":HTTPBasicAuth va:inheritsFrom :AuthBase . Transitively, HTTPBasicAuth also inherits from all of AuthBase's ancestors."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:inheritsFromName a owl:DatatypeProperty ;
    rdfs:label "inherits from (by name)"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Name of a base class, as a string. Syntactic-level import; cross-module resolution to the actual class IRI is deferred to a semantic-analysis pass."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:initialValue a owl:DatatypeProperty ;
    rdfs:label "initial value"@en ;
    dcterms:source "v4.1.0 §E."@en ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The literal initial value of an Attribute as it appears in source, represented as a string. For non-literal initializers (calls, expressions), use va:initializerKind to classify without recording the full expression."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:initializerKind a owl:DatatypeProperty ;
    rdfs:label "initializer kind"@en ;
    dcterms:source "v4.1.0 §E."@en ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Classification of an attribute's initializer: 'literal' (a direct value), 'constructor-call' (e.g., User()), 'function-call' (e.g., fetch_default()), 'empty-collection' (e.g., {}, []), 'none' (e.g., None), 'parameter-ref' (initialized from a constructor parameter), 'expression' (other). Coarse classification for structural/behavioral signal."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:involvesArtifact a owl:ObjectProperty ;
    rdfs:label "involves artifact"@en ;
    dcterms:source "v4.2.0 §D."@en ;
    rdfs:domain [ owl:unionOf ( va:Convergence va:Divergence va:Gap ) ] ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Artifact ;
    skos:definition "A reconciliation observation (Convergence, Divergence, or Gap) involves specific Artifacts. Multi-valued: convergences and divergences typically involve 2+ artifacts; gaps involve at least the expected-but-missing artifact location."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isAssociative a owl:DatatypeProperty ;
    rdfs:label "is associative"@en ;
    dcterms:source "Altunel 2013 Tablo 2.6"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the operator is associative. From thesis Tablo 2.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isAsync a owl:DatatypeProperty ;
    rdfs:label "is async"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True when the signature is for an async function/method."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isCommutative a owl:DatatypeProperty ;
    rdfs:label "is commutative"@en ;
    dcterms:source "Altunel 2013 Tablo 2.6"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the operator is commutative. From thesis Tablo 2.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isConstant a owl:DatatypeProperty ;
    rdfs:label "is constant"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on an Attribute: true when the attribute is intended as a constant (detected via ALL_CAPS naming convention, 'const'/'final' keyword, module-level declaration, or typing.Final annotation)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isExternalSymbol a owl:DatatypeProperty ;
    rdfs:label "is external symbol"@en ;
    dcterms:source "Sprint S-H."@en ;
    rdfs:domain va:ExternalSymbol ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean marker on a Ψ element indicating it is a symbolic stand-in for a name whose source code was not available. True for individuals created by C9 (ExternalSymbolCalculus); false or absent otherwise. Intended as a quick filter for tools that want to distinguish introspectable features from symbolic ones."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isInherited a owl:DatatypeProperty ;
    rdfs:label "is inherited"@en ;
    dcterms:source "Sprint S-D inheritance support."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a Feature indicating it is an inherited-feature-view (true) vs an own feature of the containing class (false)."@en ;
    skos:example ":HTTPBasicAuth_inherited_AuthBase___call__ va:isInherited true ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isLegalWiring a owl:DatatypeProperty ;
    rdfs:label "is legal wiring"@en ;
    dcterms:source "Wire-First-P1 simulation, Decision 2 option (promote selected)." ;
    rdfs:domain va:Wiring ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/3.2.3> ;
    rdfs:range xsd:boolean ;
    skos:definition "Tags a Wiring as having passed all three SHACL legality gates: WiringShape (1+1 ports), WiringContractMatchShape (matching Contract on both endpoints), WiringDirectionShape (UML provided->required ball-and-socket). Materialised by Phase P1.1 of wire-first-constraint-propagation-P1."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:isSimplified a owl:DatatypeProperty ;
    rdfs:label "is simplified"@en ;
    dcterms:source "Sprint S-G audit trail."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a DependencyOperator indicating it was produced by a merge-simplification pass (true) vs authored directly by the designer or accepted from a single calculus suggestion (false/absent). Audit-trail marker only — semantics of the dependency are identical regardless."@en ;
    skos:example ":DepOp1 va:isSimplified true . (This edge consolidates N pairwise edges per Figure 6.31.)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:justifiedBy a owl:ObjectProperty ;
    rdfs:label "justified by"@en ;
    dcterms:source "Sprint S-D design principle: 'every feature in a variant has a reason to exist not just because of its containment' (Altunel, design discussion, 2026-04-21)."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Operator ;
    skos:definition "Inverse-index convenience property: links a Feature to one or more Operators that govern its presence/absence in variants. A feature with no justifiedBy triple is arbitrary — it has no declared reason to exist. Computed at authoring time: the Workbench emits this property when exporting TTL, listing every operator that applies to the feature (single or via group members)."@en ;
    skos:example ":Car_start va:justifiedBy :Car_Op3 . — start's presence in every variant is justified by the Mandatory declaration."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:liftedFromSegments a owl:ObjectProperty ;
    rdfs:label "lifted From Segments"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Aspect ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:BodySegment ;
    skos:definition "When an Aspect is reverse-engineered from existing source code, links the Aspect to the BodySegment(s) from which the Aspect was lifted (auto-detected) rather than originally designed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:matchesNamingPattern a owl:ObjectProperty ;
    rdfs:label "matches naming pattern"@en ;
    dcterms:source "v4.1.0 §A."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:NamingPattern ;
    skos:definition "Relates a Feature (typically a method) to a NamingPattern it matches. A feature may match multiple patterns (e.g., 'is_valid_password' matches both predicate and validator)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:maxClosureDepth a owl:DatatypeProperty ;
    rdfs:label "max closure depth"@en ;
    dcterms:source "v4.0.0 introduction; addresses combinatorial-explosion concern."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "Scope constraint on EntailmentCalculus individuals (primarily the DependencyChainCalculus / H7): limits how many transitive-closure steps are computed. Prevents combinatorial explosion in large dependency graphs. Default: unbounded; constraint applies only when set."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:memberOfPolymorphismGroup a owl:ObjectProperty ;
    rdfs:label "member of polymorphism group"@en ;
    dcterms:source "Specification v1.1 §2.6."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:PolymorphismGroup ;
    skos:altLabel "çok-biçimlilik grubu üyesi"@tr ;
    skos:definition "Relates a Feature to a PolymorphismGroup it belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:members a owl:ObjectProperty ;
    rdfs:label "members"@en ;
    dcterms:source "Altunel 2013 eq. 2.34–2.35; Sprint S-D formal declaration."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a multi-feature operator (ExclusiveOperator, OrOperator) to an rdf:List of the features in the group. Position in list is significant only for display/citation — the operator's semantics are set-based."@en ;
    skos:example ":Car_Op5 a va:ExclusiveOperator ; va:members ( :Car_4G :Car_5G ) . — exactly one of 4G or 5G in each Car variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:nameOrigin a owl:DatatypeProperty ;
    rdfs:label "name origin"@en ;
    dcterms:source "Specification v2.0 §5.3."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:altLabel "ad kökeni"@tr ;
    skos:definition "Annotation on a SoftwareUnit indicating whether its name comes from source code ('source') or was synthesized by the parser ('synthetic'). Used under the recursive-uniform population pattern so every has-members construct has a stable identifier. Supports workbench UI filtering; does not affect ontology semantics."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:operationName a owl:DatatypeProperty ;
    rdfs:label "operation name"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:ContractOperation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The name of a ContractOperation. A valid language identifier in the target implementation language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:operatorPrecedence a owl:DatatypeProperty ;
    rdfs:label "operator precedence"@en ;
    dcterms:source "Altunel 2013 Tablo 2.5"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Precedence level from thesis Table 2.5. Higher values are evaluated first. 1 = lowest (Or, Exclusive, Repetition); 8 = highest (grouping parentheses); 0 = structural (Composition)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:operatorSymbol a owl:DatatypeProperty ;
    rdfs:label "operator symbol"@en ;
    dcterms:source "Altunel 2013 Tablo 2.5"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The symbolic notation of an operator as used in thesis Table 2.5 and the algebraic DSL."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:overrides a owl:ObjectProperty ;
    rdfs:label "overrides"@en ;
    dcterms:source "Sprint S-D polymorphism modelling."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a subclass's own-defined feature to the inherited-feature-view of the same name from a parent class. Both features exist simultaneously (thesis provenance principle): the own feature is reachable via the subclass identity; the inherited feature is reachable via the parent's identity (e.g., super().__call__() in Python). Polymorphism is an explicit choice, not a hidden rewrite."@en ;
    skos:example ":HTTPBasicAuth___call__ va:overrides :HTTPBasicAuth_inherited_AuthBase___call__ . — the subclass's own __call__ overrides the inherited-view while both remain distinct Ψ identities."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:partOfBody a owl:ObjectProperty ;
    rdfs:label "part of body"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:BodySegment ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SoftwareUnit ;
    skos:definition "Links a BodySegment to the SoftwareUnit (typically a method) whose body it belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:partOfDependencyCycle a owl:DatatypeProperty ;
    rdfs:label "part of dependency cycle"@en ;
    dcterms:source "Sprint S-G cycle surfacing."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean flag on a DependencyOperator indicating it participates in a cycle in the dependency graph (e.g., a < b, b < a). Cycles are not ontologically invalid per thesis eq. 6.2 (cycle members are mutually required). Flag is informational: designer should review whether the cycle represents intended mutual requirement (common for recursive methods under C2) or a modeling error."@en ;
    skos:example ":Op1 va:partOfDependencyCycle true . (This edge is inside a cycle; its members are mutually required in every containing variant.)"@en ;
    skos:scopeNote "Cycle detection is Workbench-time only; TTL emits this flag when the simplification pass identifies a cycle. Semantics of the dependency itself are unchanged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:participatesInProtocol a owl:ObjectProperty ;
    rdfs:label "participates in protocol"@en ;
    dcterms:source "v4.1.0 §D."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Protocol ;
    skos:definition "A SoftwareUnit participates in a Protocol when its features satisfy the Protocol's required-member signatures. Multi-valued: a unit may participate in multiple protocols."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:portDirection a owl:DatatypeProperty ;
    rdfs:label "port direction"@en ;
    dcterms:source "Sprint S-A thesis extension; UML convention"@en ;
    rdfs:domain va:Port ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The direction of the port. Must be 'provided' (exposed, UML lollipop / ball end) or 'required' (consumed, UML socket end). Past-participle vocabulary aligns with the SHACL WiringDirectionShape filter, the v3.2.1 SHACL pack, and standard UML convention. Supersedes the v3.2.2 skos:definition that used present-tense 'provides'/'requires'."@en,
        "The direction of the port. Must be 'provides' (exposed, UML lollipop) or 'requires' (consumed, UML socket)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:portName a owl:DatatypeProperty ;
    rdfs:label "port name"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Port ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "A human-readable label for the port, unique within its owning unit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:positionalParamCount a owl:DatatypeProperty ;
    rdfs:label "positional parameter count"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:ContractOperation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The number of positional parameters the operation expects, excluding self. Type-agnostic."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:comment "Lock #5 closure: this is a relation, not a subClassOf va:Operator. ClosedOperatorSetShape from PBI-014 mechanically enforces this."@en ;
    rdfs:domain va:BodySegment ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:BodySegment ;
    skos:definition "Relation: BodySegment A precedes B if A.endLine < B.startLine within the same body. NOT an operator (must not be subClassOf va:Operator); pure ordering relation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:prerequisiteSet a owl:ObjectProperty ;
    rdfs:label "prerequisite set"@en ;
    dcterms:source "Altunel 2013 §2.2.6.8 eq. 2.37; Sprint S-D."@en ;
    rdfs:domain va:DependencyOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a DependencyOperator instance to an rdf:List of features on the PREREQUISITE side of the relation. Every member of dependentSet forces every member of prerequisiteSet to be present in any variant containing it."@en ;
    skos:example "See va:dependentSet example — prerequisiteSet holds the features that must be present."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:produces a owl:ObjectProperty ;
    rdfs:label "produces"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SoftwareUnit ;
    skos:definition "Links an operator instance to the unit it produces. For CompositionOperator, the produced unit is a SuperComponent."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:producesApplication a owl:ObjectProperty ;
    rdfs:label "produces application"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Assembly ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Application ;
    skos:definition "Links an Assembly activity to the resulting Application (file tree)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:protocolName a owl:DatatypeProperty ;
    rdfs:label "protocol name"@en ;
    dcterms:source "v4.1.0 §D."@en ;
    rdfs:domain va:Protocol ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable name of the Protocol (e.g., 'ContextManager', 'Iterator')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:raisesExceptionType a owl:DatatypeProperty ;
    rdfs:label "raises exception type"@en ;
    dcterms:source "v4.1.0 §G."@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The name of an exception type that a Method's body may raise (via explicit raise). Multi-valued."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:rawEvidenceSnippet a owl:DatatypeProperty ;
    rdfs:label "raw evidence snippet"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:domain va:DetectionRecord ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The raw textual evidence (excerpt from the artifact) that led to the derived fact. Enables human review. Especially important for Tier-5 facts where the calculus is not fully deterministic."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:readIsConditional a owl:DatatypeProperty ;
    rdfs:label "read is conditional"@en ;
    dcterms:source "Sprint S-F — evidence weight classification."@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Tags a DependencyOperator that was C1-detected: true if the self.X read lives inside an if/elif/try/except/loop body; false if the read is at the top level of the method body (or in a return statement). Unconditional reads are stronger evidence of hard variant-level dependency. This property does NOT change the dependency's ontological meaning — every accepted C1 edge still constrains variants the same way. It is provenance metadata for designer review."@en ;
    skos:example ":Car_Op14 va:readIsConditional false . (navigate() reads self.gps unconditionally.) vs :HTTPDigestAuth_OpN va:readIsConditional true . (the read is inside 'if self._thread_local.last_nonce:'.)"@en ;
    skos:scopeNote "NOT in thesis — added as suggestion-layer metadata only. Accepted C1 dependencies behave identically regardless of this flag."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:readsAttribute a owl:ObjectProperty ;
    rdfs:label "reads attribute"@en ;
    dcterms:source "v4.1.0 §G."@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Attribute ;
    skos:definition "A Method reads from a specific Attribute. Complementary to writesAttribute; supports read-only-classification and access-pattern analysis."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:realisesAddition a owl:ObjectProperty ;
    rdfs:label "realises addition"@en ;
    dcterms:source "Wire-First-P1 simulation, d1e calculi-first option (winner)." ;
    rdfs:domain va:Wiring ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/3.2.3> ;
    rdfs:range va:AdditionOperator ;
    skos:definition "For a legal Wiring with DirectBinding semantics, links the Wiring to an AdditionOperator whose appliesTo set contains the Wiring's endpoint Components. Per thesis eq. 2.28: a legal Wiring(A,B) IS a witness of A+B at the Component level. Materialised by Phase P1.3 of wire-first-constraint-propagation-P1 (option d1e). Removes the need for any Composition/Assembly/Wiring operator class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:realisesCartesianProduct a owl:ObjectProperty ;
    rdfs:label "realises Cartesian product"@en ;
    dcterms:source "Wire-First-P1 simulation, d1e calculi-first option (winner). IndirectBinding case." ;
    rdfs:domain va:CompositionArtefact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/3.2.3> ;
    rdfs:range va:CartesianOperator ;
    skos:definition "For an IndirectBinding composition (per the v3.1.0 SHACL relaxation: no peer wirings expected), links the composition to a CartesianOperator over its sub-components. Per thesis eq. 2.30: indirect composition produces all variant pairings. Materialised by the IndirectBinding fallback of Phase P1.3."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:realizedBy a owl:ObjectProperty ;
    rdfs:label "realized by"@en ;
    dcterms:source "Specification v1.1 §2.5."@en ;
    rdfs:domain va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SoftwareUnit ;
    owl:inverseOf va:realizes ;
    skos:definition "Inverse of va:realizes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:reconciliationDescription a owl:DatatypeProperty ;
    rdfs:label "reconciliation description"@en ;
    dcterms:source "v4.2.0 §D."@en ;
    rdfs:domain [ owl:unionOf ( va:Convergence va:Divergence va:Gap ) ] ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable description of a Convergence, Divergence, or Gap observation. Enables review and dashboarding."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:referencesContract a owl:ObjectProperty ;
    rdfs:label "references contract"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Port ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Contract ;
    skos:definition "Links a Port to the Contract it implements (for provides) or requires (for requires)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:requiresEnumerationStrategy a owl:DatatypeProperty ;
    rdfs:label "requires enumeration strategy"@en ;
    dcterms:source "Sprint S-A design decision: deflate before inflating"@en ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Declares the algorithmic strategy a consumer MUST use when enumerating variants under this operator. For CompositionOperator the mandated strategy is 'wire-first-constraint-propagation-P1' to avoid exponential inflation from brute-force Cartesian product materialisation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:requiresFeatureSignature a owl:ObjectProperty ;
    rdfs:label "requires feature signature"@en ;
    dcterms:source "v4.1.0 §D."@en ;
    rdfs:domain va:Protocol ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:CanonicalSignature ;
    skos:definition "A Protocol requires a specific CanonicalSignature among its member-unit features. Multi-valued: most Protocols require several signatures."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:roleName a owl:DatatypeProperty ;
    rdfs:label "role name"@en ;
    dcterms:source "v4.1.0 §C."@en ;
    rdfs:domain va:DecoratorRole ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The name of the role, as a string (e.g., 'HttpRoute', 'Property', 'StaticMethod', 'TestFixture'). Standardized where possible; framework-specific roles extend the set."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:segmentKind a owl:DatatypeProperty ;
    rdfs:label "segment kind"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:BodySegment ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Classification of what a BodySegment does. Eleven enumerated values (see SHACL sh:in constraint in v3.2.0 shapes): Validation, Dispatch, ResourceScope, ErrorHandling, Logging, StateUpdate, Computation, IOEffect, Result, PreconditionAssertion, Iteration. Calibration sprint pending (PBI-018: Cohen's κ ≥ 0.80 required)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:selects a owl:ObjectProperty ;
    rdfs:label "selects"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.17"@en ;
    rdfs:domain va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a Variant to the specific Features it includes from its parent Component's feature vector."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sigArity a owl:DatatypeProperty ;
    rdfs:label "signature arity"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Positional parameter count excluding implicit receiver."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sigHasKwargs a owl:DatatypeProperty ;
    rdfs:label "signature has kwargs"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean: method accepts variable keyword arguments (**kwargs)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sigHasVarargs a owl:DatatypeProperty ;
    rdfs:label "signature has varargs"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Boolean: method accepts variable positional arguments (*args)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sigKwOnlyName a owl:DatatypeProperty ;
    rdfs:label "signature kw-only name"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Keyword-only parameter name (multi-valued, one triple per parameter)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sigName a owl:DatatypeProperty ;
    rdfs:label "signature name"@en ;
    dcterms:source "Specification v1.1 §2.2."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Name component of a canonical signature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:signatureString a owl:DatatypeProperty ;
    rdfs:label "signature string"@en ;
    dcterms:source "v4.6.2 patch."@en ;
    rdfs:domain va:CanonicalSignature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Canonical string form of a signature, e.g., 'format_body(2)' or 'request(0)[headers,timeout][*args]'. Stored as a typed property for O(log n) equality retrieval."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sourceFeature a owl:ObjectProperty ;
    rdfs:label "source feature"@en ;
    dcterms:source "Sprint S-D inheritance provenance."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Per-feature provenance: the parent's feature identity that this inherited feature refers to. Together with va:inheritedFrom, forms a two-part pointer: which class, which feature-in-that-class."@en ;
    skos:example ":HTTPBasicAuth_inherited_AuthBase___call__ va:sourceFeature :AuthBase___call__ ."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:sourceModule a owl:DatatypeProperty ;
    rdfs:label "source module"@en ;
    dcterms:source "Sprint S-H cross-file support; thesis §1634 (module functions are Ψ) extended to cross-module scope."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Module basename (without .py extension) of the source file in which a Feature, Component, or Class was discovered. Complements va:definedAtLine (line position within the file). Enables cross-file variant analysis by preserving each feature's file-origin in the exported graph. Example: a Feature discovered in auth.py carries va:sourceModule 'auth'; a Feature discovered in utils.py carries va:sourceModule 'utils'."@en ;
    skos:example ":HTTPBasicAuth___call__ va:sourceModule \"auth\"^^xsd:string . :parse_dict_header va:sourceModule \"utils\"^^xsd:string ."@en ;
    skos:scopeNote "Basename only — the full relative path is not required for thesis-level variant reasoning, since the enumeration semantics treat features as flat Ψ elements. Module-tag is provenance, not structural."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:startLine a owl:DatatypeProperty ;
    rdfs:label "start Line"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:BodySegment ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:integer ;
    skos:definition "First source-code line number (1-indexed) of the BodySegment."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:targetLanguage a owl:DatatypeProperty ;
    rdfs:label "target language"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Assembly ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The programming language identifier for the assembly output (e.g. 'python', 'java', 'typescript'). Used by Component 8 emitter."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:testFrameworkUsed a owl:DatatypeProperty ;
    rdfs:label "test framework used"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:TestArtifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The testing framework the TestArtifact uses: 'pytest', 'unittest', 'doctest', 'jest', 'junit', 'mocha', etc."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:testsUnit a owl:ObjectProperty ;
    rdfs:label "tests unit"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:TestArtifact ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SoftwareUnit ;
    skos:definition "A TestArtifact tests a specific SoftwareUnit (the unit-under-test). Detected via name correspondence ('test_user_service' tests 'UserService'), import structure, or explicit mark."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:thesisSection a owl:DatatypeProperty ;
    rdfs:label "thesis section"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:comment "Domain intentionally open — thesisSection can apply to any va:* class or operator instance to record thesis-source location. Generic property."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Thesis section, equation, or table identifier where this operator (or other concept) is defined. Replaces overgeneralized 'Tables 2.6–2.7' citations with operator-specific source pinning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:toPort a owl:ObjectProperty ;
    rdfs:label "to port"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:domain va:Wiring ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Port ;
    skos:definition "The required Port that is the target of the wiring."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:trustLevel a owl:DatatypeProperty ;
    rdfs:label "trust level"@en ;
    dcterms:source "v4.0.0 introduction."@en ;
    rdfs:domain va:CalculusPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:positiveInteger ;
    skos:definition "A numeric score (1–5) indicating how aggressively calculi should propose inferences for a given scope. Trust level 1: only strongest-evidence proposals (e.g., only H1, H2 with direct syntactic evidence). Trust level 5: all calculi including weakest (H9 external-symbol). Provides a graduated tuning mechanism complementing enable/disable."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:typeName a owl:DatatypeProperty ;
    rdfs:label "type name"@en ;
    dcterms:source "v4.1.0 §B."@en ;
    rdfs:domain va:TypeReference ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The name of a referenced type as a string. For 'list[str]', the outer TypeReference has typeName 'list' and references a nested TypeReference with typeName 'str'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:unitKind a owl:DatatypeProperty ;
    rdfs:label "unit kind"@en ;
    dcterms:source "v4.6.2 patch, analyzer v0.2.0 optimization pass 2026-04-24."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:altLabel "birim türü"@tr ;
    skos:definition "Categorical label for a SoftwareUnit's structural kind: 'module', 'class', 'method', 'function', 'nested_class', 'nested_function'. Replaces v0.1.0 skos:note 'kind: X' string encoding with a queryable typed property."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:variantOf a owl:ObjectProperty ;
    rdfs:label "variant of"@en ;
    dcterms:source "Altunel 2013 eq. 2.17"@en ;
    rdfs:domain va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Component ;
    skos:definition "Links a Variant to the Component or SuperComponent whose feature vector it subsets (thesis eq. 2.17)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:variantSemantics a owl:DatatypeProperty ;
    rdfs:label "variant semantics"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Single-valued tag classifying the variant-set semantics: 'union', 'intersection', 'difference', 'product', 'projection', 'restriction', 'identity'. Single-valued constraint enforced by SHACL (PBI-014)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:visibilityLevel a owl:DatatypeProperty ;
    rdfs:label "visibility level"@en ;
    dcterms:source "v4.1.0 §I."@en ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Classification of a Feature's accessibility: 'public' (intended external use), 'protected' (single-underscore prefix in Python, 'protected' keyword in Java/C#), 'private' (double-underscore prefix / private keyword), 'internal' (language-specific, e.g., package-private in Java). Derived from naming convention or explicit modifier."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:weavesInto a owl:ObjectProperty ;
    rdfs:label "weaves Into"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:domain va:Aspect ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:BodySegment ;
    skos:definition "Links an Aspect to the BodySegment(s) where its concern realization is woven into the SoftwareUnit body."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:wiringImpliesComponent a owl:ObjectProperty ;
    rdfs:label "wiring implies component"@en ;
    dcterms:source "Wire-First-P1 simulation, Decision 2 option (promote selected)." ;
    rdfs:domain va:Wiring ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/3.2.3> ;
    rdfs:range va:ComposableUnit ;
    skos:definition "For a legal Wiring, identifies a Component (port owner) that must co-occur with this Wiring in any Assembly that includes it. Materialised by Phase P1.2 of wire-first-constraint-propagation-P1."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:writesAttribute a owl:ObjectProperty ;
    rdfs:label "writes attribute"@en ;
    dcterms:source "v4.1.0 §G; positioning note v1.1 §5a.2 mutator patterns."@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Attribute ;
    skos:definition "A Method writes to a specific Attribute (of self or of another unit reachable through parameters). Multi-valued; supports the MutatesMember classification and downstream 'which methods mutate X?' queries."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:AbstractFeature a owl:Class ;
    rdfs:label "Abstract Feature"@en ;
    dcterms:source "Specification v2.0 §2.1 Definition 2.4 and §4.1–4.2 detection rules."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Feature ;
    skos:altLabel "Soyut Unsur"@tr ;
    skos:definition "A Feature that does not provide a responsibility-fulfilling definition at its containing SoftwareUnit. Method-features: decorated with @abstractmethod/@abc.abstractmethod/@abstractproperty, or body reducible to abstract body forms. Attribute-features: declared without initializing value. An abstract Feature may itself be a SoftwareUnit (an abstract method declares a signature); its abstractness concerns its unfulfilled contract with its container, not its internal structure."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:AdditionOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Addition Operator"@en,
        "Addition operator (+)"@en ;
    va:hasAlgebraicProperty "Associative",
        "Commutative",
        "Idempotent",
        "Identity" ;
    va:hasIdentityElement "∅" ;
    va:isAssociative true ;
    va:isCommutative true ;
    va:operatorPrecedence "2"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "+" ;
    va:thesisSection "§2.2.6.1 eq. 2.28; Table 2.5 level 2; Table 2.6 row '+'" ;
    va:variantSemantics "product" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.28; Tablo 2.5 precedence 2; Tablo 2.6 properties",
        "Real, disclosed redesign (owner, 2026-09-22): '+' is reserved exclusively for EntitySet-level unification (when the operands are themselves sets/groups), not individual-element co-inclusion -- confirmed by this operator's own thesis text below ('introduces both operands into the SAME ENTITY SET', not merely 'both present') and its own already-declared variantSemantics 'union'. Unconditional element-level co-inclusion of two named features is formally redundant with nested Mandatory statements joined by ',' (verified directly: 'mandatory a mandatory b' produces the identical single admissible variant a real Addition-of-two-elements would), including the conditional case (Optional's own body already nests further statements, so 'if X chosen, a and b both follow' needs no '+' either). This session's own C24 detection calculus (tuple-unpack co-inclusion, renamed from C16) targeted this element level -- a real, honest re-scoping is needed to align it with the operator's own, higher, entity-set level; not yet done, disclosed as open work, not silently left."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Ekleme"@tr ;
    skos:definition "Thesis eq. 2.28: (a + b) = {a, b | a ∈ F ∧ b ∈ F}. Co-inclusion of two elements in the feature space. Binary; introduces both operands into the same entity set."@en ;
    skos:example "`(a + b)`: thesis eq. 2.28 produces a single variant V(a, b) where both a and b co-occur."@en ;
    skos:changeNote "3.2.7: Idempotent added (a + a = a): thesis Table 2.6, owner decision 5b (va:Decision_SubtractionRevisit_2026_09_25), and measured. Because Addition is idempotent it has no inverse (decision 5b), so 'Inverse' stays absent although Table 2.6 lists a + !a = empty. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C3 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    skos:changeNote "Owner, 2026-09-27 and 2026-09-28 (va:Decision_OwnerAnswers_2026_09_27, va:Decision_OwnerClarification_2026_09_28): operators are generic -- each has one meaning, the one its ontology rule states (02-shacl-safeguards/variant_algebra_operator_rules_v1_0_0.ttl), whatever its operands stand for; a named element is the one-element case. (3.2.8; corrected in 3.2.9, which had named the Python definitions evaluator as the semantics.) Addition is therefore one operation, union of its operands (eq. 2.28; the rule co-includes its operands), with named elements as the one-element case. The earlier source note reserving '+' for entity-set unification is superseded as a restriction of meaning; what it settled is notation: a mandatory feature is written as a bare name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Application a owl:Class ;
    rdfs:label "Application"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:altLabel "Uygulama"@tr ;
    skos:definition "A top-level software system composed of smaller units. Ψ-element."@en ;
    skos:example "A Django project's top-level package (e.g., `myproject/`) containing settings, urls, and WSGI entry points is an Application-level Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CartesianOperator a va:AlgebraicOperator,
        va:Operator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Cartesian Product Operator"@en,
        "Cartesian Product operator (*)"@en ;
    va:hasAlgebraicProperty "Associative",
        "Commutative" ;
    va:hasIdentityElement "∅" ;
    va:isAssociative true ;
    va:isCommutative true ;
    va:operatorPrecedence "3"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "*" ;
    va:thesisSection "§2.2.6.3 eq. 2.30-2.31; Table 2.5 level 3; Table 2.6 row '*'" ;
    va:variantSemantics "product" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.30–2.31; Tablo 2.5 precedence 3; Tablo 2.6"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Çarpma"@tr ;
    skos:changeNote "Owner, 2026-10-14 11:59 (UTC+3), VAF-WI-227: the product between expressions is built in the operator rules 8.0.0 (02-shacl-safeguards/variant_algebra_shapes_v1_3_3.ttl, file-module variant_algebra_operator_rules_v8_0_0.ttl). A * B joins one set of each side as + does and drops a pair whose features are partners that exclude each other (va:excludesPartner, symmetric); (a $ b) * (c $ d) gives ac, ad, bc, bd (Figure A.8). Association, commutation and idempotence (a * a = a) hold under the rules; six distributivity laws over the product or the division fail and are recorded as corrections (VAF-WI-120). Until then a statement over it was reported as not evaluable."@en ;
    skos:definition "Thesis eq. 2.30–2.31: (a * b) — Cartesian product over feature sets. A × B = {(a,b) : a ∈ A ∧ b ∈ B}. Generates all pairings."@en ;
    skos:example "`(A * B)`: thesis eq. 2.30–2.31 produces all ordered pairs (a, b) where a ∈ A, b ∈ B. Enables n × m variant generation from two sets."@en ;
    skos:changeNote "3.2.7: citation corrected. Thesis Table 2.6 also gives an inverse (a * / a = empty) and idempotence (a * a = a); they are not asserted here because which level '*' acts at (partner exclusion between features, or product between variant sets) waits on the owner (va:Decision_OperatorLevels_2026_09_27). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C1 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    skos:changeNote "Owner, 2026-09-27 and 2026-09-28 (va:Decision_OwnerAnswers_2026_09_27, va:Decision_OwnerClarification_2026_09_28): operators are generic -- each has one meaning, the one its ontology rule states (02-shacl-safeguards/variant_algebra_operator_rules_v1_0_0.ttl), whatever its operands stand for; a named element is the one-element case. (3.2.8; corrected in 3.2.9, which had named the Python definitions evaluator as the semantics.) Cartesian product is therefore one operation: over operation sets as in eq. 2.31, and over two named elements as in eq. 2.30. 'excludespartner' (D6) prunes pairs from the product. This replaces the 3.2.7 note that left the level to the owner. Thesis Table 2.6's inverse (a * / a = ε) and idempotence (a * a = a) are not asserted until they are measured under the ontology's rules."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ComputationalComplexity a owl:Class ;
    rdfs:label "Computational Complexity"@en ;
    dcterms:source "Blueprint v3.0.4 lock #3; SEN4012 (Analysis of Algorithms — efficiency)"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:StructuralConcept ;
    skos:altLabel "Hesaplama Karmaşıklığı"@tr ;
    skos:definition "An operator's worst-case time complexity, expressed as a Big-O term. Examples: O(1), O(n), O(n²), O(n log n). Used by the synthesis engine to choose efficient operator orderings. Per blueprint v3.0.4 lock #3 (efficiency commitment, SEN4012 grounding)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Concern a owl:Class ;
    rdfs:label "Concern"@en ;
    dcterms:source "Altunel 2013 §2.2.1"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "İlinti"@tr ;
    skos:definition "A concern (in the AOSD sense) to which an Aspect is bound. Referenced by thesis §2.2.1 preceding eq. 2.13."@en ;
    skos:example "Cross-cutting logging is a Concern; Aspects address this Concern by weaving logging code into many Methods."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ConcreteFeature a owl:Class ;
    rdfs:label "Concrete Feature"@en ;
    dcterms:source "Specification v2.0 §2.1 Definition 2.3."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Feature ;
    skos:altLabel "Somut Unsur"@tr ;
    skos:definition "A Feature that provides a responsibility-fulfilling definition at its containing SoftwareUnit. For method-features of a class in Python: body is not reducible to one of the abstract body forms (pass, raise NotImplementedError, lone literal return, Ellipsis stub, docstring alone). For attribute-features: initialized at declaration. Concreteness is a property of a Feature in its role as a member, independent of whether the Feature is itself a SoftwareUnit with its own internal feature set."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ConfidenceLevel a owl:Class ;
    rdfs:label "Confidence Level"@en ;
    dcterms:source "v4.2.0 §B."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Güven Düzeyi"@tr ;
    skos:definition "A named confidence level applicable to facts in an application ontology. Represents how strongly the evidence supports the fact, independent of the fact's truth. Members are named individuals enumerating the levels (Certain, High, Medium, Low, Speculative). Facts derived from deterministic Tier-1 calculi on formal artifacts typically carry High or Certain confidence; facts derived from Tier-5 probabilistic extraction on natural-language artifacts typically carry Medium or Low."@en ;
    skos:scopeNote "Intentional root primitive. ConfidenceLevel is annotation metadata, not a SoftwareUnit or Artifact. Orthogonal to the existing va:dependencyConfidence datatype property — ConfidenceLevel is a class with enumerated members supporting richer queries and SHACL constraints; dependencyConfidence is a string-valued property retained for compatibility."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DirectoryRole a owl:Class ;
    rdfs:label "Directory Role"@en ;
    dcterms:source "v4.1.0 §I; positioning note v1.1 §5a.2 directory organization."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Dizin Rolü"@tr ;
    skos:definition "A role classification derived from a file's location within a project's directory structure. Roles include: 'model' (in models/), 'view' (in views/, templates/), 'controller' (in controllers/), 'service' (in services/), 'test' (in tests/, spec/), 'utility' (in utils/, helpers/), 'config' (in config/, settings/), 'migration' (in migrations/, db/migrate/). Language-agnostic class; language/framework conventions populate via calculi."@en ;
    skos:scopeNote "Intentional root primitive. Directory roles are heuristic — some projects organize by feature rather than by layer. Calculi should emit with appropriate confidence annotations."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:EntitySet a owl:Class ;
    rdfs:label "Entity Set"@en ;
    dcterms:source "Altunel 2013 §2.2.4.1 eq. 2.20–2.21"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:AlgebraicStructure ;
    skos:altLabel "Varlık Kümesi"@tr ;
    skos:definition "Thesis eq. 2.20: VK(ω) = {f_1, f_2, ..., f_n}. An intermediate structure produced during variant generation; a set of elements on which a single operation ω acts. Directly convertible to a Variant (thesis eq. 2.21)."@en ;
    skos:example "Thesis eq. 2.20: VK(ω) = {f₁, f₂, f₃} — the set of feature symbols on which operation ω acts. Directly convertible to Variant V(f₁, f₂, f₃)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Interface a owl:Class ;
    rdfs:label "Interface"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8; design decision Sprint S-A"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:altLabel "Arayüz"@tr ;
    skos:definition "A named declaration of operations that a software unit exposes or requires (thesis §2.2.1 Ψ). Superclass of va:Contract. Retained per user directive so that existing thesis references to Arayüz remain first-class citizens."@en ;
    skos:example "`class Logger(Protocol): def log(self, msg: str) -> None: ...` — a Python Protocol (PEP 544) declaring an Interface Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:LifecyclePhase a owl:Class ;
    rdfs:label "Lifecycle Phase"@en ;
    dcterms:source "v4.1.0 §F."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Yaşam Döngüsü Aşaması"@tr ;
    skos:definition "A named phase in a unit's lifecycle (init, active, suspended, destroyed, etc.). Lifecycle-participating methods (setUp/tearDown, __enter__/__exit__, open/close, start/stop) are detected and linked to the phases they implement."@en ;
    skos:scopeNote "Intentional root primitive. Complementary to Protocol — many lifecycles are also protocols (ContextManager pairs __enter__/__exit__), but lifecycle phases may exist without being formal protocols."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:NameTerm a owl:Class ;
    rdfs:label "Name Term"@en ;
    dcterms:source "v4.1.0 §A; positioning note v1.1 §5a.2 naming."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SemanticMarker ;
    skos:altLabel "Ad Terimi"@tr ;
    skos:definition "A lexical term extracted from a parsed name. Camel-case and snake-case names decompose into sequences of terms (e.g., 'UserAuthenticationService' decomposes to terms [user, authentication, service]; 'get_user_by_id' decomposes to [get, user, by, id]). Terms are useful for domain-vocabulary analysis and for cross-unit similarity measures."@en ;
    skos:example "Class 'HTTPBasicAuth' decomposes to NameTerm individuals for 'http', 'basic', 'auth' (the parser recognizes acronym boundaries)."@en ;
    skos:scopeNote "Intentional root primitive. NameTerm is a lexical unit, not a SoftwareUnit or Feature. It annotates names to expose their constituent terms for further analysis."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:NamingPattern a owl:Class ;
    rdfs:label "Naming Pattern"@en ;
    dcterms:source "v4.1.0 §A; positioning note v1.1 §5a.2."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SemanticMarker ;
    skos:altLabel "Adlandırma Örüntüsü"@tr ;
    skos:definition "A recognized pattern in a name that assigns a structural or behavioral role. Patterns include getter (get_X, getX), setter (set_X, setX), validator (validate_X, is_valid_X), handler (handle_X, on_X), factory (create_X, make_X, build_X, X_factory), accessor (X_of_Y), mutator (X_to_Y), predicate (is_X, has_X, can_X), lifecycle (init_X, destroy_X, open_X, close_X, start_X, stop_X), test (test_X, X_test). Patterns surface behavioral-role information from naming conventions."@en ;
    skos:example "Method 'handle_401' matches the handler pattern; 'is_valid_password' matches the predicate pattern; 'get_user_by_email' matches the getter pattern."@en ;
    skos:scopeNote "Intentional root primitive. NamingPattern is a classification tag, not a SoftwareUnit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:OptionalOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Optional Operator"@en,
        "Optional operator ([ ])"@en ;
    va:hasAlgebraicProperty "Idempotent" ;
    va:operatorPrecedence "6"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "[]" ;
    va:thesisSection "§2.2.6.7 eq. 2.36; Table 2.5 level 6" ;
    va:variantSemantics "projection" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.36; Tablo 2.5 precedence 6"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Opsiyonlu"@tr ;
    skos:definition "Thesis §2.2.6.7, eq. 2.36: [a] = {a | a ∈ F1 ∨ ∅ ∈ F2}. The feature may or may not appear."@en ;
    skos:example "`Car.GPS` declared optional: variants may include or exclude GPS. Thesis eq. 2.36 [a] = {a | a ∈ F1 ∨ ∅ ∈ F2}."@en ;
    skos:changeNote "3.2.7: citation corrected (§2.3 is the thesis's system analysis). 'Idempotent' ([[a]] = [a]) is not in thesis Table 2.6; it holds under the ontology's reading (measured). Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_A6 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:PolymorphismGroup a owl:Class ;
    rdfs:label "Polymorphism Group"@en ;
    dcterms:source "Specification v1.1 §2.6 Definition 2.9; v2.0 re-typing as aggregate SoftwareUnit."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Çok-biçimlilik Grubu"@tr ;
    skos:definition "An aggregate SoftwareUnit emergent from canonical-signature match across a universe of SoftwareUnits. Members are (Unit, Feature) pairs; all member features share the same canonical signature. Non-trivial when it has at least two members. Explicitly declared if any member feature is abstract and its owning unit is a Template; otherwise implicit (duck-typed)."@en ;
    skos:example "PG((__call__, arity=1)) across AuthBase, HTTPBasicAuth, HTTPProxyAuth, HTTPDigestAuth — explicitly declared by AuthBase's abstract __call__."@en ;
    skos:scopeNote "Aggregate SoftwareUnit. Its feature set is the projection of member features onto the shared canonical signature. Unlike Component and ComponentTemplate (which contain their features as direct members), a PolymorphismGroup's features are shared across its member-pairs' origin units."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SideEffectClass a owl:Class ;
    rdfs:label "Side Effect Class"@en ;
    dcterms:source "v4.1.0 §G; positioning note v1.1 §5a.2 side-effect signatures."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Yan Etki Sınıfı"@tr ;
    skos:definition "A coarse static classification of a Method's effects: 'pure-candidate' (no writes, no I/O, no exceptions raised), 'mutates-local' (writes only local variables), 'mutates-member' (writes self's attributes), 'performs-io' (network, file, stdin/stdout, database), 'raises' (may raise exceptions), 'concurrent' (uses threading/asyncio/multiprocessing). A method may carry multiple classifications ('mutates-member' AND 'performs-io')."@en ;
    skos:scopeNote "Intentional root primitive. Static approximation: 'pure-candidate' is necessary but not sufficient for true purity (transitive calls may introduce effects). Members are enumerated below as individuals."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:StructuralOperator a owl:Class ;
    rdfs:label "Structural Operator"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    owl:deprecated true ;
    skos:definition "Superclass for operators that build higher-level structures from software units (Composition ⊕). Real, disclosed state, 2026-09-21: this group currently has zero active (non-deprecated) rdf:type members -- its only historical member, va:CompositionOperator, is owl:deprecated true (v3.2.0, per blueprint v3.0.4 lock #5b: 'a non-thesis extension... not in the lock #5b twelve-leaf enumeration'). Not a defect -- a decided, disclosed state, found while processing a real cross-session finding about this operator taxonomy."@en ;
    skos:example "InverseOperator `!`, CompositionOperator `⊕` — operators that change structure rather than select variants."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SuperComponent a owl:Class ;
    rdfs:label "Super-component"@en ;
    dcterms:source "Altunel 2013 Terms List (Alt-bileşen); Sprint S-A thesis extension"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Component ;
    skos:definition "A Component that was produced by the composition operator ⊕ from two or more sub-components. Thesis §2.2 mentions 'Alt-bileşen' (Sub-component) in the Terms List; this class names the converse. Super-components are themselves Components and can be composed further."@en ;
    skos:example "`PaymentSystem = PaymentProcessor ⊕ AuditLogger` — a SuperComponent containing both sub-components with one wiring from PaymentProcessor's audit_out port to AuditLogger's audit_in port."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:realizes a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    dcterms:source "Specification v1.1 §2.5 Definition 2.8."@en ;
    rdfs:domain va:SoftwareUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Variant ;
    skos:altLabel "gerçekleştirir"@tr ;
    skos:definition "Relates a SoftwareUnit U to a Variant V of a Component Template T, asserting that U provides concrete features matching every abstract feature in V by canonical-signature match. Relation, not operator: ten operators operate on feature expressions within a unit; realization operates across units."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Component a owl:Class ;
    rdfs:label "Component"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.9"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature ;
    skos:altLabel "Bileşen"@tr ;
    skos:definition "A software component as defined by thesis eq. 2.9: C = ⟨F_c, R_c⟩, a feature vector and a relation vector over those features. The primary unit of variant generation."@en ;
    skos:example "A Component `C = ⟨F_c, R_c⟩` where F_c = {Engine, Bluetooth, GPS, USBPort} and R_c declares mandatory/optional/dependency relations (thesis eq. 2.9)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Contract a owl:Class ;
    rdfs:label "Contract"@en ;
    dcterms:source "Sprint S-A thesis extension; informed by Python typing.Protocol and component-based SE port specifications (TinyOS, ROS, Fractal)"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Interface ;
    skos:definition "A named interface specification declaring a set of operations that must be supported by a value flowing through a port. Language-agnostic: does not rely on type systems. Subtype of va:Interface — retained alongside Interface per user directive."@en ;
    skos:example "`AuditRecordContract` declaring operations {log_record(1 param), flush(0 params)}. Both the provided port and required port reference this Contract for the wiring to be valid."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Convergence a owl:Class ;
    rdfs:label "Convergence"@en ;
    dcterms:source "v4.2.0 §D."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Uyum"@tr ;
    skos:definition "An observation that the same structural fact is supported by multiple independent Artifacts. Produced by reconciliation calculi (Tier-4). Strengthens confidence in the fact: when code, tests, and documentation all agree that method X exists with signature S, convergence annotation records the agreement. Convergence is distinct from redundancy — the fact exists once in the ontology but has multiple derivedFromArtifact links."@en ;
    skos:scopeNote "Intentional root primitive. Convergence is a reconciliation-annotation class, tracked as first-class so queries can surface high-convergence (well-corroborated) vs. single-source facts."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Divergence a owl:Class ;
    rdfs:label "Divergence"@en ;
    dcterms:source "v4.2.0 §D."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Uyumsuzluk"@tr ;
    skos:definition "An observation that different Artifacts assert conflicting structural facts. Produced by reconciliation calculi (Tier-4). Surfaces documentation drift, test/code mismatch, specification/implementation gaps. A Divergence instance identifies the conflicting Artifacts, the conflicting facts, and the nature of the disagreement (e.g., 'code says method has 3 parameters; OpenAPI spec says 2'). First-class queryable."@en ;
    skos:scopeNote "Intentional root primitive. Divergence is high-value output: the places where artifacts disagree often identify the most important issues (documentation out of date, tests testing old behavior, spec not implemented)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ExternalSymbol a owl:Class ;
    rdfs:label "External Symbol"@en ;
    dcterms:source "Sprint S-H; variant modeling under partial source availability."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Method ;
    skos:definition "A Ψ element representing an imported name whose source code is not available to the Workbench (not stdlib, not among the loaded files). Created by the ExternalSymbolCalculus (C9) when a method calls an imported name that cannot be resolved to a loaded file. Carries the import path in va:importPath. External symbols participate in Dependency relationships like any other Ψ element, but their internal structure is opaque — they are treated as atomic prerequisites."@en ;
    skos:example "If class HTTPDigestAuth calls parse_dict_header() which is imported from .utils, and utils.py is NOT loaded, C9 creates :parse_dict_header a va:ExternalSymbol ; va:importPath \"requests.utils\" ; va:isExternalSymbol true ."@en ;
    skos:scopeNote "External symbols are evidentially weaker than loaded-and-parsed sibling-file calls (C8). Accepting an C9 suggestion is a designer's judgment that the imported name represents a real variant-relevant dependency, given only the import statement as evidence."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Gap a owl:Class ;
    rdfs:label "Gap"@en ;
    dcterms:source "v4.2.0 §D."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Concept ;
    skos:altLabel "Boşluk"@tr ;
    skos:definition "An observation that a fact expected to be present in an Artifact of a given type is absent. Produced by reconciliation calculi (Tier-4). Examples: code has a method with no corresponding test (coverage gap); an OpenAPI endpoint has no implementing handler (specification gap); a requirement has no realizing code (traceability gap). Gap instances identify the expected fact, the Artifact type where it should appear, and the reconciliation rule that expected it."@en ;
    skos:scopeNote "Intentional root primitive. Gap is orthogonal to Convergence and Divergence: absence of evidence rather than presence of conflict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.14"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Parametre"@tr ;
    skos:definition "A formal parameter: ⟨ParameterType, ParameterName⟩ (thesis eq. 2.14). Member-of-Signature."@en ;
    skos:example "`⟨ParameterType, ParameterName⟩ = ⟨float, amount⟩` — thesis eq. 2.14; one element of a method's parameter list."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:TestArtifact a owl:Class ;
    rdfs:label "Test Artifact"@en ;
    dcterms:source "v4.1.0 §I; positioning note v1.1 §5a.2 tests."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Test Yapıtı"@tr ;
    skos:definition "A SoftwareUnit (class or method) identified as a test, per framework convention: pytest test_* functions, unittest.TestCase subclasses, @pytest.mark.* decorated items, methods in Jest describe/it blocks, etc. A TestArtifact typically makes assertions about a unit-under-test, which is linked via va:testsUnit."@en ;
    skos:scopeNote "Subclass of SoftwareUnit — test methods and test classes remain SoftwareUnits; this class marks their role."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ValueDomain a owl:Class ;
    rdfs:label "Value Domain"@en ;
    dcterms:source "v4.1.0 §E."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SemanticMarker ;
    skos:altLabel "Değer Alanı"@tr ;
    skos:definition "An enumerated set of permissible values for a typed attribute or parameter. Typically corresponds to an Enum declaration in source: 'class Status(Enum): ACTIVE = 1; INACTIVE = 2' produces a ValueDomain named 'Status' with two members. Algebraically, the members of a ValueDomain are mutually exclusive (at most one value at a time), which aligns with the Exclusion operator."@en ;
    skos:example "Python Enum classes, Java enum types, TypeScript string/numeric enums, C enum declarations all produce ValueDomains."@en ;
    skos:scopeNote "Intentional root primitive. A ValueDomain is vocabulary metadata, not a SoftwareUnit (though in Python, an Enum class is also a class and would be typed both as Component and as ValueDomain when recognized)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:AlgebraicStructure a owl:Class ;
    rdfs:label "Algebraic Structure"@en ;
    dcterms:source "Altunel 2013 §2.2.4"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Superclass for the auxiliary set structures of thesis §2.2.4: EntitySet, VariantSet, OperationSet, EntityPair."@en ;
    skos:example "EntitySet, VariantSet, OperationSet, EntityPair — the auxiliary structures of thesis §2.2.4, all subclasses of AlgebraicStructure."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Aspect a owl:Class ;
    rdfs:label "Aspect"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8, eq. 2.13"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature ;
    skos:altLabel "Kesit"@tr ;
    skos:definition "A cross-cutting concern module, as used in Aspect-Oriented Programming. Ψ-element. Thesis eq. 2.13 defines Body as a set of Aspects."@en ;
    skos:example "A logging `around` advice in AspectJ (`@Around('execution(* com.app.*(..))')`) that runs before and after every application method is an Aspect."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:BindingStyle a owl:Class ;
    rdfs:label "Binding Style"@en ;
    dcterms:source "Sprint S-D; Bruneton et al. 2002"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:definition "Enumeration class for composition binding styles. Two individuals: DirectBinding, IndirectBinding."@en ;
    skos:example "`va:DirectBinding` applies when the composition declares va:Wiring triples. `va:IndirectBinding` applies when sub-components communicate only through the SuperComponent's own methods."@en ;
    skos:scopeNote "NOT in Altunel 2013 thesis as a first-class concept; added by Sprint S-D to disambiguate composition sub-cases grounded in Bruneton 2002 structural composition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CompositionOperator a owl:Class ;
    rdfs:subClassOf va:StructuralOperator ;
    rdfs:label "Composition Operator"@en ;
    va:hasIdentityElement "∅" ;
    va:isAssociative true ;
    va:isCommutative false ;
    va:operatorPrecedence "0"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "⊕" ;
    va:requiresEnumerationStrategy "wire-first-constraint-propagation-P1" ;
    dcterms:source "Altunel 2013 §1.4.5 and §1.4.5.5 (citing Bruneton et al. 2002; corrected in 3.2.7 from '§1137', a line number); Terms List (Birleştirme); Sprint S-A thesis extension; Sprint S-D semantic correction."@en ;
    rdfs:comment "Deprecated in v3.2.0 per blueprint v3.0.4 lock #5b: CompositionOperator is a non-thesis extension and is not in the lock #5b twelve-leaf enumeration. Process semantics moved to va:Assembly (lock #7). Backward-compat: existing analyzed graphs that reference va:CompositionOperator continue to resolve."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:StructuralOperator ;
    owl:deprecated true ;
    skos:altLabel "Birleştirme"@tr ;
    skos:definition "Thesis extension. Binary operator that produces a SuperComponent via CONTAINMENT of two ComposableUnits. Per Bruneton et al. (2002) and thesis §1137, structural composition is defined by containment (içerme) and binding (bağlama) relations. Binding is OPTIONAL — a composition may have zero wirings (indirect binding, sub-components coordinated by super-component methods) or one-or-more wirings (direct binding via ports/contracts). Corrected in v3.0.7: earlier v3.0.0 incorrectly implied wiring was mandatory; the thesis view is that composition = containment first, binding as refinement."@en ;
    skos:example "`Car ⊕ Engine ⊕ Transmission` — containment composition; sub-components coordinated via Car's start() and drive() methods. No wirings needed — this is IndirectBinding. `PaymentProcessor ⊕ AuditLogger` — containment + wiring from provided audit_out to required audit_in. This is DirectBinding."@en ;
    skos:note "Commutativity: in general A ⊕ B ≠ B ⊕ A because wirings (when present) are directional. Associativity: (A ⊕ B) ⊕ C = A ⊕ (B ⊕ C) provided no wiring spans across the regrouping. BindingStyle: see va:bindingStyle property for DirectBinding vs IndirectBinding declarations. Distributivity over other operators: partially open; see BlindSpots §2."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    dcterms:source "v3.2.2 hygiene: top-level taxonomic group introduced to satisfy REDO S-STRUCT-2 isolated-class warning. Groups conceptually-related value/enum/structural classes per Altunel (2013) thesis Chapters 2 and 6 conventions." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Generic top-level abstraction in the Variant Algebra ontology. Used as parent for classes that don't fit a more specific top-level category. Per Altunel (2013) thesis convention, used to maintain an explicit subClassOf chain to owl:Thing for SHACL S-STRUCT-2 compliance."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ContractOperation a owl:Class ;
    rdfs:label "Contract Operation"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:CompositionArtefact ;
    skos:definition "An operation declared by a Contract: name plus positional-parameter count. Does NOT include types (language-agnostic). Type hints in source code may be recorded as advisory metadata via rdfs:comment."@en ;
    skos:example "`log_record(record)` declared as ContractOperation with va:operationName 'log_record' and va:positionalParamCount 1."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DecoratorRole a owl:Class ;
    rdfs:label "Decorator Role"@en ;
    dcterms:source "v4.1.0 §C. Complements v4.0.0's DecoratorRoleHeuristic (H5) with typed output."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Dekoratör Rolü"@tr ;
    skos:definition "A role assigned to a Feature by a decorator or annotation. Examples: HttpRoute (from @app.route), Property (from @property), StaticMethod (from @staticmethod), ClassMethod (from @classmethod), TestFixture (from @pytest.fixture), TestCase (from @pytest.mark), DataClass (from @dataclass), Overload (from @overload), Retry (from @retry). Language-agnostic: Python decorators, Java annotations, C# attributes, TypeScript decorators all map onto this class."@en ;
    skos:scopeNote "Intentional root primitive. Individual roles are instances of this class, enumerable per language/framework. The specific roles (HttpRoute, Property, etc.) may be declared as separate classes in future minor versions as practice surfaces them; for now, type via role-name strings."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:OperatorApplication a owl:Class ;
    rdfs:label "Operator Application"@en ;
    dcterms:source "Altunel, Y. (2013). An Algebraic Approach for Generation of Software Component Variants. PhD thesis, İstanbul Üniversitesi, Computer Engineering. Advisor: Prof. Dr. A. Halim Zaim." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:StructuralConcept ;
    skos:definition "An instance of applying a specific operator to specific operands at a specific abstraction level. Records the dispatch (which operator) + operands + the resulting variant set. Added in v3.2.0 from v4.6.0 archive."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Protocol a owl:Class ;
    rdfs:label "Protocol"@en ;
    dcterms:source "v4.1.0 §D; positioning note v1.1 §5a.2 protocol participation."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Enumeration ;
    skos:altLabel "Protokol"@tr ;
    skos:definition "A named collection of feature signatures that together implement a known behavioral contract. A SoftwareUnit is said to participate in a Protocol when its feature set includes concrete features matching every signature in the Protocol's required-members set. Examples: ContextManager (Python: __enter__ + __exit__; C#: IDisposable), Iterator (__iter__ + __next__), Sequence (__getitem__ + __len__), Awaitable (__await__), Comparable (__lt__, __eq__, __hash__), Callable (__call__), Number-like (arithmetic dunders). Protocols are a specialization of the existing va:Interface class with a specific focus on duck-typed/structural membership."@en ;
    skos:scopeNote "Intentional root primitive. Protocol differs from Contract/Interface in that membership is implicit (via signature match) rather than explicit (via declaration). Related to PolymorphismGroup but narrower: Protocols are named, curated sets; PolymorphismGroups are discovered automatically."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    dcterms:source "Altunel 2013 eq. 2.9"@en ;
    rdfs:domain va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a Component or other ComposableUnit to a Feature in its feature vector F_c (thesis eq. 2.9)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Bilgi Notu"@tr ;
    skos:definition "A meta-annotation on a software unit. Ψ-element."@en ;
    skos:example "Python's `@dataclass` decorator applied to a class is an Annotation Ψ element."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Assembly a owl:Class ;
    rdfs:label "Assembly"@en ;
    va:requiresEnumerationStrategy "wire-first-constraint-propagation-P1" ;
    dcterms:source "Thesis L348/L687/L704/L728 (birleştirme); Bruneton 2002 (L1391/L1393); blueprint v3.0.4 lock #7"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf prov:Activity ;
    skos:altLabel "Birleştirme"@tr ;
    skos:definition "A process class representing the post-synthesis assembly of a Variant into a runnable Application — combining components, wiring ports/contracts, and producing target-language source. NOT an algebraic operator (must not be subClassOf va:Operator); a prov:Activity-style process class that uses operators and Realization links but is not itself algebraic. Thesis grounding: 'birleştirme' (assembly/composition) referenced at L348/L687/L704/L728; Bruneton 2002 component-assembly framework cited at L1391/L1393."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CompositionArtefact a owl:Class ;
    rdfs:label "Composition Artefact"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "Superclass for the structural artefacts of the composition apparatus (Port, ContractOperation, Wiring). These support the CompositionOperator but are not Operators themselves."@en ;
    skos:example "Port, ContractOperation, Wiring — structural artefacts that support CompositionOperator but are not themselves Operators."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:EventBinding a owl:Class ;
    rdfs:label "Event Binding"@en ;
    dcterms:source "v4.1.0 §F; positioning note v1.1 §5a.2 event and activation patterns."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Concept ;
    skos:altLabel "Olay Bağlama"@tr ;
    skos:definition "A relationship between an event source and a handler — established in source via a binding call (addEventListener, signal.connect, @app.route, @pytest.fixture, etc.). An EventBinding identifies the event type/route/signal, the source object (where applicable), and the handler Feature. Language-/framework-agnostic class; framework-specific patterns populate via calculi."@en ;
    skos:example "'button.clicked.connect(self.on_click)' produces an EventBinding with event 'clicked', source 'button', handler 'self.on_click'. '@app.route(\"/users\")' produces an EventBinding with event 'HTTP-request-to-/users', source 'app', handler the decorated method."@en ;
    skos:scopeNote "Intentional root primitive. EventBinding is a structural recording of an activation relationship detected at source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SemanticMarker a owl:Class ;
    rdfs:label "SemanticMarker"@en ;
    dcterms:source "v3.2.2 hygiene: top-level taxonomic group introduced to satisfy REDO S-STRUCT-2 isolated-class warning. Groups conceptually-related value/enum/structural classes per Altunel (2013) thesis Chapters 2 and 6 conventions." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Top-level group for classes representing linguistic/semantic annotations on software entities (NameTerm, NamingPattern, TypeReference, ValueDomain). Per Altunel (2013) Chapter 4, semantic markers carry meta-information about the lexical or type-level surface of code."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:StructuralConcept a owl:Class ;
    rdfs:label "StructuralConcept"@en ;
    dcterms:source "v3.2.2 hygiene: top-level taxonomic group introduced to satisfy REDO S-STRUCT-2 isolated-class warning. Groups conceptually-related value/enum/structural classes per Altunel (2013) thesis Chapters 2 and 6 conventions." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Top-level group for classes representing structural elements of analyzed software (BodySegment, CanonicalSignature, ComputationalComplexity, OperatorApplication). Per Altunel (2013) §6, structural concepts are non-feature elements that participate in algebraic relationships."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DependencyOperator a va:Operator,
        va:VariabilityOperator,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dependency Operator"@en,
        "Dependency operator (< >)"@en ;
    va:hasAlgebraicProperty "Idempotent" ;
    va:isAssociative false ;
    va:isCommutative false ;
    va:operatorPrecedence "4"^^xsd:nonNegativeInteger ;
    va:operatorSymbol "<",
        ">" ;
    va:thesisSection "§2.2.6.8 eq. 2.37-2.38; Table 2.5 level 4; Table 2.6 row '<,>'" ;
    va:variantSemantics "restriction" ;
    dcterms:source "v3.0.7 + v4.6.0 operator punning.",
        "Altunel 2013 eq. 2.37–2.38; Tablo 2.5 precedence 4"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    skos:altLabel "Bağımlılık"@tr ;
    skos:definition "Thesis eq. 2.37, as the owner ruled on 2026-09-28 (va:Decision_DependencyPresence_2026_09_28): (a < b) gives {{a, b}} -- a with b; a dependency never makes a name optional. Optional presence comes from brackets: [a] < b gives {{}, {a, b}} ('{} < b' is {}), and (a < b) | b gives {{a, b}, {b}}, the set eq. 2.37 prints for (a<b). The keyword 'a requires b' ('if a then b') is the shorthand of [(a < b) | b]. Directional (< left-depends-on-right, > right-depends-on-left); thesis eq. 2.38: a < b ≡ b > a."@en ;
    skos:example "Navigation < GPS: variants containing Navigation must also contain GPS."@en ;
    skos:changeNote "3.2.7: Associative withdrawn and Idempotent added, by measurement. Thesis Table 2.6 states a<(b<c) = (a<b)<c, but under the ontology's reading a < (b < c) gives {c}, {a, c}, {b, c}, {a, b, c} while (a < b) < c gives {c}, {b, c}, {a, b, c} (both readings agree; 12-experiments/thesis_laws_check_v1_0_37.py). a < a = a holds. Non-commutative, as the thesis states. Citation corrected from Table 2.7 to Table 2.6. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C3 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DetectionRecord a owl:Class ;
    rdfs:label "Detection Record"@en ;
    dcterms:source "Sprint S-G aggregate-provenance support."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:definition "A bundle of calculus provenance fields (calculus individual, source line, rationale, optional conditional flag). Used as list members of va:derivedFromDetections when a DependencyOperator aggregates multiple pairwise constituents under Figure 6.31 distribution rule. Each constituent pairwise edge that was merged into a set-to-set form contributes one DetectionRecord to the merged edge's provenance list."@en ;
    skos:example "A merged edge {__eq__, __call__} < {username, password} backed by four C1 detections at lines 86, 87, 95, 95 carries a va:derivedFromDetections list with four DetectionRecord blank nodes — one per constituent."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:VariabilityOperator a owl:Class ;
    rdfs:label "Variability Operator"@en ;
    dcterms:source "Altunel 2013 §2.1.4 (the element kinds that decide variation; corrected in 3.2.7 from §2.3, the system analysis)"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    owl:deprecated true ;
    skos:definition "Superclass for operators that govern variant admissibility at enumeration time (Mandatory, Optional, Exclusive, Or, Dependency, Repetition)."@en ;
    skos:example "MandatoryOperator, OptionalOperator, ExclusiveOperator, OrOperator, DependencyOperator, RepetitionOperator — all six govern how variants are generated from feature sets."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:AlgebraicOperator a owl:Class ;
    rdfs:label "Algebraic Operator"@en ;
    dcterms:source "Altunel 2013 §2.2.7.2 Tables 2.6–2.7"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Operator ;
    owl:deprecated true ;
    skos:definition "Superclass for operators that participate in algebraic manipulation (Addition, Subtraction, Cartesian, Division, Inverse, Intersection). Thesis Tables 2.6 and 2.7 specify their algebraic properties and distributive laws. Corrected 2026-09-21: the prose previously omitted Intersection, which was already a real, current, non-deprecated member (rdf:type va:AlgebraicOperator) -- found while processing a real cross-session finding, disclosed rather than silently fixed."@en ;
    skos:example "AdditionOperator `+`, SubtractionOperator `-`, CartesianOperator `*`, DivisionOperator `/` — all four perform set-algebraic manipulations on entity sets (thesis §2.2.4)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Attribute a owl:Class ;
    rdfs:label "Attribute"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.10"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Özellik"@tr ;
    skos:definition "A data member of a Class (thesis eq. 2.10): A = ⟨Visibility, Type, Name, InitialValue⟩. Member-of-Class, not independently composable."@en ;
    skos:example "`A = ⟨Visibility, Type, Name, InitialValue⟩ = ⟨public, int, retry_count, 3⟩` — thesis eq. 2.10 Attribute structural tuple."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CalculusPolicy a owl:Class ;
    rdfs:label "Calculus Policy"@en ;
    dcterms:source "v4.0.0 introduction; addresses the calculus-control gap identified during spec v2.0 design dialogue."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Concept ;
    skos:altLabel "Hesap İlkesi"@tr ;
    skos:definition "A configuration describing how a set of Calculi should be applied to a specific scope. A CalculusPolicy names which calculi are enabled, which are disabled, any scope constraints (e.g., 'H7 capped at closure depth 5'), and conflict-resolution preferences. Application ontologies may carry multiple CalculusPolicy individuals for different scopes (e.g., first-party code vs. third-party libraries)."@en ;
    skos:scopeNote "Intentional root primitive. CalculusPolicy is a configuration descriptor, not a SoftwareUnit or a Calculus itself. It references Calculi via enablesCalculus/disablesCalculus and applies to scopes via appliesToScope. Placing it under any existing class would obscure its role as an orthogonal configuration concept."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Method a owl:Class ;
    rdfs:label "Method"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.11; design decision Sprint S-A"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:altLabel "Metod"@tr ;
    skos:definition "A behavior member of a Class (thesis eq. 2.11): M = ⟨Visibility, ReturnType, Name, ParameterList, Body⟩. Member-of-Class, not composable (design decision: composing two methods to build a new one is not meaningful)."@en ;
    skos:example "`M = ⟨Visibility, ReturnType, Name, ParameterList, Body⟩ = ⟨public, bool, charge, [amount: float], 'self.balance -= amount; return True'⟩` — thesis eq. 2.11."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Port a owl:Class ;
    rdfs:label "Port"@en ;
    dcterms:source "Sprint S-A thesis extension; UML component-diagram convention"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:CompositionArtefact ;
    skos:definition "A declared connection point on a software unit. Has a direction (provides or requires) and references a Contract. Multiple ports per unit is allowed. UML-style: provided port = lollipop; required port = socket."@en ;
    skos:example "`PaymentProcessor.audit_out`: a Port with va:portDirection 'provided' and va:referencesContract AuditRecordContract."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:TypeReference a owl:Class ;
    rdfs:label "Type Reference"@en ;
    dcterms:source "v4.1.0 §B."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SemanticMarker ;
    skos:altLabel "Tür Referansı"@tr ;
    skos:definition "A reference to a named type (class, interface, union, primitive) that appears in source as an annotation on a Parameter, Attribute, or return position. Captures type information visible in source without requiring a formal type system. For container types (list[X], dict[K,V]), element types are captured as nested TypeReferences."@en ;
    skos:example "In 'def parse(text: str) -> Document', 'str' and 'Document' are TypeReferences. In 'cache: dict[str, User]', 'dict', 'str', 'User' are TypeReferences with 'dict' as the outer and the others as parameters."@en ;
    skos:scopeNote "Intentional root primitive. TypeReference is annotation metadata, not a SoftwareUnit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.17, eq. 2.18; design decision Sprint S-A"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:altLabel "Varyant"@tr ;
    skos:definition "A subset of a component's feature vector (thesis eq. 2.17): V_x = (f_1,...,f_i) where f_j ∈ C. Composable per design decision — composing variants produces a super-component with cardinality 1 (a concrete configuration)."@en ;
    skos:example "A specific configuration of the Car component with Engine=Electric, Bluetooth=on, GPS=omitted, USBPort count=2, produced by applying the component's relation operators."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Wiring a owl:Class ;
    rdfs:label "Wiring"@en ;
    dcterms:source "Sprint S-A thesis extension"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:CompositionArtefact ;
    skos:definition "A directed link from a provided Port to a required Port, both declared within sub-components of a CompositionOperator. Valid iff the two ports reference the same Contract. Wire direction follows UML data-flow convention: from provider to consumer."@en ;
    skos:example "`W_AuditFlow`: fromPort=PaymentProcessor.audit_out (provided), toPort=AuditLogger.audit_in (required), both referencing AuditRecordContract."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

# NOTE (v3.2.5 consolidation): the embedded <…/variant-algebra/3.2.3> owl:Ontology
# declaration that previously appeared here has been removed. It was a second
# owl:Ontology node sharing the variant-algebra identity inside a single file —
# an identity collision under OE Operating Discipline B4 (BP-D2 / BP-D7) and the
# source of a self-import (owl:imports <…/3.2.2>). The vocabulary it documented
# (va:assemblyHasWiring, va:isLegalWiring, va:wiringImpliesComponent,
# va:realisesAddition, va:realisesCartesianProduct) remains defined as classes/
# properties below; its CQ + decision provenance is preserved verbatim in the
# kit release-history ABox (vaf_ontology_kit_release_history_v1_0_0.ttl).

va:BodySegment a owl:Class ;
    rdfs:label "Body Segment"@en ;
    dcterms:source "Blueprint v3.0.4 lock #4 (two-layer behaviour: BodySegment + Aspect)"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:StructuralConcept ;
    skos:altLabel "Gövde Bölümü"@tr ;
    skos:definition "A contiguous span of source-code lines within a method body that performs one identifiable kind of work. Each Aspect (cross-cutting concern realization) is woven into one or more BodySegments. Deterministic key: (va:partOfBody, va:startLine, va:endLine). Thesis grounding: §2.2.2 eq. 2.13 (Aspect/Concern)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Calculus a owl:Class ;
    rdfs:label "Calculus"@en ;
    dcterms:source "v4.0.0 introduction; supersedes the heuristic terminology of v3.0.7."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "Hesap"@tr ;
    skos:definition "An algebraic-entailment rule that applies the calculus of the variant algebra to derive structural facts from explicit inputs. Calculi are deterministic: given the same inputs, they produce the same outputs. Not probabilistic. The term supersedes the v3.0.7 name 'DetectionHeuristic' which misrepresented deterministic algebra-grounded rules as guesswork. Individual calculi may be enabled or disabled by workbench configuration; output passes through proposal/promotion review before entering the authoritative ontology."@en ;
    skos:scopeNote "Intentional root primitive; supertype of four tier-subclasses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Enumeration a owl:Class ;
    rdfs:label "Enumeration"@en ;
    dcterms:source "v3.2.2 hygiene: top-level taxonomic group introduced to satisfy REDO S-STRUCT-2 isolated-class warning. Groups conceptually-related value/enum/structural classes per Altunel (2013) thesis Chapters 2 and 6 conventions." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Top-level group for value-enumeration classes (ConfidenceLevel, Convergence, Divergence, DecoratorRole, DirectoryRole, LifecyclePhase, SideEffectClass, Protocol). Members of an Enumeration are mutually exclusive named individuals representing fixed values."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:DetectionCalculus a owl:Class ;
    rdfs:label "Detection Calculus"@en ;
    dcterms:source "Sprint S-E; thesis §743 as grounding."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Calculus,
        va:ComposableUnit,
        va:Feature,
        va:SoftwareUnit ;
    skos:definition "A named rule that examines source code structure and proposes candidate Dependencies, Inheritance relations, or other constraint edges. Instances of this class document the rules the Workbench uses to auto-detect dependencies from Python AST analysis. Each accepted candidate dependency carries a va:detectedBy link to the calculus individual that proposed it."@en ;
    skos:example "va:AttributeUsageCalculus, va:MethodCallCalculus, va:InitDependencyCalculus — three calculi shipped in Workbench v4.3.0."@en ;
    skos:scopeNote "NOT in Altunel 2013 thesis as a first-class concept; added by Sprint S-E to make AST-based suggestion provenance a first-class ontological fact. The thesis's §743 'natural dependency between attribute and using method' is the semantic basis — calculi are just mechanical implementations of that principle."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:CanonicalSignature a owl:Class ;
    rdfs:label "Canonical Signature"@en ;
    dcterms:source "Specification v1.1 §2.2 Definition 2.5; refined v2.0."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:StructuralConcept ;
    skos:altLabel "Kurallı İmza"@tr ;
    skos:definition "A structured first-class entity representing the substitutability contract of a Feature. For method features in Python: name, arity (positional parameters excluding implicit receiver), ordered list of keyword-only parameter names, has_varargs flag, has_kwargs flag. For attribute features: name and declared type when annotated. Return types are excluded in Python (dynamic binding, duck typing) but included in statically-typed languages. Canonical Signature is metadata about Features, not a container of Features."@en ;
    skos:example "sig(HTTPBasicAuth.__call__) has name='__call__', arity=1, no kw-only params, no varargs, no kwargs. sig(AuthBase.__call__) is identical; features are signature-compatible and support polymorphic dispatch."@en ;
    skos:scopeNote "Intentional root primitive. Canonical Signature is structural metadata about Features, not a SoftwareUnit. It does not contain sub-features; it is the equivalence criterion by which Features are matched for realization and polymorphism purposes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Artifact a owl:Class ;
    rdfs:label "Artifact"@en ;
    dcterms:source "v4.2.0 §A; positioning note v1.2 §5b."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "Yapıt"@tr ;
    skos:definition "An inspectable artifact produced during the software life cycle that can be used as evidence for structural, behavioral, or semantic facts about the system. Artifacts include source code files, requirements documents, design specifications, test suites, API schemas, database definitions, configuration files, deployment manifests, log schemas, monitoring configurations, and development-process records (commits, issues, pull requests). Each Artifact has a type (which determines applicable calculi), a storage location or identifier, and an authored-by relationship where applicable."@en ;
    skos:example "The file 'requirements/user_authentication.md' is a RequirementsArtifact. The OpenAPI file 'api/v1/openapi.yaml' is an APISpecificationArtifact. The file 'tests/test_auth.py' is a TestArtifact. Commits in the Git history are DevProcessArtifacts."@en ;
    skos:scopeNote "Intentional root primitive. Artifact is orthogonal to SoftwareUnit: a Python source file is both a SoftwareUnit (it contains classes, methods — unit of composition) AND a SourceCodeArtifact (it is an inspectable evidence source). The cross-classification is intended."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:ComposableUnit a owl:Class ;
    rdfs:label "Composable Unit"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8; design decision Sprint S-A"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:definition "A software unit that may be an operand of the composition operator ⊕. Subclass of SoftwareUnit. Excludes units that appear only as members of other units (Method, Attribute, Parameter, Signature, Body, Literal), per design decision confirmed by thesis author."@en ;
    skos:example "`va:Component` and `va:Class` are ComposableUnits — they can be operands of ⊕. `va:Method` and `va:Attribute` are not."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:SoftwareUnit a owl:Class ;
    rdfs:label "Software Unit"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:comment "v3.2.4 scope note: va:SoftwareUnit is the root of the Ψ taxonomy. The VAF ontology models semantic units of composition and variation. Lexical/syntactic detail (keywords, operators-in-expressions, delimiters, whitespace) is the parser's concern and is NOT represented as VAF classes. Per v3.2.4 dual-typing patch: any SoftwareUnit subclass that has internal structure should be subClassOf both va:Feature (for nesting in larger units) and va:ComposableUnit (for its own internal decomposition). Terminals (Comment, Repetition, ExternalSymbol, Literal, BindingStyle) remain SoftwareUnit-only."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "Yazılım Varlığı"@tr ;
    skos:definition "A member of the thesis's element set Ψ — the vocabulary of software entities on which the algebra operates. Subclasses enumerate the Ψ elements from thesis §2.2.2 eq. 2.8."@en ;
    skos:example "A Python class `class PaymentProcessor: def charge(self, amount): ...` is a SoftwareUnit of type Class in the Ψ taxonomy."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.15"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:SoftwareUnit ;
    skos:altLabel "Nitelik"@tr ;
    skos:definition "A member of a component's feature vector (thesis eq. 2.15, feature space F). Features are carried-by units, not standalone composables. They are Φ-members in the algebra — the things elements 'have'."@en ;
    skos:example "A Python class attribute `self.retry_count: int = 3` is a Feature carried by its owning Class/Component in the feature vector F_c."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:Operator a owl:Class ;
    rdfs:label "Operator"@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "İşlem"@tr ;
    skos:definition "An algebraic operator in Λ, from the thesis's operation set Δ (eq. 2.8). Operates on elements in Ψ to produce new elements or structures."@en ;
    skos:example "Thesis Δ = {!, +, ',', -, |, $, *, /, #, <, >, {}, []} (eq. 2.8, 13 entries; the English translation drops the ','). In the ontology: ',' is a list separator (owner, 2026-09-26), {} and [] are the bracketed forms of Repetition and Optional, and Intersection, Replacement, Next and Sequence are added. `⊕` (composition) is deprecated."@en ;
    skos:changeNote "3.2.7: the operator set is named Δ as in the thesis, not Ω, with its 13 entries. Reconciled with the thesis on 2026-09-27 (VAF-WI-102; record va:Div_C9 in variant_algebra_thesis_reconciliation_v1_0_1.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

# links from the definitions and examples that name another term (VAF-WI-252)
va:CompositionOperator rdfs:seeAlso va:SuperComponent ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .
va:SuperComponent rdfs:seeAlso va:CompositionOperator ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .
va:CompositionArtefact rdfs:seeAlso va:CompositionOperator ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .
va:Signature rdfs:seeAlso va:ParameterList ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .
va:Method rdfs:seeAlso va:ParameterList ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .
va:PolymorphismGroup rdfs:seeAlso va:CanonicalSignature ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:hasVariantMember a owl:ObjectProperty ;
    rdfs:label "variant of the set"@en ;
    rdfs:domain va:VariantSet ;
    rdfs:range va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "A variant in the set (thesis eq. 2.22)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:hasEntitySetMember a owl:ObjectProperty ;
    rdfs:label "entity set of the set"@en ;
    rdfs:domain va:OperationSet ;
    rdfs:range va:EntitySet ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "An entity set that the operation can produce (thesis eq. 2.23)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

va:convertsToVariant a owl:ObjectProperty ;
    rdfs:label "variant the entity set converts to"@en ;
    rdfs:domain va:EntitySet ;
    rdfs:range va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "The variant that the entity set converts to directly (thesis eq. 2.21)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra> .

# ==== file variant_algebra_v3_extended_properties_v1_0_80.ttl ====
@prefix amod: <http://example.org/amod#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe: <http://example.org/ontology-engineering#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://example.org/vaf-consolidated/extended-properties> rdfs:label "VAF Extended Properties v1.0.0"@en ;
    dcterms:created "2026-09-21"^^xsd:date ;
    dcterms:identifier "variant_algebra_v3_extended_properties_v1_0_80" ;
    rdfs:comment "Real merger of 8 formerly-separate v3 properties files (code-analysis, deployment-calculus, general-bridge, operator, purpose-attribution, purpose-target-selection, rdodi-domain-translation, semantic-marker) -- 432 real content triples, verified equal to the sum of the 8 originals' real content."@en,
        "Real, 3-round merger of 21 formerly-separate small TBox files. See this file's own header comment for full, real provenance of every original."@en,
        "Round 4 (2026-09-21): variant_algebra_assembly_model_v1_0_0 (\"Variant Algebra Assembly Model v1.0.0\") added -- 257 real content triples, zero coupling, zero collision, zero real active consumers found."@en ;
    owl:versionInfo "1.0.80" ;
    owl:versionIRI <http://example.org/vaf-consolidated/extended-properties/1.0.80> ;
    owl:priorVersion <http://example.org/vaf-consolidated/extended-properties/1.0.79> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

va:AnthropicProvider a owl:Class ;
    rdfs:label "Anthropic Provider"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class AnthropicProvider in llm_providers_v1_0_0.py directly." ;
    rdfs:subClassOf va:LLMProvider ;
    skos:definition "Concrete LLMProvider binding to the Anthropic v1 messages endpoint. Uses stdlib urllib.request. API key resolved from constructor argument or ANTHROPIC_API_KEY environment variable. Raises LLMProviderError on any non-2xx response. Retries 5xx up to three attempts with exponential backoff." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:BoundedEnumeration a owl:Class ;
    rdfs:label "Bounded Enumeration"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf va:EnumerationStrategy ;
    skos:definition "Caps unbounded cardinalities at enumerationBound K." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:BruteForceBackend a owl:Class ;
    rdfs:label "Brute-Force Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class BruteForceBackend in variant_backends_v1_0_35.py directly." ;
    rdfs:subClassOf va:EnumerationBackend ;
    skos:definition "Naive Cartesian-product backend. Enumerates every assignment in the declared integer box and filters by constraint predicates. Correct by inspection; inefficient above ~2^20 assignments. Retained permanently as the C5 correctness oracle for DecompositionBackend; must not be used in production runtime paths." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:CartesianOperator va:hasComputationalComplexity va:Complexity_ProductAB ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:CheckOutcome a owl:Class ;
    rdfs:label "Check Outcome"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class CheckOutcome in variant_executor_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Result of evaluating one ContractCheck during sandbox execution. Carries the check kind and target, a boolean passed flag, and a detail string describing the observed outcome (e.g. attribute value type, exception class and message)." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:CompleteEnumeration a owl:Class ;
    rdfs:label "Complete Enumeration"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf va:EnumerationStrategy ;
    skos:definition "Entire admissible set; fully bounded Components only." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ContractCheck a owl:Class ;
    rdfs:label "Contract Check"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class ContractCheck in variant_executor_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "One runtime assertion derived mechanically from a Variant. Kinds: instantiate (the component class must instantiate without raising), attribute (each selected singleton feature must be a non-None attribute on the instance), repetition (each feature with count greater than one must produce count-many non-None suffixed attributes)." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DecompositionBackend a owl:Class ;
    rdfs:label "Decomposition Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class DecompositionBackend (with real Tarjan SCC logic, _connected_components) in variant_backends_v1_0_35.py directly." ;
    rdfs:subClassOf va:EnumerationBackend ;
    skos:definition "Thesis-native backend. Partitions features into constraint-connected groups via Tarjan SCC analysis over the operator hypergraph, enumerates each group locally with unit propagation and backtracking, and combines per-group variant sets via Cartesian product. Asymptotically superior to BruteForceBackend on specs with disconnected constraint clusters. Correctness empirically gated against BruteForceBackend via differential testing." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Delta a owl:Class ;
    rdfs:label "Delta (reserved, v3.1)"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — reserved feature-delta vocabulary (add/remove/wrap method); declared but not implemented in v3.x."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A feature-level delta applied to a base implementation (add method, remove method, wrap method). Reserved; not implemented in v3.0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DependencyOperator va:hasComputationalComplexity va:Complexity_DependencyGraphWide ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveryBackend a owl:Class ;
    rdfs:label "Discovery Backend"@en ;
    dcterms:source "Altunel Y. (2013) PhD Thesis, İstanbul Üniversitesi, Computer Engineering, §4.4 pp.733-737, p.821; generalization REGISTRANT-STATED 2026-08-28"@en ;
    skos:definition "A pluggable static-analysis engine that reads existing source code and produces DiscoveredFeature/DiscoveredComponent individuals. Symmetric counterpart to va:SynthesisBackend. Language-agnostic per va:LanguageAgnosticismPrinciple: concrete subclasses name a source-language/toolchain pairing (e.g. a Java-grammar backend, a Python-AST backend, a COBOL-parser backend) purely as a statement of which tool exists — never as a boundary the class itself imposes. Generalizes the thesis's Java/NetBeans-only reverse-engineering application (Altunel 2013, §4.4 pp.733-737: 'the current reverse-engineering application is directed only at static analyses') to VAF's later multi-backend pattern."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveryRequest a owl:Class ;
    rdfs:label "Discovery Request"@en ;
    dcterms:source "Altunel Y. (2013) PhD Thesis, p.821"@en ;
    skos:definition "A request to scan a source root (package/module/file set) through a va:DiscoveryBackend, producing a va:DiscoveryResult. Grounded verbatim in Altunel 2013 p.821: the application 'scans source code consisting of different packages and classes, and converts them into software elements defined by the language.'"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveryScopeLimitation a owl:Class ;
    rdfs:label "Discovery Scope Limitation"@en ;
    dcterms:source "Altunel Y. (2013) PhD Thesis, pp.735-736, p.810"@en ;
    skos:definition "Disclosed, not-yet-closed limitation carried directly from the thesis: reverse-engineering discovery in VAF is STATIC-analysis only. Altunel 2013 pp.735-736 distinguishes static vs dynamic (behavioral) analysis explicitly; p.736: 'The current reverse-engineering application is directed only at static analyses.' Behavioral/relational discovery among entities was named as future work at p.810 ('add the property of automatically or semi-automatically determining relations among entities to the reverse-engineering application... dependencies appear extractable from analysis of source code') and remains open in VAF v1.35.1 — no dynamic-analysis discovery backend exists yet, 13 years later."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveryVerdict a owl:Class ;
    rdfs:label "Discovery Verdict"@en ;
    skos:definition "Accept/reject/needs-review verdict over a va:DiscoveryResult, per the same BP-3-style quality-gate pattern as va:SynthesisVerdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DivisionOperator va:hasComputationalComplexity va:Complexity_SumAB ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ExclusiveOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ExecutionReport a owl:Class ;
    rdfs:label "Execution Report"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class ExecutionReport in variant_executor_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Structured outcome of one sandbox execution. Carries an outcome (PASS, FAIL, EXCEPTION, TIMEOUT, OOM, CPU, INTERNAL), wall-clock elapsed milliseconds, exit code, one CheckOutcome per contract check, truncated stdout and stderr, and exception class plus message when applicable." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FabricationReport a owl:Class ;
    rdfs:label "Fabrication Report"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Outcome of FabricatedAPIChecker on generated code. Carries two flag lists: flagged imports (unknown module names at top of import statements) and flagged calls (unknown free-name call targets). Empty report means no fabrication detected." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FailureClass a owl:Class ;
    rdfs:label "Failure Class"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed already actively used and serialised by variant_feedback_adaptive_v1_0_36.py and variant_feedback_emitter_v1_0_20.py/v1_1_0.py, both real, existing, pre-session code." ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Enumeration of failure classes for FailureDiagnostic. One of SYNTACTIC, STRUCTURAL, CONTRACT, FABRICATION, QUALITY, EXECUTION, RESOURCE, UNKNOWN. Classes are prioritised in pipeline order so earlier static failures mask later dynamic ones when multiple would apply." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FailureDiagnostic a owl:Class ;
    rdfs:label "Failure Diagnostic"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- REAL, ALREADY-MATERIALIZED FINDING: variant_feedback_emitter_v1_0_20.py/v1_1_0.py already serialise real va:FailureDiagnostic-typed RDF individuals, confirmed by direct reading (the emitter's own docstring names this exact vocabulary), meaning the pre-existing system has already been producing RDF using a class this session's core never declared -- a live gap, not a hypothetical one, closed by this declaration." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Structured classification of why a SynthesisVerdict FAILed. Carries a primary FailureClass, a dict of class-specific details (missing features for STRUCTURAL, failed checks for EXECUTION, violated dimensions for QUALITY, outcome string for RESOURCE, etc), and a short human-readable reason excerpt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FeatureCount a owl:Class ;
    rdfs:label "Feature Count"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Reified multiplicity of a Feature in a Variant." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FeedbackAttempt a owl:Class ;
    rdfs:label "Feedback Attempt"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class FeedbackAttempt in variant_feedback_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "One iteration within a FeedbackSession. Carries the attempt number (1-indexed), the hints provided to this attempt, the SynthesisResult produced, the SynthesisVerdict issued, and (when the verdict FAILed) the FailureDiagnostic that classified the cause." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FeedbackLoop a owl:Class ;
    rdfs:label "Feedback Loop"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class FeedbackLoop in variant_feedback_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Orchestrator for iterative variant synthesis. Wraps a SynthesisBackend plus a SynthesisVerifier and runs up to max_attempts iterations per request. Between attempts extracts a FailureDiagnostic from each FAILed verdict and builds a refinement hint appended to the hints list passed to the next attempt. Terminates on SUCCESS (PASS or WARN verdict), EXHAUSTED (max_attempts reached with FAIL), or ABORTED_TERMINAL (diagnostic class is RESOURCE or UNKNOWN which are unlikely to recover)." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:FeedbackSession a owl:Class ;
    rdfs:label "Feedback Session"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class FeedbackSession in variant_feedback_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Record of one FeedbackLoop run on a single SynthesisRequest. Carries the request, an ordered list of FeedbackAttempt individuals, the termination reason string, and the final SynthesisVerdict. Complete history of a loop run, PROV-O-serialisable." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:IntersectionOperator va:hasComputationalComplexity va:Complexity_MinAmortized ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:InverseOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:LLMSynthesisBackend a owl:Class ;
    rdfs:label "LLM Synthesis Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- correctly chains to va:SynthesisBackend, already formally declared earlier this session (the first, Synthesis group of this same disposition item)." ;
    rdfs:subClassOf va:SynthesisBackend ;
    skos:definition "Production backend that calls an LLM API to produce code from a Variant. Outputs must pass the same verification pipeline as MockSynthesisBackend output." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:LanguageAgnosticismPrinciple a owl:Class ;
    rdfs:label "Language Agnosticism Principle"@en ;
    dcterms:source "REGISTRANT-STATED, Y. Altunel, 2026-08-28"@en ;
    skos:definition "Design principle governing both va:DiscoveryBackend and va:SynthesisBackend: no natural or programming language is privileged or excluded by the ontology itself. A concrete backend may be limited to specific languages by the availability and accessibility of its underlying tools/libraries (e.g. a parser exists for Java but not for a given DSL) — but that is a property of the backend instance, never a constraint encoded in the Discovery or Synthesis class definitions. Applies symmetrically to both families; stated for Discovery here, and holds for the already-published va:Synthesis* classes by the same registrant statement without requiring their file to be mutated (BP-D14)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:LazyEnumeration a owl:Class ;
    rdfs:label "Lazy Enumeration"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf va:EnumerationStrategy ;
    skos:definition "On-demand iteration without full materialisation." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:MockProvider a owl:Class ;
    rdfs:label "Mock Provider"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class MockProvider in llm_providers_v1_0_0.py directly." ;
    rdfs:subClassOf va:LLMProvider ;
    skos:definition "Test-time deterministic LLMProvider that returns canned completions by prompt-substring lookup. Raises on unmatched prompts so tests cannot silently drift. Used by the CI suite and the Sprint 4.1 regression tests to exercise the full pipeline without network access." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:MockSynthesisBackend a owl:Class ;
    rdfs:label "Mock Synthesis Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class MockSynthesisBackendV12 in variant_synthesis_v1_2_20.py directly, and correctly chains to va:SynthesisBackend, already declared earlier this session." ;
    rdfs:subClassOf va:SynthesisBackend ;
    skos:definition "Deterministic test-only backend. Generates skeleton code from a Variant using fixed rules, no LLM call. Analogous to BruteForceBackend in the enumeration layer: cheap, predictable, useful for oracle comparisons." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:OptionalOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# VAF-WI-073 (2026-09-29): closes Lock #3's pre-existing gap on MandatoryOperator --
# "the feature must appear in every variant" is decidable per single element without
# scanning, the same O(1) presence-check class as Optional/Exclusive/Or/Inverse above.
va:MandatoryOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# VAF-WI-073 (2026-09-29): closes Lock #3's pre-existing gap on ReplacementOperator --
# its own ontology definition (variant_algebra_v3_4_37.ttl) derives it as "(V - a) + b",
# the same set-difference-plus-union family as Subtraction/Division/Addition below, so
# Complexity_SumAB is the operator's own stated definition, not a separate estimate.
va:ReplacementOperator va:hasComputationalComplexity va:Complexity_SumAB ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:OrOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:PairGenerator a owl:Class ;
    rdfs:label "Pair Generator"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Marker individual that anchors Layer 2's bounded Cartesian pairing rule (va:CartesianRuleShape targets this class), run after Layer 0 propagation has marked prunable candidates. A real consumer asserts one va:PairGenerator instance per enumeration task."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:PartitionRoot a owl:Class ;
    rdfs:label "Partition Root"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Marker individual that anchors Layer 1's divide-and-conquer partitioning rule (va:PartitionRuleShape targets this class). A real consumer asserts exactly one va:PartitionRoot instance per enumeration task to trigger partitioning over that task's va:constrainedWith edges."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Purpose a owl:Class ;
    rdfs:label "Purpose"@en ;
    dcterms:source "This session's semantic/behavioral capability discussion, 2026-07-04." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Why an entity exists, as claimed by one or more BuilderAttributions. Deliberately NOT modeled as an intrinsic, objective property of the entity itself -- per explicit direction, purpose is always an agent-relative interpretation, never ground truth. An entity with no BuilderAttribution has no claimed Purpose at all; this is a valid, legitimate state (see va:BuilderAttribution's confidence tiers), not an error."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:QualityMetric a owl:Class ;
    rdfs:label "Quality Metric"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl (06-runtime/ontology/), carried forward verbatim -- confirmed against variant_quality_v1_1_20.py's own real implementation, and confirmed already actively serialised by variant_feedback_emitter_v1_0_20.py/v1_1_0.py." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Single dimension observation. Carries the dimension label, the observed value (decimal), the threshold (decimal), a violated flag (boolean), the severity assigned (WARN or FAIL), and a human-readable message suitable for inclusion in a verdict reason line." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:QualityPolicy a owl:Class ;
    rdfs:label "Quality Policy"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Per-dimension threshold-and-severity configuration for the static quality verifier. Each of five quality dimensions (cyclomatic, size, documentation, coupling, cohesion) carries a threshold and a severity. Severity WARN registers a warning without blocking synthesis acceptance; severity FAIL promotes the verdict outcome to FAIL. DEFAULT_POLICY is WARN on all dimensions; STRICT_POLICY is FAIL on all dimensions. A QualityPolicy is immutable for the duration of one verification run." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:QualityReport a owl:Class ;
    rdfs:label "Quality Report"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed already actively serialised by the real, existing feedback-emitter pipeline." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Outcome record of QualityChecker on a SynthesisResult. Carries one QualityMetric per dimension evaluated. Silent (zero metrics) when the generated code failed the syntactic check upstream; otherwise reports five to seven metric observations depending on whether size's sub-dimensions each produced an independent metric." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:RefinementHint a owl:Class ;
    rdfs:label "Refinement Hint"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing function build_refinement_hint in variant_feedback_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringArtefact ;
    skos:definition "Human-readable string produced by build_refinement_hint from a FailureDiagnostic. Class-specific template injects concrete details (missing feature names, failed check targets, violated quality dimensions) into a guidance string passed to the next synthesis attempt." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ReplayCache a owl:Class ;
    rdfs:label "Replay Cache"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class ReplayCache in variant_synthesis_v1_1_36.py directly." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Content-addressed filesystem cache for LLM completions. Key is sha256(provider name concatenated with model concatenated with seed concatenated with prompt). Makes CI reproducible by bootstrapping against a live LLM on first run and replaying deterministically thereafter." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ResourceLimits a owl:Class ;
    rdfs:label "Resource Limits"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed to match the real, existing class ResourceLimits and DEFAULT_LIMITS in variant_executor_v1_0_36.py directly." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Bag of resource ceilings for a single sandbox run. Carries CPU time cap, address-space cap, file-descriptor cap, wall-clock timeout, stdout and stderr truncation limits. DEFAULT_LIMITS is 5s CPU, 256MB memory, 64 FDs, 10s wall clock." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SandboxExecutor a owl:Class ;
    rdfs:label "Sandbox Executor"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward -- confirmed to match the real, existing, concrete class SandboxExecutor in variant_executor_v1_0_36.py directly. NOTE, real finding: v2.10.0's own text describes this as abstract with SubprocessSandbox as a separate reference implementation; the real code never built that split -- SandboxExecutor is itself the concrete, real class, disclosed here rather than silently carrying forward an abstract/concrete distinction the implementation doesn't have." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Runs SynthesisResult code under resource limits. Orthogonal to SynthesisBackend: synthesis produces code, the sandbox executes it." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SetA a owl:Class ;
    rdfs:label "Cartesian Operand Set A"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:definition "Scaffold class for CartesianOperator's first operand set. A real consumer types their own candidate features/components as va:SetA members for a specific enumeration task -- generic by design, matching the operator's own domain-agnostic thesis definition (A x B), not tied to one use case."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SetB a owl:Class ;
    rdfs:label "Cartesian Operand Set B"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:ComposableUnit ;
    skos:definition "Scaffold class for CartesianOperator's second operand set. See va:SetA."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SubtractionOperator va:hasComputationalComplexity va:Complexity_SumAB ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SynthesisRequest a owl:Class ;
    rdfs:label "Synthesis Request"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl (06-runtime/ontology/), carried forward verbatim -- accurately describes VAF's real, existing synthesis implementation, confirmed by direct reading of variant_synthesis_v1_2_20.py during this session's legacy-code disposition work." ;
    skos:definition "A declarative request to synthesise code for a specific Variant in a specific target language. Carries the Variant IRI, target language label, and optional stylistic or constraint annotations. Immutable; one Request produces one Result." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SynthesisVerdict a owl:Class ;
    rdfs:label "Synthesis Verdict"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    skos:definition "The verifier's judgement on a SynthesisResult. Carries an outcome (PASS, FAIL, or WARN), a structured reason, and optionally a list of violated contract elements. Authored by the verifier pipeline independently of the synthesis backend; the two are deliberately decoupled so the verifier cannot be gamed by the backend." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:VariantTransformation a owl:Class ;
    rdfs:label "Variant Transformation"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Rule mapping operation-sets to admissible variants." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:VariationCapacityMetric a owl:Class ;
    rdfs:label "Variation Capacity Metric"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- qc:QualityPattern is a real, foreign term (the vendored quality# namespace), referenced by its real IRI, not recreated." ;
    rdfs:subClassOf <http://example.org/quality#QualityPattern> ;
    skos:definition "Well-defined only when the Component is fully bounded; otherwise truncatedCapacityRatio under a declared bound." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:applicationName a owl:DatatypeProperty ;
    rdfs:label "application name"@en ;
    rdfs:domain va:Application ;
    rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:applicationOperand a owl:ObjectProperty ;
    rdfs:label "application operand"@en ;
    dcterms:source "v4.6.1 patch, recovered from session history 2026-07-04 -- absent from this ontology's own lineage until now." ;
    rdfs:domain va:OperatorApplication ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:altLabel "uygulama operandı"@tr ;
    skos:definition "Relates an OperatorApplication to an operand of the operation. Distinct from va:hasOperand (which targets ComposableUnit values per v3.0.7 CompositionOperator semantics). applicationOperand has NO range constraint -- operands may be whole ontologies, SoftwareUnits, Features, Aspects, or any other entity, depending on applicationLevel. Multi-valued; most operators take two operands, but multi-input merge may take more."@en ;
    skos:scopeNote "Formalizes what v4.6.0 intended with 'hasOperand on OperatorApplication'. Necessary because CompositionOperator's own domain-SHACL constrains hasOperand values to ComposableUnit, too strict for ontology-level or cross-family operator applications (e.g. binding an Aspect and a BodySegment to the same OperatorApplication, neither of which is a ComposableUnit)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:assembledAt a owl:DatatypeProperty ;
    rdfs:label "assembled at"@en ;
    rdfs:domain va:ApplicationInstance ;
    rdfs:range xsd:dateTime ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:assembledFromDiscovery a owl:ObjectProperty ;
    rdfs:label "assembled from discovery"@en ;
    dcterms:source "Altunel Y. (2013) PhD Thesis, p.494 (round trip named as one capability), p.821 (discovery output = 'software elements'), grounding the closure; the connecting property itself is REGISTRANT-STATED, 2026-08-28, to close a structural gap the thesis's separate §3 (algebra) and §4.4 (reverse engineering) never bridged explicitly."@en ;
    rdfs:domain va:Variant ;
    rdfs:range va:DiscoveryResult ;
    skos:definition "Links a va:Variant to the va:DiscoveryResult whose va:DiscoveredFeature individuals were assembled (via the existing va:hasFeature / va:hasConcreteFeature properties) to form it. Optional: a Variant may still be authored manually with no DiscoveryResult, per VAF's original (pre-Discovery-family) design. When present, it is what makes a Variant's provenance traceable back to the source it was reverse-engineered from, rather than merely coincidentally sharing Feature instances with a DiscoveryResult."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:assembledSource a owl:DatatypeProperty ;
    rdfs:label "assembled source"@en ;
    rdfs:domain va:ApplicationInstance ;
    rdfs:range xsd:string ;
    skos:definition "The assembled Python module text (variants + DI wiring + entry point). Emitted by the application assembler; consumed by the execution layer."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:attributedAgent a owl:ObjectProperty ;
    rdfs:label "attributed agent"@en ;
    dcterms:source "This session, 2026-07-04." ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Agent ;
    skos:definition "Links a BuilderAttribution to the Agent making the claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:attributesPurposeTo a owl:ObjectProperty ;
    rdfs:label "attributes purpose to"@en ;
    dcterms:source "This session, 2026-07-04." ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a BuilderAttribution to the entity it attributes a Purpose to. No range constraint, matching va:applicationOperand's own rationale -- the attributed entity may be a BodySegment, a Component, a SuperComponent, or any other SoftwareUnit."@en ;
    rdfs:range va:Entity ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:bindingKind a owl:DatatypeProperty ;
    rdfs:label "binding kind"@en ;
    rdfs:domain va:Binding ;
    rdfs:range xsd:string ;
    skos:definition "One of 'constructor' (inject at construction), 'attribute' (post-construction assignment), or 'method-call' (call setter method). Defaults to 'constructor'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:callsExternalFunction a owl:DatatypeProperty ;
    rdfs:label "calls external function"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C4 (ExternalCallCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "A method calls a bare module-scope function F(...) (not self.F()) -- the real-code fact C4's rule reads to propose the dependency M < F."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:callsResolvedCrossFile a owl:DatatypeProperty ;
    rdfs:label "calls resolved cross-file"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C8 (CrossFileCallCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "A method calls an imported name that resolves to a function/class defined in a loaded sibling file -- the real-code fact C8's rule reads to propose a cross-file dependency."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:callsSelfMethod a owl:ObjectProperty ;
    rdfs:label "calls self method"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C2 (MethodCallCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Method ;
    skos:definition "Method A calls self.B() in its body -- the real-code fact C2's rule reads to propose the pairwise dependency A < B."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:callsUnresolvedExternal a owl:DatatypeProperty ;
    rdfs:label "calls unresolved external"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C9 (ExternalSymbolCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "A method calls an imported name that cannot be resolved to a loaded sibling file and is not stdlib -- the real-code fact C9's rule reads to propose a weak-evidence external-symbol dependency."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candidateKind a owl:DatatypeProperty ;
    rdfs:label "candidate kind"@en ;
    dcterms:source "10-operator-implementation-spec/, this session." ;
    rdfs:domain va:SynthesisInputCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Tags which kind of fact a SynthesisInputCandidate wraps: one of 'dependency' (from C1/C2/C7-style calls/reads), 'purpose' (from BuilderAttribution), or a future value. Unlike the earlier code-analysis property-commingling issue, this is safe by construction: the tag lives on the WRAPPER individual, not shared directly on the Method, so distinguishing kinds never requires separating output properties per calculus."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candidateMember a owl:ObjectProperty ;
    rdfs:label "candidate member"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a CandidateVariant (pre-purge) to a Feature under consideration for inclusion. Subtraction(a,b) = {a, !b} (thesis eq. 2.29) is realized upstream by asserting both a and b as candidateMember, with b additionally marked va:isInverseMarked."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candidateSource a owl:ObjectProperty ;
    rdfs:label "candidate source"@en ;
    dcterms:source "10-operator-implementation-spec/, this session." ;
    rdfs:domain va:SynthesisInputCandidate ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a SynthesisInputCandidate wrapper back to the real fact it wraps (a Method for a dependency edge, or a BuilderAttribution individual for a purpose claim) -- no range constraint, matching va:applicationOperand's own precedent, since the source varies genuinely by candidateKind."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:cardinality a owl:DatatypeProperty ;
    rdfs:label "cardinality"@en ;
    rdfs:domain va:Role ;
    rdfs:range xsd:string ;
    skos:definition "How many implementation instances fill this role. Defaults to 1. Use 'N' for unbounded, or an integer literal for a fixed count."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:coOccursWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "co-occurs with"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Marks two operands of an IntersectionOperator instance as jointly present in the relevant variant. Symmetric by construction (a co-occurs with b iff b co-occurs with a)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:confidenceTier a owl:DatatypeProperty ;
    rdfs:label "confidence tier"@en ;
    dcterms:source "This session, 2026-07-04. Reuses the shape of the existing va:DependencyEdge.evidence pattern (variant_detection_calculi_v1_0_29.py: 'strong'|'weak'), extended with two more tiers this domain needs. Extended again 2026-07-06 with a fourth tier, 'domain-inferred', per the RDODI domain-ontology assessment (soundness verdict: sound but requires this tier as a prerequisite, not silently blended with directly-discovered confidence)." ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "One of: 'first-hand' (the attributing Agent IS the entity's actual builder/decider), 'derived' (inherited from a containing SuperComponent's own attribution, via the hasDerivedPurposeFrom mechanism), 'weak' (inferred from secondary evidence, e.g. naming or docstring heuristics), 'domain-inferred' (proposed from a matching concept in an externally-authored RDODI DomainOntologyArtifact, not from any fact discovered about this specific system -- the lowest tier, deliberately below 'weak', since a domain-typical pattern is a different kind of claim than any evidence about the analyzed system itself). No 'unknown' value exists -- unknown is represented by the complete absence of any BuilderAttribution, not a literal tier value (tested explicitly, Concern 2)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:constrainedWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "constrained with"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "A real (typically Exclusive/Dependency-derived) constraint edge between two features, for Layer 1 divide-and-conquer partitioning. Ports the same connected-components strategy already real and tested in 06-runtime/src/variant_backends_v1_0_35.py's DecompositionBackend to the composition-scope, ontology-natively. KNOWN LIMIT (disclosed, not silently accepted): a global k-ary bound spanning two edge-free partitions is invisible to this property unless the modeler adds an explicit edge or uses the va:contributesTo/hasMaxRepetitions pattern (Part 2) instead."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:contributesTo a owl:ObjectProperty ;
    rdfs:label "contributes to"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 2, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Links a candidate Feature to a virtual grouping Feature it counts toward when selected. Lets RepetitionOperator (via hasMaxRepetitions on the group) bound how many of a SET of otherwise-unrelated candidate features may be simultaneously selected, without a dedicated k-of-n operator -- real composition, proven in Part 2, not new algebra."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:convertsFrom a owl:ObjectProperty ;
    rdfs:label "converts from"@en ;
    rdfs:domain va:ConversionRequest ;
    rdfs:range va:DiscoveryResult ;
    skos:definition "The DiscoveryResult a ConversionRequest is assembling into a Variant." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:definesFeature a owl:ObjectProperty ;
    rdfs:label "defines feature"@en ;
    rdfs:domain va:Implementation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range va:Feature ;
    skos:definition "A Feature the Implementation itself provides — either as a method (def name:) or as an instance/class attribute (self.name = ..., or name = ... at class scope). Used with va:requiresFeature to compute dependency closure via pure graph queries rather than source-text matching."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:dependencyKind a owl:DatatypeProperty ;
    rdfs:label "dependency kind"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:string ;
    skos:definition "Classification of the dependency: one of 'self-read', 'self-call', 'bare-call', 'type-annotation', 'exception-class', 'decorator', 'inheritance', 'import', 'context-manager'. Attached to the reification of the va:requiresFeature edge when finer-grained classification is needed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:dependencyLine a owl:DatatypeProperty ;
    rdfs:label "dependency line"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The source line number where the dependency reference occurs; enables UI-level highlighting when a closure violation is reported."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:deploymentFileContent a owl:DatatypeProperty ;
    rdfs:label "deployment file content"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C14." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The raw text content of a candidate file, read by C14's rule to check for real structural markers (a FROM instruction, a services: key, apiVersion:+kind:, a resource block, hosts:+tasks:, or a [Unit] section) -- never bare keyword presence, which would false-positive on comments merely mentioning a technology by name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:deploymentFilename a owl:DatatypeProperty ;
    rdfs:label "deployment filename"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C14." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The raw filename of a candidate file under consideration for DeploymentArtifact detection."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:domainConceptLabel a owl:DatatypeProperty ;
    rdfs:label "domain concept label"@en ;
    dcterms:source "This session, 2026-07-06." ;
    rdfs:domain va:DomainConcept ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The rdfs:label of the source RDODI DomainTaxonomy class, carried over verbatim for matching against a Method's own hasRawName. A real, modest string-based matching mechanism (case-insensitive substring), not full NLP -- matching the same scope discipline already used by C10/C11 (regex/string-based, not machine-learned semantic matching)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:excludesPartner a owl:ObjectProperty ;
    rdfs:label "excludes partner"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Marks a candidate operand as incompatible with a specific member of the opposing operand set, for Layer 0 decrease-and-conquer domain propagation ahead of CartesianOperator. A candidate is only prunable (see va:isPrunable) if it excludes EVERY member of the opposing set -- proven both directions in Part 3 (partial exclusion must survive; total exclusion is correctly prunable)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:forApplication a owl:ObjectProperty ;
    rdfs:label "for application"@en ;
    rdfs:domain va:ApplicationInstance ;
    rdfs:range va:Application ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:forRole a owl:ObjectProperty ;
    rdfs:label "for role"@en ;
    rdfs:domain va:RoleBinding ;
    rdfs:range va:Role ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasASTPatternDescriptor a owl:DatatypeProperty ;
    rdfs:label "has AST pattern descriptor"@en ;
    dcterms:source "Referenced by vaf_invariants_v1_1_2.ttl Shape_CalculusContent; never actually declared until this session, same gap as va:hasConstructQuery." ;
    rdfs:domain va:DetectionCalculus ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "An AST-pattern-DSL descriptor realizing a DetectionCalculus. Declared for completeness alongside va:hasConstructQuery (same shape's sh:or alternatives) -- not used by this session's implementation, which uses the preferred SPARQL CONSTRUCT form instead."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasBinding a owl:ObjectProperty ;
    rdfs:label "has binding"@en ;
    rdfs:domain va:Application ;
    rdfs:range va:Binding ;
    skos:definition "Associates an application with one of its inter-role wirings."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasConstructQuery a owl:DatatypeProperty ;
    rdfs:label "has construct query"@en ;
    dcterms:source "Referenced by vaf_invariants_v1_1_2.ttl Shape_CalculusContent as the PREFERRED backing form for Concern #2; never actually declared anywhere in the ontology until this session -- checked directly, confirmed absent, then fixed." ;
    rdfs:domain va:DetectionCalculus ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "A real SPARQL CONSTRUCT query (as a string literal) realizing a DetectionCalculus's algorithm directly in the ontology, making the ontology itself -- not external source code -- the authoritative definition, per Concern #2's own stated principle. The preferred backing form of Shape_CalculusContent's sh:or alternatives."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasConversionVerdict a owl:ObjectProperty ;
    rdfs:label "has conversion verdict"@en ;
    rdfs:domain va:ConversionResult ;
    rdfs:range va:ConversionVerdict ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasDerivedPurposeFrom a owl:ObjectProperty ;
    rdfs:label "has derived purpose from"@en ;
    dcterms:source "This session, 2026-07-04." ;
    rdfs:domain va:ComposableUnit ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SuperComponent ;
    skos:definition "Rule-derived: a sub-component lacking its own direct BuilderAttribution inherits a derived Purpose claim from its containing SuperComponent's own attribution, via the real, pre-existing va:hasSubComponent relationship. Tested across 1 and 2 hops of nesting; a sub-component WITH its own direct attribution correctly never receives this (first-hand is not overridden). Disclosed limitation: proven to 2 hops only, matching this session's own established precedent for transitive rule depth (Layer 1 partitioning); deeper nesting needs further explicit verification before being assumed to work."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasDiscoverySource a owl:ObjectProperty ;
    rdfs:label "has discovery source"@en ;
    rdfs:domain va:DiscoveredFeature ;
    rdfs:range va:SourceLocation ;
    skos:definition "Links a va:DiscoveredFeature to the va:SourceLocation (module/file/line) it was discovered at. Reuses the definitional style of va:sourceModule (variant_algebra_v3_2_6.ttl ~line 1588: 'Module basename... in which a Feature... was discovered')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasDiscoveryStage a owl:ObjectProperty ;
    rdfs:label "has discovery stage"@en ;
    rdfs:domain va:DiscoverySynthesisPipeline ;
    rdfs:range va:DiscoveryResult ;
    skos:definition "Links a va:DiscoverySynthesisPipeline instance to the va:DiscoveryResult that started it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasDomainSource a owl:ObjectProperty ;
    rdfs:label "has domain source"@en ;
    dcterms:source "This session, 2026-07-06." ;
    rdfs:domain va:DomainConcept ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Links a DomainConcept back to the RDODI class it was read from. No range constraint -- the source IRI belongs to RDODI's own namespace, not VAF's, and is carried as a reference only, not re-typed into any VAF class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasEmittedMember a owl:ObjectProperty ;
    rdfs:label "has emitted member"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    rdfs:domain va:CandidateVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Feature ;
    skos:definition "Rule-derived (purge-before-emission output): the final, post-purge membership of a CandidateVariant -- every va:candidateMember NOT also va:isInverseMarked. A CandidateVariant whose only member is inverse-marked correctly emits none (tested explicitly, Part 4)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasMaxRepetitions a owl:DatatypeProperty ;
    rdfs:label "has max repetitions"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 2, this session -- closes a real gap: RepetitionOperator had zero bound-declaring properties in the base ontology, checked directly, not assumed." ;
    rdfs:domain va:RepetitionOperator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The maximum number of repetitions admissible for the feature (or virtual grouping feature, see va:contributesTo) this RepetitionOperator instance applies to via va:appliesTo. Per thesis eq. 2.39's 'zero or more', absence of this property should be read as unbounded, not zero."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasParameter a owl:ObjectProperty ;
    rdfs:label "has parameter"@en ;
    rdfs:domain va:Operation ;
    rdfs:range va:Parameter ;
    skos:definition "Associates an operation with one of its formal parameters, in declared order (use va:parameterOrder)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasRawName a owl:DatatypeProperty ;
    rdfs:label "has raw name"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C10/C11 (NameTerm/NamingPattern calculi read a Feature's raw source name to decompose/match)." ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The raw, unparsed source-code name of a Feature (method/function/class name as written), read by C10/C11's rules to produce NameTerm/NamingPattern proposals. Distinct from any already-parsed representation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasResultMember a owl:ObjectProperty ;
    rdfs:label "has result member"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Rule-derived: a member of the result set of a DivisionOperator or IntersectionOperator instance, after the operator's own filtering (removes / coOccursWith) has been applied."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasRole a owl:ObjectProperty ;
    rdfs:label "has role"@en ;
    rdfs:domain va:Application ;
    rdfs:range va:Role ;
    skos:definition "Associates an application with one of its declared roles."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasRoleBinding a owl:ObjectProperty ;
    rdfs:label "has role binding"@en ;
    rdfs:domain va:ApplicationInstance ;
    rdfs:range va:RoleBinding ;
    skos:definition "Associates an application instance with one of its per-role implementation choices."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasSynthesisCandidate a owl:ObjectProperty ;
    rdfs:label "has synthesis candidate"@en ;
    dcterms:source "10-operator-implementation-spec/, this session." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SynthesisInputCandidate ;
    skos:definition "Rule-derived: links a Method to a SynthesisInputCandidate wrapper recognized by the General Bridge. The wrapper itself (not this property) carries the candidateKind tag, so multiple candidates of different kinds may attach to the same Method without collision -- avoiding the exact property-commingling mistake found and fixed in the code-analysis rules (F-14)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasSynthesisStage a owl:ObjectProperty ;
    rdfs:label "has synthesis stage"@en ;
    rdfs:domain va:DiscoverySynthesisPipeline ;
    rdfs:range va:SynthesisResult ;
    skos:definition "Links a va:DiscoverySynthesisPipeline instance to the va:SynthesisResult that closed it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:implementationOperation a owl:ObjectProperty ;
    rdfs:label "implementation operation"@en ;
    rdfs:domain va:Implementation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range va:Operation ;
    skos:definition "Associates an Implementation with the Operation record describing one of its own methods. When an Implementation claims va:implementsInterface I, and I has Operation O_iface, the implementation's correspondingly-named Operation record O_impl must have matching va:paramCount / va:requiredParamCount for signature conformance."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:implementationSourceFile a owl:DatatypeProperty ;
    rdfs:label "implementation source file"@en ;
    rdfs:domain va:Implementation ;
    rdfs:range xsd:string ;
    skos:definition "The filename from which this implementation's source was extracted. For provenance."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:implementsInterface a owl:ObjectProperty ;
    rdfs:label "implements interface"@en ;
    rdfs:domain va:Implementation ;
    rdfs:range va:Interface ;
    skos:definition "Declares that this implementation conforms to the given interface. SHACL shapes verify signature-level conformance (every interface operation has a matching method in va:pythonSource)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:implementsVariant a owl:ObjectProperty ;
    rdfs:label "implements variant"@en ;
    rdfs:domain va:Implementation ;
    rdfs:range va:Variant ;
    skos:definition "Optional link from an Implementation to the va:Variant (from v2.x) whose feature selection this implementation realises. This connects the implementation to the discovery/induction output."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:impliesExclusiveOperator a owl:DatatypeProperty ;
    rdfs:label "implies exclusive operator"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C13, realizing the base ontology's OWN stated algebraic fact: 'the members of a ValueDomain are mutually exclusive... which aligns with the Exclusion operator' (va:ValueDomain's own skos:definition, quoted verbatim)." ;
    rdfs:domain va:ValueDomain ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff a ValueDomain has 2+ distinct members, confirming it genuinely implies an ExclusiveOperator relationship among its va:hasDomainMember values -- a real, disclosed link back to the already-implemented ExclusiveOperator (Part 1 of this spec), not a new algebraic claim."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isAdmissible a owl:DatatypeProperty ;
    rdfs:label "is admissible"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff the operator instance is structurally well-formed (e.g. OptionalOperator correctly has an appliesTo target)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isCoIncludedBy a owl:ObjectProperty ;
    rdfs:label "is co-included by"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:AdditionOperator ;
    skos:definition "Inverse-direction binding for AdditionOperator: lets an operand be bound from either direction, since va:hasOperand's natural direction is operator-to-operand only."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isCollectionTyped a owl:DatatypeProperty ;
    rdfs:label "is collection typed"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C6 (CollectionInitCalculus)." ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True iff an Attribute was initialized in __init__ to a mutable-container literal or constructor call (list/dict/set/deque/OrderedDict) -- the real-code fact C6's rule reads to propose the attribute is RepetitionOperator-governed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isInitDeclared a owl:DatatypeProperty ;
    rdfs:label "is init declared"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C3 (InitDependencyCalculus)." ;
    rdfs:domain va:Attribute ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "True iff an Attribute was assigned in __init__. C3's rule combines this with the real, EXISTING va:readsAttribute (not a new property) to propose a method reading any init-declared attribute depends on __init__."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isInverseMarked a owl:DatatypeProperty ;
    rdfs:label "is inverse marked"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "The operational realization of InverseOperator's (!x): 'produces an element that is removed from the variant's feature set... requires subtraction of all inverse elements before variant emission' (base ontology's own skos:definition, quoted verbatim). Tested idempotent under double-marking (stays purged, does not flip back to present -- Part 4)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isPrunable a owl:DatatypeProperty ;
    rdfs:label "is prunable"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff a candidate operand has zero admissible partners remaining in the opposing set (Layer 0 output). Consumers should exclude va:isPrunable=true candidates before CartesianOperator's Layer 2 pairing rule runs."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isSelected a owl:DatatypeProperty ;
    rdfs:label "is selected"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Marks a Feature/Component as chosen in the candidate variant currently under evaluation by Exclusive/Or/Dependency rules. An evaluation-time marker, asserted per-candidate by the consuming pipeline before rules run -- not a static ontology fact."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:isViolated a owl:DatatypeProperty ;
    rdfs:label "is violated"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:domain va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff the operator instance's constraint is violated by the current candidate selection (va:isSelected markers). Shared across ExclusiveOperator, OrOperator, and DependencyOperator's rules rather than one bespoke property per operator."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:memberOfDiscoveryResult a owl:ObjectProperty ;
    rdfs:label "member of discovery result"@en ;
    rdfs:domain va:DiscoveredFeature ;
    rdfs:range va:DiscoveryResult ;
    skos:definition "Real, disclosed gap closed during WI_ConversionVerdictShape: no property linked a va:DiscoveredFeature to the va:DiscoveryResult its own assembled set belongs to -- found while re-checking conversion_verdict_shacl_v1_0_0.ttl's own ambiguity shape, which had no way to scope a targetSlot collision to features within the SAME result without this link, and so genuinely false-positived on two separate, legitimate ConversionResults that independently happened to use the same slot name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:paramCount a owl:DatatypeProperty ;
    rdfs:label "parameter count"@en ;
    rdfs:domain va:Operation ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Cached total count of parameters, excluding self. Used by the signature-conformance SHACL shape."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:parameterDefault a owl:DatatypeProperty ;
    rdfs:label "parameter default"@en ;
    rdfs:domain va:Parameter ;
    rdfs:range xsd:string ;
    skos:definition "Default value as a Python expression string. Absent means no default (parameter is required)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:parameterKind a owl:DatatypeProperty ;
    rdfs:label "parameter kind"@en ;
    rdfs:domain va:Parameter ;
    rdfs:range xsd:string ;
    skos:definition "Python parameter kind: one of 'pos-only', 'positional', 'keyword-only', 'vararg', 'kwarg'. Enables signature-fidelity checks (e.g. a caller passing positional args can only satisfy pos-only or positional params)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:parameterName a owl:DatatypeProperty ;
    rdfs:label "parameter name"@en ;
    rdfs:domain va:Parameter ;
    rdfs:range xsd:string ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:parameterOrder a owl:DatatypeProperty ;
    rdfs:label "parameter order"@en ;
    rdfs:domain va:Parameter ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Zero-based position of the parameter within its operation's signature. 'self' does not receive a position."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:parameterType a owl:DatatypeProperty ;
    rdfs:label "parameter type"@en ;
    rdfs:domain va:Parameter ;
    rdfs:range xsd:string ;
    skos:definition "Python type annotation string, e.g. 'str', 'List[int]'. Empty/absent means unspecified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:producesConversion a owl:ObjectProperty ;
    rdfs:label "produces conversion"@en ;
    rdfs:domain va:ConversionRequest ;
    rdfs:range va:ConversionResult ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesAttributeDependency a owl:ObjectProperty ;
    rdfs:label "proposes attribute dependency"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C1 (AttributeUsageCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Attribute ;
    skos:definition "Rule-derived: C1's proposed dependency on a real Attribute individual, read but not written. Purpose-built, not shared with C2/C7's output -- an earlier design sharing one generic va:proposesDependency property across C1/C2/C7 was tested running all three together and found to commingle their outputs on the same Method subject, making attribution ambiguous. Split per calculus instead."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesCallDependency a owl:ObjectProperty ;
    rdfs:label "proposes call dependency"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C2 (MethodCallCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Method ;
    skos:definition "Rule-derived: C2's proposed dependency on a real Method individual, via a direct self.method() call. Purpose-built, see va:proposesAttributeDependency for why this isn't shared with C1/C7."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesDeploymentArtifactKind a owl:DatatypeProperty ;
    rdfs:label "proposes deployment artifact kind"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C14." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: one of 'dockerfile', 'docker-compose', 'kubernetes', 'terraform', 'ansible', 'systemd' -- the specific DeploymentArtifact kind C14's rule detected via a real structural marker in va:deploymentFileContent."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesExternalDependency a owl:DatatypeProperty ;
    rdfs:label "proposes external dependency"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C4/C8/C9 (ExternalCall/CrossFileCall/ExternalSymbol calculi). Shared across these three based on their source AST facts being structurally disjoint at the trigger-property level (C4 triggers on va:callsExternalFunction from bare Name() calls; C8/C9 trigger on va:callsResolvedCrossFile/va:callsUnresolvedExternal from Attribute() calls, and the original Python C8/C9 are mutually exclusive by explicit design -- C9 skips any call C8 already resolved). NOT independently joint-tested the way C1/C2/C3/C7's commingling was found and fixed this session -- disclosed as an assumption carried from the source design, not verified with the same rigor. Flagged as follow-up work, not silently treated as proven." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: a proposed dependency on an EXTERNAL name (a bare function call C4, a cross-file resolved symbol C8, or an unresolved external symbol C9) not modeled as a va:Method individual."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesInitDependency a owl:DatatypeProperty ;
    rdfs:label "proposes init dependency"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C3 (InitDependencyCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff this method reads an init-declared Attribute (C3's proposal). Purpose-built, kept separate from C4/C8/C9's va:proposesExternalDependency after the same commingling issue found for C1/C2/C7 was also found here on re-test."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesNameTerm a owl:DatatypeProperty ;
    rdfs:label "proposes name term"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C10." ;
    rdfs:domain va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: a proposed lexical term text, to be materialized as a real va:NameTerm individual (via va:hasNameTerm) once accepted -- kept as a string proposal at the SHACL-AF layer since NameTerm individuals are per-term and open-vocabulary, not a closed enumeration like NamingPattern."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesOperatorRefinement a owl:DatatypeProperty ;
    rdfs:label "proposes operator refinement"@en ;
    dcterms:source "10-operator-implementation-spec/, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: a proposed operator-type refinement (e.g. 'MandatoryOperator', 'RepetitionOperator') produced by C5/C6's rules. Shared output vocabulary."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesOuterConfirmed a owl:DatatypeProperty ;
    rdfs:label "proposes outer confirmed"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C12." ;
    rdfs:domain va:TypeReference ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:boolean ;
    skos:definition "Rule-derived: true iff a TypeReference individual has a real va:typeName, confirming it was correctly materialized from source (the outer type of a container, or a simple type). Nested parameter TypeReferences are already linked via the base ontology's own va:hasTypeParameter -- this rule confirms well-formedness, it does not re-derive the nesting structure itself."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesSynthesisTarget a owl:DatatypeProperty ;
    rdfs:label "proposes synthesis target"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- Package 3." ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: one of 'python' or 'html', classified from va:purposeDescription's free text via keyword matching (utility/library-shaped text -> python; demo/stakeholder/presentation-shaped text -> html). Absence of this property (no BuilderAttribution, or a BuilderAttribution with no matching keywords) means the consuming pipeline must apply its own defined default, not treat it as an error -- matching F-16's own 'unknown purpose is absence, not an error' precedent."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesTransitiveDependency a owl:ObjectProperty ;
    rdfs:label "proposes transitive dependency"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- C7 (TransitiveClosureCalculus)." ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:Method ;
    skos:definition "Rule-derived: C7's proposed dependency via 2-hop transitive closure over va:proposesCallDependency edges. Purpose-built, see va:proposesAttributeDependency for why this isn't shared with C1/C2."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:purposeDescription a owl:DatatypeProperty ;
    rdfs:label "purpose description"@en ;
    dcterms:source "10-operator-implementation-spec/, this session -- Package 3." ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Free-text description of why the attributed entity exists, e.g. 'internal utility library' or 'stakeholder demo'. Classified by va:proposesSynthesisTarget's rule into a concrete target-selection signal, matching the keyword-classification approach already established by C11 (NamingPattern)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:pythonAst a owl:DatatypeProperty ;
    rdfs:label "python AST"@en ;
    rdfs:range xsd:string ;
    skos:definition "Optional serialised AST (e.g. output of Python ast.dump) for entities where structural manipulation is expected. Redundant with va:pythonSource; maintained for tools that prefer AST-level reasoning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:pythonEntryPoint a owl:DatatypeProperty ;
    rdfs:label "python entry point"@en ;
    rdfs:range xsd:string ;
    skos:definition "The fully qualified name of a callable within the source that serves as the entry point for execution. E.g. 'Notifier' for a class, or 'main' for a module-level function."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:pythonRequiredModule a owl:DatatypeProperty ;
    rdfs:label "python required module"@en ;
    rdfs:range xsd:string ;
    skos:definition "A module name (e.g. 'smtplib', 'requests') that the annotated implementation imports. Used by the assembler to verify availability in the target runtime (Pyodide has a bounded set of stdlib and PyPI packages)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:pythonSource a owl:DatatypeProperty ;
    rdfs:label "python source"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( va:Implementation va:Operation ) ] ;
    rdfs:range xsd:string ;
    skos:definition "The Python source text of the annotated entity, verbatim, preserved from the original parse. Caller is responsible for ensuring the text is syntactically valid Python 3."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:realizesFacet a owl:ObjectProperty ;
    rdfs:label "realizes facet"@en ;
    rdfs:comment "Mirrors backlog:adoptsFacet's role." ;
    rdfs:domain va:VAFDomainProfile ;
    rdfs:range va:DomainFacet ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:removes a owl:ObjectProperty ;
    rdfs:label "removes"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 1, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Marks one operand of a DivisionOperator instance as cancelling another -- the operational realization of thesis eq. 2.32-33's set-difference semantics."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:requiredParamCount a owl:DatatypeProperty ;
    rdfs:label "required parameter count"@en ;
    rdfs:domain va:Operation ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Cached count of parameters without defaults, excluding *args and **kwargs. Used by the signature-conformance SHACL shape to avoid per-shape aggregation. Parser v2.0.1 auto-populates this."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:requires a owl:ObjectProperty ;
    rdfs:label "requires (interface)"@en ;
    rdfs:domain va:Role ;
    rdfs:range va:Interface ;
    skos:definition "The interface that any implementation filling this role must conform to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:requiresFeature a owl:ObjectProperty ;
    rdfs:label "requires feature"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( va:Implementation va:Operation ) ] ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range va:Feature ;
    skos:definition "An Implementation or Operation requires the target Feature to be present in any variant selection including this one. Derived from AST analysis: the source references this feature by name, as a method call, as a type annotation, as an exception class, or as another concrete code-level reference."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:returnType a owl:DatatypeProperty ;
    rdfs:label "return type"@en ;
    rdfs:domain va:Operation ;
    rdfs:range xsd:string ;
    skos:definition "The return type as a Python type annotation string, e.g. 'bool', 'Optional[str]', 'dict'. Empty/absent means unspecified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:reviewApproved a owl:DatatypeProperty ;
    rdfs:label "review approved"@en ;
    dcterms:source "WI_ProbabilisticGuardFact, 2026-08-31 — the review-gate half of Del_ProbabilisticGuardProven." ;
    rdfs:domain va:Operator ;
    rdfs:range xsd:boolean ;
    skos:definition "Records that a human designer explicitly reviewed and accepted an Operator whose provenance (detectedBy) traces to a Tier-5, probabilistic calculus. Absent or false means the fact has not been consciously accepted -- it must not be treated as carrying the same epistemic weight as a deterministically-detected or manually-declared Operator. This property has no meaning, and is not required, for non-probabilistic provenance; requiring it universally would misrepresent Tiers 1-4 as needing the same review Tier-5 genuinely does." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:runtimeRequirementKind a owl:DatatypeProperty ;
    rdfs:label "runtime requirement kind"@en ;
    rdfs:domain va:RuntimeRequirement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:string ;
    skos:definition "Classification of the runtime requirement: one of 'config-key', 'env-var', 'event-topic', 'service-url', 'plugin-name', 'protocol', 'file-path', 'db-table', 'other'. The kind determines how the assembler's deployment manifest categorises the requirement."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:runtimeRequirementName a owl:DatatypeProperty ;
    rdfs:label "runtime requirement name"@en ;
    rdfs:domain va:RuntimeRequirement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:string ;
    skos:definition "The identifying name of the runtime requirement: the env-var name, the config key path, the event topic, the protocol FQN, etc."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:runtimeRequirementOptional a owl:DatatypeProperty ;
    rdfs:label "runtime requirement optional"@en ;
    rdfs:domain va:RuntimeRequirement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:boolean ;
    skos:definition "If true, the implementation has a fallback when the requirement is absent. If false (default), absence is a hard error at resolution time."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:runtimeRequirementSourceLine a owl:DatatypeProperty ;
    rdfs:label "runtime requirement source line"@en ;
    rdfs:domain va:RuntimeRequirement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The source line number where the auto-detector spotted this requirement (e.g. the line with os.environ[...] or config[...])."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:runtimeRequires a owl:ObjectProperty ;
    rdfs:label "runtime requires"@en ;
    rdfs:domain va:Implementation ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    rdfs:range va:RuntimeRequirement ;
    skos:definition "An Implementation declares a RuntimeRequirement it needs at execution time."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:samePartitionAs a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "same partition as"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 3, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Rule-derived (Layer 1 output): two features are in the same partition if connected via one or more va:constrainedWith hops. Proven transitive up to 2 hops in Part 3's test; the rule's property-path (rdf:rest*/rdf:first-free UNION chain) generalizes to arbitrary depth by the nature of SPARQL property-path-free transitive UNION chaining used."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:sourceProperty a owl:DatatypeProperty ;
    rdfs:label "source property"@en ;
    rdfs:domain va:Binding ;
    rdfs:range xsd:string ;
    skos:definition "Name of the property/method on the source role's implementation that provides the value. Empty string means the instance itself."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:sourceRole a owl:ObjectProperty ;
    rdfs:label "source role"@en ;
    rdfs:domain va:Binding ;
    rdfs:range va:Role ;
    skos:definition "The role whose instance provides the bound value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:targetProperty a owl:DatatypeProperty ;
    rdfs:label "target property"@en ;
    rdfs:domain va:Binding ;
    rdfs:range xsd:string ;
    skos:definition "Name of the property (or constructor parameter) on the target role's implementation that receives the bound value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:targetRole a owl:ObjectProperty ;
    rdfs:label "target role"@en ;
    rdfs:domain va:Binding ;
    rdfs:range va:Role ;
    skos:definition "The role whose instance receives the bound value."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:targetSlot a owl:DatatypeProperty ;
    rdfs:label "target slot"@en ;
    rdfs:domain va:DiscoveredFeature ;
    rdfs:range xsd:string ;
    skos:definition "Which Variant slot a DiscoveredFeature is proposed to fill. Two DiscoveredFeatures sharing a targetSlot within one ConversionRequest is the real ambiguous-mapping failure mode Obj_ConversionRiskReduced's FMEA analysis names." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:useImplementation a owl:ObjectProperty ;
    rdfs:label "use implementation"@en ;
    rdfs:domain va:RoleBinding ;
    rdfs:range va:Implementation ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:wrapsUnitClass a owl:ObjectProperty ;
    rdfs:label "wraps unit class"@en ;
    rdfs:comment "The concrete domain-specific class a facet wraps -- e.g. Facet_Software wraps va:SoftwareUnit. Required, exactly one: a DomainFacet with none is malformed (declared without saying what it actually covers) and a DomainFacet with two is ambiguous about its own scope." ;
    rdfs:domain va:DomainFacet ;
    rdfs:range owl:Class ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:AdditionOperator va:hasComputationalComplexity va:Complexity_O1 ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    dcterms:source "This session's semantic/behavioral capability discussion, 2026-07-04." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "Any entity capable of deciding to build, or building, a software artifact -- a first-hand source of purpose. Deliberately not restricted to a human person: an automated system, a calculus, or an organization may all be Agents, per explicit direction. Modeled as a real, referenceable Class (the 'non-terminal/variable' side of VAF's own grammar convention, confirmed against variant_dsl_grammar_v1_0_5.lark's rule/terminal distinction), not a literal, because the same Agent is reused across many attributions."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:KnowledgeUnit a owl:Class ;
    rdfs:label "Knowledge Unit"@en ;
    dcterms:source "REGISTRANT-STATED, Y. Altunel, 2026-08-30, closing a real gap: va:VAFDomainProfile and va:DomainFacet existed with only one facet ever wired to a concrete profile, and no second facet had ever been declared to prove the mechanism genuinely extends." ;
    rdfs:subClassOf va:GenericUnit ;
    skos:definition "A composable or variable entity in the knowledge-base-construction profile's own domain -- a business document, an incident record, a quality-system entry, an expert insight -- sibling to va:SoftwareUnit under the shared va:GenericUnit ancestor, not a subclass of it. Neither profile's entities are members of the other's domain." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:RepetitionOperator va:hasComputationalComplexity va:Complexity_ParametricN ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SynthesisResult a owl:Class ;
    rdfs:label "Synthesis Result"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    skos:definition "The output of one synthesis backend on one SynthesisRequest. Contains the generated code as a string literal, the backend that produced it, and exactly one SynthesisVerdict." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:CandidateVariant a owl:Class ;
    rdfs:label "Candidate Variant"@en ;
    dcterms:source "10-operator-implementation-spec/ Part 4, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:subClassOf va:Variant ;
    skos:definition "A Variant under evaluation, before Subtraction/Inverse's purge-before-emission rule has been applied. Subclass of the base ontology's own va:Variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ConversionRequest a owl:Class ;
    rdfs:label "Conversion Request"@en ;
    skos:definition "A request to convert one va:DiscoveryResult into a va:Variant, producing a va:ConversionResult. Symmetric to va:DiscoveryRequest: where Discovery scans source into DiscoveredFeatures, Conversion assembles those features into the algebra's own Variant structure." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ConversionResult a owl:Class ;
    rdfs:label "Conversion Result"@en ;
    skos:definition "The va:Variant produced by one va:ConversionRequest, plus a confidence/verdict. Symmetric to va:DiscoveryResult." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoverySynthesisPipeline a owl:Class ;
    rdfs:label "Discovery-Synthesis Pipeline"@en ;
    dcterms:source "REGISTRANT-STATED, Y. Altunel, 2026-08-28 (original), corrected 2026-08-30 following the owner's explicit clarification that VA is a distinct subject from the discover-synthesize workflow, and that both a software-variant profile and a knowledge-base-construction profile are real, first-class VAF profiles, not external subclassing."@en ;
    skos:definition "The full round trip as one named, referenceable process: a va:DiscoveryBackend scans a corpus (va:DiscoveryRequest -> va:DiscoveryResult, holding va:DiscoveredFeature individuals) -> those features are assembled into a va:Variant (va:assembledFromDiscovery) -> the Variant is realised through a va:SynthesisBackend (va:SynthesisRequest -> va:SynthesisResult) into whatever form the target profile's aim requires. This class is the generic workflow SHAPE, deliberately a different subject from the va: algebra it invokes (Feature/Variant/ComposableUnit/composition) -- the workflow moves a corpus through the algebra toward a specific aim, it is not the algebra itself. CORRECTED 2026-08-30 (was: 'VAF's own instantiation of this class is scoped to software... a consuming project instantiates or subclasses it for its own domain' -- written before the Mission amendment and the domain-profile mechanism existed, and inconsistent with both once they did): VAF itself declares multiple first-class va:VAFDomainProfile instances of this same generic pipeline, not merely enabling external consumers to do so -- va:Profile_SoftwareVariantManagement (discovery over source code, development documentation, database metadata, and data itself; synthesis realizes running systems) and va:Profile_KnowledgeBaseConstruction (discovery over emails, corporate legal documentation, quality systems, incidents, business documents, and expert insight; synthesis realizes an agent-usable knowledge base) are both real, named profiles of this one pipeline shape, sharing the same generic algebra core."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DomainConcept a owl:Class ;
    rdfs:label "Domain Concept"@en ;
    dcterms:source "This session, 2026-07-06." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "A VAF-side representation of a single concept read from an RDODI DomainOntologyArtifact's DomainTaxonomy (a class in the rdfs:subClassOf hierarchy). Deliberately minimal -- carries only the label needed for gap-filling matching, not the full taxonomic position or axiom set, since the translation mechanism's scope is proposing candidates, not importing RDODI's ontology wholesale."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:EnumerationBackend a owl:Class ;
    rdfs:label "Enumeration Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim -- confirmed against variant_backends_v1_0_35.py's own real class hierarchy." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Algorithmic policy governing how the enumerator computes the admissible variant set. Abstract parent of BruteForceBackend and DecompositionBackend. Orthogonal to EnumerationStrategy: any Strategy may be implemented by any Backend, and a Component carries both during emission." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:LLMProvider a owl:Class ;
    rdfs:label "LLM Provider"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl (06-runtime/ontology/), carried forward verbatim -- confirmed to match the real, existing llm_providers_v1_0_0.py's own LLMProvider Protocol directly." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Abstract parent of vendor-specific LLM bindings consumed by LLMSynthesisBackend. Concrete subclasses implement a complete() method taking prompt, seed, max_tokens. Orthogonal to SynthesisBackend: the backend governs the request and verification pipeline; the provider governs the underlying HTTP call." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SynthesisBackend a owl:Class ;
    rdfs:label "Synthesis Backend"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl, carried forward verbatim." ;
    skos:definition "Abstract parent of backends that produce code for a given Variant. Does not itself run any LLM; concrete subclasses carry their own configuration. Orthogonal to EnumerationBackend: the enumerator produces Variants, the SynthesisBackend consumes a Variant and returns a SynthesisResult." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ComposableUnit rdfs:subClassOf va:GenericUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveredFeature a owl:Class ;
    rdfs:label "Discovered Feature"@en ;
    rdfs:subClassOf va:Feature ;
    skos:definition "A va:Feature whose origin is static-analysis discovery from existing source rather than manual specification. Carries va:hasDiscoverySource. Corresponds to the 'software elements — packages, classes, methods, attributes, parameters' produced by reverse engineering per Altunel 2013 p.821."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:EnumerationStrategy a owl:Class ;
    rdfs:label "Enumeration Strategy"@en ;
    dcterms:source "variant_algebra_v2_10_0.ttl (06-runtime/ontology/), carried forward verbatim -- confirmed to match variant_enumerator_v2_0_35.py's own real, existing implementation." ;
    rdfs:subClassOf oe:EngineeringPattern ;
    skos:definition "Policy governing how the enumerator materialises variants: what is produced." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:GenericUnit a owl:Class ;
    rdfs:label "Generic Unit"@en ;
    dcterms:source "REGISTRANT-STATED, Y. Altunel, 2026-08-29, closing a structural gap found during WI_MetaLevelAssertion's grooming — not present in Altunel 2013, which scoped the whole algebra to software (Ψ) by design; this is the mission-amendment's own generalization made structurally real rather than only claimed." ;
    skos:definition "A composable or variable entity in ANY domain's algebra — the genuinely domain-neutral ancestor va:SoftwareUnit could not be, since SoftwareUnit's own definition scopes it to the thesis's element set Ψ (software entities specifically). A future non-software facet's own entities are GenericUnit instances without needing to also be SoftwareUnit instances, which would be a category error for, say, a database schema field or a workflow step."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:RoleBinding a owl:Class ;
    rdfs:label "Role Binding"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — application-assembly layer (role-to-implementation selection within an ApplicationInstance)."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "The choice of a specific Implementation to fill a specific Role in a specific ApplicationInstance. Distinct from va:Binding (inter-role wiring): a RoleBinding is role → implementation; a Binding is role-output → role-input."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:SynthesisInputCandidate a owl:Class ;
    rdfs:label "Synthesis Input Candidate"@en ;
    dcterms:source "10-operator-implementation-spec/VAF_PIPELINE_BACKBONE_BACKLOG_v1_0_91.md, Package 1, this session." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "A generic wrapper marking that some real, discovered or attributed fact (a dependency edge from C1-C9, a Purpose claim from BuilderAttribution, or a future fact type) has been recognized by the General Bridge as a candidate input to synthesis. Deliberately generic -- the whole point of Package 1 is that this class does not need to change when a new fact type (e.g. a future DeploymentArtifact-derived fact) is added; only a new bridging rule is needed, not a new wrapper class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:VAFDomainProfile a owl:Class ;
    rdfs:label "VAF Domain Profile"@en ;
    rdfs:comment "Mirrors backlog:AdoptionProfile's declaratory shape only -- deliberately NOT FrameworkFacet's closed owl:oneOf enumeration, since VAF's mission requires this to stay open for domains not yet built." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ApplicationInstance a owl:Class ;
    rdfs:label "Application Instance"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — application-assembly layer (fully-filled assembly; synthesis/execution target with PROV-O lineage)."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A concrete assembly: an Application with every Role filled by a specific Implementation. The target of synthesis (source emission) and execution. Connects via PROV-O to the activity that assembled and ran it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:ConversionVerdict a owl:Class ;
    rdfs:label "Conversion Verdict"@en ;
    skos:definition "Accept/reject/needs-review verdict over a va:ConversionResult, per the same BP-3-style quality-gate pattern as va:DiscoveryVerdict and va:SynthesisVerdict." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DiscoveryResult a owl:Class ;
    rdfs:label "Discovery Result"@en ;
    skos:definition "The set of va:DiscoveredFeature/va:DiscoveredComponent individuals produced by one va:DiscoveryRequest, plus a confidence/verdict. Symmetric to va:SynthesisResult."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DomainFacet a owl:Class ;
    rdfs:label "Domain Facet"@en ;
    rdfs:comment "Open class, deliberately not owl:oneOf-closed. Facet_Software is the first individual, not the only one the class permits." ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:BuilderAttribution a owl:Class ;
    rdfs:label "Builder Attribution"@en ;
    dcterms:source "This session's semantic/behavioral capability discussion, 2026-07-04." ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "A reified claim that a specific Agent attributes a Purpose to a specific entity, with an explicit confidence tier. Follows the SAME reification pattern already established by va:OperatorApplication (a Class whose individuals tie together several facts), not a new pattern. Multiple BuilderAttribution individuals may attribute Purpose to the same entity from different Agents, potentially disagreeing -- this is real information, not noise to be resolved to a single answer."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:RuntimeRequirement a owl:Class ;
    rdfs:label "Runtime Requirement"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — runtime-requirement declaration layer (deployment-manifest inputs not statically verifiable)."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A runtime binding an Implementation depends on but which cannot be verified statically: a config key, environment variable, event topic, external service URL, plugin name, protocol contract, file path, or database table. Verification occurs at runtime; the declaration ensures the assembler emits a deployment manifest enumerating these requirements."@en ;
    skos:example "EmailNotifierImpl declares a RuntimeRequirement of kind 'env-var' with name 'SMTP_PASSWORD'. The assembler's manifest lists 'SMTP_PASSWORD' among environment variables that must be set before the assembled app will run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Binding a owl:Class ;
    rdfs:label "Binding"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — inter-role wiring layer (producer-output to consumer-dependency binding)."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A directed wiring from a producing role's output property to a consuming role's dependency property. Assembled by the application assembler as either constructor-argument injection or post-construction attribute assignment, depending on va:bindingKind."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Role a owl:Class ;
    rdfs:label "Role"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — application-assembly layer (interface-typed slot filled by an Implementation at assembly time)."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A slot in an application, typed by an interface. At assembly time, each role is filled by a concrete Implementation that declares va:implementsInterface matching the role's va:requires."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Feature rdfs:subClassOf va:GenericUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    dcterms:source "Variant Algebra v3 Ontology Extension — implementation layer (concrete variant realisation carrying Python source). Grounded in Altunel (2013) thesis component/feature model §2.2."@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/assembly-model> ;
    skos:definition "A concrete realisation of a variant, carrying its Python source. Every Implementation implements at least one Interface; each operation declared in that interface must correspond to a method in the implementation's source. Implementations are what the assembler actually composes into applications."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# ============================================================
# VAF-WI-252: the terms the rules and the code use, declared (written 2026-10-20). Each was used by a rule, a reader or a builder and
# declared nowhere; the labels and definitions say what the rules and the code do with them. Nothing here changes a rule.
# ============================================================

# ---- proposals of the detection calculi
va:proposesAdditionPairing a owl:ObjectProperty ;
    rdfs:label "proposes an addition pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by addition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesCartesianPairing a owl:ObjectProperty ;
    rdfs:label "proposes a Cartesian pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by a Cartesian product."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesDivisionPairing a owl:ObjectProperty ;
    rdfs:label "proposes a division pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by division."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesExclusivePairing a owl:ObjectProperty ;
    rdfs:label "proposes an exclusive pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one exclusively."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesIntersectionPairing a owl:ObjectProperty ;
    rdfs:label "proposes an intersection pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by intersection."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesOrPairing a owl:ObjectProperty ;
    rdfs:label "proposes an or pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by or."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesSubtractionPairing a owl:ObjectProperty ;
    rdfs:label "proposes a subtraction pairing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes to pair with this one by subtraction."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesInverseRefinement a owl:ObjectProperty ;
    rdfs:label "proposes an inverse refinement"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The element the calculus proposes as the inverse refinement of this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesGuardDependency a owl:ObjectProperty ;
    rdfs:label "proposes a guard dependency"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The guard fact from which the calculus proposes a dependency."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesGuardExclusion a owl:ObjectProperty ;
    rdfs:label "proposes a guard exclusion"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The guard fact from which the calculus proposes an exclusion."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesGuardMultiExclusion a owl:ObjectProperty ;
    rdfs:label "proposes a guard multi-exclusion"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "One value of a guard that raises when the attribute is among several values (attribute:value), from which the calculus proposes an exclusion among several."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesStateMove a owl:ObjectProperty ;
    rdfs:label "proposes a state move"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The move between states that the calculus proposes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesUnguardedMove a owl:ObjectProperty ;
    rdfs:label "proposes an unguarded move"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The event whose unguarded move the calculus proposes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesInitialState a owl:ObjectProperty ;
    rdfs:label "proposes an initial state"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The state the calculus proposes as initial."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesSequenceBefore a owl:ObjectProperty ;
    rdfs:label "proposes a sequence"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The method the calculus proposes to follow this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesStepNext a owl:ObjectProperty ;
    rdfs:label "proposes a next step"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The step the calculus proposes to come next."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesStateBeforeEvent a owl:ObjectProperty ;
    rdfs:label "proposes a state before an event"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The state that the calculus proposes to hold before the event."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesImmediateFiring a owl:ObjectProperty ;
    rdfs:label "proposes an immediate firing"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The firing the calculus proposes to happen at once."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesRegistrationBefore a owl:ObjectProperty ;
    rdfs:label "proposes a registration first"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The registration the calculus proposes to come before the dispatch."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:proposesDispatchOf a owl:ObjectProperty ;
    rdfs:label "proposes a dispatch"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The dispatch the calculus proposes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# ---- hashes and file links of the descriptions
va:calculusImplementationSHA256 a owl:DatatypeProperty ;
    rdfs:label "implementation hash"@en ;
    rdfs:domain va:DetectionCalculus ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The SHA-256 of the file that implements the calculus."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:contentSHA256 a owl:DatatypeProperty ;
    rdfs:label "content hash"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The SHA-256 of the content of a file as it was harvested."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:hasFile a owl:ObjectProperty ;
    rdfs:label "has file"@en ;
    rdfs:domain va:Application ;
    rdfs:range va:SourceFile ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A file of the application."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# links from the definitions and examples that name another term (VAF-WI-252)
va:FailureDiagnostic rdfs:seeAlso va:FailureClass ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:FailureClass rdfs:seeAlso va:FailureDiagnostic ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:DecompositionBackend rdfs:seeAlso va:BruteForceBackend ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:BruteForceBackend rdfs:seeAlso va:DecompositionBackend ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:VariationCapacityMetric rdfs:seeAlso va:ThesisCapacityFormula ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:DiscoveryBackend rdfs:seeAlso va:LanguageAgnosticismPrinciple ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:LanguageAgnosticismPrinciple rdfs:seeAlso va:DiscoveryBackend ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:requestedBackend a owl:ObjectProperty ;
    rdfs:label "backend the request scans through"@en ;
    rdfs:domain va:DiscoveryRequest ;
    rdfs:range va:DiscoveryBackend ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The discovery backend through which the source root is scanned."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:limitsDiscoveryBackend a owl:ObjectProperty ;
    rdfs:label "backend the limitation holds for"@en ;
    rdfs:domain va:DiscoveryScopeLimitation ;
    rdfs:range va:DiscoveryBackend ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The kind of discovery backend whose reach the limitation states: static analysis only."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:governsBackend a owl:ObjectProperty ;
    rdfs:label "backend the principle governs"@en ;
    rdfs:domain va:LanguageAgnosticismPrinciple ;
    rdfs:range [ a owl:Class ; owl:unionOf ( va:DiscoveryBackend va:SynthesisBackend ) ] ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A backend that the principle governs: none is tied to a language."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:deltaAppliesTo a owl:ObjectProperty ;
    rdfs:label "implementation the delta applies to"@en ;
    rdfs:domain va:Delta ;
    rdfs:range va:Implementation ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The base implementation that the feature-level delta is applied to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:anchorsDecompositionLayer a owl:ObjectProperty ;
    rdfs:label "backend the marker starts"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:PairGenerator va:PartitionRoot ) ] ;
    rdfs:range va:DecompositionBackend ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The backend whose layered enumeration the marker starts: the partition root starts Layer 1 (partitioning), the pair generator Layer 2 (bounded pairing)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:claimsPurpose a owl:ObjectProperty ;
    rdfs:label "purpose claimed"@en ;
    rdfs:domain va:BuilderAttribution ;
    rdfs:range va:Purpose ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The purpose that the attribution claims for the entity."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:implementsStrategy a owl:ObjectProperty ;
    rdfs:label "strategy the backend implements"@en ;
    rdfs:domain va:EnumerationBackend ;
    rdfs:range va:EnumerationStrategy ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "An enumeration strategy that the backend can implement: any strategy may be implemented by any backend."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:usesProvider a owl:ObjectProperty ;
    rdfs:label "provider the backend uses"@en ;
    rdfs:domain va:LLMSynthesisBackend ;
    rdfs:range va:LLMProvider ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The provider of the language model that the synthesis backend calls."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:attemptVerdict a owl:ObjectProperty ;
    rdfs:label "verdict of the attempt"@en ;
    rdfs:domain va:FeedbackAttempt ;
    rdfs:range va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The verdict issued for the attempt."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:feedbackSessionFor a owl:ObjectProperty ;
    rdfs:label "request the session ran on"@en ;
    rdfs:domain va:FeedbackSession ;
    rdfs:range va:SynthesisRequest ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The synthesis request on which the feedback loop was run."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:recordsLoop a owl:ObjectProperty ;
    rdfs:label "feedback loop the session records"@en ;
    rdfs:domain va:FeedbackSession ;
    rdfs:range va:FeedbackLoop ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The feedback loop whose run the session records."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# ---- calculus results (VAF-WI-256): what a detection rule proposed, as one fact with its calculus, names and reason
va:CalculusResult a owl:Class ;
    rdfs:label "Calculus result"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "One result of a detection calculus: a proposal of the detection rules with the calculus that made it, its names and its reason."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:DependencyResult a owl:Class ;
    rdfs:label "Dependency result"@en ;
    rdfs:subClassOf va:CalculusResult ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A proposed dependency (left depends on right) of one calculus."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:RefinementResult a owl:Class ;
    rdfs:label "Refinement result"@en ;
    rdfs:subClassOf va:CalculusResult ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A proposed refinement of the operator of an attribute or method."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:PairingResult a owl:Class ;
    rdfs:label "Pairing result"@en ;
    rdfs:subClassOf va:CalculusResult ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A proposed operator between two names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:GroupAdditionResult a owl:Class ;
    rdfs:label "Group addition result"@en ;
    rdfs:subClassOf va:CalculusResult ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A group of names that one tuple-unpacking assignment includes together, recovered from the pairs of the C24 calculus."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:CoIncludedName a owl:Class ;
    rdfs:label "Co-included name"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A name that a C24 pairing includes together with another name."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:GuardConditionCandidate a owl:Class ;
    rdfs:label "Guard condition candidate"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The condition a method's own guard gives a state move it makes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:GuardConditionResult a owl:Class ;
    rdfs:label "Guard condition result"@en ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The one condition kept for a state move: where several methods give one, the smallest text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultOf a owl:ObjectProperty ;
    rdfs:label "result of"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The node the detection rule proposed the result for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultCalculus a owl:DatatypeProperty ;
    rdfs:label "result calculus"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The calculus that made the result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultLeft a owl:DatatypeProperty ;
    rdfs:label "result left"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The first name of the result (the target of a refinement)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultRight a owl:DatatypeProperty ;
    rdfs:label "result right"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The second name of the result."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultOperator a owl:DatatypeProperty ;
    rdfs:label "result operator"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The operator the result proposes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultReason a owl:DatatypeProperty ;
    rdfs:label "result reason"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "Why the calculus proposes it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:resultEvidence a owl:DatatypeProperty ;
    rdfs:label "result evidence"@en ;
    rdfs:domain va:CalculusResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "How strong the evidence is (strong or weak)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:groupMemberName a owl:DatatypeProperty ;
    rdfs:label "group member name"@en ;
    rdfs:domain va:GroupAdditionResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "A name of the group."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:groupSize a owl:DatatypeProperty ;
    rdfs:label "group size"@en ;
    rdfs:domain va:GroupAdditionResult ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "How many names the group holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:nameText a owl:DatatypeProperty ;
    rdfs:label "name text"@en ;
    rdfs:domain va:CoIncludedName ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The name as written."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:coIncludedWith a owl:ObjectProperty ;
    rdfs:label "co-included with"@en ;
    rdfs:domain va:CoIncludedName ;
    rdfs:range va:CoIncludedName ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The other name that one assignment includes together with this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candidateOf a owl:ObjectProperty ;
    rdfs:label "candidate of"@en ;
    rdfs:domain va:GuardConditionCandidate ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The method whose guard gives the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candFrom a owl:DatatypeProperty ;
    rdfs:label "candidate from"@en ;
    rdfs:domain va:GuardConditionCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The feature the state move leaves."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candTo a owl:DatatypeProperty ;
    rdfs:label "candidate to"@en ;
    rdfs:domain va:GuardConditionCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The feature the state move arrives at."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:candText a owl:DatatypeProperty ;
    rdfs:label "candidate text"@en ;
    rdfs:domain va:GuardConditionCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The condition text."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:conditionFrom a owl:ObjectProperty ;
    rdfs:label "condition from"@en ;
    rdfs:domain va:GuardConditionResult ;
    rdfs:range va:GuardConditionCandidate ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The candidate the kept condition comes from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:conditionText a owl:DatatypeProperty ;
    rdfs:label "condition text"@en ;
    rdfs:domain va:GuardConditionResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The condition the guarded state move carries."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:conditionFromFeature a owl:DatatypeProperty ;
    rdfs:label "condition from feature"@en ;
    rdfs:domain va:GuardConditionResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The feature the state move leaves."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:conditionToFeature a owl:DatatypeProperty ;
    rdfs:label "condition to feature"@en ;
    rdfs:domain va:GuardConditionResult ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/vaf-consolidated/extended-properties> ;
    skos:definition "The feature the state move arrives at."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# ---- the target a method is built for (VAF-WI-256)
va:SynthesisPolicy a owl:Class ;
    rdfs:label "Synthesis policy"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    skos:definition "The standing choices of synthesis that no purpose changes; today the target a method is built for when no purpose proposes one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:defaultSynthesisTarget a owl:DatatypeProperty ;
    rdfs:label "default synthesis target"@en ;
    rdfs:domain va:SynthesisPolicy ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "The target a method is built for when no purpose proposes one: python, the established backend. Not an error (CR3.3)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

va:selectedSynthesisTarget a owl:DatatypeProperty ;
    rdfs:label "selected synthesis target"@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range xsd:string ;
    skos:definition "Rule-derived: the target the method is built for, the smallest of those its purposes propose, else the default of the synthesis policy."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

# Relations added for the connectedness of the one T-Box (WI-253), stated where the class or the property is declared in its module.
va:resultOf rdfs:range va:SoftwareUnit ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:GuardConditionCandidate rdfs:subClassOf [ a owl:Restriction ; owl:onProperty va:candidateOf ; owl:someValuesFrom va:Method ] ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .
va:targetDefaultedBy a owl:ObjectProperty ;
    rdfs:label "target defaulted by"@en ;
    rdfs:domain va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra> ;
    rdfs:range va:SynthesisPolicy ;
    skos:definition "The synthesis policy whose default target a method is built for, because no purpose of the method proposes a target."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/extended-properties> .

