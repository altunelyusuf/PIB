    owl:priorVersion <http://example.org/vaf-domain/1.0.10> ;
    dcterms:title "VAF domain ontology - T-Box (one file for the unit)"@en ;
    dcterms:description "Every class and property of the VAF domain ontology as ONE file (BP-D54). Each former ontology file is a module: a block that starts at its marker line, carries a resource at the former header IRI with the old header's statements (less its type), and says dcterms:isPartOf on every subject. Terms keep their IRIs. A pure union of the former files, proved."@en ;
    dcterms:identifier "vaf_domain_tbox" ;
    dcterms:created "2026-10-21"^^xsd:date ;
    dcterms:modified "2026-10-21"^^xsd:date .

