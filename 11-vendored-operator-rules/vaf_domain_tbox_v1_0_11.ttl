    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "CPU time ceiling applied via RLIMIT_CPU. Integer seconds. Exceeding triggers SIGKILL with CPU outcome."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:resourceMemoryBytes a owl:DatatypeProperty ;
    rdfs:label "resource memory bytes"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ResourceLimits ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Address-space ceiling applied via RLIMIT_AS. Bytes. Exceeding may trigger Python MemoryError raised into the running code or SIGKILL from the kernel depending on allocation pattern."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:resourceWallClockSeconds a owl:DatatypeProperty ;
    rdfs:label "resource wall-clock seconds"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.8.0."@en ;
    rdfs:domain va:ResourceLimits ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:decimal ;
    skos:definition "Wall-clock timeout applied via subprocess.run timeout argument. Seconds. Independent of CPU limit; catches idle hangs and deadlocks."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:synthesisBackendUsed a owl:ObjectProperty ;
    rdfs:label "synthesis backend used"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.5.0."@en ;
    rdfs:domain va:SynthesisResult ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range va:SynthesisBackend ;
    skos:definition "Links a SynthesisResult to the backend that produced it. Required; a Result with no backend attribution violates REDO C6 Traceability."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:synthesisFor a owl:ObjectProperty ;
    rdfs:label "synthesis for"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.5.0."@en ;
    rdfs:domain va:SynthesisRequest ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range va:Variant ;
    skos:definition "Links a SynthesisRequest to the Variant it asks to be realised as code."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:terminationReason a owl:DatatypeProperty ;
    rdfs:label "termination reason"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.9.0."@en ;
    rdfs:domain va:FeedbackSession ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Why the feedback loop ended. SUCCESS if final verdict was PASS or WARN. EXHAUSTED if max_attempts was reached with FAIL. ABORTED_TERMINAL if a terminal diagnostic class (RESOURCE UNKNOWN) triggered early abort."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:truncatedCapacityRatio a owl:DatatypeProperty ;
    rdfs:label "truncated capacity ratio"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "v2.3.0."@en ;
    rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:decimal ;
    skos:definition "Bound-dependent capacity ratio when unbounded."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:variationCapacityRatio a owl:DatatypeProperty ;
    rdfs:label "variation capacity ratio"@en ;
    dcterms:source "Altunel (2013) §2.1.4. v2.2.0."@en,
        "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en ;
    rdfs:domain va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:decimal ;
    skos:definition "Admissible over upper bound for fully bounded Components."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:verdictFor a owl:ObjectProperty ;
    rdfs:label "verdict for"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.5.0."@en ;
    rdfs:domain va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range va:SynthesisResult ;
    skos:definition "Inverse direction of hasVerdict. Links a SynthesisVerdict back to the SynthesisResult it evaluates."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:verdictOutcome a owl:DatatypeProperty ;
    rdfs:label "verdict outcome"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.5.0."@en ;
    rdfs:domain va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "The verifier's top-level outcome. One of PASS, FAIL, or WARN. PASS means the generated code satisfies every contract element of the Variant. FAIL means at least one contract element is violated. WARN means the verifier suspects but cannot prove a violation; downstream tooling may still accept the Result but should surface the warning."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:verdictReason a owl:DatatypeProperty ;
    rdfs:label "verdict reason"@en ;
    dcterms:source "Carried over from 06-runtime/ontology/variant_algebra_v2_10_0.ttl, the older runtime generation, where it was the only declaration (VAF-WI-110)."@en,
        "Introduced in v2.5.0."@en ;
    rdfs:domain va:SynthesisVerdict ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    rdfs:range xsd:string ;
    skos:definition "Structured human-readable reason string. Format: one line per contract check, prefixed with PASS or FAIL, followed by a brief description. Consumers may parse it by newline or treat it as opaque."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ============================================================
# VAF-WI-252: the terms the rules and the code use, declared (written 2026-10-20). Each was used by a rule, a reader or a builder and
# declared nowhere; the labels and definitions say what the rules and the code do with them. Nothing here changes a rule.
# ============================================================

# ---- classes of variant behaviour (variant_behaviour_classes)
va:BehaviourClass a owl:Class ;
    rdfs:label "behaviour class"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A group of variants that a probe observed to behave alike: how many methods a caller can use, whether a probe ran, whether it behaves as the original."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcMethods a owl:DatatypeProperty ;
    rdfs:label "methods a caller can use"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The number of methods a caller can use in the class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcProbed a owl:DatatypeProperty ;
    rdfs:label "probed"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when a probe ran for the class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcSameAsOriginal a owl:DatatypeProperty ;
    rdfs:label "same as the original"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the class behaves as the original program."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcLabel a owl:DatatypeProperty ;
    rdfs:label "label in plain words"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The label the rules give the class, in plain words."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcRank a owl:DatatypeProperty ;
    rdfs:label "rank"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The rank the rules give the class; 1 is the most useful."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- the behavioural calculi's claim node
va:claimDocumentText a owl:DatatypeProperty ;
    rdfs:label "document text of the claim"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The docstring text a behavioural claim was read from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:claimValueWord a owl:DatatypeProperty ;
    rdfs:label "value word of the claim"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The state value a behavioural claim names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- substitution check (variant_substitution)
va:SubstitutionCheck a owl:Class ;
    rdfs:label "substitution check"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A check that a variant stays a variant when a feature is replaced by another: the edit, the variants that appear and the variants that are lost."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:CheckedVariant a owl:Class ;
    rdfs:label "checked variant"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A variant of the model that a substitution check compared."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkDeclares a owl:DatatypeProperty ;
    rdfs:label "feature declared"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the checked model declares."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkOptional a owl:DatatypeProperty ;
    rdfs:label "feature optional"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the checked model declares optional."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkRole a owl:DatatypeProperty ;
    rdfs:label "role in the check"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "Whether the variant is the original or the edited one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkMappedTo a owl:ObjectProperty ;
    rdfs:label "variant mapped to"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range va:CheckedVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The variant of the other model that this one corresponds to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkAssigns a owl:ObjectProperty ;
    rdfs:label "assigns feature"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the variant assigns."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkFeature a owl:ObjectProperty ;
    rdfs:label "variant feature"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the variant holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkFeatureName a owl:DatatypeProperty ;
    rdfs:label "feature name in the check"@en ;
    rdfs:domain va:Feature ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The name of the feature as the check reads it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:checkCount a owl:DatatypeProperty ;
    rdfs:label "count in the check"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The repetition count the variant gives a feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:substitutionEdit a owl:DatatypeProperty ;
    rdfs:label "the edit"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The edit that is checked."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:sameVariantAs a owl:ObjectProperty ;
    rdfs:label "same variant as"@en ;
    rdfs:domain va:CheckedVariant ;
    rdfs:range va:CheckedVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The variant of the other model with the same features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:gainedVariant a owl:ObjectProperty ;
    rdfs:label "variant gained"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range va:CheckedVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A variant that appears after the edit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:lostVariant a owl:ObjectProperty ;
    rdfs:label "variant lost"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range va:CheckedVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A variant that is lost by the edit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:deadFeature a owl:ObjectProperty ;
    rdfs:label "dead feature"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature that appears in no variant after the edit."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:falseOptionalFeature a owl:ObjectProperty ;
    rdfs:label "false optional feature"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature that appears in every variant after the edit although it is declared optional."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:voidModel a owl:DatatypeProperty ;
    rdfs:label "void model"@en ;
    rdfs:domain va:SubstitutionCheck ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the model has no variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- composition facts
va:CompositionFact a owl:Class ;
    rdfs:label "composition fact"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A fact read from the semantic marker rules: which class holds which attribute, of which type, by which statement."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:compositionOwner a owl:ObjectProperty ;
    rdfs:label "owner"@en ;
    rdfs:domain va:CompositionFact ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The class that holds the attribute."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:compositionAttribute a owl:ObjectProperty ;
    rdfs:label "attribute"@en ;
    rdfs:domain va:CompositionFact ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The attribute that holds the component."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:compositionTarget a owl:ObjectProperty ;
    rdfs:label "target"@en ;
    rdfs:domain va:CompositionFact ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The class of the component that the attribute holds."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:compositionType a owl:DatatypeProperty ;
    rdfs:label "composition type"@en ;
    rdfs:domain va:CompositionFact ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The kind of composition: whole-part, aggregation or association."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:compositionStatement a owl:ObjectProperty ;
    rdfs:label "statement"@en ;
    rdfs:domain va:CompositionFact ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The statement of the program that makes the composition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- profile-family soundness
va:FamilyConstraint a owl:Class ;
    rdfs:label "family constraint"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "One constraint a profile family node declares on an element: the element, the operator (Mandatory or Optional) and its position."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:FamilyContradiction a owl:Class ;
    rdfs:label "family contradiction"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A constraint of a descendant profile that contradicts one of its ancestor's."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:ownConstraint a owl:ObjectProperty ;
    rdfs:label "own constraint"@en ;
    rdfs:domain va:ProfileFamily ;
    rdfs:range va:FamilyConstraint ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A constraint a profile declares itself."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:constrainedElement a owl:ObjectProperty ;
    rdfs:label "constrained element"@en ;
    rdfs:domain va:FamilyConstraint ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The element a constraint is about."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:constraintOperator a owl:DatatypeProperty ;
    rdfs:label "constraint operator"@en ;
    rdfs:domain va:FamilyConstraint ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The operator of the constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:constraintIndex a owl:DatatypeProperty ;
    rdfs:label "constraint index"@en ;
    rdfs:domain va:FamilyConstraint ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The position of the constraint among the constraints of the family."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:familyOrder a owl:DatatypeProperty ;
    rdfs:label "family order"@en ;
    rdfs:domain va:ProfileFamily ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The position of the profile in the family, from the root."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:contradictionElement a owl:ObjectProperty ;
    rdfs:label "contradiction element"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The element on which the two constraints disagree."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:contradictionAncestor a owl:ObjectProperty ;
    rdfs:label "contradicting ancestor"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:range va:ProfileFamily ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The ancestor profile with the constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:contradictionDescendant a owl:ObjectProperty ;
    rdfs:label "contradicting descendant"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:range va:ProfileFamily ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The descendant profile with the constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:contradictionConstraint a owl:ObjectProperty ;
    rdfs:label "contradicting constraint"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:range va:FamilyConstraint ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The descendant's constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:ancestorOperator a owl:DatatypeProperty ;
    rdfs:label "ancestor operator"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The operator of the ancestor's constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:descendantOperator a owl:DatatypeProperty ;
    rdfs:label "descendant operator"@en ;
    rdfs:domain va:FamilyContradiction ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The operator of the descendant's constraint."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- probe evidence
va:ProbeQuestion a owl:Class ;
    rdfs:label "probe question"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A question put to a probe: does the second method work after the first."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:pqFrom a owl:DatatypeProperty ;
    rdfs:label "first method"@en ;
    rdfs:domain va:ProbeQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The method called first."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:pqTo a owl:DatatypeProperty ;
    rdfs:label "second method"@en ;
    rdfs:domain va:ProbeQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The method called second."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:pvKind a owl:DatatypeProperty ;
    rdfs:label "verdict kind"@en ;
    rdfs:domain va:ProbeQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The kind of verdict the probe gave."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:pvWhy a owl:DatatypeProperty ;
    rdfs:label "verdict reason"@en ;
    rdfs:domain va:ProbeQuestion ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "Why the probe gave that verdict."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:poMethod a owl:DatatypeProperty ;
    rdfs:label "observed method"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The method a probe observation is about."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:poAfter a owl:DatatypeProperty ;
    rdfs:label "observed after"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The method called before it, or none."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:poResult a owl:DatatypeProperty ;
    rdfs:label "observed result"@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "What the probe saw."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- documentation rules
va:DocClause a owl:Class ;
    rdfs:label "clause"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A sentence of a document, read for relations between members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:DocRelation a owl:Class ;
    rdfs:label "relation read from documents"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A relation between members that the document rules read from a clause."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:clauseText a owl:DatatypeProperty ;
    rdfs:label "clause text"@en ;
    rdfs:domain va:DocClause ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The words of the clause."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:tokIn a owl:ObjectProperty ;
    rdfs:label "token in clause"@en ;
    rdfs:domain va:Token ;
    rdfs:range va:DocClause ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The clause a token lies in."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:tokIndex a owl:DatatypeProperty ;
    rdfs:label "token position"@en ;
    rdfs:domain va:Token ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The position of the token in its clause."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:tokWord a owl:DatatypeProperty ;
    rdfs:label "token word"@en ;
    rdfs:domain va:Token ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The lower-cased word."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:tokMentions a owl:ObjectProperty ;
    rdfs:label "token mentions"@en ;
    rdfs:domain va:Token ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member the token names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:docFrom a owl:ObjectProperty ;
    rdfs:label "relation starts at"@en ;
    rdfs:domain va:DocRelation ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member the relation starts from."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:docTo a owl:ObjectProperty ;
    rdfs:label "relation ends at"@en ;
    rdfs:domain va:DocRelation ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member the relation points to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:docKind a owl:DatatypeProperty ;
    rdfs:label "relation kind"@en ;
    rdfs:domain va:DocRelation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The kind of relation read."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:docWhy a owl:DatatypeProperty ;
    rdfs:label "relation reason"@en ;
    rdfs:domain va:DocRelation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The words that give the relation."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:Token a owl:Class ;
    rdfs:label "token"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A word of a clause with its position."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- dependence model
va:DepAtom a owl:Class ;
    rdfs:label "member of a class"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member of a class that a variant may need: a method, an attribute, a state value or an exception."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:DepUsage a owl:Class ;
    rdfs:label "use of a member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "One use of a member by a method: it reads, writes, assigns, initialises, raises or calls it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:DepRelation a owl:Class ;
    rdfs:label "needed relation"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A relation the dependence rules decided between two members: one needs the other."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:depKind a owl:DatatypeProperty ;
    rdfs:label "member kind"@en ;
    rdfs:domain va:DepAtom ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "method, attribute, state value or exception."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:depValueOf a owl:ObjectProperty ;
    rdfs:label "state value of"@en ;
    rdfs:domain va:DepAtom ;
    rdfs:range va:DepAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The attribute that a state value is a value of."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:usageBy a owl:ObjectProperty ;
    rdfs:label "used by"@en ;
    rdfs:domain va:DepUsage ;
    rdfs:range va:DepAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The method that makes the use."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:usageOf a owl:ObjectProperty ;
    rdfs:label "used member"@en ;
    rdfs:domain va:DepUsage ;
    rdfs:range va:DepAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member that is used."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:usageRole a owl:DatatypeProperty ;
    rdfs:label "use role"@en ;
    rdfs:domain va:DepUsage ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "reads, writes, assigns, initialises, raises or calls."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:relFrom a owl:ObjectProperty ;
    rdfs:label "needs from"@en ;
    rdfs:domain va:DepRelation ;
    rdfs:range va:DepAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member that needs the other."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:relTo a owl:ObjectProperty ;
    rdfs:label "needs to"@en ;
    rdfs:domain va:DepRelation ;
    rdfs:range va:DepAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The member that is needed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:relKind a owl:DatatypeProperty ;
    rdfs:label "relation kind"@en ;
    rdfs:domain va:DepRelation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "Why it is needed: uses, reads, writes, raises, calls or sets."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:relWhy a owl:DatatypeProperty ;
    rdfs:label "relation reason"@en ;
    rdfs:domain va:DepRelation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A plain sentence that says why."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- usefulness of variants
va:UvAtom a owl:Class ;
    rdfs:label "declared member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member of the class a variant may select."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:UvMember a owl:Class ;
    rdfs:label "selected member"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member as a variant selects it."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:UvVariant a owl:Class ;
    rdfs:label "variant to judge"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A variant of the class, with the members it selects."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvName a owl:DatatypeProperty ;
    rdfs:label "member name"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The name of the member."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvKind a owl:DatatypeProperty ;
    rdfs:label "member kind"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "method, attribute, state value or exception."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvIndex a owl:DatatypeProperty ;
    rdfs:label "member position"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The position of the member among the class's members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvOptional a owl:DatatypeProperty ;
    rdfs:label "declared optional"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the model declares the member optional."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvLink a owl:ObjectProperty ;
    rdfs:label "related by use"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member related to this one by use."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvUses a owl:ObjectProperty ;
    rdfs:label "uses member"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A same-class member this method uses."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvDelegates a owl:DatatypeProperty ;
    rdfs:label "delegates"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the method calls into another class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvAdj a owl:ObjectProperty ;
    rdfs:label "adjacent member"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member linked to this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvSame a owl:ObjectProperty ;
    rdfs:label "same group"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member in the same group of linked members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvGroup a owl:DatatypeProperty ;
    rdfs:label "group"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The number of the group of linked members."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvProcesses a owl:DatatypeProperty ;
    rdfs:label "processes"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the member processes."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvOwnProcessing a owl:DatatypeProperty ;
    rdfs:label "has own processing"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the member has processing of its own."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvMeaning a owl:DatatypeProperty ;
    rdfs:label "has meaning"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the member has a meaning by itself."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvHas a owl:ObjectProperty ;
    rdfs:label "variant has member"@en ;
    rdfs:domain va:UvVariant ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A member the variant selects."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvAtom a owl:ObjectProperty ;
    rdfs:label "member atom"@en ;
    rdfs:domain va:UvMember ;
    rdfs:range va:UvAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The declared member a selection stands for."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvOfVariant a owl:ObjectProperty ;
    rdfs:label "member of variant"@en ;
    rdfs:domain va:UvMember ;
    rdfs:range va:UvVariant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The variant the selection belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvReason a owl:DatatypeProperty ;
    rdfs:label "reason it is not useful"@en ;
    rdfs:domain va:UvVariant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A plain sentence that says what is wrong with the variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvUseful a owl:DatatypeProperty ;
    rdfs:label "useful"@en ;
    rdfs:domain va:UvVariant ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when no reason was found."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvDeadFeature a owl:DatatypeProperty ;
    rdfs:label "dead feature"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the member is in no variant of the class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvFalseOptional a owl:DatatypeProperty ;
    rdfs:label "false optional feature"@en ;
    rdfs:domain va:UvAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the member is declared optional and is in every variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- realisation (variant_realise_backend)
va:RealAtom a owl:Class ;
    rdfs:label "feature in the program"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A discovered feature that occurs in the program (a method, attribute, state value, exception or external)."@en ;
    rdfs:subClassOf va:DiscoveredFeature ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:RealStatement a owl:Class ;
    rdfs:label "statement of the program"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "One statement of the harvested program."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:GroupStatement a owl:Class ;
    rdfs:label "statement in a group"@en ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A statement that the group rules link to others that name a common feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:atomSelected a owl:DatatypeProperty ;
    rdfs:label "selected"@en ;
    rdfs:domain va:RealAtom ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the variant selects the feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:atomCount a owl:DatatypeProperty ;
    rdfs:label "repetition count"@en ;
    rdfs:domain va:RealAtom ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The repetition count of the feature."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:stmtParent a owl:ObjectProperty ;
    rdfs:label "enclosing statement"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range va:RealStatement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The statement that encloses this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:stmtRefers a owl:ObjectProperty ;
    rdfs:label "statement refers to"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range va:RealAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the statement's own header expression names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:stmtRefersValue a owl:ObjectProperty ;
    rdfs:label "statement refers to value"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range va:RealAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The state value of an assignment to an attribute."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:dropsWhenVacuous a owl:DatatypeProperty ;
    rdfs:label "drops when vacuous"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the statement goes if its body is left empty."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:inInit a owl:DatatypeProperty ;
    rdfs:label "in the constructor"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the statement is in the constructor."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:assignsAttr a owl:ObjectProperty ;
    rdfs:label "assigns attribute"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range va:RealAtom ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The attribute the statement assigns."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:loopBound a owl:DatatypeProperty ;
    rdfs:label "literal loop bound"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The literal bound of a loop."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:loopAdds a owl:DatatypeProperty ;
    rdfs:label "amount the loop adds"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The amount a loop adds on each pass."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:needsTruth a owl:DatatypeProperty ;
    rdfs:label "needs truth"@en ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the statement is true only if the feature it names is present."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:realDrop a owl:DatatypeProperty ;
    rdfs:label "dropped"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the statement is not in the variant."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:realRewriteNone a owl:DatatypeProperty ;
    rdfs:label "rewritten to unset"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when an initial assignment keeps the attribute but starts it unset."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:realRewriteBound a owl:DatatypeProperty ;
    rdfs:label "rewritten bound"@en ;
    rdfs:domain va:RealStatement ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The repetition count that replaces a literal loop bound."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- group statements (evaluator)
va:gsGroup a owl:DatatypeProperty ;
    rdfs:label "group number"@en ;
    rdfs:domain va:GroupStatement ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The number of the group of linked statements."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:gsIndex a owl:DatatypeProperty ;
    rdfs:label "position"@en ;
    rdfs:domain va:GroupStatement ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The position of the statement among the statements of the model."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:gsNames a owl:ObjectProperty ;
    rdfs:label "names feature"@en ;
    rdfs:domain va:GroupStatement ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A feature the statement names."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:gsLinked a owl:ObjectProperty ;
    rdfs:label "linked statement"@en ;
    rdfs:domain va:GroupStatement ;
    rdfs:range va:GroupStatement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A statement that names a feature in common with this one."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:gsSameGroup a owl:ObjectProperty ;
    rdfs:label "same group"@en ;
    rdfs:domain va:GroupStatement ;
    rdfs:range va:GroupStatement ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A statement in the same group."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ---- candidate review
va:hasGuardCondition a owl:ObjectProperty ;
    rdfs:label "has guard condition"@en ;
    rdfs:domain va:CandidateReview ;
    rdfs:range va:Feature ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A guard condition that is correlated with the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:reviewCondition a owl:DatatypeProperty ;
    rdfs:label "review condition"@en ;
    rdfs:domain va:CandidateReview ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A condition the review rules read for the candidate."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:groupsVariant a owl:ObjectProperty ;
    rdfs:label "variant in the group"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A variant that the probe observed to behave like the others of the group."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:probesMethod a owl:ObjectProperty ;
    rdfs:label "method put to the probe"@en ;
    rdfs:domain va:ProbeQuestion ;
    rdfs:range va:Method ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "A method named by the question: the first one, after which the second is called."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:uvClass a owl:ObjectProperty ;
    rdfs:label "class the member or variant belongs to"@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( va:UvAtom va:UvVariant ) ] ;
    rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The class whose member a variant may select, or whose variant is judged."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:depAtomIn a owl:ObjectProperty ;
    rdfs:label "class of the member"@en ;
    rdfs:domain va:DepAtom ;
    rdfs:range va:Class ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The class that the member belongs to."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# VAF-WI-256: the grouping of variants into behaviour classes is rules (written 2026-10-21).

va:variantPosition a owl:DatatypeProperty ;
    rdfs:label "position of the variant"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The place of the variant among those listed, in the order they were listed."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:selectionSize a owl:DatatypeProperty ;
    rdfs:label "size of the selection"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "How many features the variant selects."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:observationSignature a owl:DatatypeProperty ;
    rdfs:label "observation signature"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "What the probe observed of the program the variant was turned into: the methods a caller can use, the calls and their results, the attributes seen; variants with the same signature behave alike."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:hasRealisedProgram a owl:DatatypeProperty ;
    rdfs:label "has a realised program"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the variant was turned into a program that could be observed; a variant without one is not classified."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:observedMethodCount a owl:DatatypeProperty ;
    rdfs:label "methods observed"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "How many methods a caller can use in the variant's program."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:probeRan a owl:DatatypeProperty ;
    rdfs:label "probe ran"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when a probe ran on the variant's program."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:behavesAsOriginal a owl:DatatypeProperty ;
    rdfs:label "behaves as the original"@en ;
    rdfs:domain va:Variant ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "True when the probe saw the variant's program behave as the original on every call tried."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcRepresentative a owl:ObjectProperty ;
    rdfs:label "representative variant"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range va:Variant ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The smallest selection of the class, the earliest listed when several are as small."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcFirstPosition a owl:DatatypeProperty ;
    rdfs:label "first position"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The place of the first variant listed that belongs to the class."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcKey a owl:DatatypeProperty ;
    rdfs:label "key of the class"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The name of the class: B and the place of its first variant among the classes, in the order they were first seen."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

va:bcOrdinal a owl:DatatypeProperty ;
    rdfs:label "ordinal of the class"@en ;
    rdfs:domain va:BehaviourClass ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/runtime-vocabulary> ;
    skos:definition "The place of the class when classes are listed by rank, then largest first, then by key; the first is 0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/runtime-vocabulary> .

# ==== file variant_algebra_temporal_occurrences_v1_0_2.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix core:    <http://example.org/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra — Temporal descriptors and occurrences v1.0.0
#
# Owner clarification, 2026-09-25: "for a->b, a>->b relations b->a and b>->a are possible with or without
# conditions ... natural in loops, state machines, workflows and algorithms ... not exclusive when they are
# descriptors. But in run-time each one becomes time stamped and a1 is not equal to a2, b1 is not equal to b2."
#
# Two levels, kept apart so that the strictness of time never forbids a loop in a description:
#   DESCRIPTOR level  features, states, steps. 'a -> b' / 'a >-> b' say b MAY follow a (immediately / later),
#                     optionally under a condition. Neither transitive-strict nor exclusive: cycles are allowed.
#   OCCURRENCE level  each activation of a descriptor is its own time-stamped individual (a PROV activity).
#                     Occurrences are STRICTLY ordered by core:precedes (transitive; OWL-Time / Allen grounded)
#                     and va:immediatelyPrecedes (nothing in between). This is where 'strict' lives.
# Link: every immediate succession between occurrences must be licensed by a descriptor edge between what
# they are occurrences of (shapes: variant_algebra_temporal_occurrence_shapes_v1_1_0.ttl).
# ============================================================

<http://example.org/variant-algebra/temporal-occurrences> owl:versionInfo "1.0.2" ;
    owl:versionIRI <http://example.org/variant-algebra/temporal-occurrences/1.0.2> ;
    owl:priorVersion <http://example.org/variant-algebra/temporal-occurrences/1.0.1> ;
    dcterms:title "Variant Algebra — Temporal descriptors and occurrences"@en ;
    owl:imports <http://example.org/variant-algebra/temporal-operators>, <http://www.w3.org/ns/prov-o> ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_temporal_occurrences_v1_0_2"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------- descriptor level ----------------
va:mayBeFollowedBy a owl:ObjectProperty ;
    rdfs:label "may be followed by"@en ;
    skos:definition "Descriptor level (Sequence, a >-> b): an occurrence of the object may come after an occurrence of the subject, with any number of steps between. Not transitive and not asymmetric: a >-> b and b >-> a may both hold, as in loops, state machines and workflows."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:mayBeImmediatelyFollowedBy a owl:ObjectProperty ;
    rdfs:subPropertyOf va:mayBeFollowedBy ;
    rdfs:label "may be immediately followed by"@en ;
    skos:definition "Descriptor level (Next, a -> b): an occurrence of the object may come directly after an occurrence of the subject. May be cyclic, including a -> a (a loop that repeats a step)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:DescriptorEdge a owl:Class ;
    rdfs:label "Descriptor edge"@en ;
    skos:definition "One descriptor-level Next or Sequence relation, reified so that it can carry a condition -- the 'with or without conditions' of the owner's clarification (for instance a guard: 'ship only when the state is confirmed')."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:edgeFrom a owl:ObjectProperty ; rdfs:label "edge from"@en ; rdfs:domain va:DescriptorEdge ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:edgeTo a owl:ObjectProperty ; rdfs:label "edge to"@en ; rdfs:domain va:DescriptorEdge ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:edgeOperator a owl:ObjectProperty ; rdfs:label "edge operator"@en ; rdfs:domain va:DescriptorEdge ;
    skos:definition "va:NextOperator or va:SequenceOperator."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:edgeCondition a owl:DatatypeProperty ; rdfs:label "edge condition"@en ; rdfs:domain va:DescriptorEdge ;
    skos:definition "The condition under which the edge may be taken, as an algebraic expression; absent when unconditional."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .

# ---------------- occurrence level ----------------
va:Occurrence a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Occurrence"@en ;
    skos:definition "One run-time activation of a descriptor -- a visit to a state, an execution of a step, a call, a firing of an event. Two activations of the same descriptor are two occurrences (a1 is not a2), told apart by their time."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:occurrenceOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain va:Occurrence ; rdfs:label "occurrence of"@en ;
    skos:definition "The descriptor (feature, state, step) this occurrence activates."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:occurrenceIndex a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain va:Occurrence ; rdfs:range xsd:nonNegativeInteger ; rdfs:label "occurrence index"@en ;
    skos:definition "Position of the occurrence in its trace, counted from 0: the logical time stamp. prov:startedAtTime carries the clock time when one was recorded."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:inTrace a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain va:Occurrence ; rdfs:label "in trace"@en ;
    skos:definition "The trace (one run) the occurrence belongs to. Order is strict within a trace; occurrences of different runs are not ordered."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:Trace a owl:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Trace"@en ;
    skos:definition "One run: the time-stamped occurrences observed or produced in a single execution."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .

# ---------------- state and conditioned edges (VAF-WI-230) ----------------
va:stateRecorded a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain va:Occurrence ; rdfs:range xsd:boolean ; rdfs:label "state recorded"@en ;
    skos:definition "True when the occurrence carries a recorded state (the features that hold at it, va:holdsFeature, possibly none). An edge condition is judged only on a recorded state: with none, the condition is unknown and licenses nothing."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:holdsFeature a owl:ObjectProperty ;
    rdfs:domain va:Occurrence ; rdfs:range va:Feature ; rdfs:label "holds feature"@en ;
    skos:definition "A feature that holds in the state of the occurrence (count one). The condition of an edge leaving the occurrence's descriptor is evaluated over these features."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .
va:edgeHolds a owl:ObjectProperty ;
    rdfs:domain va:Occurrence ; rdfs:range va:DescriptorEdge ; rdfs:label "edge holds"@en ;
    skos:definition "The condition of the edge, evaluated by the operator rules' truth (variant_native_evaluator expression_holds) over the occurrence's recorded state, is true. Computed, never asserted by hand: validate_occurrences writes it before the shapes run. An edge without a condition needs no such fact."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .

# core:precedes (transitive) and va:immediatelyPrecedes (its non-transitive specialisation) order OCCURRENCES.
va:immediatelyPrecedes skos:scopeNote "Since 2026-09-25: an occurrence-level relation. Descriptor-level immediate succession is va:mayBeImmediatelyFollowedBy, which may cycle."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#Trace> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: its superclass Activity (http://www.w3.org/ns/prov) is declared outside this file, so the link leaves the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-occurrences> .

# ==== file variant_algebra_temporal_operators_v1_0_2.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix core:    <http://example.org/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra — Temporal operators v1.0.0 (extension file; the base ontology is not mutated)
#
# Owner selection, 2026-09-24: "Temporal family + Sequence, and add Next now".
# Lock #5 (conditional closure) permits these as non-core operators with full extension metadata.
# Lock #5C (blueprint v3.0.4 lock #5b) keeps the operator hierarchy flat, so "Temporal" is a
# family CLASSIFICATION on each operator, not an operator superclass.
# Lock #4 reserves va:precedes for code-segment order inside one body; these operators do not use it.
# Facts (corrected 2026-09-25, owner clarification): at the DESCRIPTOR level they are va:mayBeFollowedBy and
# va:mayBeImmediatelyFollowedBy, which may cycle; at the OCCURRENCE level (time-stamped activations) they are
# core:precedes (transitive, OWL-Time / Allen) and va:immediatelyPrecedes. See temporal-occurrences.
# Symbols (owner, 2026-09-25): Next "->", Sequence ">->".
# ============================================================

<http://example.org/variant-algebra/temporal-operators> owl:versionInfo "1.0.2" ;
    owl:versionIRI <http://example.org/variant-algebra/temporal-operators/1.0.2> ;
    owl:priorVersion <http://example.org/variant-algebra/temporal-operators/1.0.1> ;
    dcterms:title "Variant Algebra — Temporal operators"@en ;
    owl:imports <http://example.org/core> ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_temporal_operators_v1_0_2"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------- operator families (classification, not hierarchy) ----------------
va:operatorFamily a owl:AnnotationProperty ;
    rdfs:label "operator family"@en ;
    skos:definition "Groups operators by what they constrain, without introducing an operator superclass (Lock #5C keeps the hierarchy flat)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-operators> .

# ---------------- Sequence ----------------
va:SequenceOperator a owl:Class ;
    rdfs:subClassOf va:Operator ;
    rdfs:label "Sequence operator"@en ;
    skos:definition "a >-> b. Descriptor level: b may follow a, with steps between; may cycle (b >-> a may also hold). In a variant (composed with Dependency, owner decision 1): b is never present without a. At run time, occurrences are strictly ordered by the core relation 'precedes'."@en ;
    va:operatorFamily va:Family_Temporal ;
    va:hasComputationalComplexity va:Complexity_OrderPairTrace ;
    va:isCoreOperator false ;
    va:operatorJustification "Behaviour needs order: state moves (confirm before ship), workflow stages (discover before convert) and lineage stages happen in an order that no existing operator can state. Measured in the behavioural taxonomy: step order had no operator."@en ;
    va:operatorSemanticNonOverlap "Dependency (a requires b) constrains co-presence in a variant regardless of order; Sequence constrains order during execution and says nothing about co-presence. Exclusive, Or, Addition and Repetition likewise constrain which features coexist or how many, never when. Inverse removes a feature from a variant; it cannot say 'from this point on'. No existing operator, alone or composed, distinguishes 'a then b' from 'b then a'."@en ;
    va:notExpressibleByCalculi "Guard Precondition (C31) finds 'ship only when state is confirmed' but can only emit ship < state_confirmed, losing that confirm_payment happens before ship. Inverse (C28) emits a bare 'not gift_wrap', removing gift-wrap from every variant where the code meant 'after checkout' (the Shopping cart flaw). Composing existing operators cannot recover the lost order, because every existing operator is invariant under reordering."@en ;
    va:approvalProvenance va:Approval_TemporalOperators_2026_09_24 ;
    rdfs:seeAlso core:precedes ;
    va:operatorSymbol ">->" ;
    va:operatorPrecedence "0"^^xsd:nonNegativeInteger ;
    skos:note "Symbol '>->' decided by the owner 2026-09-25 (va:Decision_OperatorSymbols_2026_09_24); in the grammar since VAF v2.81.0, loosest-binding (disclosed default for VAF-WI-065)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-operators> .

# ---------------- Next ----------------
va:NextOperator a owl:Class ;
    rdfs:subClassOf va:Operator ;
    rdfs:label "Next operator"@en ;
    skos:definition "a -> b. Descriptor level: b may follow a immediately; may cycle, including a -> a. In a variant: b is never present without a. At run time, an occurrence of b immediately after an occurrence of a is licensed by this edge."@en ;
    va:operatorFamily va:Family_Temporal ;
    va:hasComputationalComplexity va:Complexity_OrderPairTrace ;
    va:isCoreOperator false ;
    va:operatorJustification "Some orders are immediate: a state move leads directly to the next state; a method's calls follow one another; a pipeline stage hands off to the next. Sequence cannot say 'nothing in between'."@en ;
    va:operatorSemanticNonOverlap "Sequence allows any number of steps between a and b and is transitive; Next allows none and is not transitive. Next is strictly stronger than Sequence, so neither is expressible by the other: Sequence cannot exclude intermediate steps, and Next cannot express 'eventually'."@en ;
    va:notExpressibleByCalculi "Call-order and state-move discovery need to record direct succession (confirmed then shipped, not merely before). Sequence composed with any existing operator still permits intermediate steps."@en ;
    va:approvalProvenance va:Approval_TemporalOperators_2026_09_24 ;
    rdfs:seeAlso core:precedes ;
    va:operatorSymbol "->" ;
    va:operatorPrecedence "0"^^xsd:nonNegativeInteger ;
    skos:note "Symbol '->' decided by the owner 2026-09-25 (va:Decision_OperatorSymbols_2026_09_24); in the grammar since VAF v2.81.0."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-operators> .

# ---------------- the relations their facts materialise as ----------------
va:immediatelyPrecedes a owl:ObjectProperty ;
    rdfs:subPropertyOf core:precedes ;
    rdfs:label "immediately precedes"@en ;
    skos:definition "The subject is followed by the object with no step in between. Not transitive; entails core 'precedes'. Distinct from va:precedes, which Lock #4 reserves for code-segment order inside one method body."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/temporal-operators> .

# ==== file variant_algebra_thesis_foundations_v1_0_80.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- thesis foundations v1.0.0 (extension file; the base ontology is not mutated here).
# Thesis content the ontology did not hold, captured on 2026-09-27 (VAF-WI-102, Lineage 5). Each item is the
# disposition of a record in variant_algebra_thesis_reconciliation_v1_0_0.ttl (va:Div_D1 ... va:Div_D12).
# Source: the Turkish thesis text in 00-grounding-sources/ (sections and equation numbers re-read from it).
# The ontology is the authority and the thesis the origin (va:Decision_OntologyOverThesis_2026_09_27): where the
# ontology already decided otherwise, the captured item says so rather than overriding it.
# ============================================================

<http://example.org/variant-algebra/thesis-foundations> owl:versionInfo "1.0.80" ;
    owl:versionIRI <http://example.org/variant-algebra/thesis-foundations/1.0.80> ;
    owl:priorVersion <http://example.org/variant-algebra/thesis-foundations/1.0.79> ;
    dcterms:modified "2026-09-27"^^xsd:date ;
    dcterms:title "Variant Algebra -- thesis foundations"@en ;
    dcterms:source "Altunel 2013, sections 2.1.4, 2.2.1-2.2.5, 2.2.7.1 and 2.2.9"@en ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_thesis_foundations_v1_0_80"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------- D4: the algebra (§2.2.1-2.2.2, eq. 2.7-2.8) ----------------
va:Algebra a owl:Class ;
    rdfs:label "Algebra (Λ)"@en ; skos:altLabel "Cebir"@tr ;
    skos:definition "The variant algebra as a tuple Λ = <Ψ, Φ, Δ, Γ>: the elements it defines (Ψ), the attributes elements may have (Φ, a subset of Ψ), the operations (Δ) and all operation-element combinations the algebra applies (Γ)."@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.8"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:hasElementSet a owl:ObjectProperty ; rdfs:domain va:Algebra ; rdfs:label "has element set (Ψ)"@en ;
    skos:definition "The elements the algebra defines: Entity, Annotation, Application, Package, Class, Component, Variant, Interface, Attribute, Repetition, Feature, Method, Signature, Parameter, Operation, Body, Aspect, Comment, Literal, Message, ... (thesis eq. 2.8). Each is a class of this ontology."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:hasAttributeSet a owl:ObjectProperty ; rdfs:domain va:Algebra ; rdfs:label "has attribute set (Φ)"@en ;
    skos:definition "The attributes elements may have; Φ ⊆ Ψ (thesis eq. 2.8)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:hasOperationSet a owl:ObjectProperty ; rdfs:domain va:Algebra ; rdfs:label "has operation set (Δ)"@en ;
    skos:definition "The operations: Δ = {!, +, ',', -, |, $, *, /, #, <, >, {}, []} (thesis eq. 2.8). The ontology's operators and their departures from Δ are listed on va:Operator."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:hasCombinationSet a owl:ObjectProperty ; rdfs:domain va:Algebra ; rdfs:label "has combination set (Γ)"@en ;
    skos:definition "Every operation-element combination the algebra applies, Γ = Σ e_i ω_j e_k (thesis eq. 2.8)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D5: a component's relations; the empty component (eq. 2.9) ----------------
va:hasRelationVector a owl:ObjectProperty ; rdfs:domain va:Component ;
    rdfs:label "has relation vector (Rc)"@en ;
    skos:definition "A component is C = <Fc, Rc>: its feature vector Fc (va:hasFeature) and the relations Rc defined among those features. In this ontology each relation is a statement of the component's model -- an operator applied to its features (va:hasOperator)."@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.9"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:EmptyComponent a owl:Class ; rdfs:subClassOf va:Component ;
    rdfs:label "Empty component (C∅)"@en ;
    skos:definition "The component with no features and no relations (thesis eq. 2.9: i = j = m = n = 0)."@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.9"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D6: the feature space (eq. 2.15-2.16) ----------------
va:FeatureSpace a owl:Class ;
    rdfs:label "Feature space (F)"@en ; skos:altLabel "Nitelik uzayı"@tr ;
    skos:definition "The features of a component laid out as a two-dimensional matrix, f_ij the feature in row i, column j; with no rows or columns it is the empty space F∅. The ontology holds the same features as a set (va:hasFeature); the matrix is the thesis's notation for it, not extra structure."@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.15-2.16"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D7: a component is the union of its variants (eq. 2.17-2.19) ----------------
va:Component skos:note "Thesis foundations (captured 2026-09-27): a component is the union of its variants, C = V1 ∪ ... ∪ Vn (eq. 2.18), and every variant differs from every other in at least one element (eq. 2.19). A variant V(Fi) is a vector of features chosen from the component's feature space (eq. 2.17); with none chosen it is the empty variant V∅. The ontology's variants are compared by count as well as by presence (owner, 2026-09-25: repetition), which refines 'differs in at least one element' to 'differs in at least one element or count'."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:EmptyVariant a owl:Class ; rdfs:subClassOf va:Variant ;
    rdfs:label "Empty variant (V∅)"@en ;
    skos:definition "The variant with no features (thesis §2.2.2, after eq. 2.18)."@en ;
    dcterms:source "Altunel 2013 §2.2.2"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D8: entity sets and entity pairs (eq. 2.20, 2.27) ----------------
va:EntitySet skos:note "Thesis foundations (captured 2026-09-27): the elements of an entity set are independent of one another, and the empty set is an entity set (eq. 2.20)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:EntityPair skos:note "Thesis foundations (captured 2026-09-27): an entity pair whose two members are both the operation's identity element gives the empty set, (ε, ε) = ∅ (eq. 2.27)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D9: combining operation sets; from operation set to variants (Figure 2.2, eq. 2.25) ----------------
va:VariantTransformation skos:note "Thesis foundations (captured 2026-09-27): an operation set O(ω) is turned into variants V(ω) by taking, for each of its entity sets, the features it holds (eq. 2.25); operation sets are combined before the conversion (Figure 2.2). In the pipeline this is the conversion step (va:Step_Conversion)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D10: the thesis's five stages and the pipeline (§2.2.9) ----------------
va:ThesisStage a owl:Class ;
    rdfs:label "Thesis stage of variant production"@en ;
    skos:definition "One of the five stages in which the thesis produces variants (§2.2.9): definition, parsing, conversion to an intermediate form, application and synthesis. Each is placed in the one governing pipeline definition (variant_algebra_pipeline_workflow_v1_1_80.ttl)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:realisedInStep a owl:ObjectProperty ; rdfs:domain va:ThesisStage ; rdfs:range va:PipelineStep ; rdfs:label "realised in step"@en ;
    skos:definition "The pipeline step in which a thesis stage happens."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:thesisStageOrder a owl:DatatypeProperty ; rdfs:domain va:ThesisStage ; rdfs:range xsd:positiveInteger ; rdfs:label "thesis stage order"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D11: grouping and bracketed repetition as precedence levels (Table 2.5) ----------------
va:NotationConstruct a owl:Class ;
    rdfs:label "Notation construct"@en ;
    skos:definition "A bracketing form that has a level in the thesis's precedence table (Table 2.5) without being an operator of its own."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D12: attribute and parameter list (eq. 2.10, 2.14) ----------------
va:Attribute skos:note "Thesis foundations (captured 2026-09-27): an attribute is the tuple <Visibility, Type, Name, InitialValue> (eq. 2.10). If its type is another entity the attribute is a sub-component; otherwise its type is primitive, a structure the programming language defines."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:ParameterList a owl:Class ;
    rdfs:label "Parameter list"@en ; skos:altLabel "Parametre listesi"@tr ;
    skos:definition "Zero or more parameters, each a pair <ParameterType, ParameterName> (eq. 2.14); part of a method's signature <ReturnType, Name, ParameterList> (eq. 2.12)."@en ;
    dcterms:source "Altunel 2013 §2.2.2 eq. 2.12, 2.14"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ---------------- D1: variation capacity, the thesis's formulas (§2.1.4) ----------------
va:ThesisCapacityFormula a owl:Class ;
    rdfs:label "Thesis variation-capacity formula"@en ;
    skos:definition "The thesis's analytic estimate of how many variants a component can have (VK, §2.1.4). Mandatory and repeated elements are left out because they add no variety (repetition is treated as one collection). The thesis says the general formula usually cannot be applied as it stands; the model must first be reduced to optional, exclusive and dependent sets. The ontology's capacity is the count of variants at a declared bound (va:VariationCapacityMetric; owner, 2026-09-25, counts repetition), so these formulas are kept as the thesis's estimate, not as the definition."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:formulaText a owl:DatatypeProperty ; rdfs:domain va:ThesisCapacityFormula ; rdfs:range xsd:string ; rdfs:label "formula"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .
va:VariationCapacityMetric skos:note "Thesis foundations (captured 2026-09-27): the thesis's analytic formulas are recorded as va:ThesisCapacityFormula individuals. 'truncatedCapacityRatio' in the definition above names no property of this ontology; under a declared bound the capacity is the number of variants the bound admits."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# links from the definitions and examples that name another term (VAF-WI-252)
va:ThesisCapacityFormula rdfs:seeAlso va:VariationCapacityMetric ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# VAF-WI-253: links between classes (written 2026-10-20). Each says which class a class is joined to, from what its definition states.
va:hasFeatureSpace a owl:ObjectProperty ;
    rdfs:label "feature space"@en ;
    rdfs:domain va:Component ;
    rdfs:range va:FeatureSpace ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/thesis-foundations> ;
    skos:definition "The features of the component laid out as the thesis writes them, in rows and columns."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

va:notationFormOf a owl:ObjectProperty ;
    rdfs:label "operator the bracketing form is for"@en ;
    rdfs:domain va:NotationConstruct ;
    rdfs:range va:Operator ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/thesis-foundations> ;
    skos:definition "The operator whose operand the bracketing form encloses, or that it changes the order of."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

va:hasParameterList a owl:ObjectProperty ;
    rdfs:label "parameter list"@en ;
    rdfs:domain va:Signature ;
    rdfs:range va:ParameterList ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/thesis-foundations> ;
    skos:definition "The parameters of the signature (thesis eq. 2.12)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

va:estimatesCapacityOf a owl:ObjectProperty ;
    rdfs:label "component the formula estimates"@en ;
    rdfs:domain va:ThesisCapacityFormula ;
    rdfs:range va:Component ;
    rdfs:isDefinedBy <http://example.org/variant-algebra/thesis-foundations> ;
    skos:definition "The component whose number of variants the formula estimates."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# Connected outward only: recorded with the reason (WI-253).
<http://example.org/variant-algebra#Algebra> <http://www.w3.org/2004/02/skos/core#scopeNote> "Connected outward only: the relations that name this class lead to datatypes, to the class itself, or to terms that are not classes of this file, so no relation reaches another class of the file."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-foundations> .

# ==== file variant_algebra_thesis_reconciliation_v1_0_88.ttl ====
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- reconciliation with the thesis v1.0.0 (2026-09-27, VAF-WI-102, Lineage 5).
# Every point where the ontology and the thesis differ, recorded once, with one disposition.
# Checked by 02-shacl-safeguards/variant_algebra_thesis_reconciliation_shacl_v1_0_1.ttl; counted by
# 09-declarative-calculi/register_unreconciled_thesis_divergences_v1_0_0.sparql; tested by
# 06-runtime/src/test_thesis_reconciliation_v1_0_85.py. The measured thesis laws are generated into
# variant_algebra_thesis_laws_data_v1_0_33.ttl by 12-experiments/thesis_laws_check_v1_0_37.py.
# Locations: 'core' = variant_algebra_v3_2_7.ttl (3.2.6 before this work), 'OD' = owner decisions, 'GA' = grammar
# alignment, 'DEF' = definitions; thesis places are sections, equations, tables and figures of the Turkish original
# in 00-grounding-sources/, re-read for each record (the survey that listed them was a lead, not evidence).
# ============================================================

<http://example.org/variant-algebra/thesis-reconciliation> owl:versionInfo "1.0.88" ;
    owl:versionIRI <http://example.org/variant-algebra/thesis-reconciliation/1.0.88> ;
    owl:priorVersion <http://example.org/variant-algebra/thesis-reconciliation/1.0.87> ;
    skos:changeNote "1.0.7 (2026-09-28, VAF-WI-122): locations repointed to operator rules 7.0.0; no disposition changed."@en ;
    skos:changeNote "1.0.6 (2026-09-28, VAF-WI-121): locations repointed to operator rules 6.0.0; no disposition changed."@en ;
    skos:changeNote "1.0.5 (2026-09-28, VAF-WI-120): every thesis law that fails under the operator rules is a departure from the thesis and is recorded as a correction with the ruling that causes it (va:departureForLaw): four laws of Table 2.7."@en ;
    skos:changeNote "1.0.4 (2026-09-28, VAF-WI-119): C8 applied -- a dependency holds for the whole variant -- and the owner's ruling that an exclusion does too recorded as a correction of the thesis (va:Div_ExclusionWholeVariant)."@en ;
    skos:changeNote "1.0.3 (2026-09-27, VAF-WI-107): corrects 1.0.1, which named the Python definitions evaluator ('the generative reading') as the semantics. By the owner's clarification (va:Decision_OwnerClarification_2026_09_28) the semantics is the ontology's operator rules; the two law columns record two existing implementations, both to be re-measured under those rules (VAF-WI-100)."@en ;
    skos:changeNote "1.0.2 (2026-09-27, VAF-WI-106): C8's reason corrected. It had said the runtime already treats dependencies as global, which is false (a vacuous check); the ontology states the thesis rule, and applying it is to be built."@en ;
    skos:changeNote "1.0.1 (2026-09-27, VAF-WI-105): the owner's answers applied (va:Decision_OwnerAnswers_2026_09_27). The generative reading is the semantics; operators are generic. B8, C1 and C13 are settled by those rulings; B11 and C6 were put to the owner in error, their points having been decided on 2026-09-26 and 2026-09-25. No record awaits a decision."@en ;
    dcterms:modified "2026-09-28"^^xsd:date ;
    dcterms:title "Variant Algebra -- reconciliation with the thesis"@en ;
    dcterms:description "Authority: the ontology is the authority and the thesis is the origin (owner, 2026-09-27; va:Decision_OntologyOverThesis_2026_09_27). The thesis -- Altunel, Y. (2013), An Algebraic Approach for Generation of Software Component Variants, İstanbul University -- is where the algebra comes from; the ontology states what it means now. Each departure is recorded here with its reason; a departure without one is corrected or put to the owner; thesis content the ontology lacked is captured (variant_algebra_thesis_foundations_v1_0_80.ttl) or excluded with a reason."@en ;
    va:authorityDecision va:Decision_OntologyOverThesis_2026_09_27 ;
    <http://purl.org/dc/terms/identifier> "variant_algebra_thesis_reconciliation_v1_0_88"^^<http://www.w3.org/2001/XMLSchema#token> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------- vocabulary ----------------
va:authorityDecision a owl:AnnotationProperty ; rdfs:label "authority decision"@en ;
    skos:definition "The owner's decision that makes the ontology the authority over its source."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:ThesisDivergence a owl:Class ; rdfs:label "Thesis divergence"@en ;
    skos:definition "One point where the ontology and the thesis differ: something the ontology adds, changes, leaves out, or holds differently."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:DivergenceKind a owl:Class ; rdfs:label "Divergence kind"@en ;
    skos:definition "How the ontology-thesis comparison of 2026-09-27 classed a point before it was reconciled."@en ;
    owl:oneOf ( va:Kind_Extension va:Kind_Correction va:Kind_Unexplained va:Kind_Uncaptured ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:Disposition a owl:Class ; rdfs:label "Disposition"@en ;
    skos:definition "What was done with a divergence. Reconciled means the ontology now states the point or its reason."@en ;
    owl:oneOf ( va:Disp_ExtensionWithReason va:Disp_CorrectionWithReason va:Disp_CorrectedInOntology va:Disp_Captured va:Disp_ExcludedWithReason va:Disp_PutToOwner ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:isReconciled a owl:DatatypeProperty ; rdfs:domain va:Disposition ; rdfs:range xsd:boolean ; rdfs:label "is reconciled"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:surveyItem a owl:DatatypeProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range xsd:string ; rdfs:label "survey item"@en ;
    skos:definition "The point's number in the comparison of 2026-09-27 (A extensions, B corrections, C divergences, D uncaptured)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:baselineKind a owl:ObjectProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range va:DivergenceKind ; rdfs:label "baseline kind"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:hasDisposition a owl:ObjectProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range va:Disposition ; rdfs:label "has disposition"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:dispositionReason a owl:DatatypeProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range xsd:string ; rdfs:label "reason"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:ontologyLocation a owl:DatatypeProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range xsd:string ; rdfs:label "ontology location"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:thesisLocation a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "thesis location"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:resolvedIn a owl:DatatypeProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range xsd:string ; rdfs:label "resolved in"@en ;
    skos:definition "The file and version that now state the point."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:awaitsDecision a owl:ObjectProperty ; rdfs:domain va:ThesisDivergence ; rdfs:label "awaits decision"@en ;
    skos:definition "The owner decision, still pending, that settles the point."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:reclassifiedBecause a owl:DatatypeProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range xsd:string ; rdfs:label "reclassified because"@en ;
    skos:definition "Why re-checking the files changed the comparison's class for this point."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .

va:ThesisLaw a owl:Class ; rdfs:label "Thesis law"@en ;
    skos:definition "An algebraic law the thesis states for its operators (Tables 2.6 and 2.7), with whether it holds under each reading of the language, measured."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:LawKind a owl:Class ; rdfs:label "Law kind"@en ;
    owl:oneOf ( va:LawKind_Identity va:LawKind_Inverse va:LawKind_Idempotent va:LawKind_Commutative va:LawKind_Associative va:LawKind_Distributive ) ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:tagValue a owl:DatatypeProperty ; rdfs:domain va:LawKind ; rdfs:range xsd:string ; rdfs:label "tag value"@en ;
    skos:definition "The value of va:hasAlgebraicProperty that claims this kind of law."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:lawKind a owl:ObjectProperty ; rdfs:domain va:ThesisLaw ; rdfs:range va:LawKind ; rdfs:label "law kind"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:lawOperator a owl:ObjectProperty ; rdfs:domain va:ThesisLaw ; rdfs:range va:Operator ; rdfs:label "law operator"@en ;
    skos:definition "An operator the thesis law is about; a law about several operators names each."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:generativeReading a owl:DatatypeProperty ; rdfs:domain va:ThesisLaw ; rdfs:range xsd:string ; rdfs:label "under the generative reading"@en ;
    skos:definition "holds | fails | not evaluable, under the definitions evaluator (a Python implementation of the thesis's generator, §3.3). An existing implementation, not the semantics: the semantics is the ontology's operator rules (va:Decision_OwnerClarification_2026_09_28), under which the laws are to be re-measured (VAF-WI-100)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:featureModelReading a owl:DatatypeProperty ; rdfs:domain va:ThesisLaw ; rdfs:range xsd:string ; rdfs:label "under the feature-model reading"@en ;
    skos:definition "holds | fails | not evaluable, under the enumerator (which checks candidates with the ontology's operator rules and its own Python checks) applied to the definition desugared as a feature tree -- the desugar proposed in VAF-WI-097 and not adopted. An existing implementation, not the semantics."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:counterexample a owl:DatatypeProperty ; rdfs:domain va:ThesisLaw ; rdfs:range xsd:string ; rdfs:label "counterexample"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .
va:departureForLaw a owl:ObjectProperty ; rdfs:domain va:ThesisDivergence ; rdfs:range va:ThesisLaw ; rdfs:label "departure for law"@en ;
    rdfs:comment "The thesis law a departure is about: a law the thesis states that does not hold under the ontology's operator rules (1.0.5)."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/variant-algebra/thesis-reconciliation> .

# ==== file variant_algebra_usefulness_taxonomy_v1_0_0.ttl ====
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix va:      <http://example.org/variant-algebra#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# ============================================================
# Variant Algebra -- usefulness taxonomy, v1.0.0 (VAF-WI-137, 2026-10-04)  STATUS: PROPOSAL for owner review (L-116)
#
# Two taxonomies, both SKOS concept schemes, both read by the rules files (nothing here is decided in Python):
#   1. va:UsefulnessScheme -- what is wrong with a variant, how it is decided, and WHEN it can be decided
#      (before any variant is generated, as an expression of the model; when a variant is listed; once for the model; never,
#      only a label).
#   2. va:FeatureScheme -- what kinds of features a program has, by the three views the owner named (syntactic, semantic,
#      behavioural) plus the facets needed for full coverage, and the wording roles (part of speech) that point to them.
#
# Where each category comes from (so a reader can ask "why this and not the other"):
#   owner ruling 2026-10-04 -- single attribute, no processing, unrelated members, no semantics, no behaviour;
#   Fowler, Refactoring (smell catalogue, grouped as Bloaters, Object-Orientation Abusers, Change Preventers, Dispensables,
#     Couplers) -- Data Class, Lazy Class, Middle Man, Large Class;
#   Lanza and Marinescu, Object-Oriented Metrics in Practice -- the God Class rule is ATFD > few AND WMC >= very high (47)
#     AND TCC < one third: size alone never makes a class bad, size together with low cohesion does;
#   feature-model analysis (Benavides et al.; isa.us.es) -- void model, dead feature, false-optional feature, redundant constraint;
#   Meyer -- command-query separation (the semantic roles); Design by Contract (precondition, postcondition, invariant);
#   RFC 2119 -- MUST, MAY, MUST NOT as the modal words the algebra already has operators for.
# ============================================================

<http://example.org/vaf-consolidated/usefulness-taxonomy> rdfs:label "VAF Usefulness and Feature Taxonomy v1.0.0 (proposal)"@en ;
    dcterms:created "2026-10-04"^^xsd:date ;
    dcterms:identifier "variant_algebra_usefulness_taxonomy_v1_0_0" ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <http://example.org/vaf-consolidated/usefulness-taxonomy/1.0.0> ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .

# ---------------------------------------------------------------- properties
va:decidedAt a owl:ObjectProperty ; rdfs:label "the stage at which the usefulness category is decided today"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:earliestStage a owl:ObjectProperty ; rdfs:label "the earliest stage at which the category can in principle be decided (measured; see the changelog)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:expressibleAs a owl:DatatypeProperty ; rdfs:label "how the category is written as an expression of the model, when it can be"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:effect a owl:ObjectProperty ; rdfs:label "what the category does to a variant: removes it from processing, hides it by default, or only labels it"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:scopeOfJudgement a owl:DatatypeProperty ; rdfs:label "whether the category is a fact about one variant or about the whole model"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:origin a owl:DatatypeProperty ; rdfs:label "where the category comes from (owner ruling, catalogue, standard)"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:reasonPrefix a owl:DatatypeProperty ; rdfs:label "the opening words of the rule sentences that belong to this defect"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .
va:seesFeaturesAs a owl:ObjectProperty ; rdfs:label "the feature class a wording role points to"@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-consolidated/usefulness-taxonomy> .

# ==== file variant_algebra_v3_4_37.ttl ====
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oe: <http://example.org/ontology-engineering#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix va: <http://example.org/variant-algebra#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://example.org/variant-algebra> rdfs:label "Variant Algebra — Base Ontology v3.4.0"@en ;
    oe:testedBy va:VariantAlgebraV3TestSuite ;
    dcterms:created "2026-04-20"^^xsd:date ;
    dcterms:description "v3.0.0 is a major-version thesis-alignment rewrite. Supersedes v2.10.0. Adds the Ψ software-unit taxonomy, the 4 previously-unmodelled thesis algebraic operators (+, -, *, /, !), the Composition operator (⊕) with ports/contracts/wirings as a deliberate thesis extension, and the auxiliary algebraic structures (EntitySet, VariantSet, OperationSet, EntityPair) that the thesis defines in §2.2.4 but were never encoded."@en ;
    dcterms:modified "2026-09-28"^^xsd:date,
        "2026-06-01"^^xsd:date,
        "2026-04-28"^^xsd:date,
        "2026-04-30"^^xsd:date ;
    dcterms:replaces <http://example.org/variant-algebra/3.3.0> ;
    dcterms:source "Altunel, Yusuf (2013). Yazılım Bileşen Varyantlarının Üretimi için Cebirsel Bir Yaklaşım / An Algebraic Approach for Generation of Software Component Variants. PhD Thesis, İstanbul Üniversitesi, Advisor: Prof. Dr. A. Halim Zaim. Defended 30 January 2013."@en ;
    dcterms:subject "CQ-VA-1: What are the ten operators of the Variant Algebra and their precedence?"@en,
        "CQ-VA-2: Which software units are composable under the ⊕ operator?"@en,
        "CQ-VA-3: When is a composition's wiring valid?"@en,
        "CQ-VA-4: What is the ⊕ operator's interaction with the other operators?"@en ;
    rdfs:comment "v3.2.1 = v3.2.0 + 1 patch triple: va:DetectionCalculus rdfs:subClassOf va:Calculus. Fix surfaced by backlog v1.1.0 PBI-020 ASK query d3_q5 (probcalc distinct from detection). Root cause: PBI-006 rename created DetectionCalculus from DetectionHeuristic which inherited subClassOf SoftwareUnit (correct for v3.1.0) but the v4.0.0 archive's parallel DetectionCalculus is a Calculus subclass; v3.2.0 had the SoftwareUnit parent only. v3.2.1 adds the Calculus parent (multiple inheritance — both are correct: DetectionCalculus is a Computation-rule that observes SoftwareUnits). Predecessor v3.2.0 SHA-256 prefix: aa1f8e35286e."@en,
        "v3.2.2 hygiene patch: added rdfs:label / rdfs:isDefinedBy / dcterms:source on all named classes and properties to satisfy REDO v2.0.8 + META v1.0.1 SHACL gates. No vocabulary changes from v3.2.1; this is annotation-only."@en,
        "v3.2.4 = v3.2.3 + dual-typing patch for recursive feature/unit semantics. Per user-confirmed principle 2026-04-30: software units are compositions of features, and features themselves are either units (recursively decomposable) or terminal-level non-decomposable software ingredients. v3.2.4 promotes 13 classes (Method, Attribute, Signature, Body, Parameter, Operation, Annotation, Message, PolymorphismGroup, DetectionCalculus, DetectionRecord, TestArtifact, Concern) to dual-type as both va:Feature and va:ComposableUnit. Component and Aspect get Feature subClassOf only (already ComposableUnit). Diamond inheritance is OWL 2 DL legal — both branches converge at SoftwareUnit. No removals, no renames; purely additive. Terminal disclaimer scope notes added on va:Literal and va:SoftwareUnit as anti-creep guards."@en,
        "v3.2.5 = v3.2.4 metadata-only PATCH (OE Operating Discipline v2.0.0, BP-D7/BP-D2/B4). Corrections: (1) collapsed duplicate owl:versionInfo {3.2.2,3.2.4} → single 3.2.5; (2) collapsed duplicate owl:versionIRI {…/3.2.2,…/3.2.4} → single …/3.2.5; (3) owl:priorVersion …/3.2.0 → …/3.2.4 (true immediate predecessor per dcterms:replaces and the v3.2.4 changelog); (4) rdfs:label 'v3.0.7' → 'v3.2.5' (was stale); (5) removed the embedded <…/variant-algebra/3.2.3> owl:Ontology node and its self-import owl:imports <…/3.2.2> (B4 identity collision). ZERO class/property/individual changes — verified by parse-diff against v3.2.4 (identical T/Box vocabulary set)."@en ;
    owl:backwardCompatibleWith <http://example.org/variant-algebra/3.2.0> ;
    owl:priorVersion <http://example.org/variant-algebra/3.4.36> ;
    owl:priorVersion <http://example.org/variant-algebra/3.2.5> ;
    owl:priorVersion <http://example.org/variant-algebra/3.2.6> ;
    owl:priorVersion <http://example.org/variant-algebra/3.2.7> ;
    owl:priorVersion <http://example.org/variant-algebra/3.2.8> ;
    owl:priorVersion <http://example.org/variant-algebra/3.2.9> ;
    owl:priorVersion <http://example.org/variant-algebra/3.3.0> ;
    owl:priorVersion <http://example.org/variant-algebra/3.4.0> ;
    owl:priorVersion <http://example.org/variant-algebra/3.4.1> ;
    owl:versionIRI <http://example.org/variant-algebra/3.4.37> ;
    owl:versionInfo "3.4.37" ;
    skos:changeNote "v3.4.1 (2026-09-28, VAF-WI-119): '$' is exclusion (owner, 2026-09-28: '$ is not union, it is exclusion'), and an exclusion holds for the whole variant (va:Decision_WholeVariantIteration_2026_09_28), removing every variant that has both sides; its variant-set semantics tag returns to 'restriction'. 3.4.0 had tagged it 'union' from eq. 2.35, which gives the sets of A $ B taken alone, not what the relation does to the variant around it."@en ;
    skos:changeNote "v3.4.0 (2026-09-28, VAF-WI-118): '+' is additive (va:Decision_AdditionIsAdditive_2026_09_28): it joins one variant of each side into one variant, a name on both sides being one feature, so its variant-set semantics is 'product', not 'union'; the union of two sets of variants is '$' (thesis eq. 2.35), which was tagged 'restriction'. The operator rules now generate every expression's sets (operator rules 4.0.0)."@en ;
    skos:changeNote "v3.3.0 (2026-09-28, VAF-WI-117): one meaning for every expression (va:Decision_OneMeaningGenerated_2026_09_28): an expression means the sets it generates, and a statement holds where the variant restricted to its names is one of them (operator rules 3.0.0). va:DependencyOperator's definition now states the owner's ruling (a < b gives {{a, b}}; 'requires' is the shorthand of [(a < b) | b]); va:IntersectionOperator's states co-selection, as the rules and the owner's clarification do (it read 'set intersection'). No class, property or individual added or removed."@en ;
    skos:changeNote "v3.2.9 (2026-09-27, VAF-WI-107): corrects 3.2.8, whose notes named 'the generative reading' -- the Python definitions evaluator -- as the semantics. The owner's clarification (va:Decision_OwnerClarification_2026_09_28): the calculi are set, and the semantics is the ontology's own operator rules; other implementations are duplicates. The operator notes now say so. No tag, symbol or level changed."@en ;
    skos:changeNote "v3.2.8 (2026-09-27, VAF-WI-105): the owner's answers applied -- the generative reading is the semantics and operators are generic (va:Decision_OwnerAnswers_2026_09_27). Cartesian, Division and Addition are stated as one operation each over operation sets, named elements being the one-element case; Repetition's note follows the decision of 2026-09-25. No tag, symbol or level changed."@en ;
    skos:changeNote "v3.2.7 (2026-09-27, VAF-WI-102): reconciled with the thesis. The ontology is the authority and the thesis the origin (owner, 2026-09-27); each departure is recorded with its reason in variant_algebra_thesis_reconciliation_v1_0_1.ttl. Operator property tags follow measurement under the ontology's reading (Exclusive gains Associative and Idempotent; Dependency loses Associative and gains Idempotent; Addition gains Idempotent; Inverse loses Idempotent and reads complement); Replacement's text follows decisions 5a and A4; Mandatory's ',' symbol removed; the operator set named Δ with 13 entries; thesis citations corrected (sections recomputed from the thesis text; the 'L1099' placeholders replaced). Also: rdfs:label read v3.2.5 in v3.2.6."@en ;
    <http://purl.org/dc/terms/isPartOf> <http://example.org/vaf-domain> .


