@prefix pibe: <http://purl.org/pib/enumeration#> .
@prefix ex:   <http://purl.org/pib/example#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The worked capstone variation space, declared as data.
# This is the same space the pinned Python engine reports a Variation Capacity of 9 for;
# it is the reference case for the ontology-native path.

ex:CapstoneSpace a pibe:VariationSpace ;
    rdfs:label "Capstone wiring variation space"@en ;
    pibe:featureCount 6 ;
    pibe:hasFeature ex:f1_o4sdlc_produces_ad , ex:f2_radar_consumes_ad ,
                    ex:f3_radar_measures , ex:f4_pamg_measures ,
                    ex:f5_o4ucm_analysis , ex:f6_o4df_design .

ex:f1_o4sdlc_produces_ad pibe:featureIndex 1 ; rdfs:label "O4SDLC produces the analysis and design vocabulary"@en .
ex:f2_radar_consumes_ad  pibe:featureIndex 2 ; rdfs:label "RADAR consumes the analysis and design vocabulary"@en .
ex:f3_radar_measures     pibe:featureIndex 3 ; rdfs:label "RADAR performs adequacy measurement"@en .
ex:f4_pamg_measures      pibe:featureIndex 4 ; rdfs:label "PAMG performs measurement itself"@en .
ex:f5_o4ucm_analysis     pibe:featureIndex 5 ; rdfs:label "Analysis model supplied by the use-case module"@en .
ex:f6_o4df_design        pibe:featureIndex 6 ; rdfs:label "Design model supplied by the design module"@en .

ex:MandatoryProduce a pibe:MandatoryConstraint ; pibe:inSpace ex:CapstoneSpace ;
    pibe:requires ex:f1_o4sdlc_produces_ad ;
    rdfs:label "The analysis and design vocabulary must be produced"@en .
ex:MandatoryConsume a pibe:MandatoryConstraint ; pibe:inSpace ex:CapstoneSpace ;
    pibe:requires ex:f2_radar_consumes_ad ;
    rdfs:label "The analysis and design vocabulary must be consumed"@en .

ex:SoleMeasurer a pibe:ExclusiveConstraint ; pibe:inSpace ex:CapstoneSpace ;
    pibe:groupMember ex:f3_radar_measures , ex:f4_pamg_measures ;
    rdfs:label "At most one system may measure"@en .

ex:SomeAnalysisDesignSource a pibe:OrConstraint ; pibe:inSpace ex:CapstoneSpace ;
    pibe:groupMember ex:f5_o4ucm_analysis , ex:f6_o4df_design ;
    rdfs:label "At least one analysis or design source must supply the model"@en .

ex:ConsumeNeedsProduce a pibe:DependencyConstraint ; pibe:inSpace ex:CapstoneSpace ;
    pibe:dependent ex:f2_radar_consumes_ad ; pibe:prerequisite ex:f1_o4sdlc_produces_ad ;
    rdfs:label "Consuming the vocabulary requires producing it"@en .
