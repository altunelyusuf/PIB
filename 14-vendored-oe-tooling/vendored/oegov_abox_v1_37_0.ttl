kb:OEPACK_Lesson_L07 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-07: Don't assert vacuous owl:Thing / owl:Nothing triples"@en ;
    kb:hasLessonId "L-07"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L07 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 2 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "subClassOf owl:Thing satisfies no shape but pollutes the graph. If a class has no superclass, leave it implicitly under owl:Thing rather than asserting it explicitly."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L08 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-08: Use PATCH semantics for validation-fix iterations"@en ;
    kb:hasLessonId "L-08"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L08 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 2 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "vN.0.0 → vN.0.1 → vN.0.2; never overwrite the same version. The on-disk file always corresponds to exactly one version, and priorVersion chains the history."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L09 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-09: IsolatedClassShape Warnings on root primitives are intentional"@en ;
    kb:hasLessonId "L-09"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L09 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 2 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "META's IsolatedClassShape flags root primitives as Warning to surface intent ('is this really standalone?'), not as a defect. Don't suppress these; review them."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L10 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-10: Datatype hygiene for natural-language strings"@en ;
    kb:hasLessonId "L-10"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
