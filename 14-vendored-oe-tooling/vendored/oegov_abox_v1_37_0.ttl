kb:LiteratureSource_IntExt a kb:LiteratureSource,
        owl:NamedIndividual ;
    rdfs:label "Intensive and extensive properties"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    dcterms:title "Intensive and extensive properties"@en ;
    dcterms:creator "Wikipedia" ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Intensive_and_extensive_properties> ;
    kb:hasSourceKind "secondary" ;
    kb:verifiedOn "2026-10-20"^^xsd:date ;
    skos:definition "What it gave to the taxonomy: Extensive properties scale with the amount of matter and add across subsystems (mass, volume, entropy); intensive properties do not depend on system size (temperature, density, pressure); a ratio of two extensive properties is intensive; the classification is not exhaustive."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

