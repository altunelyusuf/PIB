        kb:ClassFacetValue_Persistence_Occurrent ;
    kb:groundedInSource kb:LiteratureSource_ConceptDrift ;
    skos:definition "A change over time in data: the statistics of a predicted variable shift, or records stop matching real-world facts."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_TaxonomicSame a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "Subsumption keeps the kind"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Taxonomic ;
    kb:atEnd "both" ;
    kb:requiresAgreementOn kb:ClassFacet_Persistence,
        kb:ClassFacet_Concreteness,
        kb:ClassFacet_Rigidity ;
    kb:groundedInSource kb:LiteratureSource_OntoClean,
        kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_DOLCE ;
    skos:definition "The two ends of a subclass link are of the same kind in persistence and concreteness, and an anti-rigid class cannot have a rigid subclass, nor can a class with an identity criterion have a subclass with another. A violation usually shows a constitution, a role or a type restriction written as 'is a'."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_CompositionalSame a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "Parthood stays in one category"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Compositional ;
    kb:atEnd "both" ;
    kb:requiresAgreementOn kb:ClassFacet_Persistence ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_DOLCE ;
    skos:definition "Part and whole are of the same kind in persistence: a continuant is part of a continuant and a process of a process; no parthood link crosses between them. Composition is parthood within one category; constitution is the relation that crosses categories."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_ConstitutionCross a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "Constitution joins a thing and its base"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Characterization ;
    kb:atEnd "domain" ;
    kb:requiresKind kb:ClassKind_MaterialEntity,
        kb:ClassKind_InformationArtifact ;
    kb:groundedInSource kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_SoftOntology ;
    skos:definition "A thing is constituted by another of a different category: the wood constitutes the table; code constitutes a program. Only physical things constitute physical things; code constitutes an information artifact."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_InherenceDependent a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "Inherence joins a dependent thing and its bearer"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Characterization ;
    kb:atEnd "domain" ;
    kb:requiresKind kb:ClassKind_SpecificallyDependent ;
    kb:groundedInSource kb:LiteratureSource_BFODOLCE,
        kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_BFOGround ;
    skos:definition "A quality, role or disposition (domain) inheres in a bearer that is an independent continuant (range); a quality inheres in exactly one bearer. A role may be borne by an immaterial entity; a disposition needs a material bearer."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_ParticipationEndurantProcess a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "Participation joins a continuant and an occurrent"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Participation ;
    kb:atEnd "either" ;
    kb:requiresKind kb:ClassKind_Continuant ;
    kb:groundedInSource kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_Smith2005 ;
    skos:definition "The participant is a continuant and the thing it takes part in is an occurrent; both are present at the time. An agent of the process is a continuant that bears causal responsibility, and only material continuants can be agents. Appended 2026-10-21: the relation is read in both directions, so one end of the link is the continuant and the other the occurrent, whichever is the domain; the relations of Smith et al. (2005) has_participant and has_agent have the process at the domain and the continuant at the range."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_ParticipationRange a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "The thing taken part in is an occurrent"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:appliesToCategory kb:RelationshipCategory_Participation ;
    kb:atEnd "either" ;
    kb:requiresKind kb:ClassKind_Occurrent ;
    kb:groundedInSource kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_Smith2005 ;
    skos:definition "See the rule for the participant. Appended 2026-10-21: one end of the link is the occurrent taken part in, whichever end it is."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_SpatialContinuants a kb:KindRule,
