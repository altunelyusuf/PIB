kb:OEPACK_Lesson_L01 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-01: Validate against complete shape suite, not subsets"@en ;
    kb:hasLessonId "L-01"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L01 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 0 closure; oepack_lessons_catalogue_v1_0_0.md §1."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "A SHACL run that loads only meta_shacl and skips redo_shacl will miss C1-C8 gates and ship false 'clean' attestations. Always load the complete safeguard suite per artifact context."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L02 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-02: Check rdfs:domain and rdfs:range on AMOD properties before usage"@en ;
    kb:hasLessonId "L-02"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L02 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 0 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "AMOD's strict typing (e.g., configuration:declaredInManifest requires both endpoints typed) surfaces silent type-mismatches as cascading SHACL violations. Check property signatures before constructing triples."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L03 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-03: owl:imports AMOD when using configuration: types"@en ;
    kb:hasLessonId "L-03"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L03 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 0 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "Without AMOD imports, AMOD's own SHACL shapes can't fire — silent type mismatches go undetected. Always declare owl:imports for any vocabulary whose types you assert."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L04 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-04: Build PROV before sprint closure, not after"@en ;
    kb:hasLessonId "L-04"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L04 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 0 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "Building PROV last means scrambling to retroactively fit version identifiers around already-shipped files. Author the PROV record alongside the artifacts it documents."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L05 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-05: Match AMOD's own header pattern in every artefact"@en ;
    kb:hasLessonId "L-05"^^xsd:string ;
