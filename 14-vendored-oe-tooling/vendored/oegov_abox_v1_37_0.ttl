kb:RelationshipCategory_Assessment a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Measurement and assessment relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-21 (a category for the relations that measure, evaluate, detect and verify, from the literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_DQV,
        kb:LiteratureSource_SOSA ;
    skos:definition "A measurement, metric, test or other evaluation is related to what it evaluates and to what it finds: a measurement is of a metric, a metric is in a dimension, a measurement is computed on a resource, an observation observes a property and has a result, a test detects or verifies a pathology. It is told apart from the causal category (one thing brings about another) and from the epistemic category (a statement supports another)."@en ;
    skos:example "A quality measurement of a metric in a dimension, computed on a dataset."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

