kb:RelationshipCategory_Association a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Unspecific association"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
