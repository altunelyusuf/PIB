        "OE Pack Sprint 4 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "HermiT treats narrower date types as outside OWL DL and throws InconsistentOntologyException. xsd:dateTime is universally supported."@en ;
