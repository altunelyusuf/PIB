kb:OEPACK_BP8_OneSprintOneClosure a kb:BestPractice,
        owl:NamedIndividual ;
    rdfs:label "BP-8: One sprint = one closure = one manifest"@en ;
    kb:hasBestPracticeId "BP-8"^^xsd:string ;
