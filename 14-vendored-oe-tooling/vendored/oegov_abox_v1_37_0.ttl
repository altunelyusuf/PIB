kb:OEPACK_Lesson_L12rev a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-12-rev: Use owl:AllDisjointClasses deliberately, not reflexively"@en ;
    kb:hasLessonId "L-12"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L12rev (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 5 closure (original L-12) + Phase 1 review v1.0.1 Issue I-08 refinement."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "Original L-12 said 'avoid AllDisjointClasses in foundational ontologies' — too blunt. Direct file inspection found 143 AllDisjointClasses in META, 119 in a reliability ontology, 10 in OQC, all HermiT CONSISTENT. The refined lesson: omit AllDisjointClasses where multi-class membership is legitimate; use it where mutual exclusion is intended. Sprint 5's specific finding was about WPC Core specialization classes."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L13 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-13: Cross-ontology inverse properties must use exact same IRI on both sides"@en ;
    kb:hasLessonId "L-13"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L13 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 5 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "If WPC declares (redacted vocabulary pattern) owl:inverseOf rg:offersX, the RG side must reference the same rg:offersX IRI — not a renamed variant. Rename divergence breaks the inverse-of chain silently."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L14 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-14: Governance meta-ontologies must declare owl:imports for external references"@en ;
    kb:hasLessonId "L-14"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L14 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "OE Pack Sprint 7 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "Without imports, HermiT's standalone classification can flag the meta-ontology inconsistent (external IRIs as undeclared NamedIndividuals → type-mixing inconsistency). With imports declared, both standalone and merged validation succeed."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

