<http://example.org/oe-method/backlog#Impediment_LicenceConflict> a bl:Impediment,
        owl:NamedIndividual ;
    rdfs:label "The inherited licence requires named attribution, which the removal scope forbids"@en ;
    bl:blocks <http://example.org/oe-method/backlog#Epic_LineageResolution> ;
    bl:commitsToObjective <http://example.org/oe-method/backlog#Objective_CompleteEcosystem> ;
    bl:decidedBy bl:Owner ;
    bl:hasIdentifier "OEM-I1" ;
    bl:hasImpedimentOwner bl:Owner ;
    bl:hasImpedimentStatement "The inherited licence asserts copyright to a named individual and requires that name in citation and redistribution; the removal scope forbids personal data. Cleared by the rights holder choosing: relicense, or declare named attribution an explicit exception." ;
    bl:hasState <http://example.org/oe-method/backlog#State_Blocked> ;
    bl:impedes <http://example.org/oe-method/backlog#Epic_LineageResolution> ;
    bl:memberOfContainer <http://example.org/oe-method/backlog#Backlog_Deployment> ;
    bl:raisedAt "2026-08-03T00:00:00"^^xsd:dateTime ;
    dcterms:isPartOf <http://example.org/oe-method/backlog> ;
    skos:definition """The governing pack ships a bespoke licence asserting copyright to a named
individual and REQUIRING that name in any citation or redistribution. The instruction is to remove
personal data. These cannot both hold: either the licence changes, or named attribution is a
declared exception to the removal scope. Only the rights holder can decide."""@en .

