kb:LiteratureSource_Avizienis2004 a kb:LiteratureSource,
        owl:NamedIndividual ;
    rdfs:label "Basic concepts and taxonomy of dependable and secure computing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-21 (complete the remaining work on kinds and categories by the recommended method; review the 33 links that did not fit) and the literature read on that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    dcterms:title "Basic concepts and taxonomy of dependable and secure computing"@en ;
    dcterms:creator "A. Avizienis, J.-C. Laprie, B. Randell, C. Landwehr (IEEE Transactions on Dependable and Secure Computing 1(1), 2004)" ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.inf.ed.ac.uk/teaching/courses/seoc/2006_2007/resources/BasicConcepts.pdf> ;
    kb:hasSourceKind "primary" ;
    kb:verifiedOn "2026-10-21"^^xsd:date ;
    skos:definition "What it gave to the rules: a fault is the adjudged or hypothesized cause of an error; a fault is dormant until it is activated; an error is the part of the state that may lead to a failure, which is an event. The cause of an error is a state of the system, not an event, so a cause need not be an occurrent."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:LiteratureSource_QualityInteraction a kb:LiteratureSource,
        owl:NamedIndividual ;
    rdfs:label "Identifying Quality Characteristic Interactions during Software Development"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-21 (complete the remaining work on kinds and categories by the recommended method; review the 33 links that did not fit) and the literature read on that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    dcterms:title "Identifying Quality Characteristic Interactions during Software Development"@en ;
    dcterms:creator "G. A. Garcia-Mireles, M. A. Moraga, F. Garcia, M. Piattini (ENASE 2015, pages 78-89)" ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://www.scitepress.org/Papers/2015/53518/53518.pdf> ;
    kb:hasSourceKind "secondary" ;
    kb:verifiedOn "2026-10-21"^^xsd:date ;
    skos:definition "What it gave to the rules: interactions are situations in which the satisfaction of one requirement may affect the satisfaction of another (Robinson et al., Requirements Interaction Management, ACM Computing Surveys 35(2), 2003); an interaction model is a matrix of the positive and negative influences of one quality characteristic on another. The relata are quality characteristics, not events."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

