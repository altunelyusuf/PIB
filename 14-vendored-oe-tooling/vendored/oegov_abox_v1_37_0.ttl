    kb:hasSourceKind "secondary" ;
    kb:verifiedOn "2026-10-20"^^xsd:date ;
    skos:definition "What it gave to the taxonomy: Polysemy is one form with several related senses; homonymy is unrelated words that share a form by coincidence; lexicographers give homonyms separate numbered entries and polysemes one entry, deciding by etymology and by the relatedness of the senses; a polyseme can split into homonyms over time."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:LiteratureSource_SKOSRef a kb:LiteratureSource,
        owl:NamedIndividual ;
    rdfs:label "SKOS Simple Knowledge Organization System Reference"@en ;
