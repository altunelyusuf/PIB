kb:OEPACK_Lesson_L20 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-20: For false-positive shapes, split into strict/advisory tiers"@en ;
    kb:hasLessonId "L-20"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "Migrated from redo:Lesson_L20 (oepack-lessons-rdf, plural-class normalized). (See pre-migration source statement(s) above.)"@en,
        "Phase 1 Issue I-05 closure."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "When a SHACL shape produces a false positive in standalone mode, the right fix is to make the shape import-aware (sh:condition on sh:importsResolved) or split it into strict/advisory tiers — not to relax the constraint or skip the shape. C7+ TypeDeclarationShape addressing is the exemplar."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor ;
    prov:wasGeneratedBy oe-prov:Activity_OEPackRelease_v17_33_0 .

kb:OEPACK_Lesson_L21 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-21: Verify health-check namespaces against actual ontology files"@en ;
    kb:hasLessonId "L-21"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
