    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:definition "Every artifact must declare: ontology IRI, version IRI, versionInfo, dcterms:created/modified, creator, source, rdfs:comment with versioning history. The header IS the AMOD compliance contract."@en ;
    prov:generatedAtTime "2026-05-15T00:00:00"^^xsd:dateTime ;
