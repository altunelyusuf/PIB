    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_ISO25964,
        kb:LiteratureSource_SKOS,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_DCMI ;
    kb:exemplifiedBy skos:related ;
    skos:definition "Two things are related and no more specific category says how. It is the weakest category: thesaurus standards define it only as a connection established by experience, and the same word ('has') can hide several different relationships. Use it only when no other category fits, and say in the definition what it leaves unsaid."@en ;
    skos:example "Two concepts that belong together in a thesaurus."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Temporal a kb:RelationshipCategory,
