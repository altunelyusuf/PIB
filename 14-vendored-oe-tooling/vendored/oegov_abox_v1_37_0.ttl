kb:OEPACK_Lesson_L19 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-19: Run health-checks against original artifacts when a review claims comprehensiveness"@en ;
    kb:hasLessonId "L-19"^^xsd:string ;
