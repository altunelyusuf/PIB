    skos:definition "Continuants are viewed spatially and processes temporally: located in, contained in and adjacent to join continuants; the temporal relations join occurrents and temporal entities."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
