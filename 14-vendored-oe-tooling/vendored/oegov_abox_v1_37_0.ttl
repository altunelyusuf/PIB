kb:RelationshipPlane_Representation a kb:RelationshipPlane,
        owl:NamedIndividual ;
    rdfs:label "Representation plane"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005 ;
    skos:definition "The plane of relations about the artifact that represents: its words, names and labels, its files and their organisation, its versions, its citations and the claims made about it. They hold because of how something is written down."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipPlane_Domain a kb:RelationshipPlane,
        owl:NamedIndividual ;
    rdfs:label "Domain plane"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005 ;
    skos:definition "The plane of relations about the things the model stands for. They hold whatever is written about the things; the literature on relations in ontologies leaves relations that only annotate a representation out of this plane."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_Plane a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Plane"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:seeAlso kb:RelationshipPlane_Domain,
        kb:RelationshipPlane_Representation ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005 ;
    skos:definition "Whether the relation is about the artifact (representation plane) or about the things it stands for (domain plane). Every relationship has exactly one, or both where it says something of each."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_Level a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Level of generality"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005 ;
    skos:definition "Whether the relation joins two classes, an individual and a class, or two individuals. A class-level relation is defined through the individual-level one (every instance of one class is related to some instance of the other)."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_FormalMaterial a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Formal or material"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_OntoUMLDocs ;
    skos:definition "A formal relation holds directly between its relata with no intervening individual; a material relation has material structure of its own and is mediated by an individual that connects its relata (a relator)."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_Arity a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Arity"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_NaryNote,
        kb:LiteratureSource_Storey1993 ;
    skos:definition "Whether the relation joins two things or several. A relation of more than two things, or one that needs attributes of its own, becomes an object (a class for the relation) or an ordered list."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_Logical a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Logical characteristics"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_OWL2,
        kb:LiteratureSource_Smith2005 ;
    skos:definition "The properties a relation is declared to have: functional, inverse-functional, reflexive, irreflexive, symmetric, asymmetric, transitive, with its domain, range, sub-property, inverse or reciprocal. At class level an inverse often does not exist and a reciprocal is stated instead."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_TimeIndex a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Time indexing"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_DOLCE ;
    skos:definition "Whether the relation holds at a time. A relation of things that persist through change carries a time argument (or is stated of a state), so that the same thing may stand in it at one time and not at another."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipFacet_Universality a kb:RelationshipFacet,
        owl:NamedIndividual ;
    rdfs:label "Universality"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:groundedInSource kb:LiteratureSource_Smith2005 ;
    skos:definition "How far the relation holds across the instances of a class: 'all-some' (every instance of one class stands in it to some instance of the other) is the default for class-level statements; weaker claims are marked as such."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Syntactic a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Syntactic relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_UD,
        kb:LiteratureSource_SKOS,
        kb:LiteratureSource_WordNet,
        kb:LiteratureSource_NeOnODP ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "A relationship between expressions, not between the things they stand for: which name denotes which thing, which words are variants of one another, which word of a sentence depends on which. It is found in the text of a model (definitions, comments, notes, sources, labels)."@en ;
    skos:example "A definition that names another class by its identifier."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_ReferenceByName a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Reference by name"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:seeAlso kb:BestPractice_D56_EveryClassIsLinkedAndTheClassesOfAFileFormOneModel ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Syntactic ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_LinkedData,
        kb:LiteratureSource_SKOS ;
    kb:exemplifiedBy rdfs:seeAlso ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "An expression denotes a thing by its identifier, name or label. The relationship is complete only when the name is also carried as a link to the thing named (a reference to a modelled thing is a link, never a string)."@en ;
    skos:example "A definition that says 'see best practice BP-D56' and carries an rdfs:seeAlso link to it."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_LexicalVariant a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Lexical variant"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Syntactic ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_SKOS,
        kb:LiteratureSource_WordNet,
        kb:LiteratureSource_ISO25964,
        kb:LiteratureSource_ConceptNet ;
    kb:exemplifiedBy skos:altLabel ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "Two expressions stand for the same thing or for opposite things: synonym, abbreviation, translation, spelling variant, antonym. Thesauri call the first equivalence; lexical databases call them synonymy and antonymy."@en ;
    skos:example "'Ontology Engineering Ecosystem' and 'OEE'."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_GrammaticalDependency a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Grammatical dependency"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Syntactic ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_UD,
        kb:LiteratureSource_NeOnODP ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "A word of a sentence depends on another as its subject, object, modifier, determiner or marker. It is the basis of the patterns by which a relation is recognised in a text (lexico-syntactic patterns)."@en ;
    skos:example "'X replaces Y' is a subject, a verb and an object; the verb signals a supersession."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Structural a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Structural relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_DCMI,
        kb:LiteratureSource_NeOnODP,
        kb:LiteratureSource_NaryNote,
        kb:LiteratureSource_LinkedData ;
    kb:enforcedBy kb:BestPractice_D56_EveryClassIsLinkedAndTheClassesOfAFileFormOneModel ;
    skos:definition "A relationship that holds because of how the artifact is organised: what is contained in what, in what order things are listed, how a relationship is itself made an object, and whether every part is connected to the rest."@en ;
    skos:example "A term that belongs to a module of a file."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_ContainmentMembership a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Containment and membership"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Structural ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_DCMI,
        kb:LiteratureSource_PROVO ;
    kb:exemplifiedBy dcterms:isPartOf,
        rdfs:isDefinedBy ;
    kb:enforcedBy kb:BestPractice_D56_EveryClassIsLinkedAndTheClassesOfAFileFormOneModel ;
    skos:definition "A thing is part of an artifact, a module, a collection or a package, or an artifact has a part. It says where something is kept, not what it is."@en ;
    skos:example "A class that is part of the module that defines it."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_OrderingSequence a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Ordering in a list"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Structural ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_NaryNote ;
    skos:definition "The members of a collection come in an order that matters, carried by an ordered list or by a link from each member to the next."@en ;
    skos:example "The arguments of a relation in the order given."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Reification a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Relationship made an object"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Structural ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_NaryNote,
        kb:LiteratureSource_PROVO,
        kb:LiteratureSource_CiTO ;
    skos:definition "A relationship that needs its own attributes, has several aspects, or has no distinguished participant is made an object with a link to each participant (qualified relations in provenance, a citation as an object)."@en ;
    skos:example "A purchase with buyer, seller, object and amount, modelled as a purchase object."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Connectedness a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Connectedness"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Structural ;
    kb:belongsToPlane kb:RelationshipPlane_Representation ;
    kb:groundedInSource kb:LiteratureSource_LinkedData,
        kb:LiteratureSource_NeOnODP ;
    kb:enforcedBy kb:BestPractice_D56_EveryClassIsLinkedAndTheClassesOfAFileFormOneModel ;
    skos:definition "Every class of a model is linked to at least one other, and the classes of a file form one connected model; an unconnected class cannot be judged useful. It is the structural form of the linked-data rule that a model includes links."@en ;
    skos:example "A class with no subclass, property or restriction that joins it to another class."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Semantic a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Semantic relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_ConceptNet,
        kb:LiteratureSource_SemEval2010 ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "A relationship between the things a model stands for, as opposed to its expressions or its organisation. The literature divides it by the kind of connection it makes; the sub-categories below are those it keeps apart."@en ;
    skos:example "A property between two classes with a stated domain and range."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Taxonomic a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Taxonomic relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_OntoClean,
        kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_SKOS,
        kb:LiteratureSource_WordNet,
        kb:LiteratureSource_ConceptNet ;
    kb:exemplifiedBy rdfs:subClassOf,
        skos:broader ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "Class inclusion and instantiation: one class is a kind of another, an individual is an instance of a class, a thing is classified under a concept. A subsumption is justified only when rigidity, identity and unity are respected."@en ;
    skos:example "A Cohesion dimension is a kind of Maintainability."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Compositional a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Compositional relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_Winston1987,
        kb:LiteratureSource_Bock,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_OntoUMLDocs,
        kb:LiteratureSource_WordNet,
        kb:LiteratureSource_SemEval2010 ;
    kb:enforcedBy kb:BestPractice_D57_MissingLinksAreDiscoveredDecidedAndSetNeverLeftAsText ;
    skos:definition "Part and whole. The literature keeps six kinds apart (component and integral object, member and collection, portion and mass, stuff and object, feature and activity, place and area), told apart by whether the part has a function, is of the same kind as the whole, and can be separated from it."@en ;
    skos:example "A wheel is a component of a bicycle; a tree is a member of a forest."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Spatial a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Spatial and topological relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_RCC,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_SemEval2010 ;
    skos:definition "Where a thing is relative to another: located in, contained in, adjacent to, attached to, and the eight topological relations between regions. Containment without part-hood belongs here, not under composition."@en ;
    skos:example "A document held in a folder; a region touching another."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Characterization a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Characterization and dependence"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_BFODOLCE,
        kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_OntoUMLDocs,
        kb:LiteratureSource_Storey1993 ;
    skos:definition "A thing has a quality, plays a role, is constituted by another, or cannot exist without another: inherence, characterization, mediation, constitution, possession and attribution."@en ;
    skos:example "A quality that inheres in exactly one bearer."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Participation a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Participation and case role"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_Smith2005,
        kb:LiteratureSource_DOLCE,
        kb:LiteratureSource_Storey1993,
        kb:LiteratureSource_SemEval2010 ;
    skos:definition "A thing takes part in a process and has a role in it: participant, agent, instrument, patient or recipient, producer and product, origin and destination."@en ;
    skos:example "A tool used by an agent in an activity."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Causal a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Causal relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:seeAlso kb:RelationshipCategory_TemporalOrder ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_ConceptNet,
        kb:LiteratureSource_SemEval2010,
        kb:LiteratureSource_RO ;
    skos:definition "One thing or event brings about, enables, prevents or is a prerequisite of another. It is told apart from temporal order, which says only which came first."@en ;
    skos:example "A defect causes a failure."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Intentional a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Intentional relationship"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (a systematic method to construct relationships and a taxonomy of them, from the widest literature) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:RelationshipCategory_Semantic ;
    kb:belongsToPlane kb:RelationshipPlane_Domain ;
    kb:groundedInSource kb:LiteratureSource_GuizzardiER2013,
        kb:LiteratureSource_ConceptNet ;
    skos:definition "A thing is done for a purpose: a goal is achieved by a means, an action is chosen for a goal, an element contributes to a goal as an intended or unintended effect."@en ;
    skos:example "A test is run in order to show a requirement is met."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:RelationshipCategory_Comparative a kb:RelationshipCategory,
        owl:NamedIndividual ;
    rdfs:label "Similarity and opposition"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
