    kb:atEnd "range" ;
    kb:requiresKind kb:ClassKind_MaterialEntity ;
    kb:groundedInSource kb:LiteratureSource_IntExt ;
    skos:definition "An extensive quality (mass, volume, entropy) scales with the amount of matter and adds across subsystems, so the bearer it inheres in is a material entity or an amount of matter; an intensive quality does not depend on the size of the system and sets no such limit."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:KindRule_MeasurementAttribute a kb:KindRule,
        owl:NamedIndividual ;
    rdfs:label "A metric measures an attribute"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
