kb:OEPACK_Lesson_L17 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-17: Vocabulary without ABox is a structural promise, not a working system"@en ;
    kb:hasLessonId "L-17"^^xsd:string ;
