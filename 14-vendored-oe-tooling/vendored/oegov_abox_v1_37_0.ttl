kb:OEPACK_Lesson_L11 a kb:LessonsLearned,
        owl:NamedIndividual ;
    rdfs:label "L-11: Don't use xsd:date / xsd:duration / xsd:gYear; use xsd:dateTime"@en ;
    kb:hasLessonId "L-11"^^xsd:string ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
