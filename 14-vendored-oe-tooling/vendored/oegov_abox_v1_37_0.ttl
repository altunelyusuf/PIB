    skos:definition "A relationship that holds because of time: which comes first, what follows from what, what replaces what. It is found among events and processes of the domain and among the versions of the artifact."@en ;
    skos:example "A release that follows another release."@en ;
    prov:generatedAtTime "2026-10-20T00:00:00"^^xsd:dateTime ;
