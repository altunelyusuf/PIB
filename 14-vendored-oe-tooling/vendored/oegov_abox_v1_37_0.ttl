kb:LiteratureSource_SPEM2 a kb:LiteratureSource,
        owl:NamedIndividual ;
    rdfs:label "Software and Systems Process Engineering Metamodel 2.0, method content"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's ruling of 2026-10-21 (behavioural patterns, methods) and the literature read on that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    dcterms:title "Software and Systems Process Engineering Metamodel (SPEM) 2.0, method content"@en ;
    dcterms:creator "Object Management Group (SPEM 2.0, 2008)" ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    rdfs:seeAlso <https://home.iscte-iul.pt/~hro/RUPSmallProjects/core.base_concepts/guidances/termdefinitions/method_content_6972AE81.html> ;
    kb:hasSourceKind "secondary" ;
    kb:verifiedOn "2026-10-21"^^xsd:date ;
    skos:definition "What it gave to the kinds: method content describes methodological concepts and guidance that give step-by-step explanations of how specific goals are achieved, independently of the placement of those steps within a process lifecycle; it is kept apart from its application in a process. So a method is a description (an information artifact), not an act and not a document of one run (read through a term definition of the method content of the Unified Method Architecture, which SPEM 2.0 follows; the specification itself was not opened)."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:ClassKind_Method a kb:ClassKind,
        owl:NamedIndividual ;
    rdfs:label "Method"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's ruling of 2026-10-21 (behavioural patterns, methods) and the literature read on that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:ClassKind_InformationArtifact ;
    kb:hasFacetValue kb:ClassFacetValue_Dependence_GenericallyDependent,
        kb:ClassFacetValue_Origin_Made ;
    kb:groundedInSource kb:LiteratureSource_SPEM2 ;
    skos:definition "An information artifact that says how a goal is achieved, step by step, independently of where the steps sit in a lifecycle: a technique, a procedure, a strategy, a protocol or a design pattern (not a run of it, which is a process)."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:ClassKind_BehavioralPattern a kb:ClassKind,
        owl:NamedIndividual ;
    rdfs:label "Behavioural pattern"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's ruling of 2026-10-21 (behavioural patterns, methods) and the literature read on that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
    rdfs:isDefinedBy <http://example.org/knowledge-base> ;
    skos:broader kb:ClassKind_Process ;
    kb:hasFacetValue kb:ClassFacetValue_Concreteness_Concrete,
        kb:ClassFacetValue_Persistence_Occurrent ;
    kb:groundedInSource kb:LiteratureSource_Avizienis2004 ;
    skos:definition "A recurring way an agent or system behaves, as it shows in what it does (the sequence of its external states): the pathologies of an agent and the categories of its drift. It is an occurrent; the tendency that gives rise to it is a disposition and the change in data is a drift of data."@en ;
    prov:generatedAtTime "2026-10-21T00:00:00"^^xsd:dateTime ;
    prov:wasAttributedTo oe-prov:Agent_MethodAuthor .

kb:ClassKind_Drift a kb:ClassKind,
        owl:NamedIndividual ;
    rdfs:label "Drift"@en ;
    dcterms:isPartOf <http://example.org/knowledge-base> ;
    dcterms:source "The owner's request of 2026-10-20 (the same research and taxonomy for classes, jointly with the taxonomy of relationships) and the literature research of that date, recorded in RELATIONSHIP_TAXONOMY_RESEARCH_v1_11_0.md."@en ;
