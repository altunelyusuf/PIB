pibe:CheckPhase a pibe:Phase ;
    rdfs:label "Check: confirm admissibility of every complete candidate — a safety net"@en ;
    pibe:phaseName "check" ;
    pibe:phaseOrder 3 .

pibe:CombinePhase a pibe:Phase ;
    rdfs:label "Combine: multiply the group capacities into each space's capacity"@en ;
    pibe:phaseName "combine" ;
    pibe:phaseOrder 4 .

pibe:GenerationPhase a pibe:Phase ;
    rdfs:label "Generation: enumerate the admissible selections of each group, pruning as it goes"@en ;
    pibe:phaseName "generation" ;
    pibe:phaseOrder 2 .

pibe:PartitionPhase a pibe:Phase ;
    rdfs:label "Partition: split each space into independent groups of coupled features"@en ;
    pibe:phaseName "partition" ;
    pibe:phaseOrder 1 .

pibe:TaxonomyPhase a pibe:Phase ;
    rdfs:label "Taxonomy: express the branch structure the generation phase already built"@en ;
    pibe:phaseName "taxonomy" ;
    pibe:phaseOrder 5 .

<http://purl.org/pib/enumeration/rules> rdfs:label "PIB enumeration rules — variant generation and admissibility in the ontology"@en ;
    dcterms:description "Generates every admissible candidate selection over a declared variation space, pruning as it goes, then checks admissibility as a safety net and leaves the admissible set standing to be counted."@en ;
    dcterms:identifier "rules" ;
    dcterms:isPartOf <http://purl.org/pib> ;
    owl:priorVersion <http://purl.org/pib/enumeration/rules/2.3.0> ;
    owl:versionIRI <http://purl.org/pib/enumeration/rules/2.4.0> ;
    owl:versionInfo "2.4.0" .

<http://purl.org/pib/example#IEEEPaperWiring> ns1:engine "Variant_Algebra_Framework_v1_0_0 (pinned BruteForceBackend)" ;
    ns1:publishable true ;
    ns1:variationCapacity 9 ;
    ns1:wiringValid true ;
    iif:forProfile <http://purl.org/pib/example#IEEEPaperProfile> ;
    rdfs:comment "VC=9. Same variation space as Capstone: RADAR reused the shared HasAnalysisDesignModel criterion over the same chain, so the contributed edge set (hence the capacity) is identical; the profile selects a different reproducible point."@en .

<http://purl.org/pib/example#O4SDLC_if> a iif:OntologyInterface ;
    rdfs:label "O4SDLC interface"@en ;
    iif:produces <http://purl.org/pib/example#AnalysisDesignVocabulary> .

<http://purl.org/pib/example#PAMG_if> a iif:OntologyInterface ;
    rdfs:label "PAMG interface"@en ;
    iif:consumes <http://purl.org/pib/example#AdequacyMeasurement> ;
    iif:produces <http://purl.org/pib/example#InstitutionalGrade> .

<http://purl.org/pib/example#RADAR_if> a iif:OntologyInterface ;
    rdfs:label "RADAR interface"@en ;
    iif:consumes <http://purl.org/pib/example#AnalysisDesignVocabulary> ;
    iif:produces <http://purl.org/pib/example#AdequacyMeasurement> .

<http://purl.org/pib/profile> rdfs:label "Profile Ontology — shared artifact-category & variant-configuration vocabulary"@en ;
    dcterms:created "2026-06-05"^^xsd:date ;
    dcterms:creator <http://purl.org/pib/prov#Agent_YusufAltunel>,
        "Yusuf Altunel" ;
    dcterms:description "Single source of truth for artifact CATEGORY across the generic ontology ecosystem (RDODI generates, RADAR measures, PAMG grades). A Profile binds a category identity, the criteria SHARED across systems, and a selection of one validated integration wiring variant. System-specific behaviour (RDODI generation templates, RADAR measurement dimensions, PAMG grading weights) is NOT modelled here — it is attached by each system to the shared Profile IRI, keeping this vocabulary free of scope-foreign content (OE L-64). PATCH v1.0.0.1: BP-D24 metadata completed (added dcterms:modified, dcterms:identifier, prov:wasAttributedTo, machine-linkable dcterms:creator IRI, and Activity-IRI prov:wasGeneratedBy); no vocabulary change."@en ;
    dcterms:identifier "profile" ;
    dcterms:isPartOf <http://purl.org/pib> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:publisher "İstanbul Kültür Üniversitesi — Computer Engineering" ;
    dcterms:rights "© 2026 Yusuf Altunel. CC-BY-4.0." ;
    dcterms:rightsHolder "Yusuf Altunel" ;
    owl:priorVersion <http://purl.org/pib/profile/1.2.0> ;
    owl:versionIRI <http://purl.org/pib/profile/1.3.0> ;
    owl:versionInfo "1.3.0" ;
    prov:wasAttributedTo <http://purl.org/pib/prov#Agent_YusufAltunel> ;
    prov:wasGeneratedBy <http://purl.org/pib/prov#authoring> .

pib:General a pib:RuleScope,
        owl:NamedIndividual ;
    rdfs:label "General — binds every profile, unconditionally"@en ;
    skos:definition "A rule of the domain itself — declared at the meta level, owned by no profile, and binding every profile. Generality is a consequence of having no profile home, not of an annotation: see the correction recorded in v1.2.0."@en .

<http://purl.org/pib/prov#Org_IKU_ComputerEngineering> a prov:Agent,
        prov:Organization ;
    rdfs:label "İstanbul Kültür Üniversitesi — Computer Engineering"@en .

<http://purl.org/pib/prov#PIB_v1_0_0> a prov:Entity ;
    rdfs:label "Profile + Integration-Interface Blueprint v1.0.0"@en ;
    dcterms:created "2026-06-05"^^xsd:date ;
    prov:wasDerivedFrom <http://purl.org/pib/prov#oe_pack>,
        <http://purl.org/pib/prov#vaf_pin> ;
    prov:wasGeneratedBy <http://purl.org/pib/prov#authoring> .

<http://purl.org/pib/wiring-expression> rdfs:label "PIB wiring expressions — nested operator expressions over integration wirings"@en ;
    dcterms:created "2026-09-17"^^xsd:date ;
    dcterms:creator <http://purl.org/pib/prov#Agent_YusufAltunel>,
        "Yusuf Altunel" ;
    dcterms:description "Lets a PIB wiring constraint be written as a NESTED EXPRESSION built from the variant algebra's operators, rather than as a flat list of operator applications. The algebra's operators are constructors in an expression language, not a fixed menu of features: composing them expresses constraints none of them expresses alone (a k-of-n bound, for example, is not expressible with mandatory, optional, exclusive, or, or dependency, but is expressible by composing repetition with a contributes-to grouping). This vocabulary therefore REFERENCES the algebra's own operator classes and operand/nesting predicates rather than redeclaring them — the algebra stays with its owner — and adds only what is genuinely PIB's: the binding from an expression to the wiring it governs, and the named operator individuals PIB applies. Complete adoption: all twelve concrete operators are available, not the six the previously pinned engine generation carried."@en ;
    dcterms:identifier "wiring-expression" ;
    dcterms:isPartOf <http://purl.org/pib> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:publisher "İstanbul Kültür Üniversitesi — Computer Engineering" ;
    dcterms:rights "© 2026 Yusuf Altunel. CC-BY-4.0." ;
    dcterms:rightsHolder "Yusuf Altunel" ;
    owl:priorVersion <http://purl.org/pib/wiring-expression/1.0.0.2> ;
    owl:versionIRI <http://purl.org/pib/wiring-expression/1.1.0> ;
    owl:versionInfo "1.1.0" ;
    prov:wasAttributedTo <http://purl.org/pib/prov#Agent_YusufAltunel> ;
    prov:wasGeneratedBy <http://purl.org/pib/prov#authoring> .

pibx:CapstoneWiringExpression a pibx:WiringExpression,
        owl:NamedIndividual ;
    rdfs:label "Capstone wiring constraint"@en ;
    pibx:expressionIntent "At most two measurement facets may feed the grader, and exactly one grader may be selected — both conditions together." ;
    pibx:governsWiring asmt:Wiring_CoreSoftwareDevelopment ;
    pibx:hasRootApplication pibx:CapstoneConstraintApp .

pibx:Cartesian a va:CartesianOperator,
        owl:NamedIndividual ;
    rdfs:label "Cartesian — pairs every member of one operand set with every member of the other"@en .

pibx:Dependency a va:DependencyOperator,
        owl:NamedIndividual ;
    rdfs:label "Dependency — selecting the dependent requires the prerequisite"@en .

pibx:Division a va:DivisionOperator,
        owl:NamedIndividual ;
    rdfs:label "Division — removes elements cancelled by another operand"@en .

pibx:Intersection a va:IntersectionOperator,
        owl:NamedIndividual ;
    rdfs:label "Intersection — retains only operands jointly present"@en ;
    skos:scopeNote "ELEMENT-level, like the algebra's rule that implements it: it intersects operands that co-occur, not sets of whole wirings. The question 'which wirings are admissible under two profiles at once' is set-level and is answered by enumerating both profiles' constraints in one space, not by this operator. Measured 2026-09-22: on the same subject matter the algebra's rule returns one element while the enumeration returns a capacity of 2. The same distinction applies to addition, subtraction, division, inverse and cartesian here."@en .

pibx:Inverse a va:InverseOperator,
        owl:NamedIndividual ;
    rdfs:label "Inverse — marks an element for removal before a wiring is emitted"@en .

pibx:Mandatory a va:MandatoryOperator,
        owl:NamedIndividual ;
    rdfs:label "Mandatory — the operand appears in every admissible wiring"@en .

pibx:Optional a va:OptionalOperator,
        owl:NamedIndividual ;
    rdfs:label "Optional — the operand may be present or absent"@en .

pibx:Or a va:OrOperator,
        owl:NamedIndividual ;
    rdfs:label "Or — at least one of the operands must be selected"@en .

pibx:Subtraction a va:SubtractionOperator,
        owl:NamedIndividual ;
    rdfs:label "Subtraction — the first operand with the second excluded"@en .

<http://example.org/your-package#File_my_tbox> a ns2:OntologyFile ;
    rdfs:label "my_tbox_v1_0_0.ttl"@en ;
    ns2:hasFileSHA256 "<sha256 of the file at that commit>" ;
    ns2:hasVersionInfo "1.0.0" ;
    pibcr:atPath "01-ontologies/my_tbox_v1_0_0.ttl" .

<http://example.org/your-package#MyPackage_if> a iif:OntologyInterface ;
    rdfs:label "What my package exchanges"@en ;
    iif:consumes <http://example.org/your-package#SomeOtherCapability> ;
    iif:hasSelfCoverage <http://example.org/your-package#MySelfCoverage> ;
    iif:produces <http://example.org/your-package#SomeCapability> .

<http://example.org/your-package#MySelfCoverage> a iif:SelfCoverageAttestation ;
    rdfs:label "Self-coverage: my package parses and is internally consistent standalone"@en .

<http://example.org/your-package#SomeCapability> a iif:Capability ;
    rdfs:label "A capability you produce"@en .

<http://example.org/your-package#SomeOtherCapability> a iif:Capability ;
    rdfs:label "A capability you consume"@en .

