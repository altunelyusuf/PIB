<http://example.org/your-package#MyPackageRegistration> a pibcr:ConsumerRegistration ;
    rdfs:label "Registration: <your package name>"@en ;
    pibcr:atCommit "<full 40-character commit SHA, or a tag name>" ;
    pibcr:atRepository "https://github.com/<owner>/<repo>"^^xsd:anyURI ;
    pibcr:contactSession "<the session or person who maintains this package>" ;
    pibcr:declaresInterface <http://example.org/your-package#MyPackage_if> ;
    pibcr:registersFile <http://example.org/your-package#File_my_tbox> ;
    pibcr:repositoryReachable true .

<http://purl.org/pib/assessment> rdfs:label "PIB assessment profiles — HUB-published canonical set"@en ;
    dcterms:created "2026-06-09"^^xsd:date ;
    dcterms:creator <http://purl.org/pib/prov#Agent_YusufAltunel>,
        "Yusuf Altunel" ;
    dcterms:description "Canonical assessment profiles materialized by the HUB. OBAF retired: assessment is PAMG made ontology-native and profile-driven, riding on OEE's measurement facets; ontology-development assessment belongs to OEE. Each pib:Profile pins one reproducible WiringVariant (VariationCapacity recorded), validated against the pinned VAF; every participating interface carries a G3 self-coverage attestation recording its real on-disk result. ZeroTime deferred (ZT4SWE unresolved). MINOR v1.1.0: added the Repetition operator individual, completing the six variability operators this vocabulary already states it governs — the variant-algebra engine's own definition scopes its variability family to exactly Mandatory, Optional, Exclusive, Or, Dependency and Repetition, and only five had been declared here. PATCH v1.1.0.1 corrects what followed: the claim that the algebra's remaining operators were deliberately not imported is no longer true and was never a sound reason. From PIB v1.6.0 the complete set of twelve operators is applied through the wiring-expression vocabulary, and from v2.0.0 admissibility is evaluated by rules in the ontology rather than by the pinned engine. No vocabulary in this file changed."@en ;
    dcterms:identifier "assessment" ;
    dcterms:isPartOf <http://purl.org/pib> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    dcterms:publisher "İstanbul Kültür Üniversitesi — Computer Engineering" ;
    dcterms:rights "© 2026 Yusuf Altunel. CC-BY-4.0." ;
    dcterms:rightsHolder "Yusuf Altunel" ;
    owl:priorVersion <http://purl.org/pib/assessment/1.1.0.1> ;
    owl:versionIRI <http://purl.org/pib/assessment/1.2.0> ;
    owl:versionInfo "1.2.0" ;
    prov:wasAttributedTo <http://purl.org/pib/prov#Agent_YusufAltunel> ;
    prov:wasGeneratedBy <http://purl.org/pib/prov#authoring> .

asmt:Op_Dependency a iif:VariabilityOperator,
        owl:NamedIndividual ;
    rdfs:label "Dependency operator"@en .

asmt:Op_Exclusive a iif:VariabilityOperator,
