    dcterms:source "sha256:9996f9077c8eaec0d9153fb9127131ea969dc929c92e0bfc104bc0371e00eceb" ;
    skos:note "self_covered=True; dl_consistent=True; method=self_coverage_checker_v1_1_0_1 --hermit (pySHACL 0.31.0 / HermiT owlready2), real on-disk artifact, attested by HUB" .

asmt:SelfCov_O4SDLC a iif:SelfCoverageAttestation,
        owl:NamedIndividual ;
    rdfs:label "Self-coverage attestation for O4SDLC (o4sdlc_interface_contribution_v1_0_0.ttl)"@en ;
    dcterms:source "sha256:c2d4ce934d8691fa017002d278c647c3f0e143bc259ea916273d37e12e2f84d1" ;
    skos:note "self_covered=True; dl_consistent=True; method=self_coverage_checker_v1_1_0_1 --hermit (pySHACL 0.31.0 / HermiT owlready2), real on-disk artifact, attested by HUB" .

asmt:SelfCov_OEE a iif:SelfCoverageAttestation,
        owl:NamedIndividual ;
    rdfs:label "Self-coverage attestation for OEE (measurement_tbox_v2_8_0.ttl)"@en ;
    dcterms:source "sha256:1069f7c2f389aaeb85a0ca346925d51f3e4331e3f2c1155c7bdf082f2b4e2eb0" ;
    skos:note "self_covered=True; dl_consistent=True; method=self_coverage_checker_v1_1_0_1 --hermit (pySHACL 0.31.0 / HermiT owlready2), real on-disk artifact, attested by HUB" .

asmt:SelfCov_PAMG a iif:SelfCoverageAttestation,
        owl:NamedIndividual ;
    rdfs:label "Self-coverage attestation for PAMG (pamg_interface_contribution_v1_0_0.ttl)"@en ;
    dcterms:source "sha256:8f1e2bc1302c8b4115218cac017d2dcb742d47af6f757178e235ea8a812cfeba" ;
    skos:note "self_covered=True; dl_consistent=True; method=self_coverage_checker_v1_1_0_1 --hermit (pySHACL 0.31.0 / HermiT owlready2), real on-disk artifact, attested by HUB" .

asmt:SelfCov_RADAR a iif:SelfCoverageAttestation,
        owl:NamedIndividual ;
    rdfs:label "Self-coverage attestation for RADAR (radar_interface_contribution_v1_0_0.ttl)"@en ;
    dcterms:source "sha256:c226b671eb8570dbe6c45f00e4d763f9efa01c04befd94cd60689fb25ce8d950" ;
