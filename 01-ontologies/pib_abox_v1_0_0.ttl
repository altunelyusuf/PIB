    rdfs:label "O4SDLC_if->RADAR_if [AnalysisDesignVocabulary]"@en ;
    iif:edgeCapability asmt:AnalysisDesignVocabulary ;
    iif:edgeSource asmt:O4SDLC_if ;
    iif:edgeTarget asmt:RADAR_if ;
    iif:governedByOperator asmt:Op_Mandatory .

asmt:Edge_OntologyBased_1 a iif:IntegrationEdge,
        owl:NamedIndividual ;
    rdfs:label "RADAR_if->PAMG_if [AdequacyMeasurement]"@en ;
    iif:edgeCapability asmt:AdequacyMeasurement ;
    iif:edgeSource asmt:RADAR_if ;
    iif:edgeTarget asmt:PAMG_if ;
    iif:governedByOperator asmt:Op_Mandatory .

asmt:Edge_OntologyBased_2 a iif:IntegrationEdge,
        owl:NamedIndividual ;
    rdfs:label "OEE_if->PAMG_if [OntologyQualityMeasurement]"@en ;
    iif:edgeCapability asmt:OntologyQualityMeasurement ;
    iif:edgeSource asmt:OEE_if ;
    iif:edgeTarget asmt:PAMG_if ;
