asmt:Wiring_Gamification a iif:WiringVariant,
        owl:NamedIndividual ;
    rdfs:label "Gamification wiring"@en ;
    asmt:variationCapacity 1 ;
    iif:forProfile asmt:Profile_Gamification ;
    iif:hasEdge asmt:Edge_Gamification_0 .

asmt:Wiring_OntologyBased a iif:WiringVariant,
        owl:NamedIndividual ;
    rdfs:label "OntologyBased wiring"@en ;
    asmt:variationCapacity 1 ;
    iif:forProfile asmt:Profile_OntologyBased ;
    iif:hasEdge asmt:Edge_OntologyBased_0,
        asmt:Edge_OntologyBased_1,
        asmt:Edge_OntologyBased_2 .

asmt:Wiring_OntologyDevelopment a iif:WiringVariant,
        owl:NamedIndividual ;
    rdfs:label "OntologyDevelopment wiring"@en ;
    asmt:variationCapacity 1 ;
    iif:forProfile asmt:Profile_OntologyDevelopment ;
    iif:hasEdge asmt:Edge_OntologyDevelopment_0,
        asmt:Edge_OntologyDevelopment_1,
        asmt:Edge_OntologyDevelopment_2 .

<http://purl.org/pib/example#CapstoneProfile> a pib:Profile ;
    rdfs:label "Capstone Profile"@en ;
    pib:hasCategory <http://purl.org/pib/example#CapstoneReport> ;
    pib:hasSharedCriterion <http://purl.org/pib/example#HasAnalysisDesignModel> ;
    pib:selectsWiring <http://purl.org/pib/example#CapstoneWiring> .

<http://purl.org/pib/example#CapstoneReport> a pib:ArtifactCategory ;
    rdfs:label "İKÜ Capstone Report"@en .

<http://purl.org/pib/example#CapstoneWiring> a iif:WiringVariant ;
    rdfs:label "Capstone wiring variant"@en ;
    ns1:engine "Variant_Algebra_Framework_v1_0_0 (pinned BruteForceBackend)" ;
    ns1:publishable true ;
    ns1:variationCapacity 9 ;
    ns1:wiringValid true ;
    iif:forProfile <http://purl.org/pib/example#CapstoneProfile> ;
    rdfs:comment "VC=9 admissible wirings over the contributed O4SDLC->RADAR->PAMG chain; 4/4 collision guards reject as expected. Publishable: wiring valid AND all 3 participating interfaces carry G3 self-coverage; composed graph conforms (0 violations)."@en .

<http://purl.org/pib/example#HasAnalysisDesignModel> a pib:SharedCriterion ;
    rdfs:label "must contain an Analysis & Design model"@en ;
    dcterms:source "İKÜ capstone rubric; shared by RADAR (measures adequacy) and PAMG (grades)." .

<http://purl.org/pib/example#InstitutionalGrade> a iif:Capability ;
    rdfs:label "Institutional grade"@en .

pibx:Addition a va:AdditionOperator,
        owl:NamedIndividual ;
    rdfs:label "Addition — co-inclusion: both operands enter the same set"@en .

pibx:AlternativeGrader a va:Feature,
        owl:NamedIndividual ;
    rdfs:label "Alternative grader — any grader other than the institutional one"@en .

pibx:CapstoneConstraintApp a va:AdditionOperator,
        pibx:OperatorApplication,
        owl:NamedIndividual ;
    rdfs:label "Both the measurement budget and the grading discipline apply together"@en ;
    va:hasInnerOperator pibx:Exclusive,
        pibx:Repetition ;
    va:hasOperand pibx:GradingDisciplineApp,
        pibx:MeasurementBudgetApp ;
    va:hasOperator pibx:Addition .

pibx:FacetGroup a va:Feature,
        owl:NamedIndividual ;
    rdfs:label "Measurement facet group — the facets competing for the budget"@en .

pibx:GradingDisciplineApp a va:ExclusiveOperator,
        pibx:OperatorApplication,
        owl:NamedIndividual ;
    rdfs:label "Exactly one grader: the institutional grader, or an alternative, never both"@en ;
    va:hasOperator pibx:Exclusive ;
    va:members ( asmt:PAMG_if pibx:AlternativeGrader ) .

pibx:MeasurementBudgetApp a pibx:OperatorApplication,
        va:RepetitionOperator,
        owl:NamedIndividual ;
    rdfs:label "At most two measurement facets may feed the grader"@en ;
    va:appliesTo pibx:FacetGroup ;
    va:hasMaxRepetitions 2 ;
    va:hasOperator pibx:Repetition .

asmt:HasOntologyQuality a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "has ontology-quality measurement"@en .

asmt:OEE_if a iif:OntologyInterface,
        owl:NamedIndividual ;
    rdfs:label "OEE_if"@en ;
    iif:hasSelfCoverage asmt:SelfCov_OEE ;
    iif:produces asmt:OntologyQualityMeasurement .

asmt:Wiring_CoreSoftwareDevelopment a iif:WiringVariant,
        owl:NamedIndividual ;
    rdfs:label "CoreSoftwareDevelopment wiring"@en ;
    asmt:variationCapacity 1 ;
    iif:forProfile asmt:Profile_CoreSoftwareDevelopment ;
    iif:hasEdge asmt:Edge_CoreSoftwareDevelopment_0,
        asmt:Edge_CoreSoftwareDevelopment_1 .

<http://purl.org/pib/example#AdequacyMeasurement> a iif:Capability ;
    rdfs:label "Adequacy measurement"@en .

<http://purl.org/pib/example#AnalysisDesignVocabulary> a iif:Capability ;
    rdfs:label "Analysis & Design vocabulary"@en .

<http://purl.org/pib/prov#oe_pack> a prov:Entity ;
    rdfs:label "OE Pack v20.11.0 / ABox v2.2.0 (governance)"@en .

<http://purl.org/pib/prov#vaf_pin> a prov:Entity ;
    rdfs:label "Variant_Algebra_Framework_v1_0_0 (pinned engine)"@en .

pibx:Exclusive a va:ExclusiveOperator,
        owl:NamedIndividual ;
    rdfs:label "Exclusive (optional-wrapped) — at most one of the operands may be selected"@en ;
    skos:scopeNote "PIB means the OPTIONAL-WRAPPED exclusive: at most one, zero allowed. The variant algebra defines the bare exclusive operator as EXACTLY one (thesis eq. 2.35), which is a different constraint: PIB's worked capstone has capacity 9 under at-most-one and 6 under exactly-one. Recorded here because this individual is typed by the algebra's class, whose own definition states the exactly-one reading."@en .

pibx:Repetition a va:RepetitionOperator,
        owl:NamedIndividual ;
    rdfs:label "Repetition — bounds how many contributors to a group may be selected"@en .

asmt:GamificationModel a iif:Capability,
        owl:NamedIndividual ;
    rdfs:label "Gamification model + fidelity"@en .

asmt:O4SDLC_if a iif:OntologyInterface,
        owl:NamedIndividual ;
    rdfs:label "O4SDLC_if"@en ;
    iif:hasSelfCoverage asmt:SelfCov_O4SDLC ;
    iif:produces asmt:AnalysisDesignVocabulary .

asmt:OntologyQualityMeasurement a iif:Capability,
        owl:NamedIndividual ;
    rdfs:label "Ontology-quality measurement (OEE facet)"@en .

<http://purl.org/pib> a owl:Ontology ;
    rdfs:label "PIB — A-Box — every individual and all instance data"@en ;
    dcterms:description "PIB (Profile + Integration-Interface Blueprint). One file per role, per BP-D54: what used to be a separate subject is a module inside these three files, recorded at its own former IRI, and every term keeps the IRI it always had. A consumer that names a term is unaffected; a consumer that named a FILE reads this one instead. The former files leave the package and stay recoverable from git history and the release tags."@en ;
    dcterms:identifier "pib" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-22"^^xsd:date ;
    owl:versionIRI <http://purl.org/pib/abox/1.0.0> ;
    owl:versionInfo "1.0.0" .

asmt:AdequacyMeasurement a iif:Capability,
        owl:NamedIndividual ;
    rdfs:label "Adequacy/quality measurement"@en .

asmt:AnalysisDesignVocabulary a iif:Capability,
        owl:NamedIndividual ;
    rdfs:label "Analysis & Design vocabulary"@en .

<http://purl.org/pib/prov#authoring> a prov:Activity ;
    rdfs:label "PIB blueprint authoring (PAMG session)"@en ;
    prov:used <http://purl.org/pib/prov#oe_pack>,
        <http://purl.org/pib/prov#vaf_pin> ;
    prov:wasAssociatedWith <http://purl.org/pib/prov#Agent_YusufAltunel> .

asmt:RADAR_if a iif:OntologyInterface,
        owl:NamedIndividual ;
    rdfs:label "RADAR_if"@en ;
    iif:consumes asmt:AnalysisDesignVocabulary ;
    iif:hasSelfCoverage asmt:SelfCov_RADAR ;
    iif:produces asmt:AdequacyMeasurement .

asmt:PAMG_if a iif:OntologyInterface,
        owl:NamedIndividual ;
    rdfs:label "PAMG_if"@en ;
    iif:consumes asmt:AdequacyMeasurement,
        asmt:GamificationModel,
        asmt:OntologyQualityMeasurement ;
    iif:hasSelfCoverage asmt:SelfCov_PAMG ;
    iif:produces asmt:InstitutionalGrade .

asmt:Op_Mandatory a iif:VariabilityOperator,
        owl:NamedIndividual ;
    rdfs:label "Mandatory operator"@en .

<http://purl.org/pib/prov#Agent_YusufAltunel> a prov:Agent,
        prov:Person ;
    rdfs:label "Yusuf Altunel"@en .

