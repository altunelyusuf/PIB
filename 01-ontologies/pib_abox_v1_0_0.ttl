asmt:Op_Or a iif:VariabilityOperator,
        owl:NamedIndividual ;
    rdfs:label "Or operator"@en .

asmt:Op_Repetition a iif:VariabilityOperator,
        owl:NamedIndividual ;
    rdfs:label "Repetition operator"@en .

