asmt:GamOnt_if a iif:OntologyInterface,
        owl:NamedIndividual ;
    rdfs:label "GamOnt_if"@en ;
    iif:hasSelfCoverage asmt:SelfCov_GamOnt ;
    iif:produces asmt:GamificationModel .

asmt:GamificationProject a pib:ArtifactCategory,
        owl:NamedIndividual ;
    rdfs:label "Educational gamification project"@en .

asmt:HasAnalysisDesignModel a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "contains an Analysis & Design model"@en .

asmt:HasCodeMeasurement a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "has code measurement"@en .

asmt:HasGroundingOntology a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "grounded in a published ontology"@en .

asmt:HasPlayEvidence a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "grounded in real game/play results"@en .

asmt:HasThesisFidelity a pib:SharedCriterion,
        owl:NamedIndividual ;
    rdfs:label "proposal↔implementation fidelity demonstrated"@en .

asmt:InstitutionalGrade a iif:Capability,
        owl:NamedIndividual ;
    rdfs:label "Institutional grade (PAMG, computed in-ontology)"@en .

asmt:OntologyBasedSystem a pib:ArtifactCategory,
        owl:NamedIndividual ;
    rdfs:label "Ontology-based system (uses an ontology at runtime)"@en .

asmt:OntologyDeliverable a pib:ArtifactCategory,
        owl:NamedIndividual ;
    rdfs:label "Ontology-development deliverable (the ontology is the product)"@en .

asmt:Profile_CoreSoftwareDevelopment a pib:Profile,
        owl:NamedIndividual ;
    rdfs:label "CoreSoftwareDevelopment profile"@en ;
    pib:hasCategory asmt:CoreSoftwareDevelopment ;
    pib:hasSharedCriterion asmt:HasCodeMeasurement ;
    pib:selectsWiring asmt:Wiring_CoreSoftwareDevelopment .

asmt:Profile_Gamification a pib:Profile,
        owl:NamedIndividual ;
    rdfs:label "Gamification profile"@en ;
    pib:hasCategory asmt:GamificationProject ;
    pib:hasSharedCriterion asmt:HasPlayEvidence,
        asmt:HasThesisFidelity ;
    pib:selectsWiring asmt:Wiring_Gamification .

asmt:Profile_OntologyBased a pib:Profile,
        owl:NamedIndividual ;
    rdfs:label "OntologyBased profile"@en ;
    pib:hasCategory asmt:OntologyBasedSystem ;
    pib:hasSharedCriterion asmt:HasGroundingOntology,
        asmt:HasOntologyQuality ;
    pib:selectsWiring asmt:Wiring_OntologyBased .

asmt:Profile_OntologyDevelopment a pib:Profile,
        owl:NamedIndividual ;
    rdfs:label "OntologyDevelopment profile"@en ;
    pib:hasCategory asmt:OntologyDeliverable ;
    pib:hasSharedCriterion asmt:HasAnalysisDesignModel,
        asmt:HasOntologyQuality ;
    pib:selectsWiring asmt:Wiring_OntologyDevelopment .

asmt:SelfCov_GamOnt a iif:SelfCoverageAttestation,
